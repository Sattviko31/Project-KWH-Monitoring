@{
    ViewData["Title"] = "Koneksi Database Gagal";
}
<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card border-danger shadow-sm">
                <div class="card-header bg-danger text-white">
                    <h5 class="mb-0"><i class="fas fa-exclamation-triangle me-2"></i>Koneksi Database Gagal</h5>
                </div>
                <div class="card-body">
                    <p>Server database saat ini tidak dapat diakses. Halaman ini membutuhkan koneksi ke database untuk menampilkan data.</p>
                    <p class="text-muted small">Silakan coba lagi dalam beberapa saat. Jika masalah berlanjut, hubungi administrator sistem.</p>
                    <div class="mt-3">
                        <a asp-controller="Monitoring" asp-action="Index" class="btn btn-primary me-2">
                            <i class="fas fa-home me-1"></i> Dashboard
                        </a>
                        <button onclick="location.reload()" class="btn btn-outline-secondary">
                            <i class="fas fa-sync-alt me-1"></i> Coba Lagi
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
