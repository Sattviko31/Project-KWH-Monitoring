@using KWHMonitoring.Models
@using Microsoft.Extensions.Caching.Memory
@inject IMemoryCache MemoryCache
@inject KWHMonitoring.Services.AppSettingsCache SettingsCache
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    const string cacheKey = "Layout_FooterSettings";
    if (!MemoryCache.TryGetValue(cacheKey, out Dictionary<string, string> _footerSettings))
    {
        _footerSettings = SettingsCache.GetAll();
        MemoryCache.Set(cacheKey, _footerSettings, TimeSpan.FromMinutes(5));
    }
    string _GetFooterSetting(string key, string defaultValue = "")
    {
        return _footerSettings.TryGetValue(key, out var value) ? value : defaultValue;
    }
    var _dbServer = _GetFooterSetting("Database.Server", "192.168.6.15");
    var _dbName = _GetFooterSetting("Database.Name", "HaiwellElectrical");
    var _antiforgeryTokens = Antiforgery.GetAndStoreTokens(Context);
    var controllerName = ViewContext.RouteData.Values["controller"]?.ToString();
    var isAuthPage = ViewData["AuthPage"] != null || controllerName == "Account" || controllerName == "AdminApproval";
}
<!DOCTYPE html>
<html lang="id" class="@(isAuthPage ? "auth-page" : "")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, viewport-fit=cover" />
    <meta name="csrf-token" content="@_antiforgeryTokens.RequestToken" />
    <title>@ViewData["Title"] - KWH Monitoring</title>
    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/bootstrap5-compat.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" crossorigin="anonymous" />
    <link rel="stylesheet" href="~/lib/devextreme/css/dx.common.css" />
    <link rel="stylesheet" href="~/lib/devextreme/css/dx.light.css" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        .activity-modal-content { color: var(--text-primary); background: var(--bg-surface); border: 1px solid var(--border-color); border-radius: 14px; overflow: hidden; box-shadow: var(--shadow-lg); }
        .activity-modal-content .modal-header, .activity-modal-content .modal-footer { color: var(--text-primary); background: var(--bg-surface-hover); border-color: var(--border-color); }
        .activity-modal-content .modal-title { color: var(--text-primary); }
        .activity-modal-content .text-muted { color: var(--text-muted) !important; }
        .activity-modal-content .close { color: var(--text-primary); text-shadow: none; opacity: .75; }
        .activity-modal-content .close:hover { color: var(--text-primary); opacity: 1; }
        .activity-log-list { display: flex; flex-direction: column; gap: 10px; }
        .activity-log-item { display: flex; gap: 12px; padding: 13px 14px; border: 1px solid var(--border-color); border-radius: 10px; background: var(--bg-surface); color: var(--text-primary); }
        .activity-log-icon { flex: 0 0 36px; height: 36px; display: grid; place-items: center; border-radius: 50%; background: var(--badge-bg); color: var(--badge-text); }
        .activity-log-item.severity-warning .activity-log-icon { background: rgba(245, 158, 11, .16); color: #a36500; }
        .activity-log-item.severity-critical .activity-log-icon { background: rgba(220, 53, 69, .15); color: #bd2635; }
        [data-theme="dark"] .activity-log-item.severity-warning .activity-log-icon { color: #ffd166; }
        [data-theme="dark"] .activity-log-item.severity-critical .activity-log-icon { color: #ff8d99; }
        .activity-log-copy { min-width: 0; flex: 1; }
        .activity-log-heading { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 6px 14px; }
        .activity-log-message { margin: 5px 0 0; color: var(--text-secondary); overflow-wrap: anywhere; white-space: pre-wrap; }
        .activity-log-meta { color: var(--text-muted); font-size: 12px; }
        .activity-log-empty { padding: 36px 12px; color: var(--text-muted); text-align: center; }
        #notificationActivityList { max-height: min(65vh, 620px); overflow-y: auto; }
        .help-modal-body { max-height: min(70vh, 720px); overflow-y: auto; }
        .help-section { padding: 14px 2px 16px; border-bottom: 1px solid var(--border-subtle); }
        .help-section:last-child { border-bottom: 0; }
        .help-section h6 { margin: 0 0 10px; color: var(--text-primary); font-size: 15px; font-weight: 700; }
        .help-section p, .help-section li { color: var(--text-secondary); line-height: 1.6; }
        .help-section ul, .help-section ol { padding-left: 22px; margin-bottom: 8px; }
        .help-note { padding: 10px 12px; border-left: 3px solid var(--primary-color); background: var(--badge-bg); color: var(--text-secondary); border-radius: 4px; }
        .help-release { display: grid; grid-template-columns: 155px 1fr; gap: 3px 12px; padding: 12px 0; border-top: 1px solid var(--border-subtle); }
        .help-release time { grid-row: span 2; color: var(--text-muted); font-size: 13px; }
        .help-release strong { color: var(--text-primary); }
        .help-release span { color: var(--text-secondary); line-height: 1.5; }
        @@media (max-width: 575px) { .help-release { grid-template-columns: 1fr; } .help-release time { grid-row: auto; } }
    </style>
    <link rel="stylesheet" href="~/css/card-help.css" asp-append-version="true" />
    <script>(function(){var t;try{t=localStorage.getItem('kwh_theme')}catch(e){}if(t==='dark'){document.documentElement.setAttribute('data-theme','dark');document.documentElement.style.backgroundColor='#0b0f1a'}document.documentElement.classList.add('no-transition');function s(){document.documentElement.setAttribute('data-theme-ready','')}if(document.readyState==='loading'){document.addEventListener('DOMContentLoaded',s)}else{s()}setTimeout(s,800)})();</script>
    <!-- Status login user (server-rendered oleh Razor). Dipakai agar pengunjung
         tanpa login TIDAK di-redirect paksa ke halaman Login oleh global
         ajaxError handler saat ada request API yang membutuhkan autentikasi. -->
    <script>var IS_USER_AUTHENTICATED = @(User.Identity.IsAuthenticated ? "true" : "false");</script>
    <noscript><style>html{visibility:visible!important}</style></noscript>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
</head>
<body>
    <script>/* console.log('[LayoutDebug] controller=@controllerName, isAuthPage=@isAuthPage.ToString().ToLowerInvariant()') */;</script>
    <!-- MAIN WRAPPER (no sidebar) -->
    <div class="erp-main-wrapper @(isAuthPage ? "auth-layout" : "")" id="erpMainWrapper">
        <!-- AUTH BACKGROUND CANVAS -->
        @if (isAuthPage)
        {
            <canvas id="authBackgroundCanvas" class="auth-background-canvas"></canvas>
            <script src="~/js/auth-bg.js" asp-append-version="true"></script>
        }
        else
        {
            <canvas id="dashboardBgCanvas" class="dashboard-bg-canvas"></canvas>
        }
        <!-- TOP HEADER BAR -->
        <header class="erp-topbar">
            <div class="topbar-left">
                <a class="topbar-brand" asp-controller="Monitoring" asp-action="Index">
                    <i class="fas fa-bolt text-warning"></i> <span class="d-none d-sm-inline">KWH Monitoring</span>
                </a>
                <!-- Horizontal nav in topbar -->
                @* <nav class="topbar-nav d-none d-lg-flex">
                    <a class="topbar-nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")"
                       asp-controller="Monitoring" asp-action="Index">
                        <i class="fas fa-tachometer-alt"></i> Dashboard
                    </a>
                    <a class="topbar-nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "History" ? "active" : "")"
                       asp-controller="Monitoring" asp-action="History">
                        <i class="fas fa-history"></i> History
                    </a>
                </nav> *@
            </div>
            <div class="topbar-right">
