                    <span class="topbar-badge bg-danger" id="topbarAnomalyBadge">0</span>
                </button>
                <button class="btn btn-link topbar-icon-btn" id="topbarHelp" type="button" title="Panduan dan catatan pembaruan" aria-label="Buka panduan aplikasi">
                    <i class="fas fa-question-circle"></i>
                </button>
                <span id="anomalyBadge" style="display:none">0</span>
                <!-- Mobile nav toggle -->
                <button class="btn btn-link topbar-icon-btn d-lg-none" id="mobileNavToggle" type="button" title="Menu">
                    <i class="fas fa-ellipsis-v"></i>
                </button>
                @if (User.Identity.IsAuthenticated)
                {
