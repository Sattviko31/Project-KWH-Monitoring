    <script>
        (function() {
            var toggle = document.getElementById('mobileNavToggle');
            var dropdown = document.getElementById('mobileNavDropdown');
            if (toggle && dropdown) {
                toggle.addEventListener('click', function() {
                    dropdown.classList.toggle('show');
                });
                document.addEventListener('click', function(e) {
                    if (!dropdown.contains(e.target) && !toggle.contains(e.target)) {
                        dropdown.classList.remove('show');
                    }
                });
            }

            var latestActivityItems = [];
            var activityRefreshInProgress = false;
            var activityModalIsOpen = false;
            var notificationFeedStorageKey = 'kwh_notification_feed';
            var observedSourceStorageKey = 'kwh_notification_observed_sources';
            var activityInitializedStorageKey = 'kwh_notification_sources_initialized_v2';
            var activeFindingsStorageKey = 'kwh_active_system_findings';

            function readActivityStorage(key, fallback) {
                try {
                    var value = localStorage.getItem(key);
                    return value ? JSON.parse(value) : fallback;
                } catch (e) { return fallback; }
            }

            function saveNotificationFeed(items) {
                try {
                    localStorage.setItem(notificationFeedStorageKey, JSON.stringify(items .slice(0, 100)));
                } catch (e) { /* console.warn(' Log notifikasi lokal tidak dapat disimpan:', e) */; }
            }

            function updateActivityBadge(count) {
                var badge = document.getElementById('topbarAnomalyBadge');
                var legacyBadge = document.getElementById('anomalyBadge');
                if (badge) {
                    badge.textContent = count > 99 ? '99+' : String(count);
                    badge.style.display = count ? 'inline-block' : 'none';
                    badge.title = count ? count + ' notifikasi tersimpan' : 'Tidak ada notifikasi tersimpan';
                }
                if (legacyBadge) legacyBadge.textContent = String(count);
            }

            function clearNotificationFeed() {
                saveNotificationFeed([]);
                updateActivityBadge(0);
            }

            window.queueActivityNotification = function(item) {
                var feed = readActivityStorage(notificationFeedStorageKey, []);
                var displayIds = new Set((activityModalIsOpen ? latestActivityItems : feed).map(function(existing) { return existing.id; }));
                if (!displayIds.has(item.id)) {
                    feed.unshift(item);
                    saveNotificationFeed(feed);
                }
                if (activityModalIsOpen) {
                    latestActivityItems = latestActivityItems.concat(item).filter(function(entry, index, all) {
                        return all.findIndex(function(candidate) { return candidate.id === entry.id; }) === index;
                    });
                    clearNotificationFeed();
                } else {
                    latestActivityItems = readActivityStorage(notificationFeedStorageKey, []);
                    updateActivityBadge(latestActivityItems.length);
                }
                renderActivityLog(latestActivityItems);
            };

            function markSourceItemsObserved(items) {
                try {
                    var observed = readActivityStorage(observedSourceStorageKey, []);
                    var ids = items.map(function(item) { return item.id; }).filter(Boolean);
                    localStorage.setItem(observedSourceStorageKey, JSON.stringify(Array.from(new Set(observed.concat(ids)) ).slice(-2000)));
                } catch (e) { /* console.warn('Status sumber log tidak dapat disimpan:', e) */; }
            }

            function renderActivityLog(items) {
                var list = document.getElementById('notificationActivityList');
                list.innerHTML = '';
                if (!items.length) {
                    list.innerHTML = '<div class="activity-log-empty"><i class="far fa-check-circle fa-2x d-block mb-2"></i>Belum ada aktivitas yang tercatat.</div>';
                    return;
                }

                var container = document.createElement('div');
                container.className = 'activity-log-list';
                items.forEach(function(item) {
                    var row = document.createElement('article');
                    var severity = String(item.severity || 'info').toLowerCase();
                    row.className = 'activity-log-item severity-' + (severity === 'high' || severity === 'critical' ? 'critical' : severity === 'warning' || severity === 'medium' ? 'warning' : 'info');

                    var icon = document.createElement('div');
                    icon.className = 'activity-log-icon';
                    var iconElement = document.createElement('i');
                    iconElement.className = item.category === 'Anomali' ? 'fas fa-exclamation-triangle' : item.category === 'AI Chatbot' ? 'fas fa-robot' : item.category === 'Registrasi' ? 'fas fa-user-plus' : 'fas fa-clipboard-list';
                    icon.appendChild(iconElement);

                    var copy = document.createElement('div');
                    copy.className = 'activity-log-copy';
                    var heading = document.createElement('div');
                    heading.className = 'activity-log-heading';
                    var title = document.createElement('strong');
                    title.textContent = item.title || item.category || 'Aktivitas sistem';
                    var time = document.createElement('span');
                    time.className = 'activity-log-meta';
                    var timestamp = new Date(item.timestamp);
                    time.textContent = isNaN(timestamp.getTime()) ? '' : timestamp.toLocaleString('id-ID');
                    heading.appendChild(title);
                    heading.appendChild(time);
                    var message = document.createElement('p');
                    message.className = 'activity-log-message';
                    message.textContent = item.message || '';
                    copy.appendChild(heading);
                    copy.appendChild(message);
                    row.appendChild(icon);
                    row.appendChild(copy);
                    container.appendChild(row);
                });
                list.appendChild(container);
            }

            async function refreshActivityLog() {
                if (activityRefreshInProgress) return;
                if (typeof IS_USER_AUTHENTICATED !== 'undefined' && !IS_USER_AUTHENTICATED) {
                    latestActivityItems = readActivityStorage(notificationFeedStorageKey, []);
                    renderActivityLog(latestActivityItems);
                    updateActivityBadge(latestActivityItems.length);
                    return;
                }
                activityRefreshInProgress = true;
                try {
                    var response = await fetch('/api/qwenchat/activity-log?t=' + Date.now(), { credentials: 'same-origin', cache: 'no-store' });
                    var contentType = response.headers.get('content-type') || '';
                    if (!contentType.toLowerCase().includes('application/json')) {
                        latestActivityItems = readActivityStorage(notificationFeedStorageKey, []);
                        renderActivityLog(latestActivityItems);
                        updateActivityBadge(latestActivityItems.length);
                        return;
                    }
                    if (!response.ok) throw new Error('HTTP ' + response.status);
                    var result = await response.json();
                    var sourceItems = (result.items || []).slice();
                    var liveItems = [];

                    // Gabungkan temuan live saat ini dengan aktivitas historis dari database.
                    try {
                        var snapshotResponse = await fetch('/api/qwenchat/current-dashboard-data?t=' + Date.now(), { credentials: 'same-origin', cache: 'no-store' });
                        if (snapshotResponse.ok) {
                            var snapshot = await snapshotResponse.json();
                            var activeFindings = readActivityStorage(activeFindingsStorageKey, {});
                            var currentFindingKeys = {};
                            (snapshot.systemFindings || []).forEach(function(finding, index) {
                                var findingKey = (finding.code || 'finding') + '|' + (finding.deviceKey || index);
                                currentFindingKeys[findingKey] = true;
                                if (!activeFindings[findingKey]) {
                                    activeFindings[findingKey] = {
                                        id: 'live-' + encodeURIComponent(findingKey) + '-' + Date.now(),
                                        firstSeen: new Date().toISOString()
                                    };
                                }
                                liveItems.push({
                                    id: activeFindings[findingKey].id,
                                    category: 'Anomali',
                                    title: finding.code === 'STALE_PANEL' ? 'Panel tidak mengirim data' : 'Temuan sistem',
                                    message: finding.message,
                                    severity: finding.severity,
                                    timestamp: activeFindings[findingKey].firstSeen
                                });
                            });
                            Object.keys(activeFindings).forEach(function(key) {
                                if (!currentFindingKeys[key]) delete activeFindings[key];
                            });
                            try { localStorage.setItem(activeFindingsStorageKey, JSON.stringify(activeFindings)); } catch (e) { }
                         }
                    } catch (snapshotError) {  /* console.warn('Temuan live tidak tersedia:', snapshotError) */; }

                    var observed = readActivityStorage(observedSourceStorageKey, []);
                    var observedIds = new Set(observed);
                    var newlyObserved = [];
                    if (localStorage.getItem(activityInitializedStorageKey) !== 'true') {
                        // Existing server history is a baseline, not a burst of new notifications.
                        markSourceItemsObserved(sourceItems.concat(liveItems));
                        newlyObserved = liveItems;
                        localStorage.setItem(activityInitializedStorageKey, 'true');
                    } else {
                        newlyObserved = sourceItems.concat(liveItems).filter(function(item) {
                            return item.id && !observedIds.has(item.id);
                        });
                        markSourceItemsObserved(sourceItems.concat(liveItems));
                    }

                    var feed = readActivityStorage(notificationFeedStorageKey, []);
                    var feedIds = new Set(feed.map(function(item) { return item.id; }));
                    newlyObserved.forEach(function(item) {
                        if (item.id && !feedIds.has(item.id)) {
                            feed.unshift(item);
                            feedIds.add(item.id);
                        }
                    });
                    feed.sort(function(a, b) { return new Date(b.timestamp) - new Date(a.timestamp); });
                    feed = feed.slice(0, 100);
                    saveNotificationFeed(feed);
                    if (activityModalIsOpen) {
                        var visibleById = {};
                        latestActivityItems.concat(feed).forEach(function(item) { if (item.id) visibleById[item.id] = item; });
                        latestActivityItems = Object.keys(visibleById).map(function(id) { return visibleById[id]; })
                            .sort(function(a, b) { return new Date(b.timestamp) - new Date(a.timestamp); }).slice(0, 100);
                    } else {
                        latestActivityItems = feed;
                    }
                    var updatedAt = document.getElementById('activityLogUpdatedAt');
                    if (updatedAt) updatedAt.textContent = 'Diperbarui ' + new Date().toLocaleTimeString('id-ID');
                    renderActivityLog(latestActivityItems);
                    if (activityModalIsOpen) {
                        if (feed.length) clearNotificationFeed();
                        else updateActivityBadge(0);
            } else updateActivityBadge(feed.length);
                } catch (e) {
                     /* console.warn('Gagal memuat log aktivitas:', e) */;
                    var list = document.getElementById('notificationActivityList');
                    if (list) list.innerHTML = '<div class="activity-log-empty">Log aktivitas gagal dimuat. Coba perbarui kembali.</div>';
                } finally {
                    activityRefreshInProgress = false;
                }
            }

            var notificationButton = document.getElementById('topbarNotifications');
            if (notificationButton) notificationButton.addEventListener('click', function() {
                activityModalIsOpen = true;
                latestActivityItems = readActivityStorage(notificationFeedStorageKey, []);
                renderActivityLog(latestActivityItems);
                clearNotificationFeed();
                if (window.jQuery && typeof jQuery.fn.modal === 'function') jQuery('#notificationActivityModal').modal('show');
                refreshActivityLog();
            });
            if (window.jQuery) jQuery('#notificationActivityModal').on('hidden.bs.modal', function() {
                activityModalIsOpen = false;
                latestActivityItems = [];
                renderActivityLog([]);
            });
            var helpButton = document.getElementById('topbarHelp');
            if (helpButton) helpButton.addEventListener('click', function() {
                if (window.jQuery && typeof jQuery.fn.modal === 'function') jQuery('#applicationHelpModal').modal('show');
            });
            var refreshActivityButton = document.getElementById('refreshActivityLog');
            if (refreshActivityButton) refreshActivityButton.addEventListener('click', refreshActivityLog);
            var resetActivityButton = document.getElementById('resetActivityLog');
            if (resetActivityButton) resetActivityButton.addEventListener('click', async function() {
                await refreshActivityLog();
                clearNotificationFeed();
                latestActivityItems = [];
                renderActivityLog([]);
            });
            refreshActivityLog();
            setInterval(refreshActivityLog, 60000);
        })();
    </script>

    <!-- ANOMALY BACKGROUND SERVICE -->
    @await Html.PartialAsync("_AnomalyService")

    <!-- REALTIME REFRESH: update halaman ketika ada perubahan data (bukan interval tetap) -->
    <script src="~/js/realtime-refresh.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
    <script src="~/js/language.js" asp-append-version="true"></script>
</body>
</html>

