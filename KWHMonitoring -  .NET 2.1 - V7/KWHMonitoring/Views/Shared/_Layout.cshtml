@using KWHMonitoring.Models
@using Microsoft.Extensions.Caching.Memory
@inject IMemoryCache MemoryCache
@inject ApplicationDbContext Db
@{
    const string cacheKey = "Layout_FooterSettings";
    if (!MemoryCache.TryGetValue(cacheKey, out Dictionary<string, string> _footerSettings))
    {
        _footerSettings = Db.AppSettingsRecords.ToDictionary(x => x.SettingKey, x => x.SettingValue);
        MemoryCache.Set(cacheKey, _footerSettings, TimeSpan.FromMinutes(5));
    }
    string _GetFooterSetting(string key, string defaultValue = "")
    {
        return _footerSettings.TryGetValue(key, out var value) ? value : defaultValue;
    }
    var _dbServer = _GetFooterSetting("Database.Server", "192.168.6.15");
    var _dbName = _GetFooterSetting("Database.Name", "HaiwellElectrical");
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - KWH Monitoring</title>
    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/bootstrap5-compat.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" crossorigin="anonymous" />
    <link rel="stylesheet" href="~/lib/devextreme/css/dx.common.css" />
    <link rel="stylesheet" href="~/lib/devextreme/css/dx.light.css" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <!-- SIDEBAR -->
    <aside class="erp-sidebar" id="erpSidebar">
        <div class="sidebar-brand">
            <div class="brand-banner">
                <span class="brand-warna">KWH</span>
                <span class="brand-monitoring">MONITORING</span>
            </div>
            <div class="brand-subtitle">Haiwell Electrical System</div>
        </div>

        <div class="sidebar-search">
            <div class="input-group">
                <span class="input-group-text"><i class="fas fa-search"></i></span>
                <input type="text" class="form-control" placeholder="Search..." id="sidebarSearch">
            </div>
        </div>

        <nav class="sidebar-nav">
            <ul class="nav flex-column">
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Monitoring" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")"
                       asp-controller="Monitoring" asp-action="Index">
                        <i class="fas fa-tachometer-alt"></i>
                        <span>Dashboard</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Charts" ? "active" : "")"
                       asp-controller="Monitoring" asp-action="Charts">
                        <i class="fas fa-chart-line"></i>
                        <span>All Charts</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "UsageStatistics" ? "active" : "")"
                       asp-controller="Monitoring" asp-action="UsageStatistics">
                        <i class="fas fa-chart-bar"></i>
                        <span>Usage Statistics</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "History" ? "active" : "")"
                       asp-controller="Monitoring" asp-action="History">
                        <i class="fas fa-history"></i>
                        <span>History</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "AnomalyLogs" ? "active" : "")"
                       asp-controller="Monitoring" asp-action="AnomalyLogs">
                        <i class="fas fa-exclamation-triangle"></i>
                        <span>Anomaly Logs</span>
                        <span class="badge bg-danger ms-auto" id="anomalyBadge">0</span>
                    </a>
                </li>

                <li class="nav-section-title">KONFIGURASI</li>

                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Settings" ? "active" : "")"
                       asp-controller="Monitoring" asp-action="Settings">
                        <i class="fas fa-cog"></i>
                        <span>Settings</span>
                    </a>
                </li>
            </ul>
        </nav>

        <div class="sidebar-footer">
            <div class="sidebar-server-info">
                <i class="fas fa-server"></i>
                <small>@_dbServer | @_dbName</small>
            </div>
        </div>
    </aside>

    <!-- SIDEBAR OVERLAY (mobile) -->
    <div class="sidebar-overlay" id="sidebarOverlay"></div>

    <!-- MAIN WRAPPER -->
    <div class="erp-main-wrapper" id="erpMainWrapper">
        <!-- TOP HEADER BAR -->
        <header class="erp-topbar">
            <div class="topbar-left">
                <button class="btn btn-link topbar-toggle" id="sidebarToggle" type="button">
                    <i class="fas fa-bars"></i>
                </button>
                <a class="topbar-brand" asp-controller="Monitoring" asp-action="Index">
                    <i class="fas fa-bolt text-warning"></i> <span class="d-none d-sm-inline">KWH Monitoring</span>
                </a>
            </div>
            <div class="topbar-right">
                <span class="topbar-clock d-none d-md-inline">
                    <i class="fas fa-clock"></i> @DateTime.Now.ToString("dd MMM yyyy HH:mm")
                </span>
                <button class="btn btn-link topbar-icon-btn" id="topbarNotifications" title="Notifications">
                    <i class="fas fa-bell"></i>
                    <span class="topbar-badge bg-danger" id="topbarAnomalyBadge">0</span>
                </button>
                <div class="topbar-user">
                    <div class="topbar-user-avatar">
                        <i class="fas fa-user-circle"></i>
                    </div>
                    <div class="topbar-user-info d-none d-md-block">
                        <span class="topbar-user-name">Administrator</span>
                        <span class="topbar-user-email">admin@haiwell.com</span>
                    </div>
                </div>
            </div>
        </header>

        <!-- MAIN CONTENT -->
        <div class="erp-content">
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade in" role="alert">
                    <i class="fas fa-exclamation-triangle"></i> @TempData["Error"]
                    <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
                </div>
            }
            @RenderBody()
        </div>

        <!-- FOOTER -->
        <footer class="erp-footer">
            <div class="container-fluid">
                <div class="row align-items-center">
                    <div class="col-md-6">
                        &copy; @DateTime.Now.Year - KWH Monitoring System - Haiwell Electrical
                    </div>
                    <div class="col-md-6 text-md-end">
                        <i class="fas fa-server"></i> Server: @_dbServer | Database: @_dbName
                    </div>
                </div>
            </div>
        </footer>
    </div>



                        <!-- Tambahkan Library Marked.js untuk merender Markdown -->
                        <script src="https://cdn.jsdelivr.net/npm/marked@12.0.0/lib/marked.umd.min.js" crossorigin="anonymous"></script>

                        <!-- ========================================== -->
                        <!-- HTML WIDGET QWEN (Professional Design)   -->
                        <!-- ========================================== -->
                        <div id="qwen-chat-widget">
                            <!-- Toggle Button with Notification Badge -->
                            <button id="qwen-toggle-btn" onclick="toggleQwenChat()" title="Tanya Voltra AI Assistant">
                                <div class="qwen-btn-icon">
                                    <i class="fas fa-bolt"></i>
                                </div>
                                <span id="qwen-notification-badge" class="qwen-badge" style="display: none;">0</span>
                            </button>

                            <!-- Chat Box -->
                            <div id="qwen-chat-box" class="qwen-hidden">
                                <!-- Header -->
                                <div id="qwen-chat-header">
                                    <div class="qwen-header-left">
                                        <div class="qwen-avatar">
                                            <i class="fas fa-robot"></i>
                                        </div>
                                        <div class="qwen-header-info">
                                            <div class="qwen-header-title">Voltra AI Assistant</div>
                                            <div class="qwen-header-status">
                                                <span class="qwen-status-dot"></span>
                                                Online 💭 KWH Monitoring Support
                                            </div>
                                        </div>
                                    </div>
                                    <div class="qwen-header-actions">
                                        <button id="qwen-minimize-btn" onclick="toggleQwenChat()" class="qwen-header-btn" title="Minimize">
                                            <i class="fas fa-minus"></i>
                                        </button>
                                        <button id="qwen-clear-btn" onclick="clearChatHistory()" class="qwen-header-btn" title="Hapus Percakapan">
                                            <i class="fas fa-trash-alt"></i>
                                        </button>
                                    </div>
                                </div>

                                <!-- Quick Actions -->
                                <div id="qwen-quick-actions" class="qwen-quick-actions">
                                    <button data-message="Mana panel paling boros?" class="qwen-quick-btn">
                                        <i class="fas fa-fire"></i> Panel Boros
                                    </button>
                                    <button data-message="Berapa tagihan bulan ini?" class="qwen-quick-btn">
                                        <i class="fas fa-file-invoice-dollar"></i> Tagihan
                                    </button>
                                    <button data-message="Berapa daya total sekarang?" class="qwen-quick-btn">
                                        <i class="fas fa-bolt"></i> Daya Total
                                    </button>
                                    <button data-message="Ada anomali apa saja?" class="qwen-quick-btn">
                                        <i class="fas fa-exclamation-triangle"></i> Anomali
                                    </button>
                                </div>

                                <!-- Chat Body -->
                                <div id="qwen-chat-body">
                                    <div class="qwen-welcome-container">
                                        <div class="qwen-welcome-icon">
                                            <i class="fas fa-comments"></i>
                                        </div>
                                        <div class="qwen-welcome-title">Selamat Datang!</div>
                                        <div class="qwen-welcome-text" id="qwen-welcome-message">
                                            Saya <strong>Voltra</strong>, asisten AI khusus KWH Monitoring. 
                                            Tanyakan apa saja seputar data listrik, panel, tagihan, atau anomali.
                                        </div>
                                    </div>
                                </div>

                                <!-- Typing Indicator -->
                                <div id="qwen-typing-indicator" class="qwen-typing-indicator" style="display: none;">
                                    <div class="qwen-typing-avatar">
                                        <i class="fas fa-robot"></i>
                                    </div>
                                    <div class="qwen-typing-dots">
                                        <span></span><span></span><span></span>
                                    </div>
                                    <span class="qwen-typing-text">Voltra sedang mengetik...</span>
                                </div>

                                <!-- Footer / Input -->
                                <div id="qwen-chat-footer">
                                    <div class="qwen-input-wrapper">
                                        <input type="text" id="qwen-chat-input" 
                                               placeholder="Ketik pertanyaan Anda..." 
                                               onkeypress="handleQwenEnter(event)" 
                                               autocomplete="off" />
                                        <button id="qwen-send-btn" onclick="sendQwenMessage()" title="Kirim Pesan">
                                            <i class="fas fa-paper-plane"></i>
                                        </button>
                                    </div>
                                    <div class="qwen-footer-note">
                                        <i class="fas fa-shield-alt"></i> Powered by Qwen AI
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- ========================================== -->
                        <!-- CSS PROFESSIONAL STYLING                   -->
                        <!-- ========================================== -->
                        <style>
                            /* Main Widget Container */
                            #qwen-chat-widget { 
                                position: fixed; 
                                bottom: 25px; 
                                right: 25px; 
                                z-index: 9999; 
                                font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; 
                            }

                            /* Toggle Button — Round floating button */
                            #qwen-toggle-btn {
                                background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
                                color: white;
                                border: none;
                                width: 60px;
                                height: 60px;
                                border-radius: 50%;
                                cursor: pointer;
                                box-shadow: 0 8px 25px rgba(102, 126, 234, 0.4);
                                display: flex;
                                align-items: center;
                                justify-content: center;
                                transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
                                position: relative;
                                overflow: hidden;
                                z-index: 9998;
                            }

                            #qwen-toggle-btn::before {
                                content: '';
                                position: absolute;
                                top: -50%;
                                left: -50%;
                                width: 200%;
                                height: 200%;
                                background: conic-gradient(transparent, rgba(255,255,255,0.15), transparent 30%);
                                animation: qwen-btn-spin 3s linear infinite;
                            }

                            @@keyframes qwen-btn-spin {
                                from { transform: rotate(0deg); }
                                to { transform: rotate(360deg); }
                            }

                            #qwen-toggle-btn:hover {
                                transform: translateY(-3px) scale(1.08);
                                box-shadow: 0 12px 35px rgba(102, 126, 234, 0.5);
                            }

                            #qwen-toggle-btn:active {
                                transform: translateY(-1px) scale(0.96);
                            }

                            .qwen-btn-icon {
                                width: 60px;
                                height: 60px;
                                background: transparent;
                                border-radius: 50%;
                                display: flex;
                                align-items: center;
                                justify-content: center;
                                font-size: 24px;
                                position: relative;
                                z-index: 1;
                            }

                            .qwen-badge {
                                position: absolute;
                                top: -4px;
                                right: -4px;
                                background: #ff4757;
                                color: white;
                                border-radius: 50%;
                                width: 24px;
                                height: 24px;
                                display: flex;
                                align-items: center;
                                justify-content: center;
                                font-size: 11px;
                                font-weight: 700;
                                box-shadow: 0 2px 8px rgba(255, 71, 87, 0.4);
                                animation: qwen-pulse 2s infinite;
                            }

                            @@media (max-width: 768px) {
                                #qwen-toggle-btn {
                                    width: 54px;
                                    height: 54px;
                                }

                                .qwen-btn-icon {
                                    width: 54px;
                                    height: 54px;
                                    font-size: 22px;
                                }
                            }

                            @@media (max-width: 480px) {
                                #qwen-toggle-btn {
                                    width: 52px;
                                    height: 52px;
                                }

                                .qwen-btn-icon {
                                    width: 52px;
                                    height: 52px;
                                    font-size: 20px;
                                }
                            }

                            @@media (max-width: 360px) {
                                #qwen-toggle-btn {
                                    width: 48px;
                                    height: 48px;
                                }

                                .qwen-btn-icon {
                                    width: 48px;
                                    height: 48px;
                                    font-size: 14px;
                                }
                            }

                            @@keyframes qwen-pulse {
                                0%, 100% { transform: scale(1); }
                                50% { transform: scale(1.1); }
                            }

                            /* Chat Box */
                            #qwen-chat-box { 
                                width: 420px; 
                                height: 600px; 
                                background: #ffffff; 
                                border-radius: 20px; 
                                box-shadow: 0 20px 60px rgba(0,0,0,0.15); 
                                display: flex; 
                                flex-direction: column; 
                                overflow: hidden; 
                                margin-bottom: 15px; 
                                border: 1px solid #e8e8e8;
                                animation: qwen-slide-up 0.3s ease-out;
                            }

                            @@keyframes qwen-slide-up {
                                from {
                                    opacity: 0;
                                    transform: translateY(20px);
                                }
                                to {
                                    opacity: 1;
                                    transform: translateY(0);
                                }
                            }

                            .qwen-hidden { 
                                display: none !important; 
                            }

                            /* Header */
                            #qwen-chat-header { 
                                background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); 
                                color: white; 
                                padding: 20px; 
                                display: flex; 
                                justify-content: space-between; 
                                align-items: center;
                                flex-shrink: 0;
                            }

                            .qwen-header-left {
                                display: flex;
                                align-items: center;
                                gap: 12px;
                            }

                            .qwen-avatar {
                                width: 45px;
                                height: 45px;
                                background: rgba(255,255,255,0.2);
                                border-radius: 50%;
                                display: flex;
                                align-items: center;
                                justify-content: center;
                                font-size: 22px;
                                backdrop-filter: blur(10px);
                                border: 2px solid rgba(255,255,255,0.3);
                            }

                            .qwen-header-info {
                                flex: 1;
                            }

                            .qwen-header-title {
                                font-weight: 700;
                                font-size: 16px;
                                margin-bottom: 2px;
                            }

                            .qwen-header-status {
                                font-size: 12px;
                                opacity: 0.9;
                                display: flex;
                                align-items: center;
                                gap: 6px;
                            }

                            .qwen-status-dot {
                                width: 8px;
                                height: 8px;
                                background: #4ade80;
                                border-radius: 50%;
                                display: inline-block;
                                animation: qwen-status-pulse 2s infinite;
                            }

                            @@keyframes qwen-status-pulse {
                                0%, 100% { opacity: 1; }
                                50% { opacity: 0.5; }
                            }

                            .qwen-header-actions {
                                display: flex;
                                gap: 8px;
                            }

                            .qwen-header-btn { 
                                background: rgba(255,255,255,0.15); 
                                border: none; 
                                color: white; 
                                cursor: pointer; 
                                border-radius: 50%; 
                                width: 32px; 
                                height: 32px; 
                                display: flex; 
                                align-items: center; 
                                justify-content: center; 
                                transition: all 0.2s;
                                font-size: 14px;
                            }

                            .qwen-header-btn:hover { 
                                background: rgba(255,255,255,0.25); 
                                transform: scale(1.05);
                            }

                            /* Quick Actions */
                            .qwen-quick-actions {
                                padding: 15px 20px;
                                background: #f8fafc;
                                border-bottom: 1px solid #e8e8e8;
                                display: flex;
                                gap: 8px;
                                flex-wrap: wrap;
                                flex-shrink: 0;
                            }

                            .qwen-quick-btn {
                                flex: 1;
                                min-width: 90px;
                                padding: 10px 12px;
                                background: white;
                                border: 1px solid #e2e8f0;
                                border-radius: 12px;
                                font-size: 12px;
                                font-weight: 500;
                                color: #475569;
                                cursor: pointer;
                                transition: all 0.2s;
                                display: flex;
                                align-items: center;
                                justify-content: center;
                                gap: 6px;
                                touch-action: manipulation;
                                -webkit-tap-highlight-color: transparent;
                            }

                            .qwen-quick-btn:hover {
                                background: #667eea;
                                color: white;
                                border-color: #667eea;
                                transform: translateY(-2px);
                                box-shadow: 0 4px 12px rgba(102, 126, 234, 0.3);
                            }

                            .qwen-quick-btn:active {
                                background: #5a6fd6;
                                color: white;
                                border-color: #5a6fd6;
                                transform: scale(0.95);
                            }

                            .qwen-quick-btn i {
                                font-size: 14px;
                            }

                            /* Chat Body */
                            #qwen-chat-body { 
                                flex: 1; 
                                padding: 20px; 
                                overflow-y: auto; 
                                background: linear-gradient(180deg, #f8fafc 0%, #ffffff 100%);
                                display: flex; 
                                flex-direction: column; 
                                gap: 12px; 
                            }

                            #qwen-chat-body::-webkit-scrollbar { 
                                width: 6px; 
                            }

                            #qwen-chat-body::-webkit-scrollbar-track {
                                background: transparent;
                            }

                            #qwen-chat-body::-webkit-scrollbar-thumb { 
                                background-color: #cbd5e1; 
                                border-radius: 10px; 
                            }

                            /* Welcome Container */
                            .qwen-welcome-container {
                                text-align: center;
                                padding: 30px 20px;
                                display: flex;
                                flex-direction: column;
                                align-items: center;
                                gap: 12px;
                            }

                            .qwen-welcome-icon {
                                width: 70px;
                                height: 70px;
                                background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
                                border-radius: 50%;
                                display: flex;
                                align-items: center;
                                justify-content: center;
                                font-size: 32px;
                                color: white;
                                box-shadow: 0 8px 25px rgba(102, 126, 234, 0.3);
                            }

                            .qwen-welcome-title {
                                font-size: 20px;
                                font-weight: 700;
                                color: #1e293b;
                            }

                            .qwen-welcome-text {
                                font-size: 14px;
                                color: #64748b;
                                line-height: 1.6;
                                max-width: 300px;
                            }

                            /* Messages */
                            .qwen-message { 
                                max-width: 85%; 
                                padding: 14px 18px; 
                                border-radius: 18px; 
                                font-size: 14px; 
                                line-height: 1.6; 
                                word-wrap: break-word;
                                animation: qwen-message-slide 0.3s ease-out;
                                box-shadow: 0 2px 8px rgba(0,0,0,0.06);
                            }

                            @@keyframes qwen-message-slide {
                                from {
                                    opacity: 0;
                                    transform: translateY(10px);
                                }
                                to {
                                    opacity: 1;
                                    transform: translateY(0);
                                }
                            }

                            .qwen-message p { 
                                margin: 0 0 8px 0; 
                            }

                            .qwen-message p:last-child { 
                                margin: 0; 
                            }

                            .qwen-message strong { 
                                font-weight: 700; 
                            }

                            .qwen-message ul, .qwen-message ol { 
                                margin: 8px 0; 
                                padding-left: 20px; 
                            }

                            .qwen-bot { 
                                background-color: #ffffff; 
                                color: #334155; 
                                align-self: flex-start; 
                                border-bottom-left-radius: 6px;
                                border: 1px solid #e2e8f0;
                            }

                            .qwen-user { 
                                background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); 
                                color: white; 
                                align-self: flex-end; 
                                border-bottom-right-radius: 6px;
                                box-shadow: 0 4px 15px rgba(102, 126, 234, 0.3);
                            }

                            /* Typing Indicator */
                            .qwen-typing-indicator {
                                display: flex;
                                align-items: center;
                                gap: 10px;
                                padding: 12px 18px;
                                background: #f8fafc;
                                border-radius: 18px;
                                border: 1px solid #e2e8f0;
                                margin-top: 8px;
                            }

                            .qwen-typing-avatar {
                                width: 32px;
                                height: 32px;
                                background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
                                border-radius: 50%;
                                display: flex;
                                align-items: center;
                                justify-content: center;
                                color: white;
                                font-size: 14px;
                            }

                            .qwen-typing-dots {
                                display: flex;
                                gap: 3px;
                                align-items: center;
                            }

                            .qwen-typing-dots span {
                                width: 6px;
                                height: 6px;
                                background-color: #667eea;
                                border-radius: 50%;
                                animation: qwen-typing 1.4s infinite ease-in-out both;
                                box-shadow: 0 0 6px rgba(102, 126, 234, 0.6);
                            }

                            .qwen-typing-dots span:nth-child(1) { animation-delay: -0.32s; }
                            .qwen-typing-dots span:nth-child(2) { animation-delay: -0.16s; }

                            @@keyframes qwen-typing {
