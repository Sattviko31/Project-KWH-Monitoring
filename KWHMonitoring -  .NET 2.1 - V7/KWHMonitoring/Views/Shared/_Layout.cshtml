@using KWHMonitoring.Models
@inject ApplicationDbContext Db
@{
    var _footerSettings = Db.AppSettingsRecords.ToDictionary(x => x.SettingKey, x => x.SettingValue);
    string _GetFooterSetting(string key, string defaultValue = "")
    {
        return _footerSettings.TryGetValue(key, out var value) ? value : defaultValue;
    }
    var _dbServer = _GetFooterSetting("Database.Server", "192.168.6.15");
    var _dbName = _GetFooterSetting("Database.Name", "HaiwellElectrical");
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - KWH Monitoring</title>
    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/bootstrap5-compat.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/lib/devextreme/css/dx.common.css" />
    <link rel="stylesheet" href="~/lib/devextreme/css/dx.light.css" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <!-- SIDEBAR -->
    <aside class="erp-sidebar" id="erpSidebar">
        <div class="sidebar-brand">
            <div class="brand-banner">
                <span class="brand-warna">KWH</span>
                <span class="brand-monitoring">MONITORING</span>
            </div>
            <div class="brand-subtitle">Haiwell Electrical System</div>
        </div>

        <div class="sidebar-search">
            <div class="input-group">
                <span class="input-group-text"><i class="fas fa-search"></i></span>
                <input type="text" class="form-control" placeholder="Search..." id="sidebarSearch">
            </div>
        </div>

        <nav class="sidebar-nav">
            <ul class="nav flex-column">
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Monitoring" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")"
                       asp-controller="Monitoring" asp-action="Index">
                        <i class="fas fa-tachometer-alt"></i>
                        <span>Dashboard</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Charts" ? "active" : "")"
                       asp-controller="Monitoring" asp-action="Charts">
                        <i class="fas fa-chart-line"></i>
                        <span>All Charts</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "UsageStatistics" ? "active" : "")"
                       asp-controller="Monitoring" asp-action="UsageStatistics">
                        <i class="fas fa-chart-bar"></i>
                        <span>Usage Statistics</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "History" ? "active" : "")"
                       asp-controller="Monitoring" asp-action="History">
                        <i class="fas fa-history"></i>
                        <span>History</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "AnomalyLogs" ? "active" : "")"
                       asp-controller="Monitoring" asp-action="AnomalyLogs">
                        <i class="fas fa-exclamation-triangle"></i>
                        <span>Anomaly Logs</span>
                        <span class="badge bg-danger ms-auto" id="anomalyBadge">0</span>
                    </a>
                </li>

                <li class="nav-section-title">KONFIGURASI</li>

                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Settings" ? "active" : "")"
                       asp-controller="Monitoring" asp-action="Settings">
                        <i class="fas fa-cog"></i>
                        <span>Settings</span>
                    </a>
                </li>
            </ul>
        </nav>

        <div class="sidebar-footer">
            <div class="sidebar-server-info">
                <i class="fas fa-server"></i>
                <small>@_dbServer | @_dbName</small>
            </div>
        </div>
    </aside>

    <!-- SIDEBAR OVERLAY (mobile) -->
    <div class="sidebar-overlay" id="sidebarOverlay"></div>

    <!-- MAIN WRAPPER -->
    <div class="erp-main-wrapper" id="erpMainWrapper">
        <!-- TOP HEADER BAR -->
        <header class="erp-topbar">
            <div class="topbar-left">
                <button class="btn btn-link topbar-toggle" id="sidebarToggle" type="button">
                    <i class="fas fa-bars"></i>
                </button>
                <a class="topbar-brand" asp-controller="Monitoring" asp-action="Index">
                    <i class="fas fa-bolt text-warning"></i> <span class="d-none d-sm-inline">KWH Monitoring</span>
                </a>
            </div>
            <div class="topbar-right">
                <span class="topbar-clock d-none d-md-inline">
                    <i class="fas fa-clock"></i> @DateTime.Now.ToString("dd MMM yyyy HH:mm")
                </span>
                <button class="btn btn-link topbar-icon-btn" id="topbarNotifications" title="Notifications">
                    <i class="fas fa-bell"></i>
                    <span class="topbar-badge bg-danger" id="topbarAnomalyBadge">0</span>
                </button>
                <div class="topbar-user">
                    <div class="topbar-user-avatar">
                        <i class="fas fa-user-circle"></i>
                    </div>
                    <div class="topbar-user-info d-none d-md-block">
                        <span class="topbar-user-name">Administrator</span>
                        <span class="topbar-user-email">admin@haiwell.com</span>
                    </div>
                </div>
            </div>
        </header>

        <!-- MAIN CONTENT -->
        <div class="erp-content">
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade in" role="alert">
                    <i class="fas fa-exclamation-triangle"></i> @TempData["Error"]
                    <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
                </div>
            }
            @RenderBody()
        </div>

        <!-- FOOTER -->
        <footer class="erp-footer">
            <div class="container-fluid">
                <div class="row align-items-center">
                    <div class="col-md-6">
                        &copy; @DateTime.Now.Year - KWH Monitoring System - Haiwell Electrical
                    </div>
                    <div class="col-md-6 text-md-end">
                        <i class="fas fa-server"></i> Server: @_dbServer | Database: @_dbName
                    </div>
                </div>
            </div>
        </footer>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/devextreme/js/dx.all.js"></script>
    <script src="~/lib/bootstrap/js/bootstrap.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <!-- Custom Tab Handler — completely replaces BS3's tab data-api -->
    <script>
        $(function() {
            // 1. Remove BS3's native tab click handlers (they conflict with our CSS)
            $(document).off('click.bs.tab.data-api');

            // 2. Ensure initial active tab panes have 'in' class
            $('.tab-content').each(function() {
                $(this).find('.tab-pane.active').addClass('in');
            });

            // 3. Our own tab click handler — fully controls tab switching
            $(document).on('click.customTab', '[data-toggle="tab"], [data-toggle="pill"]', function(e) {
                e.preventDefault();
                e.stopImmediatePropagation();

                var $clickedTab = $(this);
                var targetSelector = $clickedTab.attr('href');

                if (!targetSelector || targetSelector === '#' || targetSelector === '') return;

                // Find the nav this tab belongs to
                var $nav = $clickedTab.closest('.nav');
                if (!$nav.length) $nav = $clickedTab.closest('ul');

                // Find the tab-content — could be next sibling or in same parent
                var $tabContent = $nav.nextAll('.tab-content').first();
                if (!$tabContent.length) {
                    $tabContent = $nav.parent().find('.tab-content').first();
                }
                if (!$tabContent.length) return;

                // Skip if already active
                if ($clickedTab.hasClass('active') && $(targetSelector).hasClass('active')) return;

                // Find the previously active tab (BEFORE removing active class)
                var $previous = $nav.find('.nav-link.active, .erp-tab.active');

                // Deactivate all tab links in this nav
                $nav.find('.nav-link, .erp-tab').removeClass('active');
                $nav.find('li').removeClass('active');

                // Activate clicked tab link
                $clickedTab.addClass('active');
                $clickedTab.closest('li').addClass('active');

                // Hide all tab panes
                $tabContent.find('.tab-pane').removeClass('active in');

                // Show target tab pane
                var $target = $(targetSelector);
                $target.addClass('active');
                // Force reflow before adding 'in' for fade effect
                $target[0] && $target[0].offsetWidth;
                $target.addClass('in');

                // Fire BS3-compatible events so page-specific JS still works
                $clickedTab.trigger($.Event('shown.bs.tab', {
                    relatedTarget: $previous[0]
                }));
            });
        });
    </script>

    <!-- SIDEBAR TOGGLE SCRIPT -->
    <script>
        (function() {
            const sidebar = document.getElementById('erpSidebar');
            const overlay = document.getElementById('sidebarOverlay');
            const toggle = document.getElementById('sidebarToggle');
            const wrapper = document.getElementById('erpMainWrapper');

            function openSidebar() {
                sidebar.classList.add('show');
                overlay.classList.add('show');
                document.body.classList.add('sidebar-open');
            }

            function closeSidebar() {
                sidebar.classList.remove('show');
                overlay.classList.remove('show');
                document.body.classList.remove('sidebar-open');
            }

            toggle.addEventListener('click', function() {
                if (window.innerWidth < 992) {
                    if (sidebar.classList.contains('show')) {
                        closeSidebar();
                    } else {
                        openSidebar();
                    }
                } else {
                    sidebar.classList.toggle('collapsed');
                    wrapper.classList.toggle('sidebar-collapsed');
                }
            });

            overlay.addEventListener('click', closeSidebar);

            // Sync anomaly badge between sidebar and topbar
            function syncAnomalyBadges() {
                const sidebarBadge = document.getElementById('anomalyBadge');
                const topbarBadge = document.getElementById('topbarAnomalyBadge');
                if (sidebarBadge && topbarBadge) {
                    topbarBadge.textContent = sidebarBadge.textContent;
                    topbarBadge.style.display = sidebarBadge.textContent === '0' ? 'none' : 'inline-block';
                }
            }
            setInterval(syncAnomalyBadges, 5000);

            // Search filter
            const searchInput = document.getElementById('sidebarSearch');
            if (searchInput) {
                searchInput.addEventListener('input', function() {
                    const val = this.value.toLowerCase();
                    document.querySelectorAll('.sidebar-nav .nav-link').forEach(function(link) {
                        const text = link.textContent.toLowerCase();
                        link.closest('.nav-item').style.display = text.includes(val) ? '' : 'none';
                    });
                });
            }
        })();
    </script>

    <!-- ANOMALY BACKGROUND SERVICE -->
    @await Html.PartialAsync("_AnomalyService")

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
