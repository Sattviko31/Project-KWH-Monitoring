                        <!-- ========================================== -->
                        <!-- JAVASCRIPT LOGIC WIDGET                    -->
                        <!-- ========================================== -->
                        <script>
                            // Load chat history from localStorage on page load
                            let chatHistory = [];
                            try {
                                const savedHistory = localStorage.getItem('qwen_chat_history');
                                if (savedHistory) {
                                    chatHistory = JSON.parse(savedHistory);
                                    @* console.log('[QwenChat] ? History loaded from localStorage:', chatHistory.length, 'messages'); *@
                                }
                            } catch (e) {
                                @* console.warn('[QwenChat] ?? Failed to load history from localStorage:', e); *@
                            }

                            let cachedRealTimeData = null;
                            let isFetchingData = false;
                            let isSending = false;

                            function toggleQwenChat() {
                                const chatBox = document.getElementById('qwen-chat-box');
                                const toggleBtn = document.getElementById('qwen-toggle-btn');
                                if (chatBox.classList.contains('qwen-hidden')) {
                                    chatBox.classList.remove('qwen-hidden');
                                    toggleBtn.classList.add('qwen-hidden');
                                    document.getElementById('qwen-chat-input').focus();

                                    // Scroll to bottom to show latest messages
                                    scrollToBottom();

                                    // Fetch data realtime saat chat dibuka
                                    refreshRealTimeData();
                                } else {
                                    chatBox.classList.add('qwen-hidden');
                                    toggleBtn.classList.remove('qwen-hidden');
                                }
                            }

                            // Save chat history to localStorage
                            function saveChatHistory() {
                                try {
                                    localStorage.setItem('qwen_chat_history', JSON.stringify(chatHistory));
                                    @* console.log('[QwenChat] ?? History saved to localStorage:', chatHistory.length, 'messages'); *@
                                } catch (e) {
                                    @* console.warn('[QwenChat] ?? Failed to save history to localStorage:', e); *@
                                }
                            }

                            // Clear chat history
                            function clearChatHistory() {
                                chatHistory = [];
                                saveChatHistory();
                                @* console.log('[QwenChat] Chat history cleared'); *@
                                // Clear chat body and restore default welcome container
                                const chatBody = document.getElementById('qwen-chat-body');
                                chatBody.innerHTML = '<div class="qwen-welcome-container">' +
                                    '<div class="qwen-welcome-icon"><i class="fas fa-comments"></i></div>' +
                                    '<div class="qwen-welcome-title">Selamat Datang!</div>' +
                                    '<div class="qwen-welcome-text" id="qwen-welcome-message">Saya Voltra, asisten AI KWH Monitoring. Tanyakan tentang data listrik, panel, tagihan, atau anomali.</div>' +
                                    '</div>';
                            }

                            // Render chat history from localStorage on page load
                            function renderChatHistory() {
                                if (chatHistory.length === 0) {
                                    @* console.log('[QwenChat] ?? No chat history to render'); *@
                                    return;
                                }

                                const chatBody = document.getElementById('qwen-chat-body');
                                const welcomeMsg = document.getElementById('qwen-welcome-message');
                                
                                // Hide or remove welcome message
                                if (welcomeMsg) {
                                    welcomeMsg.style.display = 'none';
                                }

                                // Clear existing messages (except welcome)
                                chatBody.innerHTML = '';

                                // Render each message
                                chatHistory.forEach(msg => {
                                    const msgDiv = document.createElement('div');
                                    msgDiv.className = 'qwen-message ' + (msg.Role === 'user' ? 'qwen-user' : 'qwen-bot');
                                    
                                    if (msg.Role === 'user') {
                                        msgDiv.innerHTML = '<strong>Anda:</strong><br/>' + escapeHtml(msg.Content);
                                    } else {
                                        // Render bot message with markdown support if marked is available
                                        if (typeof marked !== 'undefined') {
                                            msgDiv.innerHTML = '<strong>Voltra:</strong><br/>' + marked.parse(msg.Content);
                                        } else {
                                            msgDiv.innerHTML = '<strong>Voltra:</strong><br/>' + escapeHtml(msg.Content).replace(/\n/g, '<br/>');
                                        }
                                    }
                                    
                                    chatBody.appendChild(msgDiv);
                                });

                                // Scroll to bottom
                                scrollToBottom();
                                @* console.log('[QwenChat] ? Rendered', chatHistory.length, 'messages from localStorage'); *@
                            }

                            // Helper function to escape HTML
                            function escapeHtml(text) {
                                const div = document.createElement('div');
                                div.textContent = text;
                                return div.innerHTML;
                            }

                            function handleQwenEnter(event) {
                                if (event.key === 'Enter') sendQwenMessage();
                            }

                            // Send quick message from quick action buttons
                            function sendQuickMessage(message) {
                                document.getElementById('qwen-chat-input').value = message;
                                sendQwenMessage();
                            }
                            
                            // Fetch data realtime dan cache
                            async function refreshRealTimeData() {
                                if (isFetchingData) return;
                                isFetchingData = true;
                                cachedRealTimeData = null;
                                
                                 try {
                                    @* console.log('[QwenChat] Memuat data realtime...'); *@
                                    const data = await getRealTimeDashboardData();
                                    if (data && !data.error) {
                                        cachedRealTimeData =  data;
                                        @* console.log('[QwenChat] ? Data realtime tersimpan di cache:', {
                                            panels: data.panels?.length || 0,
                                            timestamp: data.timestamp
                                        }); *@
                                    }
                                 } catch (err) {
                                    @* console.error('[QwenChat] Gagal memuat data realtime:', err); *@
                                } finally {
                                    isFetchingData = false;
                                }
                            }

                            // LOGIKA PENGAMBILAN DATA REAL-TIME (OPTIMIZED)
                            // Mengambil data langsung dari API internal � bukan scrape DOM
                            // Agar chatbot mendapat data terstruktur, akurat, dan per-panel
                            async function getRealTimeDashboardData() {
                                 try {
                                    @* console.log('[QwenCh at] ?? Fetch dari /api/qwenchat/current-dashboard-data...'); *@
                                    const apiResponse = await fetch('/api/qwenchat/current-dashboard-data?t=' + Date.now(), {
                                        method: 'GET',
                                        credentials: 'same-origin'
                                     });

                                    @* console.log('[Qwen Chat] ?? Response status:', apiResponse.status); *@
                                    
                                    if (apiResponse.ok) {
                                        const jsonData = await apiResponse.json();
                                        @* console.log('[QwenChat] JSON berhasil di-parse!'); *@
                                        @* console.log('[QwenChat] ?? Data detail:', {
                                            panels: jsonData.panels?.length || 0,
                                            hasUsageStats: !!jsonData.usageStatistics,
                                            hasSystemStats: !!jsonData.systemStatistics,
                                            hasAnomalies: !!jsonData.anomalies,
                                            hasCharts: jsonData.chartHistory?.length || 0,
                                            hasTariff: !!jsonData.tariff,
                                            databaseTables: jsonData.databaseTables,
                                            source: jsonData.source,
                                            error:  jsonData.error
                                        }); *@
                                        
                                        // Cek apakah data valid
                                        if (jsonData.error) {
                                            @* console.error('[QwenChat] API mengembalikan error:', jsonData.error); *@
                                        }
                                        
                                        if (jsonData.panels?.length === 0) {
                                            @* console.warn('[QwenChat] ?? PANELS KOSONG! Database mungkin belum ada data.'); *@
                                        }
                                        
                                        return jsonData; // Kirim sebagai objek JSON (bukan string)
                                    } else {
                                    throw new Error('Snapshot database gagal: HTTP ' + apiResponse.status);
                                }
                            } catch (e) {
                                @* console.error('[QwenChat] Gagal mengambil snapshot database:', e); *@
                                return null;
                            }
                        }
                            async function sendQwenMessage() {
                                if (isSending) return; // Prevent double-send (e.g. quick action while previous message still processing)

                                const inputElement = document.getElementById('qwen-chat-input');
                                const sendBtn = document.getElementById('qwen-send-btn');
                                const messageText = inputElement.value.trim();

                                if (!messageText) return;

                                isSending = true;
                                appendMessage(messageText, 'user', false);
                                inputElement.value = '';
                                inputElement.disabled = true;
                                sendBtn.disabled = true;

                                const loadingId = appendLoading();

                                // Selalu ambil data realtime terbaru sebelum mengirim pesan
                                @* console.log('[QwenChat] ?? Refresh data realtime sebelum kirim pesan...'); *@
                                await refreshRealTimeData();

                                // Gunakan data dari cache
                                let currentScreenData = cachedRealTimeData;

                                // Jika cache masih kosong, coba ambil sekali lagi
                                if (!currentScreenData) {
                                    /* console.warn('[QwenChat] Cache kosong, mencoba ambil ulang...') */;
                                    currentScreenData = await getRealTimeDashboardData();
                                    cachedRealTimeData = currentScreenData;
                                }

                                // VALIDASI: Cek apakah data valid
                                const isRealObject = typeof currentScreenData === 'object' && currentScreenData !== null && !Array.isArray(currentScreenData) && !currentScreenData.error && currentScreenData.databaseTables;

                                @* console.log('[QwenChat] ?? Validasi Data:', {
                                    type: isRealObject ? 'OBJECT (VALID)' : typeof currentScreenData,
                                    panels: isRealObject ? (currentScreenData.panels?.length || 0) : 'NOT_FOUND',
                                    usageStatistics: isRealObject ? (currentScreenData.usageStatistics ? 'ADA' : 'TIDAK ADA') : 'NOT_FOUND',
                                    systemStatistics: isRealObject ? (currentScreenData.systemStatistics ? 'ADA' : 'TIDAK ADA') : 'NOT_FOUND',
                                    anomalies: isRealObject ? (currentScreenData.anomalies ? 'ADA' : 'TIDAK ADA') : 'NOT_FOUND',
                                    chartHistory: isRealObject ? (currentScreenData.chartHistory?.length || 0) : 'NOT_FOUND',
                                    tariff: isRealObject ? (currentScreenData.tariff ? 'ADA' : 'TIDAK ADA') : 'NOT_FOUND',
                                    source: isRealObject ? currentScreenData.source : 'NOT_FOUND'
                                }); *@

                                if (!isRealObject) {
                                    @* console.error('[QwenChat] ? ERROR: RealTimeData bukan object!'); *@
                                    removeElement(loadingId);
                                    var isEnglish = (function () { try { return localStorage.getItem('kwh_language') === 'en'; } catch (e) { return false; } })();
                                    appendMessage(isEnglish ? 'The database snapshot is unavailable. Check the system connection and try again.' : 'Data terbaru dari basis data tidak tersedia. Periksa koneksi sistem, lalu coba lagi.', 'bot', false);
                                    inputElement.disabled = false;
                                    sendBtn.disabled = false;
                                    isSending = false;
                                    return;
                                }

                                if (currentScreenData.panels?.length === 0) {
                                    @* console.warn('[QwenChat] ?? WARNING: Tidak ada panel aktif di database!'); *@
                                    removeElement(loadingId);
                                    var isEnglish = (function () { try { return localStorage.getItem('kwh_language') === 'en'; } catch (e) { return false; } })();
                                    appendMessage(isEnglish ? 'No active panels were found. Make sure a device has sent data, then try again.' : 'Tidak ditemukan panel aktif. Pastikan perangkat telah mengirimkan data, lalu coba lagi.', 'bot', false);
                                    inputElement.disabled = false;
                                    sendBtn.disabled = false;
                                    isSending = false;
                                    return;
                                }

                                const payload = {
                                    Message: messageText,
                                    History: chatHistory,
                                    RealTimeData: currentScreenData,
                                    Language: (function () { try { return localStorage.getItem('kwh_language') === 'en' ? 'en' : 'id'; } catch (e) { return 'id'; } })()
                                };

                                try {
                                    const response = await fetch('/api/qwenchat/send', {
                                        method: 'POST',
                                        headers: { 'Content-Type': 'application/json' },
                                        body: JSON.stringify(payload)
                                    });

                                    const data = await response.json();
                                    removeElement(loadingId);

                                    if (data.success) {
                                        appendMessage(data.reply, 'bot', true);
                                        if (typeof window.queueActivityNotification === 'function') {
                                            window.queueActivityNotification({
                                                id: 'chat-' + Date.now() + '-' + Math.random().toString(36).slice(2, 8),
                                                category: 'AI Chatbot',
                                                title: 'Respons Voltra',
                                                message: String(data.reply || '').slice(0, 500),
                                                severity: 'info',
                                                timestamp: new Date().toISOString()
                                            });
                                        }
                                        chatHistory.push({ Role: 'user', Content: messageText });
                                        chatHistory.push({ Role: 'assistant', Content: data.reply });
                                        saveChatHistory();
                                    } else {
                                        var isEnglish = (function () { try { return localStorage.getItem('kwh_language') === 'en'; } catch (e) { return false; } })();
                                        appendMessage(isEnglish ? 'Sorry, I could not prepare a response. Please try again.' : 'Maaf, jawaban tidak dapat disiapkan. Silakan coba lagi.', 'bot', false);
                                    }
                                } catch (error) {
                                    removeElement(loadingId);
                                    var isEnglish = (function () { try { return localStorage.getItem('kwh_language') === 'en'; } catch (e) { return false; } })();
                                    appendMessage(isEnglish ? 'Could not connect to the server. Check your connection and try again.' : 'Tidak dapat terhubung ke server. Periksa koneksi Anda, lalu coba lagi.', 'bot', false);
                                } finally {
                                    inputElement.disabled = false;
                                    sendBtn.disabled = false;
                                    isSending = false;
                                    inputElement.focus();
                                }
                            }

                            function appendMessage(text, sender, parseMarkdown) {
                                const chatBody = document.getElementById('qwen-chat-body');
                                const welcomeMsg = document.getElementById('qwen-welcome-message');
                                
                                // Hide welcome message on first message
                                if (welcomeMsg && chatBody.children.length === 1) {
                                    welcomeMsg.style.display = 'none';
                                }

                                const msgDiv = document.createElement('div');
                                msgDiv.className = 'qwen-message ' + (sender === 'user' ? 'qwen-user' : 'qwen-bot');

                                if (parseMarkdown && typeof marked !== 'undefined') {
                                    msgDiv.innerHTML = marked.parse(text);
                                } else {
                                    msgDiv.textContent = text;
                                }

                                chatBody.appendChild(msgDiv);
                                scrollToBottom();
                            }

                            function appendLoading() {
                                const chatBody = document.getElementById('qwen-chat-body');
                                const msgDiv = document.createElement('div');
                                const id = 'loading-' + Date.now();
                                msgDiv.id = id;
                                msgDiv.className = 'qwen-message qwen-bot qwen-electric-loading';
                                msgDiv.innerHTML = '<div class="qwen-loading-dots"><span></span><span></span><span></span><span></span><span></span></div>';
                                chatBody.appendChild(msgDiv);
                                scrollToBottom();
                                return id;
                            }

                            function removeElement(id) {
                                const el = document.getElementById(id);
                                if (el) el.remove();
                            }

                            function scrollToBottom() {
                                const chatBody = document.getElementById('qwen-chat-body');
                                // Use smooth scrolling for mobile devices
                                chatBody.scrollTo({
                                    top: chatBody.scrollHeight,
                                    behavior: 'smooth'
                                });
                            }

                            // Handle swipe gestures for mobile
                            let touchStartY = 0;
                            let touchEndY = 0;
                            let startY = 0;
                            let currentY = 0;
                            let isDragging = false;

                            function handleTouchStart(event) {
                                touchStartY = event.touches[0].clientY;
                                touchEndY = touchStartY; // Reset to avoid stale value causing false swipe-close on tap
                                startY = parseInt(document.getElementById('qwen-chat-box').style.transform.replace('translateY(', '').replace('px)', ''), 10) || 0;
                                isDragging = true;
                            }

                            function handleTouchMove(event) {
                                if (!isDragging) return;

                                touchEndY = event.touches[0].clientY;
                                const diff = touchStartY - touchEndY;

                                // Only start drag gesture after a clear vertical swipe (15px)
                                // so small taps and normal scrolling inside chat body are not blocked
                                if (Math.abs(diff) > 15) {
                                    currentY = startY + diff;
                                    // Apply resistance effect when pulling down
                                    if (currentY > 0) {
                                        currentY = currentY * 0.5; // Resistance when pulling down
                                    }
                                    document.getElementById('qwen-chat-box').style.transform = `translateY(${currentY}px)`;
                                    event.preventDefault(); // Prevent scrolling only during intentional drag
                                }
                            }

                            function handleTouchEnd() {
                                if (!isDragging) return;
                                
                                const diff = touchStartY - touchEndY;
                                const swipeThreshold = 80; // Increased threshold for intentional close
                                
                                if (Math.abs(diff) > swipeThreshold && diff > 0) {
                                    // Swipe down - close/minimize
                                    toggleQwenChat();
                                } else {
                                    // Reset position if not enough swipe
                                    document.getElementById('qwen-chat-box').style.transition = 'transform 0.3s ease-out';
                                    document.getElementById('qwen-chat-box').style.transform = 'translateY(0)';
                                    
                                    // Remove transition after animation completes
                                    setTimeout(() => {
                                        document.getElementById('qwen-chat-box').style.transition = '';
                                    }, 300);
                                }
                                
                                isDragging = false;
                            }

                            // Initialize touch events for mobile
                            document.addEventListener('DOMContentLoaded', function() {
                                // Initialize chat history when page loads
                                renderChatHistory();
                                
                                // Initialize all event handlers after DOM is loaded
                                initializeQwenChatEvents();
                            });
                            
                            // Initialize all chatbot event handlers
                            function initializeQwenChatEvents() {
                                const toggleBtn = document.getElementById('qwen-toggle-btn');
                                if (toggleBtn) {
                                    toggleBtn.onclick = function() {
                                        toggleQwenChat();
                                    };
                                }
                                
                                const minimizeBtn = document.getElementById('qwen-minimize-btn');
                                if (minimizeBtn) {
                                    minimizeBtn.onclick = function() {
                                        toggleQwenChat();
                                    };
                                }
                                
                                const clearBtn = document.getElementById('qwen-clear-btn');
                                if (clearBtn) {
                                    clearBtn.onclick = function() {
                                        clearChatHistory();
                                    };
                                }
                                
                                const sendBtn = document.getElementById('qwen-send-btn');
                                if (sendBtn) {
                                    sendBtn.onclick = function() {
                                        sendQwenMessage();
                                    };
                                }
                                
                                const chatInput = document.getElementById('qwen-chat-input');
                                if (chatInput) {
                                    chatInput.onkeypress = function(event) {
                                        handleQwenEnter(event);
                                    };
                                }
                                
                                // Initialize quick action buttons — use data-message attribute (more reliable than onclick parsing)
                                const quickActionButtons = document.querySelectorAll('.qwen-quick-btn');
                                quickActionButtons.forEach(function(btn) {
                                    const message = btn.getAttribute('data-message');
                                    if (message) {
                                        btn.addEventListener('click', function(e) {
                                            e.preventDefault();
                                            e.stopPropagation();
                                            sendQuickMessage(message);
                                        });
                                    }
                                });
                                
                                // Initialize touch events for mobile — swipe-to-close only on chat header,
                                // NOT on the entire chat box (so tapping messages/input/quick-actions won't close the widget)
                                const chatHeader = document.getElementById('qwen-chat-header');
                                if (chatHeader) {
                                    chatHeader.addEventListener('touchstart', handleTouchStart, false);
                                    chatHeader.addEventListener('touchmove', handleTouchMove, false);
                                    chatHeader.addEventListener('touchend', handleTouchEnd, false);
                                }

                                const chatBox = document.getElementById('qwen-chat-box');
                                if (chatBox) {
                                    // Reset any transform styles when showing/hiding
                                    const observer = new MutationObserver(function(mutations) {
                                        mutations.forEach(function(mutation) {
                                            if (mutation.type === 'attributes' && mutation.attributeName === 'class') {
                                                if (!chatBox.classList.contains('qwen-hidden')) {
                                                    chatBox.style.transform = '';
                                                    chatBox.style.transition = '';
                                                }
                                            }
                                        });
                                    });
                                    
                                    observer.observe(chatBox, {
                                        attributes: true,
                                        attributeFilter: ['class']
                                    });
                                }
                            }

                        </script>



    <script>
        // CSRF token helper: attach anti-forgery token to all mutating AJAX requests
        (function() {
            var csrfToken = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content') || '';
            if (typeof jQuery !== 'undefined') {
                $(document).ajaxSend(function(e, xhr, options) {
                    var method = (options.type || 'GET').toUpperCase();
                    if (method === 'POST' || method === 'PUT' || method === 'DELETE' || method === 'PATCH') {
                        xhr.setRequestHeader('RequestVerificationToken', csrfToken);
                    }
                });
                // Global 401 handler: redirect to login if session expired
                // Untuk pengunjung TANPA login (IS_USER_AUTHENTICATED === false):
                // JANGAN redirect paksa — cukup catat ke console, agar halaman
                // yang memang publik tetap terbuka tanpa "ditarik" ke halaman Login.
                $(document).ajaxError(function(e, xhr, options) {
                    if (xhr.status === 401 && !options._authRedirecting) {
                        if (typeof IS_USER_AUTHENTICATED !== 'undefined' && !IS_USER_AUTHENTICATED) {
                            /* console.warn('🔒 Fitur ini memerlukan login (akses ditolak).') */;
                            return;
                        }
                        /* console.warn('🔒 Session expired — redirecting to login') */;
                        window.location.href = '/Account/Login?ReturnUrl=' + encodeURIComponent(window.location.pathname + window.location.search);
                    }
                });
            }
            window.getCsrfToken = function() { return csrfToken; };
        })();
    </script>
