                            <li class="dropdown-header">@User.Identity.Name</li>
                            <li><a class="dropdown-item" href="/Account/Logout" onclick="event.preventDefault(); document.getElementById('logout-form').submit();"><i class="fas fa-sign-out-alt me-2"></i> Logout</a></li>
                        </ul>
                        <form id="logout-form" asp-controller="Account" asp-action="Logout" method="post" style="display:none">
                            @Html.AntiForgeryToken()
                        </form>
                    </div>
                }
                else
                {
                    <a href="/Account/Login" class="btn btn-sm btn-outline-primary me-2">
                        <i class="fas fa-sign-in-alt me-1"></i> <span class="d-none d-sm-inline">Login</span>
                    </a>
                }
            </div>
        </header>

        <div class="modal fade" id="notificationActivityModal" tabindex="-1" role="dialog" aria-labelledby="notificationActivityTitle" aria-hidden="true">
            <div class="modal-dialog modal-lg" role="document">
                <div class="modal-content activity-modal-content">
                    <div class="modal-header">
                        <div>
                            <h5 class="modal-title" id="notificationActivityTitle"><i class="fas fa-bell text-warning mr-2"></i>Log Aktivitas Sistem</h5>
                            <small class="text-muted" id="activityLogUpdatedAt">Memuat aktivitas terbaru...</small>
                        </div>
                        <button type="button" class="close" data-dismiss="modal" aria-label="Tutup"><span aria-hidden="true">&times;</span></button>
                    </div>
                    <div class="modal-body" id="notificationActivityList" aria-live="polite">
                        <div class="activity-log-empty">Memuat log aktivitas...</div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-danger mr-auto" id="resetActivityLog"><i class="fas fa-trash-alt mr-1"></i>Reset log</button>
                        <button type="button" class="btn btn-outline-secondary" id="refreshActivityLog"><i class="fas fa-sync-alt mr-1"></i>Perbarui</button>
                        <button type="button" class="btn btn-secondary" data-dismiss="modal">Tutup</button>
                    </div>
                </div>
            </div>
        </div>

        <div class="modal fade" id="applicationHelpModal" tabindex="-1" role="dialog" aria-labelledby="applicationHelpTitle" aria-hidden="true">
            <div class="modal-dialog modal-lg" role="document">
                <div class="modal-content activity-modal-content">
                    <div class="modal-header">
                        <div>
                            <h5 class="modal-title" id="applicationHelpTitle"><i class="fas fa-life-ring text-primary mr-2"></i>Panduan KWH Monitoring</h5>
                            <small class="text-muted">Cara kerja aplikasi dan catatan pembaruan sistem</small>
                        </div>
                        <button type="button" class="close" data-dismiss="modal" aria-label="Tutup"><span aria-hidden="true">&times;</span></button>
                    </div>
                    <div class="modal-body help-modal-body">
                        <section class="help-section">
                            <h6><i class="fas fa-project-diagram mr-2"></i>1. Alur kerja aplikasi</h6>
                            <ol>
                                <li>Meter atau perangkat mengirim data listrik ke layanan penerima perangkat.</li>
                                <li>Data masuk disimpan sebagai pembacaan bertanda waktu. Sistem menggunakan pembacaan terbaru dari setiap panel untuk menampilkan kondisi terkini.</li>
                                <li>Data energi dihimpun per jam, hari, bulan, dan tahun untuk menyajikan statistik konsumsi.</li>
                                <li>Dasbor, grafik, statistik, dan Voltra mengambil data melalui layanan aplikasi. Setiap pertanyaan kepada Voltra memicu pengambilan cuplikan data terbaru.</li>
                                <li>Pemeriksaan anomali membandingkan hasil pembacaan dengan ambang batas sistem. Aktivitas penting dicatat dan ditampilkan pada ikon lonceng notifikasi.</li>
                            </ol>
                            <p class="help-note">Waktu pembaruan mengikuti waktu penerimaan data oleh server. Jika data terakhir sudah lama, periksa koneksi perangkat dan status panel sebelum menyimpulkan bahwa konsumsi bernilai nol.</p>
                        </section>

                        <section class="help-section">
                            <h6><i class="fas fa-tachometer-alt mr-2"></i>2. Dasbor dan kondisi panel</h6>
                            <p>Dasbor merangkum panel, daya aktif, tegangan, arus, faktor daya, frekuensi, dan energi. Pilih panel untuk membuka rinciannya. Nilai setiap fasa R/S/T tersedia pada perangkat tiga fasa; beberapa perangkat hanya mengirim satu fasa.</p>
                            <ul>
                                <li><strong>Watt (W):</strong> daya pada saat pembacaan diterima.</li>
                                <li><strong>kWh:</strong> akumulasi energi selama periode; gunakan statistik energi untuk membandingkan periode.</li>
                                <li><strong>Faktor daya:</strong> nilai faktor daya yang dilaporkan perangkat; nilainya umumnya berada pada rentang 0 hingga 1.</li>
                                <li><strong>Waktu terakhir:</strong> periksa cap waktu untuk memastikan data panel masih baru.</li>
                            </ul>
                        </section>

                        <section class="help-section">
                            <h6><i class="fas fa-chart-line mr-2"></i>3. Grafik, riwayat, dan statistik biaya</h6>
                            <ul>
                                <li><strong>Grafik:</strong> menampilkan perubahan daya, tegangan, dan arus berdasarkan data historis.</li>
                                <li><strong>Riwayat:</strong> menelusuri hasil pembacaan berdasarkan panel dan rentang tanggal.</li>
                                <li><strong>Statistik Penggunaan:</strong> membandingkan konsumsi setiap panel per hari, bulan, dan tahun serta melihat peringkat konsumsi.</li>
                                <li><strong>Perkiraan biaya:</strong> konsumsi energi dalam kWh dikalikan dengan tarif per kWh yang dikonfigurasi. Nilai ini merupakan perkiraan aplikasi, bukan tagihan resmi penyedia listrik.</li>
                            </ul>
                        </section>

                        <section class="help-section">
                            <h6><i class="fas fa-exclamation-triangle mr-2"></i>4. Anomali dan lonceng aktivitas</h6>
                            <p>Halaman <strong>Log Anomali</strong> memuat kejadian yang direkam sistem, status penanganan, dan rincian panel. Ikon lonceng menampilkan riwayat anomali, aktivitas akun dan pendaftaran, respons AI, serta temuan kondisi panel yang masih aktif. Pilih <strong>Perbarui</strong> pada dialog notifikasi untuk memuat ulang data.</p>
                            <p>Temuan langsung mencakup data panel yang tidak diperbarui selama lebih dari 15 menit, nilai daya atau energi negatif, faktor daya di luar rentang 0–1, dan tegangan fasa R di luar acuan 180–260 V. Rentang tegangan tersebut hanya digunakan untuk pemeriksaan awal; bandingkan dengan standar instalasi dan konfigurasi lokasi.</p>
                        </section>

                        <section class="help-section">
                            <h6><i class="fas fa-robot mr-2"></i>5. Menggunakan Voltra AI</h6>
                            <p>Pilih tombol Voltra untuk bertanya tentang kondisi panel, konsumsi, perkiraan biaya, peringkat konsumsi, tren, dan anomali. Jawaban menggunakan cuplikan terbaru dari basis data saat pesan dikirim. Voltra tidak menggantikan pemeriksaan teknisi; mintalah petugas berwenang memvalidasi tindakan kelistrikan.</p>
                            <p>Jika pengambilan cuplikan data gagal, chatbot meminta Anda mencoba kembali agar data lama tidak dianggap sebagai kondisi terkini. Riwayat percakapan disimpan di peramban, sedangkan respons yang berhasil juga dicatat dalam catatan aktivitas sistem.</p>
                        </section>

                        <section class="help-section">
                            <h6><i class="fas fa-sliders-h mr-2"></i>6. Pengaturan, akun, dan akses</h6>
                            <ul>
                                <li><strong>Pengaturan:</strong> atur tarif, ambang batas dan mode deteksi, preferensi notifikasi, serta konfigurasi chatbot sesuai dengan hak akses akun.</li>
                                <li><strong>Pendaftaran:</strong> pengguna baru mendaftar dengan alamat email, menyelesaikan verifikasi, lalu menunggu persetujuan akses atau penetapan peran jika diwajibkan administrator.</li>
                                <li><strong>Manajemen Pengguna:</strong> administrator dapat mengubah peran atau status akun. Aktivitas akun utama dicatat dalam catatan audit.</li>
                                <li>Jika halaman atau API menolak akses, masuklah menggunakan akun dengan peran yang sesuai dengan kebijakan sistem.</li>
                            </ul>
                        </section>

                        <section class="help-section help-changelog">
                            <h6><i class="fas fa-clipboard-list mr-2"></i>Catatan pembaruan sistem</h6>
                            <p class="text-muted">Daftar ini ditulis langsung pada tata letak aplikasi. Tambahkan catatan baru di bagian teratas setiap kali pembaruan dirilis.</p>
                            <div class="help-release"><time datetime="2026-09-29">29 September 2026</time><strong>Pusat bantuan dan log aktivitas</strong><span>Menambahkan panduan penggunaan terintegrasi, modal aktivitas notifikasi, pencatatan respons Voltra, dan tampilan temuan sistem aktif.</span></div>
                            <div class="help-release"><time datetime="2026-09-29">29 September 2026</time><strong>Pembaruan chatbot dan pemeriksaan kondisi panel</strong><span>Cuplikan data chatbot kini memuat seluruh panel dan peringkat tanpa pemotongan, serta memeriksa kebaruan data, nilai negatif, faktor daya, dan tegangan.</span></div>
                            <div class="help-release"><time datetime="2026-09-29">29 September 2026</time><strong>Perbaikan konsistensi snapshot Voltra</strong><span>Chatbot mengambil snapshot database terbaru setiap pertanyaan dan tidak memakai fallback teks halaman jika pengambilan snapshot gagal.</span></div>
                        </section>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-dismiss="modal">Tutup panduan</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Mobile nav dropdown -->
        <div class="topbar-mobile-nav d-lg-none" id="mobileNavDropdown">
            <a class="topbar-mobile-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")"
               asp-controller="Monitoring" asp-action="Index">
                <i class="fas fa-tachometer-alt"></i> Dashboard
            </a>
            <a class="topbar-mobile-link @(ViewContext.RouteData.Values["action"]?.ToString() == "History" ? "active" : "")"
               asp-controller="Monitoring" asp-action="History">
                <i class="fas fa-history"></i> History
            </a>
        </div>

        <!-- MAIN CONTENT -->
        <div class="erp-content">
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade in" role="alert">
                    <i class="fas fa-exclamation-triangle"></i> @TempData["Error"]
                    <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
                </div>
            }
            @RenderBody()
        </div>

        <!-- FOOTER -->
        <footer class="erp-footer">
            <div class="container-fluid">
                <div class="row align-items-center">
                    <div class="col-md-6">
                        &copy; @DateTime.Now.Year - KWH Monitoring System - Haiwell Electrical
                    </div>
                    <div class="col-md-6 text-md-end">
                        <i class="fas fa-server"></i> Server: @_dbServer | Database: @_dbName
                    </div>
                </div>
            </div>
        </footer>
    </div>

