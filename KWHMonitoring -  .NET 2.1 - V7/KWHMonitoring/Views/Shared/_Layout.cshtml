                                animation: qwen-electric-border 2s infinite;
                            }

                            @@keyframes qwen-electric-border {
                                0%, 100% { border-color: #e2e8f0; box-shadow: 0 2px 8px rgba(0,0,0,0.06); }
                                50% { border-color: #667eea; box-shadow: 0 0 12px rgba(102, 126, 234, 0.3), 0 2px 8px rgba(0,0,0,0.06); }
                            }

                            /* Footer / Input */
                            #qwen-chat-footer { 
                                padding: 16px 20px; 
                                background: white; 
