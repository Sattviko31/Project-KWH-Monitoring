    <script>
        (function() {
            window._deviceSettings = window._deviceSettings || {};
            window._deviceSettingsLoaded = false;

            function fetchDeviceSettings() {
                return $.ajax({
                    url: '/api/Api/device-settings',
                    method: 'GET',
                    dataType: 'json',
                    cache: false
                }).then(function(resp) {
                    if (resp.success && resp.settings) {
                        window._deviceSettings = resp.settings;
                        window._deviceSettingsLoaded = true;
                        var keys = Object.keys(resp.settings);
                        var sample = keys.length > 0 ? resp.settings[keys[0]] : null;
                        @* console.log('DeviceSettings loaded:', keys.length, 'devices. Keys:', keys.join(','), 'Sample:', JSON.stringify(sample)); *@
                     } else {
                        @* console.warn('DeviceSettings: API returned no settings', resp); *@
                    }
                 }).fail(function(xhr, status, error) {
                    @* console.error('DeviceSettings: Failed to load:', error || status); *@
                });
            }

            window._deviceSettingsPromise = fetchDeviceSettings();

            // Periodic refresh every 60 seconds to pick up admin settings changes
            setInterval(function() {
                fetchDeviceSettings();
            }, 60000);

            window.getDeviceSettings = function(deviceKey) {
                var s = (window._deviceSettings || {})[ deviceKey];
                if (!s) {
                    /* console.warn('getDevi ceSettings: no settings for deviceKey="' + deviceKey + '"') */;
                    return null;
                }
                return {
                    installedCapacityVA: s.installedCapacityVA || s.InstalledCapacityVA || 0,
                    maxCapacity: s.effectiveMaxCapacityWatt || s.EffectiveMaxCapacityWatt || s.maxCapacity || s.MaxCapacity || 0,
                    loadNormalThreshold: (s.loadNormalThreshold != null && s.loadNormalThreshold > 0) ? s.loadNormalThreshold : (s.LoadNormalThreshold != null && s.LoadNormalThreshold > 0 ? s.LoadNormalThreshold : 30),
                    loadMediumThreshold: (s.loadMediumThreshold != null && s.loadMediumThreshold > 0) ? s.loadMediumThreshold : (s.LoadMediumThreshold != null && s.LoadMediumThreshold > 0 ? s.LoadMediumThreshold : 70),
                    emaUpperThreshold: s.emaUpperThreshold || s.EmaUpperThreshold || 0,
                    emaLowerThreshold: s.emaLowerThreshold || s.EmaLowerThreshold || 0,
                    emaFibUpper: s.emaFibUpper || s.EmaFibUpper || 0,
                    emaFibLower: s.emaFibLower || s.EmaFibLower || 0,
                    tariffPerKWh: (s.tariffPerKWh != null && s.tariffPerKWh > 0) ? s.tariffPerKWh : (s.TariffPerKWh != null && s.TariffPerKWh > 0 ? s.TariffPerKWh : 1500),
                    downtimeEnabled: s.downtimeEnabled === true || s.DowntimeEnabled === true,
                    downtimeStart: s.downtimeStart || s.DowntimeStart,
                    downtimeEnd: s.downtimeEnd || s.DowntimeEnd,
                    controlMode: s.controlMode || s.ControlMode || 'OnOff',
                    deviceCategory: s.deviceCategory || s.DeviceCategory || 'Billboard'
                };
            };

            window.getDeviceSetting = function(deviceKey, field, defaultValue) {
                var ds = window.getDeviceSettings(deviceKey);
                if (!ds) return defaultValue;
                return ds[field] !== undefined ? ds[field] : defaultValue;
            };
        })();
    </script>

