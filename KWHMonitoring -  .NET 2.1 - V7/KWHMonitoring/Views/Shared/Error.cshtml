@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="container-fluid vh-100 d-flex align-items-center justify-content-center" style="background: linear-gradient(135deg, #dc3545 0%, #a52834 100%);">
        <div class="row justify-content-center w-100">
            <div class="col-md-6 col-lg-5">
                <div class="card shadow-lg border-0">
                    <div class="card-body p-5 text-center">
                        <i class="fas fa-exclamation-triangle text-warning fa-4x mb-4"></i>
                        <h3 class="fw-bold text-danger">Terjadi Kesalahan</h3>
                        <p class="text-muted mt-3">@Model.Message</p>
                        <a href="/Account/Login" class="btn btn-primary mt-3">
                            <i class="fas fa-arrow-left me-2"></i> Kembali ke Login
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <h1 class="text-danger">Error.</h1>
    <h2 class="text-danger">An error occurred while processing your request.</h2>

    @if (Model.ShowRequestId)
    {
        <p>
            <strong>Request ID:</strong> <code>@Model.RequestId</code>
        </p>
    }
}
