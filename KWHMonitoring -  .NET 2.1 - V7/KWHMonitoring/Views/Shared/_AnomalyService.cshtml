@* Background Anomaly Detection Service - Berjalan di semua halaman *@
<script>
    (function() {
        'use strict';

        // ============================================
        // GLOBAL SETTINGS - SEMUA DARI DATABASE
        // ============================================
        // Semua nilai ini akan di-load dari database saat service start
        // dan di-update setiap kali user mengubah settings di modal
        // ============================================
        let anomalyServiceConfig = {
            enabled: true,
            checkInterval: 30,           // Akan di-load dari DB
            cooldownTime: 60000,         // Akan di-load dari DB (ms)
            emaPeriod: 20,
            mode: 'manual',
            upperThreshold: 30,
            lowerThreshold: 50,
            fibUpper: 1.618,
            fibLower: 0.618
        };

        // API settings may legitimately contain numeric zero (for example, a
        // disabled threshold). Preserve that value instead of treating it as
        // missing and silently substituting a different preset.
        function settingValue(value, fallback) {
            return value === null || value === undefined || value === '' ? fallback : value;
        }

        // Time-based cooldown DIHAPUS - sekarang hanya condition-based (trigger saat power normal)
        // let anomalyCooldown = {};  // âŒ REMOVED: No more timer-based cooldown
        
        let anomalyTimer = null;
        let anomalyTimerInterval = 0;    // Track current interval value (ms) - setInterval returns primitive, can't hold properties
        let settingsReloadTimer = null;  // Timer untuk reload settings secara berkala
        let anomalyChecksInFlight = {};  // Hindari pemrosesan bersamaan untuk device yang sama
        let lastProcessedSampleByDevice = {}; // Satu sampel hanya boleh dihitung sekali

        // Konfirmasi anomali - AKAN DI-LOAD DARI DATABASE
        let anomalyConfirmation = {
            counts: {},                   // deviceKey_anomalyType -> count
            maxConfirmations: 3,          // Akan di-load dari DB
            cooldownTime: 60000           // Akan di-load dari DB (ms) - TIDAK DIPAKAI LAGI (condition-based)
        };

        // Cooldown state: track apakah sedang dalam cooldown karena sudah ter-log
        // Ini adalah SATU-SATUNYA mekanisme cooldown sekarang
        let anomalyCooldownState = {};  // deviceKey -> { type: 'OVERLOAD'/'DROP', loggedAt: timestamp, waitingForNormal: boolean }

        // ============================================
        // CHART SNAPSHOT BUFFER
        // Menangkap 50 titik sebelum & 50 titik sesudah anomali
        // ============================================
        const CHART_SNAPSHOT_SIZE = 50;
        let anomalyChartBuffers = {};  // deviceKey -> { logId, beforeData, afterBuffer, afterCount, thresholds }

        function buildChartDataPoints(powerData, ema, thresholds, timestamps) {
            // Build array of ChartDataPoint-compatible objects from current chart data
            var points = [];
            var len = powerData.length;
            for (var i = 0; i < len; i++) {
                points.push({
                    Timestamp: timestamps ? timestamps[i] : null,
                    Power: powerData[i],
                    Upper: thresholds.upper[i] || null,
                    Lower: thresholds.lower[i] || null,
                    EMA: ema[i] || null
                });
            }
            return points;
        }

        function getTimestampsFromChart(data) {
            if (data && Array.isArray(data.timestamps) && data.timestamps.length > 0) {
                return data.timestamps.map(function(timestamp) {
                    var parsed = new Date(timestamp);
                    return isNaN(parsed.getTime()) ? null : parsed;
                });
            }
            // Build DateTime timestamps from chart labels if available
            if (data && data.labels && Array.isArray(data.labels) && data.labels.length > 0) {
                var today = new Date();
                var yyyy = today.getFullYear();
                var MM = String(today.getMonth() + 1).padStart(2, '0');
                var dd = String(today.getDate()).padStart(2, '0');
                return data.labels.map(function(label) {
                    // label format: "HH:mm:ss"
                    try {
                        return new Date(yyyy + '-' + MM + '-' + dd + 'T' + label);
                    } catch(e) {
                        return null;
                    }
                });
            }
            return null;
        }

        const CHART_SNAPSHOT_SEND_INTERVAL = 1; // Send each sampled point so open detail charts stay current
        const CHART_SNAPSHOT_SEND_TIMEOUT = 300000; // Force send after 5 minutes even with few points

        function sendChartSnapshotAfter(logId, deviceKey, isFinal) {
            var buf = anomalyChartBuffers[deviceKey];
            if (!buf || !buf.afterBuffer || buf.afterBuffer.length === 0) return;
            if (buf.uploadInFlight) return;

            var afterData = buf.afterBuffer.slice(0, CHART_SNAPSHOT_SIZE);
            isFinal = isFinal || afterData.length >= CHART_SNAPSHOT_SIZE;
            buf.uploadInFlight = true;
            @* console.log('ðŸ“Š Sending chart snapshot AFTER data for anomaly #' + logId + ' (' + afterData.length + ' points' + (isFinal ? ', FINAL' : ', incremental') + ')'); *@

            $.ajax({
                url: '/api/Api/anomaly-logs/' + logId + '/chart-snapshot',
                method: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({ After: afterData, IsFinal: isFinal }),
                success: function() {
                    buf.uploadInFlight = false;
                    @* console.log('âœ… Chart snapshot AFTER data saved for anomaly #' + logId + ' (' + afterData.length + ' points)'); *@
                    if (isFinal) {
                        delete anomalyChartBuffers[deviceKey];
                    } else {
                        buf.lastSentCount = afterData.length;
                        buf.lastSentTime = Date.now();
                        // Point mungkin masuk saat request sebelumnya masih berjalan.
                        if (buf.afterBuffer.length > afterData.length) {
                            setTimeout(function() {
                                sendChartSnapshotAfter(logId, deviceKey, buf.afterBuffer.length >= CHART_SNAPSHOT_SIZE);
                            }, 0);
                        }
                    }
                },
                error: function(xhr, status, error) {
                    buf.uploadInFlight = false;
                    /* console.error('âŒ Error saving chart snapshot AFTER data:', error, xhr.status) */;
                    if (xhr.status === 401 || xhr.status === 403) {
                        /* console.warn('âš ï¸ Auth error on chart-snapshot endpoint â€” will retry via sendBeacon on page unload') */;
                    }
                    // Keep buffer for retry on next check or sendBeacon on unload
                }
            });
        }

        // Device category mapping & per-category downtime cache
        // Updated periodically alongside settings reload
        let deviceCategoryMap = {};             // deviceKey -> category name (dynamic from API)
        let categoryDowntimeCache = {};         // category -> boolean (isDowntime)

        // ============================================
        // GLOBAL ACCESSORS - Untuk diakses dari halaman lain (Index, Charts, dll)
        // ============================================
        window.getAnomalyCooldownState = function() {
            return anomalyCooldownState;
        };

        // Dispatch event saat cooldown state berubah
        function notifyCooldownChanged(deviceKey, isActive, anomalyType) {
            window.dispatchEvent(new CustomEvent('anomalyCooldownChanged', {
                detail: { deviceKey: deviceKey, isActive: isActive, anomalyType: anomalyType || null }
            }));
        }

        // Chart & System Settings - AKAN DI-LOAD DARI DATABASE
        let chartDataPoints = 20;       // Akan di-load dari DB
        let chartRefreshInterval = 30;  // Akan di-loaded dari DB
        
        // Notification settings - AKAN DI-LOAD DARI DATABASE
        let notificationSettings = {
            enableEmail: false,         // Akan di-load dari DB
            enableWhatsApp: false       // Akan di-load dari DB
        };
        
        // EMA baseline setting - AKAN DI-LOAD DARI DATABASE
        var useInitial100ForEma = false;  // Akan di-load dari DB

        // Debounce timer untuk save anomaly state ke database
        let anomalyStateSaveTimer = null;

        // ============================================
        // PERSIST ANOMALY STATE KE DATABASE
        // ============================================
        // Confirmation counts & cooldown state harus survive page reload
        // ============================================

        function loadAnomalyState() {
            return $.ajax({
                url: '/api/Api/get-anomaly-state',
                method: 'GET',
                dataType: 'json',
                timeout: 5000,
                success: function(data) {
                    if (data.success) {
                        // Restore confirmation counts
                        try {
                            var counts = JSON.parse(data.confirmationCounts);
                            if (counts && typeof counts === 'object') {
                                anomalyConfirmation.counts = counts;
                                @* console.log('ðŸ“‹ Restored confirmation counts from DB:', counts); *@
                            }
                        } catch (e) {
                            @* console.warn('âš ï¸ Could not parse confirmation counts:', e); *@
                        }

                        // Restore cooldown state
                        try {
                            var cooldown = JSON.parse(data.cooldownState);
                            if (cooldown && typeof cooldown === 'object') {
                                // Clean up stale cooldown entries (older than 24 hours)
                                var now = Date.now();
                                var cleaned = {};
                                Object.keys(cooldown).forEach(function(key) {
                                    var state = cooldown[key];
                                    if (state && state.waitingForNormal && state.loggedAt) {
                                        // Keep if logged within last 24 hours
                                        if ((now - state.loggedAt) < 86400000) {
                                            cleaned[key] = state;
                                        } else {
                                            @* console.log(`ðŸ§¹ Cleaning stale cooldown for ${key} (older than 24h)`); *@
                                        }
                                    }
                                });
                                anomalyCooldownState =  cleaned;
                                @* console.log('ðŸ“‹ Re stored cooldown state from DB:', cleaned); *@

                                // Notify UI about restored cooldown states
                                Object.keys(cleaned).forEach(function(deviceKey) {
                                    if (cleaned[deviceKey] && cleaned[deviceKey].waitingForNormal) {
                                        notifyCooldownChanged(deviceKey, true, cleaned[deviceKey].type);
                                    }
                                });
                            }
                        } catch  (e) {
                            @* console.warn('âš ï¸ C ould not parse cooldown state:', e); *@
                        }
                    }
                },
                error : function() {
                    @* console.warn('âš ï¸ Could not load anom aly state from DB, using defaults'); *@
                }
            });
        }

        function saveAnomalyState() {
            // Tamu (belum login): state disimpan hanya di memori halaman.
            // Endpoint save-anomaly-state membutuhkan role Operator/Admin.
            if (typeof IS_USER_AUTHENTICATED !== 'undefined' && !IS_USER_AUTHENTICATED) return;
            // Debounce: wait 2 seconds before saving to avoid excessive DB writes
            if (anomalyStateSaveTimer) clearTimeout(anomalyStateSaveTimer);
            anomalyStateSaveTimer = setTimeout(function() {
                $.ajax({
                    url: '/api/Api/save-anomaly-state',
                    method: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({
                        confirmationCounts: JSON.stringify(anomalyConfirmation.counts),
                        cooldownState: JSON.stringify(anomalyCooldownState)
                    }),
                    success: function() {
                        @* console.log('Anomaly state saved to DB'); *@
                    },
                    error: function(xhr) {
                        if (xhr.status === 401) {
                            @* console.warn('ðŸ”’ Session expired â€” stopping anomaly timer'); *@
                            if (anomalyTimer) { clearInterval(anomalyTimer); anomalyTimer = null; }
                        } else {
                            @* console.error('âŒ Error saving anomaly state:', xhr.statusText); *@
                        }
                    }
                });
            }, 2000);
        }

        function saveAnomalyStateImmediate() {
            // Tamu (belum login): state disimpan hanya di memori halaman.
            // Endpoint save-anomaly-state membutuhkan role Operator/Admin.
            if (typeof IS_USER_AUTHENTICATED !== 'undefined' && !IS_USER_AUTHENTICATED) return;
            // Immediate save for critical state changes (cooldown enter/exit)
            if (anomalyStateSaveTimer) clearTimeout(anomalyStateSaveTimer);
            $.ajax({
                url: '/api/Api/save-anomaly-state',
                method: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({
                    confirmationCounts: JSON.stringify(anomalyConfirmation.counts),
                    cooldownState: JSON.stringify(anomalyCooldownState)
                }),
                success: function() {
                    @* console.log('ðŸ’¾ Anomaly state saved to DB (immediate)'); *@
                },
                error: function(xhr) {
                    if (xhr.status === 401) {
                        @* console.warn('ðŸ”’ Session expired â€” stopping anomaly timer'); *@
                        if (anomalyTimer) { clearInterval(anomalyTimer); anomalyTimer = null; }
                    } else {
                        @* console.error('âŒ Error saving anomaly state:', xhr.statusText); *@
                    }
                }
            });
        }

        // Reset server-side anomaly alert state saat power kembali normal
        // Ini memungkinkan alert baru dikirim lagi untuk device yang sama
        function resetServerAnomalyAlert(deviceKey) {
            // Tamu (belum login): lewati â€” endpoint reset-anomaly-alert membutuhkan role Operator/Admin.
            if (typeof IS_USER_AUTHENTICATED !== 'undefined' && !IS_USER_AUTHENTICATED) return;
            $.ajax({
                url: '/api/Api/reset-anomaly-alert',
                method: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({ deviceKey: deviceKey }),
                success: function() {
                 @* console.log('ðŸ”“ Server anomaly a lert reset for ' + deviceKey); *@
                },
                error: function(xhr, status, error) {
                    @* console.error('âŒ Error reset ting server anomaly alert:', error); *@
                }
            });
        }

        function loadAnomalySettings() {
            @* console.log('ï¿½ ï¿½ Loading all settings from database...'); *@
            
            return $.when(
                // Load EMA, Anomaly, AND Notification settings PERSIS SAMA
                $.ajax({
                    url: '/api/Api/get-ema-settings',
                    method: 'GET',
                    dataType: 'json',
                    timeout: 5000,
                    success: function(data) {
                        var oldConfig = JSON.parse(JSON.stringify(anomalyServiceConfig));
                        
                        // ============================================
                        // EMA SETTINGS (dari get-ema-settings)
                        // ============================================
                        anomalyServiceConfig.emaPeriod = Number(settingValue(data.emaPeriod, 20));
                        anomalyServiceConfig.mode = settingValue(data.emaMode, 'manual');
                        anomalyServiceConfig.upperThreshold = Number(settingValue(data.emaUpperThreshold, 0));
                        anomalyServiceConfig.lowerThreshold = Number(settingValue(data.emaLowerThreshold, 0));
                        anomalyServiceConfig.fibUpper = Number(settingValue(data.emaFibUpper, 0));
                        anomalyServiceConfig.fibLower = Number(settingValue(data.emaFibLower, 0));
                        useInitial100ForEma = settingValue(data.useInitial100ForEma, false) === true;
                        
                        // Anomaly & Notification settings TIDAK ada di get-ema-settings
                        // Mereka di-load dari get-notification-settings (panggilan ketiga di bawah)
                        
                        @* console.log('âœ… ALL SETTINGS LOADED FROM DATABASE:', {
                            emaSettings: {
                                period: anomalyServiceConfig.emaPeriod,
                                mode: anomalyServiceConfig.mode,
                                upperThreshold: anomalyServiceConfig.upperThreshold + '%',
                                lowerThreshold: anomalyServiceConfig.lowerThreshold + '%',
                                useInitial100ForEma: useInitial100ForEma
                            },
                            anomalyDetection: {
                                checkInterval: (anomalyServiceConfig.checkInterval / 1000).toFixed(0) + 's',
                                maxConfirmations: anomalyConfirmation.maxConfirmations,
                                cooldownTime: (anomalyConfirmation.cooldownTime / 1000).toFixed(0) + 's'
                            },
                            notifications: {
                                emailEnabled: notificationSettings.enableEmail,
                                whatsappEnabled: notificationSettings.enableWhatsApp
                            }
                        }); *@
                        
                        // ============================================
                        // VERIFIKASI SINKRONISASI - SEMUA DARI DB YANG SAMA
                        // ================================== ==========
                        @* console.log('ðŸ” Ve rifying settings syn chronization:') ;
                        console.log(`   EMA Period: ${anomalyServiceConfig.emaPeriod} (from DB)`);
                        console.log(`   âœ… Upper Threshold: ${anomalyServiceConfig.upperThreshold}% (from D B)`);
                        console.log(`   Lower Threshold: ${anomalyServiceConfig.lowerThreshold}% (from DB)`);
                        console.log(`   âœ… Max Confirmations: ${anomalyConfirmation.maxConfirmations} (from DB)`);
                        console.log(`   âœ… Check Interval: ${anomalyServiceConfig.checkInterval / 1000}s (from DB) `);
                        console.log(`   Cooldown Time: ${anomalyConfirmation.cooldownTime / 1000}s (from DB)`);
                        console.log(`    Chart Refresh: ${chartRefreshInterval}s (from DB)`);
                        console.log(`   âœ… Email Notifica tions: ${notificationSettings.enableEmail} (from DB)`);
                        console.log(`   âœ… WhatsApp Notifications: ${notificationSettings.enableWhatsApp} (from DB)`); *@
                         
                        // Log perubahan yang signifikan
                        if (oldConfig.emaPeriod !==  anomalyServiceConfig.emaPeriod) {
                            @* console.log(`CHANGE DETECTED: EMA Period berubah: ${oldConfig.emaPeriod} -> ${anomalyServiceConfig.emaPeriod}`); *@
                        }
                        if (oldConfig.upperThreshold !== anomalyServiceConfig.upperThreshold) {
                            @* console.log(`âš™ï¸ âš ï¸ CHANGE DETECTED: Upper Threshold berubah: ${oldConfig.upperThreshold}% â†’  ${anomalyServiceConfig.upperThreshold}%`); *@
                        }
                        if (anomalyConfirmation.maxConfirmations !== 3) {
                            @* console.log(`âš™ï¸ âš ï¸ CHANGE DETECTED: Max Confirmations diubah ke : ${anomalyConfirmation.maxConfirmations}`); *@
                         }
                    },
                    error: function(xhr, status, error) {
                        @* console.error('âŒ Error loading settings:' , status, error);
                        console.log('âš ï¸ Using default settings (checkInterval=30s, maxConfirmations=3, cooldown=60s)'); *@
                    }
                }),
                
                // Load system settings (Chart & Refresh Interval)
                $.ajax({
                    url: '/api/Api/get-system-settings',
                    method: 'GET',
                    dataType: 'json',
                    timeout: 5000,
                    success: function(data) {
                        if (data.success && data.settings) {
                            chartDataPoints = parseInt(data.settings['Chart.DataPoints']) || 20;
                            var loadedInterval = parseInt(data.settings['Chart.RefreshInterval']) ||
                                                 parseInt(data.settings['RefreshInterval']) || 30;

                            // Sampling anomaly berjalan dengan interval preset anomaly.
                            // Refresh chart hanya mengatur frekuensi tampilan.
                            if (loadedInterval !== chartRefreshInterval) {
                                chartRefreshInterval = loadedInterval;
                                @* console.log(`â±ï¸ Cha rt refresh interval updated: ${chartRefreshInterval}s`); *@
                            }
                        }
                         @* console.log('ðŸ“Š System settings loaded: chartDataPoints=' + chartDataPoints + ', refreshInterval=' +  chartRefreshInterval + 's'); *@
                    },
                     error: function(xhr, status, error) {
                        @* console.error('âŒ Error loading system settings:', status, error); *@
                    }
                }),

                // Load notification & anomaly settings (anomalyCheckInterval, enableEmail, dll)
                $.ajax({
                    url: '/api/Api/get-notification-settings',
                    method: 'GET',
                    dataType: 'json',
                    timeout: 5000,
                    success: function(data) {
                        // Anomaly detection settings
                        if (data.anomalyCheckInterval !== null && data.anomalyCheckInterval !== undefined && Number(data.anomalyCheckInterval) > 0) {
                            var configuredInterval = Number(data.anomalyCheckInterval);
                            var newInterval = configuredInterval * 1000; // Convert ke ms
                            anomalyServiceConfig.checkInterval = configuredInterval;
                            anomalyConfirmation.maxConfirmations = (typeof data.anomalyMaxConfirmations === 'number') ? data.anomalyMaxConfirmations : 3;
                            anomalyConfirmation.cooldownTime = Number(settingValue(data.anomalyCooldownTime, 60)) * 1000; // Convert ke ms

                            // Sampling mengikuti interval anomaly dari preset.
                            if (anomalyTimer && newInterval !== anomalyTimerInterval) {
                                clearInterval(anomalyTimer);
                                anomalyTimerInterval = newInterval;
                                anomalyTimer = setInterval(runAnomalyCheck, newInterval);
                                @* console.log(`â±ï¸ Anomaly check interval updated to ${newInterval / 1000}s`); *@
                            }
                        }

                        // Notification settings
                        if (data.enableEmail !== undefined) {
                            notificationSettings.enableEmail = data.enableEmail || false;
                            notificationSettings.enableWhatsApp = data.enableWhatsApp || false;
                        }

                         @* console.log('ðŸ”” Notification settings loaded: email=' + notificationSettings.enableEmail + ', whatsapp=' + notificationSettings.enableWhatsApp); *@
                        @* console.log('âš™ï¸ Anomaly settings loaded: checkInterval=' + (anomalyServiceConfig.checkInterval / 1000) + 's, maxConfirmations=' + anomalyConfirmation.maxConfirmations  + ', cooldownTime=' + (anomalyConfirmation.cooldownTime / 1000) + 's'); *@
                    },
                    error: function(xhr, status, error) {
                        @* console.error('âŒ Error loading notification settings:', status, error); *@
                    }
                }),

                // Load device categories & per-category downtime status
                loadDeviceCategories(),
                loadCategoryDowntimeStatus()
            );
        }

        // ============================================
        // DEVICE CATEGORY & PER-CATEGORY DOWNTIME
        // Cached & refreshed alongside settings
        // ============================================
        function loadDeviceCategories() {
            return $.ajax({
                url: '/api/Api/device-categories',
                method: 'GET',
                dataType: 'json',
                timeout: 5000,
                 success: function(data) {
                    if (data.devices) {
                        deviceCategoryMap = data.devices;
                     }
                    @* console.log('ðŸ“‹ Device categories  cached:', deviceCategoryMap); *@
                },
                error: function() {
                    @* console.warn('âš ï¸ Could not load device categories, using cache'); *@
                }
            });
        }

        function loadCategoryDowntimeStatus() {
            var categories = Object.keys(window._categoryMetaMap || {}).length > 0 ? Object.keys(window._categoryMetaMap) : ['Billboard'];
            var requests = categories.map(function(cat) {
                return $.ajax({
                    url: '/api/Api/downtime-status?category=' + encodeURIComponent(cat),
                    method: 'GET',
                    dataType: 'json',
                    timeout: 5000,
                    success: function(data) {
                        categoryDowntimeCache[cat] = data.isDowntime || false;
                    },
                    error: function() {
                         // Keep previous value on error
                    }
                 });
            });
            return $.when.apply($, requests).done(function() {
                @* console.log('📋 Category downtime cached:', categoryDowntimeCache); *@
            });
        }

        function isDowntimeForDevice(deviceKey) {
            var ds = (window.getDeviceSettings && window.getDeviceSettings(deviceKey)) || { downtimeEnabled: false };
            if (!ds.downtimeEnabled) return false;

            var startParts = (ds.downtimeStart || '22:00:00').toString().split(':');
            var endParts = (ds.downtimeEnd || '06:00:00').toString().split(':');
            var startHour = parseInt(startParts[0]) || 0;
            var startMin = parseInt(startParts[1]) || 0;
            var endHour = parseInt(endParts[0]) || 0;
            var endMin = parseInt(endParts[1]) || 0;

            var now = new Date();
            var current = now.getHours() * 60 + now.getMinutes();
            var start = startHour * 60 + startMin;
            var end = endHour * 60 + endMin;

            if (start < end) {
                return current >= start && current < end;
            } else {
                return current >= start || current < end;
            }
        }

        function calculateEMA(data, period) {
            if (!data || data.length === 0) return [];
            const k = 2 / (period + 1);
            let ema = [data[0] || 0];
            for (let i = 1; i < data.length; i++) {
                const value = data[i] !== null && data[i] !== undefined ? data[i] : ema[i - 1];
                ema.push(value * k + ema[i - 1] * (1 - k));
            }
            return ema;
        }

        // Fungsi untuk menghitung EMA dengan baseline statis dari 100 data pertama
        // Baseline ini TIDAK berubah meski jumlah data points chart berubah
        function calculateEMAWithBaseline(powerData, period, baselineValue) {
            if (!powerData || powerData.length === 0) return [];
            if (baselineValue === null || baselineValue === undefined) {
                // Fallback ke EMA biasa jika tidak ada baseline
                return calculateEMA(powerData, period);
            }
            
            // Baseline horizontal = nilai baseline tetap untuk semua titik
            // Ini membuat EMA dimulai dari garis horizontal yang stabil
            return powerData.map(function() { return baselineValue; });
        }

        // Fetch baseline EMA dari server (SMA dari 100 data pertama)
        function fetchInitialEmaBaseline(deviceKey) {
            return $.ajax({
                url: '/api/Api/get-initial-ema/' + encodeURIComponent(deviceKey),
                method: 'GET',
                dataType: 'json',
                timeout: 10000
            }).then(function(response) {
                if (response.success && response.emaBaseline != null) {
                    @* console.log(`🎯 EMA Baseline loaded for ${deviceKey}: ${response.emaBaseline.toFixed(2)}W`); *@
                    return response.emaBaseline;
                } else {
                    @* console.log(`⚠️ No EMA baseline for ${deviceKey}, using fallback`); *@
                    return null;
                }
            }, function() {
                @* console.log(`❌ Error fetching EMA baseline for ${deviceKey}`); *@
                return null;
            });
        }

        function calculateThresholds(ema, mode, upperValue, lowerValue) {
            let upper = [], lower = [];
            if (mode === 'fibonacci') {
                upper = ema.map(v => (v || 0) * upperValue);
                lower = ema.map(v => (v || 0) * lowerValue);
            } else {
                upper = ema.map(v => (v || 0) * (1 + upperValue / 100));
                lower = ema.map(v => (v || 0) * (1 - lowerValue / 100));
            }
            return { upper, lower };
        }

        function checkDeviceAnomaly(deviceKey) {
            // Jumlah sampling 0 berarti deteksi anomali dimatikan
            if (anomalyConfirmation.maxConfirmations <= 0) {
                return;
            }
            if (anomalyChecksInFlight[deviceKey]) return;
            anomalyChecksInFlight[deviceKey] = true;

            // Gunakan chartDataPoints yang sudah diload dari system settings
            // Fetch MORE points for snapshot buffer: max(chartDataPoints, CHART_SNAPSHOT_SIZE)
            const pointsToFetch = Math.max(chartDataPoints || 20, CHART_SNAPSHOT_SIZE);

            // ============================================
            // TAHAP 1: Ambil data chart
            // ============================================
            $.ajax({
                url: `/api/Api/panels/${deviceKey}/chart?points=${pointsToFetch}`,
                method: 'GET',
                dataType: 'json',
                timeout: 5000,
                success: function(data) {
                    if (!data || !data.power || data.power.length === 0) {
                        delete anomalyChecksInFlight[deviceKey];
                        return;
                    }

                    const lastIndex = data.power.length - 1;
                    // Nilai null di database bukan pembacaan 0 W dan tidak boleh menjadi anomali.
                    if (Array.isArray(data.powerValid) && data.powerValid[lastIndex] !== true) {
                        delete anomalyChecksInFlight[deviceKey];
                        return;
                    }
                    const sampleTime = data.timestamps && data.timestamps[lastIndex];
                    if (!sampleTime) {
                        delete anomalyChecksInFlight[deviceKey];
                        return;
                    }
                    const sampleKey = new Date(sampleTime).getTime();
                    if (!Number.isFinite(sampleKey) || lastProcessedSampleByDevice[deviceKey] === sampleKey) {
                        delete anomalyChecksInFlight[deviceKey];
                        return;
                    }
                    lastProcessedSampleByDevice[deviceKey] = sampleKey;

                    const powerData = data.power;
                    const timestamps = getTimestampsFromChart(data);

                    // ============================================
                    // TAHAP 2: Hitung EMA atau ambil baseline statis
                    // ============================================
                    let emaValues, baselineValue;

                    if (useInitial100ForEma) {
                        // USE STATIC BASELINE FROM INITIAL 100 DATA POINTS
                        // Baseline ini TIDAK BERUBAH meski jumlah data points chart berubah
                        fetchInitialEmaBaseline(deviceKey).then(function(baseline) {
                            baselineValue = baseline;
                            emaValues = calculateEMAWithBaseline(powerData, anomalyServiceConfig.emaPeriod, baseline);

                            processAnomalyCheck(deviceKey, powerData, emaValues, baselineValue, timestamps);
                            delete anomalyChecksInFlight[deviceKey];
                        });
                    } else {
                        // NORMAL MODE: Calculate EMA from current data points
                        emaValues = calculateEMA(powerData, anomalyServiceConfig.emaPeriod);

                        processAnomalyCheck(deviceKey, powerData, emaValues, null, timestamps);
                        delete anomalyChecksInFlight[deviceKey];
                    }
                },
                error: function() { delete anomalyChecksInFlight[deviceKey]; }
            });
        }

        // Fungsi helper untuk melakukan pengecekan anomali setelah EMA/baseline didapat
        function processAnomalyCheck(deviceKey, powerData, ema, baselineValue, timestamps) {
            var ds = (window.getDeviceSettings && window.getDeviceSettings(deviceKey)) || {};
            var upperValue = ds.emaUpperThreshold || 0;
            var lowerValue = ds.emaLowerThreshold || 0;

            // Nilai 0 per-device berarti deteksi sengaja tidak dikonfigurasi untuk device ini.
            if (upperValue <= 0 && lowerValue <= 0) {
                @* console.log('ðŸ“ˆ No per-device EMA thresholds configured for ' + deviceKey + ', skipping anomaly check'); *@
                return;
            }

            // ============================================
            // PENTING: Thresholds HARUS SAMA DENGAN CHART
            // ============================================
            // Chart menggunakan calculateThresholds(ema, mode, upper, lower)
            // Jadi anomaly service juga harus menggunakan cara yang SAMA
            // Threshold dihitung dari EMA, bukan dari baseline statis!
            // ============================================

            const thresholds = calculateThresholds(ema, anomalyServiceConfig.mode, upperValue, lowerValue);

            const lastIndex = powerData.length - 1;
            const currentPower = powerData[lastIndex];
            const emaValue = ema[lastIndex];
            const upper = thresholds.upper[lastIndex];  // â† Upper dari EMA (sama dengan chart!)
            const lower = thresholds.lower[lastIndex];  // â† Lower dari EMA (sama dengan chart!)

            if (currentPower === null || currentPower === undefined) return;
            if (upper === undefined || lower === undefined) return;

            // ============================================
            // CHART SNAPSHOT: Collect AFTER data if buffer active
            // Sends incrementally every CHART_SNAPSHOT_SEND_INTERVAL points
            // to survive page reloads / navigation
            // ============================================
            var chartBuf = anomalyChartBuffers[deviceKey];
            if (chartBuf && chartBuf.afterBuffer.length < CHART_SNAPSHOT_SIZE) {
                // Add latest data point to the after-buffer
                var ts = timestamps ? timestamps[lastIndex] : null;
                chartBuf.afterBuffer.push({
                    Timestamp: ts,
                    Power: currentPower,
                    Upper: upper,
                    Lower: lower,
                    EMA: emaValue
                });
                @* console.log('ðŸ“Š Chart snapshot after-buffer: ' + chartBuf.afterBuffer.length + '/' + CHART_SNAPSHOT_SIZE + ' for ' + deviceKey); *@

                // Send incrementally: every N points OR after timeout, OR when buffer is full
                var timeSinceLastSend = chartBuf.lastSentTime ? (Date.now() - chartBuf.lastSentTime) : (Date.now() - chartBuf.createdAt);
                if (chartBuf.afterBuffer.length >= CHART_SNAPSHOT_SIZE) {
                    @* console.log('ðŸ“Š Chart snapshot after-buffer COMPLETE for ' + deviceKey + ', sending final...'); *@
                    sendChartSnapshotAfter(chartBuf.logId, deviceKey, true);
                } else if (chartBuf.afterBuffer.length % CHART_SNAPSHOT_SEND_INTERVAL  === 0) {
                    @* console.log('ðŸ“Š Chart snapshot after-buffer incremental send (' + chartBuf.afterBuffer.length +  ' points) for ' + deviceKey); *@
                    sendChartSnapshotAfter(chartBuf.logId, deviceKey, false);
                } else if (timeSinceLastSend >= CHART_SNAPSHOT_SEND_TIMEOUT && chartBuf.afterBuffer .length > 0) {
                    @* console.log('ðŸ“Š Chart snapshot after-buffer timeout send (' + chartBuf.afterBuffer.length + ' points, ' + Math.round(timeSinceLastSend / 1000) + 's elapsed) for ' + deviceKey); *@
                    sendChartSnapshotAfter(chartBuf.logId, deviceKey, false);
                }
            }

            // Debug logging - pastikan nilai SAMA dengan yang ditampilkan di chart
            // Tampilkan juga threshold settings yang digunakan
            const thresholdMode = anomalyServiceConfig.mode;
            const thresholdPercent = thresholdMode === 'fibonacci' ?
                `FIB: Ã—${upperValue}/${lowerValue}` :
                `MANUAL: +${upperValue}%/-${lowerValue}%`;
            
            if (baselineValue !== null && baselineValue !== undefined) {
                @* console.log(`📈 [BASELINE=${baselineValue.toFixed(1)}W] ${deviceKey}: Power=${currentPower.toFixed(1)}W | EMA=${emaValue.toFixed(1)}W | Upper=${upper.toFixed(1)}W | Lower=${lower.toFixed(1)}W | ${thresholdPercent}`); *@
            } else {
                @* console.log(`📈 [NORMAL] ${deviceKey}: Power=${currentPower.toFixed(1)}W | EMA=${emaValue.toFixed(1)}W | Upper=${upper.toFixed(1)}W | Lower=${lower.toFixed(1)}W | ${thresholdPercent}`); *@
            }

            // Check downtime status â€” CATEGORY-AWARE (from cache)
            var isDowntime = isDowntimeForDevice(deviceKey);
            var deviceCat = deviceCategoryMap[deviceKey] || 'Unknown';
            @* console.log(`🕐 Downtime check for ${deviceKey} (${deviceCat}): ${isDowntime ? 'DOWNTIME' : 'NORMAL'}`); *@

            let anomalyType = null;
            let thresholdValue = 0;
            let deviation = 0;

            // ============================================
            // DETEKSI ANOMALI - SAMA PERSIS DENGAN CHART
            // ============================================
            // Normal operation (bukan downtime):
            // - OVERLOAD: Power > Upper Threshold (dari EMA)
            // - DROP: Power < Lower Threshold (dari EMA)
            //
            // Downtime period:
            // - OVERLOAD: Power > EMA (listrik nyala saat jam mati)
            // - DROP: TIDAK DIDETEKSI (karena lower threshold disembunyikan saat downtime)
            // ============================================

            if (isDowntime) {
                // DOWNTIME LOGIC: Hanya deteksi OVERLOAD saat downtime
                // Trigger: Power > EMA (bukan Upper Line)
                // Karena saat downtime seharusnya listrik mati, tapi masih nyala = anomali
                if (currentPower > emaValue) {
                    anomalyType = 'OVERLOAD';
                    thresholdValue = emaValue;
                    deviation = ((currentPower - emaValue ) / emaValue * 100);
                    @* console.log(`DOWNTIME OVERLOAD: ${deviceKey} - Power ${currentPower.toFixed(1)}W > EMA ${emaValue.toFixed(1)}W`); *@
                }   
                // DROP tidak dideteksi saat downtime karena lower threshold disembunyikan
            } else {
                // NORMAL OPERATION LOGIC
                // OVERLOAD: Power > Upper Threshold (dari EMA, sama dengan chart!)
                if (currentPower > upper) {
                    anomalyType = 'OVERLOAD';
                    thresholdValue = upper;
                    deviation = ((currentPower - upper) / upper * 100);
                    @* console.log(`âš¡ NORMAL OVERLOAD: ${deviceKey} - Power ${currentPower.toFixed(1)}W > Upper ${upper.toFixed(1)}W`); *@
                }
                // DROP: Power < Lower Threshold (dari EMA, sama dengan chart!)
                else if (currentPower < lower) {
                    anomalyType = 'DROP';
                    thresholdValue = lower;
                    deviation = ((lower - currentPower) / lower * 100);
                    @* console.log(`âš¡ NORMAL DROP: ${deviceKey} - Power ${currentPower.toFixed(1)}W < Lower ${lower.toFixed(1)}W`); *@
                }
            }

            if (!anomalyType) {
                // Tidak ada anomali - RESET semua counter untuk device ini
                const resetKeys = Object.keys(anomalyConfirmation.counts).filter(k => k.startsWith(deviceKey + '_'));
                resetKeys.forEach(k => {
                    anomalyConfirmation.counts[k] = 0;
                });

                // Jika ada cooldown aktif, clear juga (power normal = cooldown selesai)
                if (anomalyCooldownState[deviceKey]) {
                    @* console.log(`ðŸ”„ Power normal for ${deviceKey}, clearing cooldown state...`); *@
                    anomalyCooldownState[deviceKey] = null;
                    notifyCooldownChanged(deviceKey, false, null);
                    saveAnomalyStateImmediate(); // Critical: cooldown cleared
                    resetServerAnomalyAlert(deviceKey); // Reset server-side dedup state
                }

                @* console.log(`ðŸ”„ Reset all anomaly counters for ${deviceKey} (power back to normal)`); *@
                saveAnomalyState(); // Debounced: save counter reset
                return;
            }

            // ============================================
            // TYPE TRANSITION: Reset counter tipe berlawanan
            // Untuk beban volatile (videotron/LED), perpindahan DROPâ†”OVERLOAD
            // adalah pola normal â€” counter tipe sebelumnya harus di-reset
            // agar tidak terakumulasi saat daya bouncing antar zona
            // ============================================
            const oppositeType = anomalyType === 'OVERLOAD' ? 'DROP' : 'OVERLOAD';
            const oppositeKey = deviceKey + '_' + oppositeType;
            if (anomalyConfirmation.counts[oppositeKey] > 0) {
                @* console.log(`ðŸ”„ Anomaly type transition: ${oppositeType} â†’ ${anomalyType} for ${deviceKey}, resetting ${oppositeType} counter from ${anomalyConfirmation.counts[oppositeKey]} to 0`); *@
                anomalyConfirmation.counts[oppositeKey] = 0;
                saveAnomalyState(); // Debounced: save counter reset
            }

            // ============================================
            // COOLDOWN CHECK - Condition-based
            // ============================================
            // Dua cara cooldown bisa clear:
            // 1. Power kembali ke zona normal (antara lower & upper)
            // 2. Anomaly type berpindah (DROP â†’ OVERLOAD atau OVERLOAD â†’ DROP)
            //    Untuk beban volatile videotron, transisi ini menandakan siklus normal
            // ============================================
            const cooldownState = anomalyCooldownState[deviceKey];

            if (cooldownState && cooldownState.waitingForNormal) {
                // Jika tipe anomali berbeda dari cooldown, clear cooldown
                // (misal: cooldown OVERLOAD tapi power sekarang DROP)
                // Untuk videotron, DROPâ†”OVERLOAD transition = pola normal
                if (anomalyType !== cooldownState .type) {
                    @* console.log(`Anomaly type transition (${cooldownState.type} -> ${anomalyType}) for ${deviceKey}, clearing cooldown`);
                    console.log(`   For volatile videotron loads, DROPâ†”OVERLOAD tr ansition indicates normal cycling`); *@
                    anomalyCooldownState[deviceKey] = null;
                    notifyCooldownChanged(deviceKey, false, null);
                    saveAnomalyStateImmediate();
                    resetServerAnomalyAlert(deviceKey);
                    // Don't return â€” lanjut proses tipe anomali baru dengan counter fresh
                 } else {
                    @* console.log(`ðŸ›‘ ${anomalyType.toUpperCase()} for ${deviceKey} - IN COOLDOWN , waiting for power to return to normal`); *@

                    // Check apakah sudah kembali normal
                    if (!isDowntime && currentPower >= lower && currentPower <= upper) {
                        @* console.log(`âœ… Power returned to normal for $ {deviceKey}, clearing cooldown...`); *@
                        anomalyCooldownState[deviceKey] = null;
                        notifyCooldownChanged(deviceKey, false, null);
                        saveAnomalyStateImmediate(); // Critical: cooldown cleared
                        resetServerAnomalyAlert(deviceKey); // Reset server-side dedup state
                        return; // Skip processing, will be checked in next interval
                    } else if (isDowntime && currentPower <= emaValue) {
                        @* console.log(`âœ… DOWNTIME ended (power back to zero), clea ring cooldown for ${deviceKey}...`); *@
                        anomalyCooldownState[deviceKey] = null;
                        notifyCooldownChanged(deviceKey, false, null);
                        saveAnomalyStateImmediate(); // Critical: cooldown cleared
                        resetServerAnomalyAlert(deviceKey); // Reset server-side dedup state
                        return; // Skip processing
                    }

                    return; // Still in cooldown, skip this check
                }
            }

            // Time-based cooldown DIHAPUS - hanya condition-based yang berlaku
            // const cooldownKey = `${deviceKey}_${anomalyType}`;
            // if (anomalyCooldown[cooldownKey] && (now - anomalyCooldown[cooldownKey]) < ...) { return; }
            // âŒ REMOVED

            // ============================================
            // KONFIRMASI ANOMALI REAL-TIME
            // ============================================
            // Konsep: "Touch & Hold" 
            // - Kontak pertama dengan threshold â†’ hitung 1 deteksi
            // - Kontak kedua masih luar threshold â†’ hitung 2 deteksi
            // - Kembali normal â†’ RESET ke 0
            // - Hitung berapa kali menyentuh threshold dalam satu sesi
            
            const confirmationKey = `${deviceKey}_${anomalyType}`;
            let confirmedCount = anomalyConfirmation.counts[confirmationKey] || 0;
            
            // Increment confirmation count
            confirmedCount++;
            anomalyConfirmation.counts[confirmationKey] = confirmedCount;
            saveAnomalyState(); // Debounced: save count increment
            
            // Log confirmation progress dengan detail lengkap
            const statusMessage = isDowntime ? '[DOWNTIME]' : '[NORMAL]';
            const modeLabel = anomalyServiceConfig.mode === 'fibonacci' ? 'FIB' : 'MANUAL';
            @* console.log(`ANOMALY DETECTED #${confirmedCount}: ${anomalyType} for ${deviceKey} ${statusMessage}`); *@

            if (isDowntime) {
                 @* console.log(`   Power: ${currentPower.toFixed(1)}W | EMA: ${emaValue.toFixed(1)}W | Threshold: ${thresholdValue.toFixed(1)}W`); *@
            } else {
                @* console.log(`   Power: ${currentPower.toFixed(1)}W | Upper: ${upper.toFixed(1)}W | Lower: ${lower.toFixed(1)}W | Threshold: ${thresholdValue.toFixed(1)}W`); *@
            }
            @* console.log(`   Mode: ${modeLabel} | Deviation: ${deviation.toFixed(1)}%`); *@
            
            // KIRIM LOG SETELAH 3x TERUS-MENERUS di  luar threshold (lebih cepat dari sebelumnya)
            if (confirmedCount >= anomalyConfirmation.maxConfirmations) {
                @* console.log(`ANOMALY CONFIRMED! ${anomalyType} for ${deviceKey} - ${confirmedCount}/${anomalyConfirmation.maxConfirmations} consecutive samples outside threshold`); *@
                @* console.log(`   Final: Power=${currentPower.toFixed(1)}W, Threshold=${thresholdValue.toFixed(1)}W, Deviation=${deviation.toFixed(1)}%`); *@

                // ============================================
                // CHART SNAPSHOT: Capture BEFORE data (last 50 points before anomaly)
                // ============================================
                var beforeStart = Math.max(0, powerData.length - CHART_SNAPSHOT_SIZE);
                var beforeData = [];
                for (var bi = beforeStart; bi < powerData.length; bi++) {
                    beforeData.push({
                        Timestamp: timestamps ? timestamps[bi] : null,
                        Power: powerData[bi],
                        Upper: thresholds.upper[bi] || null,
                        Lower: thresholds.lower[bi] || null,
                        EMA: ema[bi] || null
                    });
                }

                var chartSnapshotPayload = {
                    Before: beforeData,
                    After: [],  // Will be collected and sent separately
                    UpperThreshold: upper,
                    LowerThreshold: lower,
                    EMAValue: emaValue
 
                };

                /* console.log('ðŸ“Š Chart snapshot BEFORE data captured: ' + beforeData.length + ' points for ' + deviceKey) */;

                // Tamu (belum login): jangan POST ke log-anomaly (butuh role Operator/Admin)
                // agar tidak memicu respons 401 -> redirect ke halaman Login.
                // State anomali & notifikasi UI tetap diproses secara lokal di memori.
                if (typeof IS_USER_AUTHENTICATED !== 'undefined' && !IS_USER_AUTHENTICATED) {
                    anomalyCooldownState[deviceKey] = {
                        type: anomalyType,
                        loggedAt: Date.now(),
                        waitingForNormal: true
                    };
                    notifyCooldownChanged(deviceKey, true, anomalyType);
                    anomalyConfirmation.counts[confirmationKey] = 0;
                    return;
                }

                $.ajax({
                    url: '/api/Api/log-anomaly',
                    method: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({
                        deviceKey: deviceKey,
                        deviceId: deviceKey,
                        anomalyType: anomalyType,
                        powerValue: currentPower,
                        thresholdValue: thresholdValue,
                        deviation: Math.round(deviation * 10) / 10,
                        emaValue: emaValue,
                        thresholdMode: anomalyServiceConfig. mode,
                        chartSnapshot: chartSnapshotPayload
                    }),
                    success: function(response) {
                        @* console.log(`âœ… Anomaly logged: ${anomalyType} for ${deviceKey}`); *@

                        // ============================================
                        // CHART SNAPSHOT: Initialize AFTER buffer
                        // ============================================
                        if (response.success && response.logId) {
                            anomalyChartBuffers[deviceKey] = {
                                logId: response.logId,
                                beforeData: beforeData,
                                afterBuffer: [],
                                thresholds: { upper: upper, lower: lower },
                                createdAt: Date.now(),
                                lastSentCount: 0,
                                 lastSentTime: null
                            };
                            @* console.log('ðŸ“Š Chart snapshot after-buffer initialized for anomaly #' + response.logId); *@
                        }

                        // Set cooldown STATE - TUNGGU SAMPAI KEMBALI NORMAL
                        // Tidak ada timer! Hanya kondisi power normal yang bisa clear cooldown
                        anomalyCooldownState[deviceKey] = {
                            type: anomalyType,
                            loggedAt: Date.now(),
                            waitingForNormal: true  // Akan di-clear HANYA saat power normal
                        };

                        // Notify UI (panel header colors, chips, etc)
                        notifyCooldownChanged(deviceKey, true, anomalyType);

                        // Reset confirmation count
                        anomalyConfirmation.counts[confirmationKey] = 0;

                        // Critical: save cooldown state immediately (survive page reload)
                        saveAnomalyStateImmediate();

                        // Time-based cooldown DIHAPUS
                         // anomalyCooldown[cooldownK ey] = now;  // âŒ REMOVED
                    },
                    error: function(xhr, status, error) {
                        /* console.error('Error logging anomaly:', error) */;
                        // Reset confirmation count on error so it can retry
                        anomalyConfirmation.counts[confirmationKey] = 0;
                        saveAnomalyState(); // Debounced: save counter reset
                    }
                });
 
            } else {
                @* console.log(`â³ Still monitoring... (${confirmedCount}/${anomalyConfirmation.maxConfirmations} consecutiv e samples outside threshold)`); *@
                @* console.log(`â³ If power returns to normal before ${anomalyConfirmation.maxConfirmations}, counter will reset automatically`); *@
            }
        }

        function runAnomalyCheck() {
            if (!anomalyServiceConfig.enabled) return;

            $.ajax({
                url: '/api/Api/panels',
                method: 'GET',
                dataType: 'json',
                timeout: 5000,
                success: function(panels) {
                    if (!panels || !Array.isArray(panels)) return;
                    const deviceKeys = [...new Set(panels.map(p => p.deviceKey))];
                    deviceKeys.forEach(function(deviceKey) {
                        checkDeviceAnomaly( deviceKey);
                    });
                },
                 error: function() {}
            });
         }

        function startAnomalyService() {
            @* console.log('=== ANOMALY BACKGROUND SERVICE STARTED ==='); *@
            @* console.log(`â±ï¸ Initial chart refresh interval: ${chartRefreshInterval}s`); *@

            // Load settings, anomaly state, AND per-device settings before starting checks
             $.when(loadAnomalySettings(), loadAnomalyState(), (window._deviceSettingsPromise || $.Deferred().resolve())).done(function() {
                 @* console.log ('Settings, anomaly state, and per-device  settings loaded. Devices:', Object.keys(window._deviceSettings || {}).length); *@
                @* console.log('Starting anomaly checks...'); *@
                setTimeout(runAnomalyCheck, 2000);
                
                // Gunakan sampling interval dari preset anomaly.
                anomalyTimerInterval = (anomalyServiceConfig.checkInterval || 30) * 1000;
                anomalyTimer = setInterval(runAnomalyCheck, anomalyTimerInterval);
                @* console.log(`ðŸ”„ Anomaly check started with interval: ${anomalyTimerInterval / 1000}s`); *@
                
                // ============================================
                // RELOAD SETTINGS SETIAP 60 DETIK (2x chart interval)
                // Agar perubahan method SMA/EMA langs ung diterapkan
                // tanpa perlu reload halaman
                 // ============================================
                @* console.log('â° Settings reload timer started (every 60 seconds)'); *@
                settingsReloadTimer = setInterval(function() {
                    @* console.log('Reloading anomaly settings...'); *@
                    loadAnomalySettings().done(function() {
                         @* console.log('âœ… Settings reloaded successfully'); *@
                    }).fail(function() {
                        @* console.error('âŒ Failed to reload settings'); *@
                    });
                }, 60000); // Setiap 60 detik (2x chart interval)
            });
        }

        $(document).ready(function() {
            startAnomalyService();
        });
        
        // Cleanup saat halaman di-unload
        $(window).on('beforeunload', function() {
            // Save state sebelum halaman ditutup menggunakan sendBeacon
            if (anomalyStateSaveTimer) clearTimeout(anomalyStateSaveTimer);
            try {
                var payload = JSON.stringify({
                    confirmationCounts: JSON.stringify(anomalyConfirmation.counts),
                    cooldownState: JSON.stringify(anomalyCooldownState)
                });
                var blob = new Blob([payload], { type: 'application/json' });
                navigator.sendBeacon('/api/Api/save-anomaly-state', blob);
            } catch (e) {
                @* console.warn('Anomaly state save failed; it will be retried on the next page load.', e); *@
            }

            // Save any remaining chart snapshot after-buffers via sendBeacon
            try {
                Object.keys(anomalyChartBuffers).forEach(function(deviceKey) {
                    var buf = anomalyChartBuffers[deviceKey];
                    if (buf && buf.afterBuffer && buf.afterBuffer.length > 0 && buf.logId) {
                        var finalAfterData = buf.afterBuffer.slice(0, CHART_SNAPSHOT_SIZE);
                        var snapPayload = JSON.stringify({ After: finalAfterData, IsFinal: finalAfterData.length >= CHART_SNAPSHOT_SIZE });
                        var snapBlob = new Blob([snapPayload], { type:  'application/json' });
                        var sent = navigator.sendBeacon('/api/Api/anomaly-logs/' + buf.logId + '/chart-snapshot ', snapBlob);
                        @* console.log('ðŸ“Š Sent chart snapshot via sendBeacon  for #' + buf.logId + ' (' + buf.afterBuffer.length + ' points, sen t=' + sent + ')'); *@
                    }
                });
            } catch (e) {
                @* console.error('âŒ Error sending chart snapshot via se ndBeacon:', e); *@
            }

             if (anomalyTimer) clearInterval(anomalyTimer);
            if (settingsReloadTimer) clearInterval(settingsReloadTimer);
            @* console.log('ðŸ›‘ Anomaly service stopped'); *@
        });
    })();
</script>
