@{
    ViewData["Title"] = "Akses Ditolak";
    Layout = "_Layout";
}

<div class="container-fluid vh-100 d-flex align-items-center justify-content-center" style="background: linear-gradient(135deg, #dc3545 0%, #a52834 100%);">
    <div class="row justify-content-center w-100">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-lg border-0">
                <div class="card-body p-5 text-center">
                    <i class="fas fa-times-circle text-danger fa-4x mb-4"></i>
                    <h3 class="fw-bold text-danger">Akses Ditolak</h3>
                    <p class="text-muted mt-3">
                        Permintaan akses dari <strong>@ViewBag.UserEmail</strong> telah ditolak.<br>
                        Akun tersebut telah dinonaktifkan.
                    </p>
                    <a href="/" class="btn btn-danger mt-3">
                        <i class="fas fa-arrow-left me-2"></i> Ke Dashboard
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
