@{
    ViewData["Title"] = "Persetujuan Akses";
    Layout = "_Layout";
}

<div class="container-fluid vh-100 d-flex align-items-center justify-content-center" style="background: linear-gradient(135deg, #0d6efd 0%, #0a58ca 100%);">
    <div class="row justify-content-center w-100">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-lg border-0">
                <div class="card-body p-5">
                    @if (ViewBag.Approved == true)
                    {
                        <div class="text-center">
                            <i class="fas fa-check-circle text-success fa-4x mb-4"></i>
                            <h3 class="fw-bold text-success">Akses Disetujui</h3>
                            <p class="text-muted mt-3">
                                Pengguna <strong>@ViewBag.UserEmail</strong> telah diberikan role <strong>@ViewBag.Role</strong>.<br>
                                Email konfirmasi telah dikirim ke user.
                            </p>
                            <a href="/" class="btn btn-primary mt-3">
                                <i class="fas fa-arrow-left me-2"></i> Ke Dashboard
                            </a>
                        </div>
                    }
                    else
                    {
                        <div class="text-center mb-4">
                            <i class="fas fa-user-check text-primary fa-3x mb-3"></i>
                            <h3 class="fw-bold text-primary">Persetujuan Akses</h3>
                            <p class="text-muted">Setujui atau tolak permintaan akses pengguna baru.</p>
                        </div>

                        <div class="alert alert-info">
                            <p class="mb-1"><strong>Email:</strong> @ViewBag.UserEmail</p>
                            <p class="mb-1"><strong>Nama:</strong> @ViewBag.DisplayName</p>
                            <p class="mb-0"><strong>Tanggal Daftar:</strong> @ViewBag.RegisteredAt</p>
                        </div>

                        <form method="post" asp-controller="AdminApproval" asp-action="Approve">
                            <input type="hidden" name="email" value="@ViewBag.UserEmail" />
                            <input type="hidden" name="token" value="@ViewBag.Token" />

                            <div class="mb-3">
                                <label for="role" class="form-label">Pilih Role</label>
                                <select name="role" id="role" class="form-select" required>
                                    <option value="">Pilih role...</option>
                                    <option value="Viewer">Viewer (Hanya melihat)</option>
                                    <option value="Operator">Operator (Dapat mengontrol device)</option>
                                </select>
                            </div>

                            <div class="d-grid gap-2">
                                <button type="submit" name="action" value="approve" class="btn btn-success">
                                    <i class="fas fa-check me-2"></i> Setujui Akses
                                </button>
                            </div>
                        </form>

                        <div class="mt-3 text-center">
                            <a href="/AdminApproval/Reject?email=@Uri.EscapeDataString(ViewBag.UserEmail)&token=@Uri.EscapeDataString(ViewBag.Token)" class="btn btn-outline-danger">
                                <i class="fas fa-times me-2"></i> Tolak Akses
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
