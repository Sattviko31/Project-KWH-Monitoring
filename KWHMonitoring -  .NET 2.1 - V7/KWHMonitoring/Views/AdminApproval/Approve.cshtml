@{
    ViewData["Title"] = "Persetujuan Akses";
    Layout = "_Layout";
    ViewData["AuthPage"] = true;
}

<div class="auth-page">
    <div class="auth-card" data-card-help="Persetujuan Administrator|Halaman khusus administrator utama untuk menyetujui pendaftaran pengguna baru.|Pilih peran (Pengamat atau Operator) bagi pengguna yang disetujui.|Halaman ini dilindungi oleh token dari email dan token anti-pemalsuan permintaan; akun administrator tidak dapat disetujui melalui halaman ini.">
        <div class="card-body">
            @if (ViewBag.Approved == true)
            {
                <div class="text-center">
                    <div class="auth-logo auth-logo-success">
                        <i class="fas fa-check-circle"></i>
                    </div>
                    <h3 class="auth-title">Akses Disetujui</h3>
                    <p class="auth-subtitle">Persetujuan berhasil diproses</p>

                    <div class="auth-message">
                        Peran <strong>@ViewBag.Role</strong> telah diberikan kepada pengguna <strong>@ViewBag.UserEmail</strong>.<br>
                        Email konfirmasi telah dikirim kepada pengguna tersebut.
                    </div>

                    <a href="/" class="auth-btn auth-btn-primary">
                        <i class="fas fa-arrow-left"></i> Ke Dashboard
                    </a>
                </div>
            }
            else
            {
                <div class="text-center">
                    <div class="auth-logo">
                        <i class="fas fa-user-check"></i>
                    </div>
                    <h3 class="auth-title">Persetujuan Akses</h3>
                    <p class="auth-subtitle">Setujui atau tolak permintaan akses pengguna baru</p>
                </div>

                <div class="alert alert-info text-start">
                    <p class="mb-1"><strong>Email:</strong> @ViewBag.UserEmail</p>
                    <p class="mb-1"><strong>Nama:</strong> @ViewBag.DisplayName</p>
                    <p class="mb-0"><strong>Tanggal Daftar:</strong> @ViewBag.RegisteredAt</p>
                </div>

                <form method="post" asp-controller="AdminApproval" asp-action="Approve" novalidate>
                    <input type="hidden" name="email" value="@ViewBag.UserEmail" />
                    <input type="hidden" name="token" value="@ViewBag.Token" />

                    <div class="auth-input-group text-start">
                        <label for="role" class="auth-input-label">Pilih Peran</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fas fa-user-tag"></i></span>
                            <select name="role" id="role" class="form-control" required>
                                <option value="">Pilih peran...</option>
                                <option value="Viewer">Viewer (Hanya melihat)</option>
                                <option value="Operator">Operator (dapat mengendalikan perangkat)</option>
                            </select>
                        </div>
                    </div>

                    <button type="submit" name="action" value="approve" class="auth-btn auth-btn-success">
                        <i class="fas fa-check"></i> Setujui Akses
                    </button>
                </form>

                <div class="auth-links">
                    <a href="/AdminApproval/Reject?email=@Uri.EscapeDataString(ViewBag.UserEmail)&token=@Uri.EscapeDataString(ViewBag.Token)" class="btn btn-outline-danger w-100 py-2 fw-bold">
                        <i class="fas fa-times"></i> Tolak Akses
                    </a>
                </div>
            }
        </div>
    </div>
</div>
