@using System.Globalization
@functions {
    string FormatNoTrailingZeros(decimal value) {
        return value.ToString("0.#########################", CultureInfo.InvariantCulture);
    }
}
@{
    var devices = ViewBag.Devices as List<KWHMonitoring.Models.DeviceSettingsListItem> ?? new List<KWHMonitoring.Models.DeviceSettingsListItem>();
    var deviceSettings = ViewBag.DeviceSettings as Dictionary<string, KWHMonitoring.Models.DeviceSettings> ?? new Dictionary<string, KWHMonitoring.Models.DeviceSettings>();
    var categoryOptions = new[] { "Billboard", "Videotron", "LED", "Lainnya" };
}

<style>
.device-form-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.42rem;
}
.device-settings-group {
    min-width: 0;
    padding: 0.34rem 0.38rem 0.38rem;
    border: 1px solid rgba(108, 117, 125, 0.28);
    border-radius: 0.4rem;
    background: rgba(15, 23, 42, 0.18);
}
.device-settings-group-title {
    display: flex;
    align-items: center;
    min-height: 1rem;
    padding-bottom: 0.18rem;
    margin-bottom: 0.28rem;
    border-bottom: 1px solid rgba(108, 117, 125, 0.24);
    color: #a9c7e8;
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
}
.device-form-group {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.22rem 0.34rem;
    align-items: end;
    margin-bottom: 0.28rem;
}
.device-form-group-single {
    grid-template-columns: 1fr;
}
.device-form-group:last-child {
    margin-bottom: 0;
}
.device-form-row {
    display: flex;
    flex-direction: column;
    gap: 0.06rem;
    min-width: 0;
}
.device-label {
    font-size: 0.63rem;
    font-weight: 600;
    color: #6c757d;
    margin-bottom: 0;
    line-height: 1.15;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
[data-bs-theme="dark"] .device-label {
    color: #adb5bd;
}
.device-settings-card .card-body {
    padding: 0.36rem;
}
.device-settings-card .form-control-sm,
.device-settings-card .form-select-sm {
    width: 100%;
    min-width: 0;
    font-size: 0.69rem;
    padding: 0.14rem 0.3rem;
    height: calc(1.35em + 0.3rem + 2px);
}
.device-settings-card .form-check-input {
    width: 2em;
    height: 1em;
    flex: 0 0 auto;
}
.device-settings-card .form-check-label {
    font-size: 0.64rem;
    margin-left: 0.2rem;
    line-height: 1.1;
}
.device-settings-card .form-check.form-switch {
    display: flex;
    align-items: center;
    min-height: calc(1.35em + 0.3rem + 2px);
    margin: 0;
}
.device-pair {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 0.28rem;
    align-items: end;
}
.device-pair > .device-form-row,
.device-pair > .device-action-row {
    min-width: 0;
}
.device-action-row {
    display: flex;
    align-items: center;
    min-height: calc(1.35em + 0.3rem + 2px);
}
.device-action-row .form-check {
    width: 100%;
}
.device-budget-source {
    display: block;
    margin-top: 0.08rem;
    color: #7ea6d8;
    font-size: 0.56rem;
    line-height: 1.1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
.device-settings-card .device-form-row.align-self-center {
    align-self: stretch;
    justify-content: end;
}
.device-settings-card .card-footer {
    min-height: 2.2rem;
    padding: 0.28rem 0.42rem !important;
    gap: 0.35rem;
}
.device-settings-card .card-footer .btn {
    padding: 0.18rem 0.35rem;
    font-size: 0.64rem;
    white-space: nowrap;
}
.device-settings-card .status-text {
    font-size: 0.62rem !important;
    line-height: 1.1;
}
#deviceSettingsGrid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 310px), 1fr));
    gap: 0.7rem;
    align-items: stretch;
}
.device-settings-card > .card {
    display: flex;
    flex-direction: column;
}
.device-settings-card > .card > .card-body {
    flex: 1 1 auto;
}
@@media (max-width: 420px) {
    #deviceSettingsGrid {
        grid-template-columns: minmax(0, 1fr);
        gap: 0.5rem;
    }
    .device-form-group {
        grid-template-columns: minmax(0, 1fr);
    }
    .device-pair {
        grid-template-columns: minmax(0, 1fr);
    }
}
</style>

<div class="settings-section-list">
    <div class="settings-section">
        <div class="settings-section-header">
            <div class="settings-section-icon bg-primary-soft">
                <i class="fas fa-sliders-h text-primary"></i>
            </div>
            <div class="settings-section-title">
                <h5>Pengaturan Perangkat</h5>
                <p>Pengaturan khusus untuk setiap perangkat.</p>
            </div>
            <div class="settings-section-action">
                <button type="button" class="btn btn-outline-primary btn-sm" id="btnSaveAllDeviceSettings">
                    <i class="fas fa-save"></i> Simpan Semua
                </button>
            </div>
        </div>
        <div class="settings-section-body">
            @if (!devices.Any())
            {
                <div class="alert alert-info">
                    <i class="fas fa-info-circle"></i> Belum ada perangkat yang terdaftar.
                </div>
            }
            else
            {
                <div class="panel-grid mb-3" id="deviceSettingsGrid">
                    @foreach (var device in devices)
                    {
                        var settings = deviceSettings.ContainsKey(device.DeviceKey) ? deviceSettings[device.DeviceKey] : new KWHMonitoring.Models.DeviceSettings { DeviceKey = device.DeviceKey };
                        var safeKey = device.DeviceKey.Replace("-", "_");
                        <div class="device-settings-card" data-device-key="@device.DeviceKey" data-safe-key="@safeKey">
                            <div class="card shadow-sm h-100 border-0">
                                <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center py-2">
                                    <h6 class="mb-0 text-truncate" style="font-size: 0.9rem;">
                                        <i class="fas fa-plug"></i> @device.GroupName
                                    </h6>
                                    <span class="badge bg-info">@device.DeviceKey</span>
                                </div>
                                <div class="card-body p-2">
                                    <div class="device-form-grid">
                                        <div class="device-settings-group">
                                            <div class="device-settings-group-title">Perangkat &amp; Tarif</div>
                                            <div class="device-form-row">
                                                <label class="device-label">Kategori</label>
                                                <select class="form-select form-select-sm device-category" data-field="DeviceCategory">
                                                    @foreach (var cat in categoryOptions)
                                                    {
                                                        var isSelected = settings.DeviceCategory == cat;
                                                        <option value="@cat" selected="@(isSelected ? "selected" : null)">@cat</option>
                                                    }
                                                    @if (!categoryOptions.Contains(settings.DeviceCategory))
                                                    {
                                                        <option value="@settings.DeviceCategory" selected="selected">@settings.DeviceCategory</option>
                                                    }
                                                </select>
                                            </div>
                                            <div class="device-form-group device-form-group-single">
                                                <div class="device-form-row">
                                                    <input type="hidden" data-field="MaxCapacity" value="@FormatNoTrailingZeros(settings.MaxCapacity)">
                                                    <label class="device-label">Tarif (Rp/kWh)</label>
                                                    <input type="number" class="form-control form-control-sm" data-field="TariffPerKWh" value="@FormatNoTrailingZeros(settings.TariffPerKWh)" min="0" step="50">
                                                </div>
                                            </div>
                                            <div class="device-form-group">
                                                <div class="device-form-row">
                                                    <label class="device-label">Tarif WBP (Rp)</label>
                                                    <input type="number" class="form-control form-control-sm" data-field="TariffWBP" value="@FormatNoTrailingZeros(settings.TariffWBP)" min="0" step="50">
                                                </div>
                                                <div class="device-form-row">
                                                    <label class="device-label">Tarif LWBP (Rp)</label>
                                                    <input type="number" class="form-control form-control-sm" data-field="TariffLWBP" value="@FormatNoTrailingZeros(settings.TariffLWBP)" min="0" step="50">
                                                </div>
                                            </div>
                                         </div>
                                         <div class="device-settings-group">
                                             <div class="device-settings-group-title">Billing &amp; Anggaran</div>
                                             <div class="device-pair">
                                                 <div class="device-form-row device-budget-input">
                                                     <label class="device-label">Anggaran Bulanan (Rp)</label>
                                                      <input type="number" class="form-control form-control-sm" data-field="MonthlyBillingBudgetAmount" value="@(settings.MonthlyBillingBudgetAmount.HasValue ? FormatNoTrailingZeros(settings.MonthlyBillingBudgetAmount.Value) : string.Empty)" min="0" step="1000" @(!settings.MonthlyBillingBudgetManualOverride ? "disabled" : "")>
                                                     <small class="device-budget-source">Sumber: @(settings.MonthlyBillingBudgetManualOverride ? "Manual" : (settings.MonthlyBillingBudgetSource ?? "Trend"))</small>
                                                     <input type="hidden" data-field="BudgetKWh" value="@FormatNoTrailingZeros(settings.BudgetKWh)">
                                                 </div>
                                                 <div class="device-action-row">
                                                     <div class="form-check form-switch">
                                                         <input class="form-check-input" type="checkbox" data-field="MonthlyBillingBudgetAuto" @(!settings.MonthlyBillingBudgetManualOverride ? "checked" : "")>
                                                         <label class="form-check-label device-label">Otomatis dari trend</label>
                                                     </div>
                                                 </div>
                                             </div>
                                             <div class="device-pair">
                                                 <div class="device-form-row">
                                                     <label class="device-label">Luas (m²)</label>
                                                     <input type="number" class="form-control form-control-sm" data-field="SurfaceArea" value="@FormatNoTrailingZeros(settings.SurfaceArea)" min="0" step="0.1">
                                                 </div>
                                                 <div class="device-form-row">
                                                     <label class="device-label">Pendapatan per Jam (Rp)</label>
                                                     <input type="number" class="form-control form-control-sm" data-field="RevenuePerHour" value="@FormatNoTrailingZeros(settings.RevenuePerHour)" min="0" step="1000">
                                                 </div>
                                             </div>
                                             <div class="device-pair">
                                                 <div class="device-action-row">
                                                     <div class="form-check form-switch">
                                                         <input class="form-check-input" type="checkbox" data-field="BillingCutoffEnabled" @(settings.BillingCutoffEnabled ? "checked" : "")>
                                                         <label class="form-check-label device-label">Cutoff Meter PLN</label>
                                                     </div>
                                                 </div>
                                                 <div class="device-form-row">
                                                     <label class="device-label">Tanggal Cutoff (25-31)</label>
                                                     <select class="form-select form-select-sm" data-field="BillingCutoffDay" @(settings.BillingCutoffEnabled ? "" : "disabled")>
                                                         <option value="" selected="@(!settings.BillingCutoffDay.HasValue ? "selected" : null)">Tidak digunakan</option>
                                                         @for (var cutoffDay = 25; cutoffDay <= 31; cutoffDay++)
                                                         {
                                                             <option value="@cutoffDay" selected="@(settings.BillingCutoffDay == cutoffDay ? "selected" : null)">@cutoffDay</option>
                                                         }
                                                     </select>
                                                 </div>
                                             </div>
                                         </div>
                                         <div class="device-settings-group">
                                            <div class="device-settings-group-title">Threshold Billing</div>
                                        <div class="device-form-group">
                                            <div class="device-form-row">
                                                <label class="device-label">Ambang Selisih Tagihan (Rp)</label>
                                                <input type="number" class="form-control form-control-sm" data-field="BillingAnomalyThreshold" value="@(settings.BillingAnomalyThreshold.HasValue ? FormatNoTrailingZeros(settings.BillingAnomalyThreshold.Value) : string.Empty)" min="0" step="1000">
                                            </div>
                                        </div>
                                        <div class="device-form-group">
                                            <div class="device-form-row">
                                                <label class="device-label">Mode Threshold</label>
                                                <select class="form-select form-select-sm" data-field="BillingAnomalyThresholdMode">
                                                    <option value="AMOUNT" selected="@(settings.BillingAnomalyThresholdMode == "AMOUNT" ? "selected" : null)">Nominal</option>
                                                    <option value="PERCENTAGE" selected="@(settings.BillingAnomalyThresholdMode == "PERCENTAGE" ? "selected" : null)">Persentase</option>
                                                </select>
                                            </div>
                                            <div class="device-form-row">
                                                <label class="device-label">Threshold Persentase (%)</label>
                                                <input type="number" class="form-control form-control-sm" data-field="BillingAnomalyThresholdPercent" value="@(settings.BillingAnomalyThresholdPercent.HasValue ? FormatNoTrailingZeros(settings.BillingAnomalyThresholdPercent.Value) : string.Empty)" min="0" max="1000" step="0.01">
                                            </div>
                                        </div>
                                        <div class="device-form-group">
                                            <div class="device-form-row">
                                                <label class="device-label">Mode Toleransi Trend</label>
                                                <select class="form-select form-select-sm" data-field="BillingTrendToleranceMode">
                                                    <option value="PERCENTAGE" selected="@(settings.BillingTrendToleranceMode == "PERCENTAGE" ? "selected" : null)">Persentase</option>
                                                    <option value="AMOUNT" selected="@(settings.BillingTrendToleranceMode == "AMOUNT" ? "selected" : null)">Nominal</option>
                                                </select>
                                            </div>
                                            <div class="device-form-row">
                                                <label class="device-label">Toleransi Trend (%)</label>
                                                <input type="number" class="form-control form-control-sm" data-field="BillingTrendTolerancePercent" value="@(settings.BillingTrendTolerancePercent.HasValue ? FormatNoTrailingZeros(settings.BillingTrendTolerancePercent.Value) : string.Empty)" min="0" max="1000" step="0.01">
                                            </div>
                                        </div>
                                        <div class="device-form-group device-form-group-single">
                                            <div class="device-form-row">
                                                <label class="device-label">Toleransi Trend (Rp)</label>
                                                <input type="number" class="form-control form-control-sm" data-field="BillingTrendToleranceAmount" value="@(settings.BillingTrendToleranceAmount.HasValue ? FormatNoTrailingZeros(settings.BillingTrendToleranceAmount.Value) : string.Empty)" min="0" step="1000">
                                            </div>
                                        </div>
                                        <div class="device-form-group">
                                            <div class="device-form-row">
                                                <label class="device-label">Normal (%)</label>
                                                <input type="number" class="form-control form-control-sm" data-field="LoadNormalThreshold" value="@settings.LoadNormalThreshold" min="1" max="100">
                                            </div>
                                            <div class="device-form-row">
                                                <label class="device-label">Medium (%)</label>
                                                <input type="number" class="form-control form-control-sm" data-field="LoadMediumThreshold" value="@settings.LoadMediumThreshold" min="1" max="100">
                                            </div>
                                        </div>
                                        <div class="device-form-group">
                                            <div class="device-form-row">
                                                <label class="device-label">Upper Line (%)</label>
                                                <input type="number" class="form-control form-control-sm" data-field="EmaUpperThreshold" value="@settings.EmaUpperThreshold" min="0" max="1000">
                                            </div>
                                            <div class="device-form-row">
                                                <label class="device-label">Lower Line (%)</label>
                                                <input type="number" class="form-control form-control-sm" data-field="EmaLowerThreshold" value="@settings.EmaLowerThreshold" min="0" max="100">
                                            </div>
                                        </div>
                                        </div>
                                        <div class="device-settings-group">
                                            <div class="device-settings-group-title">Waktu &amp; Kendali</div>
                                        <div class="device-form-group">
                                            <div class="device-form-row">
                                                <label class="device-label">Mulai</label>
                                                <input type="time" class="form-control form-control-sm" data-field="DowntimeStart" value="@settings.DowntimeStart.ToString(@"hh\:mm")">
                                            </div>
                                            <div class="device-form-row">
                                                <label class="device-label">Selesai</label>
                                                <input type="time" class="form-control form-control-sm" data-field="DowntimeEnd" value="@settings.DowntimeEnd.ToString(@"hh\:mm")">
                                            </div>
                                        </div>
                                        <div class="device-form-group">
                                            <div class="device-form-row">
                                                <label class="device-label">Mode Kendali</label>
                                                <select class="form-select form-select-sm device-control-mode" data-field="ControlMode">
                                                    <option value="OnOff" selected="@(settings.ControlMode == "OnOff" ? "selected" : null)">ON/OFF</option>
                                                    <option value="Toggle" selected="@(settings.ControlMode == "Toggle" ? "selected" : null)">Toggle</option>
                                                    <option value="Pulse" selected="@(settings.ControlMode == "Pulse" ? "selected" : null)">Pulse</option>
                                                    <option value="Toggle2Relay" selected="@(settings.ControlMode == "Toggle2Relay" ? "selected" : null)">2 Relay</option>
                                                    <option value="ToggleAll" selected="@(settings.ControlMode == "ToggleAll" ? "selected" : null)">All</option>
                                                </select>
                                            </div>
                                            <div class="device-form-row align-self-center">
                                                <div class="form-check form-switch">
                                                    <input class="form-check-input" type="checkbox" data-field="DowntimeEnabled" @(settings.DowntimeEnabled ? "checked" : "")>
                                                    <label class="form-check-label device-label">Waktu Henti</label>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="device-form-group device-form-group-single">
                                            <div class="device-form-row align-self-center">
                                                <div class="form-check form-switch">
                                                    <input class="form-check-input" type="checkbox" data-field="InvertRelayCommand" @(settings.InvertRelayCommand ? "checked" : "")>
                                                    <label class="form-check-label device-label">Invers Perintah</label>
                                                </div>
                                            </div>
                                        </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="card-footer bg-light py-2 d-flex justify-content-between align-items-center">
                                    <small class="text-muted status-text" style="font-size: 0.75rem;">Belum disimpan</small>
                                    <div class="d-flex gap-1">
                                        <button type="button" class="btn btn-outline-danger btn-sm btn-reset-chart-data" data-device-key="@device.DeviceKey" title="Hapus seluruh data grafik untuk menghitung ulang nilai SMA">
                                            <i class="fas fa-trash-alt"></i> Atur Ulang Grafik
                                        </button>
                                        <button type="button" class="btn btn-primary btn-sm btn-save-device-settings" data-device-key="@device.DeviceKey">
                                            <i class="fas fa-save"></i> Simpan
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

<script>
    (function() {
        function numberValue($card, field, fallback) {
            var value = parseFloat($card.find('[data-field="' + field + '"]').val());
            return isNaN(value) ? fallback : value;
        }

        function integerValue($card, field, fallback) {
            var value = parseInt($card.find('[data-field="' + field + '"]').val(), 10);
            return isNaN(value) ? fallback : value;
        }

        function nullableNumberValue($card, field) {
            var raw = $card.find('[data-field="' + field + '"]').val();
            if (raw === undefined || raw === null || String(raw).trim() === '') return null;
            var value = parseFloat(raw);
            return isNaN(value) || value < 0 ? null : value;
        }

        function collectDeviceSettings($card) {
            return {
                deviceKey: $card.data('device-key'),
                maxCapacity: numberValue($card, 'MaxCapacity', 0),
                deviceCategory: $card.find('[data-field="DeviceCategory"]').val() || 'Billboard',
                downtimeEnabled: $card.find('[data-field="DowntimeEnabled"]').is(':checked'),
                downtimeStart: $card.find('[data-field="DowntimeStart"]').val() || '00:00',
                downtimeEnd: $card.find('[data-field="DowntimeEnd"]').val() || '06:00',
                tariffPerKWh: numberValue($card, 'TariffPerKWh', 0),
                tariffWBP: numberValue($card, 'TariffWBP', 0),
                tariffLWBP: numberValue($card, 'TariffLWBP', 0),
                wbpStartHour: integerValue($card, 'WbpStartHour', 0),
                wbpEndHour: integerValue($card, 'WbpEndHour', 0),
                budgetKWh: (function() {
                    var monthlyBudget = nullableNumberValue($card, 'MonthlyBillingBudgetAmount');
                    var tariff = numberValue($card, 'TariffPerKWh', 0);
                    return monthlyBudget !== null && tariff > 0 ? monthlyBudget / tariff : numberValue($card, 'BudgetKWh', 0);
                })(),
                surfaceArea: numberValue($card, 'SurfaceArea', 0),
                revenuePerHour: numberValue($card, 'RevenuePerHour', 0),
                billingAnomalyThreshold: (function() {
                    var raw = $card.find('[data-field="BillingAnomalyThreshold"]').val();
                    if (raw === undefined || raw === null || raw.trim() === '') return null;
                    var value = parseFloat(raw);
                    return isNaN(value) || value < 0 ? null : value;
                })(),
                billingAnomalyThresholdMode: $card.find('[data-field="BillingAnomalyThresholdMode"]').val() || 'AMOUNT',
                billingAnomalyThresholdPercent: nullableNumberValue($card, 'BillingAnomalyThresholdPercent'),
                billingTrendToleranceMode: $card.find('[data-field="BillingTrendToleranceMode"]').val() || 'PERCENTAGE',
                billingTrendToleranceAmount: nullableNumberValue($card, 'BillingTrendToleranceAmount'),
                billingTrendTolerancePercent: nullableNumberValue($card, 'BillingTrendTolerancePercent'),
                monthlyBillingBudgetAmount: nullableNumberValue($card, 'MonthlyBillingBudgetAmount'),
                monthlyBillingBudgetSource: $card.find('[data-field="MonthlyBillingBudgetAuto"]').is(':checked') ? 'TREND_AUTO' : 'MANUAL',
                monthlyBillingBudgetManualOverride: !$card.find('[data-field="MonthlyBillingBudgetAuto"]').is(':checked'),
                loadNormalThreshold: integerValue($card, 'LoadNormalThreshold', 0),
                loadMediumThreshold: integerValue($card, 'LoadMediumThreshold', 0),
                emaUpperThreshold: integerValue($card, 'EmaUpperThreshold', 0),
                emaLowerThreshold: integerValue($card, 'EmaLowerThreshold', 0),
                emaFibUpper: 0,
                emaFibLower: 0,
                controlMode: $card.find('[data-field="ControlMode"]').val() || 'OnOff',
                invertRelayCommand: $card.find('[data-field="InvertRelayCommand"]').is(':checked')
                ,billingCutoffEnabled: $card.find('[data-field="BillingCutoffEnabled"]').is(':checked')
                ,billingCutoffDay: (function() {
                    var raw = $card.find('[data-field="BillingCutoffDay"]').val();
                    if (!raw) return null;
                    var value = parseInt(raw, 10);
                    return isNaN(value) ? null : value;
                })()
            };
        }

        function timeSpanFromString(timeStr) {
            var parts = timeStr.split(':');
            var hours = parseInt(parts[0]) || 0;
            var minutes = parseInt(parts[1]) || 0;
            return hours.toString().padStart(2, '0') + ':' + minutes.toString().padStart(2, '0') + ':00';
        }

        function saveDeviceSettings(deviceKey, settings, $card) {
            var $status = $card.find('.status-text');
            $status.text('Menyimpan...');

            var payload = {
                maxCapacity: settings.maxCapacity,
                deviceCategory: settings.deviceCategory,
                downtimeEnabled: settings.downtimeEnabled,
                downtimeStart: timeSpanFromString(settings.downtimeStart),
                downtimeEnd: timeSpanFromString(settings.downtimeEnd),
                tariffPerKWh: settings.tariffPerKWh,
                tariffWBP: settings.tariffWBP,
                tariffLWBP: settings.tariffLWBP,
                wbpStartHour: settings.wbpStartHour,
                wbpEndHour: settings.wbpEndHour,
                budgetKWh: settings.budgetKWh,
                surfaceArea: settings.surfaceArea,
                loadNormalThreshold: settings.loadNormalThreshold,
                loadMediumThreshold: settings.loadMediumThreshold,
                emaUpperThreshold: settings.emaUpperThreshold,
                emaLowerThreshold: settings.emaLowerThreshold,
                emaFibUpper: settings.emaFibUpper,
                emaFibLower: settings.emaFibLower,
                revenuePerHour: settings.revenuePerHour,
                billingAnomalyThreshold: settings.billingAnomalyThreshold,
                billingAnomalyThresholdMode: settings.billingAnomalyThresholdMode,
                billingAnomalyThresholdPercent: settings.billingAnomalyThresholdPercent,
                billingTrendToleranceMode: settings.billingTrendToleranceMode,
                billingTrendToleranceAmount: settings.billingTrendToleranceAmount,
                billingTrendTolerancePercent: settings.billingTrendTolerancePercent,
                monthlyBillingBudgetAmount: settings.monthlyBillingBudgetAmount,
                monthlyBillingBudgetSource: settings.monthlyBillingBudgetSource,
                monthlyBillingBudgetManualOverride: settings.monthlyBillingBudgetManualOverride,
                controlMode: settings.controlMode,
                invertRelayCommand: settings.invertRelayCommand,
                billingCutoffEnabled: settings.billingCutoffEnabled,
                billingCutoffDay: settings.billingCutoffEnabled ? settings.billingCutoffDay : null
            };

            $.ajax({
                url: '/api/Api/device-settings/' + encodeURIComponent(deviceKey),
                method: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(payload),
                success: function(response) {
                    if (response.success) {
                        $status.text('Tersimpan').removeClass('text-muted').addClass('text-success');
                        setTimeout(function() {
                            $status.text('Belum disimpan').removeClass('text-success').addClass('text-muted');
                        }, 3000);
                    } else {
                        $status.text('Gagal: ' + response.message);
                    }
                },
                error: function(xhr) {
                    var msg = 'Error';
                    try { msg = JSON.parse(xhr.responseText).message || msg; } catch(e) {}
                    $status.text('Gagal: ' + msg);
                }
            });
        }

        $(document).on('click', '.btn-save-device-settings', function() {
            var $card = $(this).closest('.device-settings-card');
            var deviceKey = $card.data('device-key');
            var settings = collectDeviceSettings($card);
            saveDeviceSettings(deviceKey, settings, $card);
        });

        $(document).on('change', '[data-field="BillingCutoffEnabled"]', function() {
            var $card = $(this).closest('.device-settings-card');
            var $day = $card.find('[data-field="BillingCutoffDay"]');
            $day.prop('disabled', !$(this).is(':checked'));
            if (!$(this).is(':checked')) $day.val('');
        });

        function updateMonthlyBillingBudgetMode($card) {
            var auto = $card.find('[data-field="MonthlyBillingBudgetAuto"]').is(':checked');
            $card.find('[data-field="MonthlyBillingBudgetAmount"]')
                .prop('disabled', auto)
                .attr('placeholder', auto ? 'Diisi oleh trend' : 'Masukkan budget manual');
        }

        $(document).on('change', '[data-field="MonthlyBillingBudgetAuto"]', function() {
            updateMonthlyBillingBudgetMode($(this).closest('.device-settings-card'));
        });

        $('.device-settings-card').each(function() {
            updateMonthlyBillingBudgetMode($(this));
        });

        $('#btnSaveAllDeviceSettings').on('click', function() {
            var allSettings = [];
            $('.device-settings-card').each(function() {
                var $card = $(this);
                var settings = collectDeviceSettings($card);
                settings.downtimeStart = timeSpanFromString(settings.downtimeStart || '22:00');
                settings.downtimeEnd = timeSpanFromString(settings.downtimeEnd || '06:00');
                allSettings.push(settings);
            });

            $.ajax({
                url: '/api/Api/device-settings/bulk',
                method: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({ settings: allSettings }),
                success: function(response) {
                    if (response.success) {
                        $('.status-text').text('Tersimpan').removeClass('text-muted').addClass('text-success');
                        setTimeout(function() {
                            $('.status-text').text('Belum disimpan').removeClass('text-success').addClass('text-muted');
                        }, 3000);
                    } else {
                        alert('Gagal menyimpan: ' + response.message);
                    }
                },
                error: function(xhr) {
                    var msg = 'Error';
                    try { msg = JSON.parse(xhr.responseText).message || msg; } catch(e) {}
                    alert('Gagal menyimpan: ' + msg);
                }
            });
        });

        // Reset Chart Data
        $(document).on('click', '.btn-reset-chart-data', function() {
            var $btn = $(this);
            var deviceKey = $btn.data('device-key');
            var $card = $btn.closest('.device-settings-card');
            var $status = $card.find('.status-text');

            var isEnglish = false;
            try { isEnglish = localStorage.getItem('kwh_language') === 'en'; } catch (_) { }
            var confirmMessage = isEnglish
                ? 'Reset all chart data for device ' + deviceKey + '?\n\nEnergy data will be deleted and the simple moving average (SMA) will be recalculated from new data.\nThis action cannot be undone.'
                : 'Atur ulang seluruh data grafik untuk perangkat ' + deviceKey + '?\n\nData energi akan dihapus dan nilai rata-rata bergerak sederhana (SMA) akan dihitung kembali berdasarkan data baru.\nTindakan ini tidak dapat dibatalkan.';
            if (!confirm(confirmMessage)) {
                return;
            }

            $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> ' + (isEnglish ? 'Resetting...' : 'Mengatur ulang...'));
            $status.text(isEnglish ? 'Deleting chart data...' : 'Menghapus data grafik...');

            $.ajax({
                url: '/api/Api/reset-chart-data/' + encodeURIComponent(deviceKey),
                method: 'DELETE',
                success: function(response) {
                    if (response.success) {
                        var count = response.deletedCount || 0;
                        $status.text(isEnglish ? 'Chart reset (' + count + ' records).' : 'Grafik berhasil diatur ulang (' + count + ' data).').removeClass('text-muted').addClass('text-success');
                        setTimeout(function() {
                            $status.text('Belum disimpan').removeClass('text-success').addClass('text-muted');
                        }, 5000);
                    } else {
                        $status.text((isEnglish ? 'Failed: ' : 'Gagal: ') + response.message).removeClass('text-muted').addClass('text-danger');
                    }
                },
                error: function(xhr) {
                    var msg = isEnglish ? 'An error occurred.' : 'Terjadi kesalahan.';
                    try { msg = JSON.parse(xhr.responseText).message || msg; } catch(e) {}
                    $status.text((isEnglish ? 'Failed: ' : 'Gagal: ') + msg).removeClass('text-muted').addClass('text-danger');
                },
                complete: function() {
                    $btn.prop('disabled', false).html('<i class="fas fa-trash-alt"></i> ' + (isEnglish ? 'Reset Chart' : 'Atur Ulang Grafik'));
                }
            });
        });
    })();
</script>
