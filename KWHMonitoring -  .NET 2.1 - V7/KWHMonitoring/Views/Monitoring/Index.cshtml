        // ============================================
        // ANOMALY DETECTION & LOGGING
        // ============================================
        let anomalyCooldown = {}; // Mencegah spam log
        let anomalyConfirmation = {
            counts: {},
            maxConfirmations: 3
        };

        function detectAndLogAnomaly(deviceKey, powerData, ema, upperThreshold, lowerThreshold) {
            if (!emaSettings.enableAlerts) return;

            if (anomalyConfirmation.maxConfirmations <= 0) {
                console.log('Anomaly detection disabled (maxConfirmations=' + anomalyConfirmation.maxConfirmations + ')');
                return;
            }

            // Cek data point terakhir saja (real-time)
            const lastIndex = powerData.length - 1;
            if (lastIndex < 0) return;

            const currentPower = powerData[lastIndex];
            const upper = upperThreshold[lastIndex];
            const lower = lowerThreshold[lastIndex];

            if (currentPower === null || currentPower === undefined) return;
            if (upper === undefined || lower === undefined) return;

            let anomalyType = null;
            let thresholdValue = 0;
            let deviation = 0;

            if (currentPower > upper) {
                anomalyType = 'OVERLOAD';
                thresholdValue = upper;
                deviation = ((currentPower - upper) / upper * 100);
            } else if (currentPower < lower) {
                anomalyType = 'DROP';
                thresholdValue = lower;
                deviation = ((lower - currentPower) / lower * 100);
            }

            if (!anomalyType) return;

            const confirmationKey = `${deviceKey}_${anomalyType}`;
            let confirmedCount = anomalyConfirmation.counts[confirmationKey] || 0;
            confirmedCount++;
            anomalyConfirmation.counts[confirmationKey] = confirmedCount;

            console.log(`⚠️ ANOMALY CHECK: ${anomalyType} for ${deviceKey} - Count: ${confirmedCount}/${anomalyConfirmation.maxConfirmations}`);

            if (confirmedCount < anomalyConfirmation.maxConfirmations) {
                console.log(`⏳ Waiting for more samples... (${confirmedCount}/${anomalyConfirmation.maxConfirmations} needed)`);
                return;
            }

            // Cooldown 60 detik per device per type
            const cooldownKey = `${deviceKey}_${anomalyType}`;
            const now = Date.now();
            if (anomalyCooldown[cooldownKey] && (now - anomalyCooldown[cooldownKey]) < 60000) {
                return;
            }
            anomalyCooldown[cooldownKey] = now;

            // Log ke database
            $.ajax({
                url: '/api/Api/log-anomaly',
                method: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({
                    deviceKey: deviceKey,
                    deviceId: deviceKey,
                    anomalyType: anomalyType,
                    powerValue: currentPower,
                    thresholdValue: thresholdValue,
                    deviation: Math.round(deviation * 10) / 10,
                    emaValue: ema[lastIndex],
                    thresholdMode: emaSettings.mode
                }),
                success: function(response) {
                    console.log(`Anomaly logged: ${anomalyType} for ${deviceKey}`);
                    anomalyConfirmation.counts[confirmationKey] = 0;
                },
                error: function(xhr, status, error) {
                    console.error('Error logging anomaly:', error);
                    anomalyConfirmation.counts[confirmationKey] = 0;
                }
            });

            // Show alert modal
            showAnomalyAlert(deviceKey, anomalyType, currentPower, thresholdValue, deviation);
        }

        function showAnomalyAlert(deviceKey, type, power, threshold, deviation) {
            const isOverload = type === 'OVERLOAD';
            const content = `
                <div class="alert alert-${isOverload ? 'danger' : 'warning'}">
                    <h5><i class="fas ${isOverload ? 'fa-bolt' : 'fa-power-off'}"></i> ${isOverload ? 'OVERLOAD' : 'DEVICE DROP'} DETECTED</h5>
                    <hr>
                    <p><strong>Device:</strong> ${deviceKey}</p>
                    <p><strong>Power:</strong> ${formatNumber(power)} W</p>
                    <p><strong>Threshold:</strong> ${formatNumber(threshold)} W</p>
                    <p><strong>Deviation:</strong> ${deviation.toFixed(1)}%</p>
                    <p><strong>Time:</strong> ${new Date().toLocaleString('id-ID')}</p>
                </div>
            `;
            $('#anomalyContent').html(content);
            $('#anomalyModal').modal('show');
        }

        // Update header panel berdasarkan REAL-TIME cooldown state (bukan log 5 menit ke belakang)
        function updatePanelHeadersByAnomaly() {
            // Ambil cooldown state langsung dari anomaly service (real-time)
            const cooldownState = (typeof window.getAnomalyCooldownState === 'function') 
                ? window.getAnomalyCooldownState() 
                : {};

            // Build deviceStatus from cooldown state (real-time, bukan database log)
            const deviceStatus = {};
            Object.keys(cooldownState).forEach(function(deviceKey) {
                if (cooldownState[deviceKey] && cooldownState[deviceKey].waitingForNormal) {
                    deviceStatus[deviceKey] = cooldownState[deviceKey].type; // 'OVERLOAD' or 'DROP'
                }
            });

            // Update anomalyStatusMap for chip coloring
            anomalyStatusMap = {};
            panelList.forEach(function(panel) {
                const status = deviceStatus[panel.deviceKey];
                if (status === 'OVERLOAD' || status === 'DROP') {
                    anomalyStatusMap[panel.deviceKey] = status;
                }
            });

            // Re-render chips with updated anomaly colors
            renderPanelChips();

            // Update panel card headers
            panelList.forEach(function(panel) {
                const safeKey = panel.safeKey;
                const panelCard = document.getElementById(`panel_${safeKey}`);
                const header = panelCard ? panelCard.querySelector('.card-header') : null;
                // Get all badges, pick the LAST one (status badge, not phase badge)
                const badges = panelCard ? panelCard.querySelectorAll('.card-header .badge') : null;
                const badge = badges && badges.length > 1 ? badges[badges.length - 1] : badges?.[0];

                if (!header || !badge) return;

                const status = deviceStatus[panel.deviceKey];

                // Reset color-related classes only, keep layout classes intact
                header.classList.remove('bg-danger', 'bg-warning', 'bg-dark', 'text-white', 'text-dark');

                if (status === 'OVERLOAD') {
                    header.classList.add('bg-danger', 'text-white');
                    badge.className = 'badge me-2 bg-danger';
                    badge.textContent = 'OVERLOAD';
                } else if (status === 'DROP') {
                    header.classList.add('bg-warning', 'text-dark');
                    badge.className = 'badge me-2 bg-warning text-dark';
                    badge.textContent = 'DROP';
                } else {
                    // Normal status - reset to dark background
                    header.classList.add('bg-dark', 'text-white');
                    badge.className = 'badge me-2 bg-success';
                    badge.textContent = 'NORMAL';
                }
            });

            const anomalyCount = Object.keys(deviceStatus).length;
            $('#anomalyBadge').text(anomalyCount);
        }

        // ============================================
        // SYNC PROGRESS BARS (Initial Load)
        // ============================================
        function syncProgressBars() {
            console.log('Syncing progress bars with settings:', systemSettings);

            panelList.forEach(function(panel) {
                const safeKey = panel.deviceKey.replace(/-/g, '_');
                const panelCard = $(`#panel_${safeKey}`);
                if (panelCard.length === 0) return;

                // Ambil nilai dari data-value yang sudah di-render server
                const cosPhiText = panelCard.find('[data-value="cosphi"]').text().replace(',', '.');
                const loadText = panelCard.find('[data-label="load-value"]').text().replace(/\./g, '').replace(' W', '').replace(',', '.');

                const cosPhi = parseFloat(cosPhiText) || 0;
                const dayaWatt = parseFloat(loadText) || 0;

                // Update Power Factor gauge
                const pfPercent = (cosPhi * 100).toFixed(1);
                const pfBar = panelCard.find('[data-gauge="power-factor"]');
                if (pfBar.length > 0) {
                    pfBar.css('width', pfPercent + '%');
                    pfBar.text(pfPercent.replace('.', ',') + '%');
                    pfBar.removeClass('bg-success bg-warning bg-danger');
                    if (cosPhi >= 0.8) pfBar.addClass('bg-success');
                    else if (cosPhi >= 0.6) pfBar.addClass('bg-warning');
                    else pfBar.addClass('bg-danger');
                }

                // Update Load gauge MENGGUNAKAN systemSettings
                const maxCap = systemSettings.maxCapacity || 30000;
                const normalThresh = systemSettings.normalThreshold || 30;
                const mediumThresh = systemSettings.mediumThreshold || 70;

                const loadPercent = Math.min((dayaWatt / maxCap) * 100, 100);
                const loadBar = panelCard.find('[data-gauge="load"]');

                if (loadBar.length > 0) {
                    loadBar.css('width', loadPercent.toFixed(1) + '%');
                    loadBar.removeClass('bg-info bg-warning bg-danger');

                    // Gunakan threshold dinamis dari settings
                    if (loadPercent > mediumThresh) {
                        loadBar.addClass('bg-danger'); // High
                    } else if (loadPercent > normalThresh) {
                        loadBar.addClass('bg-warning'); // Medium
                    } else {
                        loadBar.addClass('bg-info'); // Normal
                    }
                }
            });
        }

        function formatNumber(num) {
            if (num === null || num === undefined || isNaN(num)) return '0';
            return Number(num).toLocaleString('id-ID', { maximumFractionDigits: 0 });
        }

        // ============================================
        // RELAY STATE INDICATOR (RCI)
        // ============================================
        function updateRelayIndicator($wrapper, state) {
            if (!$wrapper || $wrapper.length === 0) return;
            state = state || 'unknown';
            $wrapper.removeClass('on off unknown').addClass(state);
            $wrapper.data('relay-state', state);
            $wrapper.attr('data-relay-state', state);
            syncToggleButtonUi($wrapper, state);
        }

        function syncToggleButtonUi($wrapper, state) {
            if (!$wrapper || $wrapper.length === 0) return;
            var $btn = $wrapper.find('.btn-device-toggle');
            if ($btn.length === 0) return;

            var mode = $wrapper.data('control-mode');
            var relay = String($btn.data('relay') || '1');
            $btn.data('state', state);

            if (mode === 'ToggleAll') {
                if (state === 'on') {
                    $btn.removeClass('btn-success').addClass('btn-danger');
                    $btn.find('span').text('OFF ALL');
                } else {
                    $btn.removeClass('btn-danger').addClass('btn-success');
                    $btn.find('span').text('ON ALL');
                }
            } else if (mode === 'Toggle2Relay') {
                var label = 'R' + relay;
                if (state === 'on') {
                    $btn.removeClass('btn-success').addClass('btn-danger');
                    $btn.find('span').text(label + ' OFF');
                } else {
                    $btn.removeClass('btn-danger').addClass('btn-success');
                    $btn.find('span').text(label + ' ON');
                }
            } else {
                if (state === 'on') {
                    $btn.removeClass('btn-success').addClass('btn-danger');
                    $btn.find('span').text('OFF');
                } else {
                    $btn.removeClass('btn-danger').addClass('btn-success');
                    $btn.find('span').text('ON');
                }
            }
        }

        function getRelayStateFromRci(mode, relay, rci) {
            if (rci === null || rci === undefined || rci === '') return 'unknown';
            var s = String(rci).trim();
            var n = parseInt(s, 10);

            if (isNaN(n)) {
                s = s.toLowerCase();
                if (s === 'true' || s === 'on' || s === 'high') return 'on';
                if (s === 'false' || s === 'off' || s === 'low') return 'off';
                return 'unknown';
            }

            if (mode === 'Toggle2Relay') {
                // bit 0 = relay 1, bit 1 = relay 2
                if (relay === 1 || relay === '1') return (n & 1) === 1 ? 'on' : 'off';
                if (relay === 2 || relay === '2') return (n & 2) === 2 ? 'on' : 'off';
                return 'unknown';
            }

            if (mode === 'ToggleAll') {
                return n === 3 ? 'on' : 'off';
            }

            if (mode === 'Pulse') {
                return n === 1 ? 'on' : 'off';
            }

            // OnOff, Toggle: 1 = on, 0 = off
            return n === 0 ? 'off' : 'on';
        }

        function updateRelayStates() {
            $.ajax({
                url: '/api/Api/relay-states',
                method: 'GET',
                dataType: 'json',
                cache: false,
                success: function(response) {
                    if (!response.success || !response.states) {
                        console.warn('Relay states response invalid:', response);
                        return;
                    }
                    if (response.error) {
                        console.error('Relay states server error:', response.error);
                    }
                    var states = response.states;
                    $('.device-control-wrapper').each(function() {
                        var $wrapper = $(this);
                        var deviceKey = $wrapper.data('device-key');
                        var deviceId = $wrapper.data('device-id');
                        var groupName = $wrapper.data('group-name');
                        var mode = $wrapper.data('control-mode') || 'OnOff';
                        var relay = $wrapper.data('relay');
                        var info = states[deviceKey] || states[deviceId] || states[groupName];
                        var rci = (info && info.rciRaw != null && info.rciRaw !== '') ? String(info.rciRaw).trim() : '';
                        var state = getRelayStateFromRci(mode, relay, rci);
                        updateRelayIndicator($wrapper, state);
                        console.log('Relay state:', { deviceKey: deviceKey, deviceId: deviceId, groupName: groupName, rci: rci, rciRaw: info ? info.rciRaw : null, rcRaw: info ? info.rcRaw : null, state: state, mode: mode, relay: relay });
                    });
                },
                error: function() {
                    console.error('Failed to update relay states');
                }
            });
        }

        function startAutoRefresh() {
            if (refreshTimer) clearInterval(refreshTimer);
            refreshTimer = setInterval(function() {
                updatePanelCards();
                updateStatistics();
                updatePanelHeadersByAnomaly();
                updateRelayStates();
            }, 10000);
        }

        function updateStatistics() {
            $.ajax({
                url: '/api/Api/statistics',
                method: 'GET',
                dataType: 'json',
                success: function(stats) {
                    $('.stat-card.bg-primary .stat-value').first().text(formatNumber(stats.totalDaya) + ' W');
                    $('.stat-card.bg-success .stat-value').first().text(formatNumber(stats.totalEnergy) + ' Wh');
                    $('.stat-card.bg-warning .stat-value').first().text(formatNumber(stats.totalEnergiAktif) + ' Wh');
                    $('.stat-card.bg-secondary .stat-value').first().text(stats.activePanels);
                    $('.stat-card.bg-dark .stat-value').first().text(stats.avgPowerFactor.toFixed(3).replace('.', ','));
                    $('#lastUpdate').text(stats.timestamp);
                    $('#statusText').text('Online');
                },
                error: function() { $('#statusText').text('Offline'); }
            });
        }

         // ============================================
        // UPDATE PANEL CARDS (Auto-refresh)
        // ============================================
        function updatePanelCards() {
            $.ajax({
                url: '/api/Api/panels',
                method: 'GET',
                dataType: 'json',
                success: function(panels) {
                    // Update cached panel data for filtering
                    allPanelData = panels;

                    // Re-render chip list with updated data
                    renderPanelChips();

                    panels.forEach(function(panel) {
                        const safeKey = panel.deviceKey.replace(/-/g, '_');
                        const panelCard = $(`#panel_${safeKey}`);
                        if (panelCard.length === 0) return;

                        const cosPhi = parseFloat(panel.cosPhi) || 0;
                        const dayaWatt = parseFloat(panel.dayaWatt) || 0;
                        const isThreePhase = panel.isThreePhase === true;
                        const avgVoltage = isThreePhase
                            ? ((panel.r + panel.s + panel.t) / 3).toFixed(1)
                            : panel.r.toFixed(1);

                        // Update Header Badges
                        const headerBadges = panelCard.find('.card-header .badge');
                        const statusBadge = panelCard.find('#statusBadge_' + safeKey);

                        // Update voltage header badge
                        const $voltHeader = panelCard.find('[data-volt-header]');
                        if ($voltHeader.length > 0) {
                            $voltHeader.text(avgVoltage + 'V');
                        }

                        // Update category selector from API data
                        if (panel.deviceCategory) {
                            deviceCategoryMap[panel.deviceKey] = panel.deviceCategory;
                            updateCategoryIconUI(safeKey, panel.deviceCategory);
                        }

                        statusBadge.removeClass('bg-success bg-warning bg-danger');
                        statusBadge.text(panel.status);
                        if (panel.status === 'HIGH') statusBadge.addClass('bg-danger');
                        else if (panel.status === 'MEDIUM') statusBadge.addClass('bg-warning');
                        else statusBadge.addClass('bg-success');

                        // Update phase type badge
                        const $phaseBadge = panelCard.find('[data-phase-type]');
                        if ($phaseBadge.length > 0) {
                            if (isThreePhase) {
                                $phaseBadge.text('3\u03A6').removeClass('bg-warning').addClass('bg-info').css('background-color', '').css('color', '');
                            } else {
                                $phaseBadge.text('1\u03A6').removeClass('bg-info').addClass('bg-warning').css('background-color', '').css('color', '#212529');
                            }
                        }

                        // Update Voltage Badges
                        const voltBadges = panelCard.find('[data-volt-badge]');
                        if (voltBadges.length >= 1) {
                            $(voltBadges[0]).find('.phase-val').text(panel.r.toFixed(1).replace('.', ','));
                            $(voltBadges[0]).removeClass('bg-success bg-warning bg-danger bg-secondary').addClass('bg-' + (panel.phaseRColor || 'success'));
                        }
                        if (isThreePhase && voltBadges.length >= 3) {
                            $(voltBadges[1]).find('.phase-val').text(panel.s.toFixed(1).replace('.', ','));
                            $(voltBadges[1]).removeClass('bg-success bg-warning bg-danger bg-secondary').addClass('bg-' + (panel.phaseSColor || 'secondary'));
                            $(voltBadges[2]).find('.phase-val').text(panel.t.toFixed(1).replace('.', ','));
                            $(voltBadges[2]).removeClass('bg-success bg-warning bg-danger bg-secondary').addClass('bg-' + (panel.phaseTColor || 'secondary'));
                        }

                        // Update Amp Badges
                        const ampBadges = panelCard.find('[data-amp-badge]');
                        if (ampBadges.length >= 1) {
                            $(ampBadges[0]).find('.phase-val').text(panel.ampR.toFixed(2).replace('.', ','));
                        }
                        if (isThreePhase && ampBadges.length >= 3) {
                            $(ampBadges[1]).find('.phase-val').text(panel.ampS.toFixed(2).replace('.', ','));
                            $(ampBadges[2]).find('.phase-val').text(panel.ampT.toFixed(2).replace('.', ','));
                        }

                        // Update panel-value for Voltage and Current labels (Avg line)
                        const $voltLabel = panelCard.find('[data-label="voltage-avg"]');
                        if ($voltLabel.length > 0) {
                            $voltLabel.text('Avg ' + avgVoltage + ' V');
                        }
                        const avgAmpere = isThreePhase
                            ? ((panel.ampR + panel.ampS + panel.ampT) / 3).toFixed(2)
                            : panel.ampR.toFixed(2);
                        const $ampLabel = panelCard.find('[data-label="current-avg"]');
                        if ($ampLabel.length > 0) {
                            $ampLabel.text('Avg ' + avgAmpere + ' A');
                        }

                        // Update Text Values
                        panelCard.find('[data-value="power"]').text(formatNumber(dayaWatt));
                        panelCard.find('[data-value="total-energy"]').text(formatNumber(panel.totalEnergy) + ' Wh');
                        panelCard.find('[data-value="energi-aktif"]').text(formatNumber(panel.energiAktif));
                        panelCard.find('[data-value="cosphi"]').text(cosPhi.toFixed(3).replace('.', ','));
                        panelCard.find('[data-value="freq"]').text(panel.frekuensi.toFixed(2).replace('.', ',') + ' Hz');

                        // Update Power Factor Gauge
                        const pfPercent = (cosPhi * 100).toFixed(1);
                        const pfBar = panelCard.find('[data-gauge="power-factor"]');
                        if (pfBar.length > 0) {
                            pfBar.css('width', pfPercent + '%').text(pfPercent.replace('.', ',') + '%');
                            pfBar.removeClass('bg-success bg-warning bg-danger');
                            if (cosPhi >= 0.8) pfBar.addClass('bg-success');
                            else if (cosPhi >= 0.6) pfBar.addClass('bg-warning');
                            else pfBar.addClass('bg-danger');
                        }

                        // Update Load Gauge MENGGUNAKAN systemSettings
                        const maxCap = systemSettings.maxCapacity || 30000;
                        const normalThresh = systemSettings.normalThreshold || 30;
                        const mediumThresh = systemSettings.mediumThreshold || 70;

                        const loadPercent = Math.min((dayaWatt / maxCap) * 100, 100);
                        const loadBar = panelCard.find('[data-gauge="load"]');

                        if (loadBar.length > 0) {
                            loadBar.css('width', loadPercent.toFixed(1) + '%');
                            loadBar.removeClass('bg-info bg-warning bg-danger');

                            // Gunakan threshold dinamis dari settings
                            if (loadPercent > mediumThresh) {
                                loadBar.addClass('bg-danger'); // High
                            } else if (loadPercent > normalThresh) {
                                loadBar.addClass('bg-warning'); // Medium
                            } else {
                                loadBar.addClass('bg-info'); // Normal
                            }
                        }

                        // Update Labels
                        panelCard.find('[data-label="load-value"]').text(formatNumber(dayaWatt) + ' W');
                        panelCard.find('[data-label="pf-percent"]').text(pfPercent.replace('.', ',') + '%');
                    });

                    // Re-apply active filter after data refresh
                    applyPanelFilter();

                    // Update relay state indicator behind On/Off buttons
                    updateRelayStates();
                },
                error: function() {
                    console.error('Error updating panel cards');
                }
            });
        }

        function updateLastUpdate() {
            $('#lastUpdate').text(new Date().toLocaleString('id-ID'));
        }

        // ============================================
        // DEVICE CONTROL (MQTT PUBLISH)
        // ============================================
        function publishRelayCommand(deviceId, rcValue, $btn, pulse, onComplete, groupName, otpCode) {
            var displayName = groupName || deviceId;
            if (!deviceId) {
                showNotification('Perangkat tidak ditemukan', 'danger');
                if (typeof onComplete === 'function') onComplete(false);
                return;
            }

            var originalHtml = $btn.html();
            $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i>');

            var payload = { DeviceId: deviceId, RCValue: rcValue, Pulse: pulse || false };
            if (otpCode) payload.OtpCode = otpCode;

            $.ajax({
                url: '/api/Api/publish-relay',
                method: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(payload),
                success: function(response) {
                    $btn.prop('disabled', false).html(originalHtml);
                    if (response.success) {
                        showNotification('Perintah terkirim ke ' + displayName, 'success');
                        if (typeof onComplete === 'function') onComplete(true);
                    } else {
                        showNotification(response.error || 'Gagal mengirim perintah ke ' + displayName, 'danger');
                        if (typeof onComplete === 'function') onComplete(false);
                    }
                },
                error: function(xhr) {
                    $btn.prop('disabled', false).html(originalHtml);
                    var errorMsg = 'Gagal mengirim perintah ke ' + displayName;
                    try {
                        var response = JSON.parse(xhr.responseText);
                        errorMsg = response.error || errorMsg;
                    } catch(e) {}
                    showNotification(errorMsg, 'danger');
                    if (typeof onComplete === 'function') onComplete(false);
                }
            });
        }

        // ON/OFF mode: ON -> RC=1, OFF -> RC=0
        $(document).on('click', '.btn-device-on, .btn-device-off', function(e) {
            e.preventDefault();
            e.stopPropagation();

            var $btn = $(this);
            var deviceId = $btn.data('device-id');
            var $wrapper = $btn.closest('.device-control-wrapper');
            var groupName = $wrapper.data('group-name') || deviceId;
            var currentState = $wrapper.data('relay-state') || 'unknown';
            var isOn = $btn.hasClass('btn-device-on');
            var rcValue = isOn ? '1' : '0';

            if (isOn && currentState === 'on') {
                showRelayStateInfo(groupName, 'on', 'on');
                return;
            }
            if (!isOn && currentState === 'off') {
                showRelayStateInfo(groupName, 'off', 'off');
                return;
            }

            var actionText = isOn ? 'menyalakan (ON)' : 'mematikan (OFF)';

            // OFF requires OTP verification
            if (!isOn) {
                confirmRelayAction(
                    '<i class="fas fa-exclamation-triangle text-warning"></i> Konfirmasi Kontrol Perangkat',
                    'Apakah Anda yakin ingin ' + actionText + ' perangkat ' + groupName + '?',
                    function() {
                        openRelayOtpModal(deviceId, '0', false, groupName, $btn, $wrapper, actionText, function(success) {
                            if (success) updateRelayIndicator($wrapper, 'off');
                            setTimeout(updateRelayStates, success ? 1500 : 0);
                        });
                    }
                );
                return;
            }

            confirmRelayAction(
                '<i class="fas fa-exclamation-triangle text-warning"></i> Konfirmasi Kontrol Perangkat',
                'Apakah Anda yakin ingin ' + actionText + ' perangkat ' + groupName + '?',
                function() {
                    updateRelayIndicator($wrapper, 'on');
                    publishRelayCommand(deviceId, rcValue, $btn, false, function(success) {
                        setTimeout(updateRelayStates, success ? 1500 : 0);
                    }, groupName);
                }
            );
        });

        // Pulse mode
        $(document).on('click', '.btn-device-pulse', function(e) {
            e.preventDefault();
            e.stopPropagation();

            var $btn = $(this);
            var deviceId = $btn.data('device-id');
            var $wrapper = $btn.closest('.device-control-wrapper');
            var groupName = $wrapper.data('group-name') || deviceId;
            var currentState = $wrapper.data('relay-state') || 'unknown';
            var rcValue = String($btn.data('rc'));
            var isOn = rcValue === '1';

            if (isOn && currentState === 'on') {
                showRelayStateInfo(groupName, 'on', 'on');
                return;
            }
            if (!isOn && currentState === 'off') {
                showRelayStateInfo(groupName, 'off', 'off');
                return;
            }

            var actionText = isOn ? 'menyalakan (Pulse ON)' : 'mematikan (Pulse OFF)';

            // Pulse OFF requires OTP verification
            if (!isOn) {
                confirmRelayAction(
                    '<i class="fas fa-exclamation-triangle text-warning"></i> Konfirmasi Kontrol Perangkat',
                    'Apakah Anda yakin ingin ' + actionText + ' perangkat ' + groupName + '?',
                    function() {
                        openRelayOtpModal(deviceId, rcValue, true, groupName, $btn, $wrapper, actionText, function(success) {
                            if (success) updateRelayIndicator($wrapper, 'off');
                            setTimeout(updateRelayStates, success ? 1500 : 0);
                        });
                    }
                );
                return;
            }

            confirmRelayAction(
                '<i class="fas fa-exclamation-triangle text-warning"></i> Konfirmasi Kontrol Perangkat',
                'Apakah Anda yakin ingin ' + actionText + ' perangkat ' + groupName + '?',
                function() {
                    updateRelayIndicator($wrapper, 'on');
                    publishRelayCommand(deviceId, rcValue, $btn, true, function(success) {
                        setTimeout(updateRelayStates, success ? 1500 : 0);
                    }, groupName);
                }
            );
        });

        // Toggle mode
        $(document).on('click', '.btn-device-toggle', function(e) {
            e.preventDefault();
            e.stopPropagation();

            var $btn = $(this);
            var deviceId = $btn.data('device-id');
            var $wrapper = $btn.closest('.device-control-wrapper');
            var groupName = $wrapper.data('group-name') || deviceId;
            var relay = String($btn.data('relay'));
            var currentState = $wrapper.data('relay-state') || 'unknown';
            var isOff = currentState === 'off' || currentState === 'unknown';

            var rcValue;
            if (relay === 'all') {
                rcValue = isOff ? '3' : '0';
            } else {
                rcValue = isOff ? relay : '0';
            }

            var actionText = isOff ? 'menyalakan' : 'mematikan';
            var targetText = relay === 'all' ? 'semua relay' : 'relay ' + relay;

            // Toggle OFF requires OTP verification
            if (!isOff) {
                confirmRelayAction(
                    '<i class="fas fa-exclamation-triangle text-warning"></i> Konfirmasi Kontrol Perangkat',
                    'Apakah Anda yakin ingin ' + actionText + ' ' + targetText + ' pada perangkat ' + groupName + '?',
                    function() {
                        openRelayOtpModal(deviceId, rcValue, false, groupName, $btn, $wrapper, actionText + ' ' + targetText, function(success) {
                            if (success) updateRelayIndicator($wrapper, 'off');
                            setTimeout(updateRelayStates, success ? 1500 : 0);
                        });
                    }
                );
                return;
            }

            confirmRelayAction(
                '<i class="fas fa-exclamation-triangle text-warning"></i> Konfirmasi Kontrol Perangkat',
                'Apakah Anda yakin ingin ' + actionText + ' ' + targetText + ' pada perangkat ' + groupName + '?',
                function() {
                    publishRelayCommand(deviceId, rcValue, $btn, false, function(success) {
                        setTimeout(updateRelayStates, success ? 1500 : 0);
                    }, groupName);

                    var newState = isOff ? 'on' : 'off';
                    updateRelayIndicator($wrapper, newState);
                }
            );
        });
    </script>
}