@{
    ViewData["Title"] = "History";
}

<!-- Breadcrumb -->
<div class="erp-breadcrumb">
    <a asp-controller="Monitoring" asp-action="Index"><i class="fas fa-home"></i> Dashboard</a>
    <span class="separator"><i class="fas fa-chevron-right" style="font-size:0.6rem"></i></span>
    <span class="current">History</span>
</div>

<!-- Page Header -->
<div class="erp-page-header">
    <div>
        <h2><i class="fas fa-history text-primary"></i> History Data</h2>
        <div class="subtitle">
            <span class="badge bg-light text-dark border">
                <i class="fas fa-database me-1"></i><span id="totalRecords">0</span> records
            </span>
            <span class="ms-2">
                <i class="fas fa-circle text-success" id="statusDot" style="font-size:0.5rem"></i>
                <span id="statusText">Auto-refresh ON</span>
            </span>
        </div>
    </div>
    <div class="actions">
        <label class="form-check mb-0 d-none d-sm-flex align-items-center me-2">
            <input type="checkbox" id="autoRefreshCheck" checked class="form-check-input me-1">
            <small class="text-muted">Auto 10s</small>
        </label>
        <a asp-action="Index" class="btn btn-erp-action">
            <i class="fas fa-arrow-left"></i>
        </a>
        <button class="btn btn-erp-action" id="btnRefresh" title="Refresh">
            <i class="fas fa-sync-alt"></i>
        </button>
        <button class="btn btn-erp-action" id="btnExportCsv" title="Export CSV">
            <i class="fas fa-file-csv"></i>
        </button>
        <button class="btn btn-erp-action" id="btnExportExcel" title="Export Excel">
            <i class="fas fa-file-excel"></i>
        </button>
    </div>
</div>

<!-- DevExpress DataGrid -->
<div id="historyDataGrid" style="width:100%;"></div>

<style>
    /* Full width grid */
    #historyDataGrid {
        width: 100% !important;
    }
    #historyDataGrid .dx-datagrid {
        width: 100% !important;
    }
    #historyDataGrid .card:hover {
        transform: none !important;
        box-shadow: none !important;
    }

    .dx-datagrid {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        font-size: 12px;
    }

    .dx-datagrid .dx-header-row td {
        font-size: 11px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.3px;
        color: #6c757d;
    }

    .dx-datagrid .dx-data-row td {
        font-size: 12px;
        vertical-align: middle;
    }

    .dx-datagrid .dx-datagrid-rowsview .dx-row > td {
        padding-top: 4px;
        padding-bottom: 4px;
    }

    .dx-datagrid .dx-datagrid-headers .dx-header-row > td {
        padding-top: 6px;
        padding-bottom: 6px;
    }

    .dx-datagrid .dx-datagrid-summary-item {
        font-weight: 600;
        color: #0d6efd;
        font-size: 11px;
    }

    .dx-master-detail-row .dx-master-detail-cell {
        padding: 8px 12px !important;
        background-color: #f8f9fa;
    }

    .dx-datagrid .dx-row-alt {
        background-color: #f8f9fa;
    }

    .dx-datagrid .badge {
        font-size: 0.7rem;
        padding: 0.3em 0.55em;
        font-weight: 600;
        letter-spacing: 0.3px;
        white-space: nowrap;
    }

    /* Fix DevExtreme toolbar icons - use text instead */
    .dx-datagrid .dx-toolbar .dx-button .dx-button-content {
        font-size: 12px;
    }

    .history-volt {
        font-weight: 600;
        font-size: 12px;
    }

    .history-amp {
        font-weight: 600;
        font-size: 12px;
    }

    .history-power {
        font-weight: 700;
        font-size: 12px;
    }

    .history-time {
        font-size: 11px;
        white-space: nowrap;
        color: #495057;
    }

    .history-device {
        font-weight: 600;
        color: #0d6efd;
        font-size: 12px;
    }

    .history-group {
        font-size: 11px;
        color: #6c757d;
    }
</style>

@section Scripts {
    <script>
        var autoRefreshTimer = null;
        var autoRefreshEnabled = true;
        var dataGrid = null;
        var allData = [];
        var lastReceivedTimeCursor = null;
        var currentPage = 0;

        $(function() {
            try { localStorage.removeItem('kwhHistoryGrid_v2'); } catch(e) {}
            try { localStorage.removeItem('kwhHistoryGrid_v3'); } catch(e) {}

            initDataGrid();
            setupAutoRefresh();
            setupEventHandlers();
        });

        function formatDateTime(val) {
            if (!val) return '-';
            try {
                var d = (val instanceof Date) ? val : new Date(val);
                if (isNaN(d.getTime())) return typeof val === 'string' ? val : '-';
                var dd = String(d.getDate()).padStart(2, '0');
                var MM = String(d.getMonth() + 1).padStart(2, '0');
                var yyyy = d.getFullYear();
                var hh = String(d.getHours()).padStart(2, '0');
                var mm = String(d.getMinutes()).padStart(2, '0');
                var ss = String(d.getSeconds()).padStart(2, '0');
                return dd + '/' + MM + '/' + yyyy + ' ' + hh + ':' + mm + ':' + ss;
            } catch(e) {
                return '-';
            }
        }

        function fmt(value, precision) {
            if (value == null) return '-';
            return value.toLocaleString('id-ID', {
                minimumFractionDigits: precision,
                maximumFractionDigits: precision
            });
        }

        function initDataGrid() {
            $('#historyDataGrid').dxDataGrid({
                dataSource: new DevExpress.data.DataSource({
                    store: new DevExpress.data.CustomStore({
                        key: 'historyId',
                        load: function(loadOptions) {
                            var d = $.Deferred();
                            var params = {
                                take: loadOptions.take || 10,
                                lastReceivedTime: lastReceivedTimeCursor
                            };

                            // Reset cursor jika sort atau filter berubah
                            if (loadOptions.sort || loadOptions.filter) {
                                lastReceivedTimeCursor = null;
                            }

                            if (loadOptions.sort) {
                                params.sort = JSON.stringify(loadOptions.sort);
                            }

                            if (loadOptions.filter) {
                                params.filter = JSON.stringify(loadOptions.filter);
                            }

                            $.ajax({
                                url: '/api/Api/history-archive',
                                method: 'GET',
                                data: params,
                                dataType: 'json',
                                timeout: 30000,
                                success: function(response) {
                                    currentPage++;
                                    console.log('History API page:', currentPage, '- loaded:', (response.data||[]).length, 'hasMore:', response.hasMore);
                                    var mapped = (response.data || []).map(function(item) {
                                        return {
                                            historyId: item.historyId || 0,
                                            originalId: item.originalId || 0,
                                            deviceKey: item.deviceKey || '',
                                            deviceId: item.deviceId || '',
                                            groupName: item.groupName || '',
                                            terminalTime: item.terminalTime,
                                            receivedTime: item.receivedTime,
                                            phaseR: item.phaseR || 0,
                                            phaseS: item.phaseS,
                                            phaseT: item.phaseT,
                                            ampereR: item.ampereR || 0,
                                            ampereS: item.ampereS,
                                            ampereT: item.ampereT,
                                            w: item.w || 0,
                                            cosPhi: item.cosPhi || 0,
                                            f: item.f || 0,
                                            aktifPower: item.aktifPower || 0,
                                            totalW: item.totalW || 0,
                                            totalW1M: item.totalW1M || 0,
                                            archivedAt: item.archivedAt,
                                            status: (item.w || 0) > 20000 ? 'HIGH LOAD' : (item.w || 0) > 10000 ? 'MEDIUM LOAD' : 'NORMAL'
                                        };
                                    });
                                    allData = mapped;

                                    // Update cursor ke row terakhir agar bisa lanjut page berikutnya
                                    if (mapped.length > 0) {
                                        lastReceivedTimeCursor = mapped[mapped.length - 1].receivedTime;
                                    }

                                    d.resolve(mapped, mapped.length);
                                },
                                error: function(xhr, status, error) {
                                    console.error('Error loading data:', status, error);
                                    d.reject(error);
                                }
                            });
                            return d.promise();
                        }
                    }),
                    paginate: true,
                    pageSize: 10
                }),

                remoteOperations: {
                    sorting: true,
                    paging: true,
                    filtering: true
                },
                
                // Paging
                paging: { pageSize: 10 },
                pager: {
                    showPageSizeSelector: true,
                    allowedPageSizes: [10, 50, 100, 500],
                    showInfo: true,
                    showNavigationButtons: true,
                    visible: true
                },

                // Scrolling
                scrolling: {
                    mode: 'standard',
                    showScrollbar: 'always',
                    useNative: true
                },

                // Search
                searchPanel: {
                    visible: true,
                    width: 200,
                    placeholder: 'Cari data...'
                },

                // Column Chooser
                columnChooser: {
                    enabled: true,
                    mode: 'select'
                },

                // Column Fixing
                columnFixing: { enabled: true },

                // Grouping
                grouping: { autoExpandAll: false },
                groupPanel: { visible: false },

                // Header Filter
                headerFilter: { visible: true },

                // Filter Row
                filterRow: { visible: true },

                // Sorting
                sorting: { mode: 'single' },

                // Selection
                selection: { mode: 'none' },

                // State Storing
                stateStoring: { enabled: false },

                // Row Alternation
                rowAlternationEnabled: true,

                // Borders
                showBorders: true,
                showColumnLines: true,
                showRowLines: false,

                // Resize/reorder
                allowColumnResizing: true,
                allowColumnReordering: true,
                columnAutoWidth: true,

                // Load panel
                loadPanel: { enabled: true, text: 'Memuat data...' },

                // No data text
                noDataText: 'Tidak ada data',

                // Master Detail
                masterDetail: {
                    enabled: true,
                    template: function(container, options) {
                        var d = options.data;
                        var borderCls = d.status === 'HIGH LOAD' ? 'danger' : d.status === 'MEDIUM LOAD' ? 'warning' : 'success';
                        var html = '<div class="row g-2 p-2">'
                            + '<div class="col-md-3 col-6"><div class="card border-' + borderCls + ' h-100"><div class="card-body p-2">'
                            + '<small class="text-muted"><i class="fas fa-info-circle"></i> Status</small><br>'
                            + '<span class="badge bg-' + borderCls + '">' + d.status + '</span>'
                            + '</div></div></div>'
                            + '<div class="col-md-3 col-6"><div class="card border-info h-100"><div class="card-body p-2">'
                            + '<small class="text-muted"><i class="fas fa-bolt"></i> Voltage</small><br>'
                            + '<small>R: ' + fmt(d.phaseR,1) + 'V' + (d.phaseS != null ? ' | S: ' + fmt(d.phaseS,1) + 'V' : '') + (d.phaseT != null ? ' | T: ' + fmt(d.phaseT,1) + 'V' : '') + '</small>'
                            + '</div></div></div>'
                            + '<div class="col-md-3 col-6"><div class="card border-warning h-100"><div class="card-body p-2">'
                            + '<small class="text-muted"><i class="fas fa-wave-square"></i> Current</small><br>'
                            + '<small>R: ' + fmt(d.ampereR,3) + 'A' + (d.ampereS != null ? ' | S: ' + fmt(d.ampereS,3) + 'A' : '') + (d.ampereT != null ? ' | T: ' + fmt(d.ampereT,3) + 'A' : '') + '</small>'
                            + '</div></div></div>'
                            + '<div class="col-md-3 col-6"><div class="card border-primary h-100"><div class="card-body p-2">'
                            + '<small class="text-muted"><i class="fas fa-plug"></i> Power</small><br>'
                            + '<small>' + fmt(d.w,0) + ' W | Cos&phi;: ' + fmt(d.cosPhi,3) + ' | ' + fmt(d.f,2) + ' Hz</small>'
                            + '</div></div></div>'
                            + '</div>';
                        container.append(html);
                    }
                },

                // Summary
                summary: {
                    totalItems: [
                        { column: 'historyId', summaryType: 'count', displayFormat: '{0} records' }
                    ],
                    groupItems: [
                        { column: 'historyId', summaryType: 'count', displayFormat: '{0}' }
                    ]
                },

                // Toolbar
                onToolbarPreparing: function(e) {
                    var items = e.toolbarOptions.items;
                    items.push({
                        location: 'after',
                        widget: 'dxButton',
                        options: {
                            text: 'Columns',
                            hint: 'Show/Hide Columns',
                            onClick: function() { dataGrid.showColumnChooser(); }
                        }
                    });
                    items.push({
                        location: 'after',
                        widget: 'dxButton',
                        options: {
                            text: 'Clear',
                            hint: 'Clear all filters',
                            onClick: function() {
                                dataGrid.clearFilter();
                                dataGrid.refresh();
                            }
                        }
                    });
                },

                // Cell customization
                onCellPrepared: function(e) {
                    if (e.rowType !== 'data') return;
                    if (e.column.dataField === 'w' && e.value > 20000) {
                        e.cellElement.css('background-color', 'rgba(220,53,69,0.10)');
                    } else if (e.column.dataField === 'w' && e.value > 10000) {
                        e.cellElement.css('background-color', 'rgba(255,193,7,0.1)');
                    }
                },

                // Row customization
                onRowPrepared: function(e) {
                    if (e.rowType !== 'data') return;
                    var s = e.data.status;
                    if (s === 'HIGH LOAD') e.rowElement.css('border-left', '3px solid #dc3545');
                    else if (s === 'MEDIUM LOAD') e.rowElement.css('border-left', '3px solid #ffc107');
                    else e.rowElement.css('border-left', '3px solid #198754');
                },

                // Columns
                columns: [
                    {
                        dataField: 'historyId',
                        caption: 'History ID',
                        width: 80,
                        fixed: true,
                        fixedPosition: 'left',
                        allowGrouping: false,
                        allowFiltering: false,
                        allowHeaderFiltering: false,
                        alignment: 'center'
                    },
                    {
                        dataField: 'originalId',
                        caption: 'Original ID',
                        width: 80,
                        visible: false,
                        alignment: 'center'
                    },
                    {
                        dataField: 'deviceKey',
                        caption: 'Device',
                        width: 100,
                        fixed: true,
                        fixedPosition: 'left',
                        alignment: 'center',
                        headerFilter: { allowSelectAll: true },
                        cellTemplate: function(container, options) {
                            $('<span>').addClass('history-device').text(options.value).appendTo(container);
                        }
                    },
                    {
                        dataField: 'groupName',
                        caption: 'Group',
                        alignment: 'center',
                        headerFilter: { allowSelectAll: true }
                    },
                    {
                        dataField: 'receivedTime',
                        caption: 'Received Time',
                        dataType: 'datetime',
                        sortOrder: 'desc',
                        alignment: 'center',
                        format: { type: 'dd/MM/yyyy HH:mm:ss' },
                        filterOperations: ['between', '>=', '<=', '>', '<', '='],
                        selectedFilterOperation: 'between',
                        editorOptions: {
                            type: 'datetime',
                            displayFormat: 'dd/MM/yyyy HH:mm:ss'
                        },
                        cellTemplate: function(container, options) {
                            $('<span>').addClass('history-time').text(formatDateTime(options.value)).appendTo(container);
                        }
                    },
                    {
                        dataField: 'terminalTime',
                        caption: 'Terminal Time',
                        dataType: 'datetime',
                        visible: false,
                        alignment: 'center',
                        format: { type: 'dd/MM/yyyy HH:mm:ss' },
                        cellTemplate: function(container, options) {
                            $('<span>').addClass('history-time').text(formatDateTime(options.value)).appendTo(container);
                        }
                    },
                    {
                        dataField: 'phaseR',
                        caption: 'V R',
                        dataType: 'number',
                        alignment: 'center',
                        cellTemplate: function(container, options) {
                            var v = options.value;
                            var cls = v < 200 ? 'text-danger' : v < 220 ? 'text-warning' : 'text-success';
                            $('<span>').addClass('history-volt ' + cls).text(fmt(v, 1)).appendTo(container);
                        }
                    },
                    {
                        dataField: 'phaseS',
                        caption: 'V S',
                        dataType: 'number',
                        alignment: 'center',
                        cellTemplate: function(container, options) {
                            if (options.value != null) {
                                var v = options.value;
                                var cls = v < 200 ? 'text-danger' : v < 220 ? 'text-warning' : 'text-success';
                                $('<span>').addClass('history-volt ' + cls).text(fmt(v, 1)).appendTo(container);
                            } else {
                                container.text('-');
                            }
                        }
                    },
                    {
                        dataField: 'phaseT',
                        caption: 'V T',
                        dataType: 'number',
                        alignment: 'center',
                        cellTemplate: function(container, options) {
                            if (options.value != null) {
                                var v = options.value;
                                var cls = v < 200 ? 'text-danger' : v < 220 ? 'text-warning' : 'text-success';
                                $('<span>').addClass('history-volt ' + cls).text(fmt(v, 1)).appendTo(container);
                            } else {
                                container.text('-');
                            }
                        }
                    },
                    {
                        dataField: 'ampereR',
                        caption: 'A R',
                        dataType: 'number',
                        alignment: 'center',
                        cellTemplate: function(container, options) {
                            var v = options.value;
                            var cls = v > 80 ? 'text-danger' : v > 70 ? 'text-warning' : 'text-success';
                            $('<span>').addClass('history-amp ' + cls).text(fmt(v, 1)).appendTo(container);
                        }
                    },
                    {
                        dataField: 'ampereS',
                        caption: 'A S',
                        dataType: 'number',
                        alignment: 'center',
                        cellTemplate: function(container, options) {
                            if (options.value != null) {
                                var v = options.value;
                                var cls = v > 80 ? 'text-danger' : v > 70 ? 'text-warning' : 'text-success';
                                $('<span>').addClass('history-amp ' + cls).text(fmt(v, 1)).appendTo(container);
                            } else {
                                container.text('-');
                            }
                        }
                    },
                    {
                        dataField: 'ampereT',
                        caption: 'A T',
                        dataType: 'number',
                        alignment: 'center',
                        cellTemplate: function(container, options) {
                            if (options.value != null) {
                                var v = options.value;
                                var cls = v > 80 ? 'text-danger' : v > 70 ? 'text-warning' : 'text-success';
                                $('<span>').addClass('history-amp ' + cls).text(fmt(v, 1)).appendTo(container);
                            } else {
                                container.text('-');
                            }
                        }
                    },
                    {
                        dataField: 'cosPhi',
                        caption: 'Cos\u03C6',
                        dataType: 'number',
                        alignment: 'center',
                        cellTemplate: function(container, options) {
                            $('<span>').text(fmt(options.value, 2)).appendTo(container);
                        }
                    },
                    {
                        dataField: 'w',
                        caption: 'Daya (W)',
                        dataType: 'number',
                        alignment: 'center',
                        cellTemplate: function(container, options) {
                            $('<span>').addClass('history-power').text(fmt(options.value, 0)).appendTo(container);
                        }
                    },
                    {
                        dataField: 'aktifPower',
                        caption: 'Aktif Power',
                        dataType: 'number',
                        visible: false,
                        alignment: 'center'
                    },
                    {
                        dataField: 'totalW',
                        caption: 'Total W',
                        dataType: 'number',
                        visible: false,
                        alignment: 'center'
                    },
                    {
                        dataField: 'totalW1M',
                        caption: 'TotalW1M',
                        dataType: 'number',
                        visible: false,
                        alignment: 'center'
                    },
                    {
                        dataField: 'f',
                        caption: 'Freq (Hz)',
                        dataType: 'number',
                        alignment: 'center',
                        cellTemplate: function(container, options) {
                            $('<span>').text(fmt(options.value, 1)).appendTo(container);
                        }
                    },
                    {
                        dataField: 'archivedAt',
                        caption: 'Archived At',
                        dataType: 'datetime',
                        visible: false,
                        alignment: 'center',
                        format: { type: 'dd/MM/yyyy HH:mm:ss' },
                        cellTemplate: function(container, options) {
                            $('<span>').addClass('history-time').text(formatDateTime(options.value)).appendTo(container);
                        }
                    },
                    {
                        dataField: 'status',
                        caption: 'Status',
                        width: 90,
                        alignment: 'center',
                        headerFilter: {
                            dataSource: [
                                { text: 'NORMAL', value: 'NORMAL' },
                                { text: 'MEDIUM LOAD', value: 'MEDIUM LOAD' },
                                { text: 'HIGH LOAD', value: 'HIGH LOAD' }
                            ]
                        },
                        cellTemplate: function(container, options) {
                            var v = options.value;
                            var cls, symbol;
                            if (v === 'HIGH LOAD') { cls = 'bg-danger'; symbol = '\u25B2 HIGH'; }
                            else if (v === 'MEDIUM LOAD') { cls = 'bg-warning text-dark'; symbol = '\u25C6 MED'; }
                            else { cls = 'bg-success'; symbol = '\u25CF OK'; }
                            $('<span>').addClass('badge ' + cls).text(symbol).appendTo(container);
                        }
                    }
                ]
            });

            dataGrid = $('#historyDataGrid').dxDataGrid('instance');

            // Update total records on data load
            dataGrid.on('contentReady', function() {
                var totalCount = dataGrid.totalCount();
                if (totalCount !== undefined) {
                    $('#totalRecords').text(totalCount);
                }
            });
        }

        function setupAutoRefresh() {
            stopAutoRefresh();
            if (autoRefreshEnabled) {
                autoRefreshTimer = setInterval(function() {
                    if (dataGrid) {
                        dataGrid.refresh();
                    }
                }, 10000);
            }
        }

        function stopAutoRefresh() {
            if (autoRefreshTimer) {
                clearInterval(autoRefreshTimer);
                autoRefreshTimer = null;
            }
        }

        function setupEventHandlers() {
            $('#btnRefresh').click(function() {
                if (dataGrid) dataGrid.refresh();
            });

            $('#autoRefreshCheck').change(function() {
                autoRefreshEnabled = $(this).is(':checked');
                if (autoRefreshEnabled) {
                    setupAutoRefresh();
                    $('#statusDot').removeClass('text-danger').addClass('text-success');
                    $('#statusText').text('Auto-refresh ON');
                } else {
                    stopAutoRefresh();
                    $('#statusDot').removeClass('text-success').addClass('text-danger');
                    $('#statusText').text('Auto-refresh OFF');
                }
            });

            $('#btnExportCsv').click(function() {
                window.location.href = '/api/Api/history-export?format=csv';
            });

            $('#btnExportExcel').click(function() {
                window.location.href = '/api/Api/history-export?format=excel';
            });
        }

        function copyRowToClipboard(data) {
            var lines = [
                'History ID: ' + data.historyId,
                'Device: ' + data.deviceKey,
                'Group: ' + data.groupName,
                'Terminal Time: ' + formatDateTime(data.terminalTime),
                'Received Time: ' + formatDateTime(data.receivedTime),
                'Volt R: ' + fmt(data.phaseR, 1) + 'V',
                'Volt S: ' + (data.phaseS != null ? fmt(data.phaseS, 1) + 'V' : '-'),
                'Volt T: ' + (data.phaseT != null ? fmt(data.phaseT, 1) + 'V' : '-'),
                'Amp R: ' + fmt(data.ampereR, 3) + 'A',
                'Amp S: ' + (data.ampereS != null ? fmt(data.ampereS, 3) + 'A' : '-'),
                'Amp T: ' + (data.ampereT != null ? fmt(data.ampereT, 3) + 'A' : '-'),
                'Cos Phi: ' + fmt(data.cosPhi, 3),
                'Daya: ' + fmt(data.w, 0) + ' W',
                'Aktif Power: ' + fmt(data.aktifPower, 0) + ' Wh',
                'Total W: ' + fmt(data.totalW, 0) + ' Wh',
                'Frekuensi: ' + fmt(data.f, 2) + ' Hz',
                'Status: ' + data.status
            ];
            var text = lines.join('\n');
            if (navigator.clipboard) {
                navigator.clipboard.writeText(text);
            } else {
                var ta = document.createElement('textarea');
                ta.value = text;
                document.body.appendChild(ta);
                ta.select();
                document.execCommand('copy');
                document.body.removeChild(ta);
            }
            DevExpress.ui.notify('Data copied to clipboard', 'success', 2000);
        }
    </script>
}