        // ============================================
        // UTILITY FUNCTIONS
        // ============================================
        function formatNumber(num) {
            if (num === null || num === undefined || isNaN(num)) return '0';
            return Number(num).toLocaleString('id-ID', { maximumFractionDigits: 0 });
        }

        function calculateEMA(data, period) {
            if (!data || data.length === 0) return [];
            var k = 2 / (period + 1);
            var ema = [data[0] || 0];
            for (var i = 1; i < data.length; i++) {
                var value = data[i] !== null && data[i] !== undefined ? data[i] : ema[i - 1];
                ema.push(value * k + ema[i - 1] * (1 - k));
            }
            return ema;
        }

        // Fungsi untuk menghitung EMA dengan baseline SMA dari 100 data pertama
        // Baseline = rata-rata sederhana (SMA), membentuk garis horizontal datar
        // Threshold dihitung dari baseline ini, bukan dari EMA yang berubah-ubah
        function calculateEMAWithBaseline(data, period, baselineValue) {
            if (!data || data.length === 0) return [];
            if (baselineValue === null || baselineValue === undefined) {
                return calculateEMA(data, period);
            }

            // Garis horizontal datar pada nilai baseline (SMA 100 data pertama)
            // Setiap titik data memiliki nilai yang sama = baseline
            return data.map(function() { return baselineValue; });
        }

        function calculateThresholds(ema, mode, upperValue, lowerValue) {
            var upper = [], lower = [];
            try {
                var uv = upperValue != null && !isNaN(upperValue) ? upperValue : 1;
                var lv = lowerValue != null && !isNaN(lowerValue) ? lowerValue : 1;
                if (mode === 'fibonacci') {
                    upper = ema.map(function(v) { return (v != null ? v : 0) * uv; });
                    lower = ema.map(function(v) { return (v != null ? v : 0) * lv; });
                } else {
                    upper = ema.map(function(v) { return (v != null ? v : 0) * (1 + uv / 100); });
                    lower = ema.map(function(v) { return (v != null ? v : 0) * (1 - lv / 100); });
                }
            } catch(e) { console.error('Error calculating thresholds:', e); }
            return { upper: upper, lower: lower };
        }

        // ============================================
        // GRID CONFIG HELPERS
        // ============================================
        function getGridConfig() {
            var gridColor = (typeof window.getChartGridColor === 'function') ? window.getChartGridColor() : systemSettings.gridColor;
            return {
                display: systemSettings.showGrid,
                drawOnChartArea: systemSettings.showGrid,
                drawTicks: systemSettings.showGrid,
                color: gridColor,
                lineWidth: 1
            };
        }

        function getScaleConfig(beginAtZero, yCallback) {
            var tickColor = (typeof window.getChartTickColor === 'function') ? window.getChartTickColor() : '#666';
            return {
                x: {
                    ticks: { font: { size: 9 }, maxRotation: 45, color: tickColor },
                    grid: getGridConfig()
                },
                y: {
                    beginAtZero: beginAtZero,
                    ticks: { font: { size: 9 }, callback: yCallback, color: tickColor },
                    grid: getGridConfig()
                }
            };
        }

        // ============================================
        // ANOMALY DETECTION & LOGGING (AKTIF)
        // ============================================
        function detectAndLogAnomaly(deviceKey, powerData, ema, upperThreshold, lowerThreshold) {
            if (!emaSettings.enableAlerts) {
                console.log('Anomaly alerts disabled');
                return;
            }

            if (anomalyConfirmation.maxConfirmations <= 0) {
                console.log('Anomaly detection disabled (maxConfirmations=' + anomalyConfirmation.maxConfirmations + ')');
                return;
            }

            // Cek data point terakhir (real-time)
            var lastIndex = powerData.length - 1;
            if (lastIndex < 0) {
                console.log('No power data');
                return;
            }

            var currentPower = powerData[lastIndex];
            var upper = upperThreshold[lastIndex];
            var lower = lowerThreshold[lastIndex];
            var emaValue = ema[lastIndex];

            console.log('=== ANOMALY CHECK ===');
            console.log('Current Power:', currentPower);
            console.log('Upper Threshold:', upper);
            console.log('Lower Threshold:', lower);
            console.log('EMA Value:', emaValue);

            if (currentPower === null || currentPower === undefined) {
                console.log('Current power is null/undefined');
                return;
            }
            if (upper === undefined || lower === undefined) {
                console.log('Thresholds are undefined');
                return;
            }

            var anomalyType = null;
            var thresholdValue = 0;
            var deviation = 0;

            // DOWNTIME LOGIC: Use EMA as trigger (not upper line)
            // This indicates power is still ON normally during downtime, not overload
            if (isDowntimeForDevice() && currentPower > emaValue) {
                anomalyType = 'OVERLOAD';
                thresholdValue = emaValue;
                deviation = ((currentPower - emaValue) / emaValue * 100);
                console.log(' LISTRIK MENYALA SAAT JAM MATI! Power:', currentPower.toFixed(1), 'W | EMA:', emaValue.toFixed(1), 'W | Deviation:', deviation.toFixed(1) + '%');
            }
            // NORMAL LOGIC: Use upper line as trigger
            else if (currentPower > upper) {
                anomalyType = 'OVERLOAD';
                thresholdValue = upper;
                deviation = ((currentPower - upper) / upper * 100);
                console.log(' OVERLOAD DETECTED! Deviation:', deviation.toFixed(1) + '%');
            }
            // DROP detection (normal operation only, suppressed during downtime)
            else if (!isDowntimeForDevice() && currentPower < lower) {
                anomalyType = 'DROP';
                thresholdValue = lower;
                deviation = ((lower - currentPower) / lower * 100);
                console.log(' DEVICE DROP DETECTED! Deviation:', deviation.toFixed(1) + '%');
            } else {
                console.log(' Power within normal range');
                return;
            }

            // CONFIRMATION LOGIC: Need N consecutive data points to confirm anomaly (N from Settings)
            var cooldownKey = deviceKey + '_' + anomalyType;
            var now = Date.now();
            
            // Check cooldown first
            if (anomalyCooldown[cooldownKey] && (now - anomalyCooldown[cooldownKey]) < anomalyConfirmation.cooldownTime) {
                console.log(' Anomaly ' + anomalyType + ' for ' + deviceKey + ' in cooldown period');
                return;
            }

            let confirmedCount = anomalyConfirmation.counts[cooldownKey] || 0;
            
            // Increment confirmation count
            confirmedCount++;
            anomalyConfirmation.counts[cooldownKey] = confirmedCount;
            
            // Log confirmation progress
            const statusMessage = isDowntimeForDevice() ? '[DOWNTIME]' : '[NORMAL]';
            console.log(` ANOMALY CHECK: ${anomalyType} for ${deviceKey} ${statusMessage} - Threshold: ${thresholdValue.toFixed(2)}, Count: ${confirmedCount}/${anomalyConfirmation.maxConfirmations}`);
            
            // Only send log after 5 confirmed samples
            if (confirmedCount >= anomalyConfirmation.maxConfirmations) {
                console.log(` ANOMALY CONFIRMED! ${anomalyType} for ${deviceKey} - ${confirmedCount}/5 samples met`);
                
                // Log ke database
                console.log('Posting anomaly log to database...');
                $.ajax({
                    url: '/api/Api/log-anomaly',
                    method: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({
                        deviceKey: deviceKey,
                        deviceId: deviceKey,
                        anomalyType: anomalyType,
                        powerValue: currentPower,
                        thresholdValue: thresholdValue,
                        deviation: Math.round(deviation * 10) / 10,
                        emaValue: emaValue,
                        thresholdMode: emaSettings.mode
                    }),
                    timeout: 10000,
                    success: function(response) {
                        console.log(' Anomaly logged successfully:', response);
                        // Update badge counter
                        loadAnomalyLogs();
                        // Reset confirmation count and set cooldown
                        anomalyConfirmation.counts[cooldownKey] = 0;
                        anomalyCooldown[cooldownKey] = now;
                    },
                    error: function(xhr, status, error) {
                        console.error(' Error logging anomaly:', error);
                        console.error('Response:', xhr.responseText);
                        // Reset confirmation count on error so it can retry
                        anomalyConfirmation.counts[cooldownKey] = 0;
                    }
                });

                // Show alert modal
                showAnomalyAlert(deviceKey, anomalyType, currentPower, thresholdValue, deviation);
            } else {
                console.log(` Waiting for more samples... (${confirmedCount}/${anomalyConfirmation.maxConfirmations} needed)`);
                // Continue checking without sending notification yet
            }
        }

        function showAnomalyAlert(deviceKey, type, power, threshold, deviation) {
            var isOverload = type === 'OVERLOAD';
            var content = '<div class="alert alert-' + (isOverload ? 'danger' : 'warning') + '">' +
                '<h5><i class="fas ' + (isOverload ? 'fa-bolt' : 'fa-power-off') + '"></i> ' + (isOverload ? 'OVERLOAD' : 'DEVICE DROP') + ' DETECTED</h5>' +
                '<hr>' +
                '<p><strong>Device:</strong> ' + deviceKey + '</p>' +
                '<p><strong>Power:</strong> ' + formatNumber(power) + ' W</p>' +
                '<p><strong>Threshold:</strong> ' + formatNumber(threshold) + ' W</p>' +
                '<p><strong>Deviation:</strong> ' + deviation.toFixed(1) + '%</p>' +
                '<p><strong>Time:</strong> ' + new Date().toLocaleString('id-ID') + '</p>' +
                '</div>';
            $('#anomalyContent').html(content);
            $('#anomalyModal').modal('show');
        }

        // ============================================
        // UPDATE PANEL MONITORING
        // ============================================
        function updatePanelMonitoring() {
            console.log('Updating panel monitoring...');

            $.ajax({
                url: '/api/Api/panels',
                method: 'GET',
                dataType: 'json',
                timeout: 10000,
                success: function(panels) {
                    var panel = panels.find(function(p) { return p.deviceKey === deviceKey; });
                    if (!panel) {
                        console.log('Panel not found');
                        return;
                    }

                    var voltR = parseFloat(panel.r) || 0;
                    var voltS = panel.s != null ? parseFloat(panel.s) : null;
                    var voltT = panel.t != null ? parseFloat(panel.t) : null;
                    var ampR = parseFloat(panel.ampR) || 0;
                    var ampS = panel.ampS != null ? parseFloat(panel.ampS) : null;
                    var ampT = panel.ampT != null ? parseFloat(panel.ampT) : null;
                    var cosPhi = parseFloat(panel.cosPhi) || 0;
                    var dayaWatt = parseFloat(panel.dayaWatt) || 0;
                    var aktif = parseFloat(panel.energiAktif) || 0;
                    var freq = parseFloat(panel.frekuensi) || 0;

                    var isThreePhase = panel.isThreePhase === true;
                    var avgVoltage = isThreePhase ? (voltR + voltS + voltT) / 3 : voltR;
                    var avgCurrent = isThreePhase ? (ampR + ampS + ampT) / 3 : ampR;
                    var pfPercent = (cosPhi * 100);
                    var ds = (window.getDeviceSettings && window.getDeviceSettings(deviceKey)) || { maxCapacity: 0, loadNormalThreshold: 30, loadMediumThreshold: 70 };
                    var maxCap = ds.maxCapacity || 0;
                    var normalThresh = ds.loadNormalThreshold || 30;
                    var mediumThresh = ds.loadMediumThreshold || 70;
                    var loadPercent = maxCap > 0 ? Math.min((dayaWatt / maxCap) * 100, 100) : 0;

                    $('#panelStatus').text(panel.status);
                    $('#panelStatus').removeClass('bg-success bg-warning bg-danger');
                    if (panel.status === 'HIGH') $('#panelStatus').addClass('bg-danger');
                    else if (panel.status === 'MEDIUM') $('#panelStatus').addClass('bg-warning');
                    else $('#panelStatus').addClass('bg-success');

                    $('#panelAvgVoltage').text(avgVoltage.toFixed(1) + 'V');

                    // Phase type badge
                    var $phaseBadge = $('#phaseTypeBadge');
                    if (isThreePhase) {
                        $phaseBadge.text('3\u03A6').removeClass('bg-warning').addClass('bg-info').css('background-color', '').css('color', '');
                    } else {
                        $phaseBadge.text('1\u03A6').removeClass('bg-info').addClass('bg-warning').css('background-color', '').css('color', '#212529');
                    }

                    // Update category from API data
                    if (panel.deviceCategory) {
                        deviceCategoryMap[deviceKey] = panel.deviceCategory;
                        if (panel.deviceCategory !== currentCategory) {
                            updateCategoryUI(panel.deviceCategory);
                        }
                    }

                    // Voltage badges - warna dinamis
                    function getVoltColor(v) { return v < 200 ? 'bg-danger' : v < 220 ? 'bg-warning' : 'bg-success'; }
                    $('#voltR').text(voltR.toFixed(1).replace('.', ',') + 'V').removeClass('bg-success bg-warning bg-danger').addClass(getVoltColor(voltR));

                    if (isThreePhase) {
                        $('#voltS').text(voltS.toFixed(1).replace('.', ',') + 'V').removeClass('bg-success bg-warning bg-danger').addClass(getVoltColor(voltS));
                        $('#voltT').text(voltT.toFixed(1).replace('.', ',') + 'V').removeClass('bg-success bg-warning bg-danger').addClass(getVoltColor(voltT));
                    }

                    $('#avgVoltageDisplay').text(avgVoltage.toFixed(1) + ' V');

                    // Current badges - warna dinamis
                    function getAmpColor(a) { return a > 80 ? 'bg-danger' : a > 70 ? 'bg-warning' : 'bg-secondary'; }
                    $('#ampR').text(ampR.toFixed(2).replace('.', ',') + 'A').removeClass('bg-secondary bg-warning bg-danger').addClass(getAmpColor(ampR));

                    if (isThreePhase) {
                        $('#ampS').text(ampS.toFixed(2).replace('.', ',') + 'A').removeClass('bg-secondary bg-warning bg-danger').addClass(getAmpColor(ampS));
                        $('#ampT').text(ampT.toFixed(2).replace('.', ',') + 'A').removeClass('bg-secondary bg-warning bg-danger').addClass(getAmpColor(ampT));
                    }

                    $('#avgCurrentDisplay').text(avgCurrent.toFixed(2) + ' A');
                    $('#powerDisplay').text(formatNumber(dayaWatt) + ' W');
                    $('#aktifDisplay').text(formatNumber(aktif) + ' Wh');
                    $('#cosPhiDisplay').text(cosPhi.toFixed(3).replace('.', ','));
                    $('#freqDisplay').text(freq.toFixed(2).replace('.', ',') + ' Hz');

                    $('#pfPercentDisplay').text(pfPercent.toFixed(1).replace('.', ',') + '%');
                    var pfStatus = 'Poor';
                    var pfColor = 'bg-danger';
                    var pfTextColor = 'text-danger';
                    if (cosPhi >= 0.8) { pfStatus = 'Excellent'; pfColor = 'bg-success'; pfTextColor = 'text-success'; }
                    else if (cosPhi >= 0.6) { pfStatus = 'Good'; pfColor = 'bg-warning'; pfTextColor = 'text-warning'; }
                    $('#pfStatusDisplay').text(pfStatus).removeClass('bg-success bg-warning bg-danger').addClass(pfColor);
                    $('#pfStatusText').html('<span class="' + pfTextColor + '">' + pfStatus + '</span>');
                    $('#pfGauge').css('width', pfPercent + '%').text(pfPercent.toFixed(0) + '%');
                    $('#pfGauge').removeClass('bg-success bg-warning bg-danger').addClass(pfColor);

                    $('#loadDisplay').text(formatNumber(dayaWatt) + ' W');
                    $('#loadCapacityLabel').text(maxCap > 0 ? formatNumber(maxCap) : '-');
                    var loadColor = 'bg-info';
                    var loadStatus = 'NORMAL';
                    var loadStatusColor = 'text-success';
                    if (maxCap <= 0) { loadColor = 'bg-secondary'; loadStatus = '-'; loadStatusColor = 'text-muted'; }
                    else if (loadPercent > mediumThresh) { loadColor = 'bg-danger'; loadStatus = 'HIGH LOAD'; loadStatusColor = 'text-danger'; }
                    else if (loadPercent > normalThresh) { loadColor = 'bg-warning'; loadStatus = 'MEDIUM LOAD'; loadStatusColor = 'text-warning'; }
                    $('#loadStatusDisplay').html('<span class="' + loadStatusColor + '">' + loadStatus + '</span>');
                    $('#loadGauge').css('width', loadPercent + '%').text(maxCap > 0 ? loadPercent.toFixed(0) + '%' : '-');
                    $('#loadGauge').removeClass('bg-info bg-warning bg-danger bg-secondary').addClass(loadColor);

                    $('#statusText').text('Online');
                    console.log('Panel monitoring updated');
                },
                error: function(xhr, status, error) {
                    console.error('Error updating monitoring:', error);
                    $('#statusText').text('Offline');
                }
            });
        }

