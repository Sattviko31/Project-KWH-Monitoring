        // Chart.js center-text plugin (register once)
        if (!window._centerTextPluginRegistered) {
            window._centerTextPluginRegistered = true;
            var deviceCenterTextPlugin = {
                id: 'centerText',
                afterDraw: function(chart) {
                    var ct = chart.config.options && chart.config.options.plugins && chart.config.options.plugins.centerText;
                    if (!ct) return;
                    var ctx = chart.ctx;
                    var cx = (chart.chartArea.left + chart.chartArea.right) / 2;
                    var cy = (chart.chartArea.top + chart.chartArea.bottom) / 2;
                    ctx.save();
                    ctx.textAlign = 'center';
                    ctx.textBaseline = 'middle';
                    if (ct.line1) {
                        ctx.font = 'bold 13px sans-serif';
                        ctx.fillStyle = ct.color1 || '#333';
                        ctx.fillText(ct.line1, cx, cy - 10);
                    }
                    if (ct.line2) {
                        ctx.font = '10px sans-serif';
                        ctx.fillStyle = ct.color2 || '#888';
                        ctx.fillText(ct.line2, cx, cy + 8);
                    }
                    if (ct.line3) {
                        ctx.font = '9px sans-serif';
                        ctx.fillStyle = ct.color3 || '#aaa';
                        ctx.fillText(ct.line3, cx, cy + 22);
                    }
                    ctx.restore();
                }
            };
            Chart.register(deviceCenterTextPlugin);
        }

