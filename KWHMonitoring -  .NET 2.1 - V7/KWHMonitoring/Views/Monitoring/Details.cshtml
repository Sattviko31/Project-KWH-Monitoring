        function loadDeviceUsageStatistics() {
            console.log('Loading device usage statistics for', deviceKey);

            var startDate = new Date(deviceUsageDate.getFullYear(), deviceUsageDate.getMonth(), deviceUsageDate.getDate());
            var endDate = new Date(deviceUsageDate.getFullYear(), deviceUsageDate.getMonth(), deviceUsageDate.getDate(), 23, 59, 59);

            $.ajax({
                url: '/api/Api/usage-statistics/' + deviceKey,
                method: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({
                    startDate: startDate.toISOString(),
                    endDate: endDate.toISOString()
                }),
                dataType: 'json',
                timeout: 15000,
                success: function(data) {
                    if (!data.success) {
                        console.error('Error loading usage statistics');
                        return;
                    }

                    // Update summary cards (dalam kWh)
                    lastDeviceEnergyData = data;
                    $('#usageToday').text(formatDecimal(data.today.total) + ' kWh');
                    $('#usageTodayAvg').text(formatDecimal(data.today.avgPerHour));
                    $('#usageMonth').text(formatDecimal(data.month.total) + ' kWh');
                    $('#usageMonthAvg').text(formatDecimal(data.month.avgPerDay));
                    $('#usageYear').text(formatDecimal(data.year.total) + ' kWh');
                    $('#usageYearAvg').text(formatDecimal(data.year.avgPerMonth));

                    var tariff = data.tariffPerKWh || 1500;
                    $('#tariffDisplay').text('Rp ' + formatNumber(tariff));
                    var cost = data.estimatedCost || (data.month.total * tariff);
                    $('#usageCost').text('Rp ' + formatNumber(cost));

                    // Update peak information (dalam kWh)
                    $('#peakHourValue').text(formatDecimal(data.today.peakHour) + ' kWh');
                    $('#peakHourTime').text(data.today.peakHourTime);
                    $('#peakDayValue').text(formatDecimal(data.month.peakDay) + ' kWh');
                    $('#peakDayDate').text(data.month.peakDayDate);
                    $('#peakMonthValue').text(formatDecimal(data.year.peakMonth) + ' kWh');
                    $('#peakMonthName').text(data.year.peakMonthName);

                    // Update charts
                    updateDeviceUsageCharts(data);

                    // Update financial analysis sections
                    updateDeviceFinancialUI(data);

                    console.log('Device usage statistics loaded');
                },
                error: function(xhr, status, error) {
                    console.error('Error loading device usage statistics:', error);
                }
            });
        }

        function updateDeviceUsageCharts(data) {
            var commonOptions = {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } }
            };

            var today = new Date();
            var isToday = deviceUsageDate.toDateString() === today.toDateString();

            // Hourly Chart - SORT BY HOUR
            var hourlyCtx = document.getElementById('deviceHourlyChart');
            if (hourlyCtx && data.today.hourlyData.length > 0) {
                if (deviceUsageCharts.hourly) deviceUsageCharts.hourly.destroy();

                var sortedHourly = data.today.hourlyData.slice().sort(function(a, b) { return a.sortKey - b.sortKey; });
                var currentHour = today.getHours();

                var hourlyColors = sortedHourly.map(function(h) {
                    if (!isToday) return 'rgba(13, 110, 253, 0.7)';
                    if (h.sortKey === currentHour) return 'rgba(255, 165, 0, 0.9)';
                    if (h.sortKey < currentHour) return 'rgba(13, 110, 253, 0.7)';
                    return 'rgba(200, 200, 200, 0.3)';
                });

                deviceUsageCharts.hourly = new Chart(hourlyCtx, {
                    type: 'bar',
                    data: {
                        labels: sortedHourly.map(function(h) { return h.timeLabel; }),
                        datasets: [{
                            label: 'Energy (kWh)',
                            data: sortedHourly.map(function(h) { return h.energy; }),
                            backgroundColor: hourlyColors,
                            borderColor: hourlyColors.map(function(c) { return c.replace('0.7', '1').replace('0.9', '1').replace('0.3', '0.5'); }),
                            borderWidth: 1
                        }]
                    },
                    options: Object.assign({}, commonOptions, {
                        scales: {
                            y: {
                                beginAtZero: true,
                                ticks: { font: { size: 9 }, callback: function(v) { return v.toFixed(2) + ' kWh'; } }
                            },
                            x: { ticks: { font: { size: 8 }, maxRotation: 45 } }
                        }
                    })
                });
            }

            // Daily Chart - SORT BY DAY
            var dailyCtx = document.getElementById('deviceDailyChart');
            if (dailyCtx && data.month.dailyData.length > 0) {
                if (deviceUsageCharts.daily) deviceUsageCharts.daily.destroy();

                var sortedDaily = data.month.dailyData.slice().sort(function(a, b) { return a.sortKey - b.sortKey; });
                var isThisMonth = deviceUsageDate.getMonth() === today.getMonth() && deviceUsageDate.getFullYear() === today.getFullYear();
                var currentDay = today.getDate();

                var dailyColors = sortedDaily.map(function(d) {
                    if (!isThisMonth) return 'rgba(25, 135, 84, 0.7)';
                    if (d.sortKey === currentDay) return 'rgba(255, 165, 0, 0.9)';
                    if (d.sortKey < currentDay) return 'rgba(25, 135, 84, 0.7)';
                    return 'rgba(200, 200, 200, 0.3)';
                });

                deviceUsageCharts.daily = new Chart(dailyCtx, {
                    type: 'bar',
                    data: {
                        labels: sortedDaily.map(function(d) { return d.dateLabel; }),
                        datasets: [{
                            label: 'Energy (kWh)',
                            data: sortedDaily.map(function(d) { return d.energy; }),
                            backgroundColor: dailyColors,
                            borderColor: dailyColors.map(function(c) { return c.replace('0.7', '1').replace('0.9', '1').replace('0.3', '0.5'); }),
                            borderWidth: 1
                        }]
                    },
                    options: Object.assign({}, commonOptions, {
                        scales: {
                            y: {
                                beginAtZero: true,
                                ticks: { font: { size: 9 }, callback: function(v) { return v.toFixed(2) + ' kWh'; } }
                            },
                            x: { ticks: { font: { size: 8 }, maxRotation: 45 } }
                        }
                    })
                });
