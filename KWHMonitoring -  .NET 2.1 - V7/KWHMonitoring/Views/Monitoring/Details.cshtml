@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>

        // ============================================
        // CONFIGURATION
        // ============================================
        var deviceKey = '@deviceKey';
        var safeKey = '@safeKey';
        var isThreePhaseDevice = @Model.IsThreePhase.ToString().ToLower();
        var charts = {};
        var currentAnomalyPage = 1;
        var anomalyPageSize = 20;
        var refreshTimer = null;
        var anomalyTimer = null;
        var anomalyCooldown = {};
        
        // Konfirmasi anomali: butuh 5 data berturut-turut yang anomali
        var anomalyConfirmation = {
            counts: {}, // deviceKey_anomalyType -> count
            maxConfirmations: 5,
            cooldownTime: 60000
        };
        
        var deviceUsageDate = new Date();

        // EMA Settings - akan di-load dari database
        var emaSettings = {
            period: 20,
            mode: 'manual',
            upperThreshold: 30,
            lowerThreshold: 50,
            fibUpper: 1.618,
            fibLower: 0.618,
            showEMA: true,
            showThresholds: true,
            useInitial100ForEma: false,
            refreshInterval: 10,
            enableAlerts: true
        };

        // System/Display Settings
        var systemSettings = {
            chartDataPoints: 20,
            refreshInterval: 10,
            showGrid: true,
            showGridX: true,
            showGridY: true,
            gridColor: '#e0e0e0',
            showLegend: false,
            maxCapacity: 30000,
            normalThreshold: 30,
            mediumThreshold: 70
        };

        // Downtime Settings
        var downtimeSettings = {
            enabled: false,
            startHour: 22,
            endHour: 6,
            description: ''
        };

        var isDowntimeNow = false;

        // ============================================
        // DEVICE CATEGORY MANAGEMENT
        // ============================================
        var deviceCategoryMap = {};
        var currentCategory = 'Billboard';

        var categoryMeta = {
            Billboard: { icon: '🔵', color: '#2196f3', desc: 'Perangkat kategori Billboard — Digunakan untuk panel iklan billboard.' },
            Megatron:  { icon: '🟠', color: '#ff9800', desc: 'Perangkat kategori Megatron — Digunakan untuk panel megatron / LED display.' },
            NeonBox:   { icon: '🟣', color: '#9c27b0', desc: 'Perangkat kategori Neon Box — Digunakan untuk box neon sign.' }
        };

        var categoryDowntimeSettings = {
            Billboard: { enabled: false, startHour: 22, endHour: 6, description: '' },
            Megatron:  { enabled: false, startHour: 22, endHour: 6, description: '' },
            NeonBox:   { enabled: false, startHour: 22, endHour: 6, description: '' }
        };

        var categoryDowntimeMap = {};

        function loadDeviceCategory() {
            return $.ajax({
                url: '/api/Api/device-categories',
                method: 'GET',
                dataType: 'json',
                timeout: 10000,
                success: function(data) {
                    if (data.devices) {
                        deviceCategoryMap = data.devices;
                    }
                    currentCategory = deviceCategoryMap[deviceKey] || 'Billboard';
                    updateCategoryUI(currentCategory);
                    console.log('Device category loaded:', deviceCategoryMap);
                },
                error: function() { console.warn('Failed to load device categories'); }
            });
        }

        function updateCategoryUI(category) {
            currentCategory = category;
            var meta = categoryMeta[category] || categoryMeta['Billboard'];

            // Update header badge
            $('#detailCategoryBadge').html('<span class="badge cat-' + category + '" style="font-size: 0.75rem;">' + meta.icon + ' ' + category + '</span>');

            // Update selector in header bar
            var $sel = $('#detailCategorySelect');
            $sel.val(category);
            $sel.removeClass('cat-Billboard cat-Megatron cat-NeonBox').addClass('cat-' + category);

            // Update icon in header bar
            $('#detailCategoryIcon').text(meta.icon);

            // Update downtime info for this category
            updateCategoryDowntimeUI(category);
        }

        function saveDeviceCategory(deviceKey, category) {
            return $.ajax({
                url: '/api/Api/device-category',
                method: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({ deviceKey: deviceKey, category: category }),
                success: function(data) {
                    if (data.success) {
                        deviceCategoryMap[deviceKey] = category;
                        updateCategoryUI(category);
                        // Reload downtime for new category
                        checkCategoryDowntime(category).then(function() {
                            updateCategoryDowntimeUI(category);
                            loadDetailChartData();
                        });
                    }
                },
                error: function() { alert('Gagal menyimpan kategori device'); }
            });
        }

        // Category selector change handler
        $(document).on('change', '#detailCategorySelect', function(e) {
            e.stopPropagation();
            var category = $(this).val();
            saveDeviceCategory(deviceKey, category);
        });

        function loadCategoryDowntimeSettings() {
            var categories = ['Billboard', 'Megatron', 'NeonBox'];
            var promises = categories.map(function(cat) {
                return $.ajax({
                    url: '/api/Api/downtime-settings/' + cat,
                    method: 'GET',
                    dataType: 'json',
                    timeout: 10000,
                    success: function(data) {
                        categoryDowntimeSettings[cat] = {
                            enabled: data.enabled || false,
                            startHour: data.startHour != null ? data.startHour : 22,
                            endHour: data.endHour != null ? data.endHour : 6,
                            description: data.description || ''
                        };
                    }
                });
            });
            return $.when.apply($, promises);
        }

        function checkCategoryDowntime(category) {
            if (!category) category = 'Billboard';
            return $.ajax({
                url: '/api/Api/downtime-status?category=' + encodeURIComponent(category),
                method: 'GET',
                dataType: 'json',
                timeout: 5000,
                success: function(data) {
                    categoryDowntimeMap[category] = data.isDowntime || false;
                },
                error: function() { console.warn('Failed to check downtime for ' + category); }
            });
        }

        function loadAllCategoryDowntime() {
            var categories = ['Billboard', 'Megatron', 'NeonBox'];
            var promises = categories.map(function(cat) {
                return checkCategoryDowntime(cat);
            });
            return $.when.apply($, promises);
        }

        function updateCategoryDowntimeUI(category) {
            var s = categoryDowntimeSettings[category] || categoryDowntimeSettings['Billboard'];
            var isDowntime = categoryDowntimeMap[category] || false;

            var startLabel = (s.startHour < 10 ? '0' : '') + s.startHour + ':00';
            var endLabel = (s.endHour < 10 ? '0' : '') + s.endHour + ':00';

            // Update downtime label in header bar
            if (s.enabled) {
                $('#detailDowntimeLabel')
                    .text(startLabel + '–' + endLabel)
                    .removeClass('bg-secondary bg-success bg-danger')
                    .addClass(isDowntime ? 'bg-danger' : 'bg-success');
            } else {
                $('#detailDowntimeLabel')
                    .text('Tidak Aktif')
                    .removeClass('bg-success bg-danger')
                    .addClass('bg-secondary');
            }

            // Update downtime status in header bar
            var $status = $('#detailDowntimeStatus');
            var $time = $('#detailDowntimeTime');

            if (isDowntime) {
                $status.html('<span class="text-danger"><i class="fas fa-moon"></i> DOWNTIME</span>');
                $time.text(startLabel + '–' + endLabel);
            } else if (s.enabled) {
                $status.html('<span class="text-success"><i class="fas fa-sun"></i> NORMAL</span>');
                $time.text(startLabel + '–' + endLabel);
            } else {
                $status.html('<span class="text-muted"><i class="fas fa-minus-circle"></i> Nonaktif</span>');
                $time.text('');
            }
        }

        function isDowntimeForDevice() {
            return categoryDowntimeMap[currentCategory] || false;
        }

        // ============================================
        // USAGE STATISTICS CHARTS
        // ============================================
        var deviceUsageCharts = {};

        function updateDeviceDateInput() {
            var y = deviceUsageDate.getFullYear();
            var m = String(deviceUsageDate.getMonth() + 1).padStart(2, '0');
            var d = String(deviceUsageDate.getDate()).padStart(2, '0');
            $('#deviceFilterDate').val(y + '-' + m + '-' + d);
        }

        function updateDeviceDayName() {
            var days = ['Minggu', 'Senin', 'Selasa', 'Rabu', 'Kamis', 'Jumat', 'Sabtu'];
            var months = ['Januari', 'Februari', 'Maret', 'April', 'Mei', 'Juni', 'Juli', 'Agustus', 'September', 'Oktober', 'November', 'Desember'];

            var dayName = days[deviceUsageDate.getDay()];
            var dateStr = deviceUsageDate.getDate() + ' ' + months[deviceUsageDate.getMonth()] + ' ' + deviceUsageDate.getFullYear();

            var today = new Date();
            var isToday = deviceUsageDate.toDateString() === today.toDateString();

            $('#deviceSelectedDayName').text(dayName + ' - ' + dateStr + (isToday ? ' (Hari Ini)' : ''));
        }

        function loadDeviceUsageStatistics() {
            console.log('Loading device usage statistics for', deviceKey);

            var startDate = new Date(deviceUsageDate.getFullYear(), deviceUsageDate.getMonth(), deviceUsageDate.getDate());
            var endDate = new Date(deviceUsageDate.getFullYear(), deviceUsageDate.getMonth(), deviceUsageDate.getDate(), 23, 59, 59);

            $.ajax({
                url: '/api/Api/usage-statistics/' + deviceKey,
                method: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({
                    startDate: startDate.toISOString(),
                    endDate: endDate.toISOString()
                }),
                dataType: 'json',
                timeout: 15000,
                success: function(data) {
                    if (!data.success) {
                        console.error('Error loading usage statistics');
                        return;
                    }

                    // Update summary cards (dalam kWh)
                    $('#usageToday').text(formatDecimal(data.today.total) + ' kWh');
                    $('#usageTodayAvg').text(formatDecimal(data.today.avgPerHour));
                    $('#usageMonth').text(formatDecimal(data.month.total) + ' kWh');
                    $('#usageMonthAvg').text(formatDecimal(data.month.avgPerDay));
                    $('#usageYear').text(formatDecimal(data.year.total) + ' kWh');
                    $('#usageYearAvg').text(formatDecimal(data.year.avgPerMonth));

                    var tariff = data.tariffPerKWh || 1500;
                    $('#tariffDisplay').text('Rp ' + formatNumber(tariff));
                    var cost = data.estimatedCost || (data.month.total * tariff);
                    $('#usageCost').text('Rp ' + formatNumber(cost));

                    // Update peak information (dalam kWh)
                    $('#peakHourValue').text(formatDecimal(data.today.peakHour) + ' kWh');
                    $('#peakHourTime').text(data.today.peakHourTime);
                    $('#peakDayValue').text(formatDecimal(data.month.peakDay) + ' kWh');
