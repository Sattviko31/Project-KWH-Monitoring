@model KWHMonitoring.Models.PanelViewModel
@{
    ViewData["Title"] = $"Details - {Model.GroupName}";
    var deviceKey = Model.DeviceKey;
    var safeKey = deviceKey.Replace("-", "_");
    var isThreePhase = Model.IsThreePhase;
    // Define maximum capacity for load calculations (in Watts)
    // This value should ideally come from the model or database
    var maxCapacity = 30000m; // Default to 30,000W - should be loaded from configuration
}

<!-- Breadcrumb -->
<div class="erp-breadcrumb">
    <a asp-controller="Monitoring" asp-action="Index"><i class="fas fa-home"></i> Dashboard</a>
    <span class="separator"><i class="fas fa-chevron-right" style="font-size:0.6rem"></i></span>
    <span class="current">Details - @Model.GroupName</span>
</div>

<!-- Page Header -->
<div class="erp-page-header">
    <div>
        <h2><i class="fas fa-info-circle text-primary"></i> Details - @Model.GroupName</h2>
        <div class="subtitle">
            <i class="fas fa-microchip"></i> Device: <strong>@deviceKey</strong>
            <span class="d-none d-md-inline">
                <span class="mx-2">|</span>
                <i class="fas fa-server"></i> ID: @Model.DeviceId
            </span>
            <span class="ms-2">
                @if (isThreePhase)
                {
                    <span class="badge" style="background-color: #6f42c1; font-size: 0.75rem;">3&#934; Three Phase</span>
                }
                else
                {
                    <span class="badge" style="background-color: #fd7e14; font-size: 0.75rem;">1&#934; Single Phase</span>
                }
            </span>
            <span class="ms-2" id="detailCategoryBadge">
                <span class="badge cat-Billboard" style="font-size: 0.75rem;">🔵 Billboard</span>
            </span>
            <span class="ms-2"><i class="fas fa-circle text-success" style="font-size:0.5rem"></i> <span id="statusText">Online</span></span>
        </div>
    </div>
    <div class="actions">
        <button class="btn btn-erp-action" id="btnRefresh">
            <i class="fas fa-sync-alt"></i> <span class="d-none d-sm-inline">Refresh</span>
        </button>
        <button class="btn btn-erp-action" id="btnSettings">
            <i class="fas fa-cog"></i> <span class="d-none d-sm-inline">EMA</span>
        </button>
        <a asp-action="Index" class="btn btn-erp-action">
            <i class="fas fa-arrow-left"></i> <span class="d-none d-sm-inline">Dashboard</span>
        </a>
        <a asp-action="ExportCSV" asp-route-deviceKey="@deviceKey" class="btn btn-erp-action">
            <i class="fas fa-file-csv"></i> <span class="d-none d-sm-inline">Export</span>
        </a>
    </div>
</div>

<!-- Category & Downtime Info Bar -->
<div class="card shadow-sm mb-3">
    <div class="card-body py-2 px-3">
        <div class="d-flex align-items-center flex-wrap gap-3">
            <div class="d-flex align-items-center gap-2">
                <span id="detailCategoryIcon" style="font-size: 1.3rem;">🔵</span>
                <select class="category-selector cat-Billboard" id="detailCategorySelect" data-device-key="@deviceKey" title="Pilih kategori device" style="font-size:0.8rem;">
                    <option value="Billboard" selected>🔵 Billboard</option>
                    <option value="Megatron">🟠 Megatron</option>
                    <option value="NeonBox">🟣 Neon Box</option>
                </select>
            </div>
            <div class="vr d-none d-md-block"></div>
            <div class="d-flex align-items-center gap-2">
                <i class="fas fa-clock text-muted" style="font-size:0.8rem;"></i>
                <small class="text-muted">Downtime:</small>
                <span class="badge bg-secondary" id="detailDowntimeLabel" style="font-size: 0.75rem;">Tidak Aktif</span>
            </div>
            <div class="vr d-none d-md-block"></div>
            <div class="d-flex align-items-center gap-2" id="detailDowntimeStatusCard">
                <span id="detailDowntimeStatus" class="fw-bold" style="font-size: 0.8rem;">
                    <i class="fas fa-spinner fa-spin"></i> Memuat...
                </span>
                <small class="text-muted" id="detailDowntimeTime"></small>
            </div>
        </div>
    </div>
</div>

<!-- Tabs Navigation (ERP Style) -->
<ul class="nav nav-tabs erp-tabs" id="detailsTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <a class="nav-link erp-tab active" id="monitoring-tab" data-toggle="tab" href="#tabMonitoring" role="tab">
            <i class="fas fa-tachometer-alt"></i> <span>Monitoring</span>
        </a>
    </li>
    <li class="nav-item" role="presentation">
        <a class="nav-link erp-tab" id="charts-tab" data-toggle="tab" href="#tabCharts" role="tab">
            <i class="fas fa-chart-line"></i> <span>Charts</span>
        </a>
    </li>
    <li class="nav-item" role="presentation">
        <a class="nav-link erp-tab" id="usage-tab" data-toggle="tab" href="#tabUsage" role="tab">
            <i class="fas fa-chart-bar"></i> <span>Usage</span>
        </a>
    </li>
    <li class="nav-item" role="presentation">
        <a class="nav-link erp-tab" id="logs-tab" data-toggle="tab" href="#tabAnomalyLogs" role="tab">
            <i class="fas fa-exclamation-triangle"></i> <span>Anomaly</span>
            <span class="badge bg-danger" id="anomalyCount">0</span>
        </a>
    </li>
</ul>

    <!-- Tab Content -->
    <div class="tab-content" id="detailsTabContent">

        <!-- TAB 1: MONITORING -->
        <div class="tab-pane fade in active" id="tabMonitoring" role="tabpanel">
            <div class="card shadow-sm mb-3 mb-md-4">
                <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center py-2 py-md-3">
                    <h5 class="mb-0">
                        <i class="fas fa-plug"></i> <span id="panelGroupName">@Model.GroupName</span>
                    </h5>
                    <div class="d-flex align-items-center gap-2">
                        @if (isThreePhase)
                        {
                            <span class="badge me-2" style="background-color: #6f42c1;" id="phaseTypeBadge">3&#934;</span>
                        }
                        else
                        {
                            <span class="badge me-2" style="background-color: #fd7e14;" id="phaseTypeBadge">1&#934;</span>
                        }
                        <span class="badge bg-success me-2" id="panelStatus">NORMAL</span>
                        <span class="badge bg-secondary" id="panelAvgVoltage">@Model.AvgVoltage.ToString("N1")V</span>
                    </div>
                </div>
                <div class="card-body">
                    <!-- Row 1: 3 cards -->
                    <div class="detail-stats-row mb-3">
                        <!-- Voltage Section -->
                        <div>
                            <div class="card h-100 border-start border-primary border-4">
                                <div class="card-body p-3">
                                    @if (isThreePhase)
                                    {
                                        <h6 class="text-muted mb-3 pb-2 border-bottom">
                                            <i class="fas fa-bolt text-warning"></i> Voltage (R/S/T)
                                        </h6>
                                        <div class="d-flex justify-content-between gap-2 mb-3">
                                            <div class="text-center flex-fill">
                                                <div class="badge bg-success w-100 py-2 px-1 fs-6" id="voltR">@Model.Volt_R.ToString("N1")V</div>
                                                <small class="text-muted d-block mt-1">R</small>
                                            </div>
                                            <div class="text-center flex-fill">
                                                <div class="badge bg-success w-100 py-2 px-1 fs-6" id="voltS">@(Model.Volt_S?.ToString("N1") ?? "0.0")V</div>
                                                <small class="text-muted d-block mt-1">S</small>
                                            </div>
                                            <div class="text-center flex-fill">
                                                <div class="badge bg-success w-100 py-2 px-1 fs-6" id="voltT">@(Model.Volt_T?.ToString("N1") ?? "0.0")V</div>
                                                <small class="text-muted d-block mt-1">T</small>
                                            </div>
                                        </div>
                                        <div class="text-center pt-2 border-top">
                                            <small class="text-muted">Average</small>
                                            <h5 class="text-primary mb-0 fw-bold" id="avgVoltageDisplay">@Model.AvgVoltage.ToString("N1") V</h5>
                                        </div>
                                    }
                                    else
                                    {
                                        <h6 class="text-muted mb-3 pb-2 border-bottom">
                                            <i class="fas fa-bolt text-warning"></i> Voltage
                                        </h6>
                                        <div class="text-center mb-3">
                                            <div class="badge bg-success py-2 px-3 fs-5" id="voltR">@Model.Volt_R.ToString("N1")V</div>
                                            <small class="text-muted d-block mt-1">R</small>
                                        </div>
                                        <div class="text-center pt-2 border-top">
                                            <small class="text-muted">Voltage</small>
                                            <h5 class="text-primary mb-0 fw-bold" id="avgVoltageDisplay">@Model.Volt_R.ToString("N1") V</h5>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- Current Section -->
                        <div>
                            <div class="card h-100 border-start border-info border-4">
                                <div class="card-body p-3">
                                    @if (isThreePhase)
                                    {
                                        <h6 class="text-muted mb-3 pb-2 border-bottom">
                                            <i class="fas fa-wave-square text-info"></i> Current (R/S/T)
                                        </h6>
                                        <div class="d-flex justify-content-between gap-2 mb-3">
                                            <div class="text-center flex-fill">
                                                <div class="badge bg-secondary w-100 py-2 px-1 fs-6" id="ampR">@Model.Amp_R.ToString("N2")A</div>
                                                <small class="text-muted d-block mt-1">R</small>
                                            </div>
                                            <div class="text-center flex-fill">
                                                <div class="badge bg-secondary w-100 py-2 px-1 fs-6" id="ampS">@(Model.Amp_S?.ToString("N2") ?? "0.00")A</div>
                                                <small class="text-muted d-block mt-1">S</small>
                                            </div>
                                            <div class="text-center flex-fill">
                                                <div class="badge bg-secondary w-100 py-2 px-1 fs-6" id="ampT">@(Model.Amp_T?.ToString("N2") ?? "0.00")A</div>
                                                <small class="text-muted d-block mt-1">T</small>
                                            </div>
                                        </div>
                                        <div class="text-center pt-2 border-top">
                                            <small class="text-muted">Average</small>
                                            <h5 class="text-success mb-0 fw-bold" id="avgCurrentDisplay">@Model.AvgAmpere.ToString("N2") A</h5>
                                        </div>
                                    }
                                    else
                                    {
                                        <h6 class="text-muted mb-3 pb-2 border-bottom">
                                            <i class="fas fa-wave-square text-info"></i> Current
                                        </h6>
                                        <div class="text-center mb-3">
                                            <div class="badge bg-secondary py-2 px-3 fs-5" id="ampR">@Model.Amp_R.ToString("N2")A</div>
                                            <small class="text-muted d-block mt-1">R</small>
                                        </div>
                                        <div class="text-center pt-2 border-top">
                                            <small class="text-muted">Current</small>
                                            <h5 class="text-success mb-0 fw-bold" id="avgCurrentDisplay">@Model.Amp_R.ToString("N2") A</h5>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- Power & Energy Section -->
                        <div>
                            <div class="card h-100 border-start border-danger border-4">
                                <div class="card-body p-3">
                                    <h6 class="text-muted mb-3 pb-2 border-bottom">
                                        <i class="fas fa-fire text-danger"></i> Power & Energy
                                    </h6>
                                    <div class="d-flex gap-3 mb-3">
                                        <div class="flex-fill text-center p-2 bg-primary bg-opacity-10 rounded-3">
                                            <small class="text-primary fw-semibold d-block mb-1">Power</small>
                                            <strong class="text-primary fs-5" id="powerDisplay">@Model.Daya_Watt.ToString("N0") W</strong>
                                        </div>
                                        <div class="flex-fill text-center p-2 bg-warning bg-opacity-10 rounded-3">
                                            <small class="text-warning fw-semibold d-block mb-1">Aktif</small>
                                            <strong class="text-warning fs-5" id="aktifDisplay">@Model.Energi_Aktif_Wh.ToString("N0") Wh</strong>
                                        </div>
                                    </div>
                                    <div class="text-center pt-2 border-top">
                                        <small class="text-muted">Status</small>
                                        <h5 class="mb-0 fw-bold" id="loadStatusDisplay">
                                            @{
                                                var loadStatusPercent = Math.Min((Model.Daya_Watt / maxCapacity) * 100, 100);
                                            }
                                            @if (loadStatusPercent > 70) { <span class="text-danger">HIGH</span> }
                                            else if (loadStatusPercent > 30) { <span class="text-warning">MEDIUM</span> }
                                            else { <span class="text-success">NORMAL</span> }
                                        </h5>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Row 2: 3 cards -->
                    <div class="detail-stats-row">
                        <!-- Cos Phi & Frequency -->
                        <div>
                            <div class="card h-100 border-start border-warning border-4">
                                <div class="card-body p-3">
                                    <h6 class="text-muted mb-3 pb-2 border-bottom">
                                        <i class="fas fa-percentage text-info"></i> Power Factor & Freq
                                    </h6>
                                    <div class="d-flex gap-3 mb-3">
                                        <div class="flex-fill text-center p-2">
                                            <small class="text-muted fw-semibold d-block mb-1">Cos Phi</small>
                                            <strong class="text-info fs-5" id="cosPhiDisplay">@Model.Cos_Phi.ToString("N3")</strong>
                                        </div>
                                        <div class="flex-fill text-center p-2">
                                            <small class="text-muted fw-semibold d-block mb-1">Frequency</small>
                                            <strong class="text-warning fs-5" id="freqDisplay">@Model.Frekuensi_Hz.ToString("N2") Hz</strong>
                                        </div>
                                    </div>
                                    <div class="text-center pt-2 border-top">
                                        <small class="text-muted">PF Status</small>
                                        <h5 class="mb-0 fw-bold" id="pfStatusText">
                                            @if (Model.Cos_Phi >= 0.8m) { <span class="text-success">Excellent</span> }
                                            else if (Model.Cos_Phi >= 0.6m) { <span class="text-warning">Good</span> }
                                            else { <span class="text-danger">Poor</span> }
                                        </h5>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Power Factor Gauge -->
                        <div>
                            <div class="card h-100 border-start border-success border-4">
                                <div class="card-body p-3">
                                    <h6 class="text-muted mb-3 pb-2 border-bottom">
                                        <i class="fas fa-tachometer-alt text-success"></i> Power Factor
                                    </h6>
                                    <div class="text-center mb-3">
                                        <h3 class="mb-1 fw-bold" id="pfPercentDisplay">@((Model.Cos_Phi * 100).ToString("N1"))%</h3>
                                        <span class="badge bg-@(Model.Cos_Phi >= 0.8m ? "success" : Model.Cos_Phi >= 0.6m ? "warning" : "danger") fs-6" id="pfStatusDisplay">
                                            @(Model.Cos_Phi >= 0.8m ? "Excellent" : Model.Cos_Phi >= 0.6m ? "Good" : "Poor")
                                        </span>
                                    </div>
                                    <div class="progress" style="height: 20px;">
                                        <div class="progress-bar @(Model.Cos_Phi >= 0.8m ? "bg-success" : Model.Cos_Phi >= 0.6m ? "bg-warning" : "bg-danger")"
                                             id="pfGauge"
                                             role="progressbar"
                                             style="width: @((Model.Cos_Phi * 100).ToString("F0"))%; font-size: 0.85rem; font-weight: bold;">
                                            @((Model.Cos_Phi * 100).ToString("N0"))%
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Load Gauge -->
                        <div>
                            <div class="card h-100 border-start border-primary border-4">
                                <div class="card-body p-3">
                                    <h6 class="text-muted mb-3 pb-2 border-bottom">
                                        <i class="fas fa-chart-line text-primary"></i> Load
                                    </h6>
                                    <div class="text-center mb-3">
                                        <h3 class="mb-1 fw-bold" id="loadDisplay">@Model.Daya_Watt.ToString("N0") W</h3>
                                        <small class="text-muted">of <span id="loadCapacityLabel">@maxCapacity.ToString("N0")</span> W capacity</small>
                                    </div>
                                    @{
                                        var loadPercent = Math.Min((Model.Daya_Watt / maxCapacity) * 100, 100);
                                        var loadColor = loadPercent > 70 ? "bg-danger" : loadPercent > 30 ? "bg-warning" : "bg-info";
                                    }
                                    <div class="progress" style="height: 20px;">
                                        <div class="progress-bar @loadColor"
                                             id="loadGauge"
                                             role="progressbar"
                                             style="width: @loadPercent%; font-size: 0.85rem; font-weight: bold;">
                                            @loadPercent.ToString("N0")%
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Category & Downtime Info Card moved to header bar -->

        </div>

        <!-- TAB 2: USAGE STATISTICS -->
        <div class="tab-pane fade" id="tabUsage" role="tabpanel">
            <!-- Date Navigation -->
            <div class="row mb-2 mb-md-3">
                <div class="col-12">
                    <div class="card shadow-sm">
                        <div class="card-body py-2">
                            <div class="row align-items-center date-nav-row">
                                <div class="col-auto">
                                    <label class="form-label mb-0 fw-bold"><i class="fas fa-calendar"></i></label>
                                </div>
                                <div class="col-auto">
                                    <button class="btn btn-outline-primary btn-sm" id="btnDevicePrevDay">
                                        <i class="fas fa-chevron-left"></i>
                                    </button>
                                </div>
                                <div class="col-auto">
                                    <input type="date" class="form-control form-control-sm" id="deviceFilterDate" style="min-width: 140px;">
                                </div>
                                <div class="col-auto">
                                    <button class="btn btn-outline-primary btn-sm" id="btnDeviceNextDay">
                                        <i class="fas fa-chevron-right"></i>
                                    </button>
                                </div>
                                <div class="col-auto">
                                    <button class="btn btn-outline-secondary btn-sm" id="btnDeviceToday">
                                        <i class="fas fa-calendar-day"></i> <span class="d-none d-sm-inline">Hari Ini</span>
                                    </button>
                                </div>
                                <div class="col">
                                    <span class="text-muted ms-2" id="deviceSelectedDayName">-</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Summary Cards -->
            <div class="stats-row mb-3 mb-md-4">
                <div>
                    <div class="stat-card bg-primary h-100">
                        <div class="stat-label">Hari Ini</div>
                        <div class="stat-value" id="usageToday">0 kWh</div>
                        <small style="opacity:0.75">Rata-rata: <span id="usageTodayAvg">0</span> kWh/jam</small>
                        <i class="fas fa-calendar-day stat-icon"></i>
                    </div>
                </div>
                <div>
                    <div class="stat-card bg-success h-100">
                        <div class="stat-label">Bulan Ini</div>
                        <div class="stat-value" id="usageMonth">0 kWh</div>
                        <small style="opacity:0.75">Rata-rata: <span id="usageMonthAvg">0</span> kWh/hari</small>
                        <i class="fas fa-calendar-week stat-icon"></i>
                    </div>
                </div>
                <div>
                    <div class="stat-card bg-info h-100">
                        <div class="stat-label">Tahun Ini</div>
                        <div class="stat-value" id="usageYear">0 kWh</div>
                        <small style="opacity:0.75">Rata-rata: <span id="usageYearAvg">0</span> kWh/bulan</small>
                        <i class="fas fa-calendar stat-icon"></i>
                    </div>
                </div>
                <div>
                    <div class="stat-card bg-warning h-100">
                        <div class="stat-label">Estimasi Biaya</div>
                        <div class="stat-value" id="usageCost">Rp 0</div>
                        <small style="opacity:0.75">Tarif: <span id="tariffDisplay">Rp 1.500</span>/kWh</small>
                        <i class="fas fa-money-bill-wave stat-icon"></i>
                    </div>
                </div>
            </div>

            <!-- Charts -->
            <div class="chart-row mb-3 mb-md-4">
                <div>
                    <div class="card shadow-sm h-100">
                        <div class="card-header bg-primary text-white py-2">
                            <h6 class="mb-0"><i class="fas fa-clock"></i> Per Jam</h6>
                        </div>
                        <div class="card-body">
                            <canvas id="deviceHourlyChart"></canvas>
                        </div>
                    </div>
                </div>
                <div>
                    <div class="card shadow-sm h-100">
                        <div class="card-header bg-success text-white py-2">
                            <h6 class="mb-0"><i class="fas fa-calendar-day"></i> Per Hari</h6>
                        </div>
                        <div class="card-body">
                            <canvas id="deviceDailyChart"></canvas>
                        </div>
                    </div>
                </div>
                <div>
                    <div class="card shadow-sm h-100">
                        <div class="card-header bg-info text-white py-2">
                            <h6 class="mb-0"><i class="fas fa-calendar-alt"></i> Per Bulan</h6>
                        </div>
                        <div class="card-body">
                            <canvas id="deviceMonthlyChart"></canvas>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Peak Info -->
            <div class="peak-row">
                <div>
                    <div class="card bg-light">
                        <div class="card-body py-2">
                            <h6 class="text-muted mb-1"><i class="fas fa-bolt text-warning"></i> Peak Hour</h6>
                            <h5 class="text-primary mb-1" id="peakHourValue">0 kWh</h5>
                            <p class="text-muted mb-0">Jam: <span id="peakHourTime">-</span></p>
                        </div>
                    </div>
                </div>
                <div>
                    <div class="card bg-light">
                        <div class="card-body py-2">
                            <h6 class="text-muted mb-1"><i class="fas fa-calendar-day text-success"></i> Peak Day</h6>
                            <h5 class="text-success mb-1" id="peakDayValue">0 kWh</h5>
                            <p class="text-muted mb-0">Tanggal: <span id="peakDayDate">-</span></p>
                        </div>
                    </div>
                </div>
                <div>
                    <div class="card bg-light">
                        <div class="card-body py-2">
                            <h6 class="text-muted mb-1"><i class="fas fa-calendar-alt text-info"></i> Peak Month</h6>
                            <h5 class="text-info mb-1" id="peakMonthValue">0 kWh</h5>
                            <p class="text-muted mb-0">Bulan: <span id="peakMonthName">-</span></p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- TAB 3: CHARTS -->
        <div class="tab-pane fade" id="tabCharts" role="tabpanel">
            <div class="chart-row">
                <div>
                    <div class="card shadow-sm h-100">
                        <div class="card-header bg-primary text-white py-2">
                            <h6 class="mb-0"><i class="fas fa-bolt"></i> Voltage (V)</h6>
                        </div>
                        <div class="card-body">
                            <canvas id="detailVoltageChart"></canvas>
                        </div>
                    </div>
                </div>
                <div>
                    <div class="card shadow-sm h-100">
                        <div class="card-header bg-success text-white py-2">
                            <h6 class="mb-0"><i class="fas fa-wave-square"></i> Current (A)</h6>
                        </div>
                        <div class="card-body">
                            <canvas id="detailCurrentChart"></canvas>
                        </div>
                    </div>
                </div>
                <div>
                    <div class="card shadow-sm h-100">
                        <div class="card-header bg-info text-white py-2">
                            <h6 class="mb-0"><i class="fas fa-fire"></i> Power (W)</h6>
                        </div>
                        <div class="card-body">
                            <canvas id="detailPowerChart"></canvas>
                        </div>
                    </div>
