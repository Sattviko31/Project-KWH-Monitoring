</div>

<!-- EMA & Chart Settings Modal -->
<div class="modal fade" id="emaSettingsModal" tabindex="-1">
    <div class="modal-dialog ema-modal-dialog">
        <div class="modal-content ema-modal-content">
            <div class="modal-header bg-primary text-white py-2">
                <h6 class="modal-title mb-0"><i class="fas fa-cog"></i> EMA & Chart Settings</h6>
                <button type="button" class="close text-white" data-dismiss="modal"><span>&times;</span></button>
            </div>
            <div class="modal-body ema-modal-body">
                <ul class="nav nav-tabs nav-tabs-sm mb-2" id="emaModalTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <a class="nav-link active" id="ema-tab-inner" data-toggle="tab" href="#emaTabContent" role="tab">
                            <i class="fas fa-chart-line"></i> EMA
                        </a>
                    </li>
                    <li class="nav-item" role="presentation">
                        <a class="nav-link" id="downtime-tab-inner" data-toggle="tab" href="#downtimeTabContent" role="tab">
                            <i class="fas fa-moon"></i> Downtime
                        </a>
                    </li>
                    <li class="nav-item" role="presentation">
                        <a class="nav-link" id="display-tab-inner" data-toggle="tab" href="#displayTabContent" role="tab">
                            <i class="fas fa-th"></i> Display
                        </a>
                    </li>
                </ul>
                <div class="tab-content">
                    <!-- EMA TAB -->
                    <div class="tab-pane fade in active" id="emaTabContent" role="tabpanel">
                        <div class="ema-info-banner">
                            <i class="fas fa-info-circle"></i>
                            <strong>EMA</strong> — Exponential Moving Average untuk deteksi anomali pada chart Power.
                        </div>
                        <div class="mb-2">
                            <label class="form-label ema-label">Threshold Mode</label>
                            <div class="btn-group w-100 ema-btn-group" role="group">
                                <input type="radio" class="btn-check" name="thresholdMode" id="modeManual" value="manual" checked>
                                <label class="btn btn-outline-primary ema-btn-sm" for="modeManual"><i class="fas fa-percentage"></i> Manual (%)</label>
                                <input type="radio" class="btn-check" name="thresholdMode" id="modeFibonacci" value="fibonacci">
                                <label class="btn btn-outline-primary ema-btn-sm" for="modeFibonacci"><i class="fas fa-infinity"></i> Fibonacci (φ)</label>
                            </div>
                        </div>
                        <div id="manualSettings">
                            <div class="ema-grid-2 mb-2">
                                <div>
                                    <label class="form-label ema-label">Upper Threshold (%)</label>
                                    <input type="number" class="form-control form-control-sm" id="upperThreshold" value="30" min="1" max="1000">
                                    <small class="text-muted ema-hint">Di atas EMA → OVERLOAD</small>
                                </div>
                                <div>
                                    <label class="form-label ema-label">Lower Threshold (%)</label>
                                    <input type="number" class="form-control form-control-sm" id="lowerThreshold" value="50" min="1" max="100">
                                    <small class="text-muted ema-hint">Di bawah EMA → DEVICE DROP</small>
                                </div>
                            </div>
                        </div>
                        <div id="fibonacciSettings" style="display: none;">
                            <div class="ema-grid-2 mb-2">
                                <div>
                                    <label class="form-label ema-label text-danger">Upper (φ)</label>
                                    <select class="form-select form-select-sm" id="fibUpper">
                                        <option value="1.272">1.272 (√φ)</option>
                                        <option value="1.618" selected>1.618 (φ)</option>
                                        <option value="2.000">2.000 (2×)</option>
                                        <option value="2.618">2.618 (φ²)</option>
                                        <option value="3.236">3.236 (2φ)</option>
                                        <option value="4.236">4.236 (φ³)</option>
                                    </select>
                                </div>
                                <div>
                                    <label class="form-label ema-label text-warning">Lower (1/φ)</label>
                                    <select class="form-select form-select-sm" id="fibLower">
                                        <option value="0.236">0.236</option>
                                        <option value="0.382">0.382</option>
                                        <option value="0.500">0.500</option>
                                        <option value="0.618" selected>0.618 (1/φ)</option>
                                        <option value="0.786">0.786</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="ema-grid-2 mb-2">
                            <div>
                                <label class="form-label ema-label">EMA Period</label>
                                <input type="number" class="form-control form-control-sm" id="emaPeriod" value="20" min="1" max="1000000" step="1">
                                <small class="text-muted ema-hint">Kecil = responsif, Besar = smooth</small>
                            </div>
                            <div>
                                <label class="form-label ema-label">Auto-Refresh (sec)</label>
                                <input type="number" class="form-control form-control-sm" id="refreshInterval" value="10" min="5" max="300">
                            </div>
                        </div>
                        <div class="ema-check-group">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="showEMA" checked>
                                <label class="form-check-label">Show EMA Line</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="showThresholds" checked>
                                <label class="form-check-label">Show Threshold Lines</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="useInitial100ForEma">
                                <label class="form-check-label">Use 100 Initial Points Baseline</label>
                            </div>
                        </div>
                        <small class="text-muted ema-hint">Baseline: EMA diambil dari 100 data pertama device. Jika off, gunakan EMA biasa.</small>
                    </div>
                    <!-- DOWNTIME TAB -->
                    <div class="tab-pane fade" id="downtimeTabContent" role="tabpanel">
                        <div class="ema-info-banner">
                            <i class="fas fa-info-circle"></i>
                            <strong>Downtime</strong> — periode listrik dimatikan. <span class="badge bg-secondary">DROP</span> ditahan,
                            <span class="badge bg-danger">OVERLOAD</span> → alert "listrik menyala saat jam mati",
                            <span class="badge bg-warning text-dark">Lower Line</span> disembunyikan.
                        </div>
                        <div class="mb-2">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="downtimeEnabled" style="width: 2.5em; height: 1.3em;">
                                <label class="form-check-label ema-label" for="downtimeEnabled">Aktifkan Downtime Period</label>
                            </div>
                        </div>
                        <div class="mb-2">
                            <label class="form-label ema-label">Preset Waktu</label>
                            <div class="ema-grid-presets">
                                <button type="button" class="btn w-100 preset-btn ema-preset-btn" data-start="22" data-end="6" data-desc="Shift Malam">
                                    <i class="fas fa-moon"></i><br><small>22:00-06:00</small>
                                </button>
                                <button type="button" class="btn w-100 preset-btn ema-preset-btn" data-start="12" data-end="13" data-desc="Istirahat Siang">
                                    <i class="fas fa-utensils"></i><br><small>12:00-13:00</small>
                                </button>
                                <button type="button" class="btn w-100 preset-btn ema-preset-btn" data-start="21" data-end="5" data-desc="Malam Awal">
                                    <i class="fas fa-cloud-moon"></i><br><small>21:00-05:00</small>
                                </button>
                                <button type="button" class="btn w-100 preset-btn ema-preset-btn" data-start="0" data-end="0" data-desc="Custom">
                                    <i class="fas fa-sliders-h"></i><br><small>Atur manual</small>
                                </button>
                            </div>
                        </div>
                        <div class="ema-grid-3 mb-2">
                            <div>
                                <label class="form-label ema-label">Jam Mulai</label>
                                <select class="form-select form-select-sm" id="downtimeStartHour"></select>
                            </div>
                            <div>
                                <label class="form-label ema-label">Jam Selesai</label>
                                <select class="form-select form-select-sm" id="downtimeEndHour"></select>
                            </div>
                            <div>
                                <label class="form-label ema-label">Durasi</label>
                                <div class="form-control form-control-sm bg-light text-center" id="downtimeDuration" readonly>8 jam</div>
                            </div>
                        </div>
                        <div class="mb-2">
                            <label class="form-label ema-label">Deskripsi</label>
                            <input type="text" class="form-control form-control-sm" id="downtimeDescription" placeholder="Contoh: Periode listrik sengaja dimatikan">
                        </div>
                        <div class="mb-2">
                            <label class="form-label ema-label"><i class="fas fa-clock"></i> Timeline</label>
                            <div class="position-relative" style="height: 24px; background: #28a745; border-radius: 4px; overflow: hidden;">
                                <div id="downtimeTimelineBar" style="position: absolute; top: 0; height: 100%; background: #343a40; transition: all 0.3s;"></div>
                            </div>
                            <div class="d-flex justify-content-between mt-1" style="font-size: 0.6rem; color: #6c757d;">
                                <span>00:00</span><span>06:00</span><span>12:00</span><span>18:00</span><span>24:00</span>
                            </div>
                        </div>
                        <div class="card border" id="downtimeStatusCard">
                            <div class="card-body text-center py-1">
                                <div id="downtimeCurrentStatus" class="fw-bold" style="font-size: 0.85rem;"><i class="fas fa-spinner fa-spin"></i> Memuat...</div>
                            </div>
                        </div>
                    </div>
                    <!-- DISPLAY TAB -->
                    <div class="tab-pane fade" id="displayTabContent" role="tabpanel">
                        <div class="ema-grid-2 mb-2">
                            <div>
                                <label class="form-label ema-label">Chart Data Points</label>
                                <input type="number" class="form-control form-control-sm" id="chartDataPoints" value="20" min="10" max="100">
                                <small class="text-muted ema-hint">Jumlah titik data (10-100)</small>
                            </div>
                            <div>
                                <label class="form-label ema-label">Grid Color</label>
                                <input type="color" class="form-control form-control-color form-control-sm" id="chartGridColor" value="#e0e0e0">
                            </div>
