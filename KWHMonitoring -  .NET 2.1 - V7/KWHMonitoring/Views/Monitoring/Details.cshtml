        // --- Compact Financial Metrics ---
        function updateDeviceFinancialMetrics(data) {
            var w = data.waste || {};
            var pc = data.periodComparison || {};
            var bp = data.billProjection || {};
            var lf = data.loadFactorInfo || {};
            var ue = data.unitEconomics || {};

            // Waste
            if (w.configured) {
                var wp = w.wastePercent || 0;
                var isHigh = wp > 5;
                var wCls = isHigh ? 'text-danger' : 'text-success';
                var cellCls = isHigh ? 'fin-critical' : 'fin-ok';
                $('#deviceFinWaste').attr('class', 'fin-metric ' + cellCls);
                $('#deviceFinWasteValue').attr('class', 'fin-metric-value ' + wCls).text(wp.toFixed(1) + '%' + (isHigh ? ' ' : ''));
                var subParts = [formatDecimal(w.wasteKwh || 0) + ' kWh', 'Rp ' + formatNumber(w.wasteCost || 0)];
                if (w.downtimeStart !== undefined) subParts.push(w.downtimeStart + '-' + w.downtimeEnd);
                if (isHigh) subParts.push('batas 5%');
                $('#deviceFinWasteSub').text(subParts.join(' · '));
            } else {
                $('#deviceFinWaste').attr('class', 'fin-metric');
                $('#deviceFinWasteValue').attr('class', 'fin-metric-value text-muted').text('—');
                $('#deviceFinWasteSub').text('Belum dikonfigurasi');
            }

            // MoM
            if (pc.momChangePercent || pc.momChangePercent === 0) {
                var mv = pc.momChangePercent || 0;
                var mUp = mv > 0;
                var mCls = mUp ? 'text-danger' : 'text-success';
                var mArr = mUp ? '▲' : '▼';
                var mCellCls = Math.abs(mv) > 20 ? 'fin-critical' : (Math.abs(mv) > 10 ? 'fin-warning' : (mUp ? '' : 'fin-ok'));
                $('#deviceFinMom').attr('class', 'fin-metric ' + mCellCls);
                $('#deviceFinMomValue').attr('class', 'fin-metric-value ' + mCls).text(mArr + ' ' + Math.abs(mv).toFixed(1) + '%');
                var momSub = (mUp ? 'Naik' : 'Turun') + ' ' + formatDecimal(Math.abs(pc.momChange || 0)) + ' kWh';
                if (pc.lastMonthKWh) momSub += ' (bln lalu: ' + formatDecimal(pc.lastMonthKWh) + ')';
                $('#deviceFinMomSub').text(momSub);
            } else if (pc.momChange || pc.momChange === 0) {
                var mv2 = pc.momChange || 0;
                var mUp2 = mv2 > 0;
                var mCls2 = mUp2 ? 'text-danger' : 'text-success';
                var mArr2 = mUp2 ? '▲' : '▼';
                $('#deviceFinMom').attr('class', 'fin-metric');
                $('#deviceFinMomValue').attr('class', 'fin-metric-value ' + mCls2).text(mArr2 + ' ' + Math.abs(mv2).toFixed(1) + '%');
                $('#deviceFinMomSub').text((mUp2 ? 'Naik' : 'Turun') + ' vs bulan lalu');
            } else {
                $('#deviceFinMom').attr('class', 'fin-metric');
                $('#deviceFinMomValue').attr('class', 'fin-metric-value text-muted').text('—');
                $('#deviceFinMomSub').text('');
            }

            // YoY
            if (pc.yoyChangePercent || pc.yoyChangePercent === 0) {
                var yv = pc.yoyChangePercent || 0;
                var yUp = yv > 0;
                var yCls = yUp ? 'text-danger' : 'text-success';
                var yArr = yUp ? '▲' : '▼';
                var yCellCls = Math.abs(yv) > 50 ? 'fin-critical' : (Math.abs(yv) > 20 ? 'fin-warning' : (yUp ? '' : 'fin-ok'));
                $('#deviceFinYoy').attr('class', 'fin-metric ' + yCellCls);
                $('#deviceFinYoyValue').attr('class', 'fin-metric-value ' + yCls).text(yArr + ' ' + Math.abs(yv).toFixed(1) + '%');
                var yoySub = (yUp ? 'Naik' : 'Turun') + ' ' + formatDecimal(Math.abs(pc.yoyChange || 0)) + ' kWh';
                if (pc.lastYearSameMonthKWh) yoySub += ' (thn lalu: ' + formatDecimal(pc.lastYearSameMonthKWh) + ')';
                $('#deviceFinYoySub').text(yoySub);
            } else if (pc.yoyChange || pc.yoyChange === 0) {
                var yv2 = pc.yoyChange || 0;
                var yUp2 = yv2 > 0;
                var yCls2 = yUp2 ? 'text-danger' : 'text-success';
                var yArr2 = yUp2 ? '▲' : '▼';
                $('#deviceFinYoy').attr('class', 'fin-metric');
                $('#deviceFinYoyValue').attr('class', 'fin-metric-value ' + yCls2).text(yArr2 + ' ' + Math.abs(yv2).toFixed(1) + '%');
                $('#deviceFinYoySub').text((yUp2 ? 'Naik' : 'Turun') + ' vs tahun lalu');
            } else {
                $('#deviceFinYoy').attr('class', 'fin-metric');
                $('#deviceFinYoyValue').attr('class', 'fin-metric-value text-muted').text('—');
                $('#deviceFinYoySub').text('');
            }

            // Bill Projection
            if (bp.projectedMonthKWh || bp.projectedMonthKWh === 0) {
                var isNearEom = (bp.daysRemaining || 0) <= 5;
                $('#deviceFinBill').attr('class', 'fin-metric' + (isNearEom ? ' fin-warning' : ''));
                $('#deviceFinBillValue').attr('class', 'fin-metric-value text-warning').text(formatDecimal(bp.projectedMonthKWh || 0) + ' kWh');
                var billSub = 'Rp ' + formatNumber(bp.projectedCost || 0);
                if (bp.daysElapsed && bp.daysRemaining) {
                    var avgDaily = (bp.projectedMonthKWh || 0) / (bp.daysElapsed + bp.daysRemaining);
                    billSub += ' · ' + formatDecimal(avgDaily) + ' kWh/hari';
                }
                billSub += ' · sisa ' + (bp.daysRemaining || 0) + ' hari';
                $('#deviceFinBillSub').text(billSub);
            } else {
                $('#deviceFinBill').attr('class', 'fin-metric');
                $('#deviceFinBillValue').attr('class', 'fin-metric-value text-muted').text('—');
                $('#deviceFinBillSub').text('');
            }

            // Load Factor — API returns 0-100 percentage
            // Thresholds: <30 Under-utilized, 30-80 Optimal, >80 High Risk
            if (lf.loadFactor || lf.loadFactor === 0) {
                var lfVal = lf.loadFactor || 0;
                var lfPct = lfVal.toFixed(1);
                var lfCls, lfLabel, lfCellCls;
                if (lfVal > 80) {
                    lfCls = 'text-danger'; lfLabel = 'Risiko Tinggi'; lfCellCls = 'fin-critical';
                } else if (lfVal < 30) {
                    lfCls = 'text-warning'; lfLabel = 'Under-utilized'; lfCellCls = 'fin-warning';
                } else {
                    lfCls = 'text-success'; lfLabel = 'Optimal'; lfCellCls = 'fin-ok';
                }
                $('#deviceFinLf').attr('class', 'fin-metric ' + lfCellCls);
                $('#deviceFinLfValue').attr('class', 'fin-metric-value ' + lfCls).text(lfPct + '%');
                var lfSub = lfLabel;
                if (lf.maxCapacity) lfSub += ' · Max ' + formatDecimal(lf.maxCapacity / 1000) + ' kVA';
                if (lf.status) lfSub += ' · ' + lf.status;
                $('#deviceFinLfSub').text(lfSub);
            } else if (lf.configured === false) {
                $('#deviceFinLf').attr('class', 'fin-metric');
                $('#deviceFinLfValue').attr('class', 'fin-metric-value text-muted').text('—');
                $('#deviceFinLfSub').text('Belum dikonfigurasi');
            } else {
                $('#deviceFinLf').attr('class', 'fin-metric');
                $('#deviceFinLfValue').attr('class', 'fin-metric-value text-muted').text('—');
                $('#deviceFinLfSub').text('');
            }

            // Unit Economics
            if ((ue.costPerM2 || ue.costPerM2 === 0) || (ue.costPerHour || ue.costPerHour === 0)) {
                var mainVal = '';
                if (ue.costPerM2) mainVal = 'Rp ' + formatNumber(ue.costPerM2) + '/m²';
                else if (ue.costPerHour) mainVal = 'Rp ' + formatNumber(ue.costPerHour) + '/jam';
                $('#deviceFinUeValue').attr('class', 'fin-metric-value').text(mainVal);
                var ueSub = [];
                if (ue.costPerM2 && ue.costPerHour) ueSub.push('Rp ' + formatNumber(ue.costPerHour) + '/jam');
                if (ue.surfaceArea) ueSub.push('Area: ' + formatDecimal(ue.surfaceArea) + ' m²');
                $('#deviceFinUeSub').text(ueSub.join(' · '));
                $('#deviceFinUe').attr('class', 'fin-metric');
            } else {
                $('#deviceFinUe').attr('class', 'fin-metric');
                $('#deviceFinUeValue').attr('class', 'fin-metric-value text-muted').text('—');
                $('#deviceFinUeSub').text('');
            }
        }

        // --- Anomaly Cost Impact ---
        function updateDeviceAnomalyCostUI(ac) {
            var $body = $('#deviceAnomalyCostBody');
            var totalCost = ac.estimatedCostImpact || ac.totalCost || 0;
            var totalAnomalies = ac.totalAnomalies || 0;
            var items = ac.anomalies || ac.topAnomalies || [];

            if (items.length === 0) {
                $body.html(
                    '<div class="text-center" style="font-size:0.8rem">' +
                        '<span class="text-muted">Dampak Biaya Anomali:</span> <strong class="text-primary">Rp ' + formatNumber(totalCost) + '</strong>' +
                        (totalAnomalies > 0 ? ' <span class="badge bg-secondary">' + totalAnomalies + ' anomali</span>' : '') +
                        '<div class="text-muted mt-1" style="font-size:0.7rem">Tidak ada anomali aktif</div>' +
                    '</div>'
                );
                return;
            }

            var html = '<div class="mb-2" style="font-size:0.8rem"><span class="text-muted">Total Dampak:</span> <strong class="text-danger">Rp ' + formatNumber(totalCost) + '</strong>';
            if (totalAnomalies > 0) html += ' <span class="badge bg-danger">' + totalAnomalies + ' anomali</span>';
            html += '</div>';
            html += '<div style="font-size:0.75rem">';

            items.forEach(function(a, i) {
                if (i >= 5) return;
                var icon = (a.anomalyType || a.type) === 'OVERLOAD' ? 'fa-arrow-up text-danger' : 'fa-arrow-down text-warning';
                var cost = a.estimatedCost || a.costImpact || 0;
                var name = a.deviceName || a.deviceKey || '—';
                var severity = a.severity || '';
                var sevBadge = severity === 'high' ? ' <span class="badge bg-danger">HIGH</span>' : (severity === 'medium' ? ' <span class="badge bg-warning text-dark">MED</span>' : '');
                html += '<div class="anomaly-cost-item d-flex justify-content-between align-items-center py-1' + (i < items.length - 1 && i < 4 ? ' border-bottom' : '') + '">' +
                    '<span class="anomaly-cost-name"><i class="fas ' + icon + '"></i> ' + name + sevBadge + '</span>' +
                    '<span class="text-danger fw-bold text-nowrap ms-2">Rp ' + formatNumber(cost) + '</span>' +
                '</div>';
            });

            html += '</div>';
            $body.html(html);
        }

        // ============================================
        // DAILY REPORT (auto-generated analysis)
        // ============================================
        function generateDeviceDailyReport() {
            var $body = $('#deviceDailyReportBody');
            if (!$body.length) return;

            var d = lastDeviceFinancialData;
            if (!d) {
                $body.html('<div class="text-center text-muted py-2" style="font-size:0.8rem">Data belum tersedia</div>');
                return;
            }

            var todayKwh = (d.today && d.today.total) || 0;
            var todayAvgPerHour = (d.today && d.today.avgPerHour) || 0;
            var monthKwh = (d.month && d.month.total) || 0;
            var monthAvgPerDay = (d.month && d.month.avgPerDay) || 0;
            var tariff = d.tariffPerKWh || 1500;
            var wbpLwbp = d.wbpLwbp || {};
            var budget = d.budget || {};
            var waste = d.waste || {};
            var pc = d.periodComparison || {};
            var bp = d.billProjection || {};
            var lf = d.loadFactorInfo || {};
            var ac = d.anomalyCostImpact || {};

            var todayCost = todayKwh * tariff;
            var tariffType = wbpLwbp.configured ? 'WBP/LWBP' : 'Flat';
            if (wbpLwbp.configured && todayKwh > 0) {
                var wbpKwh = wbpLwbp.wbpKwh || 0;
                var lwbpKwh = wbpLwbp.lwbpKwh || 0;
                var wbpCost = wbpLwbp.wbpCost || 0;
                var lwbpCost = wbpLwbp.lwbpCost || 0;
                todayCost = wbpCost + lwbpCost;
            }

            // Peak hour
            var peakHourKwh = (d.today && d.today.peakHour) || 0;
            var peakHourTime = (d.today && d.today.peakHourTime) || '-';
            var peakHourCost = peakHourKwh * tariff;

            // Days in current month
            var now = new Date();
            var daysInMonth = new Date(now.getFullYear(), now.getMonth() + 1, 0).getDate();
            var currentDay = now.getDate();

            // --- METRIC BLOCKS ---
            var avgDailyKwh = monthAvgPerDay || (currentDay > 0 ? monthKwh / currentDay : 0);
            var vsAvgPct = avgDailyKwh > 0 ? ((todayKwh - avgDailyKwh) / avgDailyKwh * 100) : 0;

            var html = '';
            html += '<div class="fin-metric-grid" style="margin-bottom:8px">';

            // Konsumsi
            var konsCls = vsAvgPct > 20 ? 'fin-critical' : (vsAvgPct < -20 ? 'fin-ok' : '');
            html += '<div class="fin-metric ' + konsCls + '">';
            html += '<div class="fin-metric-label"><i class="fas fa-bolt text-primary"></i> Konsumsi</div>';
            html += '<div class="fin-metric-value">' + formatDecimal(todayKwh) + ' kWh</div>';
            html += '<div class="fin-metric-sub">vs rata² ' + formatDecimal(avgDailyKwh) + ' kWh/hari';
            if (vsAvgPct !== 0) {
                var vsCls = vsAvgPct > 0 ? 'text-danger' : 'text-success';
                html += ' <span class="' + vsCls + '">(' + (vsAvgPct > 0 ? '+' : '') + vsAvgPct.toFixed(1) + '%)</span>';
            }
            html += '</div></div>';

            // Estimasi Biaya
            html += '<div class="fin-metric">';
            html += '<div class="fin-metric-label"><i class="fas fa-money-bill-wave text-success"></i> Estimasi Biaya</div>';
            html += '<div class="fin-metric-value text-primary">Rp ' + formatNumber(todayCost) + '</div>';
            html += '<div class="fin-metric-sub">Tarif ' + tariffType + ' · Rp ' + formatNumber(tariff) + '/kWh</div>';
            html += '</div>';

            // Jam Puncak
            html += '<div class="fin-metric">';
            html += '<div class="fin-metric-label"><i class="fas fa-clock text-warning"></i> Jam Puncak</div>';
            html += '<div class="fin-metric-value">' + formatDecimal(peakHourKwh) + ' kWh</div>';
            html += '<div class="fin-metric-sub">Jam ' + peakHourTime + ' · Rp ' + formatNumber(peakHourCost) + '</div>';
            html += '</div>';

            html += '</div>';

            // --- INSIGHT SECTION ---
            html += '<div class="daily-report-insights">';
            html += '<div class="text-muted mb-1"><i class="fas fa-lightbulb text-warning"></i> <strong>Insight</strong></div>';

            // 1. Consumption vs average
            if (vsAvgPct > 20) {
                html += '<div class="text-danger mb-1"><i class="fas fa-arrow-up"></i> Konsumsi hari ini ' + vsAvgPct.toFixed(1) + '% di atas rata-rata harian</div>';
            } else if (vsAvgPct < -20) {
                html += '<div class="text-success mb-1"><i class="fas fa-arrow-down"></i> Konsumsi hari ini ' + Math.abs(vsAvgPct).toFixed(1) + '% di bawah rata-rata harian (hemat)</div>';
            } else {
                html += '<div class="text-muted mb-1"><i class="fas fa-equals"></i> Konsumsi hari ini sejalan dengan rata-rata harian</div>';
            }

            // 2. WBP ratio optimization
            if (wbpLwbp.configured) {
                var wbpKwh2 = wbpLwbp.wbpKwh || 0;
                var lwbpKwh2 = wbpLwbp.lwbpKwh || 0;
                var totalWbpLwbp = wbpKwh2 + lwbpKwh2;
                if (totalWbpLwbp > 0) {
                    var wbpRatio = (wbpKwh2 / totalWbpLwbp) * 100;
                    if (wbpRatio > 40) {
                        html += '<div class="text-danger mb-1"><i class="fas fa-exchange-alt"></i> Rasio WBP ' + wbpRatio.toFixed(1) + '% — pertimbangkan geser beban ke jam LWBP untuk efisiensi</div>';
                    } else {
                        html += '<div class="text-success mb-1"><i class="fas fa-check-circle"></i> Rasio WBP ' + wbpRatio.toFixed(1) + '% — distribusi WBP/LWBP baik</div>';
                    }
                }
            } else {
                html += '<div class="text-muted mb-1"><i class="fas fa-tag"></i> Tarif flat — konfigurasi WBP/LWBP untuk optimasi biaya</div>';
            }

            // 3. Budget pace
            if (budget.configured) {
                var budgetKwh = budget.budgetKWH || budget.budgetKWh || 0;
                var dailyBudget = daysInMonth > 0 ? budgetKwh / daysInMonth : 0;
                if (dailyBudget > 0) {
                    var budgetPacePct = (todayKwh / dailyBudget) * 100;
                    if (budgetPacePct > 110) {
                        html += '<div class="text-danger mb-1"><i class="fas fa-wallet"></i> Pace harian ' + budgetPacePct.toFixed(0) + '% dari budget (target ' + formatDecimal(dailyBudget) + ' kWh/hari) — over pace</div>';
                    } else if (budgetPacePct > 90) {
                        html += '<div class="text-warning mb-1"><i class="fas fa-wallet"></i> Pace harian ' + budgetPacePct.toFixed(0) + '% dari budget — mendekati batas</div>';
                    } else {
                        html += '<div class="text-success mb-1"><i class="fas fa-wallet"></i> Pace harian ' + budgetPacePct.toFixed(0) + '% dari budget — sesuai target</div>';
                    }
                }
            }

            // 4. Waste detection
            if (waste.configured) {
                var wp = waste.wastePercent || 0;
                if (wp > 5) {
                    html += '<div class="text-danger mb-1"><i class="fas fa-exclamation-triangle"></i> Waste ' + wp.toFixed(1) + '% — ' + formatDecimal(waste.wasteKwh || 0) + ' kWh terbuang (Rp ' + formatNumber(waste.wasteCost || 0) + ')</div>';
                } else {
                    html += '<div class="text-success mb-1"><i class="fas fa-check-circle"></i> Waste ' + wp.toFixed(1) + '% — dalam batas normal</div>';
                }
            }

            // 5. Load Factor status
            if (lf.loadFactor || lf.loadFactor === 0) {
                var lfVal = lf.loadFactor || 0;
                if (lfVal > 80) {
                    html += '<div class="text-danger mb-1"><i class="fas fa-tachometer-alt"></i> Load Factor ' + lfVal.toFixed(1) + '% — Risiko Tinggi, pertimbangkan redistribusi beban</div>';
                } else if (lfVal < 30) {
                    html += '<div class="text-warning mb-1"><i class="fas fa-tachometer-alt"></i> Load Factor ' + lfVal.toFixed(1) + '% — Under-utilized, potensi efisiensi kapasitas</div>';
                } else {
                    html += '<div class="text-success mb-1"><i class="fas fa-tachometer-alt"></i> Load Factor ' + lfVal.toFixed(1) + '% — Optimal</div>';
                }
            }

            // 6. Anomaly impact
            var anomalyCost = ac.estimatedCostImpact || ac.totalCost || 0;
            var anomalyCount = ac.totalAnomalies || 0;
            if (anomalyCount > 0 && anomalyCost > 0) {
                html += '<div class="text-warning mb-1"><i class="fas fa-exclamation-circle"></i> ' + anomalyCount + ' anomali aktif — dampak Rp ' + formatNumber(anomalyCost) + '</div>';
            } else {
                html += '<div class="text-muted mb-1"><i class="fas fa-shield-alt"></i> Tidak ada anomali aktif</div>';
            }

            // 7. Tariff type indicator
            if (wbpLwbp.configured) {
                var wbpT = wbpLwbp.tariffWBP || 0;
                var lwbpT = wbpLwbp.tariffLWBP || 0;
                html += '<div class="text-muted mb-1"><i class="fas fa-tags"></i> Tarif WBP/LWBP — WBP Rp ' + formatNumber(wbpT) + '/kWh, LWBP Rp ' + formatNumber(lwbpT) + '/kWh</div>';
            } else {
                html += '<div class="text-muted mb-1"><i class="fas fa-tag"></i> Tarif flat Rp ' + formatNumber(tariff) + '/kWh</div>';
            }

            // 8. MoM comparison
            if (pc.momChangePercent || pc.momChangePercent === 0) {
                var mv = pc.momChangePercent || 0;
                if (Math.abs(mv) >= 0.1) {
                    var momCls = mv > 0 ? 'text-danger' : 'text-success';
                    var momArr = mv > 0 ? '▲' : '▼';
                    html += '<div class="' + momCls + ' mb-1"><i class="fas fa-exchange-alt"></i> MoM ' + momArr + ' ' + Math.abs(mv).toFixed(1) + '% vs bulan lalu</div>';
                }
            }

            // 9. Bill projection vs budget
            if (bp.projectedMonthKWh || bp.projectedMonthKWh === 0) {
                var projKwh = bp.projectedMonthKWh || 0;
                var projCost = bp.projectedCost || 0;
                if (budget.configured) {
                    var budgetKwh2 = budget.budgetKWH || budget.budgetKWh || 0;
                    var budgetCost2 = budget.budgetCost || 0;
                    if (budgetKwh2 > 0) {
                        var projPct = (projKwh / budgetKwh2) * 100;
                        if (projPct > 100) {
                            html += '<div class="text-danger mb-1"><i class="fas fa-file-invoice-dollar"></i> Proyeksi ' + formatDecimal(projKwh) + ' kWh (Rp ' + formatNumber(projCost) + ') — melebihi budget ' + formatDecimal(budgetKwh2) + ' kWh</div>';
                        } else {
                            html += '<div class="text-success mb-1"><i class="fas fa-file-invoice-dollar"></i> Proyeksi ' + formatDecimal(projKwh) + ' kWh (Rp ' + formatNumber(projCost) + ') — dalam budget</div>';
                        }
                    }
                } else {
                    html += '<div class="text-muted mb-1"><i class="fas fa-file-invoice-dollar"></i> Proyeksi bulan ini: ' + formatDecimal(projKwh) + ' kWh · Rp ' + formatNumber(projCost) + '</div>';
                }
            }

            html += '</div>';

            $body.html(html);
        }

        // ============================================
        // RENDER ALL DEVICE REPORTS
        // ============================================
        function renderAllDeviceReports() {
            generateDeviceDailyReport();
            generateDeviceMonthlyReport();
            generateDeviceYearlyReport();
        }

        // ============================================
        // MONTHLY REPORT (per-device)
        // ============================================
        function generateDeviceMonthlyReport() {
            var $body = $('#deviceMonthlyReportBody');
            if (!$body.length) return;

            var d = lastDeviceFinancialData;
            if (!d) {
                $body.html('<div class="text-center text-muted py-2" style="font-size:0.8rem">Data belum tersedia</div>');
                return;
            }

            var monthKwh = (d.month && d.month.total) || 0;
            var monthAvgPerDay = (d.month && d.month.avgPerDay) || 0;
            var tariff = d.tariffPerKWh || 1500;
            var wbpLwbp = d.wbpLwbp || {};
            var budget = d.budget || {};
            var waste = d.waste || {};
            var bp = d.billProjection || {};
            var lf = d.loadFactorInfo || {};
            var ac = d.anomalyCostImpact || {};
            var pc = d.periodComparison || {};
            var ue = d.unitEconomics || {};

            var now = new Date();
            var dayOfMonth = now.getDate();
            var daysInMonth = new Date(now.getFullYear(), now.getMonth() + 1, 0).getDate();
            var budgetKwh = budget.budgetKWH || budget.budgetKWh || 0;

            // Actual cost
            var actualCost = 0;
            if (wbpLwbp.configured) {
                actualCost = (wbpLwbp.wbpCost || 0) + (wbpLwbp.lwbpCost || 0);
            } else {
                actualCost = Math.round(monthKwh * tariff);
            }

            // Peak day from daily data
            var dailyData = (d.month && d.month.dailyData) || [];
            var peakDayInfo = dailyData.length > 0 ? dailyData.reduce(function(max, dd) { return dd.energy > max.energy ? dd : max; }, { energy: 0, timeLabel: '-' }) : { energy: 0, timeLabel: '-' };

            var projKwh = bp.projectedMonthKWh || 0;
            var projCost = bp.projectedCost || 0;

            var html = '';
            html += '<div class="fin-metric-grid" style="margin-bottom:8px">';

            // Konsumsi Bulan
            html += '<div class="fin-metric"><div class="fin-metric-label"><i class="fas fa-calendar-week text-primary"></i> Konsumsi Bulan</div>';
            html += '<div class="fin-metric-value">' + formatDecimal(monthKwh) + ' kWh</div>';
            html += '<div class="fin-metric-sub">Rata² ' + formatDecimal(monthAvgPerDay) + ' kWh/hari · Hari ke-' + dayOfMonth + '</div></div>';

            // Biaya Aktual
            html += '<div class="fin-metric"><div class="fin-metric-label"><i class="fas fa-coins text-warning"></i> Biaya Aktual</div>';
            html += '<div class="fin-metric-value">Rp ' + formatNumber(actualCost) + '</div>';
            html += '<div class="fin-metric-sub">' + (wbpLwbp.configured ? 'WBP/LWBP' : 'Flat') + ' · Rp ' + formatNumber(tariff) + '/kWh</div></div>';

            // Hari Puncak
            html += '<div class="fin-metric"><div class="fin-metric-label"><i class="fas fa-arrow-up text-info"></i> Hari Puncak</div>';
            html += '<div class="fin-metric-value">' + (peakDayInfo.timeLabel || '-') + '</div>';
            html += '<div class="fin-metric-sub">' + formatDecimal(peakDayInfo.energy) + ' kWh</div></div>';

            // Proyeksi
            html += '<div class="fin-metric"><div class="fin-metric-label"><i class="fas fa-chart-line text-warning"></i> Proyeksi</div>';
            html += '<div class="fin-metric-value">' + formatDecimal(projKwh) + ' kWh</div>';
            html += '<div class="fin-metric-sub">Rp ' + formatNumber(projCost) + ' · Sisa ' + (bp.daysRemaining || 0) + ' hari</div></div>';

            // Budget
            html += '<div class="fin-metric"><div class="fin-metric-label"><i class="fas fa-wallet text-success"></i> Budget</div>';
            if (budget.configured && budgetKwh > 0) {
                var budgetPct = Math.round(monthKwh / budgetKwh * 100);
                var bCls = budgetPct > 100 ? 'text-danger' : (budgetPct > 80 ? 'text-warning' : 'text-success');
                html += '<div class="fin-metric-value ' + bCls + '">' + budgetPct + '%</div>';
                html += '<div class="fin-metric-sub">Budget ' + formatDecimal(budgetKwh) + ' kWh</div></div>';
            } else {
                html += '<div class="fin-metric-value text-muted">—</div>';
                html += '<div class="fin-metric-sub">Belum dikonfigurasi</div></div>';
            }

            // Load Factor
            html += '<div class="fin-metric"><div class="fin-metric-label"><i class="fas fa-tachometer-alt text-warning"></i> Load Factor</div>';
            if (lf.loadFactor || lf.loadFactor === 0) {
                var lfVal = lf.loadFactor || 0;
                var lfCls = lfVal > 80 ? 'text-danger' : (lfVal < 30 ? 'text-warning' : 'text-success');
                html += '<div class="fin-metric-value ' + lfCls + '">' + lfVal.toFixed(1) + '%</div>';
                html += '<div class="fin-metric-sub">' + (lf.status || 'N/A') + '</div></div>';
            } else {
                html += '<div class="fin-metric-value text-muted">—</div>';
                html += '<div class="fin-metric-sub">Belum dikonfigurasi</div></div>';
            }

            html += '</div>';

            // Monthly insights
            html += '<div class="daily-report-insights">';
            html += '<div class="text-muted mb-1"><i class="fas fa-lightbulb text-warning"></i> <strong>Insight Bulanan</strong></div>';
            var insights = [];

            // MoM
            if (pc.momChangePercent !== undefined && pc.lastMonthKWh > 0) {
                var momArr = pc.momChangePercent > 0 ? '▲' : '▼';
                var momCls = pc.momChangePercent > 10 ? 'text-danger' : (pc.momChangePercent < -10 ? 'text-success' : '');
                insights.push('<span class="' + momCls + '">' + momArr + ' MoM ' + Math.abs(pc.momChangePercent).toFixed(1) + '% vs bulan lalu (' + formatDecimal(pc.lastMonthKWh) + ' kWh)</span>');
            }

            // YoY
            if (pc.yoyChangePercent !== undefined && pc.lastYearSameMonthKWh > 0) {
                var yoyArr = pc.yoyChangePercent > 0 ? '▲' : '▼';
                var yoyCls = pc.yoyChangePercent > 20 ? 'text-danger' : (pc.yoyChangePercent < -20 ? 'text-success' : '');
                insights.push('<span class="' + yoyCls + '">' + yoyArr + ' YoY ' + Math.abs(pc.yoyChangePercent).toFixed(1) + '% vs tahun lalu bulan yang sama</span>');
            }

            // WBP/LWBP split
            if (wbpLwbp.configured) {
                var wbpKwh = wbpLwbp.wbpKwh || 0;
                var lwbpKwh = wbpLwbp.lwbpKwh || 0;
                var wbpTotal = wbpKwh + lwbpKwh;
                if (wbpTotal > 0) {
                    var wbpRatio = (wbpKwh / wbpTotal * 100).toFixed(1);
                    insights.push(' WBP ' + wbpRatio + '% (' + formatDecimal(wbpKwh) + ' kWh) · LWBP ' + (100 - parseFloat(wbpRatio)).toFixed(1) + '% (' + formatDecimal(lwbpKwh) + ' kWh)');
                    if (parseFloat(wbpRatio) > 40) {
                        insights.push('<span class="text-danger">Rasio WBP tinggi — pertimbangkan geser beban ke jam LWBP</span>');
                    }
                }
            }

            // Waste
            if (waste.configured && waste.wastePercent > 0) {
                if (waste.wastePercent > 5) {
                    insights.push('<span class="text-danger"> Waste ' + waste.wastePercent.toFixed(1) + '% = ' + formatDecimal(waste.wasteKwh || 0) + ' kWh (Rp ' + formatNumber(waste.wasteCost || 0) + ')</span>');
                } else {
                    insights.push(' Waste ' + waste.wastePercent.toFixed(1) + '% — dalam batas normal');
                }
            }

            // Projection vs budget
            if (projKwh > 0 && budget.configured && budgetKwh > 0) {
                if (projKwh > budgetKwh) {
                    insights.push('<span class="text-danger"> Proyeksi ' + formatDecimal(projKwh) + ' kWh melebihi budget ' + formatDecimal(budgetKwh) + ' kWh — perlu penghematan ' + formatDecimal(projKwh - budgetKwh) + ' kWh</span>');
                } else {
                    insights.push('<span class="text-success"> Proyeksi ' + formatDecimal(projKwh) + ' kWh — dalam budget, sisa ' + formatDecimal(budgetKwh - projKwh) + ' kWh</span>');
                }
            }

            // Unit Economics
            if (ue && ue.configured && ue.costPerM2 > 0) {
                insights.push(' Biaya per m²: Rp ' + formatNumber(ue.costPerM2) + ' · per jam: Rp ' + formatNumber(ue.costPerHour || 0));
            }

            // Anomaly
            if (ac.totalAnomalies > 0) {
                insights.push('<span class="text-danger"> ' + ac.totalAnomalies + ' anomali bulan ini · dampak Rp ' + formatNumber(ac.estimatedCostImpact || 0) + '</span>');
            }

            if (insights.length === 0) {
                insights.push('<span class="text-muted">Data belum cukup untuk analisa bulanan</span>');
            }

            insights.forEach(function(insight) {
                html += '<div style="padding:2px 0; line-height:1.4">' + insight + '</div>';
            });
            html += '</div>';
            $body.html(html);
        }

        // ============================================
        // YEARLY REPORT (per-device)
        // ============================================
        function generateDeviceYearlyReport() {
            var $body = $('#deviceYearlyReportBody');
            if (!$body.length) return;

            var d = lastDeviceFinancialData;
            if (!d) {
                $body.html('<div class="text-center text-muted py-2" style="font-size:0.8rem">Data belum tersedia</div>');
                return;
            }

            var yearKwh = (d.year && d.year.total) || 0;
            var yearAvgPerMonth = (d.year && d.year.avgPerMonth) || 0;
            var tariff = d.tariffPerKWh || 1500;
            var wbpLwbp = d.wbpLwbp || {};
            var budget = d.budget || {};
            var waste = d.waste || {};
            var pc = d.periodComparison || {};

            var monthKwh = (d.month && d.month.total) || 0;
            var currentMonth = new Date().getMonth() + 1;
            var yearCost = Math.round(yearKwh * tariff);
            if (wbpLwbp.configured) {
                yearCost = Math.round((wbpLwbp.wbpCost || 0) + (wbpLwbp.lwbpCost || 0));
                if (yearKwh > 0) yearCost = Math.round(((wbpLwbp.wbpCost || 0) + (wbpLwbp.lwbpCost || 0)) / monthKwh * yearKwh);
            }

            // Monthly data for peak/best
            var monthlyData = (d.year && d.year.monthlyData) || [];
            var peakMonthInfo = monthlyData.length > 0 ? monthlyData.reduce(function(max, m) { return m.energy > max.energy ? m : max; }, { energy: 0, timeLabel: '-' }) : { energy: 0, timeLabel: '-' };
            var bestMonth = monthlyData.length > 0 ? monthlyData.reduce(function(min, m) { return m.energy > 0 && m.energy < min.energy ? m : min; }, { energy: Infinity, timeLabel: '-' }) : null;

            // Yearly budget
            var budgetKwh = budget.budgetKWH || budget.budgetKWh || 0;
            var yearlyBudget = budget.configured && budgetKwh > 0 ? budgetKwh * 12 : 0;

            var html = '';
            html += '<div class="fin-metric-grid" style="margin-bottom:8px">';

            // Total Tahun
            html += '<div class="fin-metric"><div class="fin-metric-label"><i class="fas fa-calendar text-primary"></i> Total Tahun</div>';
            html += '<div class="fin-metric-value">' + formatDecimal(yearKwh) + ' kWh</div>';
            html += '<div class="fin-metric-sub">Rata² ' + formatDecimal(yearAvgPerMonth) + ' kWh/bulan · Bulan ke-' + currentMonth + '</div></div>';

            // Biaya Tahunan
            html += '<div class="fin-metric"><div class="fin-metric-label"><i class="fas fa-coins text-warning"></i> Biaya Tahunan</div>';
            html += '<div class="fin-metric-value">Rp ' + formatNumber(yearCost) + '</div>';
            html += '<div class="fin-metric-sub">Rata² Rp ' + formatNumber(Math.round(yearCost / Math.max(currentMonth, 1))) + '/bulan</div></div>';

            // Bulan Puncak
            html += '<div class="fin-metric"><div class="fin-metric-label"><i class="fas fa-arrow-up text-danger"></i> Bulan Puncak</div>';
            html += '<div class="fin-metric-value">' + (peakMonthInfo.timeLabel || '-') + '</div>';
            html += '<div class="fin-metric-sub">' + formatDecimal(peakMonthInfo.energy) + ' kWh</div></div>';

            // Bulan Terendah
            html += '<div class="fin-metric"><div class="fin-metric-label"><i class="fas fa-arrow-down text-success"></i> Bulan Terendah</div>';
            if (bestMonth && bestMonth.energy > 0 && bestMonth.energy < Infinity) {
                html += '<div class="fin-metric-value">' + bestMonth.timeLabel + '</div>';
                html += '<div class="fin-metric-sub">' + formatDecimal(bestMonth.energy) + ' kWh</div></div>';
            } else {
                html += '<div class="fin-metric-value text-muted">—</div>';
                html += '<div class="fin-metric-sub">Data belum cukup</div></div>';
            }

            // YoY
            html += '<div class="fin-metric"><div class="fin-metric-label"><i class="fas fa-sync-alt text-info"></i> YoY</div>';
            if (pc.yoyChangePercent !== undefined && pc.lastYearSameMonthKWh > 0) {
                var yoyArr = pc.yoyChangePercent > 0 ? '▲' : '▼';
                var yoyCls = pc.yoyChangePercent > 20 ? 'text-danger' : (pc.yoyChangePercent < -20 ? 'text-success' : '');
                html += '<div class="fin-metric-value ' + yoyCls + '">' + yoyArr + ' ' + Math.abs(pc.yoyChangePercent).toFixed(1) + '%</div>';
                html += '<div class="fin-metric-sub">vs bulan sama tahun lalu</div></div>';
            } else {
                html += '<div class="fin-metric-value text-muted">—</div>';
                html += '<div class="fin-metric-sub">Data tahun lalu belum tersedia</div></div>';
            }

            // Budget Tahunan
            html += '<div class="fin-metric"><div class="fin-metric-label"><i class="fas fa-wallet text-success"></i> Budget Tahunan</div>';
            if (yearlyBudget > 0) {
                var yBudgetPct = Math.round(yearKwh / yearlyBudget * 100);
                var ybCls = yBudgetPct > 100 ? 'text-danger' : (yBudgetPct > 80 ? 'text-warning' : 'text-success');
                html += '<div class="fin-metric-value ' + ybCls + '">' + yBudgetPct + '%</div>';
                html += '<div class="fin-metric-sub">Est. ' + formatDecimal(yearlyBudget) + ' kWh/tahun</div></div>';
            } else {
                html += '<div class="fin-metric-value text-muted">—</div>';
                html += '<div class="fin-metric-sub">Belum dikonfigurasi</div></div>';
            }

            html += '</div>';

            // Yearly insights
            html += '<div class="daily-report-insights">';
            html += '<div class="text-muted mb-1"><i class="fas fa-lightbulb text-warning"></i> <strong>Insight Tahunan</strong></div>';
            var insights = [];

            // Average costs
            var daysThisYear = Math.floor((new Date() - new Date(new Date().getFullYear(), 0, 1)) / 86400000) + 1;
            var avgDailyCost = daysThisYear > 0 ? Math.round(yearCost / daysThisYear) : 0;
            insights.push(' Rata-rata biaya harian: Rp ' + formatNumber(avgDailyCost) + ' · Bulanan: Rp ' + formatNumber(Math.round(yearCost / Math.max(currentMonth, 1))));

            // YoY trend
            if (pc.yoyChangePercent !== undefined && pc.lastYearSameMonthKWh > 0) {
                if (pc.yoyChangePercent > 20) {
                    insights.push('<span class="text-danger"> Tren naik signifikan — ' + Math.abs(pc.yoyChangePercent).toFixed(1) + '% lebih tinggi dari tahun lalu</span>');
                } else if (pc.yoyChangePercent < -20) {
                    insights.push('<span class="text-success"> Tren turun — ' + Math.abs(pc.yoyChangePercent).toFixed(1) + '% lebih rendah dari tahun lalu</span>');
                } else {
                    insights.push('Konsumsi relatif stabil vs tahun lalu (selisih ' + Math.abs(pc.yoyChangePercent || 0).toFixed(1) + '%)');
                }
            }

            // Peak vs avg
            if (peakMonthInfo.energy > 0 && yearAvgPerMonth > 0) {
                var peakVsAvg = Math.round(peakMonthInfo.energy / yearAvgPerMonth * 100 - 100);
                if (peakVsAvg > 50) {
                    insights.push('<span class="text-warning"> Bulan puncak ' + peakVsAvg + '% di atas rata-rata — pertimbangkan penjadwalan ulang beban</span>');
                }
            }

            // WBP contribution
            if (wbpLwbp.configured && (wbpLwbp.wbpKwh + wbpLwbp.lwbpKwh) > 0) {
                var wbpTotal2 = (wbpLwbp.wbpKwh || 0) + (wbpLwbp.lwbpKwh || 0);
                var wbpPct2 = ((wbpLwbp.wbpKwh || 0) / wbpTotal2 * 100).toFixed(1);
                var lwbpPct2 = (100 - parseFloat(wbpPct2)).toFixed(1);
                insights.push(' Proporsi WBP ' + wbpPct2 + '% · LWBP ' + lwbpPct2 + '%');
            }

            // Waste annualized
            if (waste.configured && waste.wastePercent > 0) {
                var annualWasteKWh = (waste.wasteKwh || 0) * 12;
                var annualWasteCost = (waste.wasteCost || 0) * 12;
                insights.push('<span class="' + (waste.wastePercent > 5 ? 'text-danger' : '') + '"> Waste ' + waste.wastePercent.toFixed(1) + '% · Estimasi tahunan: ' + formatDecimal(annualWasteKWh) + ' kWh (Rp ' + formatNumber(annualWasteCost) + ')</span>');
            }

            // Budget pace
            if (yearlyBudget > 0) {
                var yBudgetPct2 = Math.round(yearKwh / yearlyBudget * 100);
                var expectedPctByNow = Math.round(currentMonth / 12 * 100);
                if (yBudgetPct2 > expectedPctByNow + 10) {
                    insights.push('<span class="text-danger"> Penggunaan ' + yBudgetPct2 + '% dari budget tahunan, padahal baru ' + expectedPctByNow + '% waktu — over pace</span>');
                } else {
                    insights.push('<span class="text-success"> Penggunaan ' + yBudgetPct2 + '% dari budget tahunan · Pace ' + expectedPctByNow + '% — sesuai target</span>');
                }
            }

            // Projection to year end
            if (yearKwh > 0 && currentMonth > 1) {
                var projectedYearKwh = Math.round(yearKwh / currentMonth * 12);
                var projectedYearCost = Math.round(projectedYearKwh * tariff);
                insights.push(' Proyeksi akhir tahun: ' + formatDecimal(projectedYearKwh) + ' kWh (Rp ' + formatNumber(projectedYearCost) + ')');
            }

            if (insights.length === 0) {
                insights.push('<span class="text-muted">Data belum cukup untuk analisa tahunan</span>');
            }

            insights.forEach(function(insight) {
                html += '<div style="padding:2px 0; line-height:1.4">' + insight + '</div>';
            });
            html += '</div>';
            $body.html(html);
        }

