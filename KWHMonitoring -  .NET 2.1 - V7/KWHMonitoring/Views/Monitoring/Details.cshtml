        function renderDeviceCostProjection() {
            var d = lastDeviceFinancialData;
            if (!d) return;
            if (activeDeviceCostProjectionTab === 'monthly') renderDeviceMonthlyCostProjection(d);
            else renderDeviceYearlyCostProjection(d);
        }

        function calculateCostPerKWh(d) {
            var monthKwh = (d.month && d.month.total) || 0;
            var monthActualCost = d.budget && d.budget.actualCost || 0;
            var tariff = d.tariffPerKWh || 1500;
            if (monthActualCost === 0 && monthKwh > 0) monthActualCost = Math.round(monthKwh * tariff);
            return monthKwh > 0 ? monthActualCost / monthKwh : tariff;
        }

        function renderDeviceMonthlyCostProjection(d) {
            var $canvas = $('#deviceCostProjectionChart');
            var $footer = $('#deviceCostProjectionFooter');

            var now = new Date();
            var dayOfMonth = now.getDate();
            var daysInMonth = new Date(now.getFullYear(), now.getMonth() + 1, 0).getDate();

            var dailyData = (d.month && d.month.dailyData) || [];
            var budget = d.budget || {};
            var costPerKWh = calculateCostPerKWh(d);

            var dailyCost = new Array(daysInMonth).fill(0);
            dailyData.forEach(function(dd) { var idx = (dd.sortKey || 0) - 1; if (idx >= 0 && idx < daysInMonth) dailyCost[idx] = Math.round((dd.energy || 0) * costPerKWh); });

            var cumCost = 0, cumProjCost = 0;
            var costCum = [], projCostCum = [];
            for (var i = 0; i < daysInMonth; i++) {
                if (i < dayOfMonth) { cumCost += dailyCost[i]; costCum.push(cumCost); projCostCum.push(cumCost); }
                else { costCum.push(null); var avg = dayOfMonth > 0 ? cumCost / dayOfMonth : 0; cumProjCost += avg; projCostCum.push(cumCost + cumProjCost); }
            }
            var totalProjMonthCost = cumCost + (dayOfMonth > 0 ? cumCost / dayOfMonth : 0) * (daysInMonth - dayOfMonth);

            var budgetKwh = budget.budgetKWH || budget.budgetKWh || 0;
            var budgetCostPerDay = budgetKwh > 0 ? (budgetKwh * costPerKWh) / daysInMonth : 0;
            var monthlyBudCostLine = [];
            for (var i = 0; i < daysInMonth; i++) monthlyBudCostLine.push(budgetCostPerDay * (i + 1));

            var dayLabels = []; for (var i = 1; i <= daysInMonth; i++) dayLabels.push(i);

            var datasets = [
                { label: 'Biaya Aktual (Rp)', data: costCum, borderColor: 'rgba(13,148,136,1)', backgroundColor: 'rgba(13,148,136,0.1)', borderWidth: 2, pointRadius: 0, pointHitRadius: 0, fill: true, tension: 0.3, order: 1 },
                { label: 'Biaya Proyeksi (Rp)', data: projCostCum, borderColor: 'rgba(251,146,60,0.9)', borderWidth: 2, borderDash: [5,3], pointRadius: 0, pointHitRadius: 0, fill: false, tension: 0.3, order: 1 }
            ];
            if (budgetCostPerDay > 0) datasets.push({ label: 'Pace Budget (Rp)', data: monthlyBudCostLine, borderColor: 'rgba(34,197,94,0.7)', borderWidth: 2, borderDash: [8,4], pointRadius: 0, pointHitRadius: 0, fill: false, order: 0 });

            if (deviceCostProjectionChartInstance) deviceCostProjectionChartInstance.destroy();
            deviceCostProjectionChartInstance = new Chart($canvas[0].getContext('2d'), {
                type: 'line', data: { labels: dayLabels, datasets: datasets },
                options: { responsive: true, maintainAspectRatio: false, interaction: { intersect: false, mode: 'index' },
                    plugins: { legend: { display: true, position: 'top', labels: { font: { size: 10 }, boxWidth: 12 } },
                        tooltip: { callbacks: { label: function(ctx) { var v = ctx.parsed.y; if (v === null || v === undefined) return null; return ctx.dataset.label + ': Rp ' + formatInteger(Math.round(v)); } } } },
                    scales: { x: { grid: { display: false }, ticks: { font: { size: 9 }, maxTicksLimit: 15 } }, y: { beginAtZero: true, grid: { color: 'rgba(0,0,0,0.06)' }, ticks: { font: { size: 9 }, callback: function(v) { return 'Rp ' + formatInteger(v); } } } }
                }
            });

            var fh = '<div><strong>Biaya aktual bulan ini:</strong> Rp ' + formatInteger(cumCost) + ' · <strong>Proyeksi EOM:</strong> Rp ' + formatInteger(Math.round(totalProjMonthCost)) + '</div>';
            fh += '<div>Tarif efektif: Rp ' + formatInteger(Math.round(costPerKWh)) + '/kWh · Rata² harian: Rp ' + formatInteger(dayOfMonth > 0 ? Math.round(cumCost / dayOfMonth) : 0) + '</div>';
            if (budgetKwh > 0) { var budgetCostMonth = Math.round(budgetKwh * costPerKWh); var bpPct = Math.round(totalProjMonthCost / budgetCostMonth * 100); fh += '<div class="' + (bpPct > 100 ? 'text-danger' : (bpPct > 80 ? 'text-warning' : 'text-success')) + '">Proyeksi vs Budget: ' + bpPct + '% (Rp ' + formatInteger(budgetCostMonth) + ')</div>'; }
            $footer.html(fh).show();
        }

