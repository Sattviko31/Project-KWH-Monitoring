            // Monthly Chart - SORT BY MONTH
            var monthlyCtx = document.getElementById('deviceMonthlyChart');
            if (monthlyCtx && data.year.monthlyData.length > 0) {
                if (deviceUsageCharts.monthly) deviceUsageCharts.monthly.destroy();

                var sortedMonthly = data.year.monthlyData.slice().sort(function(a, b) { return a.sortKey - b.sortKey; });
                var isThisYear = deviceUsageDate.getFullYear() === today.getFullYear();
                var currentMonth = today.getMonth() + 1;

                var monthlyColors = sortedMonthly.map(function(m) {
                    if (!isThisYear) return 'rgba(13, 202, 240, 0.7)';
                    if (m.sortKey === currentMonth) return 'rgba(255, 165, 0, 0.9)';
                    if (m.sortKey < currentMonth) return 'rgba(13, 202, 240, 0.7)';
                    return 'rgba(200, 200, 200, 0.3)';
                });

                deviceUsageCharts.monthly = new Chart(monthlyCtx, {
                    type: 'bar',
                    data: {
                        labels: sortedMonthly.map(function(m) { return m.monthName; }),
