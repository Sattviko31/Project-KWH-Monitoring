        function loadAnomalyLogs() {
            if (detailAnomalyGrid) {
                detailAnomalyGrid.getDataSource().reload();
            }
        }

        function fmtDev(value) {
            if (value == null) return '-';
            return value.toLocaleString('id-ID', { minimumFractionDigits: 1, maximumFractionDigits: 1 });
        }

        function formatDateTimeShort(isoStr) {
            if (!isoStr) return '-';
            try {
                var d = new Date(isoStr);
                if (isNaN(d.getTime())) return isoStr;
                var dd = String(d.getDate()).padStart(2, '0');
                var MM = String(d.getMonth() + 1).padStart(2, '0');
                var yyyy = d.getFullYear();
                var hh = String(d.getHours()).padStart(2, '0');
                var mm = String(d.getMinutes()).padStart(2, '0');
                var ss = String(d.getSeconds()).padStart(2, '0');
                return dd + '/' + MM + '/' + yyyy + ' ' + hh + ':' + mm + ':' + ss;
            } catch(e) { return isoStr; }
        }

        // ============================================
        // AUTO REFRESH
        // ============================================
        function startAutoRefresh() {
            console.log('Starting auto-refresh...');

            if (refreshTimer) clearInterval(refreshTimer);
            if (anomalyTimer) clearInterval(anomalyTimer);

            refreshTimer = setInterval(function() {
                console.log('=== Auto-refresh triggered at', new Date().toLocaleTimeString(), '===');
                loadDetailChartData();
                updatePanelMonitoring();
            }, systemSettings.refreshInterval * 1000);

            anomalyTimer = setInterval(function() {
                loadAnomalyLogs();
            }, 30000);

            console.log('Auto-refresh started, interval:', systemSettings.refreshInterval, 'seconds');
        }

        // ============================================
        // DOWNTIME UI HELPERS
        // ============================================
        function populateDowntimeHourDropdowns() {
            var startSel = $('#downtimeStartHour');
            var endSel = $('#downtimeEndHour');
            startSel.empty();
            endSel.empty();
            for (var h = 0; h < 24; h++) {
                var label = (h < 10 ? '0' : '') + h + ':00';
                startSel.append('<option value="' + h + '">' + label + '</option>');
                endSel.append('<option value="' + h + '">' + label + '</option>');
            }
            startSel.val(downtimeSettings.startHour);
            endSel.val(downtimeSettings.endHour);
        }

        function updateDowntimeDuration() {
            var start = parseInt($('#downtimeStartHour').val());
            var end = parseInt($('#downtimeEndHour').val());
            var duration;
            if (start === end) duration = 24;
            else if (start < end) duration = end - start;
            else duration = (24 - start) + end;
            $('#downtimeDuration').text(duration + ' jam');
        }

        function updateDowntimeTimeline() {
            var start = parseInt($('#downtimeStartHour').val());
            var end = parseInt($('#downtimeEndHour').val());
            var bar = $('#downtimeTimelineBar');
            var pct = 100 / 24;

            if (start === end) {
                bar.css({ left: '0%', width: '100%', borderRadius: '6px', background: '#343a40' });
            } else if (start < end) {
                bar.css({ left: (start * pct) + '%', width: ((end - start) * pct) + '%', borderRadius: '0', background: '#343a40' });
            } else {
                var startPct = start * pct;
                var endPct = end * pct;
                bar.css({ left: '0%', width: '100%', borderRadius: '0',
                    background: 'linear-gradient(to right, #343a40 0%, #343a40 ' + endPct + '%, #28a745 ' + endPct + '%, #28a745 ' + startPct + '%, #343a40 ' + startPct + '%, #343a40 100%)'
                });
                return;
            }
            bar.css('background', '#343a40');
        }

        function updateDowntimeStatusUI() {
            $.ajax({
                url: '/api/Api/downtime-status',
                method: 'GET',
                dataType: 'json',
                success: function(data) {
                    if (data.isDowntime) {
                        $('#downtimeCurrentStatus').html('<span class="text-danger"><i class="fas fa-moon"></i> DOWNTIME AKTIF</span><br><small class="text-muted">' + data.message + '</small>');
                        $('#downtimeStatusCard').removeClass('border-success').addClass('border-danger');
                    } else {
                        $('#downtimeCurrentStatus').html('<span class="text-success"><i class="fas fa-sun"></i> OPERASI NORMAL</span><br><small class="text-muted">' + data.message + '</small>');
                        $('#downtimeStatusCard').removeClass('border-danger').addClass('border-success');
                    }
                },
                error: function() {
                    $('#downtimeCurrentStatus').html('<span class="text-muted">Tidak dapat memuat status</span>');
                }
            });
        }

        function highlightMatchingPreset(startHour, endHour) {
            $('.preset-btn').removeClass('ema-preset-active');
            $('.preset-btn').each(function() {
                if (parseInt($(this).data('start')) === startHour && parseInt($(this).data('end')) === endHour) {
                    $(this).addClass('ema-preset-active');
                }
            });
        }

        // ============================================
        // UPDATE SETTINGS MODAL UI FROM LOADED SETTINGS
        // ============================================
        function updateSettingsModalUI() {
            // EMA
            $('#emaPeriod').val(emaSettings.period);
            $('#upperThreshold').val(emaSettings.upperThreshold);
            $('#lowerThreshold').val(emaSettings.lowerThreshold);
            $('#fibUpper').val(emaSettings.fibUpper);
            $('#fibLower').val(emaSettings.fibLower);
            $('#refreshInterval').val(systemSettings.refreshInterval);
            $('#showEMA').prop('checked', emaSettings.showEMA);
            $('#showThresholds').prop('checked', emaSettings.showThresholds);
            $('#useInitial100ForEma').prop('checked', emaSettings.useInitial100ForEma || false);
            if (emaSettings.mode === 'manual') {
                $('#modeManual').prop('checked', true);
                $('#manualSettings').show();
                $('#fibonacciSettings').hide();
            } else {
                $('#modeFibonacci').prop('checked', true);
                $('#manualSettings').hide();
                $('#fibonacciSettings').show();
            }

            // Downtime
            populateDowntimeHourDropdowns();
            $('#downtimeEnabled').prop('checked', downtimeSettings.enabled);
            $('#downtimeStartHour').val(downtimeSettings.startHour);
            $('#downtimeEndHour').val(downtimeSettings.endHour);
            $('#downtimeDescription').val(downtimeSettings.description);
            highlightMatchingPreset(downtimeSettings.startHour, downtimeSettings.endHour);
            updateDowntimeDuration();
            updateDowntimeTimeline();
            updateDowntimeStatusUI();

            // Display
            $('#chartDataPoints').val(systemSettings.chartDataPoints);
            $('#chartShowGrid').prop('checked', systemSettings.showGrid);
            $('#chartShowLegend').prop('checked', systemSettings.showLegend);
            $('#chartGridColor').val(systemSettings.gridColor);
        }

        // ============================================
        // REBUILD CHARTS
        // ============================================
        function rebuildCharts() {
            console.log('Rebuilding charts...');
            if (charts.voltage) charts.voltage.destroy();
            if (charts.current) charts.current.destroy();
            if (charts.power) charts.power.destroy();

            initDetailCharts();
            loadDetailChartData();
        }

        // ============================================
        // INITIALIZATION
        // ============================================
        $(document).ready(function() {
            console.log('========================================');
            console.log('Details Page Initialized');
            console.log('Device Key:', deviceKey);
            console.log('========================================');

            // Load all settings in parallel, then init charts
            Promise.all([loadEmaSettings(), loadSystemSettings(), loadDowntimeSettings(), checkDowntimeStatus()]).then(function() {
                console.log('All settings loaded, loading categories...');

                // Load device category and category downtime, then init
                loadDeviceCategory().then(function() {
                    return loadCategoryDowntimeSettings();
                }).then(function() {
                    return loadAllCategoryDowntime();
                }).then(function() {
                    console.log('All settings + categories loaded, initializing charts...');

                    updateSettingsModalUI();
                    initDetailCharts();
                    loadDetailChartData();
                    updatePanelMonitoring();
                    initDetailAnomalyGrid();
                    startAutoRefresh();

                    // Periodically re-check downtime status
                    setInterval(function() {
                        loadAllCategoryDowntime().then(function() {
                            updateCategoryDowntimeUI(currentCategory);
                            checkDowntimeStatus().then(function() {
                                loadDetailChartData();
                            });
                        });
                    }, 60000);
                });
            });

            $('#statusText').text('Online');

            // Load usage statistics when tab is shown
            $('#usage-tab').on('shown.bs.tab', function() {
                console.log('Usage Statistics tab shown');
                updateDeviceDateInput();
                updateDeviceDayName();
                loadDeviceUsageStatistics();
            });

            // Date navigation handlers for usage tab
            $('#btnDevicePrevDay').click(function() {
                deviceUsageDate.setDate(deviceUsageDate.getDate() - 1);
                updateDeviceDateInput();
                updateDeviceDayName();
                loadDeviceUsageStatistics();
            });

            $('#btnDeviceNextDay').click(function() {
                deviceUsageDate.setDate(deviceUsageDate.getDate() + 1);
                updateDeviceDateInput();
                updateDeviceDayName();
                loadDeviceUsageStatistics();
            });

            $('#btnDeviceToday').click(function() {
                deviceUsageDate = new Date();
                updateDeviceDateInput();
                updateDeviceDayName();
                loadDeviceUsageStatistics();
            });

            $('#deviceFilterDate').change(function() {
                var dateVal = $(this).val();
                if (dateVal) {
                    var parts = dateVal.split('-');
                    deviceUsageDate = new Date(parts[0], parts[1] - 1, parts[2]);
                    updateDeviceDayName();
                    loadDeviceUsageStatistics();
                }
            });

            // Button handlers
            $('#btnRefresh').click(function() {
                console.log('Manual refresh clicked');
                loadDetailChartData();
                updatePanelMonitoring();
                loadAnomalyLogs();
            });

            // Settings button — open modal
            $('#btnSettings').click(function() {
                Promise.all([loadEmaSettings(), loadSystemSettings(), loadDowntimeSettings(), checkDowntimeStatus()]).then(function() {
                    updateSettingsModalUI();
                    $('#emaSettingsModal').modal('show');
                });
            });

            // Mode toggle
            $('input[name="thresholdMode"]').change(function() {
                if ($(this).val() === 'manual') {
                    $('#manualSettings').show();
                    $('#fibonacciSettings').hide();
                } else {
                    $('#manualSettings').hide();
                    $('#fibonacciSettings').show();
                }
            });

            // Preset button click
            $('.preset-btn').click(function() {
                var start = parseInt($(this).data('start'));
                var end = parseInt($(this).data('end'));
                var desc = $(this).data('desc');
                $('.preset-btn').removeClass('ema-preset-active');
                $(this).addClass('ema-preset-active');
                if (start === 0 && end === 0) {
                    $('#downtimeStartHour').focus();
                } else {
                    $('#downtimeStartHour').val(start);
                    $('#downtimeEndHour').val(end);
                    $('#downtimeDescription').val(desc);
                }
                updateDowntimeDuration();
                updateDowntimeTimeline();
            });

            // Downtime hour change
            $('#downtimeStartHour, #downtimeEndHour').change(function() {
                $('.preset-btn').removeClass('ema-preset-active');
                updateDowntimeDuration();
                updateDowntimeTimeline();
            });

            // Save All Settings
            $('#btnSaveEmaSettings').click(function() {
                var btn = $(this);
                btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Saving...');

                // Collect EMA settings
                var emaData = {
                    emaPeriod: parseInt($('#emaPeriod').val()) || 20,
                    emaMode: $('input[name="thresholdMode"]:checked').val() || 'manual',
                    emaUpperThreshold: parseInt($('#upperThreshold').val()) || 30,
                    emaLowerThreshold: parseInt($('#lowerThreshold').val()) || 50,
                    emaFibUpper: parseFloat($('#fibUpper').val()) || 1.618,
                    emaFibLower: parseFloat($('#fibLower').val()) || 0.618,
                    emaShowLine: $('#showEMA').is(':checked'),
                    emaShowThresholds: $('#showThresholds').is(':checked'),
                    useInitial100ForEma: $('#useInitial100ForEma').is(':checked'),
                    refreshInterval: parseInt($('#refreshInterval').val()) || 10,
                    chartDataPoints: parseInt($('#chartDataPoints').val()) || 20,
                    tariffPerKWh: 1500
                };

                // Collect downtime settings
                var downtimeData = {
                    enabled: $('#downtimeEnabled').is(':checked'),
                    startHour: parseInt($('#downtimeStartHour').val()),
                    endHour: parseInt($('#downtimeEndHour').val()),
                    description: $('#downtimeDescription').val() || ''
                };

                // Collect system/display settings
                var systemData = {
                    'Chart.DataPoints': $('#chartDataPoints').val() || '20',
                    'Chart.ShowGrid': $('#chartShowGrid').is(':checked').toString(),
                    'Chart.ShowLegend': $('#chartShowLegend').is(':checked').toString(),
                    'Chart.GridColor': $('#chartGridColor').val() || '#e0e0e0'
                };

                // Save all in parallel
                var requests = [
                    $.ajax({ url: '/api/Api/save-ema-settings', method: 'POST', contentType: 'application/json', data: JSON.stringify(emaData) }),
                    $.ajax({ url: '/api/Api/save-downtime-settings', method: 'POST', contentType: 'application/json', data: JSON.stringify(downtimeData) }),
                    $.ajax({ url: '/api/Api/save-system-settings', method: 'POST', contentType: 'application/json', data: JSON.stringify(systemData) })
                ];

                $.when.apply($, requests).done(function() {
                    // Update local settings
                    emaSettings.period = emaData.emaPeriod;
                    emaSettings.mode = emaData.emaMode;
                    emaSettings.upperThreshold = emaData.emaUpperThreshold;
                    emaSettings.lowerThreshold = emaData.emaLowerThreshold;
                    emaSettings.fibUpper = emaData.emaFibUpper;
                    emaSettings.fibLower = emaData.emaFibLower;
                    emaSettings.showEMA = emaData.emaShowLine;
                    emaSettings.showThresholds = emaData.emaShowThresholds;
                    emaSettings.useInitial100ForEma = emaData.useInitial100ForEma || false;
                    emaSettings.refreshInterval = emaData.refreshInterval;

                    systemSettings.chartDataPoints = parseInt(systemData['Chart.DataPoints']) || 20;
                    systemSettings.showGrid = systemData['Chart.ShowGrid'] !== 'false';
                    systemSettings.showLegend = systemData['Chart.ShowLegend'] !== 'false';
                    systemSettings.gridColor = systemData['Chart.GridColor'] || '#e0e0e0';
                    systemSettings.maxCapacity = parseInt(systemData['Load.MaxCapacity']) || 30000;
                    systemSettings.normalThreshold = parseInt(systemData['Load.NormalThreshold']) || 30;
                    systemSettings.mediumThreshold = parseInt(systemData['Load.MediumThreshold']) || 70;

                    downtimeSettings.enabled = downtimeData.enabled;
                    downtimeSettings.startHour = downtimeData.startHour;
                    downtimeSettings.endHour = downtimeData.endHour;
                    downtimeSettings.description = downtimeData.description;

                    // Re-check downtime status and rebuild charts
                    checkDowntimeStatus().then(function() {
                        startAutoRefresh();
                        rebuildCharts();
                        updateDowntimeStatusUI();
                    });

                    btn.prop('disabled', false).html('<i class="fas fa-save"></i> Save All Settings');
                    $('#emaSettingsModal').modal('hide');
                    alert('Settings saved!\nEMA Period: ' + emaSettings.period + '\nData Points: ' + systemSettings.chartDataPoints + '\nDowntime: ' + (downtimeSettings.enabled ? 'Active' : 'Disabled'));
                }).fail(function() {
                    btn.prop('disabled', false).html('<i class="fas fa-save"></i> Save All Settings');
                    alert('Error saving settings. Please try again.');
                });
            });

            console.log('Initialization Complete');
        });
    </script>
    <!-- Anomaly Alert Modal -->
    <div class="modal fade" id="anomalyModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title"><i class="fas fa-exclamation-triangle"></i> Anomaly Detected</h5>
                    <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
                </div>
                <div class="modal-body" id="anomalyContent"></div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>
}