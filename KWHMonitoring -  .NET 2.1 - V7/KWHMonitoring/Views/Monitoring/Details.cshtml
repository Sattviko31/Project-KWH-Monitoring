@section Scripts {
    <script src="~/js/chart.umd.min.js"></script>
    <script>

        // ============================================
        // CONFIGURATION
        // ============================================
        var deviceKey = '@deviceKey';
        var safeKey = '@safeKey';
        var isThreePhaseDevice = @Model.IsThreePhase.ToString().ToLower();
        var charts = {};
        var currentAnomalyPage = 1;
        var anomalyPageSize = 10;
        var refreshTimer = null;
        var anomalyTimer = null;
        var anomalyCooldown = {};
        
        // Konfirmasi anomali: jumlah sampling bisa di-set melalui Settings
        var anomalyConfirmation = {
            counts: {}, // deviceKey_anomalyType -> count
            maxConfirmations: 3, // Default, akan di-load dari DB
            cooldownTime: 60000
        };
        
        var deviceUsageDate = new Date();

        // EMA Settings - akan di-load dari database
        var emaSettings = {
            period: 20,
            mode: 'manual',
            upperThreshold: 0,
            lowerThreshold: 0,
            fibUpper: 0,
            fibLower: 0,
            showEMA: true,
            showThresholds: true,
            showMaxCapacity: true,
            useInitial100ForEma: false,
            refreshInterval: 10,
            enableAlerts: true
        };

        // System/Display Settings
        var systemSettings = {
            chartDataPoints: 20,
            refreshInterval: 10,
            showGrid: true,
            showGridX: true,
            showGridY: true,
            gridColor: '#e0e0e0',
            showLegend: false,
            maxCapacity: 0,
            normalThreshold: 30,
            mediumThreshold: 70
        };

        var isDowntimeNow = false;

        // Global stores for last loaded device data (used by generateDeviceDailyReport)
        var lastDeviceEnergyData = null;
        var lastDeviceFinancialData = null;

        // ============================================
        // DEVICE CATEGORY MANAGEMENT
        // ============================================
        var deviceCategoryMap = {};
        var currentCategory = 'Billboard';

        var categoryMeta = {}; // Populated dynamically from API

        var categoryDowntimeSettings = {};

        var categoryDowntimeMap = {};

        // Load categories metadata from API
        function loadCategoriesMeta() {
            return $.ajax({
                url: '/api/Api/categories',
                method: 'GET',
                dataType: 'json',
                timeout: 10000,
                success: function(data) {
                    categoryMeta = {};
                    (data || []).forEach(function(cat) {
                        categoryMeta[cat.name] = { icon: cat.icon, color: cat.color, desc: cat.description };
                    });
                    // Inject dynamic CSS for category colors
                    if (typeof injectCategoryStyles === 'function') injectCategoryStyles(data);
                    // Expose globally for partial views like _AnomalyService
                    window._categoryMetaMap = categoryMeta;
                    // Populate category badge in header
                    updateCategoryUI(currentCategory);
                    // Build downtime category tabs in modal
                    buildDowntimeCategoryTabs();
                    console.log('Categories meta loaded:', categoryMeta);
                },
                error: function() { console.warn('Failed to load categories meta'); }
            });
        }

        function loadDeviceCategory() {
            return $.ajax({
                url: '/api/Api/device-categories',
                method: 'GET',
                dataType: 'json',
                timeout: 10000,
                success: function(data) {
                    if (data.devices) {
                        deviceCategoryMap = data.devices;
                    }
                    currentCategory = deviceCategoryMap[deviceKey] || 'Billboard';
                    updateCategoryUI(currentCategory);
                    console.log('Device category loaded:', deviceCategoryMap);
                },
                error: function() { console.warn('Failed to load device categories'); }
            });
        }

        function updateCategoryUI(category) {
            currentCategory = category;
            var meta = categoryMeta[category] || { icon: '⚪', color: '#6c757d', desc: '' };

            // Update icon in info bar
            $('#detailCategoryIcon').text(meta.icon);
            // Update icon in page header
            $('#detailCategoryBadge').text(meta.icon);

            // Update downtime info for this category
            updateCategoryDowntimeUI(category);
        }

        function saveDeviceCategory(deviceKey, category) {
            return $.ajax({
                url: '/api/Api/device-category',
                method: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({ deviceKey: deviceKey, category: category }),
                success: function(data) {
                    if (data.success) {
                        deviceCategoryMap[deviceKey] = category;
                        updateCategoryUI(category);
                        // Reload downtime for new category
                        checkCategoryDowntime(category).then(function() {
                            updateCategoryDowntimeUI(category);
                            loadDetailChartData();
                        });
                    }
                },
                error: function() { alert('Gagal menyimpan kategori device'); }
            });
        }

        function loadCategoryDowntimeSettings() {
            // Get categories dynamically from API
            var cats = Object.keys(categoryMeta);
            if (cats.length === 0) cats = ['Billboard'];
            var promises = cats.map(function(cat) {
                return $.ajax({
                    url: '/api/Api/downtime-settings/' + cat,
                    method: 'GET',
                    dataType: 'json',
                    timeout: 10000,
                    success: function(data) {
                        categoryDowntimeSettings[cat] = {
                            enabled: data.enabled || false,
                            startHour: data.startHour != null ? data.startHour : 22,
                            endHour: data.endHour != null ? data.endHour : 6,
                            description: data.description || ''
                        };
                    }
                });
            });
            return $.when.apply($, promises);
        }

        function checkCategoryDowntime(category) {
            if (!category) category = 'Billboard';
            return $.ajax({
                url: '/api/Api/downtime-status?category=' + encodeURIComponent(category),
                method: 'GET',
                dataType: 'json',
                timeout: 5000,
                success: function(data) {
                    categoryDowntimeMap[category] = data.isDowntime || false;
                },
                error: function() { console.warn('Failed to check downtime for ' + category); }
            });
        }

        function loadAllCategoryDowntime() {
            var cats = Object.keys(categoryMeta);
            if (cats.length === 0) cats = ['Billboard'];
            var promises = cats.map(function(cat) {
                return checkCategoryDowntime(cat);
            });
            return $.when.apply($, promises);
        }

        // ============================================
        // MODAL DOWNTIME TABS — Dynamic per category
        // ============================================
        function buildDowntimeCategoryTabs() {
            var $tabs = $('#downtimeCategoryTabs');
            var $content = $('#downtimeCategoryTabContent');
            $tabs.empty();
            $content.empty();

            var categories = Object.keys(categoryMeta || {}).length > 0 ? Object.keys(categoryMeta) : ['Billboard'];
            if (categories.length === 0) {
                $content.html('<div class="text-center py-4 text-muted"><i class="fas fa-info-circle"></i> Tidak ada kategori</div>');
                return;
            }

            categories.forEach(function(cat, idx) {
                var meta = categoryMeta[cat] || {};
                var icon = meta.icon || '⚪';
                var color = meta.color || '#6c757d';
                var active = idx === 0;

                // Tab nav
                var tabHtml = '<li class="nav-item" role="presentation">' +
                    '<a class="nav-link' + (active ? ' active' : '') + '" data-toggle="tab" href="#downtime' + cat + '" role="tab">' +
                    '<span style="display:inline-block;width:8px;height:8px;border-radius:50%;background:' + color + ';vertical-align:middle;margin-right:2px"></span> ' + cat +
                    '</a></li>';
                $tabs.append(tabHtml);

                // Tab content
                var paneHtml = '<div class="tab-pane' + (active ? ' active' : '') + '" id="downtime' + cat + '" role="tabpanel">' +
                    '<div class="mb-2"><div class="form-check form-switch">' +
                    '<input class="form-check-input cat-downtime-enabled" type="checkbox" id="downtime' + cat + 'Enabled" data-category="' + cat + '" style="width: 2.5em; height: 1.3em;">' +
                    '<label class="form-check-label ema-label" for="downtime' + cat + 'Enabled">Aktifkan Downtime ' + cat + '</label>' +
                    '</div></div>' +
                    '<div class="ema-grid-3 mb-2">' +
                    '<div><label class="form-label ema-label">Jam Mulai</label><select class="form-select form-select-sm cat-downtime-start" id="downtime' + cat + 'StartHour" data-category="' + cat + '"></select></div>' +
                    '<div><label class="form-label ema-label">Jam Selesai</label><select class="form-select form-select-sm cat-downtime-end" id="downtime' + cat + 'EndHour" data-category="' + cat + '"></select></div>' +
                    '<div><label class="form-label ema-label">Durasi</label><div class="form-control form-control-sm bg-light text-center" id="downtime' + cat + 'Duration" readonly>8 jam</div></div>' +
                    '</div>' +
                    '<div class="mb-2"><label class="form-label ema-label">Deskripsi</label>' +
                    '<input type="text" class="form-control form-control-sm cat-downtime-desc" id="downtime' + cat + 'Description" data-category="' + cat + '" placeholder="Contoh: ' + cat + ' mati malam hari"></div>' +
                    '<div class="mb-2"><label class="form-label ema-label"><i class="fas fa-clock"></i> Timeline</label>' +
                    '<div class="position-relative" style="height: 24px; background: #198754; border-radius: 4px; overflow: hidden;">' +
                    '<div id="downtime' + cat + 'TimelineBar" style="position: absolute; top: 0; height: 100%; background: #1a1d23; transition: all 0.3s;"></div></div>' +
                    '<div class="d-flex justify-content-between mt-1" style="font-size: 0.6rem; color: #6c757d;">' +
                    '<span>00:00</span><span>06:00</span><span>12:00</span><span>18:00</span><span>24:00</span></div></div>' +
                    '<div class="card border" id="downtime' + cat + 'StatusCard"><div class="card-body text-center py-1">' +
                    '<div id="downtime' + cat + 'Status" class="fw-bold" style="font-size: 0.85rem;"><i class="fas fa-spinner fa-spin"></i> Memuat...</div>' +
                    '</div></div></div>';
                $content.append(paneHtml);

                // Init default downtime settings if not exists
                if (!categoryDowntimeSettings[cat]) {
                    categoryDowntimeSettings[cat] = { enabled: false, startHour: 22, endHour: 6, description: '' };
                }
            });
        }

        function populateCategoryHourDropdowns() {
            var categories = Object.keys(categoryMeta || {}).length > 0 ? Object.keys(categoryMeta) : ['Billboard'];
            categories.forEach(function(cat) {
                var $start = $('#downtime' + cat + 'StartHour');
                var $end = $('#downtime' + cat + 'EndHour');
                $start.empty();
                $end.empty();
                for (var h = 0; h < 24; h++) {
                    var label = (h < 10 ? '0' : '') + h + ':00';
                    $start.append('<option value="' + h + '">' + label + '</option>');
                    $end.append('<option value="' + h + '">' + label + '</option>');
                }
                var s = categoryDowntimeSettings[cat];
                if (s) {
                    $start.val(s.startHour);
                    $end.val(s.endHour);
                }
            });
        }

        function updateCategoryDuration(cat) {
            var start = parseInt($('#downtime' + cat + 'StartHour').val());
            var end = parseInt($('#downtime' + cat + 'EndHour').val());
            var duration;
            if (start === end) duration = 24;
            else if (start < end) duration = end - start;
            else duration = (24 - start) + end;
            $('#downtime' + cat + 'Duration').text(duration + ' jam');
        }

        function updateDowntimeTimelineForCategory(cat) {
            var start = parseInt($('#downtime' + cat + 'StartHour').val()) || 22;
            var end = parseInt($('#downtime' + cat + 'EndHour').val()) || 6;
            var bar = $('#downtime' + cat + 'TimelineBar');
            if (!bar.length) return;
            var pctPerHour = 100 / 24;
            if (start === end) {
                bar.css({ left: '0%', width: '100%', borderRadius: '4px', background: '#1a1d23' });
            } else if (start < end) {
                bar.css({ left: (start * pctPerHour) + '%', width: ((end - start) * pctPerHour) + '%', borderRadius: '0', background: '#1a1d23' });
            } else {
                var startPct = start * pctPerHour;
                var endPct = end * pctPerHour;
                bar.css({ left: '0%', width: '100%', borderRadius: '0',
                    background: 'linear-gradient(to right, #1a1d23 0%, #1a1d23 ' + endPct + '%, #198754 ' + endPct + '%, #198754 ' + startPct + '%, #1a1d23 ' + startPct + '%, #1a1d23 100%)'
                });
            }
        }

        function updateCategoryDowntimeStatusUIModal(cat) {
            var $status = $('#downtime' + cat + 'Status');
            var $card = $('#downtime' + cat + 'StatusCard');
            var isDowntime = categoryDowntimeMap[cat] || false;
            var s = categoryDowntimeSettings[cat] || { enabled: false, startHour: 22, endHour: 6 };
            var startLabel = (s.startHour < 10 ? '0' : '') + s.startHour + ':00';
            var endLabel = (s.endHour < 10 ? '0' : '') + s.endHour + ':00';
            if (isDowntime) {
                $status.html('<span class="text-danger"><i class="fas fa-moon"></i> DOWNTIME AKTIF</span><br><small class="text-muted">' + startLabel + '–' + endLabel + ' - Lower threshold disabled</small>');
                $card.removeClass('border-success').addClass('border-danger');
            } else {
                $status.html('<span class="text-success"><i class="fas fa-sun"></i> OPERASI NORMAL</span><br><small class="text-muted">All thresholds active</small>');
                $card.removeClass('border-danger').addClass('border-success');
            }
        }

        function updateCategoryDowntimeUI(category) {
            // Don't update UI if downtime settings haven't been loaded yet
            var firstCat = Object.keys(categoryDowntimeSettings)[0];
            if (!categoryDowntimeSettings[category] && !categoryDowntimeSettings[firstCat]) {
                console.log('⏳ Downtime settings not loaded yet, skipping UI update for ' + category);
                return;
            }

            var s = categoryDowntimeSettings[category] || categoryDowntimeSettings[firstCat] || { enabled: false, startHour: 22, endHour: 6 };
            var isDowntime = categoryDowntimeMap[category] || false;

            var startLabel = (s.startHour < 10 ? '0' : '') + s.startHour + ':00';
            var endLabel = (s.endHour < 10 ? '0' : '') + s.endHour + ':00';

            // Update downtime label in header bar
            if (s.enabled) {
                $('#detailDowntimeLabel')
                    .text(startLabel + '–' + endLabel)
                    .removeClass('bg-secondary bg-success bg-danger')
                    .addClass(isDowntime ? 'bg-danger' : 'bg-success');
