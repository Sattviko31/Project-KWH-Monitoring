                rowAlternationEnabled: true,
                showBorders: true,
                showColumnLines: true,
                showRowLines: false,
                allowColumnResizing: true,
                columnAutoWidth: true,
                loadPanel: { enabled: true, text: 'Memuat data...' },
                noDataText: 'Tidak ada data anomali',

                onRowPrepared: function(e) {
                    if (e.rowType !== 'data') return;
                    var t = e.data.anomalyType;
                    if (t === 'OVERLOAD') e.rowElement.css('border-left', '3px solid #dc3545');
                    else if (t === 'DROP' || t === 'DEVICE_DROP') e.rowElement.css('border-left', '3px solid #ffc107');
                    else e.rowElement.css('border-left', '3px solid #0d6efd');
                },

                columns: [
                    {
                        dataField: 'id',
                        caption: '#',
                        width: 50,
                        allowGrouping: false,
                        allowFiltering: false,
                        allowHeaderFiltering: false,
                        alignment: 'center'
                    },
                    {
                        dataField: 'detectedTime',
                        caption: 'Time',
                        dataType: 'datetime',
                        sortOrder: 'desc',
                        alignment: 'center',
                        allowHeaderFiltering: false,
                        filterOperations: ['between', '>=', '<=', '>', '<', '='],
                        selectedFilterOperation: 'between',
                        editorOptions: {
                            type: 'datetime',
                            displayFormat: 'dd/MM/yyyy HH:mm:ss'
                        },
                        cellTemplate: function(container, options) {
                            var val = options.value;
                            var text = '-';
                            if (val) {
                                if (val instanceof Date && !isNaN(val.getTime())) {
                                    var dd = String(val.getDate()).padStart(2, '0');
                                    var MM = String(val.getMonth() + 1).padStart(2, '0');
                                    var yyyy = val.getFullYear();
                                    var hh = String(val.getHours()).padStart(2, '0');
                                    var mm = String(val.getMinutes()).padStart(2, '0');
                                    var ss = String(val.getSeconds()).padStart(2, '0');
                                    text = dd + '/' + MM + '/' + yyyy + ' ' + hh + ':' + mm + ':' + ss;
                                } else {
                                    text = formatDateTimeShort(val);
                                }
                            }
                            $('<span>').text(text).appendTo(container);
                        }
                    },
                    {
                        dataField: 'anomalyType',
                        caption: 'Type',
                        alignment: 'center',
                        headerFilter: {
                            dataSource: [
                                { text: 'OVERLOAD', value: 'OVERLOAD' },
                                { text: 'DEVICE DROP', value: 'DROP' },
                                { text: 'DEVICE DROP', value: 'DEVICE_DROP' }
                            ]
                        },
                        cellTemplate: function(container, options) {
                            var v = options.value;
                            var cls, icon, text;
                            if (v === 'OVERLOAD') { cls = 'bg-danger'; icon = 'fa-bolt'; text = 'OVERLOAD'; }
                            else if (v === 'DROP' || v === 'DEVICE_DROP') { cls = 'bg-warning text-dark'; icon = 'fa-arrow-down'; text = 'DEVICE DROP'; }
                            else { cls = 'bg-info'; icon = 'fa-question'; text = v; }
                            $('<span>').addClass('badge ' + cls).html('<i class="fas ' + icon + '"></i> ' + text).appendTo(container);
                        }
                    },
                    {
                        dataField: 'powerValue',
                        caption: 'Power (W)',
                        dataType: 'number',
                        alignment: 'center',
                        cellTemplate: function(container, options) {
                            var v = options.value;
                            var cls = v > 20000 ? 'text-danger' : v > 10000 ? 'text-warning' : 'text-dark';
                            $('<span>').addClass(cls).text(formatNumber(v) + ' W').appendTo(container);
                        }
                    },
                    {
                        dataField: 'thresholdValue',
                        caption: 'Threshold (W)',
                        dataType: 'number',
                        alignment: 'center',
                        format: { type: 'fixedPoint', precision: 0 }
                    },
                    {
                        dataField: 'deviation',
                        caption: 'Deviation',
                        dataType: 'number',
                        alignment: 'center',
                        cellTemplate: function(container, options) {
                            var v = options.value;
                            var cls = v > 100 ? 'text-danger' : v > 50 ? 'text-warning' : 'text-success';
                            $('<span>').addClass(cls).text(fmtDev(v) + '%').appendTo(container);
                        }
                    },
                    {
                        dataField: 'durationMinutes',
                        caption: 'Durasi',
                        dataType: 'number',
                        alignment: 'center',
                        cellTemplate: function(container, options) {
                            var v = options.value;
                            if (v == null || v === undefined) { $('<span>').addClass('text-muted small fst-italic').text('ongoing').appendTo(container); return; }
                            var h = Math.floor(v / 60);
                            var m = Math.floor(v % 60);
                            var text = h > 0 ? h + 'j ' + m + 'm' : m + 'm';
                            $('<span>').text(text).appendTo(container);
                        }
                    },
                    {
                        dataField: 'responseTimeMinutes',
                        caption: 'Response',
                        dataType: 'number',
                        alignment: 'center',
                        cellTemplate: function(container, options) {
                            var v = options.value;
                            if (v == null || v === undefined) { $('<span>').text('-').appendTo(container); return; }
                            var h = Math.floor(v / 60);
                            var m = Math.floor(v % 60);
                            var cls = v <= 60 ? 'text-success' : v <= 240 ? 'text-warning' : 'text-danger';
                            var text = h > 0 ? h + 'j ' + m + 'm' : m + 'm';
                            $('<span>').addClass(cls).text(text).appendTo(container);
                        }
                    },
                    {
                        dataField: 'anomalyCostImpact',
                        caption: 'Dampak Biaya',
                        dataType: 'number',
                        alignment: 'center',
                        cellTemplate: function(container, options) {
                            var v = options.value || 0;
                            var data = options.row.data;
                            if (data.anomalyType !== 'OVERLOAD' || v <= 0) { $('<span>').text('-').appendTo(container); return; }
                            $('<span>').addClass('text-danger fw-bold').text('Rp ' + formatNumber(v)).appendTo(container);
                        }
                    },
                    {
                        dataField: 'revenueLoss',
                        caption: 'Revenue Loss',
                        dataType: 'number',
                        alignment: 'center',
                        cellTemplate: function(container, options) {
                            var v = options.value || 0;
                            var data = options.row.data;
                            var isResolved = data.isResolved;
                            if (data.anomalyType !== 'DROP' && data.anomalyType !== 'DEVICE_DROP') { $('<span>').text('-').appendTo(container); return; }
                            var cls = 'text-danger fw-bold';
                            if (!isResolved) cls += ' fst-italic';
                            $('<span>').addClass(cls).text('Rp ' + formatNumber(v) + (!isResolved ? ' *' : '')).appendTo(container);
                        }
                    },
                    {
                        dataField: 'thresholdMode',
                        caption: 'Mode',
                        alignment: 'center',
                        headerFilter: {
                            dataSource: [
                                { text: 'MANUAL', value: 'manual' },
                                { text: 'EMA', value: 'ema' }
                            ]
                        },
                        cellTemplate: function(container, options) {
                            $('<span>').addClass('badge bg-info').text(options.value.toUpperCase()).appendTo(container);
                        }
                    },
                    {
                        dataField: 'acknowledged',
                        caption: 'Status',
                        dataType: 'boolean',
                        alignment: 'center',
                        headerFilter: {
                            dataSource: [
                                { text: 'New', value: false },
                                { text: 'Acknowledged', value: true }
                            ]
                        },
                        cellTemplate: function(container, options) {
                            if (options.value) {
                                $('<span>').addClass('badge bg-success').text('Acknowledged').appendTo(container);
                            } else {
                                $('<span>').addClass('badge bg-secondary').text('New').appendTo(container);
                            }
                        }
                    }
                ]
            });
        }

        function loadAnomalyLogs() {
            var instance = $('#detailAnomalyGrid').dxDataGrid('instance');
            if (instance) {
                instance.getDataSource().reload();
            }
        }

        function fmtDev(value) {
            if (value == null) return '-';
            return value.toLocaleString('id-ID', { minimumFractionDigits: 1, maximumFractionDigits: 1 });
        }

        function formatDateTimeShort(isoStr) {
            if (!isoStr) return '-';
            try {
                var d = new Date(isoStr);
                if (isNaN(d.getTime())) return isoStr;
                var dd = String(d.getDate()).padStart(2, '0');
                var MM = String(d.getMonth() + 1).padStart(2, '0');
                var yyyy = d.getFullYear();
                var hh = String(d.getHours()).padStart(2, '0');
                var mm = String(d.getMinutes()).padStart(2, '0');
                var ss = String(d.getSeconds()).padStart(2, '0');
                return dd + '/' + MM + '/' + yyyy + ' ' + hh + ':' + mm + ':' + ss;
            } catch(e) { return isoStr; }
        }

        // ============================================
        // AUTO REFRESH
        // ============================================
        function startAutoRefresh() {
            console.log('Starting auto-refresh...');

            if (refreshTimer) clearInterval(refreshTimer);
            if (anomalyTimer) clearInterval(anomalyTimer);

            refreshTimer = setInterval(function() {
                console.log('=== Auto-refresh triggered at', new Date().toLocaleTimeString(), '===');
                loadDetailChartData();
                updatePanelMonitoring();
            }, systemSettings.refreshInterval * 1000);

            anomalyTimer = setInterval(function() {
                loadAnomalyLogs();
            }, 30000);

            console.log('Auto-refresh started, interval:', systemSettings.refreshInterval, 'seconds');
        }

        // ============================================
        // DOWNTIME UI HELPERS (per-category)
        // ============================================
        function highlightMatchingPresetForCategory(cat) {
            var s = categoryDowntimeSettings[cat] || { startHour: 22, endHour: 6 };
            $('.preset-btn').removeClass('ema-preset-active');
            $('.preset-btn').each(function() {
                if (parseInt($(this).data('start')) === s.startHour && parseInt($(this).data('end')) === s.endHour) {
                    $(this).addClass('ema-preset-active');
                }
            });
        }

        // ============================================
        // UPDATE SETTINGS MODAL UI FROM LOADED SETTINGS
        // ============================================
        function updateSettingsModalUI() {
            // Display
            $('#chartDataPoints').val(systemSettings.chartDataPoints);
            $('#chartShowGrid').prop('checked', systemSettings.showGrid);
            $('#chartShowLegend').prop('checked', systemSettings.showLegend);
            $('#chartGridColor').val(systemSettings.gridColor);
            $('#showEMA').prop('checked', emaSettings.showEMA);
            $('#showThresholds').prop('checked', emaSettings.showThresholds);
            $('#chartShowMaxCapacity').prop('checked', emaSettings.showMaxCapacity);
        }

        // ============================================
        // REBUILD CHARTS
        // ============================================
        function rebuildCharts() {
            console.log('Rebuilding charts...');
            if (charts.voltage) charts.voltage.destroy();
            if (charts.current) charts.current.destroy();
            if (charts.power) charts.power.destroy();

            initDetailCharts();
            loadDetailChartData();
        }

        // ============================================
        // INITIALIZATION
        // ============================================
        $(document).ready(function() {
            console.log('========================================');
            console.log('Details Page Initialized');
            console.log('Device Key:', deviceKey);
            console.log('========================================');

            // Load all settings in parallel (including per-device settings), then init charts
            // NOTE: checkDowntimeStatus is NOT called here because currentCategory
            // is not yet known. It will be called after loadDeviceCategory() completes.
            Promise.all([loadEmaSettings(), loadSystemSettings(), loadAnomalyMaxConfirmations(), loadCategoryDowntimeSettings(), Promise.resolve(window._deviceSettingsPromise)]).then(function() {
                console.log('Per-device settings loaded:', window._deviceSettingsLoaded, 'Device settings:', window.getDeviceSettings ? window.getDeviceSettings(deviceKey) : 'N/A');
                console.log('All settings loaded, loading categories...');

                // Load categories meta first, then device category, then downtime
                loadCategoriesMeta().then(function() {
                    return loadDeviceCategory();
                }).then(function() {
                    return loadCategoryDowntimeSettings();
                }).then(function() {
                    return loadAllCategoryDowntime();
                }).then(function() {
                    // Now that category downtime data is loaded, check the actual
                    // downtime status for the current device category and update UI
                    return checkDowntimeStatus();
                }).then(function() {
                    // Update header downtime display with actual data
                    updateCategoryDowntimeUI(currentCategory);

                    console.log('All settings + categories + downtime loaded, initializing charts...');

                    updateSettingsModalUI();
                    initDetailCharts();
                    loadDetailChartData();
                    updatePanelMonitoring();
                    initDetailAnomalyGrid();
                    startAutoRefresh();

                    // Periodically re-check downtime status and anomaly maxConfirmations
                    setInterval(function() {
                        loadAnomalyMaxConfirmations();
                        loadAllCategoryDowntime().then(function() {
                            updateCategoryDowntimeUI(currentCategory);
                            checkDowntimeStatus().then(function() {
                                loadDetailChartData();
                            });
                        });
                    }, 60000);
                });
            });

            $('#statusText').text('Online');

            // Load usage statistics when tab is shown
            $('#usage-tab').on('shown.bs.tab', function() {
                console.log('Usage Statistics tab shown');
                updateDeviceDateInput();
                updateDeviceDayName();
                loadDeviceUsageStatistics();
            });

            // Date navigation handlers for usage tab
            $('#btnDevicePrevDay').click(function() {
                deviceUsageDate.setDate(deviceUsageDate.getDate() - 1);
                updateDeviceDateInput();
                updateDeviceDayName();
                loadDeviceUsageStatistics();
            });

            $('#btnDeviceNextDay').click(function() {
                deviceUsageDate.setDate(deviceUsageDate.getDate() + 1);
                updateDeviceDateInput();
                updateDeviceDayName();
                loadDeviceUsageStatistics();
            });

            $('#btnDeviceToday').click(function() {
                deviceUsageDate = new Date();
                updateDeviceDateInput();
                updateDeviceDayName();
                loadDeviceUsageStatistics();
            });

            $('#deviceFilterDate').change(function() {
                var dateVal = $(this).val();
                if (dateVal) {
                    var parts = dateVal.split('-');
                    deviceUsageDate = new Date(parts[0], parts[1] - 1, parts[2]);
                    updateDeviceDayName();
                    loadDeviceUsageStatistics();
                }
            });

            // Button handlers
            $('#btnRefresh').click(function() {
                console.log('Manual refresh clicked');
                loadDetailChartData();
                updatePanelMonitoring();
                loadAnomalyLogs();
            });

            // Settings button — open modal
            $('#btnSettings').click(function() {
                updateSettingsModalUI();
                $('#emaSettingsModal').modal('show');
            });

            // Mode toggle
            $('input[name="thresholdMode"]').change(function() {
                if ($(this).val() === 'manual') {
                    $('#manualSettings').show();
                    $('#fibonacciSettings').hide();
                } else {
                    $('#manualSettings').hide();
                    $('#fibonacciSettings').show();
                }
            });

            // Preset button click — applies to active category tab
            $(document).on('click', '.preset-btn', function() {
                var start = parseInt($(this).data('start'));
                var end = parseInt($(this).data('end'));
                var desc = $(this).data('desc');
                var activeCat = $('#downtimeCategoryTabs .nav-link.active').text().trim() || Object.keys(categoryMeta)[0] || 'Billboard';
                $('.preset-btn').removeClass('ema-preset-active');
                $(this).addClass('ema-preset-active');
                if (start === 0 && end === 0) {
                    $('#downtime' + activeCat + 'StartHour').focus();
                } else {
                    $('#downtime' + activeCat + 'StartHour').val(start);
                    $('#downtime' + activeCat + 'EndHour').val(end);
                    $('#downtime' + activeCat + 'Description').val(desc);
                }
                updateCategoryDuration(activeCat);
                updateDowntimeTimelineForCategory(activeCat);
            });

            // Downtime hour change — delegated for per-category fields
            $(document).on('change', '.cat-downtime-start, .cat-downtime-end', function() {
                var cat = $(this).data('category');
                if (!cat) return;
                $('.preset-btn').removeClass('ema-preset-active');
                updateCategoryDuration(cat);
                updateDowntimeTimelineForCategory(cat);
            });

            // Category downtime tab switch — update preset highlights
            $(document).on('shown.bs.tab', '#downtimeCategoryTabs a[data-toggle="tab"]', function() {
                var cat = $(this).text().trim();
                highlightMatchingPresetForCategory(cat);
            });

            // Save Display Settings to localStorage
            $('#btnSaveDisplaySettings').click(function() {
                var displaySettings = {
                    chartDataPoints: parseInt($('#chartDataPoints').val()) || 20,
                    gridColor: $('#chartGridColor').val() || '#e0e0e0',
                    showGrid: $('#chartShowGrid').is(':checked'),
                    showEMA: $('#showEMA').is(':checked'),
                    showThresholds: $('#showThresholds').is(':checked'),
                    showMaxCapacity: $('#chartShowMaxCapacity').is(':checked'),
                    showLegend: $('#chartShowLegend').is(':checked')
                };

                localStorage.setItem('chartDisplaySettings', JSON.stringify(displaySettings));

                // Update local settings
                systemSettings.chartDataPoints = displaySettings.chartDataPoints;
                systemSettings.gridColor = displaySettings.gridColor;
                systemSettings.showGrid = displaySettings.showGrid;
                systemSettings.showLegend = displaySettings.showLegend;
                emaSettings.showEMA = displaySettings.showEMA;
                emaSettings.showThresholds = displaySettings.showThresholds;
                emaSettings.showMaxCapacity = displaySettings.showMaxCapacity;

                // Rebuild all charts to apply changes
                rebuildCharts();

                $('#emaSettingsModal').modal('hide');
            });

            console.log('Initialization Complete');
        });
    </script>
    <!-- Anomaly Alert Modal -->
    <div class="modal fade" id="anomalyModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title"><i class="fas fa-exclamation-triangle"></i> Anomaly Detected</h5>
                    <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
                </div>
                <div class="modal-body" id="anomalyContent"></div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>
}