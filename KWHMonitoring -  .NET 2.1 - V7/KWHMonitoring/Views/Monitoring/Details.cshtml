        // ============================================
        // SAVE SETTINGS TO DATABASE
        // ============================================
        function saveEmaSettings() {
            var emaData = {
                emaPeriod: emaSettings.period,
                emaMode: emaSettings.mode,
                emaUpperThreshold: emaSettings.upperThreshold,
                emaLowerThreshold: emaSettings.lowerThreshold,
                emaFibUpper: emaSettings.fibUpper,
