                            upperThreshold: data.emaUpperThreshold || 0,
                            lowerThreshold: data.emaLowerThreshold || 0,
                            fibUpper: data.emaFibUpper || 0,
                            fibLower: data.emaFibLower || 0,
                            showEMA: data.emaShowLine !== false,
                            showThresholds: data.emaShowThresholds !== false,
                            useInitial100ForEma: data.useInitial100ForEma || false,
                            refreshInterval: data.refreshInterval || 10,
                            enableAlerts: true
                        };
                        console.log('EMA Settings loaded:', emaSettings);
                        resolve();
                    },
                    error: function() { resolve(); }
                });
            });
