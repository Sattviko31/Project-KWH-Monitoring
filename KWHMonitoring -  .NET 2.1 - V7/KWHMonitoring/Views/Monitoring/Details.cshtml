        // --- WBP/LWBP Doughnut Chart ---
        function updateDeviceWbpLwbpChart(wbpLwbp) {
            var $canvas = $('#deviceWbpLwbpChart');
            var $notCfg = $('#deviceWbpLwbpNotConfigured');
            var $footer = $('#deviceWbpLwbpFooter');

            if (!wbpLwbp.configured) {
                $canvas.hide();
                var finData = lastDeviceFinancialData || {};
                var monthKwh = finData.month ? (finData.month.total || 0) : 0;
                var tariff = finData.tariffPerKWh || 1500;
                var flatCost = finData.budget && finData.budget.actualCost ? finData.budget.actualCost : (monthKwh * tariff);
                $notCfg.html(
                    '<div class="text-center py-2" style="font-size:0.8rem">' +
                        '<i class="fas fa-tag text-info"></i> <strong>Device ini menggunakan tarif flat</strong>' +
                        '<div class="mt-1">Konsumsi bulan ini: <strong>' + formatDecimal(monthKwh) + ' kWh</strong></div>' +
                        '<div>Estimasi biaya: <strong class="text-primary">Rp ' + formatNumber(flatCost) + '</strong> <span class="text-muted">(Rp ' + formatNumber(tariff) + '/kWh)</span></div>' +
                    '</div>'
                ).show();
                $footer.hide();
                if (deviceUsageCharts.wbpLwbp) { deviceUsageCharts.wbpLwbp.destroy(); deviceUsageCharts.wbpLwbp = null; }
                return;
            }

            var wbpKwh = wbpLwbp.wbpKwh || 0;
            var lwbpKwh = wbpLwbp.lwbpKwh || 0;
            var total = wbpKwh + lwbpKwh;

            if (total === 0) {
                $canvas.hide();
                $notCfg.html('<i class="fas fa-chart-pie"></i> Tidak ada data konsumsi untuk periode ini').show();
                $footer.hide();
                if (deviceUsageCharts.wbpLwbp) { deviceUsageCharts.wbpLwbp.destroy(); deviceUsageCharts.wbpLwbp = null; }
                return;
            }

            $canvas.show();
            $notCfg.hide();
            if (deviceUsageCharts.wbpLwbp) deviceUsageCharts.wbpLwbp.destroy();

            var wbpPct = total > 0 ? Math.round((wbpKwh / total) * 100) : 0;
            var lwbpPct = 100 - wbpPct;
            var wbpCost = wbpLwbp.wbpCost || 0;
            var lwbpCost = wbpLwbp.lwbpCost || 0;
            var totalCost = wbpLwbp.totalCostWBP || (wbpCost + lwbpCost);
            var wbpTariff = wbpLwbp.tariffWBP || 0;
            var lwbpTariff = wbpLwbp.tariffLWBP || 0;

            deviceUsageCharts.wbpLwbp = new Chart($canvas[0], {
                type: 'doughnut',
                data: {
                    labels: ['WBP', 'LWBP'],
                    datasets: [{
                        data: [wbpKwh, lwbpKwh],
                        backgroundColor: ['rgba(91,94,166,0.85)', 'rgba(25,135,84,0.85)'],
                        borderColor: ['rgba(91,94,166,0.85)', 'rgba(25,135,84,0.85)'],
                        borderWidth: 2,
                        hoverOffset: 2
                    }]
                },
                options: {
                    responsive: true, maintainAspectRatio: false,
                    cutout: '62%',
                    plugins: {
                        legend: { display: true, position: 'bottom', labels: { font: { size: 10 }, padding: 8, boxWidth: 12 } },
                        centerText: {
                            line1: formatDecimal(total) + ' kWh', line2: 'WBP ' + wbpPct + '% / LWBP ' + lwbpPct + '%', line3: 'Rp ' + formatNumber(totalCost),
                            color1: '#333', color2: '#888', color3: '#aaa'
                        },
                        tooltip: { callbacks: { label: function(ctx) { var cost = ctx.dataIndex === 0 ? wbpCost : lwbpCost; return ctx.label + ': ' + formatDecimal(ctx.parsed) + ' kWh (Rp ' + formatNumber(cost) + ')'; } } }
                    }
                }
            });

            $footer.show().html(
                '<div><span style="color:rgba(91,94,166,0.9)">WBP:</span> ' + formatDecimal(wbpKwh) + ' kWh = Rp ' + formatNumber(wbpCost) + '</div>' +
                '<div><span style="color:rgba(25,135,84,0.9)">LWBP:</span> ' + formatDecimal(lwbpKwh) + ' kWh = Rp ' + formatNumber(lwbpCost) + '</div>' +
                '<div class="mt-1" style="border-top:1px solid rgba(128,128,128,0.2);padding-top:2px">Tarif: WBP Rp ' + formatNumber(wbpTariff) + '/kWh · LWBP Rp ' + formatNumber(lwbpTariff) + '/kWh' +
                (wbpLwbp.wbpStart !== undefined ? ' · Jam ' + wbpLwbp.wbpStart + ':00-' + wbpLwbp.wbpEnd + ':00' : '') +
                '</div>'
            );
        }

        // --- Budget vs Actual Doughnut Chart ---
        function updateDeviceBudgetChart(budget) {
            var $canvas = $('#deviceBudgetChart');
            var $notCfg = $('#deviceBudgetNotConfigured');
            var $footer = $('#deviceBudgetFooter');
            var $header = $('#deviceBudgetCardHeader');

            if (!budget.configured) {
                $canvas.hide();
                $notCfg.html('<i class="fas fa-cog"></i> Belum dikonfigurasi — set Budget Rp/bln di Settings').show();
                $footer.hide();
                $header.attr('class', 'card-header bg-success text-white py-2');
                if (deviceUsageCharts.budget) { deviceUsageCharts.budget.destroy(); deviceUsageCharts.budget = null; }
                return;
            }

            $notCfg.hide();
            if (deviceUsageCharts.budget) deviceUsageCharts.budget.destroy();

            var budgetKwh = budget.budgetKWH || budget.budgetKWh || 0;
            var actualKwh = budget.actualKWH || budget.actualKWh || 0;
            var variance = budget.variance || (actualKwh - budgetKwh);
            var remaining = Math.max(budgetKwh - actualKwh, 0);
            var pct = budgetKwh > 0 ? Math.round((actualKwh / budgetKwh) * 100) : 0;
            var isOver = pct > 100;

            if (isOver) {
                $header.attr('class', 'card-header bg-danger text-white py-2');
            } else if (pct > 80) {
                $header.attr('class', 'card-header text-white py-2').css('background-color', '#e0a800');
            } else {
                $header.attr('class', 'card-header bg-success text-white py-2');
            }

            if (budgetKwh === 0 && actualKwh === 0) {
                $canvas.hide();
                $notCfg.html('<i class="fas fa-chart-pie"></i> Tidak ada data').show();
                $footer.hide();
                return;
            }

            $canvas.show();
            var usedColor = isOver ? 'rgba(220,53,69,0.85)' : (pct > 80 ? 'rgba(255,193,7,0.85)' : 'rgba(25,135,84,0.85)');
            var usedBorder = isOver ? 'rgba(220,53,69,1)' : (pct > 80 ? 'rgba(255,193,7,1)' : 'rgba(25,135,84,1)');

            deviceUsageCharts.budget = new Chart($canvas[0], {
                type: 'doughnut',
                data: {
                    labels: ['Terpakai', 'Sisa'],
                    datasets: [{
                        data: [actualKwh, remaining],
                        backgroundColor: [usedColor, 'rgba(200,200,200,0.3)'],
                        borderColor: [usedColor, 'rgba(200,200,200,0.3)'],
                        borderWidth: 2,
                        hoverOffset: 2
                    }]
                },
                options: {
                    responsive: true, maintainAspectRatio: false,
                    cutout: '62%',
                    plugins: {
                        legend: { display: true, position: 'bottom', labels: { font: { size: 10 }, padding: 8, boxWidth: 12 } },
                        centerText: {
                            line1: pct + '%', line2: isOver ? 'Over Budget' : 'terpakai', line3: isOver ? 'Over ' + (pct - 100) + '%' : 'Sisa ' + (100 - pct) + '%',
                            color1: isOver ? '#dc3545' : (pct > 80 ? '#856404' : '#198754'), color2: '#888', color3: isOver ? '#dc3545' : '#aaa'
                        },
                        tooltip: { callbacks: { label: function(ctx) { return ctx.label + ': ' + formatDecimal(ctx.parsed) + ' kWh'; } } }
                    }
                }
            });

            var budgetCost = budget.budgetCost || 0;
            var actualCost = budget.actualCost || 0;
            var footHtml = '<div><strong>Budget:</strong> Rp ' + formatNumber(budgetCost) + ' (' + formatDecimal(budgetKwh) + ' kWh)</div>' +
                '<div><strong>Actual:</strong> Rp ' + formatNumber(actualCost) + ' (' + formatDecimal(actualKwh) + ' kWh)</div>';
            if (variance !== 0) {
                var vCls = variance > 0 ? 'text-danger' : 'text-success';
                footHtml += '<div><strong>Variance:</strong> <span class="' + vCls + '">' + (variance > 0 ? '+' : '') + formatDecimal(variance) + ' kWh</span></div>';
            }
            $footer.show().html(footHtml);
        }

        // ============================================
        // DEVICE PROJECTION CHARTS
        // ============================================
        var activeDeviceProjectionTab = 'monthly';
        var activeDeviceCostProjectionTab = 'monthly';
        var deviceProjectionChartInstance = null;
        var deviceCostProjectionChartInstance = null;

        function switchDeviceProjectionTab(tab) {
            activeDeviceProjectionTab = tab;
            $('[data-devproj-tab]').removeClass('active');
            $('[data-devproj-tab="' + tab + '"]').addClass('active');
            renderDeviceConsumptionProjection();
        }

        function switchDeviceCostProjectionTab(tab) {
            activeDeviceCostProjectionTab = tab;
            $('[data-devcostproj-tab]').removeClass('active');
            $('[data-devcostproj-tab="' + tab + '"]').addClass('active');
            renderDeviceCostProjection();
        }

        function updateDeviceProjectionCharts() {
            if (!lastDeviceFinancialData) return;
            renderDeviceConsumptionProjection();
            renderDeviceCostProjection();
        }

        function renderDeviceConsumptionProjection() {
            var d = lastDeviceFinancialData;
            if (!d) return;

            var $canvas = $('#deviceProjectionChart');
            var $footer = $('#deviceProjectionFooter');

            if (activeDeviceProjectionTab === 'monthly') {
                renderDevMonthlyProj(d, $canvas, $footer);
            } else {
                renderDevYearlyProj(d, $canvas, $footer);
            }
        }

        function renderDevMonthlyProj(d, $canvas, $footer) {
            var now = new Date();
            var daysInMonth = new Date(now.getFullYear(), now.getMonth() + 1, 0).getDate();
            var dayOfMonth = now.getDate();

            var dailyData = (d.month && d.month.dailyData) || [];
            var budget = d.budget || {};

            var actualDaily = new Array(daysInMonth).fill(0);
            dailyData.forEach(function(dd) {
                var idx = (dd.sortKey || 0) - 1;
                if (idx >= 0 && idx < daysInMonth) actualDaily[idx] = dd.energy || 0;
            });

            var filledDays = 0, filledSum = 0;
            for (var i = 0; i < Math.min(dayOfMonth, daysInMonth); i++) {
                if (actualDaily[i] > 0) { filledDays++; filledSum += actualDaily[i]; }
            }

            var recentWindow = 7, recentSum = 0, recentCount = 0, olderSum = 0, olderCount = 0;
            var cutoff = Math.max(0, dayOfMonth - recentWindow);
            for (var i = cutoff; i < Math.min(dayOfMonth, daysInMonth); i++) { if (actualDaily[i] > 0) { recentSum += actualDaily[i]; recentCount++; } }
            for (var i = 0; i < cutoff; i++) { if (actualDaily[i] > 0) { olderSum += actualDaily[i]; olderCount++; } }
            var recentAvg = recentCount > 0 ? recentSum / recentCount : 0;
            var olderAvg = olderCount > 0 ? olderSum / olderCount : 0;
            var projKWh = (recentAvg > 0 && olderAvg > 0) ? recentAvg * 0.6 + olderAvg * 0.4 : (recentAvg > 0 ? recentAvg : (olderAvg > 0 ? olderAvg : (filledDays > 0 ? filledSum / filledDays : 0)));

            var projectedDaily = new Array(daysInMonth).fill(0);
            for (var i = 0; i < daysInMonth; i++) projectedDaily[i] = i < dayOfMonth ? actualDaily[i] : projKWh;

            var actualCum = [], projCum = [], budgetPace = [];
            var cA = 0, cP = 0, budgetKwh = budget.budgetKWH || budget.budgetKWh || 0;
            var dailyBud = budgetKwh > 0 ? budgetKwh / daysInMonth : 0;
            for (var i = 0; i < daysInMonth; i++) {
                if (i < dayOfMonth) { cA += actualDaily[i]; actualCum.push(cA); projCum.push(cA); }
                else { actualCum.push(null); cP += projectedDaily[i]; projCum.push(cA + cP); }
                budgetPace.push(dailyBud * (i + 1));
            }

            var labels = []; for (var i = 1; i <= daysInMonth; i++) labels.push(i);
            var totalActual = 0; for (var i = 0; i < dayOfMonth; i++) totalActual += actualDaily[i];
            var totalProj = totalActual + projKWh * (daysInMonth - dayOfMonth);

            var datasets = [
                { label: 'Aktual (kWh)', data: actualDaily.slice(0, dayOfMonth).concat(new Array(daysInMonth - dayOfMonth).fill(null)), type: 'bar', backgroundColor: 'rgba(59,130,246,0.7)', borderColor: 'rgba(59,130,246,1)', borderWidth: 1, borderRadius: 2, order: 3 },
                { label: 'Proyeksi (kWh)', data: new Array(dayOfMonth).fill(null).concat(projectedDaily.slice(dayOfMonth)), type: 'bar', backgroundColor: 'rgba(251,146,60,0.4)', borderColor: 'rgba(251,146,60,0.8)', borderWidth: 1, borderDash: [3,3], borderRadius: 2, order: 3 },
                { label: 'Kumulatif Aktual', data: actualCum, type: 'line', borderColor: 'rgba(59,130,246,1)', borderWidth: 2, pointRadius: 0, pointHitRadius: 0, fill: false, tension: 0.3, order: 1 },
                { label: 'Kumulatif Proyeksi', data: projCum, type: 'line', borderColor: 'rgba(251,146,60,0.9)', borderWidth: 2, borderDash: [5,3], pointRadius: 0, pointHitRadius: 0, fill: false, tension: 0.3, order: 1 }
            ];
            if (budgetKwh > 0) datasets.push({ label: 'Pace Budget', data: budgetPace, type: 'line', borderColor: 'rgba(34,197,94,0.8)', borderWidth: 2, borderDash: [8,4], pointRadius: 0, pointHitRadius: 0, fill: false, order: 0 });

            if (deviceProjectionChartInstance) deviceProjectionChartInstance.destroy();
            deviceProjectionChartInstance = new Chart($canvas[0].getContext('2d'), {
                type: 'bar', data: { labels: labels, datasets: datasets },
                options: { responsive: true, maintainAspectRatio: false, interaction: { intersect: false, mode: 'index' },
                    plugins: { legend: { display: true, position: 'top', labels: { font: { size: 10 }, boxWidth: 12 } },
                        tooltip: { callbacks: { label: function(ctx) { var v = ctx.parsed.y; if (v === null || v === undefined) return null; return ctx.dataset.label + ': ' + formatDecimal(v) + ' kWh'; } } } },
                    scales: { x: { grid: { display: false }, ticks: { font: { size: 9 }, maxTicksLimit: 15 } }, y: { beginAtZero: true, grid: { color: 'rgba(0,0,0,0.06)' }, ticks: { font: { size: 9 }, callback: function(v) { return formatDecimal(v); } } } }
                }
            });

            var fh = '<div><strong>Aktual:</strong> ' + formatDecimal(totalActual) + ' kWh · <strong>Proyeksi EOM:</strong> ' + formatDecimal(totalProj) + ' kWh</div>';
            fh += '<div>Rata² aktual: ' + formatDecimal(filledDays > 0 ? filledSum / filledDays : 0) + ' kWh/hari · Proyeksi sisa: ' + formatDecimal(projKWh) + ' kWh/hari · Sisa ' + (daysInMonth - dayOfMonth) + ' hari</div>';
            if (budgetKwh > 0) { var bp = Math.round(totalProj / budgetKwh * 100); fh += '<div class="' + (bp > 100 ? 'text-danger' : (bp > 80 ? 'text-warning' : 'text-success')) + '">Proyeksi vs Budget: ' + bp + '% (' + formatDecimal(budgetKwh) + ' kWh)</div>'; }
            $footer.html(fh).show();
        }

        function renderDevYearlyProj(d, $canvas, $footer) {
            var currentMonth = new Date().getMonth() + 1;
            var monthlyData = (d.year && d.year.monthlyData) || [];
            var budget = d.budget || {};
            var monthLabels = ['Jan','Feb','Mar','Apr','Mei','Jun','Jul','Ags','Sep','Okt','Nov','Des'];

            var actualMonthly = new Array(12).fill(0);
            monthlyData.forEach(function(m) { var idx = (m.sortKey || 0) - 1; if (idx >= 0 && idx < 12) actualMonthly[idx] = m.energy || 0; });

            var filledMonths = 0, filledSum = 0;
            for (var i = 0; i < currentMonth; i++) { if (actualMonthly[i] > 0) { filledMonths++; filledSum += actualMonthly[i]; } }

            var recentWindow = 3, recentSum = 0, recentCount = 0, olderSum = 0, olderCount = 0;
            var cutoff = Math.max(0, currentMonth - recentWindow);
            for (var i = cutoff; i < currentMonth; i++) { if (actualMonthly[i] > 0) { recentSum += actualMonthly[i]; recentCount++; } }
            for (var i = 0; i < cutoff; i++) { if (actualMonthly[i] > 0) { olderSum += actualMonthly[i]; olderCount++; } }
            var recentAvg = recentCount > 0 ? recentSum / recentCount : 0;
            var olderAvg = olderCount > 0 ? olderSum / olderCount : 0;
            var projKWh = (recentAvg > 0 && olderAvg > 0) ? recentAvg * 0.6 + olderAvg * 0.4 : (recentAvg > 0 ? recentAvg : (olderAvg > 0 ? olderAvg : (filledMonths > 0 ? filledSum / filledMonths : 0)));

            var actualCum = [], projCum = [], budgetPace = [];
            var cA = 0, cP = 0, budgetKwh = budget.budgetKWH || budget.budgetKWh || 0;
            var yearlyBudget = budgetKwh > 0 ? budgetKwh * 12 : 0;
            var monthlyBud = yearlyBudget > 0 ? yearlyBudget / 12 : 0;
            for (var i = 0; i < 12; i++) {
                if (i < currentMonth) { cA += actualMonthly[i]; actualCum.push(cA); projCum.push(cA); }
                else { actualCum.push(null); cP += projKWh; projCum.push(cA + cP); }
                budgetPace.push(monthlyBud * (i + 1));
            }
            var totalActualYear = cA, totalProjYear = totalActualYear + projKWh * (12 - currentMonth);

            var datasets = [
                { label: 'Aktual (kWh)', data: actualMonthly.slice(0, currentMonth).concat(new Array(12 - currentMonth).fill(null)), type: 'bar', backgroundColor: 'rgba(99,102,241,0.7)', borderColor: 'rgba(99,102,241,1)', borderWidth: 1, borderRadius: 3, order: 3 },
                { label: 'Proyeksi (kWh)', data: new Array(currentMonth).fill(null).concat(new Array(12 - currentMonth).fill(projKWh)), type: 'bar', backgroundColor: 'rgba(251,146,60,0.35)', borderColor: 'rgba(251,146,60,0.7)', borderWidth: 1, borderDash: [3,3], borderRadius: 3, order: 3 },
                { label: 'Kumulatif Aktual', data: actualCum, type: 'line', borderColor: 'rgba(99,102,241,1)', borderWidth: 2, pointRadius: 2, fill: false, tension: 0.3, order: 1 },
                { label: 'Kumulatif Proyeksi', data: projCum, type: 'line', borderColor: 'rgba(251,146,60,0.9)', borderWidth: 2, borderDash: [5,3], pointRadius: 0, pointHitRadius: 0, fill: false, tension: 0.3, order: 1 }
            ];
            if (yearlyBudget > 0) datasets.push({ label: 'Pace Budget', data: budgetPace, type: 'line', borderColor: 'rgba(34,197,94,0.8)', borderWidth: 2, borderDash: [8,4], pointRadius: 0, pointHitRadius: 0, fill: false, order: 0 });

            if (deviceProjectionChartInstance) deviceProjectionChartInstance.destroy();
            deviceProjectionChartInstance = new Chart($canvas[0].getContext('2d'), {
                type: 'bar', data: { labels: monthLabels, datasets: datasets },
                options: { responsive: true, maintainAspectRatio: false, interaction: { intersect: false, mode: 'index' },
                    plugins: { legend: { display: true, position: 'top', labels: { font: { size: 10 }, boxWidth: 12 } },
                        tooltip: { callbacks: { label: function(ctx) { var v = ctx.parsed.y; if (v === null || v === undefined) return null; return ctx.dataset.label + ': ' + formatDecimal(v) + ' kWh'; } } } },
                    scales: { x: { grid: { display: false }, ticks: { font: { size: 9 } } }, y: { beginAtZero: true, grid: { color: 'rgba(0,0,0,0.06)' }, ticks: { font: { size: 9 }, callback: function(v) { return formatDecimal(v); } } } }
                }
            });

            var fh = '<div><strong>Aktual ' + currentMonth + ' bulan:</strong> ' + formatDecimal(totalActualYear) + ' kWh · <strong>Proyeksi EOY:</strong> ' + formatDecimal(totalProjYear) + ' kWh</div>';
            fh += '<div>Rata² bulanan: ' + formatDecimal(filledMonths > 0 ? filledSum / filledMonths : 0) + ' kWh · Proyeksi sisa: ' + formatDecimal(projKWh) + ' kWh/bln</div>';
            if (yearlyBudget > 0) { var yp = Math.round(totalProjYear / yearlyBudget * 100); fh += '<div class="' + (yp > 100 ? 'text-danger' : (yp > 80 ? 'text-warning' : 'text-success')) + '">Proyeksi vs Budget: ' + yp + '% (' + formatDecimal(yearlyBudget) + ' kWh/tahun)</div>'; }
            $footer.html(fh).show();
