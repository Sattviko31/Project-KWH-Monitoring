        // ============================================
        // EMA CALCULATION HELPER (Promise-based, non-blocking)
        // ============================================
        function fetchAndApplyEma(devKey, powerData) {
            if (!devKey) {
                console.warn('fetchAndApplyEma: deviceKey is missing, using regular EMA');
                return $.Deferred().resolve(calculateEMA(powerData, emaSettings.period)).promise();
            }

            if (emaSettings.useInitial100ForEma) {
                return $.ajax({
                    url: '/api/Api/get-initial-ema/' + encodeURIComponent(devKey),
                    method: 'GET',
                    dataType: 'json',
                    timeout: 10000
                }).then(function(initialData) {
                    if (initialData.success && initialData.emaBaseline != null) {
                        var emaBaseline = initialData.emaBaseline;
                        console.log('Using EMA Baseline:', emaBaseline);
                        return calculateEMAWithBaseline(powerData, emaSettings.period, emaBaseline);
                    } else {
                        console.log('No EMA baseline found, using regular EMA');
                        return calculateEMA(powerData, emaSettings.period);
                    }
                }).fail(function() {
                    console.log('Error fetching EMA baseline, using regular EMA');
                    return calculateEMA(powerData, emaSettings.period);
                });
            } else {
                return $.Deferred().resolve(calculateEMA(powerData, emaSettings.period)).promise();
            }
        }

        // ============================================
        // DATA LOADING WITH EMA & ANOMALY DETECTION
        // ============================================
        function loadDetailChartData() {
            console.log('Loading chart data for', deviceKey);

            var points = systemSettings.chartDataPoints || 20;
            $.ajax({
                url: '/api/Api/panels/' + deviceKey + '/chart?points=' + points,
                method: 'GET',
                dataType: 'json',
                timeout: 10000,
                success: function(data) {
                    try {
                        if (charts.voltage && data.voltage) {
                            charts.voltage.data.labels = data.labels || [];
                            charts.voltage.data.datasets[0].data = data.voltage.r || [];
                            if (isThreePhaseDevice && charts.voltage.data.datasets.length > 1) {
                                charts.voltage.data.datasets[1].data = data.voltage.s || [];
                                if (charts.voltage.data.datasets.length > 2) {
                                    charts.voltage.data.datasets[2].data = data.voltage.t || [];
                                }
                            }
                            charts.voltage.update('none');
                        }

                        if (charts.current && data.current) {
                            charts.current.data.labels = data.labels || [];
                            charts.current.data.datasets[0].data = data.current.r || [];
                            if (isThreePhaseDevice && charts.current.data.datasets.length > 1) {
                                charts.current.data.datasets[1].data = data.current.s || [];
                                if (charts.current.data.datasets.length > 2) {
                                    charts.current.data.datasets[2].data = data.current.t || [];
                                }
                            }
                            charts.current.update('none');
                        }

                        if (charts.power && data.power) {
                            var powerData = data.power || [];
                            charts.power.data.labels = data.labels || [];
                            charts.power.data.datasets[0].data = powerData;

                            // Update max capacity line (per-device, only if enabled)
                            if (emaSettings.showMaxCapacity) {
                                var mcDs = (window.getDeviceSettings && window.getDeviceSettings(deviceKey)) || {};
                                var mcValue = mcDs.maxCapacity || 0;
                                // Find Max Capacity dataset by label
                                for (var i = 0; i < charts.power.data.datasets.length; i++) {
                                    if (charts.power.data.datasets[i].label.indexOf('Max Capacity') === 0) {
                                        if (mcValue > 0) {
                                            charts.power.data.datasets[i].data = powerData.map(function() { return mcValue; });
                                            charts.power.data.datasets[i].label = 'Max Capacity (' + mcValue.toLocaleString('id-ID') + ' W)';
                                            charts.power.data.datasets[i].borderColor = '#8e44ad';
                                            charts.power.data.datasets[i].borderDash = [15, 5];
                                        } else {
                                            charts.power.data.datasets[i].data = [];
                                            charts.power.data.datasets[i].label = 'Max Capacity (-)';
                                            charts.power.data.datasets[i].borderColor = 'transparent';
                                        }
                                        break;
                                    }
                                }
                            }

                            if (emaSettings.showEMA && charts.power.data.datasets[1]) {
                                fetchAndApplyEma(deviceKey, powerData).done(function(ema) {
                                    try {
                                        charts.power.data.datasets[1].data = ema;
                                        charts.power.data.datasets[1].label = emaSettings.useInitial100ForEma ? 'SMA 100 (Baseline)' : 'EMA ' + emaSettings.period;
                                        charts.power.data.datasets[1].tension = emaSettings.useInitial100ForEma ? 0 : 0.3;

                                        if (emaSettings.showThresholds && charts.power.data.datasets[2]) {
                                            var ds = (window.getDeviceSettings && window.getDeviceSettings(deviceKey)) || {};
                                            var upperValue = ds.emaUpperThreshold || 0;
                                            var lowerValue = ds.emaLowerThreshold || 0;

                                            // Calculate thresholds only when at least one value is configured
                                            var thresholds = (upperValue > 0 || lowerValue > 0)
                                                ? calculateThresholds(ema, 'manual', upperValue, lowerValue)
                                                : { upper: [], lower: [] };

                                            // Upper line: only draw if configured (> 0)
                                            if (upperValue > 0) {
                                                charts.power.data.datasets[2].data = thresholds.upper;
                                                charts.power.data.datasets[2].label = 'Upper (+' + upperValue + '%)';
                                                charts.power.data.datasets[2].borderColor = '#ff0000';
                                            } else {
                                                charts.power.data.datasets[2].data = [];
                                                charts.power.data.datasets[2].borderColor = 'transparent';
                                            }

                                            // Lower line: only draw if configured (> 0) AND not in downtime
                                            if (charts.power.data.datasets[3]) {
                                                if (lowerValue <= 0 || isDowntimeForDevice()) {
                                                    charts.power.data.datasets[3].data = [];
                                                    charts.power.data.datasets[3].borderColor = 'transparent';
                                                    charts.power.data.datasets[3].label = lowerValue <= 0 ? 'Lower (-)' : 'Lower (Downtime)';
                                                } else {
                                                    charts.power.data.datasets[3].data = thresholds.lower;
                                                    charts.power.data.datasets[3].borderColor = '#ff9900';
                                                    charts.power.data.datasets[3].label = 'Lower (-' + lowerValue + '%)';
                                                }
                                            }

                                            // DETEKSI DAN LOG ANOMALI (only when thresholds are configured)
                                            if (upperValue > 0 || lowerValue > 0) {
                                                detectAndLogAnomaly(deviceKey, powerData, ema, thresholds.upper, thresholds.lower);
                                            }
                                        }

                                        charts.power.update('none');
                                    } catch(err) {
                                        console.error('Error applying EMA to chart:', err);
                                    }
                                });
                            } else {
                                charts.power.update('none');
                            }
                        }

                        console.log('Charts updated');
                    } catch(e) {
                        console.error('Error updating charts:', e);
                    }
                },
                error: function(xhr, status, error) {
                    console.error('Error loading chart data:', error);
                }
            });
        }

