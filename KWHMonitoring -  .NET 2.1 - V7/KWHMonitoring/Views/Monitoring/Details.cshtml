                { label: 'Kumulatif Proyeksi', data: yProjCostCum, type: 'line', borderColor: 'rgba(251,146,60,0.9)', borderWidth: 2, borderDash: [5,3], pointRadius: 0, pointHitRadius: 0, fill: false, tension: 0.3, order: 1 }
            ];
            if (yearlyBudgetCost > 0) datasets.push({ label: 'Pace Budget', data: yearlyBudgetCostLine, type: 'line', borderColor: 'rgba(34,197,94,0.8)', borderWidth: 2, borderDash: [8,4], pointRadius: 0, pointHitRadius: 0, fill: false, order: 0 });

            if (deviceCostProjectionChartInstance) deviceCostProjectionChartInstance.destroy();
            deviceCostProjectionChartInstance = new Chart($canvas[0].getContext('2d'), {
