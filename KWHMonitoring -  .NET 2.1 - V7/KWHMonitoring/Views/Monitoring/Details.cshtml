        <!-- TAB 4: ANOMALY LOGS -->
        <div class="tab-pane fade" id="tabAnomalyLogs" role="tabpanel">
            <div class="card shadow">
                <div class="card-header bg-warning text-dark d-flex justify-content-between align-items-center py-2">
                    <h6 class="mb-0"><i class="fas fa-exclamation-triangle"></i> Anomaly Logs</h6>
                </div>
                <div class="card-body p-0">
                    <div class="anomaly-grid-scroll-wrapper">
                        <div id="detailAnomalyGrid" style="width:100%;"></div>
                    </div>
                </div>
