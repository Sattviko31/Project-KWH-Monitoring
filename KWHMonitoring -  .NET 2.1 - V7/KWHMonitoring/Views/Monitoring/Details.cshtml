                                            durationMinutes: item.durationMinutes || item.DurationMinutes,
                                            responseTimeMinutes: item.responseTimeMinutes || item.ResponseTimeMinutes,
                                            revenueLoss: item.revenueLoss || item.RevenueLoss || 0,
                                            anomalyCostImpact: item.anomalyCostImpact || item.AnomalyCostImpact || 0
