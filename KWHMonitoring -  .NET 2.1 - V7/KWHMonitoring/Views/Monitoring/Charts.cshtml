@model KWHMonitoring.Models.DashboardViewModel
@{
    ViewData["Title"] = "All Charts";
}

<!-- Breadcrumb -->
<div class="erp-breadcrumb">
    <a asp-controller="Monitoring" asp-action="Index"><i class="fas fa-home"></i> Dashboard</a>
    <span class="separator"><i class="fas fa-chevron-right" style="font-size:0.6rem"></i></span>
    <span class="current">All Charts</span>
</div>

<!-- Page Header -->
<div class="erp-page-header">
    <div>
        <h2><i class="fas fa-chart-line text-primary"></i> All Charts</h2>
        <div class="subtitle">
            <i class="fas fa-clock"></i> Last Update: <span class="last-update">-</span>
            <span class="ms-2"><i class="fas fa-circle text-success" style="font-size:0.5rem"></i> <span class="status-text">Online</span></span>
        </div>
    </div>
    <div class="actions">
        <button class="btn btn-erp-action" id="btnRefresh">
            <i class="fas fa-sync-alt"></i> <span class="d-none d-sm-inline">Refresh</span>
        </button>
        <button class="btn btn-erp-action" id="btnSettings">
            <i class="fas fa-cog"></i><span class="d-none d-sm-inline"> EMA Settings</span>
        </button>
    </div>
</div>

<!-- Tabs (ERP Style) -->
<div class="erp-tabs">
    <a class="erp-tab" asp-controller="Monitoring" asp-action="Index">
        <i class="fas fa-th"></i> <span>Panel Monitoring</span>
    </a>
    <a class="erp-tab active" asp-controller="Monitoring" asp-action="Charts">
        <i class="fas fa-chart-line"></i> <span>All Charts</span>
    </a>
    <a class="erp-tab" asp-controller="Monitoring" asp-action="UsageStatistics">
        <i class="fas fa-chart-bar"></i> <span>Usage Stats</span>
    </a>
    <a class="erp-tab" asp-controller="Monitoring" asp-action="AnomalyLogs">
        <i class="fas fa-exclamation-triangle"></i> <span>Anomaly Logs</span>
    </a>
</div>

    <!-- Chart Filter Bar -->
    <div class="d-flex justify-content-between align-items-center mb-2 mb-md-3 flex-wrap gap-2">
        <h5 class="mb-0"><i class="fas fa-chart-line"></i> All Charts</h5>
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <small class="text-muted" id="chartFilterInfo">Menampilkan <strong id="chartFilteredCount">@Model.Panels.Count</strong>/<strong id="chartTotalCount">@Model.Panels.Count</strong> panel</small>
            <button class="btn btn-sm btn-outline-primary" type="button" data-toggle="collapse" data-target="#chartFilterCollapse" aria-expanded="false" title="Toggle filter">
                <i class="fas fa-filter"></i> Filter
            </button>
        </div>
    </div>

    <div class="collapse mb-3" id="chartFilterCollapse">
        <div class="filter-bar-container">
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <div class="position-relative flex-grow-1" style="min-width: 200px; max-width: 320px;">
                    <i class="fas fa-search position-absolute text-muted" style="left: 10px; top: 50%; transform: translateY(-50%); font-size: 0.8rem;"></i>
                    <input type="text" id="chartSearch" class="form-control form-control-sm ps-4" placeholder="Cari panel..." />
                </div>
                <select id="chartCategoryFilter" class="form-select form-select-sm" style="width: auto; min-width: 140px;">
                    <option value="all">🏷️ Semua Kategori</option>
                </select>
                <button id="btnClearChartFilter" class="btn btn-sm btn-outline-secondary" title="Reset filter">
                    <i class="fas fa-times"></i>
                </button>
            </div>
            <div class="mt-2 d-flex flex-wrap gap-1" id="chartChipList"></div>
        </div>
    </div>

    <!-- Charts Grid Container -->
    <div class="chart-grid" id="chartsContainer">
    @foreach (var panel in Model.Panels)
    {
        var safeKey = panel.DeviceKey.Replace("-", "_");
        <div id="chartCard_@safeKey" data-device-key="@panel.DeviceKey" data-group-name="@panel.GroupName" data-category="Billboard">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center py-2" style="gap: 8px;">
                    <h6 class="mb-0 flex-grow-1 text-truncate" style="font-size:0.82rem; min-width: 0;">
                        <i class="fas fa-chart-area"></i> @panel.GroupName
                    </h6>
                    <div class="d-flex align-items-center flex-shrink-0 chart-controls" style="gap: 4px;" data-card-id="chartCard_@safeKey">
                        <select class="category-selector cat-Billboard" id="categorySelect_@safeKey" data-device-key="@panel.DeviceKey" data-safe-key="@safeKey" title="Pilih kategori device">
                            <option value="Billboard" selected>🔵 Billboard</option>
                        </select>
                        <select class="chart-type-selector" id="chartTypeSelect_@safeKey" data-safe-key="@safeKey">
                            <option value="power" selected>⚡ Power (W)</option>
                            <option value="voltage">🔌 Voltage (V)</option>
                            <option value="current">⚡ Current (A)</option>
                        </select>
                    </div>
                </div>
                <div class="card-body p-2 p-md-3">
                    <div class="chart-view-container">
                        <div class="chart-loading" id="chartLoading_@safeKey" style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;color:#999;font-size:0.85rem;">
                            <i class="fas fa-spinner fa-spin me-2"></i> Loading chart...
                        </div>
                        <div class="chart-view-power" data-chart-type="power">
                            <canvas id="powerChart_@safeKey"></canvas>
                        </div>
                        <div class="chart-view-voltage" data-chart-type="voltage" style="display:none;">
                            <canvas id="voltageChart_@safeKey"></canvas>
                        </div>
                        <div class="chart-view-current" data-chart-type="current" style="display:none;">
                            <canvas id="currentChart_@safeKey"></canvas>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    </div>
</div>

<!-- EMA & Chart Settings Modal -->
<div class="modal fade" id="emaSettingsModal" tabindex="-1">
    <div class="modal-dialog ema-modal-dialog">
        <div class="modal-content ema-modal-content">
            <div class="modal-header bg-primary text-white py-2">
                <h6 class="modal-title mb-0"><i class="fas fa-cog"></i> EMA & Chart Settings</h6>
                <button type="button" class="close text-white" data-dismiss="modal"><span>&times;</span></button>
            </div>
            <div class="modal-body ema-modal-body">
                <ul class="nav nav-tabs nav-tabs-sm mb-2" id="emaModalTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <a class="nav-link active" id="ema-tab-inner" data-toggle="tab" href="#emaTabContent" role="tab">
                            <i class="fas fa-chart-line"></i> EMA
                        </a>
                    </li>
                    <li class="nav-item" role="presentation">
                        <a class="nav-link" id="downtime-tab-inner" data-toggle="tab" href="#downtimeTabContent" role="tab">
                            <i class="fas fa-moon"></i> Downtime
                        </a>
                    </li>
                    <li class="nav-item" role="presentation">
                        <a class="nav-link" id="display-tab-inner" data-toggle="tab" href="#displayTabContent" role="tab">
                            <i class="fas fa-th"></i> Display
                        </a>
                    </li>
                </ul>

                <div class="tab-content">
                    <!-- EMA TAB -->
                    <div class="tab-pane active" id="emaTabContent" role="tabpanel">
                        @* <div class="ema-info-banner">
                            <i class="fas fa-info-circle"></i>
                            <strong>EMA</strong> — Exponential Moving Average untuk deteksi anomali pada chart Power.
                        </div> *@

                        <div class="mb-2">
                            <label class="form-label ema-label">Threshold Mode</label>
                            <div class="btn-group w-100 ema-btn-group" role="group">
                                <input type="radio" class="btn-check" name="thresholdMode" id="modeManual" value="manual" checked>
                                <label class="btn btn-outline-primary ema-btn-sm" for="modeManual"><i class="fas fa-percentage"></i> Manual (%)</label>
                                <input type="radio" class="btn-check" name="thresholdMode" id="modeFibonacci" value="fibonacci">
                                <label class="btn btn-outline-primary ema-btn-sm" for="modeFibonacci"><i class="fas fa-infinity"></i> Fibonacci (φ)</label>
                            </div>
                        </div>

                        <div id="manualSettings">
                            <div class="ema-grid-2 mb-2">
                                <div>
                                    <label class="form-label ema-label">Upper Threshold (%)</label>
                                    <input type="number" class="form-control form-control-sm" id="upperThreshold" value="30" min="1" max="1000">
                                    <small class="text-muted ema-hint">Di atas EMA → OVERLOAD</small>
                                </div>
                                <div>
                                    <label class="form-label ema-label">Lower Threshold (%)</label>
                                    <input type="number" class="form-control form-control-sm" id="lowerThreshold" value="50" min="1" max="100">
                                    <small class="text-muted ema-hint">Di bawah EMA → DEVICE DROP</small>
                                </div>
                            </div>
                        </div>

                        <div id="fibonacciSettings" style="display: none;">
                            <div class="ema-grid-2 mb-2">
                                <div>
                                    <label class="form-label ema-label text-danger">Upper (φ)</label>
                                    <select class="form-select form-select-sm" id="fibUpper">
                                        <option value="1.272">1.272 (√φ)</option>
                                        <option value="1.618" selected>1.618 (φ)</option>
                                        <option value="2.000">2.000 (2×)</option>
                                        <option value="2.618">2.618 (φ²)</option>
                                        <option value="3.236">3.236 (2φ)</option>
                                        <option value="4.236">4.236 (φ³)</option>
                                    </select>
                                </div>
                                <div>
                                    <label class="form-label ema-label text-warning">Lower (1/φ)</label>
                                    <select class="form-select form-select-sm" id="fibLower">
                                        <option value="0.236">0.236</option>
                                        <option value="0.382">0.382</option>
                                        <option value="0.500">0.500</option>
                                        <option value="0.618" selected>0.618 (1/φ)</option>
                                        <option value="0.786">0.786</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div class="ema-grid-2 mb-2">
                            <div>
                                <label class="form-label ema-label">EMA Period</label>
                                <input type="number" class="form-control form-control-sm" id="emaPeriod" value="20" min="1" max="1000000" step="1">
                                <small class="text-muted ema-hint">Kecil = responsif, Besar = smooth</small>
                            </div>
                            <div>
                                <label class="form-label ema-label">Auto-Refresh (sec)</label>
                                <input type="number" class="form-control form-control-sm" id="refreshInterval" value="10" min="5" max="300">
                            </div>
                        </div>

                        <div class="ema-check-group">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="showEMA" checked>
                                <label class="form-check-label">Show EMA Line</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="showThresholds" checked>
                                <label class="form-check-label">Show Threshold Lines</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="useInitial100ForEma">
                                <label class="form-check-label">Use 100 Initial Points Baseline</label>
                            </div>
                        </div>
                        <small class="text-muted ema-hint">Baseline: EMA diambil dari 100 data pertama device. Jika off, gunakan EMA biasa.</small>
                    </div>

                    <!-- DOWNTIME TAB — Per Category (Dynamic) -->
                  <div class="tab-pane fade" id="downtimeTabContent" role="tabpanel">
                        <!-- Preset Buttons — per kategori aktif -->
                        <div class="mb-2">
                            <label class="form-label ema-label">Preset Waktu <small class="text-muted">(kategori aktif)</small></label>
                            <div class="d-flex flex-wrap gap-1">
                                <button type="button" class="btn btn-outline-dark btn-sm ema-preset-btn" data-start="22" data-end="6" data-desc="Shift Malam - Listrik dimatikan">
                                    <i class="fas fa-moon"></i> Malam <small>22:00-06:00</small>
                                </button>
                                <button type="button" class="btn btn-outline-dark btn-sm ema-preset-btn" data-start="12" data-end="13" data-desc="Istirahat Siang - Listrik dimatikan">
                                    <i class="fas fa-utensils"></i> Istirahat <small>12:00-13:00</small>
                                </button>
                                <button type="button" class="btn btn-outline-dark btn-sm ema-preset-btn" data-start="21" data-end="5" data-desc="Shift Malam Awal - Listrik dimatikan">
                                    <i class="fas fa-cloud-moon"></i> Malam Awal <small>21:00-05:00</small>
                                </button>
                                <button type="button" class="btn btn-outline-dark btn-sm ema-preset-btn" data-start="0" data-end="0" data-desc="Custom downtime period">
                                    <i class="fas fa-sliders-h"></i> Custom <small>Atur manual</small>
                                </button>
                            </div>
                        </div>

                        <!-- Category sub-tabs — built dynamically, horizontally scrollable -->
                        <ul class="nav nav-tabs nav-tabs-sm mb-2" id="downtimeCategoryTabs" role="tablist"></ul>
                        <div class="tab-content" id="downtimeCategoryTabContent"></div>
                    </div>

                    <!-- DISPLAY TAB -->
                    <div class="tab-pane" id="displayTabContent" role="tabpanel">
                        <div class="ema-grid-2 mb-2">
                            <div>
                                <label class="form-label ema-label">Chart Data Points</label>
                                <input type="number" class="form-control form-control-sm" id="chartDataPoints" value="20" min="10" max="100">
                                <small class="text-muted ema-hint">Jumlah titik data (10-100)</small>
                            </div>
                            <div>
                                <label class="form-label ema-label">Grid Color</label>
                                <input type="color" class="form-control form-control-color form-control-sm" id="chartGridColor" value="#e0e0e0">
                            </div>
                        </div>
                        <div class="ema-check-group">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="chartShowGrid" checked>
                                <label class="form-check-label">Show Grid Lines</label>
                            </div>
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="chartShowLegend" checked>
                                <label class="form-check-label">Show Legend</label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer py-2">
                <button type="button" class="btn btn-secondary btn-sm" data-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary btn-sm" id="btnSaveEmaSettings">
                    <i class="fas fa-save"></i> Save All Settings
                </button>
            </div>
        </div>
    </div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.2/dist/chart.umd.min.js" crossorigin="anonymous"></script>
    <script>
        // ============================================
        // CHART TYPE SELECTOR (Dropdown)
        // ============================================
        function switchChartType(safeKey, chartType) {
            var $card = $('#chartCard_' + safeKey);
            if ($card.length === 0) return;

            // Hide all chart views
            $card.find('[data-chart-type]').hide();

            // Show selected chart
            $card.find('[data-chart-type="' + chartType + '"]').show();

            // Resize the visible chart to fit container
            var chartKey = chartType + '_' + safeKey;
            if (charts[chartKey]) {
                charts[chartKey].resize();
            }
        }

        $(document).on('change', '.chart-type-selector', function() {
            var safeKey = $(this).data('safe-key');
            var chartType = $(this).val();
            switchChartType(safeKey, chartType);
        });

        // ============================================
        // CONFIGURATION
        // ============================================
        var charts = {};
        var refreshTimer = null;
        var deviceCategoryMap = {};
        var categoryDowntimeMap = {};
        var categoryMetaMap = {};
        function loadCategoriesMetaForCharts() {
            return $.ajax({
                url: '/api/Api/categories',
                method: 'GET',
                dataType: 'json',
                timeout: 10000,
                success: function(data) {
                    categoryMetaMap = {};
                    (data || []).forEach(function(cat) {
                        categoryMetaMap[cat.name] = { icon: cat.icon, color: cat.color, description: cat.description };
                    });
                    if (typeof injectCategoryStyles === 'function') injectCategoryStyles(data);
                    categoryLabels = buildCategoryLabels();
                    populateChartCategoryFilter();
                    populateAllCategorySelectors();
                    buildDowntimeCategoryTabs();
                    // Expose globally for _AnomalyService
                    window._categoryMetaMap = categoryMetaMap;
                },
                error: function() { console.warn('Failed to load categories meta'); }
            });
        }
        var panelList = @Html.Raw(Json.Serialize(Model.Panels.Select(p => new {
            deviceKey = p.DeviceKey,
            safeKey = p.DeviceKey.Replace("-", "_"),
            groupName = p.GroupName,
            isThreePhase = p.IsThreePhase,
            deviceCategory = "Billboard"
        }).ToList()));

        // ============================================
        // DEVICE CATEGORY MANAGEMENT
        // ============================================
        function loadDeviceCategories() {
            return $.ajax({
                url: '/api/Api/device-categories',
                method: 'GET',
                dataType: 'json',
                timeout: 10000,
                success: function(data) {
                    if (data.devices) {
                        deviceCategoryMap = data.devices;
                    }
                    // Update panelList and UI
                    panelList.forEach(function(panel) {
                        var cat = deviceCategoryMap[panel.deviceKey] || 'Billboard';
                        panel.deviceCategory = cat;
                        updateCategorySelectorUI(panel.safeKey, cat);
                    });
                    // Re-apply filter after categories are loaded
                    applyChartFilter();
                    console.log('Device categories loaded:', deviceCategoryMap);
                },
                error: function() { console.warn('Failed to load device categories'); }
            });
        }

        function updateCategorySelectorUI(safeKey, category) {
            var $sel = $('#categorySelect_' + safeKey);
            if ($sel.length === 0) return;

            $sel.val(category);
            // Remove any existing cat-* class dynamically
            var existingClasses = ($sel.attr('class') || '').split(/\s+/).filter(function(c) { return c.startsWith('cat-'); });
            if (existingClasses.length) $sel.removeClass(existingClasses.join(' '));
            $sel.addClass('cat-' + category);

            var $card = $('#chartCard_' + safeKey);
            if ($card.length) {
                $card.attr('data-category', category);
            }
        }

        function saveDeviceCategory(deviceKey, category) {
            return $.ajax({
                url: '/api/Api/device-category',
                method: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({ deviceKey: deviceKey, category: category }),
                success: function(data) {
                    if (data.success) {
                        deviceCategoryMap[deviceKey] = category;
                        var safeKey = deviceKey.replace(/-/g, '_');
                        updateCategorySelectorUI(safeKey, category);
                        // Reload charts with new category downtime
                        checkCategoryDowntime(category).then(function() {
                            loadChartData(deviceKey, safeKey);
                        });
                    }
                },
                error: function() { alert('Gagal menyimpan kategori device'); }
            });
        }

        // Category selector change → save
        $(document).on('change', '.category-selector', function() {
            var deviceKey = $(this).data('device-key');
            var category = $(this).val();
            saveDeviceCategory(deviceKey, category);
        });

        // ============================================
        // CATEGORY-AWARE DOWNTIME
        // ============================================
        function checkCategoryDowntime(category) {
            if (!category) category = 'Billboard';
            return $.ajax({
                url: '/api/Api/downtime-status?category=' + encodeURIComponent(category),
                method: 'GET',
                dataType: 'json',
                timeout: 5000,
                success: function(data) {
                    categoryDowntimeMap[category] = data.isDowntime || false;
                    console.log('Downtime status for ' + category + ':', data.isDowntime ? 'DOWNTIME' : 'NORMAL');
                },
                error: function() { console.warn('Failed to check downtime for ' + category); }
            });
        }

        function loadAllCategoryDowntime() {
            var categories = Object.keys(categoryMetaMap || {}).length > 0 ? Object.keys(categoryMetaMap) : ['Billboard'];
            var promises = categories.map(function(cat) {
                return checkCategoryDowntime(cat);
            });
            return $.when.apply($, promises);
        }

        function isDowntimeForDevice(deviceKey) {
            var cat = deviceCategoryMap[deviceKey] || 'Billboard';
            return categoryDowntimeMap[cat] || false;
        }

        // ============================================
        // CHART FILTER LOGIC
        // ============================================
        var chartFilterDebounce = null;
        var activeChartChipDeviceKey = null;
        var chartAnomalyStatusMap = {};

        function getChartChipClass(deviceKey) {
            var anomaly = chartAnomalyStatusMap[deviceKey];
            if (anomaly === 'OVERLOAD') return 'chip-high';
            if (anomaly === 'DROP') return 'chip-medium';
            return 'chip-normal';
        }

        function renderChartChips() {
            var $list = $('#chartChipList');
            $list.empty();

            if (panelList.length === 0) return;

            var sorted = panelList.slice().sort(function(a, b) {
                var aAnomaly = chartAnomalyStatusMap[a.deviceKey] || '';
                var bAnomaly = chartAnomalyStatusMap[b.deviceKey] || '';
                var order = { 'OVERLOAD': 0, 'DROP': 1, '': 2 };
                var aOrder = order[aAnomaly] !== undefined ? order[aAnomaly] : 2;
                var bOrder = order[bAnomaly] !== undefined ? order[bAnomaly] : 2;
                if (aOrder !== bOrder) return aOrder - bOrder;
                var nameA = (a.groupName || a.deviceKey).toLowerCase();
                var nameB = (b.groupName || b.deviceKey).toLowerCase();
                return nameA.localeCompare(nameB);
            });

            // "All" chip
            var $allChip = $('<span>')
                .addClass('panel-chip ' + (activeChartChipDeviceKey === null ? 'chip-normal active' : 'chip-normal'))
                .attr('data-device-key', '__all__')
                .html('<span class="chip-dot"></span>Semua')
                .on('click', function() {
                    activeChartChipDeviceKey = null;
                    $list.find('.panel-chip').removeClass('active');
                    $(this).addClass('active');
                    applyChartFilter();
                });
            $list.append($allChip);

            sorted.forEach(function(panel) {
                var chipClass = getChartChipClass(panel.deviceKey);
                var label = panel.groupName || panel.deviceKey;
                var isActive = activeChartChipDeviceKey === panel.deviceKey;

                var $chip = $('<span>')
                    .addClass('panel-chip ' + chipClass + (isActive ? ' active' : ''))
                    .attr('data-device-key', panel.deviceKey)
                    .html('<span class="chip-dot"></span>' + label)
                    .on('click', function() {
                        activeChartChipDeviceKey = panel.deviceKey;
                        $list.find('.panel-chip').removeClass('active');
                        $(this).addClass('active');
                        applyChartFilter();
                    });

                $list.append($chip);
            });
        }

        function applyChartFilter() {
            var search = $('#chartSearch').val().trim().toLowerCase();
            var category = $('#chartCategoryFilter').val();
            var visibleCount = 0;

            panelList.forEach(function(panel) {
                var $card = $('#chartCard_' + panel.safeKey);
                if ($card.length === 0) return;

                var show = true;

                // Chip filter
                if (activeChartChipDeviceKey && panel.deviceKey !== activeChartChipDeviceKey) {
                    show = false;
                }

                // Search filter
                if (show && search) {
                    var groupName = (panel.groupName || '').toLowerCase();
                    var deviceKey = panel.deviceKey.toLowerCase();
                    if (!groupName.includes(search) && !deviceKey.includes(search)) {
                        show = false;
                    }
                }

                // Category filter
                if (show && category && category !== 'all') {
                    var panelCategory = panel.deviceCategory || deviceCategoryMap[panel.deviceKey] || 'Billboard';
                    if (panelCategory !== category) show = false;
                }

                if (show) {
                    $card.show();
                    visibleCount++;
                } else {
                    $card.hide();
                }
            });

            $('#chartFilteredCount').text(visibleCount);
            $('#chartTotalCount').text(panelList.length);
        }

        function setupChartFilterEvents() {
            $('#chartSearch').on('input', function() {
                clearTimeout(chartFilterDebounce);
                chartFilterDebounce = setTimeout(applyChartFilter, 200);
            });

            $('#chartCategoryFilter').on('change', applyChartFilter);

            $('#btnClearChartFilter').on('click', function() {
                $('#chartSearch').val('');
                $('#chartCategoryFilter').val('all');
                activeChartChipDeviceKey = null;
                $('#chartChipList').find('.panel-chip').removeClass('active');
