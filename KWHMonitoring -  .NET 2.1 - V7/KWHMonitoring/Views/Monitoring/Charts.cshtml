        // ============================================
        // EMA CALCULATION HELPER
        // ============================================
        function fetchAndApplyEma(deviceKey, powerData) {
            if (!deviceKey) {
                console.warn('fetchAndApplyEma: deviceKey is missing, using regular EMA');
                return $.Deferred().resolve(calculateEMA(powerData, emaSettings.period)).promise();
            }

            if (emaSettings.useInitial100ForEma) {
                // Gunakan Promise-based AJAX (non-blocking) untuk fetch EMA baseline
                return $.ajax({
                    url: '/api/Api/get-initial-ema/' + encodeURIComponent(deviceKey),
                    method: 'GET',
                    dataType: 'json',
                    timeout: 10000
                }).then(function(initialData) {
                    if (initialData.success && initialData.emaBaseline != null) {
                        var emaBaseline = initialData.emaBaseline;
                        console.log('Using EMA Baseline for ' + deviceKey + ':', emaBaseline);
                        return calculateEMAWithBaseline(powerData, emaSettings.period, emaBaseline);
                    } else {
                        console.log('No EMA baseline found, using regular EMA');
                        return calculateEMA(powerData, emaSettings.period);
                    }
                }).fail(function() {
                    console.log('Error fetching EMA baseline, using regular EMA');
                    return calculateEMA(powerData, emaSettings.period);
                });
            } else {
                // EMA biasa tanpa baseline - return resolved Promise
                return $.Deferred().resolve(calculateEMA(powerData, emaSettings.period)).promise();
            }
        }

        // ============================================
        // DATA LOADING WITH EMA + DOWNTIME
        // ============================================
        function loadChartData(deviceKey, safeKey) {
            // Guard: skip if deviceKey is empty to prevent invalid API calls
            if (!deviceKey || deviceKey.trim() === '') return;

            var points = systemSettings.chartDataPoints || 20;
            $.ajax({
                url: '/api/Api/panels/' + deviceKey + '/chart?points=' + points,
                method: 'GET',
                dataType: 'json',
                timeout: 10000,
                success: function(data) {
                    // Hide loading spinner
                    $('#chartLoading_' + safeKey).hide();
                    try {
                        if (charts['voltage_' + safeKey] && data.voltage) {
                            charts['voltage_' + safeKey].data.labels = data.labels || [];
                            charts['voltage_' + safeKey].data.datasets[0].data = data.voltage.r || [];
                            if (charts['voltage_' + safeKey].data.datasets.length > 1) {
                                charts['voltage_' + safeKey].data.datasets[1].data = data.voltage.s || [];
                            }
                            if (charts['voltage_' + safeKey].data.datasets.length > 2) {
                                charts['voltage_' + safeKey].data.datasets[2].data = data.voltage.t || [];
                            }
                            charts['voltage_' + safeKey].update('none');
                        }

                        if (charts['current_' + safeKey] && data.current) {
                            charts['current_' + safeKey].data.labels = data.labels || [];
                            charts['current_' + safeKey].data.datasets[0].data = data.current.r || [];
                            if (charts['current_' + safeKey].data.datasets.length > 1) {
                                charts['current_' + safeKey].data.datasets[1].data = data.current.s || [];
                            }
                            if (charts['current_' + safeKey].data.datasets.length > 2) {
                                charts['current_' + safeKey].data.datasets[2].data = data.current.t || [];
                            }
                            charts['current_' + safeKey].update('none');
                        }

                        if (charts['power_' + safeKey] && data.power) {
                            var powerData = data.power || [];
                            charts['power_' + safeKey].data.labels = data.labels || [];
                            charts['power_' + safeKey].data.datasets[0].data = powerData;

                            // Update max capacity line (per-device, only if enabled)
                            if (emaSettings.showMaxCapacity) {
                                var mcDs = (window.getDeviceSettings && window.getDeviceSettings(deviceKey)) || {};
                                var mcValue = mcDs.maxCapacity || 0;
                                // Find Max Capacity dataset by label
                                for (var i = 0; i < charts['power_' + safeKey].data.datasets.length; i++) {
                                    if (charts['power_' + safeKey].data.datasets[i].label.indexOf('Max Capacity') === 0) {
                                        if (mcValue > 0) {
                                            charts['power_' + safeKey].data.datasets[i].data = powerData.map(function() { return mcValue; });
                                            charts['power_' + safeKey].data.datasets[i].label = 'Max Capacity (' + mcValue.toLocaleString('id-ID') + ' W)';
                                            charts['power_' + safeKey].data.datasets[i].borderColor = '#8e44ad';
                                            charts['power_' + safeKey].data.datasets[i].borderDash = [15, 5];
                                        } else {
                                            charts['power_' + safeKey].data.datasets[i].data = [];
                                            charts['power_' + safeKey].data.datasets[i].label = 'Max Capacity (-)';
                                            charts['power_' + safeKey].data.datasets[i].borderColor = 'transparent';
                                        }
                                        break;
                                    }
                                }
                            }

                            // Calculate and add EMA (Promise-based, non-blocking)
                            if (emaSettings.showEMA && charts['power_' + safeKey].data.datasets[1]) {
                                var _deviceKey = data.deviceKey || deviceKey;
                                fetchAndApplyEma(_deviceKey, powerData).done(function(ema) {
                                    try {
                                        charts['power_' + safeKey].data.datasets[1].data = ema;
                                        charts['power_' + safeKey].data.datasets[1].label = emaSettings.useInitial100ForEma ? 'SMA 100 (Baseline)' : 'EMA ' + emaSettings.period;
                                        charts['power_' + safeKey].data.datasets[1].tension = emaSettings.useInitial100ForEma ? 0 : 0.3;

                                        // Calculate and add Thresholds (per-device EMA thresholds)
                                        if (emaSettings.showThresholds && charts['power_' + safeKey].data.datasets[2]) {
                                            var ds = (window.getDeviceSettings && window.getDeviceSettings(deviceKey)) || {};
                                            var upperValue = ds.emaUpperThreshold || 0;
                                            var lowerValue = ds.emaLowerThreshold || 0;

                                            // Calculate thresholds only when at least one value is configured
                                            var thresholds = (upperValue > 0 || lowerValue > 0)
                                                ? calculateThresholds(ema, 'manual', upperValue, lowerValue)
                                                : { upper: [], lower: [] };

                                            // Upper line: only draw if configured (> 0)
                                            if (upperValue > 0) {
                                                charts['power_' + safeKey].data.datasets[2].data = thresholds.upper;
                                                charts['power_' + safeKey].data.datasets[2].label = 'Upper (+' + upperValue + '%)';
                                                charts['power_' + safeKey].data.datasets[2].tension = emaSettings.useInitial100ForEma ? 0 : 0;
                                                charts['power_' + safeKey].data.datasets[2].borderColor = '#ff0000';
                                            } else {
                                                charts['power_' + safeKey].data.datasets[2].data = [];
                                                charts['power_' + safeKey].data.datasets[2].borderColor = 'transparent';
                                            }

                                            // Lower line: only draw if configured (> 0) AND not in downtime
                                            if (charts['power_' + safeKey].data.datasets[3]) {
                                                var deviceDowntime = isDowntimeForDevice(deviceKey);
                                                if (lowerValue <= 0 || deviceDowntime) {
                                                    charts['power_' + safeKey].data.datasets[3].data = [];
                                                    charts['power_' + safeKey].data.datasets[3].borderColor = 'transparent';
                                                    charts['power_' + safeKey].data.datasets[3].label = lowerValue <= 0 ? 'Lower (-)' : 'Lower (Downtime)';
                                                } else {
                                                    charts['power_' + safeKey].data.datasets[3].data = thresholds.lower;
                                                    charts['power_' + safeKey].data.datasets[3].borderColor = '#ff9900';
                                                    charts['power_' + safeKey].data.datasets[3].label = 'Lower (-' + lowerValue + '%)';
                                                    charts['power_' + safeKey].data.datasets[3].tension = emaSettings.useInitial100ForEma ? 0 : 0;
                                                }
                                            }
                                        }

                                        charts['power_' + safeKey].update('none');
                                    } catch(err) {
                                        console.error('Error applying EMA to chart:', err);
                                    }
                                });
                            } else {
                                charts['power_' + safeKey].update('none');
                            }
                        }
                    } catch(e) {
                        console.error('Error updating charts for ' + deviceKey + ':', e);
                    }
                },
                error: function(xhr, status, error) {
                    console.error('Error loading chart for ' + deviceKey + ':', error);
                }
            });
        }

        // ============================================
        // AUTO REFRESH
        // ============================================
        function startAutoRefresh() {
            if (refreshTimer) clearInterval(refreshTimer);
            refreshTimer = setInterval(function() {
                panelList.forEach(function(panel) {
                    loadChartData(panel.deviceKey, panel.safeKey);
                });
                
                // Trigger event untuk anomaly service setelah chart update
                setTimeout(function() {
                    window.dispatchEvent(new CustomEvent('chartDataUpdated'));
                }, 500); // Delay 500ms untuk memastikan chart selesai update
            }, systemSettings.refreshInterval * 1000);
        }

        // ============================================
        // REBUILD ALL CHARTS
        // ============================================
        function rebuildAllCharts() {
            panelList.forEach(function(panel) {
                if (charts['voltage_' + panel.safeKey]) { charts['voltage_' + panel.safeKey].destroy(); delete charts['voltage_' + panel.safeKey]; }
                if (charts['current_' + panel.safeKey]) { charts['current_' + panel.safeKey].destroy(); delete charts['current_' + panel.safeKey]; }
                if (charts['power_' + panel.safeKey]) { charts['power_' + panel.safeKey].destroy(); delete charts['power_' + panel.safeKey]; }
            });
            panelList.forEach(function(panel) {
                initPanelCharts(panel.deviceKey, panel.safeKey, panel.isThreePhase);
                loadChartData(panel.deviceKey, panel.safeKey);
            });
        }

