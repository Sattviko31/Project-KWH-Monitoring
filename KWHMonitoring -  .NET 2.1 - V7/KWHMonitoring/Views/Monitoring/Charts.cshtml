                var meta = categoryMetaMap[cat] || {};
                var icon = meta.icon || '⚪';
                $sel.append('<option value="' + cat + '">' + icon + ' ' + cat + '</option>');
            });
            if (currentVal && $sel.find('option[value="' + currentVal + '"]').length) {
                $sel.val(currentVal);
            }
        }

        function populateAllCategorySelectors() {
            var categories = Object.keys(categoryMetaMap || {}).length > 0 ? Object.keys(categoryMetaMap) : ['Billboard'];
            $('.category-selector').each(function() {
                var $sel = $(this);
                var currentVal = $sel.val() || 'Billboard';
                $sel.find('option').remove();
                categories.forEach(function(cat) {
                    var meta = categoryMetaMap[cat] || {};
                    var icon = meta.icon || '⚪';
                    $sel.append('<option value="' + cat + '">' + icon + ' ' + cat + '</option>');
                });
                if ($sel.find('option[value="' + currentVal + '"]').length) {
                    $sel.val(currentVal);
                } else {
                    $sel.val('Billboard');
                }
            });
        }

        function populateCategoryHourDropdowns() {
            var categories = Object.keys(categoryMetaMap || {}).length > 0 ? Object.keys(categoryMetaMap) : ['Billboard'];
            categories.forEach(function(cat) {
                var $start = $('#downtime' + cat + 'StartHour');
                var $end = $('#downtime' + cat + 'EndHour');
                $start.empty();
                $end.empty();
                for (var h = 0; h < 24; h++) {
                    var label = (h < 10 ? '0' : '') + h + ':00';
                    $start.append('<option value="' + h + '">' + label + '</option>');
                    $end.append('<option value="' + h + '">' + label + '</option>');
                }
                var s = categoryDowntimeSettings[cat];
                $start.val(s.startHour);
                $end.val(s.endHour);
            });
        }

        function updateCategoryDuration(cat) {
            var start = parseInt($('#downtime' + cat + 'StartHour').val());
            var end = parseInt($('#downtime' + cat + 'EndHour').val());
            var duration;
            if (start === end) duration = 24;
            else if (start < end) duration = end - start;
            else duration = (24 - start) + end;
            $('#downtime' + cat + 'Duration').text(duration + ' jam');
        }

        function loadCategoryDowntimeSettings() {
            var categories = Object.keys(categoryMetaMap || {}).length > 0 ? Object.keys(categoryMetaMap) : ['Billboard'];
            var promises = categories.map(function(cat) {
                return $.ajax({
                    url: '/api/Api/downtime-settings/' + cat,
                    method: 'GET',
                    dataType: 'json',
                    timeout: 10000,
                    success: function(data) {
                        categoryDowntimeSettings[cat] = {
                            enabled: data.enabled || false,
                            startHour: data.startHour != null ? data.startHour : 22,
                            endHour: data.endHour != null ? data.endHour : 6,
                            description: data.description || ''
                        };
                    }
                });
            });
            return $.when.apply($, promises);
        }

        function updateCategoryDowntimeStatusUI(cat) {
            var $status = $('#downtime' + cat + 'Status');
            var $card = $('#downtime' + cat + 'StatusCard');
            var isDowntime = categoryDowntimeMap[cat] || false;
            var s = categoryDowntimeSettings[cat];
            var startLabel = (s.startHour < 10 ? '0' : '') + s.startHour + ':00';
            var endLabel = (s.endHour < 10 ? '0' : '') + s.endHour + ':00';
            if (isDowntime) {
                $status.html('<span class="text-danger"><i class="fas fa-moon"></i> DOWNTIME AKTIF</span><br><small class="text-muted">Downtime period active (' + startLabel + '–' + endLabel + ') - Lower threshold disabled</small>');
                $card.removeClass('border-success').addClass('border-danger');
            } else {
                $status.html('<span class="text-success"><i class="fas fa-sun"></i> OPERASI NORMAL</span><br><small class="text-muted">Normal operation - All thresholds active</small>');
                $card.removeClass('border-danger').addClass('border-success');
            }
        }

        // ============================================
        // UPDATE MODAL UI FROM LOADED SETTINGS
        // ============================================
        function updateSettingsModalUI() {
            // EMA
            $('#emaPeriod').val(emaSettings.period);
            $('#upperThreshold').val(emaSettings.upperThreshold);
            $('#lowerThreshold').val(emaSettings.lowerThreshold);
            $('#fibUpper').val(emaSettings.fibUpper);
            $('#fibLower').val(emaSettings.fibLower);
            $('#refreshInterval').val(systemSettings.refreshInterval);
            $('#showEMA').prop('checked', emaSettings.showEMA);
            $('#showThresholds').prop('checked', emaSettings.showThresholds);
            $('#useInitial100ForEma').prop('checked', emaSettings.useInitial100ForEma || false);
            if (emaSettings.mode === 'manual') {
                $('#modeManual').prop('checked', true);
                $('#manualSettings').show();
                $('#fibonacciSettings').hide();
            } else {
                $('#modeFibonacci').prop('checked', true);
                $('#manualSettings').hide();
                $('#fibonacciSettings').show();
            }

            // Per-Category Downtime
            populateCategoryHourDropdowns();
            var categories = Object.keys(categoryMetaMap || {}).length > 0 ? Object.keys(categoryMetaMap) : ['Billboard'];
            categories.forEach(function(cat) {
                var s = categoryDowntimeSettings[cat];
                $('#downtime' + cat + 'Enabled').prop('checked', s.enabled);
                $('#downtime' + cat + 'StartHour').val(s.startHour);
                $('#downtime' + cat + 'EndHour').val(s.endHour);
                $('#downtime' + cat + 'Description').val(s.description);
                updateCategoryDuration(cat);
                updateCategoryDowntimeStatusUI(cat);
            });

            // Display
            $('#chartDataPoints').val(systemSettings.chartDataPoints);
            $('#chartShowGrid').prop('checked', systemSettings.showGrid);
            $('#chartShowLegend').prop('checked', systemSettings.showLegend);
            $('#chartGridColor').val(systemSettings.gridColor);
        }

        // ============================================
        // RESPONSIVE DROPDOWN LABELS
        // ============================================
        var COMPACT_THRESHOLD = 420; // px — card width below which dropdowns use compact labels

        function buildCategoryLabels() {
            var full = {}, compact = {};
            Object.keys(categoryMetaMap).forEach(function(name) {
                var meta = categoryMetaMap[name];
                full[name] = (meta.icon || '⚪') + ' ' + name;
                compact[name] = meta.icon || '⚪';
            });
            return { full: full, compact: compact };
        }
        var categoryLabels = buildCategoryLabels();
        var chartTypeLabels = {
            full:    { 'power': '⚡ Power (W)', 'voltage': '🔌 Voltage (V)', 'current': '⚡ Current (A)' },
            compact: { 'power': '⚡W', 'voltage': '🔌V', 'current': '⚡A' }
        };

        function updateDropdownLabels(cardEl, compact) {
            var labels = compact ? 'compact' : 'full';
            var $card = $(cardEl);

            $card.find('.category-selector').each(function() {
                var sel = this;
                var currentVal = sel.value;
                var map = categoryLabels[labels];
                $(sel).find('option').each(function() {
                    if (map[this.value]) this.textContent = map[this.value];
                });
                sel.value = currentVal; // preserve selection
            });

            $card.find('.chart-type-selector').each(function() {
                var sel = this;
                var currentVal = sel.value;
                var map = chartTypeLabels[labels];
                $(sel).find('option').each(function() {
                    if (map[this.value]) this.textContent = map[this.value];
                });
                sel.value = currentVal;
            });
        }

        function setupResponsiveDropdowns() {
            var observer = new ResizeObserver(function(entries) {
                entries.forEach(function(entry) {
                    var w = entry.contentRect.width;
                    var card = entry.target;
                    var compact = w < COMPACT_THRESHOLD;
                    // Only update if mode changed (avoid flicker on every pixel)
                    if (card._dropdownCompact !== compact) {
                        card._dropdownCompact = compact;
                        updateDropdownLabels(card, compact);
                    }
                });
            });

            // Observe each chart card in the grid
            document.querySelectorAll('.chart-grid > div').forEach(function(card) {
                // Set initial state
                var w = card.getBoundingClientRect().width;
                card._dropdownCompact = w < COMPACT_THRESHOLD;
                updateDropdownLabels(card, card._dropdownCompact);
                observer.observe(card);
            });
        }

        // ============================================
        // INITIALIZATION
        // ============================================
        $(document).ready(function() {
            updateLastUpdate();
            setInterval(updateLastUpdate, 60000);

            // Initialize chart filter
            setupChartFilterEvents();
            renderChartChips();
            updateChartAnomalyStatus();

            // Real-time update saat cooldown state berubah (dari anomaly service)
            window.addEventListener('anomalyCooldownChanged', function(e) {
                console.log('🔄 Anomaly cooldown changed (charts):', e.detail);
                updateChartAnomalyStatus();
            });

            // Load all settings in parallel, then init charts
            Promise.all([loadEmaSettings(), loadSystemSettings(), loadDowntimeSettings(), loadCategoriesMetaForCharts()]).then(function() {
                console.log('Settings loaded, loading categories...');
                // Load device categories, then category downtime settings, then init
                loadDeviceCategories().then(function() {
                    return loadCategoryDowntimeSettings();
                }).then(function() {
                    return loadAllCategoryDowntime();
                }).then(function() {
                    console.log('All settings + categories loaded, initializing charts...');
                    updateSettingsModalUI();
                    panelList.forEach(function(panel) {
                        initPanelCharts(panel.deviceKey, panel.safeKey, panel.isThreePhase);
                    });
                    panelList.forEach(function(panel) {
                        loadChartData(panel.deviceKey, panel.safeKey);
                    });
                    // Ensure charts render correctly after layout is settled
                    setTimeout(function() {
                        panelList.forEach(function(panel) {
                            ['power', 'voltage', 'current'].forEach(function(type) {
                                var key = type + '_' + panel.safeKey;
                                if (charts[key]) charts[key].resize();
                            });
                        });
                    }, 200);
                    setupResponsiveDropdowns();
                    startAutoRefresh();
                });

                // Periodically re-check category downtime status
                setInterval(function() {
                    loadAllCategoryDowntime().then(function() {
                        panelList.forEach(function(panel) {
                            loadChartData(panel.deviceKey, panel.safeKey);
                        });
                    });
                }, 60000);
            });

            // Refresh button
            $('#btnRefresh').click(function() {
                panelList.forEach(function(panel) {
                    loadChartData(panel.deviceKey, panel.safeKey);
                });
            });

            // Settings button — open modal
            $('#btnSettings').click(function() {
                Promise.all([loadEmaSettings(), loadSystemSettings(), loadDowntimeSettings(), loadCategoryDowntimeSettings(), loadAllCategoryDowntime()]).then(function() {
                    updateSettingsModalUI();
                    $('#emaSettingsModal').modal('show');
                });
            });

            // Fix nested tab: saat Downtime tab diklik, pastikan sub-tab content muncul
            $('a[href="#downtimeTabContent"]').on('click', function() {
                // Tunggu Bootstrap selesai proses tab switch, lalu force show sub-tab
                setTimeout(function() {
                    var $activeSub = $('#downtimeCategoryTabs .nav-link.active');
                    var targetId = $activeSub.attr('href') || '#downtimeBillboard';
                    // Force show sub-tab content
                    $('#downtimeCategoryTabContent .tab-pane').removeClass('active');
                    $(targetId).addClass('active');
                }, 50);
            });

            // Sub-tab switching di Downtime (manual handling untuk nested tab fix)
            $(document).on('click', '#downtimeCategoryTabs .nav-link', function(e) {
                e.preventDefault();
                var targetId = $(this).attr('href');
                // Update nav-link active state
                $('#downtimeCategoryTabs .nav-link').removeClass('active');
                $(this).addClass('active');
                // Update tab-pane active state
                $('#downtimeTabContent .tab-content .tab-pane').removeClass('active');
                $(targetId).addClass('active');
                // Clear preset highlight
                $('.ema-preset-btn').removeClass('active');
            });

            // Preset buttons — apply to currently active category only
            $(document).on('click', '.ema-preset-btn', function() {
                var start = parseInt($(this).data('start'));
                var end = parseInt($(this).data('end'));
                var desc = $(this).data('desc');

                // Highlight active preset
                $('.ema-preset-btn').removeClass('active');
                $(this).addClass('active');

                // Find currently active category
                var $activeTab = $('#downtimeCategoryTabs .nav-link.active');
                var href = $activeTab.attr('href') || '#downtimeBillboard';
                var cat = href.replace('#downtime', '');

                if (start === 0 && end === 0) {
                    // Custom — just focus the start hour
                    $('#downtime' + cat + 'StartHour').focus();
                } else {
                    $('#downtime' + cat + 'StartHour').val(start);
                    $('#downtime' + cat + 'EndHour').val(end);
                    $('#downtime' + cat + 'Description').val(desc);
                    updateCategoryDuration(cat);
                }
            });

            // Mode toggle
            $('input[name="thresholdMode"]').change(function() {
                if ($(this).val() === 'manual') {
                    $('#manualSettings').show();
                    $('#fibonacciSettings').hide();
                } else {
                    $('#manualSettings').hide();
                    $('#fibonacciSettings').show();
                }
            });

            // Per-category downtime hour change
            $(document).on('change', '.cat-downtime-start, .cat-downtime-end', function() {
                var cat = $(this).data('category');
                updateCategoryDuration(cat);
            });

            // Save All Settings
            $('#btnSaveEmaSettings').click(function() {
                var btn = $(this);
                btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Saving...');

                // Collect EMA settings
                var emaData = {
                    emaPeriod: parseInt($('#emaPeriod').val()) || 20,
                    emaMode: $('input[name="thresholdMode"]:checked').val() || 'manual',
                    emaUpperThreshold: parseInt($('#upperThreshold').val()) || 30,
                    emaLowerThreshold: parseInt($('#lowerThreshold').val()) || 50,
                    emaFibUpper: parseFloat($('#fibUpper').val()) || 1.618,
                    emaFibLower: parseFloat($('#fibLower').val()) || 0.618,
                    emaShowLine: $('#showEMA').is(':checked'),
                    emaShowThresholds: $('#showThresholds').is(':checked'),
                    useInitial100ForEma: $('#useInitial100ForEma').is(':checked'),
                    refreshInterval: parseInt($('#refreshInterval').val()) || 10,
                    chartDataPoints: parseInt($('#chartDataPoints').val()) || 20
                };

                // Collect per-category downtime settings
                var categories = Object.keys(categoryMetaMap || {}).length > 0 ? Object.keys(categoryMetaMap) : ['Billboard'];
                var catDowntimeRequests = categories.map(function(cat) {
                    var catData = {
                        enabled: $('#downtime' + cat + 'Enabled').is(':checked'),
                        startHour: parseInt($('#downtime' + cat + 'StartHour').val()) || 22,
                        endHour: parseInt($('#downtime' + cat + 'EndHour').val()) || 6,
                        description: $('#downtime' + cat + 'Description').val() || ''
                    };
                    categoryDowntimeSettings[cat] = catData;
                    return $.ajax({ url: '/api/Api/downtime-settings/' + cat, method: 'POST', contentType: 'application/json', data: JSON.stringify(catData) });
                });

                // Collect system/display settings
                var systemData = {
                    'Chart.DataPoints': $('#chartDataPoints').val() || '20',
                    'RefreshInterval': ($('#refreshInterval').val() || '10'),
                    'Chart.ShowGrid': $('#chartShowGrid').is(':checked').toString(),
                    'Chart.ShowLegend': $('#chartShowLegend').is(':checked').toString(),
                    'Chart.GridColor': $('#chartGridColor').val() || '#e0e0e0'
                };

                // Save all in parallel (EMA, per-category Downtime, System)
                var requests = [
                    $.ajax({ url: '/api/Api/save-ema-settings', method: 'POST', contentType: 'application/json', data: JSON.stringify(emaData) }),
                    $.ajax({ url: '/api/Api/save-system-settings', method: 'POST', contentType: 'application/json', data: JSON.stringify(systemData) })
                ].concat(catDowntimeRequests);

                $.when.apply($, requests).done(function() {
                    // Update local settings
                    emaSettings.period = emaData.emaPeriod;
                    emaSettings.mode = emaData.emaMode;
                    emaSettings.upperThreshold = emaData.emaUpperThreshold;
                    emaSettings.lowerThreshold = emaData.emaLowerThreshold;
                    emaSettings.fibUpper = emaData.emaFibUpper;
                    emaSettings.fibLower = emaData.emaFibLower;
                    emaSettings.showEMA = emaData.emaShowLine;
                    emaSettings.showThresholds = emaData.emaShowThresholds;
                    emaSettings.useInitial100ForEma = emaData.useInitial100ForEma || false;
                    emaSettings.refreshInterval = emaData.refreshInterval;

                    systemSettings.chartDataPoints = parseInt(systemData['Chart.DataPoints']) || 20;
                    systemSettings.refreshInterval = parseInt(systemData['RefreshInterval']) || 10;
                    systemSettings.showGrid = systemData['Chart.ShowGrid'] !== 'false';
                    systemSettings.showLegend = systemData['Chart.ShowLegend'] !== 'false';
                    systemSettings.gridColor = systemData['Chart.GridColor'] || '#e0e0e0';

                    // Re-check category downtime status and rebuild charts
                    loadAllCategoryDowntime().then(function() {
                        startAutoRefresh();
                        rebuildAllCharts();
                        categories.forEach(function(cat) {
                            updateCategoryDowntimeStatusUI(cat);
                        });
                    });

                    btn.prop('disabled', false).html('<i class="fas fa-save"></i> Save All Settings');
                    $('#emaSettingsModal').modal('hide');
                    var catSummary = categories.map(function(cat) {
                        return cat + ': ' + (categoryDowntimeSettings[cat].enabled ? 'Active' : 'Off');
                    }).join(', ');
                    alert('Settings saved!\nEMA Period: ' + emaSettings.period + '\nData Points: ' + systemSettings.chartDataPoints + '\nDowntime: ' + catSummary);
                }).fail(function() {
                    btn.prop('disabled', false).html('<i class="fas fa-save"></i> Save All Settings');
                    alert('Error saving settings. Please try again.');
                });
            });
        });
    </script>
}
