@model KWHMonitoring.Models.DashboardViewModel
@{
    ViewData["Title"] = "All Charts";
}

@await Html.PartialAsync("_DashboardHeader")

    <!-- Chart Filter Bar -->
    <div class="d-flex justify-content-between align-items-center mb-2 mb-md-3 flex-wrap gap-2">
        <h5 class="mb-0"><i class="fas fa-chart-line"></i> All Charts</h5>
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <small class="text-muted" id="chartFilterInfo">Menampilkan <strong id="chartFilteredCount">@Model.Panels.Count</strong>/<strong id="chartTotalCount">@Model.Panels.Count</strong> panel</small>
            <button class="btn btn-sm btn-outline-primary" type="button" data-toggle="collapse" data-target="#chartFilterCollapse" aria-expanded="false" title="Toggle filter">
                <i class="fas fa-filter"></i> Filter
            </button>
        </div>
    </div>

    <div class="collapse mb-3" id="chartFilterCollapse">
        <div class="filter-bar-container">
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <div class="position-relative flex-grow-1" style="min-width: 200px; max-width: 320px;">
                    <i class="fas fa-search position-absolute text-muted" style="left: 10px; top: 50%; transform: translateY(-50%); font-size: 0.8rem;"></i>
                    <input type="text" id="chartSearch" class="form-control form-control-sm ps-4" placeholder="Cari panel..." />
                </div>
                <select id="chartCategoryFilter" class="form-select form-select-sm" style="width: auto; min-width: 140px;">
                    <option value="all">🏷️ Semua Kategori</option>
                </select>
                <button id="btnClearChartFilter" class="btn btn-sm btn-outline-secondary" title="Reset filter">
                    <i class="fas fa-times"></i>
                </button>
            </div>
            <div class="mt-2 d-flex flex-wrap gap-1" id="chartChipList"></div>
        </div>
    </div>

    <!-- Charts Grid Container -->
    <div class="chart-grid" id="chartsContainer">
    @foreach (var panel in Model.Panels)
    {
        var safeKey = panel.DeviceKey.Replace("-", "_");
        <div id="chartCard_@safeKey" data-device-key="@panel.DeviceKey" data-group-name="@panel.GroupName" data-category="Billboard">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center py-2" style="gap: 8px;">
                    <h6 class="mb-0 flex-grow-1 text-truncate" style="font-size:0.82rem; min-width: 0;">
                        <i class="fas fa-chart-area"></i> @panel.GroupName
                    </h6>
                    <div class="d-flex gap-1 flex-shrink-0 align-items-center">
                        <span class="category-icon cat-Billboard" id="categoryIcon_@safeKey" data-device-key="@panel.DeviceKey" style="font-size: 1rem; cursor: default;"></span>
                    </div>
                    <div class="d-flex align-items-center flex-shrink-0 chart-controls" style="gap: 4px;" data-card-id="chartCard_@safeKey">
                        <select class="chart-type-selector" id="chartTypeSelect_@safeKey" data-safe-key="@safeKey">
                            <option value="power" selected>⚡ Power (W)</option>
                            <option value="voltage">🔌 Voltage (V)</option>
                            <option value="current">⚡ Current (A)</option>
                        </select>
                    </div>
                </div>
                <div class="card-body p-2 p-md-3">
                    <div class="chart-view-container">
                        <div class="chart-loading" id="chartLoading_@safeKey" style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;color:#999;font-size:0.85rem;">
                            <i class="fas fa-spinner fa-spin me-2"></i> Loading chart...
                        </div>
                        <div class="chart-view-power" data-chart-type="power">
                            <canvas id="powerChart_@safeKey"></canvas>
                        </div>
                        <div class="chart-view-voltage" data-chart-type="voltage" style="display:none;">
                            <canvas id="voltageChart_@safeKey"></canvas>
                        </div>
                        <div class="chart-view-current" data-chart-type="current" style="display:none;">
                            <canvas id="currentChart_@safeKey"></canvas>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    </div>
</div>

<!-- Chart Display Settings Modal -->
<div class="modal fade" id="emaSettingsModal" tabindex="-1">
    <div class="modal-dialog ema-modal-dialog">
        <div class="modal-content ema-modal-content">
            <div class="modal-header bg-primary text-white py-2">
                <h6 class="modal-title mb-0"><i class="fas fa-th"></i> Chart Display Settings</h6>
                <button type="button" class="close text-white" data-dismiss="modal"><span>&times;</span></button>
            </div>
            <div class="modal-body ema-modal-body">
                <div class="display-grid-2">
                    <div class="display-group">
                        <label class="form-label ema-label">Chart Data Points</label>
                        <input type="number" class="form-control form-control-sm" id="chartDataPoints" value="20" min="10" max="100">
                        <small class="text-muted ema-hint">Jumlah titik data (10-100)</small>
                    </div>
                    <div class="display-group">
                        <label class="form-label ema-label">Grid Color</label>
                        <input type="color" class="form-control form-control-color form-control-sm" id="chartGridColor" value="#e0e0e0">
                    </div>
                </div>
                <div class="ema-check-group">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="chartShowGrid" checked>
                        <label class="form-check-label">Show Grid Lines</label>
                    </div>
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="showEMA" checked>
                        <label class="form-check-label">Show EMA Line</label>
                    </div>
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="showThresholds" checked>
                        <label class="form-check-label">Show Upper & Lower Lines</label>
                    </div>
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="chartShowMaxCapacity" checked>
                        <label class="form-check-label">Show Max Capacity Line</label>
                    </div>
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="chartShowLegend">
                        <label class="form-check-label">Show Legend</label>
                    </div>
                </div>
                <small class="text-muted ema-hint"><i class="fas fa-info-circle"></i> Settings disimpan di browser (localStorage) — tidak mempengaruhi database.</small>
            </div>
            <div class="modal-footer py-2">
                <button type="button" class="btn btn-secondary btn-sm" data-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary btn-sm" id="btnSaveDisplaySettings">
                    <i class="fas fa-save"></i> Save
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/chart.umd.min.js"></script>
    <script>
        // ============================================
        // CHART TYPE SELECTOR (Dropdown)
        // ============================================
        function switchChartType(safeKey, chartType) {
            var $card = $('#chartCard_' + safeKey);
            if ($card.length === 0) return;

            // Hide all chart views
            $card.find('[data-chart-type]').hide();

            // Show selected chart
            $card.find('[data-chart-type="' + chartType + '"]').show();

            // Resize the visible chart to fit container
            var chartKey = chartType + '_' + safeKey;
            if (charts[chartKey]) {
                charts[chartKey].resize();
            }
        }

        $(document).on('change', '.chart-type-selector', function() {
            var safeKey = $(this).data('safe-key');
            var chartType = $(this).val();
            switchChartType(safeKey, chartType);
        });

        // ============================================
        // CONFIGURATION
        // ============================================
        var charts = {};
        var refreshTimer = null;
        var deviceCategoryMap = {};
        var categoryDowntimeMap = {};
        var categoryMetaMap = {};
        function loadCategoriesMetaForCharts() {
            return $.ajax({
                url: '/api/Api/categories',
                method: 'GET',
                dataType: 'json',
                timeout: 10000,
                success: function(data) {
                    categoryMetaMap = {};
                    (data || []).forEach(function(cat) {
                        categoryMetaMap[cat.name] = { icon: cat.icon, color: cat.color, description: cat.description };
                    });
                    if (typeof injectCategoryStyles === 'function') injectCategoryStyles(data);
                    categoryLabels = buildCategoryLabels();
                    populateChartCategoryFilter();
                    buildDowntimeCategoryTabs();
                    // Expose globally for _AnomalyService
                    window._categoryMetaMap = categoryMetaMap;
                },
                error: function() { console.warn('Failed to load categories meta'); }
            });
        }
        var panelList = @Html.Raw(Json.Serialize(Model.Panels.Select(p => new {
            deviceKey = p.DeviceKey,
            safeKey = p.DeviceKey.Replace("-", "_"),
            groupName = p.GroupName,
            isThreePhase = p.IsThreePhase,
            deviceCategory = "Billboard"
        }).ToList()));

        // ============================================
        // DEVICE CATEGORY MANAGEMENT
        // ============================================
        function loadDeviceCategories() {
            return $.ajax({
                url: '/api/Api/device-categories',
                method: 'GET',
                dataType: 'json',
                timeout: 10000,
                success: function(data) {
                    if (data.devices) {
                        deviceCategoryMap = data.devices;
                    }
                    // Update panelList and UI
                    panelList.forEach(function(panel) {
                        var cat = deviceCategoryMap[panel.deviceKey] || 'Billboard';
                        panel.deviceCategory = cat;
                        updateDeviceCategoryUI(panel.safeKey, cat);
                    });
                    // Re-apply filter after categories are loaded
                    applyChartFilter();
                    console.log('Device categories loaded:', deviceCategoryMap);
                },
                error: function() { console.warn('Failed to load device categories'); }
            });
        }

        function updateDeviceCategoryUI(safeKey, category) {
            var $card = $('#chartCard_' + safeKey);
            if ($card.length) {
                $card.attr('data-category', category);
            }

            // Update category icon to match monitoring panel style
            var $icon = $('#categoryIcon_' + safeKey);
            if ($icon.length) {
                var meta = categoryMetaMap[category] || { icon: '⚪', color: '#6c757d' };
                $icon.text(meta.icon);
                var classesToRemove = [];
                $.each($icon[0].classList, function(i, cls) {
                    if (cls.startsWith('cat-')) classesToRemove.push(cls);
                });
                $icon.removeClass(classesToRemove.join(' ')).addClass('cat-' + category);
            }
        }

        // ============================================
        // CATEGORY-AWARE DOWNTIME
        // ============================================
        function checkCategoryDowntime(category) {
            if (!category) category = 'Billboard';
            return $.ajax({
                url: '/api/Api/downtime-status?category=' + encodeURIComponent(category),
                method: 'GET',
                dataType: 'json',
                timeout: 5000,
                success: function(data) {
                    categoryDowntimeMap[category] = data.isDowntime || false;
                    console.log('Downtime status for ' + category + ':', data.isDowntime ? 'DOWNTIME' : 'NORMAL');
                },
                error: function() { console.warn('Failed to check downtime for ' + category); }
            });
        }

        function loadAllCategoryDowntime() {
            var categories = Object.keys(categoryMetaMap || {}).length > 0 ? Object.keys(categoryMetaMap) : ['Billboard'];
            var promises = categories.map(function(cat) {
                return checkCategoryDowntime(cat);
            });
            return $.when.apply($, promises);
        }

        function isDowntimeForDevice(deviceKey) {
            var ds = (window.getDeviceSettings && window.getDeviceSettings(deviceKey)) || { downtimeEnabled: false };
            if (!ds.downtimeEnabled) return false;

            var startParts = (ds.downtimeStart || '22:00:00').toString().split(':');
            var endParts = (ds.downtimeEnd || '06:00:00').toString().split(':');
            var startHour = parseInt(startParts[0]) || 0;
            var startMin = parseInt(startParts[1]) || 0;
            var endHour = parseInt(endParts[0]) || 0;
            var endMin = parseInt(endParts[1]) || 0;

            var now = new Date();
            var current = now.getHours() * 60 + now.getMinutes();
            var start = startHour * 60 + startMin;
            var end = endHour * 60 + endMin;

            if (start < end) {
                return current >= start && current < end;
            } else {
                return current >= start || current < end;
            }
        }

        // ============================================
        // CHART FILTER LOGIC
        // ============================================
        var chartFilterDebounce = null;
        var activeChartChipDeviceKey = null;
        var chartAnomalyStatusMap = {};

        function getChartChipClass(deviceKey) {
            var anomaly = chartAnomalyStatusMap[deviceKey];
            if (anomaly === 'OVERLOAD') return 'chip-high';
            if (anomaly === 'DROP') return 'chip-medium';
            return 'chip-normal';
        }

        function renderChartChips() {
            var $list = $('#chartChipList');
            $list.empty();

            if (panelList.length === 0) return;

            var sorted = panelList.slice().sort(function(a, b) {
                var aAnomaly = chartAnomalyStatusMap[a.deviceKey] || '';
                var bAnomaly = chartAnomalyStatusMap[b.deviceKey] || '';
                var order = { 'OVERLOAD': 0, 'DROP': 1, '': 2 };
                var aOrder = order[aAnomaly] !== undefined ? order[aAnomaly] : 2;
                var bOrder = order[bAnomaly] !== undefined ? order[bAnomaly] : 2;
                if (aOrder !== bOrder) return aOrder - bOrder;
                var nameA = (a.groupName || a.deviceKey).toLowerCase();
                var nameB = (b.groupName || b.deviceKey).toLowerCase();
                return nameA.localeCompare(nameB);
            });

            // "All" chip
            var $allChip = $('<span>')
                .addClass('panel-chip ' + (activeChartChipDeviceKey === null ? 'chip-normal active' : 'chip-normal'))
                .attr('data-device-key', '__all__')
                .html('<span class="chip-dot"></span>Semua')
                .on('click', function() {
                    activeChartChipDeviceKey = null;
                    $list.find('.panel-chip').removeClass('active');
                    $(this).addClass('active');
                    applyChartFilter();
                });
            $list.append($allChip);

            sorted.forEach(function(panel) {
                var chipClass = getChartChipClass(panel.deviceKey);
                var label = panel.groupName || panel.deviceKey;
                var isActive = activeChartChipDeviceKey === panel.deviceKey;

                var $chip = $('<span>')
                    .addClass('panel-chip ' + chipClass + (isActive ? ' active' : ''))
                    .attr('data-device-key', panel.deviceKey)
                    .html('<span class="chip-dot"></span>' + label)
                    .on('click', function() {
                        activeChartChipDeviceKey = panel.deviceKey;
                        $list.find('.panel-chip').removeClass('active');
                        $(this).addClass('active');
                        applyChartFilter();
                    });

                $list.append($chip);
            });
        }

        function applyChartFilter() {
            var search = $('#chartSearch').val().trim().toLowerCase();
            var category = $('#chartCategoryFilter').val();
            var visibleCount = 0;

            panelList.forEach(function(panel) {
                var $card = $('#chartCard_' + panel.safeKey);
                if ($card.length === 0) return;

                var show = true;

                // Chip filter
                if (activeChartChipDeviceKey && panel.deviceKey !== activeChartChipDeviceKey) {
                    show = false;
                }

                // Search filter
                if (show && search) {
                    var groupName = (panel.groupName || '').toLowerCase();
                    var deviceKey = panel.deviceKey.toLowerCase();
                    if (!groupName.includes(search) && !deviceKey.includes(search)) {
                        show = false;
                    }
                }

                // Category filter
                if (show && category && category !== 'all') {
                    var panelCategory = panel.deviceCategory || deviceCategoryMap[panel.deviceKey] || 'Billboard';
                    if (panelCategory !== category) show = false;
                }

                if (show) {
                    $card.show();
                    visibleCount++;
                } else {
                    $card.hide();
                }
            });

            $('#chartFilteredCount').text(visibleCount);
            $('#chartTotalCount').text(panelList.length);
        }

        function setupChartFilterEvents() {
            $('#chartSearch').on('input', function() {
                clearTimeout(chartFilterDebounce);
                chartFilterDebounce = setTimeout(applyChartFilter, 200);
            });

            $('#chartCategoryFilter').on('change', applyChartFilter);

            $('#btnClearChartFilter').on('click', function() {
                $('#chartSearch').val('');
                $('#chartCategoryFilter').val('all');
                activeChartChipDeviceKey = null;
                $('#chartChipList').find('.panel-chip').removeClass('active');
                applyChartFilter();
            });
        }

        function updateChartAnomalyStatus() {
            // Ambil cooldown state langsung dari anomaly service (real-time)
            var cooldownState = (typeof window.getAnomalyCooldownState === 'function') 
                ? window.getAnomalyCooldownState() 
                : {};

            // Build deviceStatus from cooldown state (real-time, bukan database log)
            var deviceStatus = {};
            Object.keys(cooldownState).forEach(function(deviceKey) {
                if (cooldownState[deviceKey] && cooldownState[deviceKey].waitingForNormal) {
                    deviceStatus[deviceKey] = cooldownState[deviceKey].type; // 'OVERLOAD' or 'DROP'
                }
            });

            chartAnomalyStatusMap = {};
            panelList.forEach(function(panel) {
                var status = deviceStatus[panel.deviceKey];
                if (status === 'OVERLOAD' || status === 'DROP') {
                    chartAnomalyStatusMap[panel.deviceKey] = status;
                }
            });

            renderChartChips();

            // Update card header colors based on anomaly
            panelList.forEach(function(panel) {
                var $card = $('#chartCard_' + panel.safeKey);
                if ($card.length === 0) return;

                var $header = $card.find('.card-header');
                var status = deviceStatus[panel.deviceKey];

                $header.removeClass('bg-danger bg-warning bg-primary');
                if (status === 'OVERLOAD') {
                    $header.addClass('bg-danger');
                } else if (status === 'DROP') {
                    $header.addClass('bg-warning');
                } else {
                    $header.addClass('bg-primary');
                }
            });
        }

        // EMA Settings
        var emaSettings = {
            period: 20,
            mode: 'manual',
            upperThreshold: 0,
            lowerThreshold: 0,
            fibUpper: 0,
            fibLower: 0,
            showEMA: true,
            showThresholds: true,
            showMaxCapacity: true,
            refreshInterval: 10,
            useInitial100ForEma: false
        };

        // System/Display Settings
        var systemSettings = {
            chartDataPoints: 20,
            refreshInterval: 10,
            showGrid: true,
            showGridX: true,
            showGridY: true,
            gridColor: '#e0e0e0',
            showLegend: false
        };

        // Downtime Settings
        var downtimeSettings = {
            enabled: false,
            startHour: 22,
            endHour: 6,
            description: ''
        };

        // ============================================
        // UTILITY FUNCTIONS
        // ============================================
        function formatNumber(num) {
            if (num === null || num === undefined || isNaN(num)) return '0';
            return Number(num).toLocaleString('id-ID', { maximumFractionDigits: 0 });
        }

        function updateLastUpdate() {
            $('#lastUpdate').text(new Date().toLocaleString('id-ID'));
        }

        function calculateEMA(data, period) {
            if (!data || data.length === 0) return [];
            var k = 2 / (period + 1);
            var ema = [data[0] || 0];
            for (var i = 1; i < data.length; i++) {
                var value = data[i] !== null && data[i] !== undefined ? data[i] : ema[i - 1];
                ema.push(value * k + ema[i - 1] * (1 - k));
            }
            return ema;
        }

        // Fungsi untuk menghitung EMA dengan baseline SMA dari 100 data pertama
        // Baseline = rata-rata sederhana (SMA), membentuk garis horizontal datar
        // Threshold dihitung dari baseline ini, bukan dari EMA yang berubah-ubah
        function calculateEMAWithBaseline(data, period, baselineValue) {
            if (!data || data.length === 0) return [];
            if (baselineValue === null || baselineValue === undefined) {
                return calculateEMA(data, period);
            }

            // Garis horizontal datar pada nilai baseline (SMA 100 data pertama)
            // Setiap titik data memiliki nilai yang sama = baseline
            return data.map(function() { return baselineValue; });
        }

        function calculateThresholds(ema, mode, upperValue, lowerValue) {
            var upper = [], lower = [];
            try {
                // Gunakan nullish coalescing (??) bukan OR (||) agar nilai 0 tetap 0, bukan diubah jadi default
                var uv = upperValue != null && !isNaN(upperValue) ? upperValue : 1;
                var lv = lowerValue != null && !isNaN(lowerValue) ? lowerValue : 1;
                if (mode === 'fibonacci') {
                    upper = ema.map(function(v) { return (v != null ? v : 0) * uv; });
                    lower = ema.map(function(v) { return (v != null ? v : 0) * lv; });
                } else {
                    upper = ema.map(function(v) { return (v != null ? v : 0) * (1 + uv / 100); });
                    lower = ema.map(function(v) { return (v != null ? v : 0) * (1 - lv / 100); });
                }
            } catch(e) { console.error('Error calculating thresholds:', e); }
            return { upper: upper, lower: lower };
        }

        function getTooltipConfig(unit, decimals) {
            return {
                enabled: true,
                backgroundColor: 'rgba(0, 0, 0, 0.8)',
                titleColor: '#fff',
                bodyColor: '#fff',
                borderColor: '#444',
                borderWidth: 1,
                padding: 10,
                displayColors: true,
                callbacks: {
                    title: function(context) { return 'Waktu: ' + context[0].label; },
                    label: function(context) {
                        var label = context.dataset.label || '';
                        var value = context.parsed.y;
                        if (label) label += ': ';
                        if (unit === 'V') return label + value.toFixed(1) + ' V';
                        if (unit === 'A') return label + value.toFixed(2) + ' A';
                        if (unit === 'W') return label + value.toLocaleString('id-ID', { maximumFractionDigits: 0 }) + ' W';
                        return label + value;
                    }
                }
            };
        }

        // ============================================
        // LOAD SETTINGS FROM DATABASE
        // ============================================
        function loadEmaSettings() {
            return new Promise(function(resolve) {
                $.ajax({
                    url: '/api/Api/get-ema-settings',
                    method: 'GET',
                    dataType: 'json',
                    timeout: 10000,
                    success: function(data) {
                        emaSettings = {
                            period: data.emaPeriod || 20,
                            mode: data.emaMode || 'manual',
                            upperThreshold: data.emaUpperThreshold || 0,
                            lowerThreshold: data.emaLowerThreshold || 0,
                            fibUpper: data.emaFibUpper || 0,
                            fibLower: data.emaFibLower || 0,
                            showEMA: data.emaShowLine !== false,
                            showThresholds: data.emaShowThresholds !== false,
                            useInitial100ForEma: data.useInitial100ForEma || false,
                            refreshInterval: data.refreshInterval || 10
                        };
                        console.log('EMA Settings loaded:', emaSettings);
                        resolve();
                    },
                    error: function() { resolve(); }
                });
            });
        }

        function loadSystemSettings() {
            return new Promise(function(resolve) {
                $.ajax({
                    url: '/api/Api/get-system-settings',
                    method: 'GET',
                    dataType: 'json',
                    timeout: 10000,
                    success: function(data) {
                        if (data.success && data.settings) {
                            systemSettings.chartDataPoints = parseInt(data.settings['Chart.DataPoints']) || 20;
                            systemSettings.refreshInterval = parseInt(data.settings['RefreshInterval']) || emaSettings.refreshInterval || 10;
                            systemSettings.showGrid = data.settings['Chart.ShowGrid'] !== 'false';
                            systemSettings.showGridX = data.settings['Chart.ShowGridX'] !== 'false';
                            systemSettings.showGridY = data.settings['Chart.ShowGridY'] !== 'false';
                            systemSettings.gridColor = data.settings['Chart.GridColor'] || '#e0e0e0';
                            systemSettings.showLegend = data.settings['Chart.ShowLegend'] !== 'false';
                        }
                        console.log('System Settings loaded:', systemSettings);
                        resolve();
                    },
                    error: function() { resolve(); }
                });
            });
        }

        // Load Display Settings from localStorage
        function loadDisplaySettings() {
            try {
                var stored = localStorage.getItem('chartDisplaySettings');
                if (stored) {
                    var settings = JSON.parse(stored);
                    systemSettings.chartDataPoints = settings.chartDataPoints || 20;
                    systemSettings.gridColor = settings.gridColor || '#e0e0e0';
                    systemSettings.showGrid = settings.showGrid !== false;
                    systemSettings.showLegend = settings.showLegend !== false;
                    emaSettings.showEMA = settings.showEMA !== false;
                    emaSettings.showThresholds = settings.showThresholds !== false;
                    emaSettings.showMaxCapacity = settings.showMaxCapacity !== false;
                    console.log('Display Settings loaded from localStorage:', settings);
                }
            } catch (e) {
                console.warn('Error loading display settings:', e);
            }
        }

        // Load display settings immediately (before API calls)
        loadDisplaySettings();

        function loadDowntimeSettings() {
            return new Promise(function(resolve) {
                $.ajax({
                    url: '/api/Api/get-downtime-settings',
                    method: 'GET',
                    dataType: 'json',
                    timeout: 10000,
                    success: function(data) {
                        downtimeSettings.enabled = data.enabled || false;
                        downtimeSettings.startHour = data.startHour != null ? data.startHour : 22;
                        downtimeSettings.endHour = data.endHour != null ? data.endHour : 6;
                        downtimeSettings.description = data.description || '';
                        console.log('Downtime Settings loaded:', downtimeSettings);
                        resolve();
                    },
                    error: function() { resolve(); }
                });
            });
        }

        // ============================================
        // GRID CONFIG HELPER
        // ============================================
        function getGridConfig() {
            var gridColor = (typeof window.getChartGridColor === 'function') ? window.getChartGridColor() : systemSettings.gridColor;
            return {
                display: systemSettings.showGrid,
                drawOnChartArea: systemSettings.showGrid,
                drawTicks: systemSettings.showGrid,
                color: gridColor,
                lineWidth: 1
            };
        }

        function getScaleConfig(beginAtZero, yCallback) {
            var tickColor = (typeof window.getChartTickColor === 'function') ? window.getChartTickColor() : '#666';
            return {
                x: {
                    ticks: { font: { size: 9 }, maxRotation: 45, color: tickColor },
                    grid: getGridConfig()
                },
                y: {
                    beginAtZero: beginAtZero,
                    ticks: { font: { size: 9 }, callback: yCallback, color: tickColor },
                    grid: getGridConfig()
                }
            };
        }

