        function generateMonthlyReport() {
            var year = parseInt($('#reportYear').val());
            var month = parseInt($('#reportMonth').val());
            $('#monthlyReportEmpty').removeClass('d-none').html('<i class="fas fa-spinner fa-spin me-1"></i> Membuat laporan ' + $('#reportMonth option:selected').text() + ' ' + year + '…');
            $('#monthlyReportContainer').addClass('d-none');
            $('#btnGenerateReport').prop('disabled', true);
            $.ajax({
                url: '/api/Api/anomaly-monthly-report/generate',
                method: 'POST',
