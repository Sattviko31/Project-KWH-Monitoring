                data: JSON.stringify({ year: year, month: month }),
                dataType: 'json',
                success: function(response) {
                    if (response.success && response.data) {
                        renderMonthlyReport(response.data);
                    } else {
                        showNotification(response.error || 'Gagal membuat laporan', 'danger');
                    }
                },
                error: function() { $('#monthlyReportEmpty').removeClass('d-none').text('Laporan gagal dibuat. Silakan muat ulang periode ini dan coba kembali.'); showNotification('Gagal membuat laporan.', 'danger'); },
                complete: function() { $('#btnGenerateReport').prop('disabled', false); }
            });
        }

        function getMonthlyReportText(data) {
            var isEnglish = false;
            try { isEnglish = localStorage.getItem('kwh_language') === 'en'; } catch (_) { }
            var monthsId = ['Januari', 'Februari', 'Maret', 'April', 'Mei', 'Juni', 'Juli', 'Agustus', 'September', 'Oktober', 'November', 'Desember'];
            var monthsEn = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
            var month = parseInt(data.month, 10);
            var monthName = (isEnglish ? monthsEn : monthsId)[month - 1] || '';
            var year = data.year || '';
            var total = Number(data.totalAnomalies) || 0;
            var critical = Number(data.criticalCount) || 0;
            var unresolved = Number(data.unresolvedCount) || 0;
            var overload = Number(data.overloadCount) || 0;
            var drop = Number(data.dropCount) || 0;
            var affected = Number(data.affectedDevices) || 0;
            var cost = Number(data.totalAnomalyCostImpact) || 0;
            var revenueLoss = Number(data.totalRevenueLoss) || 0;
            var currency = isEnglish ? 'IDR ' : 'Rp ';
            var summary = isEnglish
                ? 'The anomaly report for ' + monthName + ' ' + year + ' records ' + total + ' events. ' + critical + ' are critical, and ' + unresolved + ' remain unresolved.'
                : 'Laporan anomali untuk ' + monthName + ' ' + year + ' mencatat ' + total + ' kejadian. Sebanyak ' + critical + ' kejadian berkategori kritis dan ' + unresolved + ' kejadian belum diselesaikan.';
            var recommendations = [];
            if (overload > drop) recommendations.push(isEnglish
                ? 'Excessive load is the most frequent anomaly. Review panel capacity and reduce demand during peak hours.'
                : 'Anomali beban berlebih paling banyak terjadi. Tinjau kapasitas panel dan kurangi beban pada jam puncak.');
            if (drop > overload) recommendations.push(isEnglish
                ? 'Device outages are the most frequent anomaly. Check connection quality and power supply.'
                : 'Gangguan perangkat paling banyak terjadi. Periksa kualitas koneksi dan catu daya.');
            if (affected > 1) recommendations.push(isEnglish
                ? affected + ' devices are affected. Inspect them thoroughly.'
                : 'Sebanyak ' + affected + ' perangkat terdampak. Lakukan pemeriksaan menyeluruh terhadap perangkat tersebut.');
            if (critical > 0) recommendations.push(isEnglish
                ? 'Critical anomalies were detected. Address them promptly.'
                : 'Terdapat anomali berkategori kritis. Segera lakukan penanganan.');
            if (cost > 0) recommendations.push(isEnglish
                ? 'The estimated cost impact of excessive load this month is ' + currency + formatNumber(cost) + '. Review load usage to improve efficiency.'
                : 'Dampak biaya akibat beban berlebih pada bulan ini sebesar ' + currency + formatNumber(cost) + '. Tinjau penggunaan beban untuk meningkatkan efisiensi.');
            if (revenueLoss > 0) recommendations.push(isEnglish
                ? 'Estimated revenue loss this month is ' + currency + formatNumber(revenueLoss) + '. Prioritize restoring device availability.'
                : 'Estimasi kehilangan pendapatan pada bulan ini sebesar ' + currency + formatNumber(revenueLoss) + '. Prioritaskan pemulihan ketersediaan perangkat.');
            if (!recommendations.length) recommendations.push(isEnglish
                ? 'No additional recommendations for this period.'
                : 'Tidak ada rekomendasi tambahan untuk periode ini.');
            return { summary: summary, recommendations: recommendations, isEnglish: isEnglish };
        }

        function renderMonthlyReport(data) {
            latestMonthlyReportData = data;
            var reportText = getMonthlyReportText(data);
            $('#monthlyReportEmpty').addClass('d-none');
            $('#monthlyReportContainer').removeClass('d-none');
            $('#repTotal').text(data.totalAnomalies || 0);
            $('#repOverload').text(data.overloadCount || 0);
            $('#repDrop').text(data.dropCount || 0);
            $('#repAffected').text(data.affectedDevices || 0);
            $('#repCritical').text(data.criticalCount || 0);
            $('#repUnresolved').text(data.unresolvedCount || 0);
            $('#repAvgDeviation').text(formatNumber(data.averageDeviation || 0) + '%');
            var currency = reportText.isEnglish ? 'IDR ' : 'Rp ';
            $('#repAnomalyCost').text(currency + formatNumber(data.totalAnomalyCostImpact || 0));
            $('#repRevenueLoss').text(currency + formatNumber(data.totalRevenueLoss || 0));
            $('#repOngoingRevenueLoss').text(currency + formatNumber(data.ongoingRevenueLoss || 0));
            $('#repDetailAnomalyCost').text(currency + formatNumber(data.totalAnomalyCostImpact || 0));
            $('#repDetailRevenueLoss').text(currency + formatNumber(data.totalRevenueLoss || 0));
            $('#repDetailOngoingRevenueLoss').text(currency + formatNumber(data.ongoingRevenueLoss || 0));
            $('#repSummary').text(reportText.summary);
            var $recommendations = $('#repRecommendations').empty();
            reportText.recommendations.forEach(function(line, index) {
                if (index) $recommendations.append('<br>');
                $recommendations.append(document.createTextNode(line));
            });
            $('#repGeneratedBy').text(data.generatedBy || '-');
            $('#repGeneratedAt').text(data.generatedAt ? formatDateTime(data.generatedAt) : '-');

            var rootCauses = data.topRootCauses || [];
            if (rootCauses.length > 0) {
                var $rootCauses = $('#repTopRootCausesList').empty();
                rootCauses.forEach(function(r, i) {
                    var $row = $('<div>').addClass('d-flex justify-content-between gap-2');
                    $('<span>').text((i + 1) + '. ' + (r.rootCause || r.RootCause || '-')).appendTo($row);
                    $('<span>').addClass('badge bg-secondary').text(r.count || r.Count || 0).appendTo($row);
                    $rootCauses.append($row);
                });
            } else {
                $('#repTopRootCausesList').text(reportText.isEnglish ? 'No recurring causes were recorded.' : 'Tidak ada penyebab berulang yang tercatat.');
            }
        }

        window.addEventListener('kwh-language-changed', function () {
            if (latestMonthlyReportData) renderMonthlyReport(latestMonthlyReportData);
        });

