@{
    ViewData["Title"] = "Anomaly Center";
    var userRole = ViewBag.CurrentUserRole?.ToString() ?? "Viewer";
}

@await Html.PartialAsync("_DashboardHeader")

<!-- Anomaly Center Page Controls -->
<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div class="d-flex align-items-center gap-2">
        <span class="badge badge-light border">Peran: <span id="userRoleBadge">@userRole</span></span>
    </div>
    <label class="form-check mb-0 d-flex align-items-center">
        <input type="checkbox" id="autoRefreshCheck" checked class="form-check-input me-1">
        <small class="text-muted">Pembaruan Otomatis</small>
    </label>
</div>

<!-- KPI Cards -->
<div class="stats-row mb-3">
    <div>
        <div class="stat-card" style="background: linear-gradient(135deg,#0dcaf0,#0d6efd);color:#fff;" data-card-help="Total Anomali|Jumlah seluruh kejadian anomali yang tercatat sesuai periode penyaringan.|Rumus: total = jumlah seluruh catatan anomali (beban berlebih dan gangguan perangkat).|Jumlah ini mencakup anomali yang sudah maupun belum diselesaikan.">
            <div class="stat-label">Total Anomali</div>
            <div class="stat-value" id="dashTotal">0</div>
            <i class="fas fa-list stat-icon"></i>
        </div>
    </div>
    <div>
        <div class="stat-card" style="background: linear-gradient(135deg,#20c997,#198754);color:#fff;" data-card-help="Anomali Hari Ini|Jumlah kejadian anomali yang terjadi pada hari ini.|Rumus: Total = jumlah log anomali dengan tanggal = hari ini|Berguna memantau kondisi hari berjalan.">
            <div class="stat-label">Hari Ini</div>
            <div class="stat-value" id="dashToday">0</div>
            <i class="fas fa-calendar-day stat-icon"></i>
        </div>
    </div>
    <div>
        <div class="stat-card" style="background: linear-gradient(135deg,#ffc107,#fd7e14);color:#fff;" data-card-help="Belum Diselesaikan|Anomali yang belum ditandai selesai (terbuka) oleh operator.|Rumus: Belum Diselesaikan = jumlah log dengan status belum diselesaikan|Tandai anomali sebagai selesai melalui tombol Selesaikan pada tabel agar angka turun.">
            <div class="stat-label">Belum Diselesaikan</div>
            <div class="stat-value" id="dashUnresolved">0</div>
            <i class="fas fa-exclamation-circle stat-icon"></i>
        </div>
    </div>
    <div>
        <div class="stat-card" style="background: linear-gradient(135deg,#dc3545,#7f1d1d);color:#fff;" data-card-help="Kritis|Anomali dengan tingkat keparahan tertinggi.|Kriteria: daya jauh melampaui ambang batas atas atau terjadi penurunan daya yang drastis.|Prioritaskan penanganan karena kondisi ini berisiko merusak perangkat atau menyebabkan pemadaman.">
            <div class="stat-label">Kritis</div>
            <div class="stat-value" id="dashCritical">0</div>
            <i class="fas fa-bomb stat-icon"></i>
        </div>
    </div>
    <div>
        <div class="stat-card" style="background: linear-gradient(135deg,#6610f2,#6f42c1);color:#fff;" data-card-help="Tinggi|Anomali dengan tingkat keparahan tinggi, di bawah kategori kritis.|Kriteria: deviasi secara signifikan melampaui ambang batas atas atau bawah, tetapi belum mencapai tingkat kritis.|Pantau dan tangani agar kondisi tidak memburuk.">
            <div class="stat-label">Tinggi</div>
            <div class="stat-value" id="dashHigh">0</div>
            <i class="fas fa-exclamation-triangle stat-icon"></i>
        </div>
    </div>
</div>

<!-- Charts -->
<div class="charts-row mb-3">
    <div class="charts-col charts-col-main">
        <div class="card shadow-sm h-100" data-card-help="Tren Anomali|Grafik jumlah kejadian anomali per hari (7 atau 30 hari terakhir).|Rumus: nilai tiap titik = jumlah log anomali pada tanggal tersebut|Puncak grafik menunjukkan hari dengan anomali terbanyak.">
            <div class="card-header bg-white d-flex justify-content-between align-items-center py-2">
                <h6 class="mb-0"><i class="fas fa-chart-line text-muted"></i> Tren Anomali</h6>
                <div class="btn-group btn-group-sm" role="group">
                    <button type="button" class="btn btn-outline-secondary active" data-days="7">7 Hari</button>
                    <button type="button" class="btn btn-outline-secondary" data-days="30">30 Hari</button>
                </div>
            </div>
            <div class="card-body py-2">
                <div id="anomalyTrendChart" class="anomaly-chart-container"></div>
            </div>
        </div>
    </div>
    <div class="charts-col charts-col-side">
        <div class="card shadow-sm h-100" data-card-help="Anomali berdasarkan Perangkat|Diagram lingkaran sebaran anomali antar perangkat.|Rumus: tiap irisan = jumlah kejadian anomali perangkat ÷ total anomali × 100%|Perangkat dengan irisan terbesar paling sering bermasalah.">
            <div class="card-header bg-white py-2">
                <h6 class="mb-0"><i class="fas fa-chart-pie text-muted"></i> Anomali per Perangkat</h6>
            </div>
            <div class="card-body py-2">
                <div id="anomalySeverityPieChart" class="anomaly-chart-container"></div>
            </div>
        </div>
    </div>
</div>

<!-- Financial Impact KPIs -->
<div class="stats-row mb-3" id="financialImpactRow">
    <div>
        <div class="stat-card" style="background: linear-gradient(135deg,#fd7e14,#ff9f43);color:#fff;" data-card-help="Dampak Biaya Anomali|Estimasi biaya tambahan akibat anomali beban berlebih periode ini.|Rumus: Kelebihan energi (kWh) ≈ daya berlebih (W) ÷1000 ×0,25 jam per kejadian&#10;Biaya = Kelebihan energi (kWh) × Tarif (Rp/kWh)|Semakin sering beban berlebih, semakin besar pemborosan biaya.">
            <div class="stat-label">Dampak Biaya Anomali</div>
            <div class="stat-value" id="dashAnomalyCost">Rp 0</div>
            <i class="fas fa-bolt stat-icon"></i>
        </div>
    </div>
    <div>
        <div class="stat-card" style="background: linear-gradient(135deg,#dc3545,#c0392b);color:#fff;" data-card-help="Estimasi Kehilangan Pendapatan|Estimasi kerugian pendapatan saat gangguan perangkat (mati total).|Rumus: Kehilangan pendapatan ≈ durasi gangguan (jam) × pendapatan rata-rata per jam perangkat|Dihitung dari perangkat yang kategorinya menghasilkan pendapatan (mis. billboard).">
            <div class="stat-label">Estimasi Kehilangan Pendapatan</div>
            <div class="stat-value" id="dashRevenueLoss">Rp 0</div>
            <i class="fas fa-money-bill-wave stat-icon"></i>
        </div>
    </div>
    <div>
        <div class="stat-card" style="background: linear-gradient(135deg,#6f42c1,#8e44ad);color:#fff;" data-card-help="Kehilangan Pendapatan yang Sedang Berlangsung|Akumulasi kerugian dari perangkat yang masih mengalami gangguan.|Rumus: akumulasi = durasi gangguan (jam) × pendapatan per jam.|Nilai terus bertambah hingga perangkat kembali beroperasi normal.">
            <div class="stat-label">Kehilangan Pendapatan yang Sedang Berlangsung</div>
            <div class="stat-value" id="dashOngoingRevenueLoss">Rp 0</div>
            <i class="fas fa-clock stat-icon"></i>
        </div>
    </div>
    <div>
        <div class="stat-card" style="background: linear-gradient(135deg,#0d6efd,#2980b9);color:#fff;" data-card-help="Perangkat dengan Dampak Keuangan|Jumlah perangkat yang mengalami anomali dengan dampak keuangan, berupa biaya atau kehilangan pendapatan.|Rumus: jumlah perangkat unik dalam catatan anomali dengan dampak biaya lebih dari nol.|Prioritaskan upaya efisiensi pada perangkat tersebut.">
            <div class="stat-label">Perangkat Terdampak secara Finansial</div>
            <div class="stat-value" id="dashFinancialDevices">-</div>
            <i class="fas fa-stopwatch stat-icon"></i>
        </div>
    </div>
</div>

<!-- DataGrid -->
<div class="card shadow-sm mb-3" data-card-help="Daftar Anomali|Tabel berisi waktu, perangkat, jenis anomali, tingkat keparahan, daya, deviasi, dan status.|Rumus: deviasi (%) = (daya − ambang batas) ÷ ambang batas × 100.|Gunakan penyaringan, pengurutan, dan detail untuk meninjau catatan; konfirmasikan penanganan atau tandai anomali sebagai selesai melalui tabel.">
    <div class="card-header bg-white d-flex justify-content-between align-items-center py-2 flex-wrap gap-2">
        <h6 class="mb-0"><i class="fas fa-list text-muted"></i> Daftar Anomali</h6>
        <div class="d-flex gap-1">
            @if (userRole == "Admin")
            {
                <button class="btn btn-sm btn-danger" id="btnClearAll">
                    <i class="fas fa-trash-alt"></i> <span class="d-none d-sm-inline">Hapus Semua</span>
                </button>
            }
        </div>
    </div>
    <div class="card-body p-0">
        <div class="anomaly-grid-scroll-wrapper">
            <div id="anomalyDataGrid" style="width:100%;"></div>
        </div>
    </div>
</div>

<!-- Laporan Bulanan -->
<div class="card shadow-sm mb-3" data-card-help="Laporan Anomali Bulanan|Rekapitulasi anomali untuk setiap bulan yang dapat ditampilkan atau dibuat oleh Operator atau Administrator.|Isi laporan: jumlah anomali, distribusi jenis anomali, dampak biaya, kehilangan pendapatan, dan rekomendasi.|Pembuatan laporan menyimpan rekapitulasi secara permanen untuk periode tersebut.">
    <div class="card-header bg-white py-2">
        <h6 class="mb-0"><i class="fas fa-file-alt text-muted"></i> Laporan Bulanan Anomali</h6>
    </div>
    <div class="card-body">
        <div class="report-form-row mb-3">
            <div class="report-form-field">
                <label class="form-label small mb-1">Bulan</label>
                <select id="reportMonth" class="form-select form-select-sm">
                    @for (int m = 1; m <= 12; m++)
                    {
                        <option value="@m" selected="@(m == DateTime.Now.Month ? "selected" : null)">@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(m)</option>
                    }
                </select>
            </div>
            <div class="report-form-field">
                <label class="form-label small mb-1">Tahun</label>
                <select id="reportYear" class="form-select form-select-sm">
                    @for (int y = DateTime.Now.Year - 5; y <= DateTime.Now.Year; y++)
                    {
                        <option value="@y" selected="@(y == DateTime.Now.Year ? "selected" : null)">@y</option>
                    }
                </select>
            </div>
            <div class="report-form-actions">
                <button class="btn btn-outline-secondary btn-sm" id="btnLoadReport">
                    <i class="fas fa-search"></i> Tampilkan
                </button>
                @if (userRole == "Operator" || userRole == "Admin")
                {
                    <button class="btn btn-primary btn-sm ms-1" id="btnGenerateReport">
                        <i class="fas fa-sync-alt"></i> Buat Laporan
                    </button>
                }
            </div>
        </div>

        <div id="monthlyReportContainer" class="d-none">
            <div class="report-stats-row mb-3">
                <div class="report-stat-card" data-card-help="Total Anomali (Laporan)|Jumlah anomali pada bulan yang dipilih.|Rumus: total = jumlah anomali beban berlebih dan gangguan perangkat pada bulan tersebut.|Jumlah dalam laporan dicatat saat laporan dibuat atau ditampilkan.">
                    <div class="border rounded p-2 text-center">
                        <div class="text-muted small">Total Anomali</div>
                        <div class="h5 mb-0 fw-bold text-primary" id="repTotal">0</div>
                    </div>
                </div>
                <div class="report-stat-card" data-card-help="Beban Berlebih (Laporan)|Jumlah anomali beban berlebih, yaitu kondisi saat daya melampaui batas pada bulan yang dipilih.|Rumus: jumlah catatan anomali beban berlebih.|Jika anomali ini sering terjadi, periksa beban dan kapasitas perangkat.">
                    <div class="border rounded p-2 text-center">
                        <div class="text-muted small">Beban Berlebih</div>
                        <div class="h5 mb-0 fw-bold text-danger" id="repOverload">0</div>
                    </div>
                </div>
                <div class="report-stat-card" data-card-help="Gangguan Perangkat (Laporan)|Jumlah anomali gangguan perangkat, yaitu kondisi saat daya turun drastis, pada bulan yang dipilih.|Rumus: jumlah catatan anomali gangguan perangkat.|Jika gangguan sering terjadi, periksa pasokan listrik dan koneksi perangkat.">
                    <div class="border rounded p-2 text-center">
                        <div class="text-muted small">Gangguan Perangkat</div>
                        <div class="h5 mb-0 fw-bold text-warning" id="repDrop">0</div>
                    </div>
                </div>
                <div class="report-stat-card" data-card-help="Perangkat Terdampak (Laporan)|Jumlah perangkat unik yang mengalami anomali bulan terpilih.|Rumus: jumlah perangkat berbeda pada log anomali bulan ini|Menunjukkan sebaran masalah antar perangkat.">
                    <div class="border rounded p-2 text-center">
                        <div class="text-muted small">Perangkat Terdampak</div>
                        <div class="h5 mb-0 fw-bold text-info" id="repAffected">0</div>
                    </div>
                </div>
                <div class="report-stat-card">
                    <div class="border rounded p-2 text-center bg-danger-subtle">
                        <div class="text-muted small">Tingkat Keparahan Kritis</div>
                        <div class="h5 mb-0 fw-bold text-danger" id="repCritical">0</div>
                    </div>
                </div>
                <div class="report-stat-card">
                    <div class="border rounded p-2 text-center bg-warning-subtle">
                        <div class="text-muted small">Belum Selesai</div>
                        <div class="h5 mb-0 fw-bold text-warning" id="repUnresolved">0</div>
                    </div>
                </div>
                <div class="report-stat-card">
                    <div class="border rounded p-2 text-center">
                        <div class="text-muted small">Deviasi Rata-rata</div>
                        <div class="h5 mb-0 fw-bold text-primary" id="repAvgDeviation">0%</div>
                    </div>
                </div>
                <div class="report-stat-card" data-card-help="Dampak Biaya (Laporan)|Estimasi biaya tambahan dari anomali beban berlebih bulan terpilih.|Rumus: Kelebihan energi (kWh) ≈ daya berlebih (W) ÷1000 ×0,25 jam · Biaya = Kelebihan energi (kWh) × tarif|Total keuangan dari seluruh kejadian beban berlebih bulan ini.">
                    <div class="border rounded p-2 text-center">
                        <div class="text-muted small">Dampak Biaya</div>
                        <div class="h5 mb-0 fw-bold text-danger" id="repAnomalyCost">Rp 0</div>
                    </div>
                </div>
                <div class="report-stat-card" data-card-help="Kehilangan Pendapatan (Laporan)|Perkiraan total kehilangan pendapatan akibat gangguan perangkat pada bulan yang dipilih.|Rumus: jumlah (durasi gangguan perangkat × pendapatan per jam perangkat).|Perhitungan berlaku untuk perangkat yang menghasilkan pendapatan.">
                    <div class="border rounded p-2 text-center">
                        <div class="text-muted small">Kehilangan Pendapatan</div>
                        <div class="h5 mb-0 fw-bold text-danger" id="repRevenueLoss">Rp 0</div>
                    </div>
                </div>
                <div class="report-stat-card" data-card-help="Kehilangan Pendapatan Berjalan (Laporan)|Perkiraan kehilangan pendapatan dari perangkat yang masih mengalami gangguan saat laporan dibuka.|Rumus: durasi gangguan × pendapatan per jam.|Nilai ini tidak lagi bertambah setelah perangkat kembali beroperasi normal.">
                    <div class="border rounded p-2 text-center">
                        <div class="text-muted small">Loss Berlangsung</div>
                        <div class="h5 mb-0 fw-bold text-warning" id="repOngoingRevenueLoss">Rp 0</div>
                    </div>
                </div>
            </div>
            <div class="card bg-light mb-3" data-card-help="Ringkasan Laporan|Uraian otomatis yang merangkum laporan anomali bulanan yang dipilih.|Disusun berdasarkan jumlah dan jenis anomali serta dampak biayanya.|Diperbarui setiap kali laporan dibuat atau ditampilkan.">
                <div class="card-body py-2">
                    <strong><i class="fas fa-clipboard-list text-muted me-1"></i>Ringkasan:</strong>
                    <p class="mb-1" id="repSummary">-</p>
                </div>
            </div>
            <div class="card mb-3" data-card-help="Rekomendasi|Saran tindakan yang dibuat secara otomatis berdasarkan pola anomali bulan ini.|Contoh: kurangi beban pada jam puncak dan periksa koneksi perangkat yang sering mengalami gangguan.|Disusun berdasarkan analisis kejadian berulang.">
                <div class="card-header bg-white py-2"><strong><i class="fas fa-lightbulb text-muted me-1"></i>Rekomendasi</strong></div>
                <div class="card-body py-2">
                    <div id="repRecommendations" class="small">-</div>
                </div>
            </div>
            <div class="card mb-3" data-card-help="Dampak Keuangan dan Penyebab Utama|Rincian biaya akibat anomali dan penyebab yang paling sering ditemukan.|Dampak biaya = kelebihan energi (kWh) × tarif. Kehilangan pendapatan = durasi gangguan × pendapatan per jam.|Penyebab utama adalah penyebab yang paling sering tercatat pada bulan ini.">
                <div class="card-header bg-white py-2"><strong><i class="fas fa-search-dollar text-muted me-1"></i>Dampak Finansial & Root Cause</strong></div>
                <div class="card-body py-2">
                    <div class="row small">
                        <div class="col-md-4 mb-2">
                            <div class="text-muted">Dampak Biaya Beban Berlebih</div>
                            <div class="h6 text-danger fw-bold" id="repDetailAnomalyCost">Rp 0</div>
                        </div>
                        <div class="col-md-4 mb-2">
                            <div class="text-muted">Estimasi Kehilangan Pendapatan</div>
                            <div class="h6 text-danger fw-bold" id="repDetailRevenueLoss">Rp 0</div>
                        </div>
                        <div class="col-md-4 mb-2">
                            <div class="text-muted">Kehilangan Pendapatan yang Sedang Berlangsung</div>
                            <div class="h6 text-warning fw-bold" id="repDetailOngoingRevenueLoss">Rp 0</div>
                        </div>
                    </div>
                    <div class="mt-2" id="repTopRootCauses">
                        <div class="text-muted small">Top Root Cause:</div>
                        <div class="small" id="repTopRootCausesList">-</div>
                    </div>
                </div>
            </div>
            <div class="text-muted small text-end">
                Generated by <span id="repGeneratedBy">-</span> at <span id="repGeneratedAt">-</span>
            </div>
        </div>
        <div id="monthlyReportEmpty" class="text-center text-muted py-4">
            Pilih periode dan klik "Tampilkan" untuk melihat laporan.
        </div>
    </div>
</div>

<!-- Audit Operator (Admin only) -->
@if (userRole == "Admin")
{
    <div class="card shadow-sm mb-3" data-card-help="Audit Tindakan Operator|Riwayat tindakan operator dan administrator terhadap anomali, termasuk konfirmasi penanganan, penyelesaian, penambahan catatan, dan penghapusan.|Data bersumber dari log audit keamanan yang mencatat alamat IP dan waktu setiap tindakan.|Hanya ditampilkan kepada administrator.">
        <div class="card-header bg-white py-2">
            <h6 class="mb-0"><i class="fas fa-user-shield text-muted"></i> Audit Tindakan Operator</h6>
        </div>
        <div class="card-body">
            <div class="audit-form-row mb-3">
                <div class="audit-form-field">
                    <label class="form-label small mb-1">Dari Tanggal</label>
                    <input type="date" id="auditFromDate" class="form-control form-control-sm" value="@DateTime.Now.AddDays(-30).ToString("yyyy-MM-dd")">
                </div>
                <div class="audit-form-field">
                    <label class="form-label small mb-1">Sampai Tanggal</label>
                    <input type="date" id="auditToDate" class="form-control form-control-sm" value="@DateTime.Now.ToString("yyyy-MM-dd")">
                </div>
                <div class="audit-form-actions">
                    <button class="btn btn-primary btn-sm" id="btnLoadAudit">
                        <i class="fas fa-search"></i> Muat Audit
                    </button>
                </div>
            </div>
            <div id="operatorActionsGrid" style="width:100%;min-height:300px;"></div>
        </div>
    </div>
    <div class="card shadow-sm mb-3" data-card-help="Ringkasan Operator|Rekapitulasi jumlah tindakan yang dilakukan setiap operator, seperti konfirmasi penanganan dan penyelesaian anomali.|Rumus: jumlah tindakan operator pada periode yang dipilih.|Digunakan untuk memantau beban kerja dan respons tim terhadap anomali.">
        <div class="card-header bg-white py-2">
            <h6 class="mb-0"><i class="fas fa-chart-pie text-muted"></i> Ringkasan Operator</h6>
        </div>
        <div class="card-body">
            <div class="operator-audit-kpis mb-3">
                <div class="operator-audit-kpi"><div class="text-muted small">Total Tindakan</div><div class="h5 fw-bold mb-0" id="auditTotalActions">0</div></div>
                <div class="operator-audit-kpi"><div class="text-muted small">Penanganan Dikonfirmasi</div><div class="h5 fw-bold text-info mb-0" id="auditAcknowledged">0</div></div>
                <div class="operator-audit-kpi"><div class="text-muted small">Anomali Diselesaikan</div><div class="h5 fw-bold text-success mb-0" id="auditResolved">0</div></div>
                <div class="operator-audit-kpi"><div class="text-muted small">Catatan Dihapus</div><div class="h5 fw-bold text-danger mb-0" id="auditDeleted">0</div></div>
                <div class="operator-audit-kpi"><div class="text-muted small">Semua Catatan Dihapus</div><div class="h5 fw-bold text-danger mb-0" id="auditCleared">0</div></div>
                <div class="operator-audit-kpi"><div class="text-muted small">Operator Teraktif</div><div class="small fw-bold text-primary text-truncate" id="auditTopOperator" title="-">-</div></div>
            </div>
            <div id="operatorActionsSummaryGrid" style="width:100%;min-height:200px;"></div>
        </div>
    </div>
}

<!-- Detail Modal -->
<div class="modal fade" id="detailModal" tabindex="-1">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header bg-light">
                <h5 class="modal-title"><i class="fas fa-info-circle"></i> Detail Anomali #<span id="detailId"></span></h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span>&times;</span></button>
            </div>
            <div class="modal-body">
                <div class="detail-modal-grid">
                    <section class="detail-modal-card">
                        <h6><i class="fas fa-info-circle text-muted"></i> Informasi Dasar</h6>
                        <table class="table table-sm table-borderless mb-0">
                            <tbody>
                                <tr><td class="text-muted">Perangkat</td><td id="detailDevice">-</td></tr>
                                <tr><td class="text-muted">Lokasi</td><td id="detailLocation">-</td></tr>
                                <tr><td class="text-muted">Kategori Media</td><td id="detailDeviceCategory">-</td></tr>
                                <tr><td class="text-muted">Tipe</td><td id="detailType">-</td></tr>
                                <tr><td class="text-muted">Tingkat Keparahan</td><td id="detailSeverity">-</td></tr>
