@section Scripts {
    <script src="~/js/chart.umd.min.js"></script>
    <script>
        var autoRefreshTimer = null;
        var autoRefreshEnabled = true;
        var deleteLogId = null;
        var dataGrid = null;
        var allData = [];
        var currentDetailId = null;
        var currentUserRole = '@userRole';
        var trendChart = null;
        var severityPieChart = null;
        var detailChart = null;
        var latestMonthlyReportData = null;

        $(document).ready(function() {
            // Hide page-specific buttons not applicable to this page
            $('#btnRescan, #btnExport').hide();

            // Settings button
            $('#btnSettings').click(function() {
                window.location.href = '/Monitoring/Settings';
            });

            updateLastUpdate();
            setInterval(updateLastUpdate, 60000);

            initDataGrid();
            loadDashboard();
            loadTrends(7);

            $('#btnRefresh').click(function() {
                if (dataGrid) dataGrid.refresh();
                loadDashboard();
                loadTrends(7);
            });

            $('#autoRefreshCheck').change(function() {
                autoRefreshEnabled = $(this).is(':checked');
                if (autoRefreshEnabled) {
                    setupAutoRefresh();
                    $('#statusDot').removeClass('text-danger').addClass('text-success');
                    $('#statusText').text('Online');
                } else {
                    stopAutoRefresh();
                    $('#statusDot').removeClass('text-success').addClass('text-danger');
                    $('#statusText').text('Paused');
                }
            });

            $('#btnClearAll').click(function() { $('#clearAllModal').modal('show'); });
            $('#btnConfirmClearAll').click(function() { clearAllLogs(); });
            $('#btnConfirmDelete').click(function() { if (deleteLogId) deleteSingleLog(deleteLogId); });

            $('[data-days]').click(function() {
                $('[data-days]').removeClass('active');
                $(this).addClass('active');
                loadTrends(parseInt($(this).data('days')));
            });

            $('#btnConfirmResolve').click(function() { submitResolveFromModal(); });

            $('#btnLoadReport').click(function() { loadMonthlyReport(); });
            $('#btnGenerateReport').click(function() { generateMonthlyReport(); });
            $('#reportMonth, #reportYear').on('change', function() {
                if ($('#btnGenerateReport').length) generateMonthlyReport();
                else loadMonthlyReport();
            });

            $('#btnLoadAudit').click(function() { loadOperatorActions(); });
            $('#auditFromDate, #auditToDate').on('change', function() { loadOperatorActions(); });

            if ($('#btnGenerateReport').length) generateMonthlyReport();
            else loadMonthlyReport();
            if ($('#operatorActionsGrid').length) loadOperatorActions();

            setupAutoRefresh();

            $(window).on('resize.anomalyCenter', function() {
                if (trendChart) trendChart.render();
                if (severityPieChart) severityPieChart.render();
                if (detailChart) detailChart.render();
            });
        });

        function setupAutoRefresh() {
            stopAutoRefresh();
            if (autoRefreshEnabled) {
                autoRefreshTimer = setInterval(function() {
                    if (dataGrid) dataGrid.refresh();
                    loadDashboard();
                }, 30000);
            }
        }

        function stopAutoRefresh() {
            if (autoRefreshTimer) {
                clearInterval(autoRefreshTimer);
                autoRefreshTimer = null;
            }
        }

        function formatDateTime(isoStr) {
            if (!isoStr) return '-';
            try {
                var d = new Date(isoStr);
                if (isNaN(d.getTime())) return isoStr;
                var dd = String(d.getDate()).padStart(2, '0');
                var MM = String(d.getMonth() + 1).padStart(2, '0');
                var yyyy = d.getFullYear();
                var hh = String(d.getHours()).padStart(2, '0');
                var mm = String(d.getMinutes()).padStart(2, '0');
                var ss = String(d.getSeconds()).padStart(2, '0');
                return dd + '/' + MM + '/' + yyyy + ' ' + hh + ':' + mm + ':' + ss;
            } catch(e) {
                return isoStr;
            }
        }

        function fmt(value, precision) {
            if (value == null) return '-';
            return value.toLocaleString('id-ID', {
                minimumFractionDigits: precision,
                maximumFractionDigits: precision
            });
        }

        function formatNumber(num) {
            if (num === null || num === undefined || isNaN(num)) return '0';
            return Number(num).toLocaleString('id-ID', { maximumFractionDigits: 0 });
        }

        function severityClass(severity) {
            switch ((severity || '').toLowerCase()) {
                case 'critical': return 'severity-critical';
                case 'high': return 'severity-high';
                case 'medium': return 'severity-medium';
                case 'low': return 'severity-low';
                default: return 'severity-medium';
            }
        }

        // ============================================
        // DASHBOARD
        // ============================================
        function loadDashboard() {
            $.ajax({
                url: '/api/Api/anomaly-dashboard',
                method: 'GET',
                dataType: 'json',
                success: function(response) {
                    if (response.success && response.data) {
                        var d = response.data;
                        $('#dashTotal').text(d.total || 0);
                        $('#dashToday').text(d.today || 0);
                        $('#dashUnresolved').text(d.unresolved || 0);
                        $('#dashCritical').text(d.critical || 0);
                        $('#dashHigh').text(d.high || 0);
                        $('#dashAnomalyCost').text('Rp ' + formatNumber(d.totalAnomalyCostImpact || 0));
                        $('#dashRevenueLoss').text('Rp ' + formatNumber(d.totalRevenueLoss || 0));
                        $('#dashOngoingRevenueLoss').text('Rp ' + formatNumber(d.ongoingRevenueLoss || 0));
                        $('#dashFinancialDevices').text(d.financialDeviceCount || 0);
                    }
                },
                error: function() { }
            });
            loadDeviceDistribution();
        }

        function loadDeviceDistribution() {
            $.ajax({
                url: '/api/Api/anomaly-device-distribution',
                method: 'GET',
                dataType: 'json',
                success: function(response) {
                    if (response.success && response.data) {
                        renderDevicePieChart(response.data);
                    }
                },
                error: function() { }
            });
        }

        function renderDevicePieChart(data) {
            var chartData = data.map(function(item) {
                return { arg: item.group, val: item.count };
            });

            if (chartData.length === 0) {
                $('#anomalySeverityPieChart').html('<div class="d-flex align-items-center justify-content-center h-100 text-muted"><i class="fas fa-chart-pie me-2"></i>Tidak ada data</div>');
                return;
            }

            var container = $('#anomalySeverityPieChart');
            if (severityPieChart) {
                severityPieChart.option('dataSource', chartData);
                return;
            }

            severityPieChart = container.dxPieChart({
                dataSource: chartData,
                palette: ['#0d6efd', '#dc3545', '#ffc107', '#198754', '#6f42c1', '#fd7e14', '#20c997', '#e83e8c', '#6c757d', '#17a2b8'],
                legend: {
                    verticalAlignment: 'bottom',
                    horizontalAlignment: 'center',
                    font: { size: 11 }
                },
                tooltip: {
                    enabled: true,
                    percentPrecision: 1,
                    customizeTooltip: function(arg) {
                        return { text: arg.argumentText + ': ' + arg.valueText + ' anomali (' + arg.percentText + ')' };
                    }
                },
                size: { height: 260 },
                adaptiveLayout: { width: 150, height: 150 },
                series: [{
                    type: 'pie',
                    argumentField: 'arg',
                    valueField: 'val',
                    label: {
                        visible: true,
                        format: 'fixedPoint',
                        connector: { visible: true, width: 1 },
                        customizeText: function() { return this.argumentText + ': ' + this.valueText; }
                    }
                }]
            }).dxPieChart('instance');

            setTimeout(function() { if (severityPieChart) severityPieChart.render(); }, 200);
        }

        // ============================================
        // TRENDS
        // ============================================
        function loadTrends(days) {
            $.ajax({
                url: '/api/Api/anomaly-trends',
                method: 'GET',
                data: { days: days },
                dataType: 'json',
                success: function(response) {
                    if (response.success && response.data) {
                        renderTrendChart(response.data);
                    }
                },
                error: function() { }
            });
        }

        function renderTrendChart(data) {
            var chartData = data.map(function(item) {
                return {
                    date: new Date(item.date + 'T00:00:00'),
                    total: item.total,
                    overload: item.overload,
                    drop: item.drop,
                    critical: item.critical
                };
            });

            if (trendChart) {
                trendChart.option('dataSource', chartData);
                return;
            }

            trendChart = $('#anomalyTrendChart').dxChart({
                dataSource: chartData,
                commonSeriesSettings: {
                    argumentField: 'date',
                    type: 'spline',
                    point: { size: 5 }
                },
                series: [
                    { valueField: 'total', name: 'Total', color: '#0d6efd' },
                    { valueField: 'overload', name: 'Overload', color: '#dc3545' },
                    { valueField: 'drop', name: 'Drop', color: '#ffc107' },
                    { valueField: 'critical', name: 'Critical', color: '#7f1d1d' }
                ],
                legend: { verticalAlignment: 'bottom', horizontalAlignment: 'center', itemCount: 4 },
                tooltip: { enabled: true },
                valueAxis: { title: { text: 'Jumlah' }, minValueMargin: 0.1, label: { format: { type: 'fixedPoint', precision: 0 } } },
                argumentAxis: { label: { format: 'dd/MM', rotationAngle: -30 } },
                size: { height: 260 },
                adaptiveLayout: { width: 200, height: 150 }
            }).dxChart('instance');
        }

        // ============================================
        // DATA GRID
        // ============================================
        function initDataGrid() {
            dataGrid = $('#anomalyDataGrid').dxDataGrid({
                dataSource: new DevExpress.data.DataSource({
                    store: new DevExpress.data.CustomStore({
                        key: 'id',
                        load: function(loadOptions) {
                            var d = $.Deferred();
                            var params = { skip: loadOptions.skip || 0, take: loadOptions.take || 10 };
                            if (loadOptions.sort) params.sort = JSON.stringify(loadOptions.sort);

                            $.ajax({
                                url: '/api/Api/anomaly-logs/ALL',
                                method: 'GET',
                                data: params,
                                dataType: 'json',
                                success: function(response) {
                                    var rawData = response.data || [];
                                    var mapped = rawData.map(function(item) {
                                        return {
                                            id: item.id || item.Id || 0,
                                            deviceKey: item.deviceKey || item.DeviceKey || '',
                                            deviceId: item.deviceId || item.DeviceId || '',
                                            groupName: item.groupName || item.GroupName || item.deviceKey || '',
                                            location: item.location || item.Location || '-',
                                            deviceCategory: item.deviceCategory || item.DeviceCategory || 'Unknown',
                                            anomalyType: item.anomalyType || item.AnomalyType || '',
                                            powerValue: item.powerValue || item.PowerValue || 0,
                                            thresholdValue: item.thresholdValue || item.ThresholdValue || 0,
                                            deviation: item.deviation || item.Deviation || 0,
                                            detectedTime: item.detectedTime ? new Date(item.detectedTime) : null,
                                            emaValue: item.emaValue || item.EMAValue,
                                            thresholdMode: item.thresholdMode || item.ThresholdMode || 'manual',
                                            severity: item.severity || item.Severity || 'medium',
                                            rootCause: item.rootCause || item.RootCause || '',
                                            recommendedAction: item.recommendedAction || item.RecommendedAction || '',
                                            acknowledged: item.acknowledged || item.Acknowledged || false,
                                            acknowledgedTime: item.acknowledgedTime || item.AcknowledgedTime,
                                            isResolved: item.isResolved || item.IsResolved || false,
                                            resolvedTime: item.resolvedTime || item.ResolvedTime,
                                            durationMinutes: item.durationMinutes || item.DurationMinutes,
                                            responseTimeMinutes: item.responseTimeMinutes || item.ResponseTimeMinutes,
                                            revenueLoss: item.revenueLoss || item.RevenueLoss || 0,
                                            anomalyCostImpact: item.anomalyCostImpact || item.AnomalyCostImpact || 0,
                                            operatorAction: item.operatorAction || item.OperatorAction || '',
                                            operatorNotes: item.operatorNotes || item.OperatorNotes || '',
                                            notes: item.notes || item.Notes || ''
                                        };
                                    });
                                    allData = mapped;
                                    d.resolve(mapped, { totalCount: response.totalCount || 0 });
                                },
                                error: function(xhr, status, error) {
                                    /* console.error('Error loading anomaly logs:', error) */;
                                    d.reject(error);
