                    },
                    { dataField: 'id', caption: '#', width: 50, alignment: 'center', allowGrouping: false, allowFiltering: false, allowHeaderFiltering: false },
                    {
                        dataField: 'detectedTime', caption: 'Time', dataType: 'datetime', sortOrder: 'desc', alignment: 'center',
                        allowHeaderFiltering: false, filterOperations: ['between', '>=', '<=', '>', '<', '='], selectedFilterOperation: 'between',
                        format: { type: 'dd/MM/yyyy HH:mm:ss' },
                        cellTemplate: function(container, options) {
                            var val = options.value;
                            var text = '-';
                            if (val) {
                                if (val instanceof Date && !isNaN(val.getTime())) {
                                    var dd = String(val.getDate()).padStart(2, '0');
                                    var MM = String(val.getMonth() + 1).padStart(2, '0');
                                    var yyyy = val.getFullYear();
                                    var hh = String(val.getHours()).padStart(2, '0');
                                    var mm = String(val.getMinutes()).padStart(2, '0');
                                    var ss = String(val.getSeconds()).padStart(2, '0');
                                    text = dd + '/' + MM + '/' + yyyy + ' ' + hh + ':' + mm + ':' + ss;
                                } else {
                                    text = formatDateTime(val);
                                }
                            }
                            $('<span>').text(text).appendTo(container);
                        }
                    },
                    { dataField: 'groupName', caption: 'Device', alignment: 'center', headerFilter: { allowSelectAll: true } },
                    { dataField: 'deviceCategory', caption: 'Kategori Media', alignment: 'center', headerFilter: { allowSelectAll: true } },
                    { dataField: 'location', caption: 'Lokasi', alignment: 'center', visible: false },
                    {
                        dataField: 'anomalyType', caption: 'Type', alignment: 'center',
                        headerFilter: { dataSource: [{ text: 'OVERLOAD', value: 'OVERLOAD' }, { text: 'DEVICE DROP', value: 'DROP' }, { text: 'DEVICE DROP', value: 'DEVICE_DROP' }] },
                        cellTemplate: function(container, options) {
                            var v = options.value;
                            var cls, icon, text;
                            if (v === 'OVERLOAD') { cls = 'bg-danger'; icon = 'fa-bolt'; text = 'OVERLOAD'; }
                            else if (v === 'DROP' || v === 'DEVICE_DROP' || v === 'DEVICE DROP') { cls = 'bg-warning text-dark'; icon = 'fa-arrow-down'; text = 'DEVICE DROP'; }
                            else { cls = 'bg-info'; icon = 'fa-question'; text = v; }
                            $('<span>').addClass('badge ' + cls).html('<i class="fas ' + icon + '"></i> ' + text).appendTo(container);
                        }
                    },
                    {
                        dataField: 'severity', caption: 'Severity', alignment: 'center',
                        headerFilter: { dataSource: [{ text: 'Critical', value: 'critical' }, { text: 'High', value: 'high' }, { text: 'Medium', value: 'medium' }, { text: 'Low', value: 'low' }] },
                        cellTemplate: function(container, options) {
                            var v = options.value || 'medium';
                            $('<span>').addClass('severity-badge ' + severityClass(v)).text(severityLabel(v)).appendTo(container);
                        }
                    },
                    {
                        dataField: 'powerValue', caption: 'Power (W)', dataType: 'number', alignment: 'center',
                        cellTemplate: function(container, options) {
                            var v = options.value;
                            var cls = v > 20000 ? 'text-danger' : v > 10000 ? 'text-warning' : 'text-dark';
                            $('<span>').addClass('anomaly-power ' + cls).text(formatNumber(v) + ' W').appendTo(container);
                        }
                    },
                    { dataField: 'thresholdValue', caption: 'Threshold (W)', dataType: 'number', alignment: 'center', format: { type: 'fixedPoint', precision: 0 } },
                    {
                        dataField: 'deviation', caption: 'Deviation', dataType: 'number', alignment: 'center',
                        cellTemplate: function(container, options) {
                            var v = options.value;
                            var cls = v > 100 ? 'text-danger' : v > 50 ? 'text-warning' : 'text-success';
                            $('<span>').addClass('anomaly-deviation ' + cls).text(fmt(v, 1) + '%').appendTo(container);
                        }
                    },
                    {
                        dataField: 'thresholdMode', caption: 'Mode', alignment: 'center',
                        headerFilter: { dataSource: [{ text: 'MANUAL', value: 'manual' }, { text: 'EMA', value: 'ema' }] },
                        cellTemplate: function(container, options) { $('<span>').addClass('badge bg-info').text(options.value.toUpperCase()).appendTo(container); }
                    },
                    {
                        dataField: 'durationMinutes', caption: 'Durasi', dataType: 'number', alignment: 'center',
                        cellTemplate: function(container, options) {
                            var v = options.value;
                            if (v == null || v === undefined) { $('<span>').addClass('text-muted small fst-italic').text('ongoing').appendTo(container); return; }
                            var h = Math.floor(v / 60);
                            var m = Math.floor(v % 60);
                            var text = h > 0 ? h + 'j ' + m + 'm' : m + 'm';
                            $('<span>').text(text).appendTo(container);
                        }
                    },
                    {
                        dataField: 'responseTimeMinutes', caption: 'Response', dataType: 'number', alignment: 'center',
                        cellTemplate: function(container, options) {
                            var v = options.value;
                            if (v == null || v === undefined) { $('<span>').text('-').appendTo(container); return; }
                            var h = Math.floor(v / 60);
                            var m = Math.floor(v % 60);
                            var cls = v <= 60 ? 'text-success' : v <= 240 ? 'text-warning' : 'text-danger';
                            var text = h > 0 ? h + 'j ' + m + 'm' : m + 'm';
                            $('<span>').addClass(cls).text(text).appendTo(container);
                        }
                    },
                    {
                        dataField: 'anomalyCostImpact', caption: 'Dampak Biaya', dataType: 'number', alignment: 'center',
                        cellTemplate: function(container, options) {
                            var v = options.value || 0;
                            var data = options.row.data;
                            if (data.anomalyType !== 'OVERLOAD' || v <= 0) { $('<span>').text('-').appendTo(container); return; }
                            $('<span>').addClass('text-danger fw-bold').text('Rp ' + formatNumber(v)).appendTo(container);
                        }
                    },
                    {
                        dataField: 'revenueLoss', caption: 'Revenue Loss', dataType: 'number', alignment: 'center',
                        cellTemplate: function(container, options) {
                            var v = options.value || 0;
                            var data = options.row.data;
                            var isResolved = data.isResolved;
                            if (data.anomalyType !== 'DROP' && data.anomalyType !== 'DEVICE_DROP') { $('<span>').text('-').appendTo(container); return; }
                            var cls = 'text-danger fw-bold';
                            if (!isResolved) cls += ' fst-italic';
                            $('<span>').addClass(cls).text('Rp ' + formatNumber(v) + (!isResolved ? ' *' : '')).appendTo(container);
                        }
                    },
                    {
                        dataField: 'isResolved', caption: 'Status', dataType: 'boolean', alignment: 'center',
                        headerFilter: { dataSource: [{ text: 'New', value: false }, { text: 'Resolved', value: true }] },
                        cellTemplate: function(container, options) {
                            var data = options.row.data;
                            if (data.isResolved) $('<span>').addClass('badge bg-success').html('<i class="fas fa-check-double"></i> Resolved').appendTo(container);
                            else if (data.acknowledged) $('<span>').addClass('badge bg-info').html('<i class="fas fa-check"></i> Acknowledged').appendTo(container);
                            else $('<span>').addClass('badge bg-secondary').html('<i class="fas fa-circle"></i> New').appendTo(container);
                        }
                    },
                ]
            }).dxDataGrid('instance');
        }

        // ============================================
        // DETAIL MODAL
        // ============================================
        var pendingChartSnapshot = null;
        var detailSnapshotPollTimer = null;
        var detailSnapshotRequestInFlight = false;
        var lastDetailSnapshotSignature = null;
        var currentDetailSnapshotStatus = null;
        var currentDetailSnapshotAfterCount = 0;

        function openDetailModal(id) {
            currentDetailId = id;
            lastDetailSnapshotSignature = null;
            currentDetailSnapshotStatus = null;
            currentDetailSnapshotAfterCount = 0;
            $.ajax({
                url: '/api/Api/anomaly-logs/detail/' + id,
                method: 'GET',
                dataType: 'json',
                success: function(response) {
                    if (response.success && response.data) {
                        renderDetailModal(response.data);
                        // Defer chart rendering until modal is visible (DevExtreme needs container dimensions)
                        pendingChartSnapshot = response.data.chartSnapshot;
                        $('#detailModal').modal('show');
                    } else {
                        showNotification('Gagal memuat detail anomali', 'danger');
                    }
                },
                error: function() { showNotification('Gagal memuat detail anomali', 'danger'); }
            });
        }

        // Render chart AFTER modal is shown so Chart.js can measure the container
        $('#detailModal').on('shown.bs.modal', function() {
            if (pendingChartSnapshot !== null) {
                var initialSnapshot = pendingChartSnapshot;
                var initialStatus = (initialSnapshot.snapshotStatus || '').toLowerCase();
                var initialSignature = initialStatus + '|' + (initialSnapshot.beforeDataJson || '') + '|' + (initialSnapshot.afterDataJson || '');
                renderDetailChart(initialSnapshot, initialSignature);
                pendingChartSnapshot = null;
            }
            // Force chart resize after modal animation completes
            setTimeout(function() {
                if (detailChart) detailChart.resize();
            }, 150);
            startDetailSnapshotPolling();
        });

        function startDetailSnapshotPolling() {
            stopDetailSnapshotPolling();
            if (!currentDetailId || currentDetailSnapshotStatus === 'complete' || currentDetailSnapshotAfterCount >= 50) return;
            detailSnapshotPollTimer = setInterval(function() {
                if (!$('#detailModal').hasClass('show') || !currentDetailId) {
                    stopDetailSnapshotPolling();
                    return;
                }
                if (detailSnapshotRequestInFlight) return;
                var pollingId = currentDetailId;
                detailSnapshotRequestInFlight = true;
                $.ajax({
                    url: '/api/Api/anomaly-logs/' + pollingId + '/chart-snapshot',
                    method: 'GET',
                    dataType: 'json',
                    success: function(response) {
                        if (!$('#detailModal').hasClass('show') || currentDetailId !== pollingId) return;
                        if (!response.success || !response.data) return;
                        var snapshot = response.data;
                        var afterPoints = [];
                        try { afterPoints = JSON.parse(snapshot.afterDataJson || '[]') || []; } catch(e) {}
                        var status = (snapshot.snapshotStatus || '').toLowerCase();
                        var signature = status + '|' + (snapshot.beforeDataJson || '') + '|' + (snapshot.afterDataJson || '');
                        if (signature !== lastDetailSnapshotSignature) renderDetailChart(snapshot, signature);
                        if (status === 'complete' || afterPoints.length >= 50) {
                            currentDetailSnapshotStatus = 'complete';
                            stopDetailSnapshotPolling();
                        }
                    },
                    complete: function() { detailSnapshotRequestInFlight = false; }
                });
            }, 2500);
        }

        function stopDetailSnapshotPolling() {
            if (detailSnapshotPollTimer) {
                clearInterval(detailSnapshotPollTimer);
                detailSnapshotPollTimer = null;
            }
        }

        function isEnglishUi() {
            try { return localStorage.getItem('kwh_language') === 'en'; } catch (e) { return false; }
        }

        function severityLabel(severity) {
            var labels = isEnglishUi()
                ? { critical: 'Critical', high: 'High', medium: 'Medium', low: 'Low' }
                : { critical: 'Kritis', high: 'Tinggi', medium: 'Sedang', low: 'Rendah' };
            var key = String(severity || '').toLowerCase();
            return labels[key] || severity || '-';
        }

        // Clean up chart when modal is hidden — replace container DOM to fully reset Chart.js state
        $('#detailModal').on('hidden.bs.modal', function() {
            stopDetailSnapshotPolling();
            currentDetailId = null;
            currentDetailSnapshotStatus = null;
            lastDetailSnapshotSignature = null;
            currentDetailSnapshotAfterCount = 0;
            detailSnapshotRequestInFlight = false;
            $('#detailSnapshotLiveBadge').addClass('d-none');
            $('#detailSnapshotProgress').text('');
            $('#detailSnapshotProgressBar').css('width', '0');
            if (detailChart) {
                try { detailChart.destroy(); } catch(e) {}
                detailChart = null;
            }
            // Replace container element entirely to avoid stale Chart.js canvas state
            $('#detailChartSnapshotContainer').replaceWith('<div id="detailChartSnapshotContainer" class="detail-chart-snapshot-container"><canvas id="detailChartSnapshot"></canvas></div>');
            pendingChartSnapshot = null;
        });

        function renderDetailModal(data) {
            data = data || {};
            var detailEnglish = false;
            try { detailEnglish = localStorage.getItem('kwh_language') === 'en'; } catch (e) { }
            $('#detailId').text(data.id || '-');
            $('#detailDevice').text((data.groupName || data.deviceKey || '-') + (data.deviceId ? ' (' + data.deviceId + ')' : ''));
            $('#detailLocation').text(data.location || '-');
            $('#detailDeviceCategory').text(data.deviceCategory || (detailEnglish ? 'Unknown' : 'Tidak diketahui'));
            $('#detailType').html(renderTypeBadge(data.anomalyType));
            $('#detailSeverity').html('<span class="severity-badge ' + severityClass(data.severity) + '">' + severityLabel(data.severity || 'medium') + '</span>');
            $('#detailPower').text(formatNumber(data.powerValue) + ' W');
            $('#detailThreshold').text(formatNumber(data.thresholdValue) + ' W');
            $('#detailDeviation').text(fmt(data.deviation, 1) + '%');
            $('#detailTime').text(formatDateTime(data.detectedTime) || '-');

            var dur = data.durationMinutes;
            if (dur == null || dur === undefined)
                $('#detailDuration').html('<span class="text-muted fst-italic">' + (detailEnglish ? 'Ongoing' : 'Sedang berlangsung') + '</span>');
            else {
                var h = Math.floor(dur / 60);
                var m = Math.floor(dur % 60);
                $('#detailDuration').text(detailEnglish ? (h > 0 ? h + 'h ' + m + 'm' : m + 'm') : (h > 0 ? h + ' jam ' + m + ' menit' : m + ' menit'));
            }

            var resp = data.responseTimeMinutes;
            if (resp == null || resp === undefined)
                $('#detailResponseTime').text('-');
            else {
                var rh = Math.floor(resp / 60);
                var rm = Math.floor(resp % 60);
                $('#detailResponseTime').text(rh > 0 ? rh + 'j ' + rm + 'm' : rm + 'm');
            }

            var statusHtml;
            if (data.isResolved) statusHtml = '<span class="badge bg-success">Resolved</span>';
            else if (data.acknowledged) statusHtml = '<span class="badge bg-info">Acknowledged</span>';
            else statusHtml = '<span class="badge bg-secondary">New</span>';
            $('#detailStatus').html(statusHtml);

            $('#detailRootCause').text(data.rootCause || '-');
            $('#detailRecommendedAction').text(data.recommendedAction || '-');
            $('#detailOperatorNotes').text(data.operatorNotes || '-');

            // Financial impact
            var isDrop = data.anomalyType === 'DROP' || data.anomalyType === 'DEVICE_DROP';
            var isOverload = data.anomalyType === 'OVERLOAD';
            var cost = data.anomalyCostImpact || 0;
            var revenue = data.revenueLoss || 0;

            if (isOverload && cost > 0) {
                $('#detailAnomalyCostImpact').text('Rp ' + formatNumber(cost)).addClass('text-danger');
                $('#detailRevenueLoss').text('-').removeClass('text-danger');
                $('#detailFinancialNote').text('Dampak biaya energi akibat beban berlebih, dihitung dari selisih daya × 0,25 jam × tarif.');
            } else if (isDrop) {
                $('#detailAnomalyCostImpact').text('-').removeClass('text-danger');
                $('#detailRevenueLoss').text('Rp ' + formatNumber(revenue) + (data.isResolved ? '' : ' *')).addClass('text-danger');
                var note = 'Perkiraan kehilangan pendapatan selama perangkat mengalami gangguan.';
                if (!data.isResolved) note += ' Perhitungan berlanjut hingga anomali diselesaikan.';
                if (revenue === 0) note = 'Pendapatan per jam belum dikonfigurasi untuk perangkat ini.';
                $('#detailFinancialNote').text(note);
            } else {
                $('#detailAnomalyCostImpact').text('-').removeClass('text-danger');
                $('#detailRevenueLoss').text('-').removeClass('text-danger');
                $('#detailFinancialNote').text('Dampak keuangan untuk jenis anomali ini tidak dapat diperkirakan.');
            }

            // Chart rendering deferred to 'shown.bs.modal' event — see openDetailModal()
        }

        function renderTypeBadge(type) {
            var cls, icon, text;
            if (type === 'OVERLOAD') { cls = 'bg-danger'; icon = 'fa-bolt'; text = isEnglishUi() ? 'OVERLOAD' : 'BEBAN BERLEBIH'; }
            else if (type === 'DROP' || type === 'DEVICE_DROP' || type === 'DEVICE DROP') { cls = 'bg-warning text-dark'; icon = 'fa-arrow-down'; text = isEnglishUi() ? 'DEVICE DROP' : 'GANGGUAN PERANGKAT'; }
            else { cls = 'bg-info'; icon = 'fa-question'; text = type; }
            return '<span class="badge ' + cls + '"><i class="fas ' + icon + '"></i> ' + text + '</span>';
        }

        function renderDetailChart(snapshot, snapshotSignature) {
            currentDetailSnapshotStatus = (snapshot && snapshot.snapshotStatus || '').toLowerCase();
            if (snapshotSignature) lastDetailSnapshotSignature = snapshotSignature;
            if (!snapshot || (!snapshot.beforeDataJson && !snapshot.afterDataJson)) {
                $('#detailChartSnapshotContainer').html('<div class="h-100 d-flex align-items-center justify-content-center text-muted">Snapshot belum tersedia. Menunggu data…</div>');
                $('#detailSnapshotStatus').text('Snapshot akan diperbarui otomatis selama data pasca-anomali dikumpulkan.');
                $('#detailSnapshotLiveBadge').removeClass('d-none');
                return;
            }

            var beforeData = [], afterData = [];
            try {
                beforeData = JSON.parse(snapshot.beforeDataJson || '[]') || [];
                afterData = JSON.parse(snapshot.afterDataJson || '[]') || [];
            } catch (e) {
                $('#detailChartSnapshotContainer').html('<div class="h-100 d-flex align-items-center justify-content-center text-danger">Gagal memuat data chart snapshot.</div>');
                return;
            }
            currentDetailSnapshotAfterCount = afterData.length;

            // Ensure container has a canvas element (may have been replaced with a placeholder)
            if (!$('#detailChartSnapshot').length || $('#detailChartSnapshot').is('div')) {
                $('#detailChartSnapshotContainer').html('<canvas id="detailChartSnapshot"></canvas>');
            }
            // Build labels and data arrays for Chart.js
            var labels = [];
            var powerArr = [], upperArr = [], lowerArr = [], emaArr = [];

            function fmtTime(ts) {
                if (!ts) return null;
                var d = new Date(ts);
                if (isNaN(d.getTime())) return null;
                var hh = String(d.getHours()).padStart(2, '0');
                var mm = String(d.getMinutes()).padStart(2, '0');
                var ss = String(d.getSeconds()).padStart(2, '0');
                return hh + ':' + mm + ':' + ss;
            }

            var allData = beforeData.concat(afterData);
            var hasValidTime = false;
            allData.forEach(function(p, i) {
                var ts = p.Timestamp || p.timestamp;
                var label = fmtTime(ts);
                if (label) hasValidTime = true;
                if (!label) label = '#' + (i + 1);
                labels.push(label);
                powerArr.push(p.Power != null ? p.Power : (p.power != null ? p.power : null));
                upperArr.push(p.Upper != null ? p.Upper : (p.upper != null ? p.upper : null));
                lowerArr.push(p.Lower != null ? p.Lower : (p.lower != null ? p.lower : null));
                emaArr.push(p.EMA != null ? p.EMA : (p.ema != null ? p.ema : null));
            });

            // Anomaly marker index: boundary between before/after
            var anomalyIdx = beforeData.length > 0 ? beforeData.length - 1 : -1;

            var statusLabel;
            if (currentDetailSnapshotStatus === 'complete' || afterData.length >= 50) statusLabel = 'Snapshot lengkap';
            else if (afterData.length > 0) statusLabel = 'Mengumpulkan sampel pasca-anomali';
            else statusLabel = 'Menunggu sampel pertama setelah anomali';
            $('#detailSnapshotStatus').text(statusLabel + ' · ' + beforeData.length + ' titik sebelum anomaly');
            $('#detailSnapshotProgress').text(Math.min(afterData.length, 50) + ' / 50 titik sesudah anomaly');
            $('#detailSnapshotProgressBar').css('width', Math.min(afterData.length, 50) * 2 + '%');
            $('#detailSnapshotLiveBadge').toggleClass('d-none', currentDetailSnapshotStatus === 'complete' || afterData.length >= 50);

            // Build Chart.js datasets — same style as All Charts page
            var datasets = [{
                label: 'Power (W)',
                data: powerArr,
                borderColor: '#00cc66',
                backgroundColor: 'rgba(0,204,102,0.15)',
                fill: true,
                tension: 0.3,
                borderWidth: 2,
                pointRadius: 0,
                pointHoverRadius: 5,
                order: 3
            }];

            if (upperArr.some(function(v) { return v != null; })) {
                datasets.push({
                    label: 'Upper Threshold',
                    data: upperArr,
                    borderColor: '#ff0000',
                    backgroundColor: 'rgba(255,0,0,0.05)',
                    fill: '+1',
                    tension: 0,
                    borderWidth: 2,
                    borderDash: [10, 5],
                    pointRadius: 0,
                    pointHoverRadius: 0,
                    order: 1
                });
            }

            if (lowerArr.some(function(v) { return v != null; })) {
                datasets.push({
                    label: 'Lower Threshold',
                    data: lowerArr,
                    borderColor: '#ff9900',
                    backgroundColor: 'transparent',
                    fill: false,
                    tension: 0,
                    borderWidth: 2,
                    borderDash: [10, 5],
                    pointRadius: 0,
                    pointHoverRadius: 0,
                    order: 1
                });
            }

            if (emaArr.some(function(v) { return v != null; })) {
                datasets.push({
                    label: 'EMA',
                    data: emaArr,
                    borderColor: '#ff6600',
                    backgroundColor: 'transparent',
                    fill: false,
                    tension: 0.3,
                    borderWidth: 2,
                    borderDash: [5, 5],
                    pointRadius: 0,
                    pointHoverRadius: 4,
                    order: 2
                });
            }

            // Chart.js annotation plugin for anomaly marker — use a custom plugin instead
            var anomalyMarkerPlugin = {
                id: 'anomalyMarker',
                afterDraw: function(chart) {
                    if (anomalyIdx < 0 || anomalyIdx >= labels.length) return;
                    var meta = chart.getDatasetMeta(0);
                    if (!meta || !meta.data || !meta.data[anomalyIdx]) return;
                    var x = meta.data[anomalyIdx].x;
                    var yAxis = chart.scales.y;
                    var ctx = chart.ctx;
                    ctx.save();
                    ctx.beginPath();
                    ctx.setLineDash([6, 3]);
                    ctx.strokeStyle = '#dc3545';
                    ctx.lineWidth = 2;
                    ctx.moveTo(x, yAxis.top);
                    ctx.lineTo(x, yAxis.bottom);
                    ctx.stroke();
                    // Label
                    ctx.setLineDash([]);
                    ctx.fillStyle = '#dc3545';
                    ctx.font = 'bold 11px sans-serif';
                    ctx.textAlign = 'center';
                    ctx.fillText('⚡ Anomali', x, yAxis.top - 6);
                    ctx.restore();
                }
            };

            var ctx = document.getElementById('detailChartSnapshot');
            if (detailChart) {
                detailChart.data.labels = labels;
                detailChart.data.datasets = datasets;
                detailChart.update('none');
                return;
            }
            detailChart = new Chart(ctx, {
                type: 'line',
                data: { labels: labels, datasets: datasets },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    interaction: { mode: 'index', intersect: false },
                    scales: {
                        x: {
                            ticks: { font: { size: 10 }, autoSkip: true, maxTicksLimit: 12, maxRotation: 0, minRotation: 0, color: (typeof window.getChartTickColor === 'function' ? window.getChartTickColor() : '#666') },
                            grid: { color: (typeof window.getChartGridColor === 'function' ? window.getChartGridColor() : '#e0e0e0'), drawBorder: false },
                            title: { display: true, text: hasValidTime ? 'Waktu' : 'Data Point' }
                        },
                        y: {
                            beginAtZero: false,
                            ticks: {
                                font: { size: 9 },
                                color: (typeof window.getChartTickColor === 'function' ? window.getChartTickColor() : '#666'),
                                callback: function(v) { return v.toLocaleString('id-ID') + 'W'; }
                            },
                            grid: { color: (typeof window.getChartGridColor === 'function' ? window.getChartGridColor() : '#e0e0e0'), drawBorder: false },
                            title: { display: true, text: 'Power (W)' }
                        }
                    },
                    plugins: {
                        legend: { display: true, position: 'bottom', labels: { boxWidth: 12, font: { size: 11 } } },
                        title: { display: false },
                        tooltip: {
                            enabled: true,
                            backgroundColor: 'rgba(0,0,0,0.8)',
                            titleColor: '#fff',
                            bodyColor: '#fff',
                            borderColor: '#444',
                            borderWidth: 1,
                            padding: 10,
                            displayColors: true,
                            callbacks: {
                                title: function(ctx) { return 'Waktu: ' + ctx[0].label; },
                                label: function(ctx) {
                                    var lbl = ctx.dataset.label || '';
                                    var val = ctx.parsed.y;
                                    if (lbl) lbl += ': ';
                                    if (val == null) return lbl + '—';
                                    return lbl + val.toLocaleString('id-ID', { maximumFractionDigits: 0 }) + ' W';
                                }
                            }
                        }
                    },
                    layout: { padding: { top: 20 } }
                },
                plugins: [anomalyMarkerPlugin]
            });
        }

