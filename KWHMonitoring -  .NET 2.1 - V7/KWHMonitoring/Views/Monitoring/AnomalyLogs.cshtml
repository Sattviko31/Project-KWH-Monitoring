                    else if (e.column.dataField === 'powerValue' && e.value > 10000) e.cellElement.css('background-color', 'rgba(255,193,7,0.1)');
                },
                onRowPrepared: function(e) {
                    if (e.rowType !== 'data') return;
                    var t = e.data.anomalyType;
                    if (t === 'OVERLOAD') e.rowElement.css('border-left', '3px solid #dc3545');
                    else if (t === 'DROP' || t === 'DEVICE_DROP' || t === 'DEVICE DROP') e.rowElement.css('border-left', '3px solid #ffc107');
                    else e.rowElement.css('border-left', '3px solid #0d6efd');
                },
                columns: [
                    {
                        caption: 'Action', width: 180, alignment: 'center',
                        allowFiltering: false, allowSorting: false, allowGrouping: false, allowHeaderFiltering: false,
                        cellTemplate: function(container, options) {
                            var data = options.data;
                            var buttons = $('<div class="d-flex justify-content-center gap-1">');
                            $('<button>').addClass('btn btn-sm btn-info').attr('title', 'View detail').html('<i class="fas fa-eye"></i>')
                                .on('click', function(e) { e.stopPropagation(); openDetailModal(data.id); }).appendTo(buttons);
                            if (currentUserRole === 'Operator' || currentUserRole === 'Admin') {
                                var canAcknowledge = !data.acknowledged && !data.isResolved;
                                var canResolve = !data.isResolved;
                                $('<button>').addClass('btn btn-sm btn-warning' + (canAcknowledge ? '' : ' disabled')).attr('title', canAcknowledge ? 'Acknowledge' : 'Already acknowledged / resolved').prop('disabled', !canAcknowledge).html('<i class="fas fa-check"></i>')
                                    .on('click', function(e) { if (!canAcknowledge) return; e.stopPropagation(); acknowledgeAnomaly(data.id); }).appendTo(buttons);
                                $('<button>').addClass('btn btn-sm btn-success' + (canResolve ? '' : ' disabled')).attr('title', canResolve ? 'Resolve' : 'Already resolved').prop('disabled', !canResolve).html('<i class="fas fa-check-double"></i>')
                                    .on('click', function(e) { if (!canResolve) return; e.stopPropagation(); openResolveModal(data.id, data.groupName || data.deviceKey, data.anomalyType); }).appendTo(buttons);
                            }
                            if (currentUserRole === 'Admin') {
                                $('<button>').addClass('btn btn-sm btn-outline-danger').attr('title', 'Delete log').html('<i class="fas fa-trash"></i>')
                                    .on('click', function(e) { e.stopPropagation(); confirmDelete(data.id, data.groupName || data.deviceKey, data.anomalyType); }).appendTo(buttons);
