@{
    ViewData["Title"] = "Anomaly Center";
    var userRole = ViewBag.CurrentUserRole?.ToString() ?? "Viewer";
}

@await Html.PartialAsync("_DashboardHeader")

<!-- Anomaly Center Page Controls -->
<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div class="d-flex align-items-center gap-2">
        <span class="badge badge-light border">Role: <span id="userRoleBadge">@userRole</span></span>
    </div>
    <label class="form-check mb-0 d-flex align-items-center">
        <input type="checkbox" id="autoRefreshCheck" checked class="form-check-input me-1">
        <small class="text-muted">Auto Refresh</small>
    </label>
</div>

<!-- KPI Cards -->
<div class="stats-row mb-3">
    <div>
        <div class="stat-card" style="background: linear-gradient(135deg,#0dcaf0,#0d6efd);color:#fff;">
            <div class="stat-label">Total Anomali</div>
            <div class="stat-value" id="dashTotal">0</div>
            <i class="fas fa-list stat-icon"></i>
        </div>
    </div>
    <div>
        <div class="stat-card" style="background: linear-gradient(135deg,#20c997,#198754);color:#fff;">
            <div class="stat-label">Hari Ini</div>
            <div class="stat-value" id="dashToday">0</div>
            <i class="fas fa-calendar-day stat-icon"></i>
        </div>
    </div>
    <div>
        <div class="stat-card" style="background: linear-gradient(135deg,#ffc107,#fd7e14);color:#fff;">
            <div class="stat-label">Belum Resolve</div>
            <div class="stat-value" id="dashUnresolved">0</div>
            <i class="fas fa-exclamation-circle stat-icon"></i>
        </div>
    </div>
    <div>
        <div class="stat-card" style="background: linear-gradient(135deg,#dc3545,#7f1d1d);color:#fff;">
            <div class="stat-label">Critical</div>
            <div class="stat-value" id="dashCritical">0</div>
            <i class="fas fa-bomb stat-icon"></i>
        </div>
    </div>
    <div>
        <div class="stat-card" style="background: linear-gradient(135deg,#6610f2,#6f42c1);color:#fff;">
            <div class="stat-label">High</div>
            <div class="stat-value" id="dashHigh">0</div>
            <i class="fas fa-exclamation-triangle stat-icon"></i>
        </div>
    </div>
    <div>
        <div class="stat-card" style="background: linear-gradient(135deg,#6c757d,#495057);color:#fff;">
            <div class="stat-label">Device Terdampak</div>
            <div class="stat-value" id="dashTopDevice" title="-">-</div>
            <i class="fas fa-server stat-icon"></i>
        </div>
    </div>
</div>

<!-- Charts -->
<div class="charts-row mb-3">
    <div class="charts-col charts-col-main">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-white d-flex justify-content-between align-items-center py-2">
                <h6 class="mb-0"><i class="fas fa-chart-line text-muted"></i> Tren Anomali</h6>
                <div class="btn-group btn-group-sm" role="group">
                    <button type="button" class="btn btn-outline-secondary active" data-days="7">7 Hari</button>
                    <button type="button" class="btn btn-outline-secondary" data-days="30">30 Hari</button>
                </div>
            </div>
            <div class="card-body py-2">
                <div id="anomalyTrendChart" class="anomaly-chart-container"></div>
            </div>
        </div>
    </div>
    <div class="charts-col charts-col-side">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-white py-2">
                <h6 class="mb-0"><i class="fas fa-chart-pie text-muted"></i> Anomali per Device</h6>
            </div>
            <div class="card-body py-2">
                <div id="anomalySeverityPieChart" class="anomaly-chart-container"></div>
            </div>
        </div>
    </div>
</div>

<!-- Financial Impact KPIs -->
<div class="stats-row mb-3" id="financialImpactRow">
    <div>
        <div class="stat-card" style="background: linear-gradient(135deg,#fd7e14,#ff9f43);color:#fff;">
            <div class="stat-label">Dampak Biaya Anomali</div>
            <div class="stat-value" id="dashAnomalyCost">Rp 0</div>
            <i class="fas fa-bolt stat-icon"></i>
        </div>
    </div>
    <div>
        <div class="stat-card" style="background: linear-gradient(135deg,#dc3545,#c0392b);color:#fff;">
            <div class="stat-label">Estimasi Revenue Loss</div>
            <div class="stat-value" id="dashRevenueLoss">Rp 0</div>
            <i class="fas fa-money-bill-wave stat-icon"></i>
        </div>
    </div>
    <div>
        <div class="stat-card" style="background: linear-gradient(135deg,#6f42c1,#8e44ad);color:#fff;">
            <div class="stat-label">Revenue Loss Berlangsung</div>
            <div class="stat-value" id="dashOngoingRevenueLoss">Rp 0</div>
            <i class="fas fa-clock stat-icon"></i>
        </div>
    </div>
    <div>
        <div class="stat-card" style="background: linear-gradient(135deg,#0d6efd,#2980b9);color:#fff;">
            <div class="stat-label">Device Terdampak Finansial</div>
            <div class="stat-value" id="dashFinancialDevices">-</div>
            <i class="fas fa-stopwatch stat-icon"></i>
        </div>
    </div>
</div>

<!-- DataGrid -->
<div class="card shadow-sm mb-3">
    <div class="card-header bg-white d-flex justify-content-between align-items-center py-2 flex-wrap gap-2">
        <h6 class="mb-0"><i class="fas fa-list text-muted"></i> Daftar Anomali</h6>
        <div class="d-flex gap-1">
            @if (userRole == "Admin")
            {
                <button class="btn btn-sm btn-danger" id="btnClearAll">
                    <i class="fas fa-trash-alt"></i> <span class="d-none d-sm-inline">Clear All</span>
                </button>
            }
        </div>
    </div>
    <div class="card-body p-0">
        <div class="anomaly-grid-scroll-wrapper">
            <div id="anomalyDataGrid" style="width:100%;"></div>
        </div>
    </div>
</div>

<!-- Laporan Bulanan -->
<div class="card shadow-sm mb-3">
    <div class="card-header bg-white py-2">
        <h6 class="mb-0"><i class="fas fa-file-alt text-muted"></i> Laporan Bulanan Anomali</h6>
    </div>
    <div class="card-body">
        <div class="report-form-row mb-3">
            <div class="report-form-field">
                <label class="form-label small mb-1">Bulan</label>
                <select id="reportMonth" class="form-select form-select-sm">
                    @for (int m = 1; m <= 12; m++)
                    {
                        <option value="@m" selected="@(m == DateTime.Now.Month ? "selected" : null)">@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(m)</option>
                    }
                </select>
            </div>
            <div class="report-form-field">
                <label class="form-label small mb-1">Tahun</label>
                <select id="reportYear" class="form-select form-select-sm">
                    @for (int y = DateTime.Now.Year - 5; y <= DateTime.Now.Year; y++)
                    {
                        <option value="@y" selected="@(y == DateTime.Now.Year ? "selected" : null)">@y</option>
                    }
                </select>
            </div>
            <div class="report-form-actions">
                <button class="btn btn-outline-secondary btn-sm" id="btnLoadReport">
                    <i class="fas fa-search"></i> Tampilkan
                </button>
                @if (userRole == "Operator" || userRole == "Admin")
                {
                    <button class="btn btn-primary btn-sm ms-1" id="btnGenerateReport">
                        <i class="fas fa-sync-alt"></i> Generate
                    </button>
                }
            </div>
        </div>

        <div id="monthlyReportContainer" class="d-none">
            <div class="report-stats-row mb-3">
                <div class="report-stat-card">
                    <div class="border rounded p-2 text-center">
                        <div class="text-muted small">Total Anomali</div>
                        <div class="h5 mb-0 fw-bold text-primary" id="repTotal">0</div>
                    </div>
                </div>
                <div class="report-stat-card">
                    <div class="border rounded p-2 text-center">
                        <div class="text-muted small">Overload</div>
                        <div class="h5 mb-0 fw-bold text-danger" id="repOverload">0</div>
                    </div>
                </div>
                <div class="report-stat-card">
                    <div class="border rounded p-2 text-center">
                        <div class="text-muted small">Device Drop</div>
                        <div class="h5 mb-0 fw-bold text-warning" id="repDrop">0</div>
                    </div>
                </div>
                <div class="report-stat-card">
                    <div class="border rounded p-2 text-center">
                        <div class="text-muted small">Device Terdampak</div>
                        <div class="h5 mb-0 fw-bold text-info" id="repAffected">0</div>
                    </div>
                </div>
                <div class="report-stat-card">
                    <div class="border rounded p-2 text-center">
                        <div class="text-muted small">Dampak Biaya</div>
                        <div class="h5 mb-0 fw-bold text-danger" id="repAnomalyCost">Rp 0</div>
                    </div>
                </div>
                <div class="report-stat-card">
                    <div class="border rounded p-2 text-center">
                        <div class="text-muted small">Revenue Loss</div>
                        <div class="h5 mb-0 fw-bold text-danger" id="repRevenueLoss">Rp 0</div>
                    </div>
                </div>
                <div class="report-stat-card">
                    <div class="border rounded p-2 text-center">
                        <div class="text-muted small">Loss Berlangsung</div>
                        <div class="h5 mb-0 fw-bold text-warning" id="repOngoingRevenueLoss">Rp 0</div>
                    </div>
                </div>
            </div>
            <div class="card bg-light mb-3">
                <div class="card-body py-2">
                    <strong><i class="fas fa-clipboard-list text-muted me-1"></i>Ringkasan:</strong>
                    <p class="mb-1" id="repSummary">-</p>
                </div>
            </div>
            <div class="card mb-3">
                <div class="card-header bg-white py-2"><strong><i class="fas fa-lightbulb text-muted me-1"></i>Rekomendasi</strong></div>
                <div class="card-body py-2">
                    <div id="repRecommendations" class="small">-</div>
                </div>
            </div>
            <div class="card mb-3">
                <div class="card-header bg-white py-2"><strong><i class="fas fa-search-dollar text-muted me-1"></i>Dampak Finansial & Root Cause</strong></div>
                <div class="card-body py-2">
                    <div class="row small">
                        <div class="col-md-4 mb-2">
                            <div class="text-muted">Dampak Biaya Overload</div>
                            <div class="h6 text-danger fw-bold" id="repDetailAnomalyCost">Rp 0</div>
                        </div>
                        <div class="col-md-4 mb-2">
                            <div class="text-muted">Estimasi Revenue Loss</div>
                            <div class="h6 text-danger fw-bold" id="repDetailRevenueLoss">Rp 0</div>
                        </div>
                        <div class="col-md-4 mb-2">
                            <div class="text-muted">Revenue Loss Berlangsung</div>
                            <div class="h6 text-warning fw-bold" id="repDetailOngoingRevenueLoss">Rp 0</div>
                        </div>
                    </div>
                    <div class="mt-2" id="repTopRootCauses">
                        <div class="text-muted small">Top Root Cause:</div>
                        <div class="small" id="repTopRootCausesList">-</div>
                    </div>
                </div>
            </div>
            <div class="text-muted small text-end">
                Generated by <span id="repGeneratedBy">-</span> at <span id="repGeneratedAt">-</span>
            </div>
        </div>
        <div id="monthlyReportEmpty" class="text-center text-muted py-4">
            Pilih periode dan klik "Tampilkan" untuk melihat laporan.
        </div>
    </div>
</div>

<!-- Audit Operator (Admin only) -->
@if (userRole == "Admin")
{
    <div class="card shadow-sm mb-3">
        <div class="card-header bg-white py-2">
            <h6 class="mb-0"><i class="fas fa-user-shield text-muted"></i> Audit Tindakan Operator</h6>
        </div>
        <div class="card-body">
            <div class="audit-form-row mb-3">
                <div class="audit-form-field">
                    <label class="form-label small mb-1">Dari Tanggal</label>
                    <input type="date" id="auditFromDate" class="form-control form-control-sm" value="@DateTime.Now.AddDays(-30).ToString("yyyy-MM-dd")">
                </div>
                <div class="audit-form-field">
                    <label class="form-label small mb-1">Sampai Tanggal</label>
                    <input type="date" id="auditToDate" class="form-control form-control-sm" value="@DateTime.Now.ToString("yyyy-MM-dd")">
                </div>
                <div class="audit-form-actions">
                    <button class="btn btn-primary btn-sm" id="btnLoadAudit">
                        <i class="fas fa-search"></i> Muat Audit
                    </button>
                </div>
            </div>
            <div id="operatorActionsGrid" style="width:100%;min-height:300px;"></div>
        </div>
    </div>
    <div class="card shadow-sm mb-3">
        <div class="card-header bg-white py-2">
            <h6 class="mb-0"><i class="fas fa-chart-pie text-muted"></i> Ringkasan Operator</h6>
        </div>
        <div class="card-body">
            <div id="operatorActionsSummaryGrid" style="width:100%;min-height:200px;"></div>
        </div>
    </div>
}

<!-- Detail Modal -->
<div class="modal fade" id="detailModal" tabindex="-1">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header bg-light">
                <h5 class="modal-title"><i class="fas fa-info-circle"></i> Detail Anomali #<span id="detailId"></span></h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span>&times;</span></button>
            </div>
            <div class="modal-body">
                <div class="detail-info-row">
                    <div class="detail-info-col">
                        <div class="card h-100">
                            <div class="card-body">
                                <h6 class="card-title"><i class="fas fa-info-circle text-muted"></i> Informasi Dasar</h6>
                                <table class="table table-sm table-borderless mb-0">
                                    <tbody>
                                        <tr><td class="text-muted">Device</td><td id="detailDevice">-</td></tr>
                                        <tr><td class="text-muted">Lokasi</td><td id="detailLocation">-</td></tr>
                                        <tr><td class="text-muted">Kategori Media</td><td id="detailDeviceCategory">-</td></tr>
                                        <tr><td class="text-muted">Tipe</td><td id="detailType">-</td></tr>
                                        <tr><td class="text-muted">Severity</td><td id="detailSeverity">-</td></tr>
                                        <tr><td class="text-muted">Daya</td><td id="detailPower">-</td></tr>
                                        <tr><td class="text-muted">Threshold</td><td id="detailThreshold">-</td></tr>
                                        <tr><td class="text-muted">Deviasi</td><td id="detailDeviation">-</td></tr>
                                        <tr><td class="text-muted">Durasi</td><td id="detailDuration">-</td></tr>
                                        <tr><td class="text-muted">Response Time</td><td id="detailResponseTime">-</td></tr>
                                        <tr><td class="text-muted">Waktu</td><td id="detailTime">-</td></tr>
                                        <tr><td class="text-muted">Status</td><td id="detailStatus">-</td></tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                    <div class="detail-info-col">
                        <div class="card h-100">
                            <div class="card-body">
                                <h6 class="card-title"><i class="fas fa-brain text-muted"></i> Analisis & Rekomendasi</h6>
                                <p class="mb-1 font-weight-bold small">Root Cause:</p>
                                <p class="small text-muted" id="detailRootCause">-</p>
                                <p class="mb-1 font-weight-bold small">Recommended Action:</p>
                                <p class="small text-muted" id="detailRecommendedAction">-</p>
                                <p class="mb-1 font-weight-bold small">Catatan Operator:</p>
                                <p class="small text-muted" id="detailOperatorNotes">-</p>
                            </div>
                        </div>
                    </div>
                    <div class="detail-info-col">
                        <div class="card h-100 border-danger">
                            <div class="card-body">
                                <h6 class="card-title"><i class="fas fa-coins text-muted"></i> Dampak Finansial</h6>
                                <div id="detailFinancialImpactContainer">
                                    <p class="mb-1 font-weight-bold small">Dampak Biaya (Overload):</p>
                                    <p class="h5 text-danger" id="detailAnomalyCostImpact">Rp 0</p>
                                    <p class="mb-1 font-weight-bold small mt-2">Estimasi Revenue Loss (Drop):</p>
                                    <p class="h5 text-danger" id="detailRevenueLoss">Rp 0</p>
                                    <p class="small text-muted mt-2" id="detailFinancialNote">-</p>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="card">
                            <div class="card-body">
                                <h6 class="card-title"><i class="fas fa-chart-area text-muted"></i> Chart Snapshot</h6>
                                <div id="detailChartSnapshotContainer" style="position:relative;height:350px;width:100%;">
                                    <canvas id="detailChartSnapshot"></canvas>
                                </div>
                                <div class="text-center text-muted small mt-2" id="detailSnapshotStatus"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-sm" data-dismiss="modal">Tutup</button>
            </div>
        </div>
    </div>
</div>

<!-- Resolve Anomaly Modal -->
<div class="modal fade" id="resolveModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title"><i class="fas fa-check-double"></i> Resolve Anomali #<span id="resolveIdDisplay"></span></h5>
                <button type="button" class="close text-white" data-dismiss="modal"><span>&times;</span></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-info small">
                    <i class="fas fa-info-circle"></i> Device: <strong id="resolveDeviceName">-</strong> | Tipe: <strong id="resolveAnomalyType">-</strong>
                </div>
                <input type="hidden" id="resolveAnomalyId">
                <div class="form-group mb-3">
                    <label for="resolveActionSelect" class="form-label small fw-bold">Jenis Tindakan Maintenance <span class="text-danger">*</span></label>
                    <select id="resolveActionSelect" class="form-select form-select-sm">
                        <option value="">-- Pilih tindakan --</option>
                        <option value="Periksa koneksi listrik">Periksa koneksi listrik</option>
                        <option value="Restart device">Restart device</option>
                        <option value="Ganti fuse / MCB">Ganti fuse / MCB</option>
                        <option value="Periksa relay / kontrol">Periksa relay / kontrol</option>
                        <option value="Periksa supply voltage">Periksa supply voltage</option>
                        <option value="Reset circuit breaker">Reset circuit breaker</option>
                        <option value="Periksa kabel grounding">Periksa kabel grounding</option>
                        <option value="Periksa sensor power meter">Periksa sensor power meter</option>
                        <option value="Bersihkan panel / ventilasi">Bersihkan panel / ventilasi</option>
                        <option value="Periksa UPS / backup power">Periksa UPS / backup power</option>
                        <option value="Periksa firmware / software">Periksa firmware / software</option>
                        <option value="Ganti komponen rusak">Ganti komponen rusak</option>
                        <option value="Lainnya">Lainnya</option>
                    </select>
                    <div class="invalid-feedback small">Pilih jenis tindakan terlebih dahulu.</div>
                </div>
                <div class="form-group mb-2">
                    <label for="resolveNotesInput" class="form-label small">Catatan Tindakan (opsional)</label>
                    <textarea id="resolveNotesInput" class="form-control form-control-sm" rows="3" placeholder="Tambahkan keterangan opsional..."></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-sm" data-dismiss="modal">Batal</button>
                <button type="button" class="btn btn-success btn-sm" id="btnConfirmResolve">
                    <i class="fas fa-check-double"></i> Resolve
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title"><i class="fas fa-exclamation-triangle"></i> Confirm Delete</h5>
                <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
            </div>
            <div class="modal-body">
                <p id="deleteMessage">Are you sure you want to delete this log?</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="btnConfirmDelete">
                    <i class="fas fa-trash"></i> Delete
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Clear All Confirmation Modal -->
<div class="modal fade" id="clearAllModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title"><i class="fas fa-exclamation-triangle"></i> Clear All Logs</h5>
                <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-warning">
                    <i class="fas fa-exclamation-circle"></i>
                    <strong>Warning!</strong> This action will permanently delete ALL anomaly logs. This cannot be undone!
                </div>
                <p>Are you sure you want to clear all anomaly logs?</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="btnConfirmClearAll">
                    <i class="fas fa-trash-alt"></i> Clear All
                </button>
            </div>
        </div>
    </div>
</div>

<style>
    /* ============================================
       KPI STAT CARDS — consistent with main theme
       ============================================ */
    .stats-row .stat-card {
        position: relative;
        overflow: hidden;
        border-radius: 0.5rem;
        padding: 0.75rem 1rem;
    }
    .stats-row .stat-card .stat-label {
        font-size: 0.7rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        opacity: 0.9;
    }
    .stats-row .stat-card .stat-value {
        font-size: 1.5rem;
        font-weight: 700;
        line-height: 1.2;
    }
    .stats-row .stat-card .stat-icon {
        position: absolute;
        top: 0.5rem;
        right: 0.75rem;
        font-size: 1.8rem;
        opacity: 0.15;
    }

    /* ============================================
       CHARTS ROW — flexbox, side-by-side
       ============================================ */
    .charts-row {
        display: flex;
        gap: 0.75rem;
    }
    .charts-col {
        display: flex;
        flex-direction: column;
        min-width: 0;
    }
    .charts-col-main {
        flex: 2 1 0%;
    }
    .charts-col-side {
        flex: 1 1 0%;
    }
    .charts-col .card {
        width: 100%;
        border: none;
        box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075) !important;
    }
    .charts-col .card .card-header {
        border-bottom: 1px solid #e9ecef;
    }
    .charts-col .card .card-header h6 {
        font-size: 0.85rem;
        color: #495057;
    }
    .charts-col .card .card-header h6 i {
        color: #6c757d;
    }
    .anomaly-chart-container {
        width: 100%;
        height: 300px;
        min-height: 260px;
    }
    /* DevExtreme chart theming */
    .anomaly-chart-container .dx-chart,
    .anomaly-chart-container .dx-piechart {
        font-family: inherit;
    }
    @@media (max-width: 767.98px) {
        .charts-row {
            flex-direction: column;
        }
        .charts-col-main,
        .charts-col-side {
            flex: 1 1 100%;
        }
    }

    /* ============================================
       REPORT FORM — flex row
       ============================================ */
    .report-form-row {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        align-items: flex-end;
    }
    .report-form-field {
        flex: 0 0 auto;
        min-width: 120px;
    }
    .report-form-actions {
        flex: 1 1 auto;
        display: flex;
        align-items: center;
        gap: 0.25rem;
    }

    /* ============================================
       REPORT STATS — auto-fit grid
       ============================================ */
    .report-stats-row {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 0.5rem;
    }
    @@media (max-width: 576px) {
        .report-stats-row {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    /* ============================================
       AUDIT FORM — flex row
       ============================================ */
    .audit-form-row {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        align-items: flex-end;
    }
    .audit-form-field {
        flex: 0 0 auto;
        min-width: 160px;
    }
    .audit-form-actions {
        flex: 1 1 auto;
        display: flex;
        align-items: center;
    }

    /* ============================================
       DETAIL MODAL — info row
       ============================================ */
    .detail-info-row {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
    }
    .detail-info-col {
        flex: 1 1 0%;
        min-width: 280px;
    }
    @@media (max-width: 576px) {
        .detail-info-col {
            flex: 1 1 100%;
        }
    }
    /* Severity badges */
    .severity-badge {
        font-size: 0.7rem;
        font-weight: 600;
        padding: 0.3em 0.6em;
        border-radius: 0.25rem;
        display: inline-block;
        text-transform: uppercase;
        letter-spacing: 0.3px;
    }
    .severity-critical { background-color: #7f1d1d; color: #fff; }
    .severity-high { background-color: #dc3545; color: #fff; }
    .severity-medium { background-color: #ffc107; color: #212529; }
    .severity-low { background-color: #0d6efd; color: #fff; }

    /* Grid */
    .anomaly-grid-scroll-wrapper {
        width: 100%;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
    }
    #anomalyDataGrid { width: 100% !important; }
    #anomalyDataGrid .dx-datagrid {
        width: 100% !important;
        border: none !important;
    }
    #anomalyDataGrid .dx-datagrid .dx-data-row td {
        text-align: center;
        vertical-align: middle;
        font-size: 12px;
    }
    #anomalyDataGrid .dx-datagrid .dx-header-row td {
        text-align: center;
        font-weight: 600;
        font-size: 0.75rem;
        color: #495057;
    }
    #anomalyDataGrid .dx-datagrid .dx-data-row.dx-row-alt > td {
        background-color: #f8f9fa;
    }

    /* Mobile */
    @@media (max-width: 768px) {
        .anomaly-grid-scroll-wrapper { overflow-x: auto; }
        #anomalyDataGrid .dx-datagrid { min-width: 700px !important; }
        #anomalyDataGrid .dx-datagrid .dx-data-row td,
        #anomalyDataGrid .dx-datagrid .dx-header-row td {
            font-size: 11px;
            padding: 4px 3px !important;
        }
    }
</style>

@section Scripts {
    <script src="~/js/chart.umd.min.js"></script>
    <script>
        var autoRefreshTimer = null;
        var autoRefreshEnabled = true;
        var deleteLogId = null;
        var dataGrid = null;
        var allData = [];
        var currentDetailId = null;
        var currentUserRole = '@userRole';
        var trendChart = null;
        var severityPieChart = null;
        var detailChart = null;

        $(document).ready(function() {
            // Hide page-specific buttons not applicable to this page
            $('#btnRescan, #btnExport').hide();

            // Settings button
            $('#btnSettings').click(function() {
                window.location.href = '/Monitoring/Settings';
            });

            updateLastUpdate();
            setInterval(updateLastUpdate, 60000);

            initDataGrid();
            loadDashboard();
            loadTrends(7);

            $('#btnRefresh').click(function() {
                if (dataGrid) dataGrid.refresh();
                loadDashboard();
                loadTrends(7);
            });

            $('#autoRefreshCheck').change(function() {
                autoRefreshEnabled = $(this).is(':checked');
                if (autoRefreshEnabled) {
                    setupAutoRefresh();
                    $('#statusDot').removeClass('text-danger').addClass('text-success');
                    $('#statusText').text('Online');
                } else {
                    stopAutoRefresh();
                    $('#statusDot').removeClass('text-success').addClass('text-danger');
                    $('#statusText').text('Paused');
                }
            });

            $('#btnClearAll').click(function() { $('#clearAllModal').modal('show'); });
            $('#btnConfirmClearAll').click(function() { clearAllLogs(); });
            $('#btnConfirmDelete').click(function() { if (deleteLogId) deleteSingleLog(deleteLogId); });

            $('[data-days]').click(function() {
                $('[data-days]').removeClass('active');
                $(this).addClass('active');
                loadTrends(parseInt($(this).data('days')));
            });

            $('#btnConfirmResolve').click(function() { submitResolveFromModal(); });

            $('#btnLoadReport').click(function() { loadMonthlyReport(); });
            $('#btnGenerateReport').click(function() { generateMonthlyReport(); });

            $('#btnLoadAudit').click(function() { loadOperatorActions(); });

            setupAutoRefresh();

            $(window).on('resize.anomalyCenter', function() {
                if (trendChart) trendChart.render();
                if (severityPieChart) severityPieChart.render();
                if (detailChart) detailChart.render();
            });
        });

        function setupAutoRefresh() {
            stopAutoRefresh();
            if (autoRefreshEnabled) {
                autoRefreshTimer = setInterval(function() {
                    if (dataGrid) dataGrid.refresh();
                    loadDashboard();
                }, 30000);
            }
        }

        function stopAutoRefresh() {
            if (autoRefreshTimer) {
                clearInterval(autoRefreshTimer);
                autoRefreshTimer = null;
            }
        }

        function formatDateTime(isoStr) {
            if (!isoStr) return '-';
            try {
                var d = new Date(isoStr);
                if (isNaN(d.getTime())) return isoStr;
                var dd = String(d.getDate()).padStart(2, '0');
                var MM = String(d.getMonth() + 1).padStart(2, '0');
                var yyyy = d.getFullYear();
                var hh = String(d.getHours()).padStart(2, '0');
                var mm = String(d.getMinutes()).padStart(2, '0');
                var ss = String(d.getSeconds()).padStart(2, '0');
                return dd + '/' + MM + '/' + yyyy + ' ' + hh + ':' + mm + ':' + ss;
            } catch(e) {
                return isoStr;
            }
        }

        function fmt(value, precision) {
            if (value == null) return '-';
            return value.toLocaleString('id-ID', {
                minimumFractionDigits: precision,
                maximumFractionDigits: precision
            });
        }

        function formatNumber(num) {
            if (num === null || num === undefined || isNaN(num)) return '0';
            return Number(num).toLocaleString('id-ID', { maximumFractionDigits: 0 });
        }

        function severityClass(severity) {
            switch ((severity || '').toLowerCase()) {
                case 'critical': return 'severity-critical';
                case 'high': return 'severity-high';
                case 'medium': return 'severity-medium';
                case 'low': return 'severity-low';
                default: return 'severity-medium';
            }
        }

        // ============================================
        // DASHBOARD
        // ============================================
        function loadDashboard() {
            $.ajax({
                url: '/api/Api/anomaly-dashboard',
                method: 'GET',
                dataType: 'json',
                success: function(response) {
                    if (response.success && response.data) {
                        var d = response.data;
                        $('#dashTotal').text(d.total || 0);
                        $('#dashToday').text(d.today || 0);
                        $('#dashUnresolved').text(d.unresolved || 0);
                        $('#dashCritical').text(d.critical || 0);
                        $('#dashHigh').text(d.high || 0);
                        $('#dashTopDevice').text(d.topDevice || '-').attr('title', d.topDevice || '-');
                        $('#dashAnomalyCost').text('Rp ' + formatNumber(d.totalAnomalyCostImpact || 0));
                        $('#dashRevenueLoss').text('Rp ' + formatNumber(d.totalRevenueLoss || 0));
                        $('#dashOngoingRevenueLoss').text('Rp ' + formatNumber(d.ongoingRevenueLoss || 0));
                        $('#dashFinancialDevices').text(d.financialDeviceCount || 0);
                    }
                },
                error: function() { }
            });
            loadDeviceDistribution();
        }

        function loadDeviceDistribution() {
            $.ajax({
                url: '/api/Api/anomaly-device-distribution',
                method: 'GET',
                dataType: 'json',
                success: function(response) {
                    if (response.success && response.data) {
                        renderDevicePieChart(response.data);
                    }
                },
                error: function() { }
            });
        }

        function renderDevicePieChart(data) {
            var chartData = data.map(function(item) {
                return { arg: item.group, val: item.count };
            });

            if (chartData.length === 0) {
                $('#anomalySeverityPieChart').html('<div class="d-flex align-items-center justify-content-center h-100 text-muted"><i class="fas fa-chart-pie me-2"></i>Tidak ada data</div>');
                return;
            }

            var container = $('#anomalySeverityPieChart');
            if (severityPieChart) {
                severityPieChart.option('dataSource', chartData);
                return;
            }

            severityPieChart = container.dxPieChart({
                dataSource: chartData,
                palette: ['#0d6efd', '#dc3545', '#ffc107', '#198754', '#6f42c1', '#fd7e14', '#20c997', '#e83e8c', '#6c757d', '#17a2b8'],
                legend: {
                    verticalAlignment: 'bottom',
                    horizontalAlignment: 'center',
                    font: { size: 11 }
                },
                tooltip: {
                    enabled: true,
                    percentPrecision: 1,
                    customizeTooltip: function(arg) {
                        return { text: arg.argumentText + ': ' + arg.valueText + ' anomali (' + arg.percentText + ')' };
                    }
                },
                size: { height: 260 },
                adaptiveLayout: { width: 150, height: 150 },
                series: [{
                    type: 'pie',
                    argumentField: 'arg',
                    valueField: 'val',
                    label: {
                        visible: true,
                        format: 'fixedPoint',
                        connector: { visible: true, width: 1 },
                        customizeText: function() { return this.argumentText + ': ' + this.valueText; }
                    }
                }]
            }).dxPieChart('instance');

            setTimeout(function() { if (severityPieChart) severityPieChart.render(); }, 200);
        }

        // ============================================
        // TRENDS
        // ============================================
        function loadTrends(days) {
            $.ajax({
                url: '/api/Api/anomaly-trends',
                method: 'GET',
                data: { days: days },
                dataType: 'json',
                success: function(response) {
                    if (response.success && response.data) {
                        renderTrendChart(response.data);
                    }
                },
                error: function() { }
            });
        }

        function renderTrendChart(data) {
            var chartData = data.map(function(item) {
                return {
                    date: new Date(item.date + 'T00:00:00'),
                    total: item.total,
                    overload: item.overload,
                    drop: item.drop,
                    critical: item.critical
                };
            });

            if (trendChart) {
                trendChart.option('dataSource', chartData);
                return;
            }

            trendChart = $('#anomalyTrendChart').dxChart({
                dataSource: chartData,
                commonSeriesSettings: {
                    argumentField: 'date',
                    type: 'spline',
                    point: { size: 5 }
                },
                series: [
                    { valueField: 'total', name: 'Total', color: '#0d6efd' },
                    { valueField: 'overload', name: 'Overload', color: '#dc3545' },
                    { valueField: 'drop', name: 'Drop', color: '#ffc107' },
                    { valueField: 'critical', name: 'Critical', color: '#7f1d1d' }
                ],
                legend: { verticalAlignment: 'bottom', horizontalAlignment: 'center', itemCount: 4 },
                tooltip: { enabled: true },
                valueAxis: { title: { text: 'Jumlah' }, minValueMargin: 0.1, label: { format: { type: 'fixedPoint', precision: 0 } } },
                argumentAxis: { label: { format: 'dd/MM', rotationAngle: -30 } },
                size: { height: 260 },
                adaptiveLayout: { width: 200, height: 150 }
            }).dxChart('instance');
        }

        // ============================================
        // DATA GRID
        // ============================================
        function initDataGrid() {
            dataGrid = $('#anomalyDataGrid').dxDataGrid({
                dataSource: new DevExpress.data.DataSource({
                    store: new DevExpress.data.CustomStore({
                        key: 'id',
                        load: function(loadOptions) {
                            var d = $.Deferred();
                            var params = { skip: loadOptions.skip || 0, take: loadOptions.take || 10 };
                            if (loadOptions.sort) params.sort = JSON.stringify(loadOptions.sort);

                            $.ajax({
                                url: '/api/Api/anomaly-logs/ALL',
                                method: 'GET',
                                data: params,
                                dataType: 'json',
                                success: function(response) {
                                    var rawData = response.data || [];
                                    var mapped = rawData.map(function(item) {
                                        return {
                                            id: item.id || item.Id || 0,
                                            deviceKey: item.deviceKey || item.DeviceKey || '',
                                            deviceId: item.deviceId || item.DeviceId || '',
                                            groupName: item.groupName || item.GroupName || item.deviceKey || '',
                                            location: item.location || item.Location || '-',
                                            deviceCategory: item.deviceCategory || item.DeviceCategory || 'Unknown',
                                            anomalyType: item.anomalyType || item.AnomalyType || '',
                                            powerValue: item.powerValue || item.PowerValue || 0,
                                            thresholdValue: item.thresholdValue || item.ThresholdValue || 0,
                                            deviation: item.deviation || item.Deviation || 0,
                                            detectedTime: item.detectedTime ? new Date(item.detectedTime) : null,
                                            emaValue: item.emaValue || item.EMAValue,
                                            thresholdMode: item.thresholdMode || item.ThresholdMode || 'manual',
                                            severity: item.severity || item.Severity || 'medium',
                                            rootCause: item.rootCause || item.RootCause || '',
                                            recommendedAction: item.recommendedAction || item.RecommendedAction || '',
                                            acknowledged: item.acknowledged || item.Acknowledged || false,
                                            acknowledgedTime: item.acknowledgedTime || item.AcknowledgedTime,
                                            isResolved: item.isResolved || item.IsResolved || false,
                                            resolvedTime: item.resolvedTime || item.ResolvedTime,
                                            durationMinutes: item.durationMinutes || item.DurationMinutes,
                                            responseTimeMinutes: item.responseTimeMinutes || item.ResponseTimeMinutes,
                                            revenueLoss: item.revenueLoss || item.RevenueLoss || 0,
                                            anomalyCostImpact: item.anomalyCostImpact || item.AnomalyCostImpact || 0,
                                            operatorAction: item.operatorAction || item.OperatorAction || '',
                                            operatorNotes: item.operatorNotes || item.OperatorNotes || '',
                                            notes: item.notes || item.Notes || ''
                                        };
                                    });
                                    allData = mapped;
                                    d.resolve(mapped, { totalCount: response.totalCount || 0 });
                                },
                                error: function(xhr, status, error) {
                                    console.error('Error loading anomaly logs:', error);
                                    d.reject(error);
                                }
                            });
                            return d.promise();
                        },
                        remove: function(key) {
                            var d = $.Deferred();
                            $.ajax({
                                url: '/api/Api/anomaly-logs/' + key,
                                method: 'DELETE',
                                success: function() { d.resolve(); },
                                error: function(xhr) { d.reject(xhr.responseText || 'Delete failed'); }
                            });
                            return d.promise();
                        }
                    }),
                    reshapeOnPush: true
                }),
                remoteOperations: { sorting: true, paging: true, filtering: true },
                paging: { pageSize: 10 },
                pager: {
                    showPageSizeSelector: true,
                    allowedPageSizes: [10, 25, 50, 100],
                    showInfo: true,
                    showNavigationButtons: true,
                    visible: true
                },
                scrolling: { mode: 'standard', showScrollbar: 'always', useNative: true },
                searchPanel: { visible: true, width: 180, placeholder: 'Cari anomali...' },
                columnChooser: { enabled: true, mode: 'select' },
                columnFixing: { enabled: true },
                grouping: { autoExpandAll: false },
                groupPanel: { visible: false },
                headerFilter: { visible: true },
                filterRow: { visible: true },
                sorting: { mode: 'single' },
                selection: { mode: 'none' },
                stateStoring: { enabled: false },
                rowAlternationEnabled: true,
                showBorders: true,
                showColumnLines: true,
                showRowLines: false,
                allowColumnResizing: true,
                allowColumnReordering: true,
                columnAutoWidth: true,
                loadPanel: { enabled: true, text: 'Memuat data...' },
                noDataText: 'Tidak ada data anomali',
                onToolbarPreparing: function(e) {
                    var items = e.toolbarOptions.items;
                    items.push({
                        location: 'after', widget: 'dxButton',
                        options: { text: 'Columns', hint: 'Show/Hide Columns', onClick: function() { dataGrid.showColumnChooser(); } }
                    });
                    items.push({
                        location: 'after', widget: 'dxButton',
                        options: { text: 'Clear', hint: 'Clear all filters', onClick: function() { dataGrid.clearFilter(); dataGrid.refresh(); } }
                    });
                },
                onCellPrepared: function(e) {
                    if (e.rowType !== 'data') return;
                    if (e.column.dataField === 'powerValue' && e.value > 20000) e.cellElement.css('background-color', 'rgba(220,53,69,0.10)');
                    else if (e.column.dataField === 'powerValue' && e.value > 10000) e.cellElement.css('background-color', 'rgba(255,193,7,0.1)');
                },
                onRowPrepared: function(e) {
                    if (e.rowType !== 'data') return;
                    var t = e.data.anomalyType;
                    if (t === 'OVERLOAD') e.rowElement.css('border-left', '3px solid #dc3545');
                    else if (t === 'DROP' || t === 'DEVICE_DROP' || t === 'DEVICE DROP') e.rowElement.css('border-left', '3px solid #ffc107');
                    else e.rowElement.css('border-left', '3px solid #0d6efd');
                },
                columns: [
                    {
                        caption: 'Action', width: 180, alignment: 'center',
                        allowFiltering: false, allowSorting: false, allowGrouping: false, allowHeaderFiltering: false,
                        cellTemplate: function(container, options) {
                            var data = options.data;
                            var buttons = $('<div class="d-flex justify-content-center gap-1">');
                            $('<button>').addClass('btn btn-sm btn-info').attr('title', 'View detail').html('<i class="fas fa-eye"></i>')
                                .on('click', function(e) { e.stopPropagation(); openDetailModal(data.id); }).appendTo(buttons);
                            if (currentUserRole === 'Operator' || currentUserRole === 'Admin') {
                                var canAcknowledge = !data.acknowledged && !data.isResolved;
                                var canResolve = !data.isResolved;
                                $('<button>').addClass('btn btn-sm btn-warning' + (canAcknowledge ? '' : ' disabled')).attr('title', canAcknowledge ? 'Acknowledge' : 'Already acknowledged / resolved').prop('disabled', !canAcknowledge).html('<i class="fas fa-check"></i>')
                                    .on('click', function(e) { if (!canAcknowledge) return; e.stopPropagation(); acknowledgeAnomaly(data.id); }).appendTo(buttons);
                                $('<button>').addClass('btn btn-sm btn-success' + (canResolve ? '' : ' disabled')).attr('title', canResolve ? 'Resolve' : 'Already resolved').prop('disabled', !canResolve).html('<i class="fas fa-check-double"></i>')
                                    .on('click', function(e) { if (!canResolve) return; e.stopPropagation(); openResolveModal(data.id, data.groupName || data.deviceKey, data.anomalyType); }).appendTo(buttons);
                            }
                            if (currentUserRole === 'Admin') {
                                $('<button>').addClass('btn btn-sm btn-outline-danger').attr('title', 'Delete log').html('<i class="fas fa-trash"></i>')
                                    .on('click', function(e) { e.stopPropagation(); confirmDelete(data.id, data.groupName || data.deviceKey, data.anomalyType); }).appendTo(buttons);
                            }
                            buttons.appendTo(container);
                        }
                    },
                    { dataField: 'id', caption: '#', width: 50, alignment: 'center', allowGrouping: false, allowFiltering: false, allowHeaderFiltering: false },
                    {
                        dataField: 'detectedTime', caption: 'Time', dataType: 'datetime', sortOrder: 'desc', alignment: 'center',
                        allowHeaderFiltering: false, filterOperations: ['between', '>=', '<=', '>', '<', '='], selectedFilterOperation: 'between',
                        format: { type: 'dd/MM/yyyy HH:mm:ss' },
                        cellTemplate: function(container, options) {
                            var val = options.value;
                            var text = '-';
                            if (val) {
                                if (val instanceof Date && !isNaN(val.getTime())) {
                                    var dd = String(val.getDate()).padStart(2, '0');
                                    var MM = String(val.getMonth() + 1).padStart(2, '0');
                                    var yyyy = val.getFullYear();
                                    var hh = String(val.getHours()).padStart(2, '0');
                                    var mm = String(val.getMinutes()).padStart(2, '0');
                                    var ss = String(val.getSeconds()).padStart(2, '0');
                                    text = dd + '/' + MM + '/' + yyyy + ' ' + hh + ':' + mm + ':' + ss;
                                } else {
                                    text = formatDateTime(val);
                                }
                            }
                            $('<span>').text(text).appendTo(container);
                        }
                    },
                    { dataField: 'groupName', caption: 'Device', alignment: 'center', headerFilter: { allowSelectAll: true } },
                    { dataField: 'deviceCategory', caption: 'Kategori Media', alignment: 'center', headerFilter: { allowSelectAll: true } },
                    { dataField: 'location', caption: 'Lokasi', alignment: 'center', visible: false },
                    {
                        dataField: 'anomalyType', caption: 'Type', alignment: 'center',
                        headerFilter: { dataSource: [{ text: 'OVERLOAD', value: 'OVERLOAD' }, { text: 'DEVICE DROP', value: 'DROP' }, { text: 'DEVICE DROP', value: 'DEVICE_DROP' }] },
                        cellTemplate: function(container, options) {
                            var v = options.value;
                            var cls, icon, text;
                            if (v === 'OVERLOAD') { cls = 'bg-danger'; icon = 'fa-bolt'; text = 'OVERLOAD'; }
                            else if (v === 'DROP' || v === 'DEVICE_DROP' || v === 'DEVICE DROP') { cls = 'bg-warning text-dark'; icon = 'fa-arrow-down'; text = 'DEVICE DROP'; }
                            else { cls = 'bg-info'; icon = 'fa-question'; text = v; }
                            $('<span>').addClass('badge ' + cls).html('<i class="fas ' + icon + '"></i> ' + text).appendTo(container);
                        }
                    },
                    {
                        dataField: 'severity', caption: 'Severity', alignment: 'center',
                        headerFilter: { dataSource: [{ text: 'Critical', value: 'critical' }, { text: 'High', value: 'high' }, { text: 'Medium', value: 'medium' }, { text: 'Low', value: 'low' }] },
                        cellTemplate: function(container, options) {
                            var v = options.value || 'medium';
                            $('<span>').addClass('severity-badge ' + severityClass(v)).text(v).appendTo(container);
                        }
                    },
                    {
                        dataField: 'powerValue', caption: 'Power (W)', dataType: 'number', alignment: 'center',
                        cellTemplate: function(container, options) {
                            var v = options.value;
                            var cls = v > 20000 ? 'text-danger' : v > 10000 ? 'text-warning' : 'text-dark';
                            $('<span>').addClass('anomaly-power ' + cls).text(formatNumber(v) + ' W').appendTo(container);
                        }
                    },
                    { dataField: 'thresholdValue', caption: 'Threshold (W)', dataType: 'number', alignment: 'center', format: { type: 'fixedPoint', precision: 0 } },
                    {
                        dataField: 'deviation', caption: 'Deviation', dataType: 'number', alignment: 'center',
                        cellTemplate: function(container, options) {
                            var v = options.value;
                            var cls = v > 100 ? 'text-danger' : v > 50 ? 'text-warning' : 'text-success';
                            $('<span>').addClass('anomaly-deviation ' + cls).text(fmt(v, 1) + '%').appendTo(container);
                        }
                    },
                    {
                        dataField: 'thresholdMode', caption: 'Mode', alignment: 'center',
                        headerFilter: { dataSource: [{ text: 'MANUAL', value: 'manual' }, { text: 'EMA', value: 'ema' }] },
                        cellTemplate: function(container, options) { $('<span>').addClass('badge bg-info').text(options.value.toUpperCase()).appendTo(container); }
                    },
                    {
                        dataField: 'durationMinutes', caption: 'Durasi', dataType: 'number', alignment: 'center',
                        cellTemplate: function(container, options) {
                            var v = options.value;
                            if (v == null || v === undefined) { $('<span>').addClass('text-muted small fst-italic').text('ongoing').appendTo(container); return; }
                            var h = Math.floor(v / 60);
                            var m = Math.floor(v % 60);
                            var text = h > 0 ? h + 'j ' + m + 'm' : m + 'm';
                            $('<span>').text(text).appendTo(container);
                        }
                    },
                    {
                        dataField: 'responseTimeMinutes', caption: 'Response', dataType: 'number', alignment: 'center',
                        cellTemplate: function(container, options) {
                            var v = options.value;
                            if (v == null || v === undefined) { $('<span>').text('-').appendTo(container); return; }
                            var h = Math.floor(v / 60);
                            var m = Math.floor(v % 60);
                            var cls = v <= 60 ? 'text-success' : v <= 240 ? 'text-warning' : 'text-danger';
                            var text = h > 0 ? h + 'j ' + m + 'm' : m + 'm';
                            $('<span>').addClass(cls).text(text).appendTo(container);
                        }
                    },
                    {
                        dataField: 'anomalyCostImpact', caption: 'Dampak Biaya', dataType: 'number', alignment: 'center',
                        cellTemplate: function(container, options) {
                            var v = options.value || 0;
                            var data = options.row.data;
                            if (data.anomalyType !== 'OVERLOAD' || v <= 0) { $('<span>').text('-').appendTo(container); return; }
                            $('<span>').addClass('text-danger fw-bold').text('Rp ' + formatNumber(v)).appendTo(container);
                        }
                    },
                    {
                        dataField: 'revenueLoss', caption: 'Revenue Loss', dataType: 'number', alignment: 'center',
                        cellTemplate: function(container, options) {
                            var v = options.value || 0;
                            var data = options.row.data;
                            var isResolved = data.isResolved;
                            if (data.anomalyType !== 'DROP' && data.anomalyType !== 'DEVICE_DROP') { $('<span>').text('-').appendTo(container); return; }
                            var cls = 'text-danger fw-bold';
                            if (!isResolved) cls += ' fst-italic';
                            $('<span>').addClass(cls).text('Rp ' + formatNumber(v) + (!isResolved ? ' *' : '')).appendTo(container);
                        }
                    },
                    {
                        dataField: 'isResolved', caption: 'Status', dataType: 'boolean', alignment: 'center',
                        headerFilter: { dataSource: [{ text: 'New', value: false }, { text: 'Resolved', value: true }] },
                        cellTemplate: function(container, options) {
                            var data = options.row.data;
                            if (data.isResolved) $('<span>').addClass('badge bg-success').html('<i class="fas fa-check-double"></i> Resolved').appendTo(container);
                            else if (data.acknowledged) $('<span>').addClass('badge bg-info').html('<i class="fas fa-check"></i> Acknowledged').appendTo(container);
                            else $('<span>').addClass('badge bg-secondary').html('<i class="fas fa-circle"></i> New').appendTo(container);
                        }
                    },
                ]
            }).dxDataGrid('instance');
        }

        // ============================================
        // DETAIL MODAL
        // ============================================
        var pendingChartSnapshot = null;

        function openDetailModal(id) {
            currentDetailId = id;
            $.ajax({
                url: '/api/Api/anomaly-logs/detail/' + id,
                method: 'GET',
                dataType: 'json',
                success: function(response) {
                    if (response.success && response.data) {
                        renderDetailModal(response.data);
                        // Defer chart rendering until modal is visible (DevExtreme needs container dimensions)
                        pendingChartSnapshot = response.data.chartSnapshot;
                        $('#detailModal').modal('show');
                    } else {
                        showNotification('Gagal memuat detail anomali', 'danger');
                    }
                },
                error: function() { showNotification('Gagal memuat detail anomali', 'danger'); }
            });
        }

        // Render chart AFTER modal is shown so Chart.js can measure the container
        $('#detailModal').on('shown.bs.modal', function() {
            if (pendingChartSnapshot !== null) {
                renderDetailChart(pendingChartSnapshot);
                pendingChartSnapshot = null;
            }
            // Force chart resize after modal animation completes
            setTimeout(function() {
                if (detailChart) detailChart.resize();
            }, 150);
        });

        // Clean up chart when modal is hidden — replace container DOM to fully reset Chart.js state
        $('#detailModal').on('hidden.bs.modal', function() {
            if (detailChart) {
                try { detailChart.destroy(); } catch(e) {}
                detailChart = null;
            }
            // Replace container element entirely to avoid stale Chart.js canvas state
            $('#detailChartSnapshotContainer').replaceWith('<div id="detailChartSnapshotContainer" style="position:relative;height:350px;width:100%;"><canvas id="detailChartSnapshot"></canvas></div>');
            pendingChartSnapshot = null;
        });

        function renderDetailModal(data) {
            data = data || {};
            $('#detailId').text(data.id || '-');
            $('#detailDevice').text((data.groupName || data.deviceKey || '-') + (data.deviceId ? ' (' + data.deviceId + ')' : ''));
            $('#detailLocation').text(data.location || '-');
            $('#detailDeviceCategory').text(data.deviceCategory || 'Unknown');
            $('#detailType').html(renderTypeBadge(data.anomalyType));
            $('#detailSeverity').html('<span class="severity-badge ' + severityClass(data.severity) + '">' + (data.severity || 'medium') + '</span>');
            $('#detailPower').text(formatNumber(data.powerValue) + ' W');
            $('#detailThreshold').text(formatNumber(data.thresholdValue) + ' W');
            $('#detailDeviation').text(fmt(data.deviation, 1) + '%');
            $('#detailTime').text(formatDateTime(data.detectedTime) || '-');

            var dur = data.durationMinutes;
            if (dur == null || dur === undefined)
                $('#detailDuration').html('<span class="text-muted fst-italic">ongoing</span>');
            else {
                var h = Math.floor(dur / 60);
                var m = Math.floor(dur % 60);
                $('#detailDuration').text(h > 0 ? h + 'j ' + m + 'm' : m + 'm');
            }

            var resp = data.responseTimeMinutes;
            if (resp == null || resp === undefined)
                $('#detailResponseTime').text('-');
            else {
                var rh = Math.floor(resp / 60);
                var rm = Math.floor(resp % 60);
                $('#detailResponseTime').text(rh > 0 ? rh + 'j ' + rm + 'm' : rm + 'm');
            }

            var statusHtml;
            if (data.isResolved) statusHtml = '<span class="badge bg-success">Resolved</span>';
            else if (data.acknowledged) statusHtml = '<span class="badge bg-info">Acknowledged</span>';
            else statusHtml = '<span class="badge bg-secondary">New</span>';
            $('#detailStatus').html(statusHtml);

            $('#detailRootCause').text(data.rootCause || '-');
            $('#detailRecommendedAction').text(data.recommendedAction || '-');
            $('#detailOperatorNotes').text(data.operatorNotes || '-');

            // Financial impact
            var isDrop = data.anomalyType === 'DROP' || data.anomalyType === 'DEVICE_DROP';
            var isOverload = data.anomalyType === 'OVERLOAD';
            var cost = data.anomalyCostImpact || 0;
            var revenue = data.revenueLoss || 0;

            if (isOverload && cost > 0) {
                $('#detailAnomalyCostImpact').text('Rp ' + formatNumber(cost)).addClass('text-danger');
                $('#detailRevenueLoss').text('-').removeClass('text-danger');
                $('#detailFinancialNote').text('Dampak biaya energi berlebih akibat overload, dihitung dari selisih daya × 0,25 jam × tarif.');
            } else if (isDrop) {
                $('#detailAnomalyCostImpact').text('-').removeClass('text-danger');
                $('#detailRevenueLoss').text('Rp ' + formatNumber(revenue) + (data.isResolved ? '' : ' *')).addClass('text-danger');
                var note = 'Estimasi revenue loss selama device down.';
                if (!data.isResolved) note += ' Perhitungan masih berlangsung hingga anomaly di-resolve.';
                if (revenue === 0) note = 'Revenue per jam belum dikonfigurasi untuk device ini.';
                $('#detailFinancialNote').text(note);
            } else {
                $('#detailAnomalyCostImpact').text('-').removeClass('text-danger');
                $('#detailRevenueLoss').text('-').removeClass('text-danger');
                $('#detailFinancialNote').text('Tidak ada dampak finansial yang dapat diestimasi untuk tipe anomaly ini.');
            }

            // Chart rendering deferred to 'shown.bs.modal' event — see openDetailModal()
        }

        function renderTypeBadge(type) {
            var cls, icon, text;
            if (type === 'OVERLOAD') { cls = 'bg-danger'; icon = 'fa-bolt'; text = 'OVERLOAD'; }
            else if (type === 'DROP' || type === 'DEVICE_DROP' || type === 'DEVICE DROP') { cls = 'bg-warning text-dark'; icon = 'fa-arrow-down'; text = 'DEVICE DROP'; }
            else { cls = 'bg-info'; icon = 'fa-question'; text = type; }
            return '<span class="badge ' + cls + '"><i class="fas ' + icon + '"></i> ' + text + '</span>';
        }

        function renderDetailChart(snapshot) {
            if (!snapshot || (!snapshot.beforeDataJson && !snapshot.afterDataJson)) {
                // Replace container with placeholder message
                $('#detailChartSnapshotContainer').replaceWith('<div id="detailChartSnapshotContainer" class="text-center text-muted py-5" style="height:350px;display:flex;align-items:center;justify-content:center;">Tidak ada chart snapshot</div>');
                $('#detailSnapshotStatus').text('');
                return;
            }

            var beforeData = [], afterData = [];
            try {
                beforeData = JSON.parse(snapshot.beforeDataJson || '[]') || [];
                afterData = JSON.parse(snapshot.afterDataJson || '[]') || [];
            } catch (e) {
                $('#detailChartSnapshotContainer').replaceWith('<div id="detailChartSnapshotContainer" class="text-center text-muted py-5" style="height:350px;display:flex;align-items:center;justify-content:center;">Gagal memuat chart snapshot</div>');
                return;
            }

            // Ensure container has a canvas element (may have been replaced with a placeholder)
            if (!$('#detailChartSnapshot').length || $('#detailChartSnapshot').is('div')) {
                $('#detailChartSnapshotContainer').replaceWith('<div id="detailChartSnapshotContainer" style="position:relative;height:350px;width:100%;"><canvas id="detailChartSnapshot"></canvas></div>');
            }

            // Build labels and data arrays for Chart.js
            var labels = [];
            var powerArr = [], upperArr = [], lowerArr = [], emaArr = [];

            function fmtTime(ts) {
                if (!ts) return null;
                var d = new Date(ts);
                if (isNaN(d.getTime())) return null;
                var hh = String(d.getHours()).padStart(2, '0');
                var mm = String(d.getMinutes()).padStart(2, '0');
                var ss = String(d.getSeconds()).padStart(2, '0');
                return hh + ':' + mm + ':' + ss;
            }

            var allData = beforeData.concat(afterData);
            var hasValidTime = false;
            allData.forEach(function(p, i) {
                var ts = p.Timestamp || p.timestamp;
                var label = fmtTime(ts);
                if (label) hasValidTime = true;
                if (!label) label = '#' + (i + 1);
                labels.push(label);
                powerArr.push(p.Power || p.power || 0);
                upperArr.push(p.Upper || p.upper || null);
                lowerArr.push(p.Lower || p.lower || null);
                emaArr.push(p.EMA || p.ema || null);
            });

            // Anomaly marker index: boundary between before/after
            var anomalyIdx = beforeData.length > 0 ? beforeData.length - 1 : -1;

            var statusLabel;
            if (snapshot.snapshotStatus === 'complete') statusLabel = 'Lengkap';
            else if (snapshot.snapshotStatus === 'partial') statusLabel = 'Sebagian (masih mengumpulkan data setelah anomali)';
            else statusLabel = 'Belum ada data setelah anomali';
            $('#detailSnapshotStatus').text('Status: ' + statusLabel + ' | Data sebelum: ' + beforeData.length + ' | Data sesudah: ' + afterData.length);

            // Build Chart.js datasets — same style as All Charts page
            var datasets = [{
                label: 'Power (W)',
                data: powerArr,
                borderColor: '#00cc66',
                backgroundColor: 'rgba(0,204,102,0.15)',
                fill: true,
                tension: 0.3,
                borderWidth: 2,
                pointRadius: 0,
                pointHoverRadius: 5,
                order: 3
            }];

            if (upperArr.some(function(v) { return v != null; })) {
                datasets.push({
                    label: 'Upper Threshold',
                    data: upperArr,
                    borderColor: '#ff0000',
                    backgroundColor: 'rgba(255,0,0,0.05)',
                    fill: '+1',
                    tension: 0,
                    borderWidth: 2,
                    borderDash: [10, 5],
                    pointRadius: 0,
                    pointHoverRadius: 0,
                    order: 1
                });
            }

            if (lowerArr.some(function(v) { return v != null; })) {
                datasets.push({
                    label: 'Lower Threshold',
                    data: lowerArr,
                    borderColor: '#ff9900',
                    backgroundColor: 'transparent',
                    fill: false,
                    tension: 0,
                    borderWidth: 2,
                    borderDash: [10, 5],
                    pointRadius: 0,
                    pointHoverRadius: 0,
                    order: 1
                });
            }

            if (emaArr.some(function(v) { return v != null; })) {
                datasets.push({
                    label: 'EMA',
                    data: emaArr,
                    borderColor: '#ff6600',
                    backgroundColor: 'transparent',
                    fill: false,
                    tension: 0.3,
                    borderWidth: 2,
                    borderDash: [5, 5],
                    pointRadius: 0,
                    pointHoverRadius: 4,
                    order: 2
                });
            }

            // Chart.js annotation plugin for anomaly marker — use a custom plugin instead
            var anomalyMarkerPlugin = {
                id: 'anomalyMarker',
                afterDraw: function(chart) {
                    if (anomalyIdx < 0 || anomalyIdx >= labels.length) return;
                    var meta = chart.getDatasetMeta(0);
                    if (!meta || !meta.data || !meta.data[anomalyIdx]) return;
                    var x = meta.data[anomalyIdx].x;
                    var yAxis = chart.scales.y;
                    var ctx = chart.ctx;
                    ctx.save();
                    ctx.beginPath();
                    ctx.setLineDash([6, 3]);
                    ctx.strokeStyle = '#dc3545';
                    ctx.lineWidth = 2;
                    ctx.moveTo(x, yAxis.top);
                    ctx.lineTo(x, yAxis.bottom);
                    ctx.stroke();
                    // Label
                    ctx.setLineDash([]);
                    ctx.fillStyle = '#dc3545';
                    ctx.font = 'bold 11px sans-serif';
                    ctx.textAlign = 'center';
                    ctx.fillText('⚡ Anomali', x, yAxis.top - 6);
                    ctx.restore();
                }
            };

            var ctx = document.getElementById('detailChartSnapshot');
            detailChart = new Chart(ctx, {
                type: 'line',
                data: { labels: labels, datasets: datasets },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    interaction: { mode: 'index', intersect: false },
                    scales: {
                        x: {
                            ticks: { font: { size: 9 }, maxRotation: 45, color: (typeof window.getChartTickColor === 'function' ? window.getChartTickColor() : '#666') },
                            grid: { color: (typeof window.getChartGridColor === 'function' ? window.getChartGridColor() : '#e0e0e0'), drawBorder: false },
                            title: { display: true, text: hasValidTime ? 'Waktu' : 'Data Point' }
                        },
                        y: {
                            beginAtZero: false,
                            ticks: {
                                font: { size: 9 },
                                color: (typeof window.getChartTickColor === 'function' ? window.getChartTickColor() : '#666'),
                                callback: function(v) { return v.toLocaleString('id-ID') + 'W'; }
                            },
                            grid: { color: (typeof window.getChartGridColor === 'function' ? window.getChartGridColor() : '#e0e0e0'), drawBorder: false },
                            title: { display: true, text: 'Power (W)' }
                        }
                    },
                    plugins: {
                        legend: { display: true, position: 'bottom', labels: { boxWidth: 12, font: { size: 11 } } },
                        title: { display: false },
                        tooltip: {
                            enabled: true,
                            backgroundColor: 'rgba(0,0,0,0.8)',
                            titleColor: '#fff',
                            bodyColor: '#fff',
                            borderColor: '#444',
                            borderWidth: 1,
                            padding: 10,
                            displayColors: true,
                            callbacks: {
                                title: function(ctx) { return 'Waktu: ' + ctx[0].label; },
                                label: function(ctx) {
                                    var lbl = ctx.dataset.label || '';
                                    var val = ctx.parsed.y;
                                    if (lbl) lbl += ': ';
                                    return lbl + val.toLocaleString('id-ID', { maximumFractionDigits: 0 }) + ' W';
                                }
                            }
                        }
                    },
                    layout: { padding: { top: 20 } }
                },
                plugins: [anomalyMarkerPlugin]
            });
        }

        function updateAnomalyMarker(anomalyTime, argField) {
            // No longer needed — Chart.js plugin handles anomaly marker inline
        }

        // ============================================
        // OPERATOR ACTIONS
        // ============================================
        function openResolveModal(id, deviceName, anomalyType) {
            $('#resolveAnomalyId').val(id);
            $('#resolveIdDisplay').text(id);
            $('#resolveDeviceName').text(deviceName || '-');
            $('#resolveAnomalyType').text(anomalyType || '-');
            $('#resolveActionSelect').val('').removeClass('is-invalid');
            $('#resolveNotesInput').val('');
            $('#resolveModal').modal('show');
        }

        function submitResolveFromModal() {
            var id = $('#resolveAnomalyId').val();
            var action = $('#resolveActionSelect').val();
            var notes = $('#resolveNotesInput').val();

            if (!action) {
                $('#resolveActionSelect').addClass('is-invalid').focus();
                return;
            }
            $('#resolveActionSelect').removeClass('is-invalid');

            $('#btnConfirmResolve').prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Menyimpan...');
            $.ajax({
                url: '/api/Api/anomaly-logs/' + id + '/resolve',
                method: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({ action: action, notes: notes }),
                dataType: 'json',
                success: function(response) {
                    $('#btnConfirmResolve').prop('disabled', false).html('<i class="fas fa-check-double"></i> Resolve');
                    if (response.success) {
                        showNotification('Anomali ditandai resolved', 'success');
                        $('#resolveModal').modal('hide');
                        if (dataGrid) dataGrid.refresh();
                        loadDashboard();
                    } else {
                        showNotification(response.error || 'Gagal resolve', 'danger');
                    }
                },
                error: function(xhr) {
                    $('#btnConfirmResolve').prop('disabled', false).html('<i class="fas fa-check-double"></i> Resolve');
                    showNotification('Gagal resolve: ' + (xhr.responseJSON ? xhr.responseJSON.error : 'Unknown error'), 'danger');
                }
            });
        }

        $('#resolveModal').on('shown.bs.modal', function() { $('#resolveActionSelect').focus(); });
        $('#resolveModal').on('hidden.bs.modal', function() {
            $('#btnConfirmResolve').prop('disabled', false).html('<i class="fas fa-check-double"></i> Resolve');
            $('#resolveActionSelect').removeClass('is-invalid');
        });

        function acknowledgeAnomaly(id) {
            if (!id) return;
            $.ajax({
                url: '/api/Api/anomaly-logs/' + id + '/acknowledge',
                method: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({}),
                dataType: 'json',
                success: function(response) {
                    if (response.success) {
                        showNotification('Anomali di-acknowledge', 'success');
                        if (dataGrid) dataGrid.refresh();
                        loadDashboard();
                    } else {
                        showNotification(response.error || 'Gagal acknowledge', 'danger');
                    }
                },
                error: function(xhr) { showNotification('Gagal acknowledge: ' + (xhr.responseJSON ? xhr.responseJSON.error : 'Unknown error'), 'danger'); }
            });
        }

