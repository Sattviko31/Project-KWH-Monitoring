            $('#repOverload').text(data.overloadCount || 0);
            $('#repDrop').text(data.dropCount || 0);
            $('#repAffected').text(data.affectedDevices || 0);
            $('#repAnomalyCost').text('Rp ' + formatNumber(data.totalAnomalyCostImpact || 0));
            $('#repRevenueLoss').text('Rp ' + formatNumber(data.totalRevenueLoss || 0));
            $('#repOngoingRevenueLoss').text('Rp ' + formatNumber(data.ongoingRevenueLoss || 0));
            $('#repDetailAnomalyCost').text('Rp ' + formatNumber(data.totalAnomalyCostImpact || 0));
            $('#repDetailRevenueLoss').text('Rp ' + formatNumber(data.totalRevenueLoss || 0));
            $('#repDetailOngoingRevenueLoss').text('Rp ' + formatNumber(data.ongoingRevenueLoss || 0));
            $('#repSummary').text(data.summaryText || '-');
            $('#repRecommendations').html((data.recommendations || '-').replace(/\n/g, '<br>'));
            $('#repGeneratedBy').text(data.generatedBy || '-');
            $('#repGeneratedAt').text(data.generatedAt ? formatDateTime(data.generatedAt) : '-');

