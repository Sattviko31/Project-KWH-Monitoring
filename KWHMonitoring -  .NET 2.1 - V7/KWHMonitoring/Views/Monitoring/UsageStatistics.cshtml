            html += '<div class="fin-metric-value">' + formatDecimal(projKwh) + ' kWh</div>';
            html += '<div class="fin-metric-sub">Rp ' + formatInteger(projCost) + ' · Sisa ' + (bp.daysRemaining || 0) + ' hari</div></div>';

            // Budget
            html += '<div class="fin-metric"><div class="fin-metric-label"><i class="fas fa-wallet text-success"></i> Anggaran</div>';
            if (budget.configured) {
                var budgetPct = budgetKwh > 0 ? Math.round(monthKwh / budgetKwh * 100) : 0;
                var bCls = budgetPct > 100 ? 'text-danger' : (budgetPct > 80 ? 'text-warning' : 'text-success');
                html += '<div class="fin-metric-value ' + bCls + '">' + budgetPct + '%</div>';
                html += '<div class="fin-metric-sub">Anggaran ' + formatDecimal(budgetKwh) + ' kWh · Selisih ' + formatDecimal(budget.variance || 0) + '</div></div>';
            } else {
                html += '<div class="fin-metric-value text-muted">—</div>';
                html += '<div class="fin-metric-sub">Belum dikonfigurasi</div></div>';
