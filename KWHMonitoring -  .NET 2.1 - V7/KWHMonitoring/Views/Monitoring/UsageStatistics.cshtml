                        centerText: {
                            line1: formatDecimal(total) + ' kWh',
                            line2: 'WBP ' + wbpPct + '% / LWBP ' + lwbpPct + '%',
                            line3: 'Rp ' + formatInteger(totalCost),
                            color1: '#333', color2: '#888', color3: '#aaa'
                        },
                        tooltip: {
                            callbacks: {
                                label: function(ctx) {
                                    var cost = ctx.dataIndex === 0 ? wbpCost : (ctx.dataIndex === 1 ? lwbpCost : (ti.flatCost || 0));
                                    return ctx.label + ': ' + formatDecimal(ctx.parsed) + ' kWh (Rp ' + formatInteger(cost) + ')';
                                }
                            }
                        }
                    }
                }
            });

            var footerHtml = '<div><span style="color:rgba(91,94,166,0.9)">WBP:</span> ' + formatDecimal(wbpKwh) + ' kWh = Rp ' + formatInteger(wbpCost) + '</div>' +
                '<div><span style="color:rgba(25,135,84,0.9)">LWBP:</span> ' + formatDecimal(lwbpKwh) + ' kWh = Rp ' + formatInteger(lwbpCost) + '</div>';
            if (hasFlat && ti.flatKWh > 0) {
                footerHtml += '<div><span style="color:rgba(108,117,125,0.9)">Flat:</span> ' + formatDecimal(ti.flatKWh) + ' kWh = Rp ' + formatInteger(ti.flatCost || 0) + '</div>';
            }
            footerHtml += '<div class="mt-1" style="border-top:1px solid rgba(128,128,128,0.2);padding-top:2px">Tarif: WBP Rp ' + formatInteger(wbpTariff) + '/kWh · LWBP Rp ' + formatInteger(lwbpTariff) + '/kWh';
            if (wbpLwbp.wbpStart !== undefined) footerHtml += ' · Jam ' + wbpLwbp.wbpStart + ':00-' + wbpLwbp.wbpEnd + ':00';
            if (ti.totalDeviceCount > 0) footerHtml += ' · ' + (ti.wbpDeviceCount || 0) + ' WBP/LWBP, ' + (ti.flatDeviceCount || 0) + ' Flat';
            footerHtml += '</div>';
            $footer.show().html(footerHtml);
