            var monthPeakDay = (ed && ed.peakDay) || 0;
            var monthPeakDayDate = (ed && ed.peakDayDate) || '-';
            var tariff = (fd && fd.avgTariffPerKWh) || (ed && ed.tariffPerKWh) || 1500;
