            if (pc.yoyChangePercent !== undefined && pc.lastYearSameMonthKWh > 0) {
                var yoyArr = pc.yoyChangePercent > 0 ? '▲' : '▼';
                var yoyCls = pc.yoyChangePercent > 20 ? 'text-danger' : (pc.yoyChangePercent < -20 ? 'text-success' : '');
                html += '<div class="fin-metric-value ' + yoyCls + '">' + yoyArr + ' ' + Math.abs(pc.yoyChangePercent).toFixed(1) + '%</div>';
                html += '<div class="fin-metric-sub">dibandingkan dengan bulan yang sama pada tahun sebelumnya</div></div>';
            } else {
                html += '<div class="fin-metric-value text-muted">—</div>';
                html += '<div class="fin-metric-sub">Data tahun lalu belum tersedia</div></div>';
            }

            // Budget Tahunan
            html += '<div class="fin-metric"><div class="fin-metric-label"><i class="fas fa-wallet text-success"></i> Anggaran Tahunan</div>';
            if (yearlyBudget > 0) {
                var yBudgetPct = Math.round(yearKwh / yearlyBudget * 100);
                var ybCls = yBudgetPct > 100 ? 'text-danger' : (yBudgetPct > 80 ? 'text-warning' : 'text-success');
                html += '<div class="fin-metric-value ' + ybCls + '">' + yBudgetPct + '%</div>';
                html += '<div class="fin-metric-sub">Perkiraan: ' + formatDecimal(yearlyBudget) + ' kWh/tahun</div></div>';
            } else {
                html += '<div class="fin-metric-value text-muted">—</div>';
                html += '<div class="fin-metric-sub">Belum dikonfigurasi</div></div>';
            }

            html += '</div>';

            // Yearly insights
            html += '<div class="daily-report-insights">';
            html += '<div class="text-muted mb-1" style="font-size:0.7rem"><i class="fas fa-lightbulb"></i> WAWASAN TAHUNAN</div>';
            var insights = [];

            // Average daily cost
            var daysThisYear = Math.floor((new Date() - new Date(new Date().getFullYear(), 0, 1)) / 86400000) + 1;
            var avgDailyCost = daysThisYear > 0 ? Math.round(yearCost / daysThisYear) : 0;
            insights.push(' Rata-rata biaya harian: Rp ' + formatInteger(avgDailyCost) + ' · Bulanan: Rp ' + formatInteger(Math.round(yearCost / Math.max(currentMonth, 1))));

            // YoY trend
            if (pc.yoyChangePercent !== undefined && pc.lastYearSameMonthKWh > 0) {
                if (pc.yoyChangePercent > 20) {
                    insights.push('<span class="text-danger"> Tren naik signifikan — konsumsi bulan ini ' + Math.abs(pc.yoyChangePercent).toFixed(1) + '% lebih tinggi dari tahun lalu</span>');
                } else if (pc.yoyChangePercent < -20) {
                    insights.push('<span class="text-success"> Tren turun — konsumsi bulan ini ' + Math.abs(pc.yoyChangePercent).toFixed(1) + '% lebih rendah dari tahun lalu</span>');
                } else {
                    insights.push('Konsumsi bulan ini relatif stabil dibandingkan dengan tahun sebelumnya (selisih ' + Math.abs(pc.yoyChangePercent || 0).toFixed(1) + '%).');
                }
            }

            // Peak vs avg ratio
            if (peakMonthInfo.energy > 0 && yearAvgPerMonth > 0) {
                var peakVsAvg = Math.round(peakMonthInfo.energy / yearAvgPerMonth * 100 - 100);
                if (peakVsAvg > 50) {
                    insights.push('<span class="text-warning"> Bulan puncak ' + peakVsAvg + '% di atas rata-rata — pertimbangkan penjadwalan ulang beban</span>');
                }
            }

            // WBP contribution
            if (wbpLwbp.configured && (wbpLwbp.wbpKwh + wbpLwbp.lwbpKwh) > 0) {
                var wbpTotal = wbpLwbp.wbpKwh + wbpLwbp.lwbpKwh;
                var wbpPct = (wbpLwbp.wbpKwh / wbpTotal * 100).toFixed(1);
                var lwbpPct = (100 - parseFloat(wbpPct)).toFixed(1);
                insights.push(' Proporsi tahunan WBP ' + wbpPct + '% · LWBP ' + lwbpPct + '% — biaya WBP Rp ' + formatInteger(wbpLwbp.wbpCost || 0) + ' vs LWBP Rp ' + formatInteger(wbpLwbp.lwbpCost || 0));
            }

            // Pemborosan energi annualized
            if (waste.configured && waste.wastePercent > 0) {
                var annualWasteKWh = waste.wasteKwh * 12;
                var annualWasteCost = waste.wasteCost * 12;
                insights.push('<span class="' + (waste.wastePercent > 5 ? 'text-danger' : '') + '"> Pemborosan energi ' + waste.wastePercent.toFixed(1) + '% · Perkiraan tahunan: ' + formatDecimal(annualWasteKWh) + ' kWh (Rp ' + formatInteger(annualWasteCost) + ')</span>');
            }

            // Budget pace
            if (yearlyBudget > 0) {
                var yBudgetPct2 = Math.round(yearKwh / yearlyBudget * 100);
                var expectedPctByNow = Math.round(currentMonth / 12 * 100);
                if (yBudgetPct2 > expectedPctByNow + 10) {
                    insights.push('<span class="text-danger"> Penggunaan anggaran tahunan telah mencapai ' + yBudgetPct2 + '%; sementara itu, baru ' + expectedPctByNow + '% periode yang telah berlalu. Penggunaan anggaran melampaui target.</span>');
                } else {
                    insights.push('<span class="text-success"> Penggunaan anggaran tahunan mencapai ' + yBudgetPct2 + '%; ' + expectedPctByNow + '% periode telah berlalu. Penggunaan anggaran sesuai target.</span>');
                }
            }

            // Device mix
            if (ti.totalDeviceCount > 1) {
                insights.push(' ' + (ti.wbpDeviceCount || 0) + ' perangkat bertarif WBP/LWBP, ' + (ti.flatDeviceCount || 0) + ' perangkat bertarif tetap');
            }

            // Projection to year end
            if (yearKwh > 0 && currentMonth > 1) {
                var projectedYearKwh = Math.round(yearKwh / currentMonth * 12);
                var projectedYearCost = Math.round(projectedYearKwh * tariff);
                insights.push(' Proyeksi akhir tahun: ' + formatDecimal(projectedYearKwh) + ' kWh (Rp ' + formatInteger(projectedYearCost) + ')');
            }

            if (insights.length === 0) {
                insights.push('<span class="text-muted">Data belum mencukupi untuk melakukan analisis tahunan.</span>');
            }

            insights.forEach(function(insight) {
                html += '<div style="padding:2px 0; line-height:1.4">' + insight + '</div>';
            });
            html += '</div>';
            $body.html(html);
        }

        function formatNumber(num) {
            if (!num) return '0';
            return Number(num).toLocaleString('id-ID');
        }

        function formatInteger(num) {
            if (!num) return '0';
            return Number(num).toLocaleString('id-ID', { maximumFractionDigits: 0 });
        }

        function formatDecimal(num) {
            if (!num) return '0,00';
            return Number(num).toLocaleString('id-ID', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        }
    </script>
}
