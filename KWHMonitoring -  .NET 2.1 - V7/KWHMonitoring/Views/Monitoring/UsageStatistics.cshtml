            function themeScales(base) {
                var gridColor = (typeof window.getChartGridColor === 'function') ? window.getChartGridColor() : 'rgba(0,0,0,0.08)';
                var tickColor = (typeof window.getChartTickColor === 'function') ? window.getChartTickColor() : '#666';
                base = base || {};
                var y = base.y || {};
                var x = base.x || {};
                y.ticks = y.ticks || {};
                x.ticks = x.ticks || {};
                y.ticks.color = tickColor;
                x.ticks.color = tickColor;
                y.grid = y.grid || {};
                x.grid = x.grid || {};
                if (!y.grid.color) y.grid.color = gridColor;
                if (!x.grid.color) x.grid.color = gridColor;
                return { y: y, x: x };
            }

            // Hourly chart
            var hourlyCtx = document.getElementById('hourlyChart');
            if (hourlyCtx) {
                var hourlyData = (data.hourlyData || []).sort((a, b) => a.sortKey - b.sortKey);

                var today = new Date();
                var isToday = selectedDate.toDateString() === today.toDateString();
                var currentHour = today.getHours();

                var colors = hourlyData.map(h => {
                    if (!isToday) return 'rgba(13, 110, 253, 0.7)';
                    if (h.sortKey === currentHour) return 'rgba(255, 165, 0, 0.9)';
                    if (h.sortKey < currentHour) return 'rgba(13, 110, 253, 0.7)';
                    return 'rgba(200, 200, 200, 0.3)';
