        // ============================================
        // PROJECTION CHARTS — Consumption & Cost
        // ============================================
        var activeProjectionTab = 'monthly';
        var activeCostProjectionTab = 'monthly';
        var projectionChartInstance = null;
        var costProjectionChartInstance = null;

        function switchProjectionTab(tab) {
            activeProjectionTab = tab;
            $('[data-proj-tab]').removeClass('active');
            $('[data-proj-tab="' + tab + '"]').addClass('active');
            updateConsumptionProjectionChart();
        }

        function switchCostProjectionTab(tab) {
