@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    ViewData["Title"] = "Usage Statistics";
    var usageBatchEndpointEnabled = !string.Equals(Configuration["UsageStatistics:UseBatchEndpoint"], "false", StringComparison.OrdinalIgnoreCase);
}

@await Html.PartialAsync("_DashboardHeader")

<style>
    /* Header khusus tabel ranking/perbandingan; tidak memengaruhi card lain. */
    .usage-ranking-comparison-card .card-header {
        display: flex;
        flex-direction: column;
        gap: .55rem;
    }

    .usage-ranking-comparison-header-main,
    .usage-ranking-comparison-header-controls {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: .75rem;
        width: 100%;
    }

    .usage-ranking-comparison-heading {
        min-width: 0;
        flex: 1 1 auto;
    }

    .usage-ranking-comparison-heading h6 {
        overflow-wrap: anywhere;
    }

    .usage-ranking-comparison-heading small {
        display: block;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .usage-ranking-comparison-switch,
    .usage-ranking-comparison-periods {
        display: flex;
        flex-wrap: wrap;
        justify-content: flex-end;
        gap: .25rem;
    }

    .usage-ranking-comparison-switch .btn,
    .usage-ranking-comparison-periods .btn {
        white-space: nowrap;
    }

    @@media (max-width: 767.98px) {
        .usage-ranking-comparison-header-main,
        .usage-ranking-comparison-header-controls {
            align-items: stretch;
            flex-direction: column;
        }

        .usage-ranking-comparison-switch,
        .usage-ranking-comparison-periods {
            justify-content: flex-start;
            width: 100%;
        }

        .usage-ranking-comparison-switch .btn,
        .usage-ranking-comparison-periods .btn {
            flex: 1 1 auto;
        }
    }
</style>

    <!-- Device Filter Bar -->
    <div class="d-flex justify-content-between align-items-center mb-2 mb-md-3 flex-wrap gap-2">
        <h5 class="mb-0"><i class="fas fa-chart-bar"></i> Usage Statistics</h5>
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <small class="text-muted" id="deviceFilterLabel">Semua Panel</small>
            <button class="btn btn-sm btn-outline-primary" type="button" data-toggle="collapse" data-target="#usageFilterCollapse" aria-expanded="false" title="Toggle filter perangkat">
                <i class="fas fa-filter"></i> Filter
            </button>
        </div>
    </div>

    <div class="collapse mb-3" id="usageFilterCollapse">
        <div class="filter-bar-container">
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <div class="position-relative flex-grow-1" style="min-width: 200px; max-width: 320px;">
                    <i class="fas fa-search position-absolute text-muted" style="left: 10px; top: 50%; transform: translateY(-50%); font-size: 0.8rem;"></i>
                    <input type="text" id="usageDeviceSearch" class="form-control form-control-sm ps-4" placeholder="Cari panel..." />
                </div>
                <select id="usageCategoryFilter" class="form-select form-select-sm" style="width: auto; min-width: 140px;">
                    <option value="all">Semua Kategori</option>
                    <option value="Billboard">Billboard</option>
                </select>
                <button id="btnClearUsageFilter" class="btn btn-sm btn-outline-secondary" title="Reset filter">
                    <i class="fas fa-times"></i>
                </button>
            </div>
            <div class="mt-2 d-flex flex-wrap gap-1" id="usageChipList"></div>
        </div>
    </div>

    <!-- Date Navigation -->
    <div class="row mb-2 mb-md-3">
        <div class="col-12">
                <div class="card-body py-2">
                    <div class="date-nav-row">
                        <div class="date-nav-group">
                            <button class="btn btn-outline-primary btn-sm" id="btnPrevDay" title="Hari sebelumnya">
                                <i class="fas fa-chevron-left"></i>
                            </button>
                            <input type="date" class="form-control form-control-sm" id="filterDate">
                            <button class="btn btn-outline-primary btn-sm" id="btnNextDay" title="Hari berikutnya">
                                <i class="fas fa-chevron-right"></i>
                            </button>
                        </div>
                        <div class="date-nav-info">
                            <button class="btn btn-outline-secondary btn-sm" id="btnToday" title="Hari ini">
                                <i class="fas fa-calendar-day"></i> <span>Hari Ini</span>
                            </button>
                            <span class="text-muted" id="selectedDayName">-</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Summary Cards -->
    <div class="stats-row mb-3 mb-md-4">
        <div>
            <div class="stat-card bg-primary h-100" data-card-help="Konsumsi Hari Ini|Total energi terpakai pada tanggal terpilih.|Rumus: kWh hari = Σ konsumsi harian seluruh perangkat|Rata-rata/jam = kWh hari ÷ jumlah jam berjalan">
                <div class="stat-label" id="usageTodayLabel">Hari Ini</div>
                <div class="stat-value" id="usageToday">0 kWh</div>
                <small>Rata-rata: <span id="usageTodayAvg">0</span> kWh/jam</small>
                <i class="fas fa-calendar-day stat-icon"></i>
            </div>
        </div>
        <div>
            <div class="stat-card bg-success h-100" data-card-help="Konsumsi Bulan Ini|Akumulasi energi sepanjang bulan berjalan.|Rumus: kWh bulan = Σ konsumsi harian bulan ini|Rata-rata/hari = kWh bulan ÷ tanggal berjalan">
                <div class="stat-label" id="usageMonthLabel">Bulan Ini</div>
                <div class="stat-value" id="usageMonth">0 kWh</div>
                <small>Rata-rata: <span id="usageMonthAvg">0</span> kWh/hari</small>
                <i class="fas fa-calendar-week stat-icon"></i>
            </div>
        </div>
        <div>
            <div class="stat-card bg-info h-100" data-card-help="Konsumsi Tahun Ini|Akumulasi energi sepanjang tahun berjalan.|Rumus: kWh tahun = Σ konsumsi bulanan tahun ini|Rata-rata/bulan = kWh tahun ÷ jumlah bulan berjalan">
                <div class="stat-label" id="usageYearLabel">Tahun Ini</div>
                <div class="stat-value" id="usageYear">0 kWh</div>
                <small>Rata-rata: <span id="usageYearAvg">0</span> kWh/bulan</small>
                <i class="fas fa-calendar stat-icon"></i>
            </div>
        </div>
        <div>
            <div class="stat-card bg-warning h-100" data-card-help="Estimasi Biaya|Perkiraan biaya listrik dari konsumsi yang sudah terpakai.|Rumus: Estimasi Biaya = kWh × Tarif (Rp/kWh)|Tarif bawaan sebesar Rp1.500/kWh dan dapat diatur untuk setiap perangkat pada halaman Pengaturan.">
                <div class="stat-label" id="usageCostLabel">Estimasi Biaya</div>
                <div class="stat-value" id="usageCost">Rp 0</div>
                <small>Tarif: <span id="tariffDisplay">Rp 1.500</span>/kWh</small>
                <i class="fas fa-money-bill-wave stat-icon"></i>
            </div>
        </div>
    </div>

    <!-- Charts -->
    <div class="chart-row mb-3 mb-md-4">
        <div>
            <div class="card shadow-sm h-100" data-card-help="Grafik Per Jam|Profil konsumsi energi tiap jam pada tanggal terpilih — berguna melihat pola pemakaian siang dibandingkan dengan malam.|Rumus: kWh jam = total energi yang terakumulasi pada jam tersebut|Jam dengan batang tertinggi = jam paling boros.">
                <div class="card-header bg-primary text-white py-2">
                    <h6 class="mb-0"><i class="fas fa-clock"></i> Per Jam</h6>
                </div>
                <div class="card-body">
                    <canvas id="hourlyChart"></canvas>
                </div>
            </div>
        </div>
        <div>
            <div class="card shadow-sm h-100" data-card-help="Grafik Per Hari|Konsumsi energi harian — membandingkan penggunaan antar hari.|Rumus: kWh hari = Σ energi harian seluruh perangkat|Puncak batang tertinggi = hari paling boros.">
                <div class="card-header bg-success text-white py-2">
                    <h6 class="mb-0"><i class="fas fa-calendar-day"></i> Per Hari</h6>
                </div>
                <div class="card-body">
                    <canvas id="dailyChart"></canvas>
                </div>
            </div>
        </div>
        <div>
            <div class="card shadow-sm h-100" data-card-help="Grafik Per Bulan|Tren konsumsi energi bulanan — melihat pola musiman dan efektivitas penghematan.|Rumus: kWh bulan = Σ konsumsi harian dalam bulan tersebut|Bandingkan batang antar bulan untuk melihat kenaikan/penurunan.">
                <div class="card-header bg-info text-white py-2">
                    <h6 class="mb-0"><i class="fas fa-calendar-alt"></i> Per Bulan</h6>
                </div>
                <div class="card-body">
                    <canvas id="monthlyChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Peak Info -->
    <div class="peak-row">
        <div>
            <div class="card bg-light" data-card-help="Jam Puncak|Jam dengan konsumsi energi tertinggi pada periode terpilih.|Rumus: Jam Puncak = jam dengan kWh maksimum|Nilainya = energi terkonsumsi di jam tersebut.">
                <div class="card-body py-2">
                    <h6 class="text-muted mb-1"><i class="fas fa-bolt text-warning"></i> Peak Hour</h6>
                    <h5 class="text-primary mb-1" id="peakHourValue">0 kWh</h5>
                    <p class="text-muted mb-0">Jam: <span id="peakHourTime">-</span></p>
                </div>
            </div>
        </div>
        <div>
            <div class="card bg-light" data-card-help="Hari Puncak|Tanggal dengan konsumsi energi tertinggi pada periode terpilih.|Rumus: Hari Puncak = hari dengan kWh maksimum|Nilainya = energi terkonsumsi pada tanggal tersebut.">
                <div class="card-body py-2">
                    <h6 class="text-muted mb-1"><i class="fas fa-calendar-day text-success"></i> Peak Day</h6>
                    <h5 class="text-success mb-1" id="peakDayValue">0 kWh</h5>
                    <p class="text-muted mb-0">Tanggal: <span id="peakDayDate">-</span></p>
                </div>
            </div>
        </div>
        <div>
            <div class="card bg-light" data-card-help="Bulan Puncak|Bulan dengan konsumsi energi tertinggi pada periode terpilih.|Rumus: Bulan Puncak = bulan dengan kWh maksimum|Nilainya = energi terkonsumsi pada bulan tersebut.">
                <div class="card-body py-2">
                    <h6 class="text-muted mb-1"><i class="fas fa-calendar-alt text-info"></i> Peak Month</h6>
                    <h5 class="text-info mb-1" id="peakMonthValue">0 kWh</h5>
                    <p class="text-muted mb-0">Bulan: <span id="peakMonthName">-</span></p>
                </div>
            </div>
        </div>
    </div>

    <div class="mb-3 mt-3 mt-md-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
    </div>
    <!-- Ranking & ERP Comparison -->
    <div class="card shadow-sm mb-3 mb-md-4 usage-ranking-comparison-card">
        <div class="card-header py-2">
            <div class="usage-ranking-comparison-header-main">
                <div class="usage-ranking-comparison-heading">
                    <h6 class="mb-0" id="usageRankingPanelTitle"><i class="fas fa-trophy text-warning"></i> Peringkat Penggunaan Energi</h6>
                    <small class="text-muted" id="usageRankingCaption">Konsumsi hari ini · memuat data</small>
                </div>
                <div class="usage-ranking-comparison-switch btn-group btn-group-sm" role="group" aria-label="Tampilan ranking dan perbandingan">
                    <button type="button" class="btn btn-primary usage-panel-view" data-view="ranking"><i class="fas fa-trophy"></i> Peringkat</button>
                    <button type="button" class="btn btn-outline-primary usage-panel-view" data-view="comparison"><i class="fas fa-file-invoice-dollar"></i> Perbandingan ERP</button>
                </div>
            </div>
            <div class="usage-ranking-comparison-header-controls">
                <div id="usageRankingControls" class="usage-ranking-comparison-periods">
                    <button type="button" class="btn btn-primary usage-ranking-period" data-period="today">Hari Ini</button>
                    <button type="button" class="btn btn-outline-primary usage-ranking-period" data-period="month">Bulan Ini</button>
                    <button type="button" class="btn btn-outline-primary usage-ranking-period" data-period="year">Tahun Ini</button>
                </div>
                <div id="usageComparisonControls" class="usage-ranking-comparison-periods" style="display:none">
                    <button type="button" class="btn btn-primary usage-comparison-period" data-period="current">Bulan Ini</button>
                    <button type="button" class="btn btn-outline-primary usage-comparison-period" data-period="previous">Bulan Lalu</button>
                    <button type="button" class="btn btn-outline-primary usage-comparison-period" data-period="twoMonthsAgo">2 Bulan Lalu</button>
                    <button type="button" class="btn btn-outline-primary usage-comparison-period" data-period="threeMonthsAgo">3 Bulan Lalu</button>
                    <button type="button" class="btn btn-outline-primary usage-comparison-period" data-period="average">Rata-rata 3 Bulan</button>
                </div>
            </div>
        </div>
        <div id="usageRankingPanel">
            <div class="table-responsive">
                <table class="table table-hover table-sm mb-0 align-middle">
                    <thead class="thead-light"><tr><th>#</th><th>Perangkat</th><th>Grup</th><th class="text-right">Energi (kWh)</th><th class="text-right">Estimasi Biaya</th><th class="text-right">Daya (W)</th><th class="text-right">Faktor Daya</th><th>Pembaruan</th></tr></thead>
                    <tbody id="usageRankingRows"><tr><td colspan="8" class="text-center text-muted py-3">Memuat peringkat...</td></tr></tbody>
                </table>
            </div>
            <div class="card-footer py-2"><small class="text-muted">Pilih baris untuk membuka detail perangkat. Estimasi biaya dihitung menggunakan tarif untuk setiap perangkat.</small></div>
        </div>
        <div id="usageComparisonPanel" style="display:none">
            <div class="table-responsive">
                <table class="table table-sm table-hover mb-0 usage-erp-comparison-table">
                    <thead class="thead-light">
                        <tr>
                            <th>Perangkat</th>
                            <th>Periode</th>
                            <th class="text-right">Energi Terukur</th>
                            <th class="text-right">Perkiraan Tagihan</th>
                            <th class="text-right">Tagihan ERP</th>
                            <th>Keterangan</th>
                            <th>Bukti Periode ERP</th>
                            <th class="text-right">Perubahan Biaya</th>
                        </tr>
                    </thead>
                    <tbody id="usageErpComparisonRows">
                        <tr><td colspan="8" class="text-center text-muted py-3"><i class="fas fa-spinner fa-spin"></i> Memuat perbandingan...</td></tr>
                    </tbody>
                </table>
            </div>
            <div class="px-3 py-2 border-top text-muted small" id="usageErpComparisonAverage"></div>
        </div>
    </div>

    <!-- Financial Analysis -->
    <div class="mb-3 mt-3 mt-md-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
        <h6 class="text-muted mb-0"><i class="fas fa-chart-line"></i> Analisis Keuangan</h6>
        <a asp-controller="Monitoring" asp-action="UsageStatisticsDocs" class="btn btn-sm btn-outline-info" target="_blank">
            <i class="fas fa-book"></i> Dokumentasi Perhitungan
        </a>
    </div>

    <!-- Financial Charts Row -->
    <div class="chart-row mb-3">
        <div>
            <div class="card shadow-sm h-100" data-card-help="Perbandingan WBP dan LWBP|Perbandingan pemakaian pada jam Beban Puncak (WBP) dibandingkan dengan Luar Beban Puncak (LWBP).|Rumus: Rasio WBP = kWh WBP ÷ total kWh × 100&#10;Biaya = kWh WBP × tarif WBP + kWh LWBP × tarif LWBP|Waktu WBP bawaan adalah pukul 18.00–22.00 dan dapat diatur untuk setiap perangkat. Pemakaian pada waktu LWBP dapat mengurangi biaya.">
                <div class="card-header py-2" style="background-color:#5b5ea6!important;color:#fff">
                    <h6 class="mb-0"><i class="fas fa-bolt"></i> Perbandingan WBP dan LWBP</h6>
                </div>
                <div class="card-body fin-chart-body">
                    <canvas id="wbpLwbpChart" style="display:none"></canvas>
                    <div id="wbpLwbpNotConfigured" class="text-center text-muted py-3" style="font-size:0.8rem"><i class="fas fa-cog"></i> Belum dikonfigurasi</div>
                </div>
                <div class="fin-chart-footer" id="wbpLwbpFooter" style="display:none"></div>
            </div>
        </div>
        <div>
            <div class="card shadow-sm h-100" data-card-help="Anggaran dan Realisasi|Perbandingan antara anggaran energi bulanan dan konsumsi aktual.|Rumus: selisih = konsumsi aktual (kWh) − anggaran (kWh). Persentase selisih = (konsumsi aktual − anggaran) ÷ anggaran × 100.|Nilai di atas 100% menunjukkan bahwa konsumsi melampaui anggaran. Anggaran dapat diatur untuk setiap perangkat pada halaman Pengaturan.">
                <div class="card-header bg-success text-white py-2" id="budgetCardHeader">
                    <h6 class="mb-0"><i class="fas fa-wallet"></i> Anggaran dan Realisasi</h6>
                </div>
                <div class="card-body fin-chart-body">
                    <canvas id="budgetChart" style="display:none"></canvas>
                    <div id="budgetNotConfigured" class="text-center text-muted py-3" style="font-size:0.8rem"><i class="fas fa-cog"></i> Belum dikonfigurasi</div>
                </div>
                <div class="fin-chart-footer" id="budgetFooter" style="display:none"></div>
            </div>
        </div>
    </div>

    <!-- Projection Chart -->
    <div class="chart-row mb-3">
        <div>
            <div class="card shadow-sm h-100" data-card-help="Proyeksi Konsumsi|Estimasi total energi sampai akhir bulan/tahun berjalan.|Rumus: Proyeksi = rata-rata konsumsi per hari × jumlah hari dalam periode|Membantu memperkirakan apakah konsumsi akan melebihi target.">
                <div class="card-header bg-orange text-white py-2 d-flex align-items-center justify-content-between">
                    <h6 class="mb-0"><i class="fas fa-chart-line"></i> Proyeksi Konsumsi</h6>
                    <div class="proj-tab-group">
                        <button type="button" class="proj-tab active" data-proj-tab="monthly" onclick="switchProjectionTab('monthly')">Bulanan</button>
                        <button type="button" class="proj-tab" data-proj-tab="yearly" onclick="switchProjectionTab('yearly')">Tahunan</button>
                    </div>
                </div>
                <div class="card-body fin-chart-body">
                    <canvas id="projectionChart"></canvas>
                </div>
                <div class="fin-chart-footer" id="projectionFooter"></div>
            </div>
        </div>
        <div>
            <div class="card shadow-sm h-100" data-card-help="Proyeksi Biaya|Estimasi tagihan listrik sampai akhir periode berjalan.|Rumus: Proyeksi Biaya = Proyeksi kWh × Tarif (Rp/kWh)|Membantu mengantisipasi tagihan sebelum periode berakhir.">
                <div class="card-header bg-teal text-white py-2 d-flex align-items-center justify-content-between">
                    <h6 class="mb-0"><i class="fas fa-chart-area"></i> Proyeksi Biaya</h6>
                    <div class="proj-tab-group">
                        <button type="button" class="proj-tab active" data-costproj-tab="monthly" onclick="switchCostProjectionTab('monthly')">Bulanan</button>
                        <button type="button" class="proj-tab" data-costproj-tab="yearly" onclick="switchCostProjectionTab('yearly')">Tahunan</button>
                    </div>
                </div>
                <div class="card-body fin-chart-body">
                    <canvas id="costProjectionChart"></canvas>
                </div>
                <div class="fin-chart-footer" id="costProjectionFooter"></div>
            </div>
        </div>
    </div>

    <!-- Financial Summary & Anomaly Cost — 2 columns -->
    <div class="fin-summary-grid mb-3">
        <div>
            <div class="card shadow-sm h-100" data-card-help="Ringkasan Keuangan|Ringkasan metrik keuangan untuk periode yang dipilih.|Rumus: Pemborosan% = Pemborosan kWh ÷ total kWh × 100&#10;perubahan bulanan% = Δ dibandingkan dengan bulan lalu ÷ bulan lalu × 100 · perubahan tahunan% = Δ dibandingkan dengan tahun lalu ÷ tahun lalu × 100&#10;Faktor beban = kWh ÷ (kapasitas × jam berjalan) × 100 (maksimal 100%)&#10;Biaya per unit = biaya ÷ luas (m²) dan biaya ÷ jam berjalan|Pemborosan >5% dan faktor beban >80% = perhatian.">
                <div class="card-header bg-dark text-white py-2">
                    <h6 class="mb-0"><i class="fas fa-th-large"></i> Ringkasan Keuangan</h6>
                </div>
                <div class="card-body py-2 px-3">
                    <div class="fin-metric-grid">
                        <div class="fin-metric" id="finWaste">
                            <div class="fin-metric-label"><i class="fas fa-exclamation-triangle text-danger"></i> Pemborosan</div>
                            <div class="fin-metric-value" id="finWasteValue">—</div>
                            <div class="fin-metric-sub" id="finWasteSub"></div>
                        </div>
                        <div class="fin-metric" id="finMom">
                            <div class="fin-metric-label"><i class="fas fa-exchange-alt text-info"></i> Perubahan Bulanan</div>
                            <div class="fin-metric-value" id="finMomValue">—</div>
                            <div class="fin-metric-sub" id="finMomSub"></div>
                        </div>
                        <div class="fin-metric" id="finYoy">
                            <div class="fin-metric-label"><i class="fas fa-sync-alt text-info"></i> Perubahan Tahunan</div>
                            <div class="fin-metric-value" id="finYoyValue">—</div>
                            <div class="fin-metric-sub" id="finYoySub"></div>
                        </div>
                        <div class="fin-metric" id="finBill">
                            <div class="fin-metric-label"><i class="fas fa-file-invoice-dollar text-warning"></i> Proyeksi</div>
                            <div class="fin-metric-value" id="finBillValue">—</div>
                            <div class="fin-metric-sub" id="finBillSub"></div>
                        </div>
                        <div class="fin-metric" id="finLf">
                            <div class="fin-metric-label"><i class="fas fa-tachometer-alt text-warning"></i> Faktor Beban</div>
                            <div class="fin-metric-value" id="finLfValue">—</div>
                            <div class="fin-metric-sub" id="finLfSub"></div>
                        </div>
                        <div class="fin-metric" id="finUe">
                            <div class="fin-metric-label"><i class="fas fa-calculator text-success"></i> Unit Econ</div>
                            <div class="fin-metric-value" id="finUeValue">—</div>
                            <div class="fin-metric-sub" id="finUeSub"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div>
            <div class="card shadow-sm h-100" data-card-help="Dampak Biaya Anomali|Estimasi biaya tambahan akibat anomali (beban berlebih / gangguan perangkat).|Rumus: Kelebihan energi (kWh) ≈ daya berlebih (W) ÷1000 ×0,25 jam per kejadian&#10;Dampak Biaya = Kelebihan energi (kWh) × Tarif (Rp/kWh)|Dihitung otomatis dari log anomali pada periode terpilih.">
                <div class="card-header bg-primary text-white py-2">
                    <h6 class="mb-0"><i class="fas fa-exclamation-circle"></i> Dampak Biaya Anomali</h6>
                </div>
                <div class="card-body py-2" id="anomalyCostBody">
                    <div class="text-center text-muted py-2" style="font-size:0.8rem">—</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Reports Grid -->
    <div class="report-grid mb-3">
        <!-- Report: Daily -->
        <div>
            <div class="card shadow-sm h-100" data-card-help="Laporan Harian|Ringkasan otomatis konsumsi dan biaya per hari.|Rumus: kWh hari = Σ energi harian · Biaya = kWh × tarif|Isi laporan diperbarui otomatis dari data monitoring.">
                <div class="card-header bg-info text-white py-2">
                    <h6 class="mb-0"><i class="fas fa-file-alt"></i> Laporan Harian</h6>
                </div>
                <div class="card-body py-2 px-3" id="dailyReportBody">
                    <div class="text-center text-muted py-2" style="font-size:0.8rem"><i class="fas fa-spinner fa-spin"></i> Memuat...</div>
                </div>
            </div>
        </div>

        <!-- Report: Monthly -->
        <div>
            <div class="card shadow-sm h-100" data-card-help="Laporan Bulanan|Ringkasan konsumsi dan biaya serta perbandingannya dengan bulan sebelumnya.|Rumus: konsumsi bulanan (kWh) = jumlah konsumsi harian. Perubahan bulanan (%) = selisih dari bulan sebelumnya ÷ konsumsi bulan sebelumnya × 100.|Laporan menandai konsumsi yang diperkirakan melampaui anggaran.">
                <div class="card-header bg-warning text-dark py-2">
                    <h6 class="mb-0"><i class="fas fa-calendar-week"></i> Laporan Bulanan</h6>
                </div>
                <div class="card-body py-2 px-3" id="monthlyReportBody">
                    <div class="text-center text-muted py-2" style="font-size:0.8rem"><i class="fas fa-spinner fa-spin"></i> Memuat...</div>
                </div>
            </div>
        </div>

        <!-- Report: Yearly -->
        <div>
            <div class="card shadow-sm h-100" data-card-help="Laporan Tahunan|Ringkasan konsumsi dan biaya tahunan serta perbandingannya dengan tahun sebelumnya.|Rumus: kWh tahunan = jumlah konsumsi bulanan. Perubahan tahunan (%) = selisih dari tahun sebelumnya ÷ konsumsi tahun sebelumnya × 100.|Laporan ini membantu melihat tren penghematan dari tahun ke tahun.">
                <div class="card-header bg-indigo text-white py-2">
                    <h6 class="mb-0"><i class="fas fa-calendar"></i> Laporan Tahunan</h6>
                </div>
                <div class="card-body py-2 px-3" id="yearlyReportBody">
                    <div class="text-center text-muted py-2" style="font-size:0.8rem"><i class="fas fa-spinner fa-spin"></i> Memuat...</div>
                </div>
            </div>
        </div>
    </div>

@section Scripts {
    <script src="~/js/chart.umd.min.js"></script>
    <script>
        var captions = { today: 'Konsumsi hari ini', month: 'Akumulasi bulan ini', year: 'Akumulasi tahun ini' };
        var usagePanelView = 'ranking';
        var usageCachePrefix = 'kwhmonitoring.usage-statistics.';

        function escapeHtml(value) { return $('<div>').text(value == null ? '' : value).html(); }
        function readUsageCache(key) {
            try {
                var raw = window.localStorage.getItem(usageCachePrefix + key);
                return raw ? JSON.parse(raw) : null;
            } catch (error) { return null; }
        }
        function writeUsageCache(key, value) {
            try { window.localStorage.setItem(usageCachePrefix + key, JSON.stringify(value)); } catch (error) { }
        }

        (function () {
            var rankingPeriod = 'today';
            var rankingRequestInProgress = false;
            var rankingXhr = null;
            var rankingHasLoaded = false;
            function showUsagePanel(view) {
                usagePanelView = view === 'comparison' ? 'comparison' : 'ranking';
                var isComparison = usagePanelView === 'comparison';
                $('#usageRankingPanel').toggle(!isComparison);
                $('#usageComparisonPanel').toggle(isComparison);
                $('#usageRankingControls').toggle(!isComparison);
                $('#usageComparisonControls').toggle(isComparison);
                $('.usage-panel-view').removeClass('btn-primary').addClass('btn-outline-primary');
                $('.usage-panel-view[data-view="' + usagePanelView + '"]').removeClass('btn-outline-primary').addClass('btn-primary');
                if (isComparison) {
                    $('#usageRankingPanelTitle').html('<i class="fas fa-file-invoice-dollar text-primary"></i> Perbandingan Estimasi KWH vs WWERP2019');
                    $('#usageRankingCaption').text('Pilih periode perbandingan untuk melihat estimasi dan aktual ERP');
                    var currentComparisonKey = getUsageComparisonRequestKey();
                    if (comparisonResponse && comparisonResponseKey === currentComparisonKey) {
                        renderUsageComparison(comparisonResponse, comparisonPeriod, false);
                    } else {
                        loadUsageErpComparison();
                    }
                } else {
                    $('#usageRankingPanelTitle').html('<i class="fas fa-trophy text-warning"></i> Peringkat Penggunaan Energi');
                    $('#usageRankingCaption').text(captions[rankingPeriod] || captions.today);
                }
            }
            function loadUsageRanking(period) {
                rankingPeriod = period;
                if (rankingRequestInProgress || document.hidden) return;
                rankingRequestInProgress = true;
                $('#usageRankingCaption').text(captions[period] + (rankingHasLoaded ? ' · memperbarui…' : ''));
                var rankingCacheKey = 'ranking.' + period;
                var cachedRows = readUsageCache(rankingCacheKey);
                if (!rankingHasLoaded && !cachedRows) $('#usageRankingRows').html('<tr><td colspan="8" class="text-center text-muted py-3">Memuat peringkat...</td></tr>');
                if (cachedRows) {
                    renderUsageRanking(cachedRows);
                    rankingHasLoaded = true;
                    $('#usageRankingCaption').text(captions[period] + ' · cache terakhir');
                }
                $('.usage-ranking-period').removeClass('btn-primary').addClass('btn-outline-primary');
                $('.usage-ranking-period[data-period="' + period + '"]').removeClass('btn-outline-primary').addClass('btn-primary');
                rankingXhr = $.getJSON('@Url.Action("UsageRanking", "Monitoring")', { period: period }).done(function (rows) {
                    rankingRequestInProgress = false;
                    rankingHasLoaded = true;
                    writeUsageCache(rankingCacheKey, rows || []);
                    renderUsageRanking(rows || []);
                    $('#usageRankingCaption').text(captions[period] + ' · diperbarui ' + new Date().toLocaleTimeString('id-ID'));
                }).fail(function (xhr, status) {
                    rankingRequestInProgress = false;
                    if (status === 'abort') return;
                    if (cachedRows || rankingHasLoaded) $('#usageRankingCaption').text(captions[period] + ' · offline, menampilkan cache terakhir');
                    else $('#usageRankingRows').html('<tr><td colspan="8" class="text-center text-danger py-3">Peringkat belum tersedia.</td></tr>');
                });
            }
            function renderUsageRanking(rows) {
                if (!rows || !rows.length) {
                    $('#usageRankingRows').html('<tr><td colspan="8" class="text-center text-muted py-3">Belum ada data konsumsi pada periode ini.</td></tr>');
                    return;
                }
                var html = '';
                rows.forEach(function (item, index) {
                    var label = item.groupName || item.deviceId || item.deviceKey;
                    var seen = item.lastSeen ? new Date(item.lastSeen).toLocaleString('id-ID') : '-';
                    var detailUrl = '@Url.Action("Details", "Monitoring")?deviceKey=' + encodeURIComponent(item.deviceKey);
                    html += '<tr class="usage-ranking-row" role="link" tabindex="0" data-url="' + escapeHtml(detailUrl) + '" style="cursor:pointer">' +
                        '<td><span class="badge ' + (index === 0 ? 'badge-warning' : 'badge-light') + '">' + (index + 1) + '</span></td>' +
                        '<td><strong>' + escapeHtml(label) + '</strong><br><small class="text-muted">Kode Lokasi: ' + escapeHtml(item.kodeLokasi || '-') + '</small></td>' +
                        '<td>' + escapeHtml(item.groupName || '-') + '</td>' +
                        '<td class="text-right font-weight-bold">' + Number(item.kwh || 0).toLocaleString('id-ID', { minimumFractionDigits: 2, maximumFractionDigits: 3 }) + '</td>' +
                        '<td class="text-right">Rp ' + Number(item.cost || 0).toLocaleString('id-ID', { maximumFractionDigits: 0 }) + '</td>' +
                        '<td class="text-right">' + Number(item.power || 0).toLocaleString('id-ID', { maximumFractionDigits: 1 }) + '</td>' +
                        '<td class="text-right">' + Number(item.powerFactor || 0).toLocaleString('id-ID', { minimumFractionDigits: 2, maximumFractionDigits: 3 }) + '</td>' +
                        '<td><small>' + escapeHtml(seen) + '</small></td></tr>';
                });
                $('#usageRankingRows').html(html);
            }
            $(document).on('click', '.usage-panel-view', function () { showUsagePanel($(this).data('view')); });
            $(document).on('click', '.usage-ranking-period', function () {
                if (rankingXhr && rankingRequestInProgress) {
                    rankingXhr.abort();
                    rankingRequestInProgress = false;
                }
                loadUsageRanking($(this).data('period'));
            });
            $(document).on('click', '.usage-ranking-row', function () { window.location.href = $(this).data('url'); });
            $(document).on('keydown', '.usage-ranking-row', function (event) {
                if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); window.location.href = $(this).data('url'); }
            });
            $(document).on('visibilitychange', function () {
                if (!document.hidden) loadUsageRanking(rankingPeriod);
            });
            $(function () {
                loadUsageRanking(rankingPeriod);
                showUsagePanel('ranking');
                if (window.RealtimeRefresh) {
                    // Peringkat ikut diperbarui ketika data KWH/agregasi berubah.
                    window.RealtimeRefresh.watch(
                        ['kwh', 'energy'],
                        function () {
                            if (!document.hidden) loadUsageRanking(rankingPeriod);
                        },
                        { throttleMs: 10000 }
                    );
                } else {
                    window.setInterval(function () {
                        if (!document.hidden) loadUsageRanking(rankingPeriod);
                    }, 10000);
                }
            });
        })();

        let charts = {};
        let selectedDate = new Date();
        let refreshTimer = null;
        let refreshWatcherId = null; // watcher realtime (refresh saat data berubah)
        let lastFinancialRefreshTime = 0;
        let usageLoadSequence = 0;
        let usageDataRequest = null;
        let usageFallbackRequests = [];
        const usageStatisticsBatchEnabled = @Html.Raw(usageBatchEndpointEnabled.ToString().ToLowerInvariant());
        let usageCycleInProgress = false;
        let usageRefreshPending = false;
        let usagePanelListReady = false;
        let usageInitialLoadPending = false;
        let lastSuccessfulUsageUpdate = '';
        let lastSuccessfulFinancialUpdate = '';
        var FINANCIAL_REFRESH_INTERVAL = 60000; // Aggregate financial data at most every 60s
        let usageFilterDebounce = null;
        let lastEnergyData = null;   // For daily report
        let lastFinancialData = null; // For daily report
        let comparisonPeriod = 'current';
        let comparisonResponse = null;
        let comparisonResponseKey = null;
        let comparisonRequestInProgress = false;
        let comparisonXhr = null;
        let comparisonRequestKey = null;
        let usagePanelListLoaded = false;
        let comparisonLoadPending = false;

        function resetUsageComparisonState() {
            if (comparisonXhr && comparisonXhr.readyState !== 4) comparisonXhr.abort();
            comparisonXhr = null;
            comparisonRequestInProgress = false;
            comparisonRequestKey = null;
            comparisonResponse = null;
            comparisonResponseKey = null;
        }

        function renderUsageChart(key, canvas, config) {
            config.options = config.options || {};
            config.options.animation = false;
            if (window.Chart && Chart.defaults) Chart.defaults.animation = false;
            var targetCanvas = canvas && canvas.canvas ? canvas.canvas : canvas;
            if (charts[key] && charts[key].canvas !== targetCanvas) {
                charts[key].destroy();
                charts[key] = null;
            }
            var existingChart = targetCanvas && window.Chart && typeof Chart.getChart === 'function'
                ? Chart.getChart(targetCanvas)
                : null;

            // Some charts (including the projection charts) are stored outside
            // `charts`, so the local cache alone cannot detect their canvas owner.
            if (existingChart && existingChart !== charts[key]) {
                existingChart.destroy();
            }
            if (charts[key] && charts[key].config.type !== config.type) {
                charts[key].destroy();
                charts[key] = null;
            }
            if (charts[key]) {
                charts[key].data = config.data;
                charts[key].options = config.options;
                charts[key].update('none');
                return charts[key];
            }
            charts[key] = new Chart(canvas, config);
            return charts[key];
        }

        // ============================================
        // DEVICE FILTER LOGIC
        // ============================================
        let usagePanelList = []; // Fetched from API
        let activeUsageChipDeviceKey = null; // null = all devices
        let usageAnomalyStatusMap = {};
        let usageDeviceCategoryMap = {}; // deviceKey -> category

        function populateUsageCategoryFilter() {
            $.ajax({
                url: '/api/Api/categories',
                method: 'GET',
                dataType: 'json',
                timeout: 10000,
                success: function(data) {
                    window._categoryMetaMap = {};
                    var $filter = $('#usageCategoryFilter');
                    var currentVal = $filter.val();
                    $filter.find('option:not(:first)').remove();
                    (data || []).forEach(function(cat) {
                        window._categoryMetaMap[cat.name] = { icon: cat.icon, color: cat.color, description: cat.description };
                        $filter.append('<option value="' + cat.name + '">' + cat.icon + ' ' + cat.name + '</option>');
                    });
                    $filter.val(currentVal);
                    if (typeof injectCategoryStyles === 'function') injectCategoryStyles(data);
                },
                error: function() { @* console.warn('Failed to load categories for usage filter'); *@ }
            });
        }

        function getUsageChipClass(deviceKey) {
            var anomaly = usageAnomalyStatusMap[deviceKey];
            if (anomaly === 'OVERLOAD') return 'chip-high';
            if (anomaly === 'DROP') return 'chip-medium';
            return 'chip-normal';
        }

        function renderUsageChips() {
            var $list = $('#usageChipList');
            $list.empty();

            if (usagePanelList.length === 0) return;

            var categoryFilter = $('#usageCategoryFilter').val();

            var sorted = usagePanelList.slice().sort(function(a, b) {
                var aAnomaly = usageAnomalyStatusMap[a.deviceKey] || '';
                var bAnomaly = usageAnomalyStatusMap[b.deviceKey] || '';
                var order = { 'OVERLOAD': 0, 'DROP': 1, '': 2 };
                var aOrder = order[aAnomaly] !== undefined ? order[aAnomaly] : 2;
                var bOrder = order[bAnomaly] !== undefined ? order[bAnomaly] : 2;
                if (aOrder !== bOrder) return aOrder - bOrder;
                var nameA = (a.groupName || a.deviceKey).toLowerCase();
                var nameB = (b.groupName || b.deviceKey).toLowerCase();
                return nameA.localeCompare(nameB);
            });

            // "All" chip
            var $allChip = $('<span>')
                .addClass('panel-chip chip-normal' + (activeUsageChipDeviceKey === null ? ' active' : ''))
                .attr('data-device-key', '__all__')
                .html('<span class="chip-dot"></span>Semua Panel')
                .on('click', function() {
                    activeUsageChipDeviceKey = null;
                    resetUsageComparisonState();
                    $list.find('.panel-chip').removeClass('active');
                    $(this).addClass('active');
                    updateDeviceFilterLabel();
                    lastFinancialRefreshTime = 0;
                    loadData(true);
                });
            $list.append($allChip);

            sorted.forEach(function(panel) {
                var chipClass = getUsageChipClass(panel.deviceKey);
                var label = panel.groupName || panel.deviceKey;
                var isActive = activeUsageChipDeviceKey === panel.deviceKey;

                // Category filter: hide chips that don't match
                var panelCategory = panel.deviceCategory || usageDeviceCategoryMap[panel.deviceKey] || 'Billboard';
                var visibleByCategory = (categoryFilter === 'all' || panelCategory === categoryFilter);

                var $chip = $('<span>')
                    .addClass('panel-chip ' + chipClass + (isActive ? ' active' : ''))
                    .attr('data-device-key', panel.deviceKey)
                    .attr('data-category', panelCategory)
                    .html('<span class="chip-dot"></span>' + label)
                    .on('click', function() {
                        activeUsageChipDeviceKey = panel.deviceKey;
                        resetUsageComparisonState();
                        $list.find('.panel-chip').removeClass('active');
                        $(this).addClass('active');
                        updateDeviceFilterLabel();
                        lastFinancialRefreshTime = 0;
                        loadData(true);
                    });

                if (!visibleByCategory) {
                    $chip.hide();
                }

                $list.append($chip);
            });
        }

        function updateDeviceFilterLabel() {
            var category = $('#usageCategoryFilter').val();
            var categoryLabel = '';
            if (category && category !== 'all') {
                var catNames = window._categoryMetaMap || {};
                var categoryLabel = catNames[category] ? ' — ' + (catNames[category].icon || '') + ' ' + category : ' — ' + category;
            }

            if (activeUsageChipDeviceKey === null) {
                $('#deviceFilterLabel').text('Semua Panel' + categoryLabel);
            } else {
                var panel = usagePanelList.find(function(p) { return p.deviceKey === activeUsageChipDeviceKey; });
                var name = panel ? (panel.groupName || panel.deviceKey) : activeUsageChipDeviceKey;
                $('#deviceFilterLabel').text(name + categoryLabel);
            }
        }

        function setupUsageFilterEvents() {
            $('#usageDeviceSearch').on('input', function() {
                clearTimeout(usageFilterDebounce);
                usageFilterDebounce = setTimeout(function() {
                    // Filter chips by search text
                    var search = $('#usageDeviceSearch').val().trim().toLowerCase();
                    $('#usageChipList').find('.panel-chip').each(function() {
                        var dk = $(this).attr('data-device-key');
                        if (dk === '__all__') { $(this).show(); return; }
                        var panel = usagePanelList.find(function(p) { return p.deviceKey === dk; });
                        var name = panel ? (panel.groupName || '').toLowerCase() : '';
                        if (!search || name.includes(search) || dk.toLowerCase().includes(search)) {
                            $(this).show();
                        } else {
                            $(this).hide();
                        }
                    });
                }, 200);
            });

            $('#usageCategoryFilter').on('change', function() {
                // If a specific device is selected and it doesn't match the new category, reset to all
                var category = $(this).val();
                if (activeUsageChipDeviceKey && category !== 'all') {
                    var panel = usagePanelList.find(function(p) { return p.deviceKey === activeUsageChipDeviceKey; });
                    var panelCategory = panel ? (panel.deviceCategory || usageDeviceCategoryMap[panel.deviceKey] || 'Billboard') : 'Billboard';
                    if (panelCategory !== category) {
                        activeUsageChipDeviceKey = null;
                        resetUsageComparisonState();
                        lastFinancialRefreshTime = 0;
                        updateDeviceFilterLabel();
                        loadData(true);
                    }
                }
                renderUsageChips();
            });

            $('#btnClearUsageFilter').on('click', function() {
                $('#usageDeviceSearch').val('');
                $('#usageCategoryFilter').val('all');
                activeUsageChipDeviceKey = null;
                resetUsageComparisonState();
                $('#usageChipList').find('.panel-chip').removeClass('active');
                $('#usageChipList').find('[data-device-key="__all__"]').addClass('active');
                $('#usageChipList').find('.panel-chip').show();
                updateDeviceFilterLabel();
                lastFinancialRefreshTime = 0;
                loadData(true);
            });
        }

        function fetchUsagePanelList() {
            $.ajax({
                url: '/api/Api/panels',
                method: 'GET',
                dataType: 'json',
                timeout: 10000,
                success: function(panels) {
                    var panelListWasEmpty = usagePanelList.length === 0;
                    usagePanelList = (panels || []).map(function(p) {
                        return {
                            deviceKey: p.deviceKey,
                            groupName: p.groupName,
                            deviceId: p.deviceId,
                            deviceCategory: p.deviceCategory || 'Billboard'
                        };
                    });
                    usagePanelListLoaded = true;
                    usagePanelListReady = true;
                    // Load device categories to ensure accurate filtering
                    loadUsageDeviceCategories();
                    if (panelListWasEmpty && activeUsageChipDeviceKey === null) {
                        if (usageCycleInProgress) usageRefreshPending = true;
                        else if (lastEnergyData) loadData(false);
                    }
                    if (usageInitialLoadPending) {
                        usageInitialLoadPending = false;
                        loadData(true);
                    }
                    if (comparisonLoadPending && usagePanelView === 'comparison') {
                        comparisonLoadPending = false;
                        loadUsageErpComparison();
                    }
                    else if (usagePanelView === 'comparison') {
                        loadUsageErpComparison();
                    }
                },
                error: function() {
                    usagePanelListLoaded = true;
                    usagePanelListReady = true;
                    if (usageInitialLoadPending) {
                        usageInitialLoadPending = false;
                        loadData(true);
                    }
                    if (comparisonLoadPending && usagePanelView === 'comparison') {
                        comparisonLoadPending = false;
                        loadUsageErpComparison();
                    }
                    else if (usagePanelView === 'comparison') {
                        $('#usageErpComparisonRows').html('<tr><td colspan="8" class="text-center text-danger py-3">Daftar perangkat tidak dapat dimuat.</td></tr>');
                    }
                    @* console.error('Error fetching panel list for usage filter'); *@
                }
            });
        }

        function loadUsageDeviceCategories() {
            $.ajax({
                url: '/api/Api/device-categories',
                method: 'GET',
                dataType: 'json',
                timeout: 10000,
                success: function(data) {
                    if (data.devices) {
                        usageDeviceCategoryMap = data.devices;
                        // Update panelList categories
                        usagePanelList.forEach(function(panel) {
                            if (usageDeviceCategoryMap[panel.deviceKey]) {
                                panel.deviceCategory = usageDeviceCategoryMap[panel.deviceKey];
                            }
                        });
                    }
                    // Populate category filter dropdown from API
                    populateUsageCategoryFilter();
                    renderUsageChips();
                    @* console.log('Usage device categories loaded:', usageDeviceCategoryMap); *@
                },
                error: function() {
                    renderUsageChips();
                    @* console.warn('Failed to load device categories for usage stats'); *@
                }
            });
        }

        function updateUsageAnomalyStatus() {
            // Ambil cooldown state langsung dari anomaly service (real-time)
            var cooldownState = (typeof window.getAnomalyCooldownState === 'function') 
                ? window.getAnomalyCooldownState() 
                : {};

            // Build deviceStatus from cooldown state (real-time, bukan database log)
            var deviceStatus = {};
            Object.keys(cooldownState).forEach(function(deviceKey) {
                if (cooldownState[deviceKey] && cooldownState[deviceKey].waitingForNormal) {
                    deviceStatus[deviceKey] = cooldownState[deviceKey].type; // 'OVERLOAD' or 'DROP'
                }
            });

            usageAnomalyStatusMap = {};
            usagePanelList.forEach(function(panel) {
                var status = deviceStatus[panel.deviceKey];
                if (status === 'OVERLOAD' || status === 'DROP') {
                    usageAnomalyStatusMap[panel.deviceKey] = status;
                }
            });
            renderUsageChips();
        }

        $(document).ready(function() {
            // Hide page-specific buttons not applicable to this page
            $('#btnRescan, #btnExport').hide();

            // Settings button
            $('#btnSettings').click(function() {
                window.location.href = '/Monitoring/Settings';
            });

            // Initialize device filter
            setupUsageFilterEvents();
            fetchUsagePanelList();
            updateUsageAnomalyStatus();

            // Real-time update saat cooldown state berubah (dari anomaly service)
            window.addEventListener('anomalyCooldownChanged', function(e) {
                @* console.log('🔄 Anomaly cooldown changed (usage stats):', e.detail); *@
                updateUsageAnomalyStatus();
            });

            updateDateInput();
            updateDayName();
            loadData(true);
            startAutoRefresh();

            $('#btnRefresh').click(function() {
                lastFinancialRefreshTime = 0;
                loadData(true);
            });

            $('#btnPrevDay').click(function() {
                selectedDate.setDate(selectedDate.getDate() - 1);
                resetUsageComparisonState();
                updateDateInput();
                updateDayName();
                lastFinancialRefreshTime = 0;
                loadData(true);
            });

            $('#btnNextDay').click(function() {
                selectedDate.setDate(selectedDate.getDate() + 1);
                resetUsageComparisonState();
                updateDateInput();
                updateDayName();
                lastFinancialRefreshTime = 0;
                loadData(true);
            });

            $('#btnToday').click(function() {
                selectedDate = new Date();
                resetUsageComparisonState();
                updateDateInput();
                updateDayName();
                lastFinancialRefreshTime = 0;
                loadData(true);
            });

            $('#filterDate').change(function() {
                var dateVal = $(this).val();
                if (dateVal) {
                    var parts = dateVal.split('-');
                    selectedDate = new Date(parts[0], parts[1] - 1, parts[2]);
                    resetUsageComparisonState();
                    updateDayName();
                    lastFinancialRefreshTime = 0;
                    loadData(true);
                }
            });
        });

        function updateDateInput() {
            var y = selectedDate.getFullYear();
            var m = String(selectedDate.getMonth() + 1).padStart(2, '0');
            var d = String(selectedDate.getDate()).padStart(2, '0');
            $('#filterDate').val(y + '-' + m + '-' + d);
        }

        function formatComparisonCurrency(value) {
            if (value === null || value === undefined) return '-';
            return 'Rp ' + Number(value || 0).toLocaleString('id-ID', { maximumFractionDigits: 0 });
        }

        function getUsageComparisonCacheKey(keys) {
            var dateKey = getUsageComparisonDateText();
            return 'comparison.' + dateKey + '.' + keys.slice().sort().join('|');
        }

        function getUsageComparisonDateText() {
            return selectedDate.getFullYear() + '-' + String(selectedDate.getMonth() + 1).padStart(2, '0') + '-' + String(selectedDate.getDate()).padStart(2, '0');
        }

        function getUsageComparisonRequestKey() {
            var keys = activeUsageChipDeviceKey
                ? [activeUsageChipDeviceKey]
                : (usagePanelList || []).map(function (panel) { return panel.deviceKey; });
            return getUsageComparisonDateText() + '|' + keys.slice().sort().join('|');
        }

        function getComparisonPeriodRow(item, period) {
            if (period === 'average') {
                var currentForAverage = item.currentMonth || {};
                var previousRows = (item.periods || []).filter(function (row) {
                    return row && !(Number(row.year) === Number(currentForAverage.year) && Number(row.month) === Number(currentForAverage.month));
                });
                var energyRows = previousRows.filter(function (row) { return row.energyKWh !== null && row.energyKWh !== undefined; });
                var average = item.averagePreviousThree || {};
                return {
                    energyKWh: energyRows.length
                        ? energyRows.reduce(function (total, row) { return total + Number(row.energyKWh || 0); }, 0) / energyRows.length
                        : null,
                    estimatedCost: average.estimatedCost,
                    actualCost: average.actualCost,
                    comparisonCost: average.comparisonCost,
                    actualMonthCount: average.actualMonthCount || 0,
                    status: 'Rata-rata 3 bulan',
                    paymentPeriod: null
                };
            }
            var current = item.currentMonth;
            if (!current) return null;
            var offset = { current: 0, previous: -1, twoMonthsAgo: -2, threeMonthsAgo: -3 }[period];
            if (offset === undefined) offset = 0;
            var target = new Date(Number(current.year), Number(current.month) - 1, 1);
            target.setMonth(target.getMonth() + offset);
            return (item.periods || []).filter(function (row) {
                return Number(row.year) === target.getFullYear() && Number(row.month) === target.getMonth() + 1;
            })[0] || null;
        }

        function getUsageComparisonDifference(row) {
            var estimatedCost = row && row.estimatedCost !== null && row.estimatedCost !== undefined
                ? Number(row.estimatedCost)
                : null;
            var actualCost = row && row.actualCost !== null && row.actualCost !== undefined
                ? Number(row.actualCost)
                : null;

            if (estimatedCost === null || actualCost === null || !isFinite(estimatedCost) || !isFinite(actualCost)) {
                return { available: false, difference: null, percent: null };
            }

            var difference = actualCost - estimatedCost;
            return {
                available: true,
                difference: difference,
                percent: estimatedCost === 0 ? null : (difference / estimatedCost * 100)
            };
        }

        function renderUsageComparison(response, period, fromCache) {
            if (!response || !Array.isArray(response.rows)) return;
            comparisonResponse = response;
            comparisonPeriod = period || comparisonPeriod;
            var html = '';
            var averageText = [];
            var periodLabels = { current: 'Bulan ini', previous: 'Bulan lalu', twoMonthsAgo: '2 bulan lalu', threeMonthsAgo: '3 bulan lalu', average: 'Rata-rata 3 bulan' };
            response.rows.forEach(function (item) {
                var selected = getComparisonPeriodRow(item, comparisonPeriod);
                if (!selected) return;
                var isAverage = comparisonPeriod === 'average';
                var device = (usagePanelList || []).filter(function (panel) { return panel.deviceKey === item.deviceKey; })[0];
                var label = device ? (device.groupName || device.deviceId || item.deviceKey) : item.deviceKey;
                var actualCost = selected.actualCost;
                var status = isAverage ? 'Rata-rata 3 bulan' : (selected.status || 'Estimasi saja');
                var comparison = getUsageComparisonDifference(selected);
                var difference = comparison.difference;
                var differencePercent = comparison.percent;
                var differenceClass = !comparison.available || difference === 0
                    ? 'text-muted'
                    : (difference > 0 ? 'text-danger' : 'text-success');
                var actualText = actualCost === null || actualCost === undefined
                    ? '<span class="text-muted">Belum tersedia</span>'
                    : formatComparisonCurrency(actualCost);
                var paymentText = selected.paymentPeriod || (isAverage
                    ? 'Gabungan ' + (selected.actualMonthCount || 0) + '/3 bulan'
                    : 'Belum ada bukti ERP');
                var differenceText = !comparison.available
                    ? '<span class="text-muted">Belum tersedia</span>'
                    : formatComparisonCurrency(difference) + ' (' + (differencePercent === null
                        ? 'persentase tidak tersedia'
                        : differencePercent.toLocaleString('id-ID', { maximumFractionDigits: 1 }) + '%') + ')';
                html += '<tr>' +
                    '<td><strong>' + escapeHtml(label) + '</strong></td>' +
                    '<td>' + escapeHtml(isAverage ? periodLabels.average : (selected.label || selected.period)) + '</td>' +
                    '<td class="text-right">' + (selected.energyKWh === null || selected.energyKWh === undefined ? '<span class="text-muted">Belum tersedia</span>' : Number(selected.energyKWh).toLocaleString('id-ID', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' kWh') + '</td>' +
                    '<td class="text-right">' + formatComparisonCurrency(selected.estimatedCost) + '</td>' +
                    '<td class="text-right">' + actualText + '</td>' +
                    '<td><span class="badge ' + (status === 'Aktual ERP' ? 'badge-success' : (isAverage ? 'badge-info' : 'badge-warning')) + '">' + escapeHtml(status) + '</span></td>' +
                    '<td>' + escapeHtml(paymentText) + '</td>' +
                    '<td class="text-right ' + differenceClass + '">' + differenceText + '</td>' +
                    '</tr>';
                if (isAverage) {
                    averageText.push('<strong>' + escapeHtml(label) + '</strong>: estimasi ' + formatComparisonCurrency(selected.estimatedCost) +
                        ', tagihan ERP tersedia ' + (selected.actualCost === null || selected.actualCost === undefined ? 'belum ada' : formatComparisonCurrency(selected.actualCost)) +
                        ' dari ' + (selected.actualMonthCount || 0) + '/3 bulan');
                }
            });
            $('#usageErpComparisonRows').html(html || '<tr><td colspan="8" class="text-center text-muted py-3">Belum ada data energi.</td></tr>');
            $('#usageErpComparisonAverage').html(comparisonPeriod === 'average'
                ? averageText.join('<br>')
                : 'Perkiraan tagihan dihitung dari kWh × tarif perangkat. Perbandingan pada setiap filter menggunakan estimasi periode tersebut dibandingkan tagihan aktual ERP pada periode yang sama.');
            $('#usageRankingCaption').text('Periode: ' + periodLabels[comparisonPeriod] + (fromCache ? ' · cache terakhir (offline)' : ' · diperbarui ' + new Date().toLocaleTimeString('id-ID')));
            $('.usage-comparison-period').removeClass('btn-primary').addClass('btn-outline-primary');
            $('.usage-comparison-period[data-period="' + comparisonPeriod + '"]').removeClass('btn-outline-primary').addClass('btn-primary');
        }

        function loadUsageErpComparison() {
            var keys = activeUsageChipDeviceKey
                ? [activeUsageChipDeviceKey]
                : (usagePanelList || []).map(function (panel) { return panel.deviceKey; });
            if (!keys.length && !usagePanelListLoaded) {
                comparisonLoadPending = true;
                $('#usageErpComparisonRows').html('<tr><td colspan="8" class="text-center text-muted py-3"><i class="fas fa-spinner fa-spin"></i> Menyiapkan daftar perangkat...</td></tr>');
                return;
            }
            if (!keys.length) {
                $('#usageErpComparisonRows').html('<tr><td colspan="8" class="text-center text-muted py-3">Belum ada perangkat untuk dibandingkan.</td></tr>');
                return;
            }
            var requestKey = getUsageComparisonRequestKey();
            if (comparisonRequestInProgress && comparisonRequestKey === requestKey) return;
            if (comparisonRequestInProgress && comparisonXhr && comparisonXhr.readyState !== 4) {
                comparisonXhr.abort();
            }
            comparisonRequestInProgress = true;
            comparisonRequestKey = requestKey;
            comparisonLoadPending = false;
            $('#usageErpComparisonRows').html('<tr><td colspan="8" class="text-center text-muted py-3"><i class="fas fa-spinner fa-spin"></i> Memuat perbandingan...</td></tr>');
            var cacheKey = getUsageComparisonCacheKey(keys);
            var cached = readUsageCache(cacheKey);
            if (cached && cached.success !== false && Array.isArray(cached.rows)) {
                comparisonResponseKey = requestKey;
                renderUsageComparison(cached, comparisonPeriod, true);
            }
            comparisonXhr = $.ajax({
                url: '/api/Api/usage-cost-comparison', method: 'POST', contentType: 'application/json', dataType: 'json', timeout: 15000,
                data: JSON.stringify({ deviceKeys: keys, startDate: getUsageComparisonDateText() })
            }).done(function (response) {
                if (!response || response.success === false || !Array.isArray(response.rows)) throw new Error('Invalid comparison response');
                if (requestKey !== getUsageComparisonRequestKey()) return;
                writeUsageCache(cacheKey, response);
                comparisonResponseKey = requestKey;
                renderUsageComparison(response, comparisonPeriod, false);
            }).fail(function () {
                if (requestKey !== getUsageComparisonRequestKey()) return;
                if (!cached) $('#usageErpComparisonRows').html('<tr><td colspan="8" class="text-center text-muted py-3">Perbandingan belum tersedia.</td></tr>');
                $('#usageRankingCaption').text(cached ? 'Database/ERP offline · menampilkan cache terakhir' : 'Database/ERP belum tersedia');
            }).always(function () {
                if (comparisonRequestKey === requestKey) {
                    comparisonRequestInProgress = false;
                    comparisonXhr = null;
                }
            });
        }

        $(document).on('click', '.usage-comparison-period', function () {
            comparisonPeriod = $(this).data('period');
            if (comparisonResponse && comparisonResponseKey === getUsageComparisonRequestKey()) renderUsageComparison(comparisonResponse, comparisonPeriod, false);
            else loadUsageErpComparison();
        });

        function updateDayName() {
            var days = ['Minggu', 'Senin', 'Selasa', 'Rabu', 'Kamis', 'Jumat', 'Sabtu'];
            var months = ['Januari', 'Februari', 'Maret', 'April', 'Mei', 'Juni', 'Juli', 'Agustus', 'September', 'Oktober', 'November', 'Desember'];

            var dayName = days[selectedDate.getDay()];
            var dateStr = selectedDate.getDate() + ' ' + months[selectedDate.getMonth()] + ' ' + selectedDate.getFullYear();

            var today = new Date();
            var isToday = selectedDate.toDateString() === today.toDateString();

            $('#selectedDayName').text(dayName + ' - ' + dateStr + (isToday ? ' (Hari Ini)' : ''));
        }

        function startAutoRefresh() {
            if (refreshTimer) { clearInterval(refreshTimer); refreshTimer = null; }
            if (refreshWatcherId && window.RealtimeRefresh) {
                window.RealtimeRefresh.unwatch(refreshWatcherId);
                refreshWatcherId = null;
            }

            var refreshUsage = function() {
                loadData(false);
            };

            // Utama: muat ulang statistik begitu ada data KWH / agregasi energi baru.
            if (window.RealtimeRefresh) {
                refreshWatcherId = window.RealtimeRefresh.watch(
                    ['kwh', 'energy', 'anomaly'],
                    refreshUsage,
                    { throttleMs: 5000 }
                );
                return;
            }

            // Fallback: skema interval lama bila script realtime tidak termuat.
            refreshTimer = setInterval(refreshUsage, 10000);
        }

        function loadData(forceRestart) {
            forceRestart = forceRestart !== false;
            // Kirim daftar device ke endpoint batch terlebih dahulu. Tanpa ini,
            // request awal akan memindai seluruh tabel untuk semua perangkat.
            if (!activeUsageChipDeviceKey && !usagePanelListReady) {
                usageInitialLoadPending = true;
                $('#statusText').text('Menyiapkan daftar perangkat...');
                return;
            }
            // Coalesce realtime events while the base response and financial requests are active.
            // Explicit filter changes take priority and cancel work for the previous filter.
            if (!forceRestart && usageCycleInProgress) {
                usageRefreshPending = true;
                return;
            }
            var requestSequence = ++usageLoadSequence;
            if (forceRestart) {
                usageRefreshPending = false;
                if (usageDataRequest && usageDataRequest.readyState !== 4) usageDataRequest.abort();
                var requestsToAbort = usageFallbackRequests.slice();
                usageFallbackRequests = [];
                requestsToAbort.forEach(function(request) {
                    if (request && request.readyState !== 4) request.abort();
                });
            }
            usageCycleInProgress = true;
            $('#statusText').text('Memperbarui...');
            $('#lastUpdate').text('Memperbarui data...');
            var selectedDateText = selectedDate.getFullYear() + '-' + String(selectedDate.getMonth() + 1).padStart(2, '0') + '-' + String(selectedDate.getDate()).padStart(2, '0');

            var isAllDevicesRequest = !activeUsageChipDeviceKey;
            var useBatchEndpoint = usageStatisticsBatchEnabled;
            var baseUrl = useBatchEndpoint
                ? '/api/Api/usage-statistics/batch'
                : (isAllDevicesRequest
                    ? '/api/Api/usage-statistics'
                    : '/api/Api/usage-statistics/' + encodeURIComponent(activeUsageChipDeviceKey));
            var requestData = { startDate: selectedDateText, endDate: selectedDateText };
            if (useBatchEndpoint) {
                if (isAllDevicesRequest) requestData.deviceKeys = usagePanelList.map(function(panel) { return panel.deviceKey; });
                else requestData.deviceKey = activeUsageChipDeviceKey;
            }
            var request = $.ajax({
                url: baseUrl,
                method: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(requestData),
                dataType: 'json',
                timeout: 60000,
                success: function(data) {
                    if (requestSequence !== usageLoadSequence) return;
                    if (useBatchEndpoint) {
                        if (!data || data.success === false || !data.summary) {
                            if (isAllDevicesRequest) loadLegacyUsageSummary(requestSequence, selectedDateText);
                            else loadLegacySingleDeviceUsage(requestSequence, selectedDateText, activeUsageChipDeviceKey);
                            return;
                        }
                        updateUI(data.summary);
                        var batchAggregateAt = data.latestAggregateAt
                            ? new Date(data.latestAggregateAt).toLocaleString('id-ID')
                            : null;
                        lastSuccessfulUsageUpdate = batchAggregateAt || '';
                        $('#lastUpdate').text(batchAggregateAt ? 'Agregat terakhir ' + batchAggregateAt : 'Belum ada waktu agregasi');
                        $('#statusText').text('Online');
                        // Energi utama sudah tampil. Jangan menahan realtime refresh
                        // hanya karena analisis finansial masih diproses.
                        finishUsageCycle(requestSequence);
                        var batchDeviceResults = Array.isArray(data.devices)
                            ? data.devices.filter(function(device) { return device && device.success !== false; })
                            : [];
                        if (batchDeviceResults.length > 0) {
                            var financialData = isAllDevicesRequest
                                ? aggregateFinancialData(batchDeviceResults)
                                : buildSingleDeviceFinancialData(batchDeviceResults[0]);
                            updateFinancialUI(financialData, requestSequence, batchAggregateAt || 'Waktu agregasi tidak tersedia');
                            if (batchAggregateAt) {
                                lastSuccessfulFinancialUpdate = batchAggregateAt;
                                $('#lastUpdate').text('Data agregat terakhir ' + batchAggregateAt);
                            }
                            var expectedDeviceCount = isAllDevicesRequest ? (usagePanelList || []).length : 1;
                            if (batchDeviceResults.length < expectedDeviceCount) {
                                $('#lastUpdate').text('Analisis finansial parsial (' + batchDeviceResults.length + '/' + expectedDeviceCount + ' perangkat)');
                            } else if (Array.isArray(data.noAggregateDeviceKeys) && data.noAggregateDeviceKeys.length > 0) {
                                $('#lastUpdate').text((batchAggregateAt ? 'Data agregat terakhir ' + batchAggregateAt : 'Waktu agregasi tidak tersedia') +
                                    ' · belum ada agregat untuk ' + data.noAggregateDeviceKeys.length + ' perangkat');
                            }
                        } else {
                            showUsageCostUnavailable();
                            $('#statusText').text('Grafik dimuat; analisis finansial perangkat gagal dihitung');
                        }
                        return;
                    }
                    if (isAllDevicesRequest) {
                        if (!data || data.success === false || data.totalToday == null || !Array.isArray(data.hourlyData)) {
                            showUsageCostUnavailable();
                            $('#statusText').text('Pembaruan gagal');
                            finishUsageCycle(requestSequence);
                            return;
                        }
                        updateUI(data);
                        lastSuccessfulUsageUpdate = data.latestAggregateAt
                            ? new Date(data.latestAggregateAt).toLocaleString('id-ID')
                            : (data.serverTime ? new Date(data.serverTime).toLocaleString('id-ID') : new Date().toLocaleString('id-ID'));
                        $('#statusText').text('Grafik diperbarui; analisis finansial memuat dari perangkat');
                        $('#lastUpdate').text(data.latestAggregateAt
                            ? 'Agregat energi mode lama · ' + lastSuccessfulUsageUpdate
                            : 'Mode endpoint lama · waktu sumber tidak tersedia');
                        finishUsageCycle(requestSequence);
                        loadLegacyDeviceFinancial(requestSequence, selectedDateText);
                        return;
                    }
                    // Save per-device financial data before normalization
                    var perDeviceDataUpdatedAt = data.dataUpdatedAt;
                    var deviceFinancialData = null;
                    if (activeUsageChipDeviceKey && data.today) {
                        deviceFinancialData = buildSingleDeviceFinancialData(data);
                        // Normalize per-device response to match aggregate format
                        data = {
                            totalToday: data.today.total,
                            avgPerHour: data.today.avgPerHour,
                            peakHour: data.today.peakHour,
                            peakHourTime: data.today.peakHourTime,
                            totalThisMonth: data.month.total,
                            avgPerDay: data.month.avgPerDay,
                            peakDay: data.month.peakDay,
                            peakDayDate: data.month.peakDayDate,
                            totalThisYear: data.year.total,
                            avgPerMonth: data.year.avgPerMonth,
                            peakMonth: data.year.peakMonth,
                            peakMonthName: data.year.peakMonthName,
                            hourlyData: data.today.hourlyData,
                            dailyData: data.month.dailyData,
                            monthlyData: data.year.monthlyData,
                            tariffPerKWh: data.tariffPerKWh,
                            estimatedCost: data.estimatedCost,
                            realtimeKWh: data.realtimeKWh,
                            currentHourLabel: data.currentHourLabel,
                            secondsToNextHour: data.secondsToNextHour,
                            isToday: data.isToday
                        };
                    }
                    updateUI(data);
                    var perDeviceUpdatedAt = perDeviceDataUpdatedAt ? new Date(perDeviceDataUpdatedAt) : null;
                    lastSuccessfulUsageUpdate = perDeviceUpdatedAt && !isNaN(perDeviceUpdatedAt.getTime())
                        ? perDeviceUpdatedAt.toLocaleString('id-ID')
                        : new Date().toLocaleString('id-ID');
                    $('#lastUpdate').text(lastSuccessfulUsageUpdate);
                    $('#statusText').text('Online');

                    // Update financial analysis — derived from per-device data
                    if (deviceFinancialData) {
                        // Single device selected: use its financial data directly
                        updateFinancialUI(deviceFinancialData, requestSequence, lastSuccessfulUsageUpdate);
                        finishUsageCycle(requestSequence);
                    } else {
                        showUsageCostUnavailable();
                        finishUsageCycle(requestSequence);
                    }
                },
                error: function(xhr, textStatus, errorThrown) {
                    if (requestSequence !== usageLoadSequence || textStatus === 'abort') return;
                    if (useBatchEndpoint && textStatus !== 'timeout') {
                        if (isAllDevicesRequest) loadLegacyUsageSummary(requestSequence, selectedDateText);
                        else loadLegacySingleDeviceUsage(requestSequence, selectedDateText, activeUsageChipDeviceKey);
                        return;
                    }
                    @* console.error('Usage statistics request failed:', {
                        httpStatus: xhr.status,
                        status: textStatus,
                        error: errorThrown || null,
                        response: xhr.responseText || null
                    }); *@
                    $('#statusText').text('Offline');
                    $('#lastUpdate').text('Pembaruan gagal' + (lastSuccessfulUsageUpdate ? ' · data sebelumnya ' + lastSuccessfulUsageUpdate : ' · belum ada data'));
                    finishUsageCycle(requestSequence);
                },
                complete: function() {
                    if (usageDataRequest === request) usageDataRequest = null;
                }
            });
            usageDataRequest = request;
        }

        function finishUsageCycle(requestSequence) {
            if (requestSequence !== usageLoadSequence) return;
            usageCycleInProgress = false;
            if (usageRefreshPending) {
                usageRefreshPending = false;
                loadData(false);
            }
        }

        function loadLegacySingleDeviceUsage(requestSequence, selectedDateText, deviceKey) {
            var fallbackRequest = $.ajax({
                url: '/api/Api/usage-statistics/' + encodeURIComponent(deviceKey),
                method: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({ startDate: selectedDateText, endDate: selectedDateText }),
                dataType: 'json',
                timeout: 15000,
                success: function(deviceData) {
                    if (requestSequence !== usageLoadSequence) return;
                    if (!deviceData || deviceData.success === false || !deviceData.today || !deviceData.month || !deviceData.year) {
                        showUsageCostUnavailable();
                        $('#statusText').text('Pembaruan perangkat gagal');
                        finishUsageCycle(requestSequence);
                        return;
                    }

                    var aggregateAt = deviceData.dataUpdatedAt
                        ? new Date(deviceData.dataUpdatedAt).toLocaleString('id-ID')
                        : null;
                    var summary = {
                        totalToday: deviceData.today.total,
                        avgPerHour: deviceData.today.avgPerHour,
                        peakHour: deviceData.today.peakHour,
                        peakHourTime: deviceData.today.peakHourTime,
                        totalThisMonth: deviceData.month.total,
                        avgPerDay: deviceData.month.avgPerDay,
                        peakDay: deviceData.month.peakDay,
                        peakDayDate: deviceData.month.peakDayDate,
                        totalThisYear: deviceData.year.total,
                        avgPerMonth: deviceData.year.avgPerMonth,
                        peakMonth: deviceData.year.peakMonth,
                        peakMonthName: deviceData.year.peakMonthName,
                        hourlyData: deviceData.today.hourlyData || [],
                        dailyData: deviceData.month.dailyData || [],
                        monthlyData: deviceData.year.monthlyData || [],
                        realtimeKWh: deviceData.realtimeKWh,
                        currentHourLabel: deviceData.currentHourLabel,
                        secondsToNextHour: deviceData.secondsToNextHour,
                        isToday: deviceData.isToday,
                        serverDate: deviceData.serverDate,
                        serverHour: deviceData.serverHour,
                        serverDay: deviceData.serverDay,
                        serverMonth: deviceData.serverMonth
                    };
                    updateUI(summary);
                    lastSuccessfulUsageUpdate = aggregateAt || '';
                    updateFinancialUI(
                        buildSingleDeviceFinancialData(deviceData),
                        requestSequence,
                        aggregateAt || 'Waktu agregasi tidak tersedia'
                    );
                    $('#statusText').text('Mode pemulihan perangkat aktif');
                    $('#lastUpdate').text(aggregateAt
                        ? 'Agregat perangkat ' + aggregateAt
                        : 'Data perangkat tampil; waktu agregasi tidak tersedia');
                    finishUsageCycle(requestSequence);
                },
                error: function(xhr, textStatus) {
                    if (requestSequence !== usageLoadSequence || textStatus === 'abort') return;
                    showUsageCostUnavailable();
                    $('#statusText').text('Pembaruan perangkat gagal');
                    $('#lastUpdate').text('Pembaruan gagal' + (lastSuccessfulUsageUpdate ? ' · data sebelumnya ' + lastSuccessfulUsageUpdate : ' · belum ada data'));
                    finishUsageCycle(requestSequence);
                },
                complete: function() {
                    if (usageDataRequest === fallbackRequest) usageDataRequest = null;
                }
            });
            usageDataRequest = fallbackRequest;
        }

        function buildSingleDeviceFinancialData(data) {
            var devTariff = data.tariffPerKWh || 1500;
            if (data.wbpLwbp && data.wbpLwbp.configured && data.wbpLwbp.tariffWBP > 0 && data.wbpLwbp.tariffLWBP > 0) {
                var wbpKwh = data.wbpLwbp.wbpKWh || 0;
                var lwbpKwh = data.wbpLwbp.lwbpKWh || 0;
                var wbpTariff = data.wbpLwbp.tariffWBP || 0;
                var lwbpTariff = data.wbpLwbp.tariffLWBP || 0;
                var totalKwh = wbpKwh + lwbpKwh;
                devTariff = totalKwh > 0
                    ? Math.round((wbpKwh * wbpTariff + lwbpKwh * lwbpTariff) / totalKwh)
                    : Math.round((wbpTariff + lwbpTariff) / 2);
            }
            var devEstimatedCost = (data.budget && data.budget.actualCost) || 0;
            if (devEstimatedCost === 0 && data.month) {
                devEstimatedCost = Math.round((data.month.total || 0) * devTariff);
            }
            return {
                wbpLwbp: data.wbpLwbp || {},
                waste: data.waste || {},
                budget: data.budget || {},
                periodComparison: data.periodComparison || {},
                billProjection: data.billProjection || {},
                anomalyCostImpact: data.anomalyCostImpact || {},
                loadFactorInfo: data.loadFactorInfo || {},
                unitEconomics: data.unitEconomics || {},
                tariffTypeInfo: {
                    wbpDeviceCount: (data.wbpLwbp && data.wbpLwbp.configured) ? 1 : 0,
                    flatDeviceCount: (data.wbpLwbp && !data.wbpLwbp.configured) ? 1 : 0,
                    flatKWh: (data.wbpLwbp && !data.wbpLwbp.configured) ? ((data.month && data.month.total) || 0) : 0,
                    flatCost: (data.wbpLwbp && !data.wbpLwbp.configured) ? ((data.budget && data.budget.actualCost) || 0) : 0,
                    totalDeviceCount: 1
                },
                avgTariffPerKWh: devTariff,
                totalEstimatedCost: devEstimatedCost
            };
        }

        function loadLegacyUsageSummary(requestSequence, selectedDateText) {
            var fallbackRequest = $.ajax({
                url: '/api/Api/usage-statistics',
                method: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({ startDate: selectedDateText, endDate: selectedDateText }),
                dataType: 'json',
                timeout: 60000,
                success: function(data) {
                    if (requestSequence !== usageLoadSequence) return;
                    updateUI(data);
                    lastSuccessfulUsageUpdate = data.latestAggregateAt
                        ? new Date(data.latestAggregateAt).toLocaleString('id-ID')
                        : (data.serverTime ? new Date(data.serverTime).toLocaleString('id-ID') : new Date().toLocaleString('id-ID'));
                    $('#statusText').text('Grafik diperbarui; memulihkan analisis finansial');
                    $('#lastUpdate').text(data.latestAggregateAt
                        ? 'Agregat energi mode pemulihan · ' + lastSuccessfulUsageUpdate
                        : 'Ringkasan energi mode pemulihan · waktu sumber tidak tersedia');
                    loadLegacyDeviceFinancial(requestSequence, selectedDateText);
                },
                error: function(xhr, textStatus) {
                    if (requestSequence !== usageLoadSequence || textStatus === 'abort') return;
                    $('#statusText').text('Offline');
                    $('#lastUpdate').text('Pembaruan gagal' + (lastSuccessfulUsageUpdate ? ' · data sebelumnya ' + lastSuccessfulUsageUpdate : ' · belum ada data'));
                    showUsageCostUnavailable();
                    finishUsageCycle(requestSequence);
                },
                complete: function() {
                    if (usageDataRequest === fallbackRequest) usageDataRequest = null;
                }
            });
            usageDataRequest = fallbackRequest;
        }

        function loadLegacyDeviceFinancial(requestSequence, selectedDateText) {
            var panels = (usagePanelList || []).slice();
            if (panels.length === 0) {
                showUsageCostUnavailable();
                $('#statusText').text('Grafik diperbarui; perangkat finansial belum tersedia');
                finishUsageCycle(requestSequence);
                return;
            }

            var pendingPanels = panels.slice();
            var deviceResults = [];
            var completedCount = 0;
            var activeCount = 0;
            var maxConcurrentRequests = 6;

            function finishFallback() {
                if (requestSequence !== usageLoadSequence) return;
                if (deviceResults.length > 0) {
                    var aggregated = aggregateFinancialData(deviceResults);
                    var sourceTimes = deviceResults.map(function(device) {
                        var value = device.dataUpdatedAt ? new Date(device.dataUpdatedAt) : null;
                        return value && !isNaN(value.getTime()) ? value.getTime() : null;
                    }).filter(function(value) { return value != null; });
                    var sourceUpdatedAt = sourceTimes.length > 0
                        ? new Date(Math.min.apply(null, sourceTimes)).toLocaleString('id-ID')
                        : new Date().toLocaleString('id-ID');
                    updateFinancialUI(aggregated, requestSequence, sourceUpdatedAt);
                    lastSuccessfulFinancialUpdate = sourceUpdatedAt;
                    var hasFailures = deviceResults.length < panels.length;
                    $('#statusText').text(hasFailures
                        ? 'Mode pemulihan aktif; analisis finansial parsial'
                        : 'Mode pemulihan aktif; analisis finansial diperbarui');
                    $('#lastUpdate').text('Data finansial fallback · ' + sourceUpdatedAt +
                        (hasFailures ? ' · ' + deviceResults.length + '/' + panels.length + ' perangkat' : ''));
                } else {
                    showUsageCostUnavailable();
                    $('#statusText').text('Grafik diperbarui; analisis finansial gagal dipulihkan');
                }
                finishUsageCycle(requestSequence);
            }

            function pumpFallbackRequests() {
                if (requestSequence !== usageLoadSequence) return;
                while (activeCount < maxConcurrentRequests && pendingPanels.length > 0) {
                    let panel = pendingPanels.shift();
                    activeCount++;
                    let deviceRequest;
                    deviceRequest = $.ajax({
                        url: '/api/Api/usage-statistics/' + encodeURIComponent(panel.deviceKey),
                        method: 'POST',
                        contentType: 'application/json',
                        data: JSON.stringify({ startDate: selectedDateText, endDate: selectedDateText }),
                        dataType: 'json',
                        timeout: 15000,
                        success: function(data) {
                            if (requestSequence === usageLoadSequence && data && data.success !== false) {
                                deviceResults.push(data);
                            }
                        },
                        complete: function() {
                            var requestIndex = usageFallbackRequests.indexOf(deviceRequest);
                            if (requestIndex >= 0) usageFallbackRequests.splice(requestIndex, 1);
                            activeCount--;
                            completedCount++;
                            if (requestSequence !== usageLoadSequence) return;
                            if (completedCount === panels.length) finishFallback();
                            else pumpFallbackRequests();
                        }
                    });
                    usageFallbackRequests.push(deviceRequest);
                }
            }

            pumpFallbackRequests();
        }

        function updateUI(data) {
            lastEnergyData = data;

            var selectedIsToday = data.isToday === true;
            var monthLabel = selectedDate.toLocaleDateString('id-ID', { month: 'long', year: 'numeric' });
            $('#usageTodayLabel').text(selectedIsToday ? 'Hari Ini' : selectedDate.toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' }));
            $('#usageMonthLabel').text(monthLabel);
            $('#usageYearLabel').text('Tahun ' + selectedDate.getFullYear());
            $('#usageCostLabel').text('Estimasi Biaya · ' + monthLabel);

            // Calculate real-time averages (exclude empty/zero data)
            var hourlyData = (data.hourlyData || []).sort((a, b) => a.sortKey - b.sortKey);
            var dailyData = (data.dailyData || []).sort((a, b) => a.sortKey - b.sortKey);
            var monthlyData = (data.monthlyData || []).sort((a, b) => a.sortKey - b.sortKey);

            var hoursInPeriod = selectedIsToday ? Math.max(1, Number(data.serverHour || 0) + 1) : 24;
            var daysInPeriod = selectedIsToday ? Number(data.serverDay || selectedDate.getDate()) : new Date(selectedDate.getFullYear(), selectedDate.getMonth() + 1, 0).getDate();
            var monthsInPeriod = selectedIsToday ? Number(data.serverMonth || (selectedDate.getMonth() + 1)) : 12;
            var rtAvgPerHour = Number(data.totalToday || 0) / hoursInPeriod;
            var rtAvgPerDay = Number(data.totalThisMonth || 0) / Math.max(1, daysInPeriod);
            var rtAvgPerMonth = Number(data.totalThisYear || 0) / Math.max(1, monthsInPeriod);

            // Update summary cards
            $('#usageToday').text(formatDecimal(data.totalToday) + ' kWh');
            $('#usageTodayAvg').text(formatDecimal(rtAvgPerHour));
            $('#usageMonth').text(formatDecimal(data.totalThisMonth) + ' kWh');
            $('#usageMonthAvg').text(formatDecimal(rtAvgPerDay));
            $('#usageYear').text(formatDecimal(data.totalThisYear) + ' kWh');
            $('#usageYearAvg').text(formatDecimal(rtAvgPerMonth));
            // Cost and tariff are supplied only by the per-device financial requests.
            if (!lastFinancialData) {
                $('#usageCost').text('Memuat...');
                $('#tariffDisplay').text('Memuat...');
            }

            // Update peak info
            $('#peakHourValue').text(formatDecimal(data.peakHour) + ' kWh');
            $('#peakHourTime').text(data.peakHourTime);
            $('#peakDayValue').text(formatDecimal(data.peakDay) + ' kWh');
            $('#peakDayDate').text(data.peakDayDate);
            $('#peakMonthValue').text(formatDecimal(data.peakMonth) + ' kWh');
            $('#peakMonthName').text(data.peakMonthName);

            // Update charts
            updateCharts(data);
        }

        function calcAvg(arr) {
            var filled = arr.filter(x => x.energy > 0);
            if (filled.length === 0) return 0;
            return filled.reduce((s, x) => s + x.energy, 0) / filled.length;
        }

        function makeAvgLine(arr, avg) {
            return arr.map(d => d.energy > 0 ? avg : null);
        }

