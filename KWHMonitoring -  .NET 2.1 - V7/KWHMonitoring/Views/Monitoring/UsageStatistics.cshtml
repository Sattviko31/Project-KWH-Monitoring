            // Load Factor
            html += '<div class="fin-metric"><div class="fin-metric-label"><i class="fas fa-tachometer-alt text-warning"></i> Faktor Beban</div>';
            if (lf.configured) {
                var lfCls = lf.loadFactor > 80 ? 'text-danger' : (lf.loadFactor < 30 ? 'text-warning' : 'text-success');
                html += '<div class="fin-metric-value ' + lfCls + '">' + (lf.loadFactor || 0).toFixed(1) + '%</div>';
                html += '<div class="fin-metric-sub">' + (lf.status || 'N/A') + '</div></div>';
            } else {
                html += '<div class="fin-metric-value text-muted">—</div>';
                html += '<div class="fin-metric-sub">Belum dikonfigurasi</div></div>';
            }

            html += '</div>';

            // Monthly insights
            html += '<div class="daily-report-insights">';
            html += '<div class="text-muted mb-1" style="font-size:0.7rem"><i class="fas fa-lightbulb"></i> WAWASAN BULANAN</div>';
            var insights = [];

            // MoM
            if (pc.momChangePercent !== undefined && pc.lastMonthKWh > 0) {
                var momArr = pc.momChangePercent > 0 ? '▲' : '▼';
                var momCls = pc.momChangePercent > 10 ? 'text-danger' : (pc.momChangePercent < -10 ? 'text-success' : '');
                insights.push('<span class="' + momCls + '">' + momArr + ' Perubahan bulanan sebesar ' + Math.abs(pc.momChangePercent).toFixed(1) + '% dibandingkan dengan bulan sebelumnya (' + formatDecimal(pc.lastMonthKWh) + ' kWh)</span>');
            }

            // YoY
            if (pc.yoyChangePercent !== undefined && pc.lastYearSameMonthKWh > 0) {
                var yoyArr = pc.yoyChangePercent > 0 ? '▲' : '▼';
                var yoyCls = pc.yoyChangePercent > 20 ? 'text-danger' : (pc.yoyChangePercent < -20 ? 'text-success' : '');
                insights.push('<span class="' + yoyCls + '">' + yoyArr + ' Perubahan tahunan sebesar ' + Math.abs(pc.yoyChangePercent).toFixed(1) + '% dibandingkan dengan bulan yang sama pada tahun sebelumnya (' + formatDecimal(pc.lastYearSameMonthKWh) + ' kWh)</span>');
            }

            // WBP/LWBP
            if (wbpLwbp.configured) {
                var wbpTotal = wbpLwbp.wbpKwh + wbpLwbp.lwbpKwh;
                if (wbpTotal > 0) {
                    var wbpRatio = (wbpLwbp.wbpKwh / wbpTotal * 100).toFixed(1);
                    insights.push(' WBP ' + wbpRatio + '% (' + formatDecimal(wbpLwbp.wbpKwh) + ' kWh) · LWBP ' + (100 - parseFloat(wbpRatio)).toFixed(1) + '% (' + formatDecimal(wbpLwbp.lwbpKwh) + ' kWh) · Total Rp ' + formatInteger(wbpLwbp.totalCostWBP || 0));
                }
            }

            // Pemborosan energi
            if (waste.configured && waste.wastePercent > 0) {
                if (waste.wastePercent > 5) {
                    insights.push('<span class="text-danger"> Pemborosan energi ' + waste.wastePercent.toFixed(1) + '% = ' + formatDecimal(waste.wasteKwh) + ' kWh (Rp ' + formatInteger(waste.wasteCost) + ') — waktu henti ' + (waste.downtimeStart || '') + '-' + (waste.downtimeEnd || '') + '.</span>');
                } else {
                    insights.push(' Pemborosan energi ' + waste.wastePercent.toFixed(1) + '% = ' + formatDecimal(waste.wasteKwh) + ' kWh (Rp ' + formatInteger(waste.wasteCost) + ').');
                }
            }

            // Projection vs anggaran
            if (projKwh > 0 && budget.configured && budgetKwh > 0) {
                if (projKwh > budgetKwh) {
                    insights.push('<span class="text-danger"> Proyeksi ' + formatDecimal(projKwh) + ' kWh melebihi anggaran ' + formatDecimal(budgetKwh) + ' kWh — perlu penghematan ' + formatDecimal(projKwh - budgetKwh) + ' kWh</span>');
                } else {
                    insights.push('<span class="text-success"> Proyeksi ' + formatDecimal(projKwh) + ' kWh — dalam anggaran, sisa ' + formatDecimal(budgetKwh - projKwh) + ' kWh</span>');
                }
            }

            // Unit Economics
            if (ue.configured && ue.costPerM2 > 0) {
                insights.push(' Biaya per m²: Rp ' + formatInteger(ue.costPerM2) + ' · Biaya per jam: Rp ' + formatInteger(ue.costPerHour || 0));
            }

            // Anomaly
            if (ac.totalAnomalies > 0) {
                insights.push('<span class="text-danger"> ' + ac.totalAnomalies + ' anomali bulan ini · dampak Rp ' + formatInteger(ac.estimatedCostImpact || 0) + '</span>');
            }

            // Device tariff mix
            if (ti.totalDeviceCount > 1) {
                insights.push(' ' + (ti.wbpDeviceCount || 0) + ' perangkat bertarif WBP/LWBP dan ' + (ti.flatDeviceCount || 0) + ' perangkat bertarif tetap.');
            }

            if (insights.length === 0) {
