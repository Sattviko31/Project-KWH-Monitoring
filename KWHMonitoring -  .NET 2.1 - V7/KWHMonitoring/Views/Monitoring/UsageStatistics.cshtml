        function updateCostProjectionChart() {
            var ed = lastEnergyData;
            var fd = lastFinancialData;
            if (!ed && !fd) return;

            var $canvas = $('#costProjectionChart');
            var $footer = $('#costProjectionFooter');

            if (activeCostProjectionTab === 'monthly') {
                renderMonthlyCostProjection(ed, fd, $canvas, $footer);
            } else {
                renderYearlyCostProjection(ed, fd, $canvas, $footer);
            }
        }

        function renderMonthlyCostProjection(ed, fd, $canvas, $footer) {
            var now = new Date();
            var dayOfMonth = now.getDate();
            var daysInMonth = new Date(now.getFullYear(), now.getMonth() + 1, 0).getDate();

            var dailyData = (ed && ed.dailyData) || [];
            var budget = (fd && fd.budget) || {};
            var tariff = (fd && fd.avgTariffPerKWh) || (ed && ed.tariffPerKWh) || 1500;

            var monthKwh = (ed && ed.totalThisMonth) || 0;
            var monthActualCost = budget.actualCost || 0;
            if (monthActualCost === 0 && monthKwh > 0) monthActualCost = Math.round(monthKwh * tariff);
            var costPerKWh = monthKwh > 0 ? monthActualCost / monthKwh : tariff;

            var dailyCost = new Array(daysInMonth).fill(0);
            dailyData.forEach(function(d) {
                var idx = (d.sortKey || 0) - 1;
                if (idx >= 0 && idx < daysInMonth) dailyCost[idx] = Math.round((d.energy || 0) * costPerKWh);
            });

            var cumulativeCost = [], projectedCostCum = [];
            var cumCost = 0, cumProjCost = 0;
            for (var i = 0; i < daysInMonth; i++) {
                if (i < dayOfMonth) {
                    cumCost += dailyCost[i];
                    cumulativeCost.push(cumCost);
                    projectedCostCum.push(cumCost);
                } else {
                    cumulativeCost.push(null);
                    var avgDailyCost = dayOfMonth > 0 ? cumCost / dayOfMonth : 0;
                    cumProjCost += avgDailyCost;
                    projectedCostCum.push(cumCost + cumProjCost);
                }
            }
            var totalProjectedMonthCost = cumCost + (dayOfMonth > 0 ? cumCost / dayOfMonth : 0) * (daysInMonth - dayOfMonth);

            var budgetKwh = budget.budgetKWh || 0;
            var budgetCostPerDay = budgetKwh > 0 ? (budgetKwh * costPerKWh) / daysInMonth : 0;
            var monthlyBudgetCostLine = [];
            for (var i = 0; i < daysInMonth; i++) monthlyBudgetCostLine.push(budgetCostPerDay * (i + 1));

            var dayLabels = [];
            for (var i = 1; i <= daysInMonth; i++) dayLabels.push(i);

            var datasets = [
                { label: 'Biaya Aktual (Rp)', data: cumulativeCost, borderColor: 'rgba(13,148,136,1)', backgroundColor: 'rgba(13,148,136,0.1)', borderWidth: 2, pointRadius: 0, pointHitRadius: 0, fill: true, tension: 0.3, order: 1 },
                { label: 'Biaya Proyeksi (Rp)', data: projectedCostCum, borderColor: 'rgba(251,146,60,0.9)', borderWidth: 2, borderDash: [5,3], pointRadius: 0, pointHitRadius: 0, fill: false, tension: 0.3, order: 1 }
            ];
            if (budgetCostPerDay > 0) datasets.push({ label: 'Anggaran (Rp)', data: monthlyBudgetCostLine, borderColor: 'rgba(34,197,94,0.7)', borderWidth: 2, borderDash: [8,4], pointRadius: 0, pointHitRadius: 0, fill: false, order: 0 });

            costProjectionChartInstance = renderUsageChart('costProjection', $canvas[0].getContext('2d'), {
                type: 'line', data: { labels: dayLabels, datasets: datasets },
                options: { responsive: true, maintainAspectRatio: false, interaction: { intersect: false, mode: 'index' },
                    plugins: { legend: { display: true, position: 'top', labels: { font: { size: 10 }, boxWidth: 12 } },
                        tooltip: { callbacks: { label: function(ctx) { var v = ctx.parsed.y; if (v === null || v === undefined) return null; return ctx.dataset.label + ': Rp ' + formatInteger(Math.round(v)); } } } },
                    scales: { x: { grid: { display: false }, ticks: { font: { size: 9 }, maxTicksLimit: 15 } }, y: { beginAtZero: true, grid: { color: 'rgba(0,0,0,0.06)' }, ticks: { font: { size: 9 }, callback: function(v) { return 'Rp ' + formatInteger(v); } } } }
                }
            });

            var fh = '<div><strong>Biaya aktual:</strong> Rp ' + formatInteger(cumCost) + ' · <strong>Proyeksi EOM:</strong> Rp ' + formatInteger(Math.round(totalProjectedMonthCost)) + '</div>';
            fh += '<div>Tarif efektif: Rp ' + formatInteger(Math.round(costPerKWh)) + '/kWh · Rata-rata harian: Rp ' + formatInteger(dayOfMonth > 0 ? Math.round(cumCost / dayOfMonth) : 0) + '</div>';
            if (budgetKwh > 0) {
                var budgetCostMonth = Math.round(budgetKwh * costPerKWh);
                var bpPct = Math.round(totalProjectedMonthCost / budgetCostMonth * 100);
                fh += '<div class="' + (bpPct > 100 ? 'text-danger' : (bpPct > 80 ? 'text-warning' : 'text-success')) + '">Proyeksi dibandingkan dengan anggaran: ' + bpPct + '% (Rp ' + formatInteger(budgetCostMonth) + ')</div>';
            }
            $footer.html(fh).show();
        }

        function renderYearlyCostProjection(ed, fd, $canvas, $footer) {
            var currentMonth = new Date().getMonth() + 1;
            var monthlyData = (ed && ed.monthlyData) || [];
            var budget = (fd && fd.budget) || {};
            var tariff = (fd && fd.avgTariffPerKWh) || (ed && ed.tariffPerKWh) || 1500;

            var monthKwh = (ed && ed.totalThisMonth) || 0;
            var monthActualCost = budget.actualCost || 0;
            if (monthActualCost === 0 && monthKwh > 0) monthActualCost = Math.round(monthKwh * tariff);
            var costPerKWh = monthKwh > 0 ? monthActualCost / monthKwh : tariff;

            var monthlyCost = new Array(12).fill(0);
            monthlyData.forEach(function(m) {
                var idx = (m.sortKey || 0) - 1;
                if (idx >= 0 && idx < 12) monthlyCost[idx] = Math.round((m.energy || 0) * costPerKWh);
            });

            var yearlyCostCum = [], yearlyProjCostCum = [];
            var yCumCost = 0, yProjCost = 0;
            for (var i = 0; i < 12; i++) {
                if (i < currentMonth) {
                    yCumCost += monthlyCost[i];
                    yearlyCostCum.push(yCumCost);
                    yearlyProjCostCum.push(yCumCost);
                } else {
                    yearlyCostCum.push(null);
                    var avgM = currentMonth > 0 ? yCumCost / currentMonth : 0;
                    yProjCost += avgM;
                    yearlyProjCostCum.push(yCumCost + yProjCost);
                }
            }
            var totalProjectedYearCost = yCumCost + (currentMonth > 0 ? yCumCost / currentMonth : 0) * (12 - currentMonth);

            var budgetKwh = budget.budgetKWh || 0;
            var yearlyBudgetCost = budgetKwh > 0 ? budgetKwh * 12 * costPerKWh : 0;
            var monthlyBudgetCost = yearlyBudgetCost / 12;
            var yearlyBudgetCostLine = [];
            for (var i = 0; i < 12; i++) yearlyBudgetCostLine.push(monthlyBudgetCost * (i + 1));

            var monthLabels = ['Jan','Feb','Mar','Apr','Mei','Jun','Jul','Ags','Sep','Okt','Nov','Des'];

            var datasets = [
                { label: 'Biaya Aktual (Rp)', data: monthlyCost.slice(0, currentMonth).concat(new Array(12 - currentMonth).fill(null)), type: 'bar', backgroundColor: 'rgba(13,148,136,0.7)', borderColor: 'rgba(13,148,136,1)', borderWidth: 1, borderRadius: 3, order: 3 },
                { label: 'Biaya Proyeksi (Rp)', data: new Array(currentMonth).fill(null).concat(new Array(12 - currentMonth).fill(currentMonth > 0 ? Math.round(yCumCost / currentMonth) : 0)), type: 'bar', backgroundColor: 'rgba(251,146,60,0.35)', borderColor: 'rgba(251,146,60,0.7)', borderWidth: 1, borderDash: [3,3], borderRadius: 3, order: 3 },
                { label: 'Kumulatif Aktual', data: yearlyCostCum, type: 'line', borderColor: 'rgba(13,148,136,1)', borderWidth: 2, pointRadius: 2, fill: false, tension: 0.3, order: 1 },
                { label: 'Kumulatif Proyeksi', data: yearlyProjCostCum, type: 'line', borderColor: 'rgba(251,146,60,0.9)', borderWidth: 2, borderDash: [5,3], pointRadius: 0, pointHitRadius: 0, fill: false, tension: 0.3, order: 1 }
            ];
            if (yearlyBudgetCost > 0) datasets.push({ label: 'Anggaran', data: yearlyBudgetCostLine, type: 'line', borderColor: 'rgba(34,197,94,0.8)', borderWidth: 2, borderDash: [8,4], pointRadius: 0, pointHitRadius: 0, fill: false, order: 0 });

            costProjectionChartInstance = renderUsageChart('costProjection', $canvas[0].getContext('2d'), {
                type: 'bar', data: { labels: monthLabels, datasets: datasets },
                options: { responsive: true, maintainAspectRatio: false, interaction: { intersect: false, mode: 'index' },
                    plugins: { legend: { display: true, position: 'top', labels: { font: { size: 10 }, boxWidth: 12 } },
                        tooltip: { callbacks: { label: function(ctx) { var v = ctx.parsed.y; if (v === null || v === undefined) return null; return ctx.dataset.label + ': Rp ' + formatInteger(Math.round(v)); } } } },
                    scales: { x: { grid: { display: false }, ticks: { font: { size: 9 } } }, y: { beginAtZero: true, grid: { color: 'rgba(0,0,0,0.06)' }, ticks: { font: { size: 9 }, callback: function(v) { return 'Rp ' + formatInteger(v); } } } }
                }
            });

            var fh = '<div><strong>Aktual ' + currentMonth + ' bulan:</strong> Rp ' + formatInteger(yCumCost) + ' · <strong>Proyeksi EOY:</strong> Rp ' + formatInteger(Math.round(totalProjectedYearCost)) + '</div>';
            fh += '<div>Rata-rata bulanan: Rp ' + formatInteger(currentMonth > 0 ? Math.round(yCumCost / currentMonth) : 0) + '</div>';
            if (yearlyBudgetCost > 0) {
                var yp = Math.round(totalProjectedYearCost / yearlyBudgetCost * 100);
                fh += '<div class="' + (yp > 100 ? 'text-danger' : (yp > 80 ? 'text-warning' : 'text-success')) + '">Proyeksi dibandingkan dengan anggaran: ' + yp + '% (Rp ' + formatInteger(Math.round(yearlyBudgetCost)) + '/tahun)</div>';
            }
            $footer.html(fh).show();
        }

        // --- Compact Financial Metrics ---
        function updateFinancialMetrics(data) {
            var w = data.waste || {};
            var pc = data.periodComparison || {};
            var bp = data.billProjection || {};
            var lf = data.loadFactorInfo || {};
            var ue = data.unitEconomics || {};

            // Pemborosan energi — highlight if >5% threshold
            if (w.configured) {
                var wp = w.wastePercent || 0;
                var isHigh = wp > 5;
                var wCls = isHigh ? 'text-danger' : 'text-success';
                var cellCls = isHigh ? 'fin-critical' : 'fin-ok';
                $('#finWaste').attr('class', 'fin-metric ' + cellCls);
                $('#finWasteValue').attr('class', 'fin-metric-value ' + wCls).text(wp.toFixed(1) + '%' + (isHigh ? ' (!)' : ''));
                var subParts = [formatDecimal(w.wasteKwh || 0) + ' kWh', 'Rp ' + formatInteger(w.wasteCost || 0)];
                if (w.downtimeStart !== undefined) subParts.push(w.downtimeStart + '-' + w.downtimeEnd);
                if (isHigh) subParts.push('batas 5%');
                $('#finWasteSub').text(subParts.join(' · '));
            } else {
                $('#finWaste').attr('class', 'fin-metric');
                $('#finWasteValue').attr('class', 'fin-metric-value text-muted').text('—');
                $('#finWasteSub').text('Belum dikonfigurasi');
            }

            // MoM — highlight significant changes
            if (pc.momChangePercent || pc.momChangePercent === 0) {
                var mv = pc.momChangePercent || 0;
                var mUp = mv > 0;
                var mCls = mUp ? 'text-danger' : 'text-success';
                var mArr = mUp ? '▲' : '▼';
                var mCellCls = Math.abs(mv) > 20 ? 'fin-critical' : (Math.abs(mv) > 10 ? 'fin-warning' : (mUp ? '' : 'fin-ok'));
                $('#finMom').attr('class', 'fin-metric ' + mCellCls);
                $('#finMomValue').attr('class', 'fin-metric-value ' + mCls).text(mArr + ' ' + Math.abs(mv).toFixed(1) + '%');
                var momSub = (mUp ? 'Naik' : 'Turun') + ' ' + formatDecimal(Math.abs(pc.momChange || 0)) + ' kWh';
                if (pc.lastMonthKWh) momSub += ' (bln lalu: ' + formatDecimal(pc.lastMonthKWh) + ')';
                $('#finMomSub').text(momSub);
            } else if (pc.momChange || pc.momChange === 0) {
                var mv2 = pc.momChange || 0;
                var mUp2 = mv2 > 0;
                var mCls2 = mUp2 ? 'text-danger' : 'text-success';
                var mArr2 = mUp2 ? '▲' : '▼';
                $('#finMom').attr('class', 'fin-metric');
                $('#finMomValue').attr('class', 'fin-metric-value ' + mCls2).text(mArr2 + ' ' + Math.abs(mv2).toFixed(1) + '%');
                $('#finMomSub').text((mUp2 ? 'Naik' : 'Turun') + ' vs bulan lalu');
            } else {
                $('#finMom').attr('class', 'fin-metric');
                $('#finMomValue').attr('class', 'fin-metric-value text-muted').text('—');
                $('#finMomSub').text('');
            }

            // YoY — highlight significant changes
            if (pc.yoyChangePercent || pc.yoyChangePercent === 0) {
                var yv = pc.yoyChangePercent || 0;
                var yUp = yv > 0;
                var yCls = yUp ? 'text-danger' : 'text-success';
                var yArr = yUp ? '▲' : '▼';
                var yCellCls = Math.abs(yv) > 50 ? 'fin-critical' : (Math.abs(yv) > 20 ? 'fin-warning' : (yUp ? '' : 'fin-ok'));
                $('#finYoy').attr('class', 'fin-metric ' + yCellCls);
                $('#finYoyValue').attr('class', 'fin-metric-value ' + yCls).text(yArr + ' ' + Math.abs(yv).toFixed(1) + '%');
                var yoySub = (yUp ? 'Naik' : 'Turun') + ' ' + formatDecimal(Math.abs(pc.yoyChange || 0)) + ' kWh';
                if (pc.lastYearSameMonthKWh) yoySub += ' (thn lalu: ' + formatDecimal(pc.lastYearSameMonthKWh) + ')';
                $('#finYoySub').text(yoySub);
            } else if (pc.yoyChange || pc.yoyChange === 0) {
                var yv2 = pc.yoyChange || 0;
                var yUp2 = yv2 > 0;
                var yCls2 = yUp2 ? 'text-danger' : 'text-success';
                var yArr2 = yUp2 ? '▲' : '▼';
                $('#finYoy').attr('class', 'fin-metric');
                $('#finYoyValue').attr('class', 'fin-metric-value ' + yCls2).text(yArr2 + ' ' + Math.abs(yv2).toFixed(1) + '%');
                    $('#finYoySub').text((yUp2 ? 'Naik' : 'Turun') + ' dibandingkan dengan tahun sebelumnya');
            } else {
                $('#finYoy').attr('class', 'fin-metric');
                $('#finYoyValue').attr('class', 'fin-metric-value text-muted').text('—');
                $('#finYoySub').text('');
            }

            // Bill Projection
            if (bp.projectedMonthKWh || bp.projectedMonthKWh === 0) {
                var isNearEom = (bp.daysRemaining || 0) <= 5;
                $('#finBill').attr('class', 'fin-metric' + (isNearEom ? ' fin-warning' : ''));
                $('#finBillValue').attr('class', 'fin-metric-value text-warning').text(formatDecimal(bp.projectedMonthKWh || 0) + ' kWh');
                var billSub = 'Rp ' + formatInteger(bp.projectedCost || 0);
                if (bp.daysElapsed && bp.daysRemaining) {
                    var avgDaily = (bp.projectedMonthKWh || 0) / (bp.daysElapsed + bp.daysRemaining);
                    billSub += ' · ' + formatDecimal(avgDaily) + ' kWh/hari';
                }
                billSub += ' · sisa ' + (bp.daysRemaining || 0) + ' hari';
                $('#finBillSub').text(billSub);
            } else {
                $('#finBill').attr('class', 'fin-metric');
                $('#finBillValue').attr('class', 'fin-metric-value text-muted').text('—');
                $('#finBillSub').text('');
            }

            // Load Factor — API returns 0-100 percentage
            // Thresholds: <30 Under-utilized, 30-80 Optimal, >80 High Risk
            if (lf.loadFactor || lf.loadFactor === 0) {
                var lfVal = lf.loadFactor || 0;
                var lfPct = lfVal.toFixed(1);
                var lfCls, lfLabel, lfCellCls;
                if (lfVal > 80) {
                    lfCls = 'text-danger'; lfLabel = 'Risiko Tinggi'; lfCellCls = 'fin-critical';
                } else if (lfVal < 30) {
                    lfCls = 'text-warning'; lfLabel = 'Kapasitas Kurang Dimanfaatkan'; lfCellCls = 'fin-warning';
                } else {
                    lfCls = 'text-success'; lfLabel = 'Optimal'; lfCellCls = 'fin-ok';
                }
                $('#finLf').attr('class', 'fin-metric ' + lfCellCls);
                $('#finLfValue').attr('class', 'fin-metric-value ' + lfCls).text(lfPct + '%');
                var lfSub = lfLabel;
                if (lf.maxCapacity) lfSub += ' · Max ' + formatDecimal(lf.maxCapacity / 1000) + ' kVA';
                if (lf.status) lfSub += ' · ' + lf.status;
                $('#finLfSub').text(lfSub);
            } else if (lf.configured === false) {
                $('#finLf').attr('class', 'fin-metric');
                $('#finLfValue').attr('class', 'fin-metric-value text-muted').text('—');
                $('#finLfSub').text('Belum dikonfigurasi');
            } else {
                $('#finLf').attr('class', 'fin-metric');
                $('#finLfValue').attr('class', 'fin-metric-value text-muted').text('—');
                $('#finLfSub').text('');
            }

            // Unit Economics — show both values with clear separation
            if ((ue.costPerM2 || ue.costPerM2 === 0) || (ue.costPerHour || ue.costPerHour === 0)) {
                var mainVal = '';
                if (ue.costPerM2) mainVal = 'Rp ' + formatInteger(ue.costPerM2) + '/m²';
                else if (ue.costPerHour) mainVal = 'Rp ' + formatInteger(ue.costPerHour) + '/jam';
                $('#finUeValue').attr('class', 'fin-metric-value').text(mainVal);
                var ueSub = [];
                if (ue.costPerM2 && ue.costPerHour) ueSub.push('Rp ' + formatInteger(ue.costPerHour) + '/jam');
                if (ue.surfaceArea) ueSub.push('Area: ' + formatDecimal(ue.surfaceArea) + ' m²');
                $('#finUeSub').text(ueSub.join(' · '));
                $('#finUe').attr('class', 'fin-metric');
            } else {
                $('#finUe').attr('class', 'fin-metric');
                $('#finUeValue').attr('class', 'fin-metric-value text-muted').text('—');
                $('#finUeSub').text('');
            }
        }

        // --- Anomaly Cost Impact ---
        function updateAnomalyCostUI(ac) {
            var $body = $('#anomalyCostBody');
            var totalCost = ac.estimatedCostImpact || ac.totalCost || 0;
            var totalAnomalies = ac.totalAnomalies || 0;
            var items = ac.anomalies || ac.topAnomalies || [];

            if (items.length === 0) {
                $body.html(
                    '<div class="text-center" style="font-size:0.8rem">' +
                        '<span class="text-muted">Dampak Biaya Anomali:</span> <strong class="text-primary">Rp ' + formatInteger(totalCost) + '</strong>' +
                        (totalAnomalies > 0 ? ' <span class="badge bg-secondary">' + totalAnomalies + ' anomali</span>' : '') +
                        '<div class="text-muted mt-1" style="font-size:0.7rem">Tidak ada anomali aktif</div>' +
                    '</div>'
                );
                return;
            }

            var html = '<div class="mb-2" style="font-size:0.8rem"><span class="text-muted">Total Dampak:</span> <strong class="text-danger">Rp ' + formatInteger(totalCost) + '</strong>';
            if (totalAnomalies > 0) html += ' <span class="badge bg-danger">' + totalAnomalies + ' anomali</span>';
            html += '</div>';
            html += '<div style="font-size:0.75rem">';

            items.forEach(function(a, i) {
                if (i >= 5) return;
                var icon = (a.anomalyType || a.type) === 'OVERLOAD' ? 'fa-arrow-up text-danger' : 'fa-arrow-down text-warning';
                var cost = a.estimatedCost || a.costImpact || 0;
                var name = a.deviceName || a.deviceKey || '—';
                var severity = a.severity || '';
                var sevBadge = severity === 'high' ? ' <span class="badge bg-danger">TINGGI</span>' : (severity === 'medium' ? ' <span class="badge bg-warning text-dark">SEDANG</span>' : '');
                html += '<div class="anomaly-cost-item d-flex justify-content-between align-items-center py-1' + (i < items.length - 1 && i < 4 ? ' border-bottom' : '') + '">' +
                    '<span class="anomaly-cost-name"><i class="fas ' + icon + '"></i> ' + name + sevBadge + '</span>' +
                    '<span class="text-danger fw-bold text-nowrap ms-2">Rp ' + formatInteger(cost) + '</span>' +
                '</div>';
            });

            html += '</div>';
            $body.html(html);
        }

        // ============================================
        // REPORTS — Daily / Monthly / Yearly
        // ============================================
        function renderAllReports() {
            generateDailyReport();
            generateMonthlyReport();
            generateYearlyReport();
        }

        function generateDailyReport() {
            var $body = $('#dailyReportBody');
            if (!$body.length) return;
            var ed = lastEnergyData;
            var fd = lastFinancialData;
            if (!ed && !fd) {
                $body.html('<div class="text-center text-muted py-2" style="font-size:0.8rem">Menunggu data...</div>');
                return;
            }

            var hourlyData = (ed && ed.hourlyData) || [];
            var totalToday = (ed && ed.totalToday) || 0;
            var dailyData = (ed && ed.dailyData) || [];
            var tariff = (fd && fd.avgTariffPerKWh) || (ed && ed.tariffPerKWh) || 1500;

            var wbpLwbp = (fd && fd.wbpLwbp) || {};
            var waste = (fd && fd.waste) || {};
            var budget = (fd && fd.budget) || {};
            var bp = (fd && fd.billProjection) || {};
            var lf = (fd && fd.loadFactorInfo) || {};
            var ac = (fd && fd.anomalyCostImpact) || {};
            var ti = (fd && fd.tariffTypeInfo) || {};
            var pc = (fd && fd.periodComparison) || {};

            // Compute insights
            var filledHours = hourlyData.filter(function(h) { return h.energy > 0; });
            var avgPerFilledHour = filledHours.length > 0 ? filledHours.reduce(function(s, h) { return s + h.energy; }, 0) / filledHours.length : 0;
            var peakHour = hourlyData.length > 0 ? hourlyData.reduce(function(max, h) { return h.energy > max.energy ? h : max; }, { energy: 0, timeLabel: '-' }) : { energy: 0, timeLabel: '-' };

            // Daily average from month data
            var filledDays = dailyData.filter(function(d) { return d.energy > 0; });
            var avgDailyKWh = filledDays.length > 0 ? filledDays.reduce(function(s, d) { return s + d.energy; }, 0) / filledDays.length : 0;
            var todayVsAvg = avgDailyKWh > 0 ? Math.round((totalToday / avgDailyKWh - 1) * 100 * 10) / 10 : 0;

            // Budget pace: daily anggaran = budgetKWh / daysInMonth
            var daysInMonth = new Date(new Date().getFullYear(), new Date().getMonth() + 1, 0).getDate();
            var dayOfMonth = new Date().getDate();
            var budgetPaceKWh = budget.configured && budget.budgetKWh > 0 ? budget.budgetKWh / daysInMonth : 0;
            var paceStatus = budgetPaceKWh > 0 ? (totalToday > budgetPaceKWh ? 'over' : 'under') : 'none';

            // Today's cost
            var todayCost = 0;
            if (wbpLwbp.configured && (wbpLwbp.wbpKWh + wbpLwbp.lwbpKWh) > 0) {
                var monthTotal = wbpLwbp.wbpKWh + wbpLwbp.lwbpKWh;
                if (ti.flatKWh) monthTotal += ti.flatKWh;
                var todayRatio = monthTotal > 0 ? totalToday / monthTotal : 0;
                todayCost = Math.round(((wbpLwbp.totalCostWBP || 0) + (ti.flatCost || 0)) * todayRatio);
            } else {
                todayCost = Math.round(totalToday * tariff);
            }

            // Build report HTML
            var html = '';
            html += '<div class="fin-metric-grid" style="margin-bottom:8px">';
            html += '<div class="fin-metric"><div class="fin-metric-label"><i class="fas fa-bolt text-primary"></i> Konsumsi</div>';
            html += '<div class="fin-metric-value' + (todayVsAvg > 20 ? ' text-danger' : (todayVsAvg > 10 ? ' text-warning' : (todayVsAvg < -10 ? ' text-success' : ''))) + '">' + formatDecimal(totalToday) + ' kWh</div>';
            html += '<div class="fin-metric-sub">' + (avgDailyKWh > 0 ? (todayVsAvg >= 0 ? '▲ ' : '▼ ') + Math.abs(todayVsAvg).toFixed(1) + '% dibandingkan dengan rata-rata' : 'Rata-rata: ' + formatDecimal(avgPerFilledHour) + ' kWh/jam') + '</div></div>';
            html += '<div class="fin-metric"><div class="fin-metric-label"><i class="fas fa-coins text-warning"></i> Estimasi Biaya</div>';
            html += '<div class="fin-metric-value">' + 'Rp ' + formatInteger(todayCost) + '</div>';
            html += '<div class="fin-metric-sub">Tarif: ' + (wbpLwbp.configured ? 'WBP/LWBP' : 'Tarif tetap') + ' · ' + formatInteger(tariff) + '/kWh</div></div>';
            html += '<div class="fin-metric"><div class="fin-metric-label"><i class="fas fa-arrow-up text-info"></i> Jam Puncak</div>';
            html += '<div class="fin-metric-value">' + peakHour.timeLabel + '</div>';
            html += '<div class="fin-metric-sub">' + formatDecimal(peakHour.energy) + ' kWh · Rp ' + formatInteger(Math.round(peakHour.energy * tariff)) + '</div></div>';
            html += '</div>';

            html += '<div class="daily-report-insights">';
            html += '<div class="text-muted mb-1" style="font-size:0.7rem"><i class="fas fa-lightbulb"></i> WAWASAN</div>';
            var insights = [];

            if (todayVsAvg > 20) {
                insights.push('<span class="text-danger"> Konsumsi hari ini ' + todayVsAvg.toFixed(1) + '% di atas rata-rata harian (' + formatDecimal(avgDailyKWh) + ' kWh/hari)</span>');
            } else if (todayVsAvg < -20) {
                insights.push('<span class="text-success">Konsumsi hari ini ' + Math.abs(todayVsAvg).toFixed(1) + '% di bawah rata-rata — efisien</span>');
            } else if (avgDailyKWh > 0) {
                insights.push('Konsumsi hari ini mendekati rata-rata (selisih ' + Math.abs(todayVsAvg).toFixed(1) + '%)');
            }

            if (wbpLwbp.configured) {
                var wbpRatio = wbpLwbp.wbpRatio || 0;
                if (wbpRatio > 40) {
                    insights.push('<span class="text-warning"> Rasio WBP ' + wbpRatio.toFixed(1) + '% — pertimbangkan shift operasional ke jam LWBP</span>');
                } else {
                    insights.push('Rasio WBP ' + wbpRatio.toFixed(1) + '% — proporsi WBP terkontrol');
                }
            }

            if (paceStatus === 'over') {
                var overPct = budgetPaceKWh > 0 ? Math.round((totalToday / budgetPaceKWh - 1) * 100) : 0;
                insights.push('<span class="text-danger"> Konsumsi hari ini mencapai ' + overPct + '% di atas laju penggunaan harian yang dianggarkan (' + formatDecimal(budgetPaceKWh) + ' kWh/hari).</span>');
            } else if (paceStatus === 'under') {
                insights.push('<span class="text-success"> Laju penggunaan hari ini sesuai anggaran (' + formatDecimal(budgetPaceKWh) + ' kWh/hari)</span>');
            }

            if (waste.configured && waste.wastePercent > 0) {
                if (waste.wastePercent > 5) {
                    insights.push('<span class="text-danger"> Pemborosan energi ' + waste.wastePercent.toFixed(1) + '% — konsumsi selama waktu henti ' + (waste.downtimeStart || '') + '-' + (waste.downtimeEnd || '') + ' perlu ditinjau.</span>');
                } else {
                    insights.push('Pemborosan energi ' + waste.wastePercent.toFixed(1) + '% — masih dalam batas wajar.');
                }
            }

            if (lf.configured) {
                if (lf.loadFactor > 80) {
                    insights.push('<span class="text-danger"> Faktor Beban ' + lf.loadFactor.toFixed(1) + '% — berisiko tinggi.</span>');
                } else if (lf.loadFactor < 30) {
                    insights.push('<span class="text-warning"> Faktor Beban ' + lf.loadFactor.toFixed(1) + '% — kapasitas kurang dimanfaatkan</span>');
                }
            }

            if (ac.totalAnomalies > 0) {
                insights.push('<span class="text-danger"> ' + ac.totalAnomalies + ' anomali bulan ini · dampak Rp ' + formatInteger(ac.estimatedCostImpact || 0) + '</span>');
            }

            if (ti.totalDeviceCount > 1) {
                insights.push(' ' + (ti.wbpDeviceCount || 0) + ' perangkat bertarif WBP/LWBP dan ' + (ti.flatDeviceCount || 0) + ' perangkat bertarif tetap.');
            }

            if (pc.momChangePercent && Math.abs(pc.momChangePercent) > 5) {
                var momDir = pc.momChangePercent > 0 ? 'naik' : 'turun';
                insights.push('Bulan ini ' + momDir + ' ' + Math.abs(pc.momChangePercent).toFixed(1) + '% vs bulan lalu');
            }

            if (bp.projectedMonthKWh > 0 && budget.configured) {
                if (bp.projectedMonthKWh > budget.budgetKWh) {
                    insights.push('<span class="text-warning"> Proyeksi akhir bulan ' + formatDecimal(bp.projectedMonthKWh) + ' kWh — melebihi anggaran ' + formatDecimal(budget.budgetKWh) + ' kWh</span>');
                } else {
                    insights.push('<span class="text-success"> Proyeksi akhir bulan ' + formatDecimal(bp.projectedMonthKWh) + ' kWh — dalam anggaran</span>');
                }
            } else if (bp.projectedMonthKWh > 0) {
                insights.push(' Proyeksi akhir bulan: ' + formatDecimal(bp.projectedMonthKWh) + ' kWh (Rp ' + formatInteger(bp.projectedCost || 0) + ')');
            }

            if (insights.length === 0) {
                insights.push('<span class="text-muted">Data belum mencukupi untuk melakukan analisis.</span>');
            }

            insights.forEach(function(insight) {
                html += '<div style="padding:2px 0; line-height:1.4">' + insight + '</div>';
            });
            html += '</div>';
            $body.html(html);
        }

        function generateMonthlyReport() {
