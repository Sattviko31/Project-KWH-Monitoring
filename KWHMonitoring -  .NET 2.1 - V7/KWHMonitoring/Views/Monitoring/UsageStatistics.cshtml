            var yearKwh = (ed && ed.totalThisYear) || 0;
            var yearAvgPerMonth = (ed && ed.avgPerMonth) || 0;
            var yearPeakMonth = (ed && ed.peakMonth) || 0;
            var yearPeakMonthName = (ed && ed.peakMonthName) || '-';
            var monthlyData = (ed && ed.monthlyData) || [];
            var tariff = (fd && fd.avgTariffPerKWh) || (ed && ed.tariffPerKWh) || 1500;
            var monthKwh = (ed && ed.totalThisMonth) || 0;

            var wbpLwbp = (fd && fd.wbpLwbp) || {};
            var waste = (fd && fd.waste) || {};
            var budget = (fd && fd.budget) || {};
            var pc = (fd && fd.periodComparison) || {};
            var ti = (fd && fd.tariffTypeInfo) || {};

            var currentMonth = new Date().getMonth() + 1;

            // Year cost: use actualCost from financial data (includes WBP/LWBP) when available
            var yearCost = 0;
            if (budget && budget.actualCost > 0 && monthKwh > 0 && yearKwh > 0) {
                yearCost = Math.round(budget.actualCost / monthKwh * yearKwh);
            } else {
                yearCost = Math.round(yearKwh * tariff);
            }

            // Find peak month from monthly data
            var peakMonthInfo = monthlyData.length > 0 ? monthlyData.reduce(function(max, m) { return m.energy > max.energy ? m : max; }, { energy: 0, timeLabel: '-' }) : { energy: 0, timeLabel: '-' };

            // Yearly anggaran estimate: monthly anggaran × 12
            var yearlyBudget = budget.configured && budget.budgetKWh > 0 ? budget.budgetKWh * 12 : 0;

            // Best & worst months
            var bestMonth = monthlyData.length > 0 ? monthlyData.reduce(function(min, m) { return m.energy > 0 && m.energy < min.energy ? m : min; }, { energy: Infinity, timeLabel: '-' }) : null;
            var worstMonth = peakMonthInfo;

            var html = '';
            html += '<div class="fin-metric-grid" style="margin-bottom:8px">';

            // Total Tahun Ini
            html += '<div class="fin-metric"><div class="fin-metric-label"><i class="fas fa-calendar text-primary"></i> Total Tahun</div>';
            html += '<div class="fin-metric-value">' + formatDecimal(yearKwh) + ' kWh</div>';
            html += '<div class="fin-metric-sub">Rata-rata ' + formatDecimal(yearAvgPerMonth) + ' kWh/bulan · Bulan ke-' + currentMonth + '</div></div>';

            // Biaya Tahunan
            html += '<div class="fin-metric"><div class="fin-metric-label"><i class="fas fa-coins text-warning"></i> Biaya Tahunan</div>';
            html += '<div class="fin-metric-value">Rp ' + formatInteger(yearCost) + '</div>';
            html += '<div class="fin-metric-sub">Rata-rata Rp ' + formatInteger(Math.round(yearCost / Math.max(currentMonth, 1))) + '/bulan</div></div>';

            // Bulan Puncak
            html += '<div class="fin-metric"><div class="fin-metric-label"><i class="fas fa-arrow-up text-danger"></i> Bulan Puncak</div>';
            html += '<div class="fin-metric-value">' + (peakMonthInfo.timeLabel || yearPeakMonthName) + '</div>';
            html += '<div class="fin-metric-sub">' + formatDecimal(peakMonthInfo.energy || yearPeakMonth) + ' kWh</div></div>';

            // Bulan Terendah
            html += '<div class="fin-metric"><div class="fin-metric-label"><i class="fas fa-arrow-down text-success"></i> Bulan Terendah</div>';
            if (bestMonth && bestMonth.energy > 0 && bestMonth.energy < Infinity) {
                html += '<div class="fin-metric-value">' + bestMonth.timeLabel + '</div>';
                html += '<div class="fin-metric-sub">' + formatDecimal(bestMonth.energy) + ' kWh</div></div>';
            } else {
                html += '<div class="fin-metric-value text-muted">—</div>';
                html += '<div class="fin-metric-sub">Data belum cukup</div></div>';
            }

            // YoY
