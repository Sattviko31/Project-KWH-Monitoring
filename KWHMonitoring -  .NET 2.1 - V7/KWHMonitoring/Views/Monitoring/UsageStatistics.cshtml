        // --- Compact Financial Metrics ---
        function updateFinancialMetrics(data) {
            var w = data.waste || {};
            var pc = data.periodComparison || {};
            var bp = data.billProjection || {};
            var lf = data.loadFactorInfo || {};
            var ue = data.unitEconomics || {};

            // Waste — highlight if >5% threshold
            if (w.configured) {
                var wp = w.wastePercent || 0;
                var isHigh = wp > 5;
                var wCls = isHigh ? 'text-danger' : 'text-success';
                var cellCls = isHigh ? 'fin-critical' : 'fin-ok';
                $('#finWaste').attr('class', 'fin-metric ' + cellCls);
                $('#finWasteValue').attr('class', 'fin-metric-value ' + wCls).text(wp.toFixed(1) + '%' + (isHigh ? ' (!)' : ''));
                var subParts = [formatDecimal(w.wasteKwh || 0) + ' kWh', 'Rp ' + formatInteger(w.wasteCost || 0)];
                if (w.downtimeStart !== undefined) subParts.push(w.downtimeStart + '-' + w.downtimeEnd);
                if (isHigh) subParts.push('batas 5%');
                $('#finWasteSub').text(subParts.join(' · '));
            } else {
                $('#finWaste').attr('class', 'fin-metric');
                $('#finWasteValue').attr('class', 'fin-metric-value text-muted').text('—');
                $('#finWasteSub').text('Belum dikonfigurasi');
            }

            // MoM — highlight significant changes
            if (pc.momChangePercent || pc.momChangePercent === 0) {
                var mv = pc.momChangePercent || 0;
                var mUp = mv > 0;
                var mCls = mUp ? 'text-danger' : 'text-success';
                var mArr = mUp ? '▲' : '▼';
                var mCellCls = Math.abs(mv) > 20 ? 'fin-critical' : (Math.abs(mv) > 10 ? 'fin-warning' : (mUp ? '' : 'fin-ok'));
                $('#finMom').attr('class', 'fin-metric ' + mCellCls);
                $('#finMomValue').attr('class', 'fin-metric-value ' + mCls).text(mArr + ' ' + Math.abs(mv).toFixed(1) + '%');
                var momSub = (mUp ? 'Naik' : 'Turun') + ' ' + formatDecimal(Math.abs(pc.momChange || 0)) + ' kWh';
                if (pc.lastMonthKWh) momSub += ' (bln lalu: ' + formatDecimal(pc.lastMonthKWh) + ')';
                $('#finMomSub').text(momSub);
            } else if (pc.momChange || pc.momChange === 0) {
                var mv2 = pc.momChange || 0;
                var mUp2 = mv2 > 0;
                var mCls2 = mUp2 ? 'text-danger' : 'text-success';
                var mArr2 = mUp2 ? '▲' : '▼';
                $('#finMom').attr('class', 'fin-metric');
                $('#finMomValue').attr('class', 'fin-metric-value ' + mCls2).text(mArr2 + ' ' + Math.abs(mv2).toFixed(1) + '%');
                $('#finMomSub').text((mUp2 ? 'Naik' : 'Turun') + ' vs bulan lalu');
            } else {
                $('#finMom').attr('class', 'fin-metric');
                $('#finMomValue').attr('class', 'fin-metric-value text-muted').text('—');
                $('#finMomSub').text('');
            }

            // YoY — highlight significant changes
            if (pc.yoyChangePercent || pc.yoyChangePercent === 0) {
                var yv = pc.yoyChangePercent || 0;
                var yUp = yv > 0;
                var yCls = yUp ? 'text-danger' : 'text-success';
                var yArr = yUp ? '▲' : '▼';
                var yCellCls = Math.abs(yv) > 50 ? 'fin-critical' : (Math.abs(yv) > 20 ? 'fin-warning' : (yUp ? '' : 'fin-ok'));
                $('#finYoy').attr('class', 'fin-metric ' + yCellCls);
                $('#finYoyValue').attr('class', 'fin-metric-value ' + yCls).text(yArr + ' ' + Math.abs(yv).toFixed(1) + '%');
                var yoySub = (yUp ? 'Naik' : 'Turun') + ' ' + formatDecimal(Math.abs(pc.yoyChange || 0)) + ' kWh';
                if (pc.lastYearSameMonthKWh) yoySub += ' (thn lalu: ' + formatDecimal(pc.lastYearSameMonthKWh) + ')';
                $('#finYoySub').text(yoySub);
            } else if (pc.yoyChange || pc.yoyChange === 0) {
                var yv2 = pc.yoyChange || 0;
                var yUp2 = yv2 > 0;
                var yCls2 = yUp2 ? 'text-danger' : 'text-success';
                var yArr2 = yUp2 ? '▲' : '▼';
                $('#finYoy').attr('class', 'fin-metric');
                $('#finYoyValue').attr('class', 'fin-metric-value ' + yCls2).text(yArr2 + ' ' + Math.abs(yv2).toFixed(1) + '%');
                $('#finYoySub').text((yUp2 ? 'Naik' : 'Turun') + ' vs tahun lalu');
            } else {
                $('#finYoy').attr('class', 'fin-metric');
                $('#finYoyValue').attr('class', 'fin-metric-value text-muted').text('—');
                $('#finYoySub').text('');
            }

            // Bill Projection
            if (bp.projectedMonthKWh || bp.projectedMonthKWh === 0) {
                var isNearEom = (bp.daysRemaining || 0) <= 5;
                $('#finBill').attr('class', 'fin-metric' + (isNearEom ? ' fin-warning' : ''));
                $('#finBillValue').attr('class', 'fin-metric-value text-warning').text(formatDecimal(bp.projectedMonthKWh || 0) + ' kWh');
                var billSub = 'Rp ' + formatInteger(bp.projectedCost || 0);
                if (bp.daysElapsed && bp.daysRemaining) {
                    var avgDaily = (bp.projectedMonthKWh || 0) / (bp.daysElapsed + bp.daysRemaining);
                    billSub += ' · ' + formatDecimal(avgDaily) + ' kWh/hari';
                }
                billSub += ' · sisa ' + (bp.daysRemaining || 0) + ' hari';
                $('#finBillSub').text(billSub);
            } else {
                $('#finBill').attr('class', 'fin-metric');
                $('#finBillValue').attr('class', 'fin-metric-value text-muted').text('—');
                $('#finBillSub').text('');
            }

            // Load Factor — API returns 0-100 percentage
            // Thresholds: <30 Under-utilized, 30-80 Optimal, >80 High Risk
            if (lf.loadFactor || lf.loadFactor === 0) {
                var lfVal = lf.loadFactor || 0;
                var lfPct = lfVal.toFixed(1);
                var lfCls, lfLabel, lfCellCls;
                if (lfVal > 80) {
                    lfCls = 'text-danger'; lfLabel = 'Risiko Tinggi'; lfCellCls = 'fin-critical';
                } else if (lfVal < 30) {
                    lfCls = 'text-warning'; lfLabel = 'Under-utilized'; lfCellCls = 'fin-warning';
                } else {
                    lfCls = 'text-success'; lfLabel = 'Optimal'; lfCellCls = 'fin-ok';
                }
                $('#finLf').attr('class', 'fin-metric ' + lfCellCls);
                $('#finLfValue').attr('class', 'fin-metric-value ' + lfCls).text(lfPct + '%');
                var lfSub = lfLabel;
                if (lf.maxCapacity) lfSub += ' · Max ' + formatDecimal(lf.maxCapacity / 1000) + ' kVA';
                if (lf.status) lfSub += ' · ' + lf.status;
                $('#finLfSub').text(lfSub);
            } else if (lf.configured === false) {
                $('#finLf').attr('class', 'fin-metric');
                $('#finLfValue').attr('class', 'fin-metric-value text-muted').text('—');
                $('#finLfSub').text('Belum dikonfigurasi');
            } else {
                $('#finLf').attr('class', 'fin-metric');
                $('#finLfValue').attr('class', 'fin-metric-value text-muted').text('—');
                $('#finLfSub').text('');
            }

            // Unit Economics — show both values with clear separation
            if ((ue.costPerM2 || ue.costPerM2 === 0) || (ue.costPerHour || ue.costPerHour === 0)) {
                var mainVal = '';
                if (ue.costPerM2) mainVal = 'Rp ' + formatInteger(ue.costPerM2) + '/m²';
                else if (ue.costPerHour) mainVal = 'Rp ' + formatInteger(ue.costPerHour) + '/jam';
                $('#finUeValue').attr('class', 'fin-metric-value').text(mainVal);
                var ueSub = [];
                if (ue.costPerM2 && ue.costPerHour) ueSub.push('Rp ' + formatInteger(ue.costPerHour) + '/jam');
                if (ue.surfaceArea) ueSub.push('Area: ' + formatDecimal(ue.surfaceArea) + ' m²');
                $('#finUeSub').text(ueSub.join(' · '));
                $('#finUe').attr('class', 'fin-metric');
            } else {
                $('#finUe').attr('class', 'fin-metric');
                $('#finUeValue').attr('class', 'fin-metric-value text-muted').text('—');
                $('#finUeSub').text('');
            }
        }

        // --- Anomaly Cost Impact ---
        function updateAnomalyCostUI(ac) {
            var $body = $('#anomalyCostBody');
            var totalCost = ac.estimatedCostImpact || ac.totalCost || 0;
            var totalAnomalies = ac.totalAnomalies || 0;
            var items = ac.anomalies || ac.topAnomalies || [];

            if (items.length === 0) {
                $body.html(
                    '<div class="text-center" style="font-size:0.8rem">' +
                        '<span class="text-muted">Dampak Biaya Anomali:</span> <strong class="text-primary">Rp ' + formatInteger(totalCost) + '</strong>' +
                        (totalAnomalies > 0 ? ' <span class="badge bg-secondary">' + totalAnomalies + ' anomali</span>' : '') +
                        '<div class="text-muted mt-1" style="font-size:0.7rem">Tidak ada anomali aktif</div>' +
                    '</div>'
                );
                return;
            }

            var html = '<div class="mb-2" style="font-size:0.8rem"><span class="text-muted">Total Dampak:</span> <strong class="text-danger">Rp ' + formatInteger(totalCost) + '</strong>';
            if (totalAnomalies > 0) html += ' <span class="badge bg-danger">' + totalAnomalies + ' anomali</span>';
            html += '</div>';
            html += '<div style="font-size:0.75rem">';

            items.forEach(function(a, i) {
                if (i >= 5) return;
                var icon = (a.anomalyType || a.type) === 'OVERLOAD' ? 'fa-arrow-up text-danger' : 'fa-arrow-down text-warning';
                var cost = a.estimatedCost || a.costImpact || 0;
                var name = a.deviceName || a.deviceKey || '—';
                var severity = a.severity || '';
                var sevBadge = severity === 'high' ? ' <span class="badge bg-danger">HIGH</span>' : (severity === 'medium' ? ' <span class="badge bg-warning text-dark">MED</span>' : '');
                html += '<div class="anomaly-cost-item d-flex justify-content-between align-items-center py-1' + (i < items.length - 1 && i < 4 ? ' border-bottom' : '') + '">' +
                    '<span class="anomaly-cost-name"><i class="fas ' + icon + '"></i> ' + name + sevBadge + '</span>' +
                    '<span class="text-danger fw-bold text-nowrap ms-2">Rp ' + formatInteger(cost) + '</span>' +
                '</div>';
            });

            html += '</div>';
            $body.html(html);
        }

        // ============================================
        // REPORTS — Daily / Monthly / Yearly
        // ============================================
        function renderAllReports() {
            generateDailyReport();
            generateMonthlyReport();
            generateYearlyReport();
        }

        function generateDailyReport() {
            var $body = $('#dailyReportBody');
            if (!$body.length) return;
            var ed = lastEnergyData;
            var fd = lastFinancialData;
            if (!ed && !fd) {
                $body.html('<div class="text-center text-muted py-2" style="font-size:0.8rem">Menunggu data...</div>');
                return;
            }

            var hourlyData = (ed && ed.hourlyData) || [];
            var totalToday = (ed && ed.totalToday) || 0;
            var dailyData = (ed && ed.dailyData) || [];
            var tariff = (fd && fd.avgTariffPerKWh) || (ed && ed.tariffPerKWh) || 1500;

            var wbpLwbp = (fd && fd.wbpLwbp) || {};
            var waste = (fd && fd.waste) || {};
            var budget = (fd && fd.budget) || {};
            var bp = (fd && fd.billProjection) || {};
            var lf = (fd && fd.loadFactorInfo) || {};
            var ac = (fd && fd.anomalyCostImpact) || {};
            var ti = (fd && fd.tariffTypeInfo) || {};
            var pc = (fd && fd.periodComparison) || {};

            // Compute insights
            var filledHours = hourlyData.filter(function(h) { return h.energy > 0; });
            var avgPerFilledHour = filledHours.length > 0 ? filledHours.reduce(function(s, h) { return s + h.energy; }, 0) / filledHours.length : 0;
            var peakHour = hourlyData.length > 0 ? hourlyData.reduce(function(max, h) { return h.energy > max.energy ? h : max; }, { energy: 0, timeLabel: '-' }) : { energy: 0, timeLabel: '-' };

            // Daily average from month data
            var filledDays = dailyData.filter(function(d) { return d.energy > 0; });
            var avgDailyKWh = filledDays.length > 0 ? filledDays.reduce(function(s, d) { return s + d.energy; }, 0) / filledDays.length : 0;
            var todayVsAvg = avgDailyKWh > 0 ? Math.round((totalToday / avgDailyKWh - 1) * 100 * 10) / 10 : 0;

            // Budget pace: daily budget = budgetKWh / daysInMonth
            var daysInMonth = new Date(new Date().getFullYear(), new Date().getMonth() + 1, 0).getDate();
            var dayOfMonth = new Date().getDate();
            var budgetPaceKWh = budget.configured && budget.budgetKWh > 0 ? budget.budgetKWh / daysInMonth : 0;
            var paceStatus = budgetPaceKWh > 0 ? (totalToday > budgetPaceKWh ? 'over' : 'under') : 'none';

            // Today's cost
            var todayCost = 0;
            if (wbpLwbp.configured && (wbpLwbp.wbpKWh + wbpLwbp.lwbpKWh) > 0) {
                var monthTotal = wbpLwbp.wbpKWh + wbpLwbp.lwbpKWh;
                if (ti.flatKWh) monthTotal += ti.flatKWh;
                var todayRatio = monthTotal > 0 ? totalToday / monthTotal : 0;
                todayCost = Math.round(((wbpLwbp.totalCostWBP || 0) + (ti.flatCost || 0)) * todayRatio);
            } else {
                todayCost = Math.round(totalToday * tariff);
            }

            // Build report HTML
            var html = '';
            html += '<div class="fin-metric-grid" style="margin-bottom:8px">';
            html += '<div class="fin-metric"><div class="fin-metric-label"><i class="fas fa-bolt text-primary"></i> Konsumsi</div>';
            html += '<div class="fin-metric-value' + (todayVsAvg > 20 ? ' text-danger' : (todayVsAvg > 10 ? ' text-warning' : (todayVsAvg < -10 ? ' text-success' : ''))) + '">' + formatDecimal(totalToday) + ' kWh</div>';
            html += '<div class="fin-metric-sub">' + (avgDailyKWh > 0 ? (todayVsAvg >= 0 ? '▲ ' : '▼ ') + Math.abs(todayVsAvg).toFixed(1) + '% vs rata-rata' : 'Rata-rata: ' + formatDecimal(avgPerFilledHour) + ' kWh/jam') + '</div></div>';
            html += '<div class="fin-metric"><div class="fin-metric-label"><i class="fas fa-coins text-warning"></i> Estimasi Biaya</div>';
            html += '<div class="fin-metric-value">' + 'Rp ' + formatInteger(todayCost) + '</div>';
            html += '<div class="fin-metric-sub">Tarif: ' + (wbpLwbp.configured ? 'WBP/LWBP' : 'Flat') + ' · ' + formatInteger(tariff) + '/kWh</div></div>';
            html += '<div class="fin-metric"><div class="fin-metric-label"><i class="fas fa-arrow-up text-info"></i> Jam Puncak</div>';
            html += '<div class="fin-metric-value">' + peakHour.timeLabel + '</div>';
            html += '<div class="fin-metric-sub">' + formatDecimal(peakHour.energy) + ' kWh · Rp ' + formatInteger(Math.round(peakHour.energy * tariff)) + '</div></div>';
            html += '</div>';

            html += '<div class="daily-report-insights">';
            html += '<div class="text-muted mb-1" style="font-size:0.7rem"><i class="fas fa-lightbulb"></i> INSIGHT</div>';
            var insights = [];

            if (todayVsAvg > 20) {
                insights.push('<span class="text-danger"> Konsumsi hari ini ' + todayVsAvg.toFixed(1) + '% di atas rata-rata harian (' + formatDecimal(avgDailyKWh) + ' kWh/hari)</span>');
            } else if (todayVsAvg < -20) {
                insights.push('<span class="text-success">Konsumsi hari ini ' + Math.abs(todayVsAvg).toFixed(1) + '% di bawah rata-rata — efisien</span>');
            } else if (avgDailyKWh > 0) {
                insights.push('Konsumsi hari ini mendekati rata-rata (selisih ' + Math.abs(todayVsAvg).toFixed(1) + '%)');
            }

            if (wbpLwbp.configured) {
                var wbpRatio = wbpLwbp.wbpRatio || 0;
                if (wbpRatio > 40) {
                    insights.push('<span class="text-warning"> Rasio WBP ' + wbpRatio.toFixed(1) + '% — pertimbangkan shift operasional ke jam LWBP</span>');
                } else {
                    insights.push('Rasio WBP ' + wbpRatio.toFixed(1) + '% — proporsi WBP terkontrol');
                }
            }

            if (paceStatus === 'over') {
                var overPct = budgetPaceKWh > 0 ? Math.round((totalToday / budgetPaceKWh - 1) * 100) : 0;
                insights.push('<span class="text-danger"> Pace hari ini ' + overPct + '% di atas pace budget (' + formatDecimal(budgetPaceKWh) + ' kWh/hari)</span>');
            } else if (paceStatus === 'under') {
                insights.push('<span class="text-success"> Pace hari ini sesuai budget (' + formatDecimal(budgetPaceKWh) + ' kWh/hari)</span>');
            }

            if (waste.configured && waste.wastePercent > 0) {
                if (waste.wastePercent > 5) {
                    insights.push('<span class="text-danger"> Waste ' + waste.wastePercent.toFixed(1) + '% — konsumsi saat downtime ' + (waste.downtimeStart || '') + '-' + (waste.downtimeEnd || '') + ' perlu ditinjau</span>');
                } else {
                    insights.push('Waste ' + waste.wastePercent.toFixed(1) + '% — dalam batas wajar');
                }
            }

            if (lf.configured) {
                if (lf.loadFactor > 80) {
                    insights.push('<span class="text-danger"> Load Factor ' + lf.loadFactor.toFixed(1) + '% — Risiko Tinggi</span>');
                } else if (lf.loadFactor < 30) {
                    insights.push('<span class="text-warning"> Load Factor ' + lf.loadFactor.toFixed(1) + '% — Under-utilized</span>');
                }
            }

            if (ac.totalAnomalies > 0) {
                insights.push('<span class="text-danger"> ' + ac.totalAnomalies + ' anomali bulan ini · dampak Rp ' + formatInteger(ac.estimatedCostImpact || 0) + '</span>');
            }

            if (ti.totalDeviceCount > 1) {
                insights.push(' ' + (ti.wbpDeviceCount || 0) + ' device WBP/LWBP, ' + (ti.flatDeviceCount || 0) + ' device Flat tariff');
            }

            if (pc.momChangePercent && Math.abs(pc.momChangePercent) > 5) {
                var momDir = pc.momChangePercent > 0 ? 'naik' : 'turun';
                insights.push('Bulan ini ' + momDir + ' ' + Math.abs(pc.momChangePercent).toFixed(1) + '% vs bulan lalu');
            }

            if (bp.projectedMonthKWh > 0 && budget.configured) {
                if (bp.projectedMonthKWh > budget.budgetKWh) {
                    insights.push('<span class="text-warning"> Proyeksi akhir bulan ' + formatDecimal(bp.projectedMonthKWh) + ' kWh — melebihi budget ' + formatDecimal(budget.budgetKWh) + ' kWh</span>');
                } else {
                    insights.push('<span class="text-success"> Proyeksi akhir bulan ' + formatDecimal(bp.projectedMonthKWh) + ' kWh — dalam budget</span>');
                }
            } else if (bp.projectedMonthKWh > 0) {
                insights.push(' Proyeksi akhir bulan: ' + formatDecimal(bp.projectedMonthKWh) + ' kWh (Rp ' + formatInteger(bp.projectedCost || 0) + ')');
            }

            if (insights.length === 0) {
                insights.push('<span class="text-muted">Data belum cukup untuk analisa</span>');
            }

            insights.forEach(function(insight) {
                html += '<div style="padding:2px 0; line-height:1.4">' + insight + '</div>';
            });
            html += '</div>';
            $body.html(html);
        }

        function generateMonthlyReport() {
            var $body = $('#monthlyReportBody');
            if (!$body.length) return;
            var fd = lastFinancialData;
            var ed = lastEnergyData;
            if (!fd && !ed) {
                $body.html('<div class="text-center text-muted py-2" style="font-size:0.8rem">Menunggu data...</div>');
                return;
            }

            var monthKwh = (ed && ed.totalThisMonth) || 0;
            var monthAvgPerDay = (ed && ed.avgPerDay) || 0;
            var monthPeakDay = (ed && ed.peakDay) || 0;
            var monthPeakDayDate = (ed && ed.peakDayDate) || '-';
            var tariff = (fd && fd.avgTariffPerKWh) || (ed && ed.tariffPerKWh) || 1500;
            var dailyData = (ed && ed.dailyData) || [];

            var wbpLwbp = (fd && fd.wbpLwbp) || {};
            var waste = (fd && fd.waste) || {};
            var budget = (fd && fd.budget) || {};
            var bp = (fd && fd.billProjection) || {};
            var lf = (fd && fd.loadFactorInfo) || {};
            var ac = (fd && fd.anomalyCostImpact) || {};
            var ti = (fd && fd.tariffTypeInfo) || {};
            var pc = (fd && fd.periodComparison) || {};
            var ue = (fd && fd.unitEconomics) || {};

            var dayOfMonth = new Date().getDate();
            var daysInMonth = new Date(new Date().getFullYear(), new Date().getMonth() + 1, 0).getDate();
            var actualCost = budget.actualCost || Math.round(monthKwh * tariff);
            var budgetKwh = budget.budgetKWh || 0;

            // Find peak day in daily data
            var peakDayInfo = dailyData.length > 0 ? dailyData.reduce(function(max, d) { return d.energy > max.energy ? d : max; }, { energy: 0, timeLabel: '-' }) : { energy: 0, timeLabel: '-' };

            var html = '';
            html += '<div class="fin-metric-grid" style="margin-bottom:8px">';

            // Konsumsi Bulan Ini
            html += '<div class="fin-metric"><div class="fin-metric-label"><i class="fas fa-calendar-week text-primary"></i> Konsumsi Bulan</div>';
            html += '<div class="fin-metric-value">' + formatDecimal(monthKwh) + ' kWh</div>';
            html += '<div class="fin-metric-sub">Rata² ' + formatDecimal(monthAvgPerDay) + ' kWh/hari · Hari ke-' + dayOfMonth + '</div></div>';

            // Biaya Bulan Ini
            html += '<div class="fin-metric"><div class="fin-metric-label"><i class="fas fa-coins text-warning"></i> Biaya Aktual</div>';
            html += '<div class="fin-metric-value">Rp ' + formatInteger(actualCost) + '</div>';
            html += '<div class="fin-metric-sub">' + (wbpLwbp.configured ? 'WBP/LWBP' : 'Flat') + ' · Rp ' + formatInteger(tariff) + '/kWh</div></div>';

            // Hari Puncak
            html += '<div class="fin-metric"><div class="fin-metric-label"><i class="fas fa-arrow-up text-info"></i> Hari Puncak</div>';
            html += '<div class="fin-metric-value">' + (peakDayInfo.timeLabel || monthPeakDayDate) + '</div>';
            html += '<div class="fin-metric-sub">' + formatDecimal(peakDayInfo.energy || monthPeakDay) + ' kWh</div></div>';

            // Proyeksi Akhir Bulan
            html += '<div class="fin-metric"><div class="fin-metric-label"><i class="fas fa-chart-line text-warning"></i> Proyeksi</div>';
            var projKwh = bp.projectedMonthKWh || 0;
            var projCost = bp.projectedCost || 0;
            html += '<div class="fin-metric-value">' + formatDecimal(projKwh) + ' kWh</div>';
            html += '<div class="fin-metric-sub">Rp ' + formatInteger(projCost) + ' · Sisa ' + (bp.daysRemaining || 0) + ' hari</div></div>';

            // Budget
            html += '<div class="fin-metric"><div class="fin-metric-label"><i class="fas fa-wallet text-success"></i> Budget</div>';
            if (budget.configured) {
                var budgetPct = budgetKwh > 0 ? Math.round(monthKwh / budgetKwh * 100) : 0;
                var bCls = budgetPct > 100 ? 'text-danger' : (budgetPct > 80 ? 'text-warning' : 'text-success');
                html += '<div class="fin-metric-value ' + bCls + '">' + budgetPct + '%</div>';
                html += '<div class="fin-metric-sub">Budget ' + formatDecimal(budgetKwh) + ' kWh · Variance ' + formatDecimal(budget.variance || 0) + '</div></div>';
            } else {
                html += '<div class="fin-metric-value text-muted">—</div>';
                html += '<div class="fin-metric-sub">Belum dikonfigurasi</div></div>';
            }

            // Load Factor
            html += '<div class="fin-metric"><div class="fin-metric-label"><i class="fas fa-tachometer-alt text-warning"></i> Load Factor</div>';
            if (lf.configured) {
                var lfCls = lf.loadFactor > 80 ? 'text-danger' : (lf.loadFactor < 30 ? 'text-warning' : 'text-success');
                html += '<div class="fin-metric-value ' + lfCls + '">' + (lf.loadFactor || 0).toFixed(1) + '%</div>';
                html += '<div class="fin-metric-sub">' + (lf.status || 'N/A') + '</div></div>';
            } else {
                html += '<div class="fin-metric-value text-muted">—</div>';
                html += '<div class="fin-metric-sub">Belum dikonfigurasi</div></div>';
            }

            html += '</div>';

            // Monthly insights
            html += '<div class="daily-report-insights">';
            html += '<div class="text-muted mb-1" style="font-size:0.7rem"><i class="fas fa-lightbulb"></i> INSIGHT BULANAN</div>';
            var insights = [];

            // MoM
            if (pc.momChangePercent !== undefined && pc.lastMonthKWh > 0) {
                var momArr = pc.momChangePercent > 0 ? '▲' : '▼';
                var momCls = pc.momChangePercent > 10 ? 'text-danger' : (pc.momChangePercent < -10 ? 'text-success' : '');
                insights.push('<span class="' + momCls + '">' + momArr + ' MoM ' + Math.abs(pc.momChangePercent).toFixed(1) + '% vs bulan lalu (' + formatDecimal(pc.lastMonthKWh) + ' kWh)</span>');
            }

            // YoY
            if (pc.yoyChangePercent !== undefined && pc.lastYearSameMonthKWh > 0) {
                var yoyArr = pc.yoyChangePercent > 0 ? '▲' : '▼';
                var yoyCls = pc.yoyChangePercent > 20 ? 'text-danger' : (pc.yoyChangePercent < -20 ? 'text-success' : '');
                insights.push('<span class="' + yoyCls + '">' + yoyArr + ' YoY ' + Math.abs(pc.yoyChangePercent).toFixed(1) + '% vs tahun lalu bulan yang sama (' + formatDecimal(pc.lastYearSameMonthKWh) + ' kWh)</span>');
            }

            // WBP/LWBP
            if (wbpLwbp.configured) {
                var wbpTotal = wbpLwbp.wbpKwh + wbpLwbp.lwbpKwh;
                if (wbpTotal > 0) {
                    var wbpRatio = (wbpLwbp.wbpKwh / wbpTotal * 100).toFixed(1);
                    insights.push(' WBP ' + wbpRatio + '% (' + formatDecimal(wbpLwbp.wbpKwh) + ' kWh) · LWBP ' + (100 - parseFloat(wbpRatio)).toFixed(1) + '% (' + formatDecimal(wbpLwbp.lwbpKwh) + ' kWh) · Total Rp ' + formatInteger(wbpLwbp.totalCostWBP || 0));
                }
            }

            // Waste
            if (waste.configured && waste.wastePercent > 0) {
                if (waste.wastePercent > 5) {
                    insights.push('<span class="text-danger"> Waste ' + waste.wastePercent.toFixed(1) + '% = ' + formatDecimal(waste.wasteKwh) + ' kWh (Rp ' + formatInteger(waste.wasteCost) + ') — downtime ' + (waste.downtimeStart || '') + '-' + (waste.downtimeEnd || '') + '</span>');
                } else {
                    insights.push(' Waste ' + waste.wastePercent.toFixed(1) + '% = ' + formatDecimal(waste.wasteKwh) + ' kWh (Rp ' + formatInteger(waste.wasteCost) + ')');
                }
            }

            // Projection vs budget
            if (projKwh > 0 && budget.configured && budgetKwh > 0) {
                if (projKwh > budgetKwh) {
                    insights.push('<span class="text-danger"> Proyeksi ' + formatDecimal(projKwh) + ' kWh melebihi budget ' + formatDecimal(budgetKwh) + ' kWh — perlu penghematan ' + formatDecimal(projKwh - budgetKwh) + ' kWh</span>');
                } else {
                    insights.push('<span class="text-success"> Proyeksi ' + formatDecimal(projKwh) + ' kWh — dalam budget, sisa ' + formatDecimal(budgetKwh - projKwh) + ' kWh</span>');
                }
            }

            // Unit Economics
            if (ue.configured && ue.costPerM2 > 0) {
                insights.push(' Biaya per m²: Rp ' + formatInteger(ue.costPerM2) + ' · Biaya per jam: Rp ' + formatInteger(ue.costPerHour || 0));
            }

            // Anomaly
            if (ac.totalAnomalies > 0) {
                insights.push('<span class="text-danger"> ' + ac.totalAnomalies + ' anomali bulan ini · dampak Rp ' + formatInteger(ac.estimatedCostImpact || 0) + '</span>');
            }

            // Device tariff mix
            if (ti.totalDeviceCount > 1) {
                insights.push(' ' + (ti.wbpDeviceCount || 0) + ' device WBP/LWBP, ' + (ti.flatDeviceCount || 0) + ' device Flat');
            }

            if (insights.length === 0) {
                insights.push('<span class="text-muted">Data belum cukup untuk analisa bulanan</span>');
            }

            insights.forEach(function(insight) {
                html += '<div style="padding:2px 0; line-height:1.4">' + insight + '</div>';
            });
            html += '</div>';
            $body.html(html);
        }

        function generateYearlyReport() {
            var $body = $('#yearlyReportBody');
            if (!$body.length) return;
            var ed = lastEnergyData;
            var fd = lastFinancialData;
            if (!ed && !fd) {
                $body.html('<div class="text-center text-muted py-2" style="font-size:0.8rem">Menunggu data...</div>');
                return;
            }

            var yearKwh = (ed && ed.totalThisYear) || 0;
            var yearAvgPerMonth = (ed && ed.avgPerMonth) || 0;
            var yearPeakMonth = (ed && ed.peakMonth) || 0;
            var yearPeakMonthName = (ed && ed.peakMonthName) || '-';
            var monthlyData = (ed && ed.monthlyData) || [];
            var tariff = (fd && fd.avgTariffPerKWh) || (ed && ed.tariffPerKWh) || 1500;
            var monthKwh = (ed && ed.totalThisMonth) || 0;

            var wbpLwbp = (fd && fd.wbpLwbp) || {};
            var waste = (fd && fd.waste) || {};
            var budget = (fd && fd.budget) || {};
            var pc = (fd && fd.periodComparison) || {};
            var ti = (fd && fd.tariffTypeInfo) || {};

            var currentMonth = new Date().getMonth() + 1;

            // Year cost: use actualCost from financial data (includes WBP/LWBP) when available
            var yearCost = 0;
            if (budget && budget.actualCost > 0 && monthKwh > 0 && yearKwh > 0) {
                yearCost = Math.round(budget.actualCost / monthKwh * yearKwh);
            } else {
                yearCost = Math.round(yearKwh * tariff);
            }

            // Find peak month from monthly data
            var peakMonthInfo = monthlyData.length > 0 ? monthlyData.reduce(function(max, m) { return m.energy > max.energy ? m : max; }, { energy: 0, timeLabel: '-' }) : { energy: 0, timeLabel: '-' };

            // Yearly budget estimate: monthly budget × 12
            var yearlyBudget = budget.configured && budget.budgetKWh > 0 ? budget.budgetKWh * 12 : 0;

            // Best & worst months
            var bestMonth = monthlyData.length > 0 ? monthlyData.reduce(function(min, m) { return m.energy > 0 && m.energy < min.energy ? m : min; }, { energy: Infinity, timeLabel: '-' }) : null;
            var worstMonth = peakMonthInfo;

            var html = '';
            html += '<div class="fin-metric-grid" style="margin-bottom:8px">';

            // Total Tahun Ini
            html += '<div class="fin-metric"><div class="fin-metric-label"><i class="fas fa-calendar text-primary"></i> Total Tahun</div>';
            html += '<div class="fin-metric-value">' + formatDecimal(yearKwh) + ' kWh</div>';
            html += '<div class="fin-metric-sub">Rata² ' + formatDecimal(yearAvgPerMonth) + ' kWh/bulan · Bulan ke-' + currentMonth + '</div></div>';

            // Biaya Tahunan
            html += '<div class="fin-metric"><div class="fin-metric-label"><i class="fas fa-coins text-warning"></i> Biaya Tahunan</div>';
            html += '<div class="fin-metric-value">Rp ' + formatInteger(yearCost) + '</div>';
            html += '<div class="fin-metric-sub">Rata² Rp ' + formatInteger(Math.round(yearCost / Math.max(currentMonth, 1))) + '/bulan</div></div>';

            // Bulan Puncak
            html += '<div class="fin-metric"><div class="fin-metric-label"><i class="fas fa-arrow-up text-danger"></i> Bulan Puncak</div>';
            html += '<div class="fin-metric-value">' + (peakMonthInfo.timeLabel || yearPeakMonthName) + '</div>';
            html += '<div class="fin-metric-sub">' + formatDecimal(peakMonthInfo.energy || yearPeakMonth) + ' kWh</div></div>';

            // Bulan Terendah
            html += '<div class="fin-metric"><div class="fin-metric-label"><i class="fas fa-arrow-down text-success"></i> Bulan Terendah</div>';
            if (bestMonth && bestMonth.energy > 0 && bestMonth.energy < Infinity) {
                html += '<div class="fin-metric-value">' + bestMonth.timeLabel + '</div>';
                html += '<div class="fin-metric-sub">' + formatDecimal(bestMonth.energy) + ' kWh</div></div>';
            } else {
                html += '<div class="fin-metric-value text-muted">—</div>';
                html += '<div class="fin-metric-sub">Data belum cukup</div></div>';
            }

            // YoY
            html += '<div class="fin-metric"><div class="fin-metric-label"><i class="fas fa-sync-alt text-info"></i> YoY</div>';
            if (pc.yoyChangePercent !== undefined && pc.lastYearSameMonthKWh > 0) {
                var yoyArr = pc.yoyChangePercent > 0 ? '▲' : '▼';
                var yoyCls = pc.yoyChangePercent > 20 ? 'text-danger' : (pc.yoyChangePercent < -20 ? 'text-success' : '');
                html += '<div class="fin-metric-value ' + yoyCls + '">' + yoyArr + ' ' + Math.abs(pc.yoyChangePercent).toFixed(1) + '%</div>';
                html += '<div class="fin-metric-sub">vs bulan sama tahun lalu</div></div>';
            } else {
                html += '<div class="fin-metric-value text-muted">—</div>';
                html += '<div class="fin-metric-sub">Data tahun lalu belum tersedia</div></div>';
            }

            // Budget Tahunan
            html += '<div class="fin-metric"><div class="fin-metric-label"><i class="fas fa-wallet text-success"></i> Budget Tahunan</div>';
            if (yearlyBudget > 0) {
                var yBudgetPct = Math.round(yearKwh / yearlyBudget * 100);
                var ybCls = yBudgetPct > 100 ? 'text-danger' : (yBudgetPct > 80 ? 'text-warning' : 'text-success');
                html += '<div class="fin-metric-value ' + ybCls + '">' + yBudgetPct + '%</div>';
                html += '<div class="fin-metric-sub">Est. ' + formatDecimal(yearlyBudget) + ' kWh/tahun</div></div>';
            } else {
                html += '<div class="fin-metric-value text-muted">—</div>';
                html += '<div class="fin-metric-sub">Belum dikonfigurasi</div></div>';
            }

            html += '</div>';

            // Yearly insights
            html += '<div class="daily-report-insights">';
            html += '<div class="text-muted mb-1" style="font-size:0.7rem"><i class="fas fa-lightbulb"></i> INSIGHT TAHUNAN</div>';
            var insights = [];

            // Average daily cost
            var daysThisYear = Math.floor((new Date() - new Date(new Date().getFullYear(), 0, 1)) / 86400000) + 1;
            var avgDailyCost = daysThisYear > 0 ? Math.round(yearCost / daysThisYear) : 0;
            insights.push(' Rata-rata biaya harian: Rp ' + formatInteger(avgDailyCost) + ' · Bulanan: Rp ' + formatInteger(Math.round(yearCost / Math.max(currentMonth, 1))));

            // YoY trend
            if (pc.yoyChangePercent !== undefined && pc.lastYearSameMonthKWh > 0) {
                if (pc.yoyChangePercent > 20) {
                    insights.push('<span class="text-danger"> Tren naik signifikan — konsumsi bulan ini ' + Math.abs(pc.yoyChangePercent).toFixed(1) + '% lebih tinggi dari tahun lalu</span>');
                } else if (pc.yoyChangePercent < -20) {
                    insights.push('<span class="text-success"> Tren turun — konsumsi bulan ini ' + Math.abs(pc.yoyChangePercent).toFixed(1) + '% lebih rendah dari tahun lalu</span>');
                } else {
                    insights.push('Konsumsi bulan ini relatif stabil vs tahun lalu (selisih ' + Math.abs(pc.yoyChangePercent || 0).toFixed(1) + '%)');
                }
            }

            // Peak vs avg ratio
            if (peakMonthInfo.energy > 0 && yearAvgPerMonth > 0) {
                var peakVsAvg = Math.round(peakMonthInfo.energy / yearAvgPerMonth * 100 - 100);
                if (peakVsAvg > 50) {
                    insights.push('<span class="text-warning"> Bulan puncak ' + peakVsAvg + '% di atas rata-rata — pertimbangkan penjadwalan ulang beban</span>');
                }
            }

            // WBP contribution
            if (wbpLwbp.configured && (wbpLwbp.wbpKwh + wbpLwbp.lwbpKwh) > 0) {
                var wbpTotal = wbpLwbp.wbpKwh + wbpLwbp.lwbpKwh;
                var wbpPct = (wbpLwbp.wbpKwh / wbpTotal * 100).toFixed(1);
                var lwbpPct = (100 - parseFloat(wbpPct)).toFixed(1);
                insights.push(' Proporsi tahunan WBP ' + wbpPct + '% · LWBP ' + lwbpPct + '% — biaya WBP Rp ' + formatInteger(wbpLwbp.wbpCost || 0) + ' vs LWBP Rp ' + formatInteger(wbpLwbp.lwbpCost || 0));
            }

            // Waste annualized
            if (waste.configured && waste.wastePercent > 0) {
                var annualWasteKWh = waste.wasteKwh * 12;
                var annualWasteCost = waste.wasteCost * 12;
                insights.push('<span class="' + (waste.wastePercent > 5 ? 'text-danger' : '') + '"> Waste ' + waste.wastePercent.toFixed(1) + '% · Estimasi tahunan: ' + formatDecimal(annualWasteKWh) + ' kWh (Rp ' + formatInteger(annualWasteCost) + ')</span>');
            }

            // Budget pace
            if (yearlyBudget > 0) {
                var yBudgetPct2 = Math.round(yearKwh / yearlyBudget * 100);
                var expectedPctByNow = Math.round(currentMonth / 12 * 100);
                if (yBudgetPct2 > expectedPctByNow + 10) {
                    insights.push('<span class="text-danger"> Penggunaan ' + yBudgetPct2 + '% dari budget tahunan, padahal baru ' + expectedPctByNow + '% waktu — over pace</span>');
                } else {
                    insights.push('<span class="text-success"> Penggunaan ' + yBudgetPct2 + '% dari budget tahunan · Pace ' + expectedPctByNow + '% — sesuai target</span>');
                }
            }

            // Device mix
            if (ti.totalDeviceCount > 1) {
                insights.push(' ' + (ti.wbpDeviceCount || 0) + ' device WBP/LWBP, ' + (ti.flatDeviceCount || 0) + ' device Flat');
            }

            // Projection to year end
            if (yearKwh > 0 && currentMonth > 1) {
                var projectedYearKwh = Math.round(yearKwh / currentMonth * 12);
                var projectedYearCost = Math.round(projectedYearKwh * tariff);
                insights.push(' Proyeksi akhir tahun: ' + formatDecimal(projectedYearKwh) + ' kWh (Rp ' + formatInteger(projectedYearCost) + ')');
            }

            if (insights.length === 0) {
                insights.push('<span class="text-muted">Data belum cukup untuk analisa tahunan</span>');
            }

            insights.forEach(function(insight) {
                html += '<div style="padding:2px 0; line-height:1.4">' + insight + '</div>';
            });
            html += '</div>';
            $body.html(html);
        }

        function formatNumber(num) {
            if (!num) return '0';
            return Number(num).toLocaleString('id-ID');
        }

        function formatInteger(num) {
            if (!num) return '0';
            return Number(num).toLocaleString('id-ID', { maximumFractionDigits: 0 });
        }

        function formatDecimal(num) {
            if (!num) return '0,00';
            return Number(num).toLocaleString('id-ID', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        }
    </script>
}
