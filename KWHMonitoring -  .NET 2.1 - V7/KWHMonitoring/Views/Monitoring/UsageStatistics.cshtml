        }

        function updateConsumptionProjectionChart() {
            var ed = lastEnergyData;
            var fd = lastFinancialData;
            if (!ed && !fd) return;

            var $canvas = $('#projectionChart');
            var $footer = $('#projectionFooter');

            if (activeProjectionTab === 'monthly') {
                renderMonthlyConsumptionProjection(ed, fd, $canvas, $footer);
            } else {
                renderYearlyConsumptionProjection(ed, fd, $canvas, $footer);
            }
        }

        function renderMonthlyConsumptionProjection(ed, fd, $canvas, $footer) {
            var now = new Date();
            var daysInMonth = new Date(now.getFullYear(), now.getMonth() + 1, 0).getDate();
            var dayOfMonth = now.getDate();

            var dailyData = (ed && ed.dailyData) || [];
            var budget = (fd && fd.budget) || {};
            var bp = (fd && fd.billProjection) || {};

            // Build actual daily values array (index 0 = day 1)
            var actualDaily = new Array(daysInMonth).fill(0);
            dailyData.forEach(function(d) {
                var idx = (d.sortKey || 0) - 1;
                if (idx >= 0 && idx < daysInMonth) actualDaily[idx] = d.energy || 0;
            });

            // Calculate average from filled days (days with consumption > 0 up to today)
            var filledDays = 0, filledSum = 0;
            for (var i = 0; i < Math.min(dayOfMonth, daysInMonth); i++) {
                if (actualDaily[i] > 0) { filledDays++; filledSum += actualDaily[i]; }
            }

            // Weighted average: recent 7 days get 60% weight, older days get 40%
            var recentWindow = 7;
            var recentSum = 0, recentCount = 0;
            var olderSum = 0, olderCount = 0;
            var cutoff = Math.max(0, dayOfMonth - recentWindow);
            for (var i = cutoff; i < Math.min(dayOfMonth, daysInMonth); i++) {
                if (actualDaily[i] > 0) { recentSum += actualDaily[i]; recentCount++; }
            }
            for (var i = 0; i < cutoff; i++) {
                if (actualDaily[i] > 0) { olderSum += actualDaily[i]; olderCount++; }
            }
            var recentAvg = recentCount > 0 ? recentSum / recentCount : 0;
            var olderAvg = olderCount > 0 ? olderSum / olderCount : 0;
            var projectedDailyKWh;
            if (recentAvg > 0 && olderAvg > 0) {
                projectedDailyKWh = recentAvg * 0.6 + olderAvg * 0.4;
            } else if (recentAvg > 0) {
                projectedDailyKWh = recentAvg;
            } else if (olderAvg > 0) {
                projectedDailyKWh = olderAvg;
            } else {
                projectedDailyKWh = filledDays > 0 ? filledSum / filledDays : 0;
            }

            // Build projected daily values for remaining days
            var projectedDaily = new Array(daysInMonth).fill(0);
            for (var i = 0; i < daysInMonth; i++) {
                if (i < dayOfMonth) {
                    projectedDaily[i] = actualDaily[i]; // actual
                } else {
                    projectedDaily[i] = projectedDailyKWh; // projected
                }
            }

            // Cumulative arrays
            var actualCumulative = [];
            var projectedCumulative = [];
            var budgetPaceLine = [];
            var cumActual = 0, cumProjected = 0;
            var budgetKwh = budget.budgetKWh || 0;
            var dailyBudgetPace = budgetKwh > 0 ? budgetKwh / daysInMonth : 0;

            for (var i = 0; i < daysInMonth; i++) {
                if (i < dayOfMonth) {
                    cumActual += actualDaily[i];
                    actualCumulative.push(cumActual);
                    projectedCumulative.push(cumActual);
                } else {
                    actualCumulative.push(null);
                    cumProjected += projectedDaily[i];
                    projectedCumulative.push(cumActual + cumProjected);
                }
                budgetPaceLine.push(dailyBudgetPace * (i + 1));
            }

            // Labels
            var labels = [];
            for (var i = 1; i <= daysInMonth; i++) labels.push(i);

            // Total projections
            var totalActualMonth = 0;
            for (var i = 0; i < dayOfMonth; i++) totalActualMonth += actualDaily[i];
            var totalProjectedMonth = totalActualMonth + projectedDailyKWh * (daysInMonth - dayOfMonth);

            var datasets = [
                {
                    label: 'Aktual (kWh)',
                    data: actualDaily.slice(0, dayOfMonth).concat(new Array(daysInMonth - dayOfMonth).fill(null)),
                    type: 'bar',
                    backgroundColor: 'rgba(59, 130, 246, 0.7)',
                    borderColor: 'rgba(59, 130, 246, 1)',
                    borderWidth: 1,
                    borderRadius: 2,
                    order: 3
                },
                {
                    label: 'Proyeksi (kWh)',
                    data: new Array(dayOfMonth).fill(null).concat(projectedDaily.slice(dayOfMonth)),
                    type: 'bar',
                    backgroundColor: 'rgba(251, 146, 60, 0.4)',
                    borderColor: 'rgba(251, 146, 60, 0.8)',
                    borderWidth: 1,
                    borderDash: [3, 3],
                    borderRadius: 2,
                    order: 3
                },
                {
                    label: 'Kumulatif Aktual',
                    data: actualCumulative,
                    type: 'line',
                    borderColor: 'rgba(59, 130, 246, 1)',
                    backgroundColor: 'rgba(59, 130, 246, 0.1)',
                    borderWidth: 2,
                    pointRadius: 0,
                    pointHitRadius: 0,
                    fill: false,
                    tension: 0.3,
                    order: 1
                },
                {
                    label: 'Kumulatif Proyeksi',
                    data: projectedCumulative,
                    type: 'line',
                    borderColor: 'rgba(251, 146, 60, 0.9)',
                    borderWidth: 2,
                    borderDash: [5, 3],
                    pointRadius: 0,
                    pointHitRadius: 0,
                    fill: false,
                    tension: 0.3,
                    order: 1
                }
            ];

            if (budgetKwh > 0) {
                datasets.push({
                    label: 'Anggaran',
                    data: budgetPaceLine,
                    type: 'line',
                    borderColor: 'rgba(34, 197, 94, 0.8)',
                    borderWidth: 2,
                    borderDash: [8, 4],
                    pointRadius: 0,
                    pointHitRadius: 0,
                    fill: false,
                    order: 0
                });
            }

            projectionChartInstance = renderUsageChart('projection', $canvas[0].getContext('2d'), {
                type: 'bar',
                data: { labels: labels, datasets: datasets },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    interaction: { intersect: false, mode: 'index' },
                    plugins: {
                        legend: { display: true, position: 'top', labels: { font: { size: 10 }, boxWidth: 12 } },
                        tooltip: {
                            callbacks: {
                                label: function(ctx) {
                                    var val = ctx.parsed.y;
                                    if (val === null || val === undefined) return null;
                                    return ctx.dataset.label + ': ' + formatDecimal(val) + ' kWh';
                                }
                            }
                        }
                    },
                    scales: {
                        x: { grid: { display: false }, ticks: { font: { size: 9 }, maxTicksLimit: 15 } },
                        y: { beginAtZero: true, grid: { color: 'rgba(0,0,0,0.06)' }, ticks: { font: { size: 9 }, callback: function(v) { return formatDecimal(v); } } }
                    }
                }
            });

            // Footer
            var footerHtml = '';
            footerHtml += '<div><strong>Aktual:</strong> ' + formatDecimal(totalActualMonth) + ' kWh · <strong>Proyeksi EOM:</strong> ' + formatDecimal(totalProjectedMonth) + ' kWh</div>';
                footerHtml += '<div>Rata-rata aktual: ' + formatDecimal(filledDays > 0 ? filledSum / filledDays : 0) + ' kWh/hari · Proyeksi sisa: ' + formatDecimal(projectedDailyKWh) + ' kWh/hari · Sisa ' + (daysInMonth - dayOfMonth) + ' hari</div>';
            if (budgetKwh > 0) {
                var bPct = Math.round(totalProjectedMonth / budgetKwh * 100);
                var bCls = bPct > 100 ? 'text-danger' : (bPct > 80 ? 'text-warning' : 'text-success');
                footerHtml += '<div class="' + bCls + '">Proyeksi dibandingkan dengan anggaran: ' + bPct + '% (' + formatDecimal(budgetKwh) + ' kWh) · Selisih ' + formatDecimal(totalProjectedMonth - budgetKwh) + ' kWh</div>';
            }
            $footer.html(footerHtml).show();
        }

        function renderYearlyConsumptionProjection(ed, fd, $canvas, $footer) {
            var now = new Date();
            var currentMonth = now.getMonth() + 1; // 1-12

            var monthlyData = (ed && ed.monthlyData) || [];
            var budget = (fd && fd.budget) || {};
            var tariff = (fd && fd.avgTariffPerKWh) || (ed && ed.tariffPerKWh) || 1500;

            var monthLabels = ['Jan', 'Feb', 'Mar', 'Apr', 'Mei', 'Jun', 'Jul', 'Ags', 'Sep', 'Okt', 'Nov', 'Des'];

            // Build actual monthly values
            var actualMonthly = new Array(12).fill(0);
            monthlyData.forEach(function(m) {
                var idx = (m.sortKey || 0) - 1;
                if (idx >= 0 && idx < 12) actualMonthly[idx] = m.energy || 0;
            });

            // Calculate average from filled months
            var filledMonths = 0, filledSum = 0;
            for (var i = 0; i < currentMonth; i++) {
                if (actualMonthly[i] > 0) { filledMonths++; filledSum += actualMonthly[i]; }
            }

            // Weighted: recent 3 months 60%, older 40%
            var recentWindow = 3;
            var recentSum = 0, recentCount = 0;
            var olderSum = 0, olderCount = 0;
            var cutoff = Math.max(0, currentMonth - recentWindow);
            for (var i = cutoff; i < currentMonth; i++) {
                if (actualMonthly[i] > 0) { recentSum += actualMonthly[i]; recentCount++; }
            }
            for (var i = 0; i < cutoff; i++) {
                if (actualMonthly[i] > 0) { olderSum += actualMonthly[i]; olderCount++; }
            }
            var recentAvg = recentCount > 0 ? recentSum / recentCount : 0;
            var olderAvg = olderCount > 0 ? olderSum / olderCount : 0;
            var projectedMonthlyKWh;
            if (recentAvg > 0 && olderAvg > 0) {
                projectedMonthlyKWh = recentAvg * 0.6 + olderAvg * 0.4;
            } else if (recentAvg > 0) {
                projectedMonthlyKWh = recentAvg;
            } else if (olderAvg > 0) {
                projectedMonthlyKWh = olderAvg;
            } else {
                projectedMonthlyKWh = filledMonths > 0 ? filledSum / filledMonths : 0;
            }

            // Cumulative
            var actualCumulative = [];
            var projectedCumulative = [];
            var budgetPaceLine = [];
            var cumActual = 0, cumProjected = 0;
            var budgetKwh = budget.budgetKWh || 0;
            var yearlyBudget = budgetKwh > 0 ? budgetKwh * 12 : 0;
            var monthlyBudgetPace = yearlyBudget > 0 ? yearlyBudget / 12 : 0;

            for (var i = 0; i < 12; i++) {
                if (i < currentMonth) {
                    cumActual += actualMonthly[i];
                    actualCumulative.push(cumActual);
                    projectedCumulative.push(cumActual);
                } else {
                    actualCumulative.push(null);
                    cumProjected += projectedMonthlyKWh;
                    projectedCumulative.push(cumActual + cumProjected);
                }
                budgetPaceLine.push(monthlyBudgetPace * (i + 1));
            }

            var totalActualYear = cumActual;
            var totalProjectedYear = totalActualYear + projectedMonthlyKWh * (12 - currentMonth);

            var datasets = [
                {
                    label: 'Aktual (kWh)',
                    data: actualMonthly.slice(0, currentMonth).concat(new Array(12 - currentMonth).fill(null)),
                    type: 'bar',
                    backgroundColor: 'rgba(99, 102, 241, 0.7)',
                    borderColor: 'rgba(99, 102, 241, 1)',
                    borderWidth: 1,
                    borderRadius: 3,
                    order: 3
                },
                {
                    label: 'Proyeksi (kWh)',
                    data: new Array(currentMonth).fill(null).concat(new Array(12 - currentMonth).fill(projectedMonthlyKWh)),
                    type: 'bar',
                    backgroundColor: 'rgba(251, 146, 60, 0.35)',
                    borderColor: 'rgba(251, 146, 60, 0.7)',
                    borderWidth: 1,
                    borderDash: [3, 3],
                    borderRadius: 3,
                    order: 3
                },
                {
                    label: 'Kumulatif Aktual',
                    data: actualCumulative,
                    type: 'line',
                    borderColor: 'rgba(99, 102, 241, 1)',
