                        centerText: {
                            line1: pct + '%',
                            line2: isOver ? 'Melebihi Anggaran' : 'terpakai',
                            line3: isOver ? 'Over ' + (pct - 100) + '%' : 'Sisa ' + (100 - pct) + '%',
                            color1: isOver ? '#dc3545' : (pct > 80 ? '#856404' : '#198754'),
                            color2: '#888',
                            color3: isOver ? '#dc3545' : '#aaa'
                        },
                        tooltip: {
                            callbacks: {
                                label: function(ctx) {
                                    return ctx.label + ': ' + formatDecimal(ctx.parsed) + ' kWh';
