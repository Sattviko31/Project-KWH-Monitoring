            footerHtml += '<div>Rata-rata bulanan aktual: ' + formatDecimal(filledMonths > 0 ? filledSum / filledMonths : 0) + ' kWh · Proyeksi sisa bulan: ' + formatDecimal(projectedMonthlyKWh) + ' kWh/bulan · Sisa ' + (12 - currentMonth) + ' bulan</div>';
            if (yearlyBudget > 0) {
                var yPct = Math.round(totalProjectedYear / yearlyBudget * 100);
