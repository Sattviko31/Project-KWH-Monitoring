            var waste = (fd && fd.waste) || {};
            var budget = (fd && fd.budget) || {};
            var bp = (fd && fd.billProjection) || {};
            var lf = (fd && fd.loadFactorInfo) || {};
            var ac = (fd && fd.anomalyCostImpact) || {};
            var ti = (fd && fd.tariffTypeInfo) || {};
            var pc = (fd && fd.periodComparison) || {};
            var ue = (fd && fd.unitEconomics) || {};

            var dayOfMonth = new Date().getDate();
            var daysInMonth = new Date(new Date().getFullYear(), new Date().getMonth() + 1, 0).getDate();
            var actualCost = budget.actualCost || Math.round(monthKwh * tariff);
            var budgetKwh = budget.budgetKWh || 0;

            // Find peak day in daily data
            var peakDayInfo = dailyData.length > 0 ? dailyData.reduce(function(max, d) { return d.energy > max.energy ? d : max; }, { energy: 0, timeLabel: '-' }) : { energy: 0, timeLabel: '-' };

            var html = '';
            html += '<div class="fin-metric-grid" style="margin-bottom:8px">';

            // Konsumsi Bulan Ini
