        // ============================================
        // FINANCIAL ANALYSIS UI
        // ============================================

        // --- Client-side aggregation from per-device financial data ---
        function showFinancialLoading() {
            // Saat refresh, pertahankan data yang sudah tampil agar tidak berkedip.
            // Hanya tampilkan placeholder loading pada load pertama.
            if (lastFinancialData) {
                return;
            }

            $('#finWasteValue, #finMomValue, #finYoyValue, #finBillValue, #finLfValue, #finUeValue')
                .attr('class', 'fin-metric-value text-muted').text('⏳');
            $('#finWasteSub, #finMomSub, #finYoySub, #finBillSub, #finLfSub, #finUeSub').text('Memuat...');
            $('#wbpLwbpNotConfigured').html('<i class="fas fa-spinner fa-spin"></i> Memuat data perangkat...').show();
            $('#budgetNotConfigured').html('<i class="fas fa-spinner fa-spin"></i> Memuat data perangkat...').show();
            $('#wbpLwbpChart, #budgetChart').hide();
            $('#wbpLwbpFooter, #budgetFooter').hide();
            $('#anomalyCostBody').html('<div class="text-center text-muted py-2" style="font-size:0.8rem"><i class="fas fa-spinner fa-spin"></i> Memuat data perangkat...</div>');
        }

        function aggregateFinancialData(deviceResults) {
            var wbpKwh = 0, lwbpKwh = 0, wbpCost = 0, lwbpCost = 0, totalCostWBP = 0;
            var anyWbpConfigured = false;
            var wbpStart, wbpEnd, tariffWBP, tariffLWBP;

            var wasteKwh = 0, wasteCost = 0;
            var anyWasteConfigured = false;
            var downtimeStart, downtimeEnd;

            var budgetKWh = 0, actualKWh = 0, budgetCost = 0, actualCost = 0;
            var anyBudgetConfigured = false;

            var lastMonthKWh = 0, momChange = 0;
            var lastYearSameMonthKWh = 0, yoyChange = 0;

            var projectedMonthKWh = 0, projectedCost = 0;
            var daysElapsed = 0, daysRemaining = 0;

            var totalAnomalies = 0, estimatedExcessKWh = 0, estimatedCostImpact = 0;
            var allAnomalies = [];

            var lfTotalKWh = 0, lfTotalMaxCapKVA = 0;
            var anyLFConfigured = false;

            var totalSurfaceArea = 0;
            var anyUEConfigured = false;

            // Tariff type tracking
            var wbpDeviceCount = 0, flatDeviceCount = 0;
            var flatKWh = 0, flatCost = 0;

            // Per-device tariff & estimated cost tracking
            var tariffSum = 0, tariffCount = 0;
            var totalEstimatedCost = 0;

            deviceResults.forEach(function(d) {
                if (!d) return;
                var deviceMonthKWh = (d.month && d.month.total) || 0;

                // Calculate effective tariff per device (weighted by consumption for WBP/LWBP)
                var devTariff = d.tariffPerKWh || 1500;
                if (d.wbpLwbp && d.wbpLwbp.configured && d.wbpLwbp.tariffWBP > 0 && d.wbpLwbp.tariffLWBP > 0) {
                    var wbpKwh = d.wbpLwbp.wbpKWh || 0;
                    var lwbpKwh = d.wbpLwbp.lwbpKWh || 0;
                    var wbpT = d.wbpLwbp.tariffWBP || 0;
                    var lwbpT = d.wbpLwbp.tariffLWBP || 0;
                    var totalDev = wbpKwh + lwbpKwh;
                    if (totalDev > 0) {
                        devTariff = Math.round((wbpKwh * wbpT + lwbpKwh * lwbpT) / totalDev);
                    } else {
                        devTariff = Math.round((wbpT + lwbpT) / 2);
                    }
                }
                tariffSum += devTariff;
                tariffCount++;

                // Sum per-device estimated cost (uses each device's own tariff/WBP)
                var devEstimatedCost = (d.budget && d.budget.actualCost) || 0;
                if (devEstimatedCost === 0 && deviceMonthKWh > 0) {
                    devEstimatedCost = Math.round(deviceMonthKWh * devTariff);
                }
                totalEstimatedCost += devEstimatedCost;

                // WBP/LWBP
                var w = d.wbpLwbp || {};
                if (w.configured) {
                    anyWbpConfigured = true;
                    wbpDeviceCount++;
                    wbpKwh += (w.wbpKWh || 0);
                    lwbpKwh += (w.lwbpKWh || 0);
                    wbpCost += (w.wbpCost || 0);
                    lwbpCost += (w.lwbpCost || 0);
                    totalCostWBP += (w.totalCostWBP || 0);
                    tariffWBP = w.tariffWBP;
                    tariffLWBP = w.tariffLWBP;
                    wbpStart = w.wbpStart;
                    wbpEnd = w.wbpEnd;
                } else {
                    // tarif tetap device
                    flatDeviceCount++;
                    flatKWh += deviceMonthKWh;
                    flatCost += (d.budget && d.budget.actualCost) || Math.round(deviceMonthKWh * (d.tariffPerKWh || 1500));
                }

                // Pemborosan energi
                var ws = d.waste || {};
                if (ws.configured) {
                    anyWasteConfigured = true;
                    wasteKwh += (ws.wasteKWh || 0);
                    wasteCost += (ws.wasteCost || 0);
                    downtimeStart = ws.downtimeStart;
                    downtimeEnd = ws.downtimeEnd;
                }

                // Budget
                var b = d.budget || {};
                if (b.configured) {
                    anyBudgetConfigured = true;
                    budgetKWh += (b.budgetKWh || 0);
                }
                // actualCost is always available regardless of anggaran configured
                actualKWh += (b.actualKWh || deviceMonthKWh);
                budgetCost += (b.budgetCost || 0);
                actualCost += (b.actualCost || Math.round(deviceMonthKWh * (d.tariffPerKWh || 1500)));

                // Period Comparison — sum absolute values
                var pc = d.periodComparison || {};
                lastMonthKWh += (pc.lastMonthKWh || 0);
                momChange += (pc.momChange || 0);
                lastYearSameMonthKWh += (pc.lastYearSameMonthKWh || 0);
                yoyChange += (pc.yoyChange || 0);

                // Bill Projection — sum per-device projections (each uses its own tariff)
                var bp = d.billProjection || {};
                projectedMonthKWh += (bp.projectedMonthKWh || 0);
                projectedCost += (bp.projectedCost || 0);
                daysElapsed = bp.daysElapsed || 0;
                daysRemaining = bp.daysRemaining || 0;

                // Anomaly Cost Impact — merge all devices
                var ac = d.anomalyCostImpact || {};
                totalAnomalies += (ac.totalAnomalies || 0);
                estimatedExcessKWh += (ac.estimatedExcessKWh || 0);
                estimatedCostImpact += (ac.estimatedCostImpact || 0);
                var items = ac.topAnomalies || ac.anomalies || [];
                allAnomalies = allAnomalies.concat(items);

                // Load Factor — accumulate for recalculation from totals
                var lf = d.loadFactorInfo || {};
                if (lf.configured && (lf.maxCapacity || 0) > 0) {
                    anyLFConfigured = true;
                    lfTotalKWh += deviceMonthKWh;
                    lfTotalMaxCapKVA += (lf.maxCapacity || 0) / 1000;
                }

                // Unit Economics — accumulate for recalculation
                var ue = d.unitEconomics || {};
                if (ue.configured && (ue.surfaceArea || 0) > 0) {
                    anyUEConfigured = true;
                    totalSurfaceArea += ue.surfaceArea;
                }
            });

            // Recalculate derived values from totals
            var totalConsumption = wbpKwh + lwbpKwh;
            if (totalConsumption === 0) totalConsumption = actualKWh;
            var wbpRatio = totalConsumption > 0 ? Math.round((wbpKwh / totalConsumption) * 100 * 10) / 10 : 0;
            var wastePercent = totalConsumption > 0 ? Math.round((wasteKwh / totalConsumption) * 100 * 10) / 10 : 0;
            var budgetVariance = anyBudgetConfigured ? Math.round((actualKWh - budgetKWh) * 100) / 100 : 0;
            var budgetVariancePct = (anyBudgetConfigured && budgetKWh > 0) ? Math.round((actualKWh - budgetKWh) / budgetKWh * 100 * 10) / 10 : 0;
            var momChangePercent = lastMonthKWh > 0 ? Math.round(momChange / lastMonthKWh * 100 * 10) / 10 : (actualKWh > 0 ? 100 : 0);
            var yoyChangePercent = lastYearSameMonthKWh > 0 ? Math.round(yoyChange / lastYearSameMonthKWh * 100 * 10) / 10 : (actualKWh > 0 ? 100 : 0);
            var loadFactor = (anyLFConfigured && lfTotalMaxCapKVA > 0 && daysElapsed > 0)
                ? Math.min(Math.round(lfTotalKWh / (lfTotalMaxCapKVA * daysElapsed * 24) * 100 * 10) / 10, 100)
                : 0;
            var lfStatus = loadFactor > 80 ? 'Risiko Tinggi' : loadFactor < 30 ? 'Kapasitas Kurang Dimanfaatkan' : 'Optimal';
            var costPerM2 = (anyUEConfigured && totalSurfaceArea > 0) ? Math.round(actualCost / totalSurfaceArea) : 0;
            var costPerHour = daysElapsed > 0 ? Math.round(actualCost / (daysElapsed * 24)) : 0;

            // Sort anomalies by estimatedCost descending, take top 5
            allAnomalies.sort(function(a, b) { return (b.estimatedCost || 0) - (a.estimatedCost || 0); });
            var top5Anomalies = allAnomalies.slice(0, 5);

            return {
                wbpLwbp: {
                    configured: anyWbpConfigured,
                    wbpKWh: Math.round(wbpKwh * 100) / 100,
                    lwbpKWh: Math.round(lwbpKwh * 100) / 100,
                    wbpCost: Math.round(wbpCost),
                    lwbpCost: Math.round(lwbpCost),
                    totalCostWBP: Math.round(totalCostWBP),
                    wbpRatio: wbpRatio,
                    tariffWBP: tariffWBP,
                    tariffLWBP: tariffLWBP,
                    wbpStart: wbpStart,
                    wbpEnd: wbpEnd
                },
                waste: {
                    configured: anyWasteConfigured,
                    wasteKWh: Math.round(wasteKwh * 100) / 100,
                    wasteCost: Math.round(wasteCost),
                    wastePercent: wastePercent,
                    downtimeStart: downtimeStart,
                    downtimeEnd: downtimeEnd
                },
                budget: {
                    configured: anyBudgetConfigured,
                    budgetKWh: Math.round(budgetKWh * 100) / 100,
                    actualKWh: Math.round(actualKWh * 100) / 100,
                    variance: budgetVariance,
                    variancePercent: budgetVariancePct,
                    budgetCost: Math.round(budgetCost),
                    actualCost: Math.round(actualCost)
                },
                periodComparison: {
                    lastMonthKWh: Math.round(lastMonthKWh * 100) / 100,
                    momChange: Math.round(momChange * 100) / 100,
                    momChangePercent: momChangePercent,
                    lastYearSameMonthKWh: Math.round(lastYearSameMonthKWh * 100) / 100,
                    yoyChange: Math.round(yoyChange * 100) / 100,
                    yoyChangePercent: yoyChangePercent
                },
                billProjection: {
                    projectedMonthKWh: Math.round(projectedMonthKWh * 100) / 100,
                    projectedCost: Math.round(projectedCost),
                    daysElapsed: daysElapsed,
                    daysRemaining: daysRemaining
                },
                anomalyCostImpact: {
                    totalAnomalies: totalAnomalies,
                    estimatedExcessKWh: Math.round(estimatedExcessKWh * 100) / 100,
                    estimatedCostImpact: Math.round(estimatedCostImpact),
                    topAnomalies: top5Anomalies
                },
                loadFactorInfo: {
                    configured: anyLFConfigured,
                    loadFactor: loadFactor,
                    maxCapacity: Math.round(lfTotalMaxCapKVA * 1000),
                    status: lfStatus
                },
                unitEconomics: {
                    configured: anyUEConfigured,
                    costPerM2: costPerM2,
                    costPerHour: costPerHour,
                    surfaceArea: Math.round(totalSurfaceArea * 100) / 100
                },
                tariffTypeInfo: {
                    wbpDeviceCount: wbpDeviceCount,
                    flatDeviceCount: flatDeviceCount,
                    flatKWh: Math.round(flatKWh * 100) / 100,
                    flatCost: Math.round(flatCost),
                    totalDeviceCount: wbpDeviceCount + flatDeviceCount
                },
                avgTariffPerKWh: tariffCount > 0 ? Math.round(tariffSum / tariffCount) : 1500,
                totalEstimatedCost: Math.round(totalEstimatedCost)
            };
        }

        // Chart.js center-text plugin for doughnut charts (register once)
        if (!window._centerTextPluginRegistered) {
            window._centerTextPluginRegistered = true;
            var centerTextPlugin = {
                id: 'centerText',
                afterDraw: function(chart) {
                    var ct = chart.config.options && chart.config.options.plugins && chart.config.options.plugins.centerText;
                    if (!ct) return;
                    var ctx = chart.ctx;
                    var cx = (chart.chartArea.left + chart.chartArea.right) / 2;
                    var cy = (chart.chartArea.top + chart.chartArea.bottom) / 2;
                    ctx.save();
                    ctx.textAlign = 'center';
                    ctx.textBaseline = 'middle';
                    if (ct.line1) {
                        ctx.font = 'bold 14px sans-serif';
                        ctx.fillStyle = ct.color1 || '#333';
                        ctx.fillText(ct.line1, cx, cy - 10);
                    }
                    if (ct.line2) {
                        ctx.font = '10px sans-serif';
                        ctx.fillStyle = ct.color2 || '#888';
                        ctx.fillText(ct.line2, cx, cy + 8);
                    }
                    if (ct.line3) {
                        ctx.font = '9px sans-serif';
                        ctx.fillStyle = ct.color3 || '#aaa';
                        ctx.fillText(ct.line3, cx, cy + 22);
                    }
                    ctx.restore();
                }
            };
            Chart.register(centerTextPlugin);
        }

        function updateFinancialUI(data, requestSequence, sourceUpdatedAt) {
            if (requestSequence != null && requestSequence !== usageLoadSequence) return;
