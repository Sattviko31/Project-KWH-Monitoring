        function saveEmaSettings() {
            var btn = $('#btnSaveEmaSettings');
            btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Saving...');

            var emaSettingsData = {
                emaPeriod: parseInt($('#emaPeriod').val()),
                emaMode: $('input[name="thresholdMode"]:checked').val(),
                emaUpperThreshold: parseInt($('#emaUpperThreshold').val()),
                emaLowerThreshold: parseInt($('#emaLowerThreshold').val()),
                emaFibUpper: parseFloat($('#emaFibUpper').val()),
                emaFibLower: parseFloat($('#emaFibLower').val()),
                emaShowLine: $('#emaShowLine').is(':checked'),
                emaShowThresholds: $('#emaShowThresholds').is(':checked'),
                useInitial100ForEma: $('#useInitial100ForEma').is(':checked'),
                refreshInterval: parseInt($('#emaRefreshInterval').val())
            };

            var emaReq = $.ajax({
                url: '/api/Api/save-ema-settings',
                method: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(emaSettingsData)
            });

            // Per-category downtime save
            var categories = downtimeCategoriesMeta.map(function(c) { return c.name; });
            var catDowntimeRequests = categories.map(function(cat) {
                var catData = {
                    enabled: $('#downtime' + cat + 'Enabled').is(':checked'),
                    startHour: parseInt($('#downtime' + cat + 'StartHour').val()) || 22,
                    endHour: parseInt($('#downtime' + cat + 'EndHour').val()) || 6,
                    description: $('#downtime' + cat + 'Description').val() || ''
                };
                categoryDowntimeSettings[cat] = catData;
                return $.ajax({
                    url: '/api/Api/downtime-settings/' + cat,
                    method: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(catData)
                });
            });

            var allRequests = [emaReq].concat(catDowntimeRequests);

            $.when.apply($, allRequests).done(function() {
                btn.prop('disabled', false).html('<i class="fas fa-save"></i> Save Settings');
                showNotification('EMA & Downtime settings saved successfully!', 'success');
                loadAllCategoryDowntimeStatus();
            }).fail(function() {
                btn.prop('disabled', false).html('<i class="fas fa-save"></i> Save Settings');
                showNotification('Error saving settings', 'danger');
            });
        }

        function resetEmaSettings() {
            $('#emaPeriod').val(20);
            $('#emaUpperThreshold').val(30);
            $('#emaLowerThreshold').val(50);
            $('#emaFibUpper').val(1.618);
            $('#emaFibLower').val(0.618);
            $('#emaRefreshInterval').val(10);
            $('#emaShowLine').prop('checked', true);
            $('#emaShowThresholds').prop('checked', true);
            $('#useInitial100ForEma').prop('checked', false);
            $('#emaModeManual').prop('checked', true);
            $('#emaManualSettings').show();
            $('#emaFibonacciSettings').hide();

            // Reset per-category downtime
            var categories = downtimeCategoriesMeta.map(function(c) { return c.name; });
            categories.forEach(function(cat) {
                $('#downtime' + cat + 'Enabled').prop('checked', false);
                $('#downtime' + cat + 'StartHour').val(22);
                $('#downtime' + cat + 'EndHour').val(6);
                $('#downtime' + cat + 'Description').val('');
                updateCategoryDuration(cat);
            });
            clearPresetHighlight();
            updateDowntimeTimeline();

            showNotification('EMA & Downtime settings reset to default. Click Save to apply.', 'info');
        }

        // ============================================
        // TARIFF SETTINGS (loaded into System tab)
        // ============================================

        loadTariffSettings();

        function loadTariffSettings() {
            $.ajax({
                url: '/api/Api/get-tariff',
                method: 'GET',
                dataType: 'json',
                success: function(data) {
                    var tariffNumber = data.tariffPerKWh || 1500;
                    if (typeof tariffNumber === 'string') {
                        tariffNumber = parseFloat(tariffNumber) || 1500;
                    }
                    $('#tariffPerKWh').val(tariffNumber);
                },
                error: function() {
                    console.log('Using default tariff: 1500');
                }
            });
        }

        // ============================================
        // PER-CATEGORY DOWNTIME SETTINGS (Dynamic)
        // ============================================

        var categoryDowntimeSettings = {};
        var categoryDowntimeMap = {};
        var downtimeCategoriesMeta = []; // [{name, icon, color, description}]

        function buildDowntimeCategoryTabs() {
            var $tabs = $('#downtimeCategoryTabs');
            var $content = $('#downtimeCategoryTabContent');
            $tabs.empty();
            $content.empty();

            if (downtimeCategoriesMeta.length === 0) {
                $content.html('<div class="text-center py-4 text-muted"><i class="fas fa-tags"></i> Tidak ada kategori. Tambahkan kategori di tab Categories.</div>');
                return;
            }

            downtimeCategoriesMeta.forEach(function(cat, idx) {
                var isActive = idx === 0;
                var tabId = 'settingsDowntime' + cat.name;

                // Build tab link
                var $li = $('<li class="nav-item" role="presentation"></li>');
                var $a = $('<a class="nav-link' + (isActive ? ' active' : '') + '" data-toggle="tab" href="#' + tabId + '" role="tab"></a>');
                $a.html('<span style="display:inline-block;width:8px;height:8px;border-radius:50%;background:' + cat.color + ';vertical-align:middle;margin-right:2px"></span> ' + cat.name);
                $li.append($a);
                $tabs.append($li);

                // Build tab pane
                var $pane = $('<div class="tab-pane' + (isActive ? ' active' : '') + '" id="' + tabId + '" role="tabpanel"></div>');
                var html = '<div class="settings-grid">';
                html += '<div class="settings-field settings-field-full">';
                html += '  <div class="form-check form-switch">';
                html += '    <input class="form-check-input cat-downtime-enabled" type="checkbox" id="downtime' + cat.name + 'Enabled" data-category="' + cat.name + '" style="width: 2.5em; height: 1.3em;">';
                html += '    <label class="form-check-label fw-bold" for="downtime' + cat.name + 'Enabled">Aktifkan Downtime ' + cat.name + '</label>';
                html += '  </div>';
                html += '</div>';
                html += '<div class="settings-field">';
                html += '  <label class="form-label">Jam Mulai</label>';
                html += '  <select class="form-select cat-downtime-start" id="downtime' + cat.name + 'StartHour" data-category="' + cat.name + '"></select>';
                html += '</div>';
                html += '<div class="settings-field">';
                html += '  <label class="form-label">Jam Selesai</label>';
                html += '  <select class="form-select cat-downtime-end" id="downtime' + cat.name + 'EndHour" data-category="' + cat.name + '"></select>';
                html += '</div>';
                html += '<div class="settings-field">';
                html += '  <label class="form-label">Durasi</label>';
                html += '  <div class="form-control bg-light text-center" id="downtime' + cat.name + 'Duration" readonly>8 jam</div>';
                html += '</div>';
                html += '<div class="settings-field">';
                html += '  <label class="form-label">Deskripsi</label>';
                html += '  <input type="text" class="form-control cat-downtime-desc" id="downtime' + cat.name + 'Description" data-category="' + cat.name + '" placeholder="Contoh: ' + cat.name + ' mati malam hari">';
                html += '</div>';
                html += '</div>';
                html += '<div class="card border mt-3" id="downtime' + cat.name + 'StatusCard">';
                html += '  <div class="card-body text-center">';
                html += '    <h6 class="mb-1"><i class="fas fa-signal"></i> Status ' + cat.name + '</h6>';
                html += '    <div id="downtime' + cat.name + 'Status" class="fs-5 fw-bold">';
                html += '      <i class="fas fa-spinner fa-spin"></i> Memuat...';
                html += '    </div>';
                html += '  </div>';
                html += '</div>';
                $pane.html(html);
                $content.append($pane);
            });
        }

        function populateCategoryHourDropdowns() {
            downtimeCategoriesMeta.forEach(function(cat) {
                var $start = $('#downtime' + cat.name + 'StartHour');
                var $end = $('#downtime' + cat.name + 'EndHour');
                $start.empty();
                $end.empty();
                for (var h = 0; h < 24; h++) {
                    var label = (h < 10 ? '0' : '') + h + ':00';
                    $start.append('<option value="' + h + '">' + label + '</option>');
                    $end.append('<option value="' + h + '">' + label + '</option>');
                }
                var s = categoryDowntimeSettings[cat.name];
                if (s) {
                    $start.val(s.startHour);
                    $end.val(s.endHour);
                }
            });
        }

        function updateCategoryDuration(cat) {
            var start = parseInt($('#downtime' + cat + 'StartHour').val());
            var end = parseInt($('#downtime' + cat + 'EndHour').val());
            var duration;
            if (start === end) duration = 24;
            else if (start < end) duration = end - start;
            else duration = (24 - start) + end;
            $('#downtime' + cat + 'Duration').text(duration + ' jam');
        }

        function loadCategoryDowntimeSettings() {
            var categories = downtimeCategoriesMeta.map(function(c) { return c.name; });
            var promises = categories.map(function(cat) {
                return $.ajax({
                    url: '/api/Api/downtime-settings/' + cat,
                    method: 'GET',
                    dataType: 'json',
                    timeout: 10000,
                    success: function(data) {
                        categoryDowntimeSettings[cat] = {
                            enabled: data.enabled || false,
                            startHour: data.startHour != null ? data.startHour : 22,
                            endHour: data.endHour != null ? data.endHour : 6,
                            description: data.description || ''
                        };
                    }
                });
            });
            return $.when.apply($, promises);
        }

        function loadAllCategoryDowntimeSettings() {
            // Load categories from API first
            $.ajax({
                url: '/api/Api/categories',
                method: 'GET',
                dataType: 'json',
                success: function(data) {
                    downtimeCategoriesMeta = data || [];
                    // Expose globally for _AnomalyService
                    window._categoryMetaMap = {};
                    (data || []).forEach(function(cat) {
                        window._categoryMetaMap[cat.name] = { icon: cat.icon, color: cat.color, description: cat.description };
                    });
                    if (typeof injectCategoryStyles === 'function') injectCategoryStyles(data);
                    buildDowntimeCategoryTabs();
                    populateCategoryHourDropdowns();
                    loadCategoryDowntimeSettings().then(function() {
                        downtimeCategoriesMeta.forEach(function(cat) {
                            var s = categoryDowntimeSettings[cat.name];
                            if (s) {
                                $('#downtime' + cat.name + 'Enabled').prop('checked', s.enabled);
                                $('#downtime' + cat.name + 'StartHour').val(s.startHour);
                                $('#downtime' + cat.name + 'EndHour').val(s.endHour);
                                $('#downtime' + cat.name + 'Description').val(s.description);
                                updateCategoryDuration(cat.name);
                            }
                        });
                        updateDowntimeTimeline();
                        loadAllCategoryDowntimeStatus();
                    });
                },
                error: function() {
                    $('#downtimeCategoryTabContent').html('<div class="text-center py-4 text-danger"><i class="fas fa-exclamation-circle"></i> Gagal memuat kategori</div>');
                }
            });
        }

        function loadAllCategoryDowntimeStatus() {
            downtimeCategoriesMeta.forEach(function(cat) {
                checkCategoryDowntimeStatus(cat.name);
            });
        }

        function checkCategoryDowntimeStatus(cat) {
            $.ajax({
                url: '/api/Api/downtime-status?category=' + encodeURIComponent(cat),
                method: 'GET',
                dataType: 'json',
                timeout: 5000,
                success: function(data) {
                    categoryDowntimeMap[cat] = data.isDowntime || false;
                    updateCategoryDowntimeStatusUI(cat);
                },
                error: function() {
                    categoryDowntimeMap[cat] = false;
                    updateCategoryDowntimeStatusUI(cat);
                }
            });
        }

        function updateCategoryDowntimeStatusUI(cat) {
            var firstCat = Object.keys(categoryDowntimeSettings)[0];
            if (!categoryDowntimeSettings[cat] && !categoryDowntimeSettings[firstCat]) {
                console.log('⏳ Downtime settings not loaded yet, skipping UI update for ' + cat);
                return;
            }

            var $status = $('#downtime' + cat + 'Status');
            var $card = $('#downtime' + cat + 'StatusCard');
            var isDowntime = categoryDowntimeMap[cat] || false;
            var s = categoryDowntimeSettings[cat] || categoryDowntimeSettings[firstCat] || { enabled: false, startHour: 22, endHour: 6 };
            var startLabel = (s.startHour < 10 ? '0' : '') + s.startHour + ':00';
            var endLabel = (s.endHour < 10 ? '0' : '') + s.endHour + ':00';
            if (isDowntime) {
                $status.html('<span class="text-danger"><i class="fas fa-moon"></i> DOWNTIME AKTIF</span><br><small class="text-muted">Downtime period active (' + startLabel + '–' + endLabel + ') - Lower threshold disabled</small>');
                $card.removeClass('border-success').addClass('border-danger');
            } else {
                $status.html('<span class="text-success"><i class="fas fa-sun"></i> OPERASI NORMAL</span><br><small class="text-muted">Normal operation - All thresholds active</small>');
                $card.removeClass('border-danger').addClass('border-success');
            }
        }

        // Preset buttons — apply to active category
        $('.preset-btn').click(function() {
            var start = parseInt($(this).data('start'));
            var end = parseInt($(this).data('end'));
            var desc = $(this).data('desc');

            clearPresetHighlight();
            $(this).addClass('preset-active');

            // Find currently active category
            var $activeTab = $('#downtimeCategoryTabs .nav-link.active');
            var href = $activeTab.attr('href') || '';
            var cat = href.replace('#settingsDowntime', '');

            if (!cat) return;

            if (start === 0 && end === 0) {
                $('#downtime' + cat + 'StartHour').focus();
            } else {
                $('#downtime' + cat + 'StartHour').val(start);
                $('#downtime' + cat + 'EndHour').val(end);
                $('#downtime' + cat + 'Description').val(desc);
                updateCategoryDuration(cat);
            }

            updateDowntimeTimeline();
        });

        // Category sub-tab switch — update timeline and clear preset highlight
        $(document).on('shown.bs.tab', '#downtimeCategoryTabs .nav-link', function() {
            updateDowntimeTimeline();
            clearPresetHighlight();
        });

        // Per-category downtime hour change — update duration + timeline
        $(document).on('change', '.cat-downtime-start, .cat-downtime-end', function() {
            var cat = $(this).data('category');
            updateCategoryDuration(cat);
            updateDowntimeTimeline();
        });

        function clearPresetHighlight() {
            $('.preset-btn').removeClass('preset-active');
        }

        function updateDowntimeTimeline() {
            var $activeTab = $('#downtimeCategoryTabs .nav-link.active');
            var href = $activeTab.attr('href') || '';
            var activeCat = href.replace('#settingsDowntime', '');

            if (!activeCat) return;

            var start = parseInt($('#downtime' + activeCat + 'StartHour').val()) || 22;
            var end = parseInt($('#downtime' + activeCat + 'EndHour').val()) || 6;
            var bar = $('#downtimeTimelineBar');

            var pctPerHour = 100 / 24;

            if (start === end) {
                bar.css({
                    left: '0%',
                    width: '100%',
                    borderRadius: '8px',
                    background: '#1a1d23'
                });
            } else if (start < end) {
                bar.css({
                    left: (start * pctPerHour) + '%',
                    width: ((end - start) * pctPerHour) + '%',
                    borderRadius: '0',
                    background: '#1a1d23'
                });
            } else {
                var startPct = start * pctPerHour;
                var endPct = end * pctPerHour;
                bar.css({
                    left: '0%',
                    width: '100%',
                    borderRadius: '0',
                    background: 'linear-gradient(to right, #1a1d23 0%, #1a1d23 ' + endPct + '%, #198754 ' + endPct + '%, #198754 ' + startPct + '%, #1a1d23 ' + startPct + '%, #1a1d23 100%)'
                });
                return;
            }
        }

        function highlightMatchingPreset(startHour, endHour) {
            clearPresetHighlight();
            $('.preset-btn').each(function() {
                var btnStart = parseInt($(this).data('start'));
                var btnEnd = parseInt($(this).data('end'));
                if (btnStart === startHour && btnEnd === endHour) {
                    $(this).addClass('preset-active');
                }
            });
        }
    </script>
}