                    $('#emaLowerThreshold').val(data.emaLowerThreshold || 50);
                    $('#emaFibUpper').val(data.emaFibUpper || 1.618);
                    $('#emaFibLower').val(data.emaFibLower || 0.618);
                    $('#emaRefreshInterval').val(data.refreshInterval || 10);
                    $('#emaShowLine').prop('checked', data.emaShowLine !== false);
                    $('#emaShowThresholds').prop('checked', data.emaShowThresholds !== false);
                    $('#useInitial100ForEma').prop('checked', data.useInitial100ForEma || false);

                    if (data.emaMode === 'fibonacci') {
                        $('#emaModeFibonacci').prop('checked', true);
                        $('#emaManualSettings').hide();
                        $('#emaFibonacciSettings').show();
                    } else {
                        $('#emaModeManual').prop('checked', true);
                        $('#emaManualSettings').show();
                        $('#emaFibonacciSettings').hide();
                    }

                    loadAllCategoryDowntimeSettings();
                },
                error: function() {
                    console.log('Using default EMA settings');
                    loadAllCategoryDowntimeSettings();
