        // Hidden field to store current resolved URL
        var _currentChatbotApiUrl = chatbotProviders.qwen.url;

        function populateChatbotModels(providerKey, selectedModel) {
            var $select = $('#chatbotModel');
            $select.empty();

            var provider = chatbotProviders[providerKey];
            if (!provider) provider = chatbotProviders.custom;

            if (provider.models.length > 0) {
                provider.models.forEach(function(m) {
                    $select.append('<option value="' + m.value + '">' + m.label + '</option>');
                });
                $select.append('<option value="__custom__">Custom Model...</option>');

                if (selectedModel) {
                    var exists = provider.models.some(function(m) { return m.value === selectedModel; });
                    if (exists) {
                        $select.val(selectedModel);
                        $('#customModelField').hide();
                    } else {
                        $select.val('__custom__');
                        $('#chatbotCustomModel').val(selectedModel);
                        $('#customModelField').show();
                    }
                } else {
                    $('#customModelField').hide();
                }
            } else {
                // Custom provider — only custom model option
                $select.append('<option value="__custom__">Masukkan nama model</option>');
                if (selectedModel) {
                    $('#chatbotCustomModel').val(selectedModel);
                }
                $('#customModelField').show();
            }
        }

        function detectProviderFromUrl(url) {
            var suffixes = ['/chat/completions', '/v1/chat/completions', '/v2/chat/completions',
                            '/v4/chat/completions', '/v1beta/openai/chat/completions',
                            '/compatible-mode/v1/chat/completions'];
            for (var key in chatbotProviders) {
                if (key === 'custom') continue;
                if (chatbotProviders[key].url) {
                    var baseUrl = chatbotProviders[key].url;
                    for (var i = 0; i < suffixes.length; i++) {
                        baseUrl = baseUrl.replace(suffixes[i], '');
                    }
                    if (baseUrl && url.indexOf(baseUrl) !== -1) {
                        return key;
                    }
                }
            }
            return 'custom';
        }

        function getChatbotApiUrl() {
            var provider = $('#chatbotProvider').val();
            if (provider === 'custom') {
                return $('#chatbotCustomApiUrl').val().trim() || '';
            }
            return chatbotProviders[provider] ? chatbotProviders[provider].url : '';
        }

        function getChatbotModel() {
            var modelVal = $('#chatbotModel').val();
            if (modelVal === '__custom__') {
                return $('#chatbotCustomModel').val().trim();
            }
            return modelVal;
        }

