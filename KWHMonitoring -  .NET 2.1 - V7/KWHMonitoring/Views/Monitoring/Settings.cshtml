        function testWablas() {
            var btn = $('#btnTestWablas');
            btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Sending...');

            var phone = $('#wablasPhoneNumbers').val().split(',')[0].trim();
            if (!phone) {
                showNotification('Masukkan nomor WhatsApp tujuan terlebih dahulu!', 'danger');
                btn.prop('disabled', false).html('<i class="fab fa-whatsapp"></i> Test Kirim');
                return;
            }

            $.ajax({
                url: '/api/Api/wablas/test',
                method: 'POST',
                data: JSON.stringify({
                    phone: phone,
                    message: 'Test message dari KWH Monitoring System - ' + new Date().toLocaleString('id-ID')
                }),
                success: function (response) {
                    $('#wablasStatus').html('<div class="alert alert-success py-1 px-2 mb-0"><i class="fas fa-check-circle"></i> ' + response.message + '</div>');
                    btn.prop('disabled', false).html('<i class="fab fa-whatsapp"></i> Test Kirim');
                },
                error: function (xhr) {
                    $('#wablasStatus').html('<div class="alert alert-danger py-1 px-2 mb-0"><i class="fas fa-exclamation-circle"></i> ' + (xhr.responseJSON?.error || 'Gagal mengirim') + '</div>');
                    btn.prop('disabled', false).html('<i class="fab fa-whatsapp"></i> Test Kirim');
                }
            });
        }

        function checkWablasDevice() {
            var btn = $('#btnCheckWablasDevice');
            btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Checking...');

            $.ajax({
                url: '/api/Api/wablas/device-status',
                method: 'GET',
                dataType: 'json',
                success: function (response) {
                    if (response.data && response.data.connected) {
                        var info = response.data;
                        $('#wablasStatus').html(
                            '<div class="alert alert-success py-1 px-2 mb-0">' +
                            '<i class="fas fa-check-circle"></i> <strong>Connected!</strong> ' +
                            'Phone: ' + (info.phone || 'N/A') +
                            (info.name ? ' | Name: ' + info.name : '') +
                            (info.battery ? ' | Battery: ' + info.battery + '%' : '') +
                            '</div>'
                        );
                    } else {
                        $('#wablasStatus').html(
                            '<div class="alert alert-warning py-1 px-2 mb-0">' +
                            '<i class="fas fa-exclamation-triangle"></i> Device not connected. ' +
                            'Pastikan WhatsApp sudah terhubung di dashboard Wablas.' +
                            '</div>'
                        );
                    }
                    btn.prop('disabled', false).html('<i class="fas fa-mobile-alt"></i> Cek Device');
                },
                error: function (xhr) {
                    $('#wablasStatus').html('<div class="alert alert-danger py-1 px-2 mb-0"><i class="fas fa-exclamation-circle"></i> ' + (xhr.responseJSON?.error || 'Gagal cek status') + '</div>');
                    btn.prop('disabled', false).html('<i class="fas fa-mobile-alt"></i> Cek Device');
                }
            });
        }

