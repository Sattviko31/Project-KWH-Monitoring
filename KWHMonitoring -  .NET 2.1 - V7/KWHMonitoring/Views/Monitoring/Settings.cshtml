                    { value: 'Qwen/Qwen2.5-32B-Instruct', label: 'Qwen 2.5 32B' },
                    { value: 'Qwen/Qwen2.5-14B-Instruct', label: 'Qwen 2.5 14B' },
                    { value: 'Qwen/Qwen2.5-7B-Instruct', label: 'Qwen 2.5 7B' },
                    { value: 'Qwen/Qwen2.5-Coder-32B-Instruct', label: 'Qwen 2.5 Coder 32B' },
                    { value: 'Qwen/QwQ-32B', label: 'QwQ 32B (Reasoning)' },
                    { value: 'deepseek-ai/DeepSeek-V3', label: 'DeepSeek V3' },
                    { value: 'deepseek-ai/DeepSeek-R1', label: 'DeepSeek R1' },
                    { value: 'deepseek-ai/DeepSeek-R1-Distill-Qwen-32B', label: 'DeepSeek R1 Distill 32B' },
                    { value: 'meta-llama/Meta-Llama-3.1-405B-Instruct', label: 'Llama 3.1 405B' },
                    { value: 'meta-llama/Meta-Llama-3.1-70B-Instruct', label: 'Llama 3.1 70B' },
                    { value: 'meta-llama/Meta-Llama-3.1-8B-Instruct', label: 'Llama 3.1 8B' },
                    { value: 'google/gemma-2-27b-it', label: 'Gemma 2 27B' },
                    { value: 'google/gemma-2-9b-it', label: 'Gemma 2 9B' },
                    { value: 'Pro/Qwen/Qwen2.5-VL-7B-Instruct', label: 'Qwen2.5-VL 7B (Vision)' }
                ]
            },
            mistral: {
                name: 'Mistral AI',
                url: 'https://api.mistral.ai/v1/chat/completions',
                models: [
                    { value: 'mistral-large-latest', label: 'Mistral Large ★ Recommended' },
                    { value: 'mistral-medium-latest', label: 'Mistral Medium' },
                    { value: 'mistral-small-latest', label: 'Mistral Small (Fast)' },
                    { value: 'mistral-tiny', label: 'Mistral Tiny' },
                    { value: 'open-mistral-nemo', label: 'Mistral Nemo 12B (Open)' },
                    { value: 'codestral-latest', label: 'Codestral (Code)' },
                    { value: 'pixtral-large-latest', label: 'Pixtral Large (Vision)' },
                    { value: 'open-mistral-7b', label: 'Mistral 7B (Open)' },
                    { value: 'open-mixtral-8x7b', label: 'Mixtral 8x7B (Open)' },
                    { value: 'open-mixtral-8x22b', label: 'Mixtral 8x22B (Open)' }
                ]
            },
            cohere: {
                name: 'Cohere',
                url: 'https://api.cohere.com/v2/chat/completions',
                models: [
                    { value: 'command-r-plus', label: 'Command R+ ★ Recommended' },
                    { value: 'command-r', label: 'Command R' },
                    { value: 'command-r7b-12-2024', label: 'Command R7B (Fast)' },
                    { value: 'command', label: 'Command' },
                    { value: 'command-light', label: 'Command Light' },
                    { value: 'c4ai-aya-expanse-32b', label: 'Aya Expanse 32B (Multilingual)' },
                    { value: 'c4ai-aya-expanse-8b', label: 'Aya Expanse 8B (Multilingual)' }
                ]
            },
            custom: {
                name: 'Custom Provider',
                url: '',
                models: []
            }
        };

        // Hidden field to store current resolved URL
        var _currentChatbotApiUrl = chatbotProviders.qwen.url;

        function populateChatbotModels(providerKey, selectedModel) {
            var $select = $('#chatbotModel');
            $select.empty();

            var provider = chatbotProviders[providerKey];
            if (!provider) provider = chatbotProviders.custom;

            if (provider.models.length > 0) {
                provider.models.forEach(function(m) {
                    $select.append('<option value="' + m.value + '">' + m.label + '</option>');
                });
                $select.append('<option value="__custom__">Custom Model...</option>');

                if (selectedModel) {
                    var exists = provider.models.some(function(m) { return m.value === selectedModel; });
                    if (exists) {
                        $select.val(selectedModel);
                        $('#customModelField').hide();
                    } else {
                        $select.val('__custom__');
                        $('#chatbotCustomModel').val(selectedModel);
                        $('#customModelField').show();
                    }
                } else {
                    $('#customModelField').hide();
                }
            } else {
                // Custom provider — only custom model option
                $select.append('<option value="__custom__">Masukkan nama model</option>');
                if (selectedModel) {
                    $('#chatbotCustomModel').val(selectedModel);
                }
                $('#customModelField').show();
            }
        }

        function detectProviderFromUrl(url) {
            var suffixes = ['/chat/completions', '/v1/chat/completions', '/v2/chat/completions',
                            '/v4/chat/completions', '/v1beta/openai/chat/completions',
                            '/compatible-mode/v1/chat/completions'];
            for (var key in chatbotProviders) {
                if (key === 'custom') continue;
                if (chatbotProviders[key].url) {
                    var baseUrl = chatbotProviders[key].url;
                    for (var i = 0; i < suffixes.length; i++) {
                        baseUrl = baseUrl.replace(suffixes[i], '');
                    }
                    if (baseUrl && url.indexOf(baseUrl) !== -1) {
                        return key;
                    }
                }
            }
            return 'custom';
        }

        function getChatbotApiUrl() {
            var provider = $('#chatbotProvider').val();
            if (provider === 'custom') {
                return $('#chatbotCustomApiUrl').val().trim() || '';
            }
            return chatbotProviders[provider] ? chatbotProviders[provider].url : '';
        }

        function getChatbotModel() {
            var modelVal = $('#chatbotModel').val();
            if (modelVal === '__custom__') {
                return $('#chatbotCustomModel').val().trim();
            }
            return modelVal;
        }

        loadChatbotSettings();

        // Provider change — update URL & models
        $('#chatbotProvider').change(function() {
            var providerKey = $(this).val();
            var provider = chatbotProviders[providerKey];

            if (providerKey === 'custom') {
                $('#customProviderUrlField').show();
                $('#chatbotCustomApiUrl').focus();
            } else {
                $('#customProviderUrlField').hide();
                _currentChatbotApiUrl = provider.url;
            }

            populateChatbotModels(providerKey);
        });

        // Model change — show/hide custom model field
        $('#chatbotModel').change(function() {
            if ($(this).val() === '__custom__') {
                $('#customModelField').show();
                $('#chatbotCustomModel').focus();
            } else {
                $('#customModelField').hide();
            }
        });

        // Test chatbot connection
        $('#btnTestChatbotConnection').click(function() {
            var btn = $(this);
            btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> <span class="chatbot-btn-label">Testing...</span>');
            $('#chatbotConnectionStatus').html('').removeClass('text-success text-danger');

            var testData = {
                apiKey: $('#chatbotApiKey').val().trim(),
                model: getChatbotModel(),
                apiUrl: getChatbotApiUrl()
            };

            $.ajax({
                url: '/api/Api/test-chatbot-connection',
                method: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(testData),
                success: function(response) {
                    if (response.success) {
                        $('#chatbotConnectionStatus').html('<i class="fas fa-check-circle text-success"></i> <span class="chatbot-btn-label">' + response.message + '</span>').addClass('text-success');
                        showNotification('Chatbot connection successful! AI replied: ' + (response.reply || 'OK'), 'success');
                    } else {
                        $('#chatbotConnectionStatus').html('<i class="fas fa-times-circle text-danger"></i> <span class="chatbot-btn-label">' + response.message + '</span>').addClass('text-danger');
                        showNotification('Chatbot connection failed: ' + response.message, 'danger');
                    }
                    btn.prop('disabled', false).html('<i class="fas fa-plug"></i> <span class="chatbot-btn-label">Test Connection</span>');
                },
                error: function(xhr) {
                    var errorMsg = 'Connection failed';
                    try { errorMsg = xhr.responseJSON?.message || xhr.responseJSON?.error || errorMsg; } catch(e) {}
                    $('#chatbotConnectionStatus').html('<i class="fas fa-times-circle text-danger"></i> ' + errorMsg).addClass('text-danger');
                    btn.prop('disabled', false).html('<i class="fas fa-plug"></i> <span class="chatbot-btn-label">Test Connection</span>');
                    showNotification('Chatbot connection error: ' + errorMsg, 'danger');
                }
            });
        });

        // Save chatbot settings
        $('#btnSaveChatbotSettings').click(function() {
            var btn = $(this);
            btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> <span class="chatbot-btn-label">Saving...</span>');

            var settings = {
                apiKey: $('#chatbotApiKey').val().trim(),
                model: getChatbotModel(),
                apiUrl: getChatbotApiUrl()
            };

            if (!settings.model) {
                btn.prop('disabled', false).html('<i class="fas fa-save"></i> <span class="chatbot-btn-label">Save Settings</span>');
                showNotification('Model AI harus diisi', 'danger');
                return;
            }
            if (!settings.apiUrl) {
                btn.prop('disabled', false).html('<i class="fas fa-save"></i> <span class="chatbot-btn-label">Save Settings</span>');
                showNotification('API Endpoint URL harus diisi', 'danger');
                return;
            }

            $.ajax({
                url: '/api/Api/chatbot-settings',
                method: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(settings),
                success: function(response) {
                    btn.prop('disabled', false).html('<i class="fas fa-save"></i> <span class="chatbot-btn-label">Save Settings</span>');
                    if (response.success) {
                        showNotification('AI Chatbot settings saved successfully!', 'success');
                        $('#chatbotApiKey').val('');
                        loadChatbotSettings();
                    } else {
                        showNotification('Error: ' + (response.error || 'Unknown error'), 'danger');
                    }
                },
                error: function(xhr) {
                    btn.prop('disabled', false).html('<i class="fas fa-save"></i> <span class="chatbot-btn-label">Save Settings</span>');
                    showNotification('Error saving chatbot settings', 'danger');
                }
            });
        });

        // Reset chatbot settings
        $('#btnResetChatbotSettings').click(function() {
            if (confirm('Reset AI Chatbot settings ke default? API key akan dihapus dari database.')) {
                $('#chatbotProvider').val('qwen');
                $('#chatbotApiKey').val('');
                $('#chatbotCustomModel').val('');
                $('#customModelField').hide();
                $('#customProviderUrlField').hide();
                $('#chatbotCustomApiUrl').val('');
                populateChatbotModels('qwen');
                showNotification('AI Chatbot settings reset to default. Click Save to apply.', 'info');
            }
        });

        // Load chatbot settings when tab is shown
        $(document).on('shown.bs.tab', '#chatbot-tab', function() {
            loadChatbotSettings();
        });

        function loadChatbotSettings() {
            $.ajax({
                url: '/api/Api/chatbot-settings',
                method: 'GET',
                dataType: 'json',
                success: function(data) {
                    var model = data.model || 'qwen-plus-2025-04-28';
                    var apiUrl = data.apiUrl || chatbotProviders.qwen.url;

                    // Detect provider from URL
                    var detectedProvider = detectProviderFromUrl(apiUrl);
                    $('#chatbotProvider').val(detectedProvider);

                    // Show/hide custom URL field
                    if (detectedProvider === 'custom') {
                        $('#customProviderUrlField').show();
                        $('#chatbotCustomApiUrl').val(apiUrl);
                    } else {
                        $('#customProviderUrlField').hide();
                    }

                    _currentChatbotApiUrl = apiUrl;

                    // Populate models for detected provider
                    populateChatbotModels(detectedProvider, model);

                    // Status display
                    if (data.isConfigured) {
                        var maskedKey = maskApiKey(data.apiKey);
                        $('#chatbotConfigStatus').html('<i class="fas fa-check-circle text-success me-2"></i> <span class="text-success">Terkonfigurasi</span> — Key: ' + maskedKey);
                    } else {
                        $('#chatbotConfigStatus').html('<i class="fas fa-exclamation-triangle text-warning me-2"></i> <span class="text-warning">Belum dikonfigurasi</span> — Menggunakan appsettings.json');
                    }

                    var providerName = chatbotProviders[detectedProvider] ? chatbotProviders[detectedProvider].name : 'Custom';
                    $('#chatbotActiveModel').html('<i class="fas fa-brain text-primary me-2"></i> ' + providerName + ' / ' + model);
                    $('#chatbotActiveUrl').html('<i class="fas fa-link text-info me-2" style="font-size:0.7rem"></i> <span style="font-size:0.78rem;word-break:break-all;">' + apiUrl + '</span>');
                },
                error: function() {
                    $('#chatbotConfigStatus').html('<i class="fas fa-question-circle text-muted me-2"></i> <span class="text-muted">Gagal memuat status</span>');
                    $('#chatbotActiveModel').html('<i class="fas fa-question-circle text-muted me-2"></i> —');
                    $('#chatbotActiveUrl').html('<i class="fas fa-question-circle text-muted me-2"></i> —');
                }
            });
        }

        function maskApiKey(key) {
            if (!key || key.length < 8) return '••••••••';
            return key.substring(0, 4) + '••••••••••••' + key.substring(key.length - 4);
        }

        // ============================================
        // EMA SETTINGS
        // ============================================

        loadEmaSettings();

        $('#btnSaveEmaSettings').click(function() {
            saveEmaSettings();
        });

        $('#btnResetEmaSettings').click(function() {
            if (confirm('Reset EMA settings ke default?')) {
                resetEmaSettings();
            }
        });

        function loadEmaSettings() {
            // Helper: apply EMA values to form
            function applyEmaValues(data) {
                $('#emaPeriod').val(data.emaPeriod || 20);
                $('#emaRefreshInterval').val(data.refreshInterval || 10);
                $('#emaShowLine').prop('checked', data.emaShowLine !== false);
                $('#emaShowThresholds').prop('checked', data.emaShowThresholds !== false);
                $('#useInitial100ForEma').prop('checked', data.useInitial100ForEma || false);
            }

            // Load EMA settings first
            $.ajax({
                url: '/api/Api/get-ema-settings',
                method: 'GET',
                dataType: 'json',
                success: function(data) {
                    applyEmaValues(data);
                    console.log('EMA settings loaded');
                },
                error: function() {
                    console.log('Using default EMA settings');
                },
                complete: function() {
                    // Load anomaly max confirmations independently
                    $.ajax({
                        url: '/api/Api/get-notification-settings',
                        method: 'GET',
                        dataType: 'json',
                        success: function(notifSettings) {
                            var loadedMax = (typeof notifSettings.anomalyMaxConfirmations === 'number') ? notifSettings.anomalyMaxConfirmations : 3;
                            $('#anomalyMaxConfirmations').val(loadedMax);
                            console.log('Anomaly maxConfirmations loaded:', loadedMax);
                        },
                        error: function() {
                            console.log('Using default anomalyMaxConfirmations: 3');
                        },
                        complete: function() {
                            console.log('EMA settings loaded');
                        }
                    });
                }
            });
        }

        function saveEmaSettings() {
            var btn = $('#btnSaveEmaSettings');
            btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Saving...');

            var emaSettingsData = {
                emaPeriod: parseInt($('#emaPeriod').val()),
                emaShowLine: $('#emaShowLine').is(':checked'),
                emaShowThresholds: $('#emaShowThresholds').is(':checked'),
                useInitial100ForEma: $('#useInitial100ForEma').is(':checked'),
                refreshInterval: parseInt($('#emaRefreshInterval').val())
            };

            var emaReq = $.ajax({
                url: '/api/Api/save-ema-settings',
                method: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(emaSettingsData)
            });

            // Save anomaly maxConfirmations without touching other anomaly settings
            var rawMax = parseInt($('#anomalyMaxConfirmations').val());
            var anomalyMaxConfirmationsValue = isNaN(rawMax) ? 3 : Math.max(0, Math.min(10, rawMax));
            var anomalyMaxConfirmationsReq = $.ajax({
                url: '/api/Api/save-system-settings',
                method: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({
                    'Anomaly.MaxConfirmations': String(anomalyMaxConfirmationsValue)
                })
            });

            $.when(emaReq, anomalyMaxConfirmationsReq).done(function() {
                btn.prop('disabled', false).html('<i class="fas fa-save"></i> Save EMA Settings');
                showNotification('EMA settings saved successfully!', 'success');
            }).fail(function() {
                btn.prop('disabled', false).html('<i class="fas fa-save"></i> Save EMA Settings');
                showNotification('Error saving EMA settings', 'danger');
            });
        }

        function resetEmaSettings() {
            $('#emaPeriod').val(20);
            $('#emaRefreshInterval').val(10);
            $('#anomalyMaxConfirmations').val(3);
            $('#emaShowLine').prop('checked', true);
            $('#emaShowThresholds').prop('checked', true);
            $('#useInitial100ForEma').prop('checked', false);

            showNotification('EMA settings reset to default. Click Save to apply.', 'info');
        }

        // Per-device settings handles its own downtime configuration
    </script>
}