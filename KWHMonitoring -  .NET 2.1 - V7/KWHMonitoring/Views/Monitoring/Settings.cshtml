        function loadNotificationSettings() {
            $.ajax({
                url: '/api/Api/get-notification-settings',
                method: 'GET',
                dataType: 'json',
                success: function(data) {
                    console.log('[LOAD-NOTIF] API returned:', data);
                    $('#smtpServer').val(data.smtpServer || 'smtp.gmail.com');
                    $('#smtpPort').val(data.smtpPort || 587);
                    $('#senderEmail').val(data.senderEmail || '');
                    $('#senderPassword').val(data.senderPassword || '');
                    $('#masterAdminEmail').val(data.masterAdminEmail || '');
                    $('#enableEmail').prop('checked', data.enableEmail || false);
                    $('#enableWhatsApp').prop('checked', data.enableWhatsApp || false);
                    $('#sendInstantAlert').prop('checked', data.sendInstantAlert !== false);
                    $('#sendHourlyReport').prop('checked', data.sendHourlyReport !== false);
                    $('#sendDailyReport').prop('checked', data.sendDailyReport || false);
                    $('#sendMonthlyReport').prop('checked', data.sendMonthlyReport || false);
                    // Hourly report schedule is fixed at every hour :00 — no time picker to populate
                    $('#dailyReportTime').val(data.dailyReportTime || '08:00');
                    $('#monthlyReportDay').val(data.monthlyReportDay || 1);
                    $('#monthlyReportTime').val(data.monthlyReportTime || '08:00');
                },
                error: function() {
                    console.log('Using default notification settings');
                }
            });

            $.ajax({
                url: '/api/Api/wablas/settings',
                method: 'GET',
                dataType: 'json',
                success: function(data) {
                    $('#wablasServerUrl').val(data.serverUrl || '');
                    $('#wablasToken').val(data.token || '');
                    $('#wablasSecretKey').val(data.secretKey || '');
                    $('#wablasPhoneNumbers').val(data.phoneNumbers || '');
                    $('#enableWhatsApp').prop('checked', data.enableWhatsApp || false);
                },
                error: function() {
                    console.log('Wablas settings not yet configured');
                }
            });
        }

        function saveNotificationSettings() {
            var btn = $('#btnSaveNotificationSettings');
            btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Saving...');

            var settings = {
                smtpServer: $('#smtpServer').val(),
                smtpPort: parseInt($('#smtpPort').val()),
                senderEmail: $('#senderEmail').val(),
                senderPassword: $('#senderPassword').val(),
                masterAdminEmail: $('#masterAdminEmail').val(),
                enableEmail: $('#enableEmail').is(':checked'),
                enableWhatsApp: $('#enableWhatsApp').is(':checked'),
                sendInstantAlert: $('#sendInstantAlert').is(':checked'),
                sendHourlyReport: $('#sendHourlyReport').is(':checked'),
                sendDailyReport: $('#sendDailyReport').is(':checked'),
                sendMonthlyReport: $('#sendMonthlyReport').is(':checked'),
                hourlyReportTime: 0, // Fixed: every hour at :00
                dailyReportTime: $('#dailyReportTime').val(),
                monthlyReportDay: parseInt($('#monthlyReportDay').val()),
                monthlyReportTime: $('#monthlyReportTime').val()
            };

            // DEBUG: Log what is being sent
            console.log('[SAVE-NOTIF] Sending:', JSON.stringify(settings, null, 2));

            $.ajax({
                url: '/api/Api/save-notification-settings',
                method: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(settings),
                success: function(response) {
                    console.log('[SAVE-NOTIF] API response:', response);
                    saveWablasSettings();
                    btn.prop('disabled', false).html('<i class="fas fa-save"></i> Save Settings');
                    showNotification('Notification settings saved successfully!', 'success');
                },
                error: function(xhr, status, error) {
                    console.error('[SAVE-NOTIF] API error:', error, xhr.responseText);
                    btn.prop('disabled', false).html('<i class="fas fa-save"></i> Save Settings');
                    showNotification('Error saving notification settings: ' + error, 'danger');
                }
            });
        }

        function saveWablasSettings() {
            var wablasSettings = {
                serverUrl: $('#wablasServerUrl').val(),
                token: $('#wablasToken').val(),
                secretKey: $('#wablasSecretKey').val(),
                phoneNumbers: ($('#wablasPhoneNumbers').val() || '').split(',').map(function(s) { return s.trim(); }).filter(function(s) { return s; }),
                enableWhatsApp: $('#enableWhatsApp').is(':checked')
            };

            $.ajax({
                url: '/api/Api/wablas/settings',
                method: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(wablasSettings),
                success: function(response) {
                    console.log('Wablas settings saved');
                },
                error: function(xhr) {
                    console.log('Error saving Wablas settings:', xhr.responseJSON?.error);
                }
            });
        }

