@{
    ViewData["Title"] = "Settings";
    var settings = ViewBag.CurrentSettings as Dictionary<string, string> ?? new Dictionary<string, string>();

    string GetSetting(string key, string defaultValue = "")
    {
        return settings.TryGetValue(key, out var value) ? value : defaultValue;
    }
}

<!-- Breadcrumb -->
<div class="erp-breadcrumb">
    <a asp-controller="Monitoring" asp-action="Index"><i class="fas fa-home"></i> Dashboard</a>
    <span class="separator"><i class="fas fa-chevron-right" style="font-size:0.6rem"></i></span>
    <span class="current">Settings</span>
</div>

<!-- Page Header -->
<div class="erp-page-header">
    <div>
        <h2><i class="fas fa-cog text-primary"></i> System Settings</h2>
        <div class="subtitle">Konfigurasi sistem KWH Monitoring — perubahan tersimpan permanen di database</div>
    </div>
    <div class="actions">
        <a asp-action="Index" class="btn btn-erp-action">
            <i class="fas fa-arrow-left"></i> <span class="d-none d-sm-inline">Dashboard</span>
        </a>
    </div>
</div>

<!-- Tabs Navigation -->
<ul class="nav nav-tabs erp-tabs settings-tabs" id="settingsTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <a class="nav-link erp-tab active" id="system-tab" data-toggle="tab" href="#system" role="tab">
            <i class="fas fa-cog"></i> <span>System</span>
        </a>
    </li>
    <li class="nav-item" role="presentation">
        <a class="nav-link erp-tab" id="ema-tab" data-toggle="tab" href="#ema" role="tab">
            <i class="fas fa-chart-line"></i> <span>EMA & Downtime</span>
        </a>
    </li>
    <li class="nav-item" role="presentation">
        <a class="nav-link erp-tab" id="notification-tab" data-toggle="tab" href="#notification" role="tab">
            <i class="fas fa-bell"></i> <span>Notifications</span>
        </a>
    </li>
</ul>

<div class="tab-content" id="settingsTabContent">

    <!-- ==================== SYSTEM SETTINGS TAB ==================== -->
    <div class="tab-pane fade in active" id="system" role="tabpanel" aria-labelledby="system-tab">
        <form id="systemSettingsForm">
        <div class="settings-section-list">

            <!-- 1. DATABASE CONNECTION -->
            <div class="settings-section">
                <div class="settings-section-header">
                    <div class="settings-section-icon bg-primary-soft">
                        <i class="fas fa-database text-primary"></i>
                    </div>
                    <div class="settings-section-title">
                        <h5>Database Connection</h5>
                        <p>Konfigurasi koneksi ke SQL Server database</p>
                    </div>
                    <div class="settings-section-action">
                        <button type="button" class="btn btn-outline-primary btn-sm" id="btnTestConnection">
                            <i class="fas fa-plug"></i> Test Connection
                        </button>
                        <span class="ms-2" id="connectionStatus"></span>
                    </div>
                </div>
                <div class="settings-section-body">
                    <div class="settings-grid">
                        <div class="settings-field">
                            <label class="form-label">Server IP / Host</label>
                            <input type="text" class="form-control" id="dbServer"
                                   value="@GetSetting("Database.Server", "192.168.6.15")"
                                   placeholder="192.168.6.15">
                            <small class="text-muted">IP address atau hostname database server</small>
                        </div>
                        <div class="settings-field">
                            <label class="form-label">Port</label>
                            <input type="number" class="form-control" id="dbPort"
                                   value="@GetSetting("Database.Port", "1433")"
                                   placeholder="1433">
                            <small class="text-muted">Default SQL Server: 1433</small>
                        </div>
                        <div class="settings-field">
                            <label class="form-label">Username</label>
                            <input type="text" class="form-control" id="dbUser"
                                   value="@GetSetting("Database.User", "sa")"
                                   placeholder="sa">
                        </div>
                        <div class="settings-field">
                            <label class="form-label">Password</label>
                            <input type="password" class="form-control" id="dbPassword"
                                   value="@GetSetting("Database.Password", "")"
                                   placeholder="••••••••">
                        </div>
                        <div class="settings-field settings-field-full">
                            <label class="form-label">Database Name</label>
                            <input type="text" class="form-control" id="dbName"
                                   value="@GetSetting("Database.Name", "HaiwellElectrical")"
                                   placeholder="HaiwellElectrical">
                        </div>
                    </div>
                </div>
            </div>

            <!-- 2. SAMPLING INTERVAL -->
            <div class="settings-section">
                <div class="settings-section-header">
                    <div class="settings-section-icon bg-success-soft">
                        <i class="fas fa-clock text-success"></i>
                    </div>
                    <div class="settings-section-title">
                        <h5>Sampling Interval</h5>
                        <p>Interval refresh data untuk setiap halaman monitoring</p>
                    </div>
                    <div class="settings-section-action">
                        <button type="button" class="btn btn-outline-success btn-sm" id="btnSyncIntervals">
                            <i class="fas fa-sync-alt"></i> Sync All
                        </button>
                    </div>
                </div>
                <div class="settings-section-body">
                    <div class="settings-grid">
                        <div class="settings-field">
                            <label class="form-label">Dashboard Refresh</label>
                            <div class="input-group">
                                <input type="number" class="form-control" id="dashboardInterval"
                                       value="@GetSetting("Interval.Dashboard", "10")"
                                       min="5" max="300" placeholder="10">
                                <small class="text-muted">detik</small>
                            </div>
                            <small class="text-muted">Min: 5, Max: 300</small>
                        </div>
                        <div class="settings-field">
                            <label class="form-label">Charts Refresh</label>
                            <div class="input-group">
                                <input type="number" class="form-control" id="chartsInterval"
                                       value="@GetSetting("Interval.Charts", "10")"
                                       min="5" max="300" placeholder="10">
                                <small class="text-muted">detik</small>
                            </div>
                            <small class="text-muted">Min: 5, Max: 300</small>
                        </div>
                        <div class="settings-field">
                            <label class="form-label">Details Page</label>
                            <div class="input-group">
                                <input type="number" class="form-control" id="detailsInterval"
                                       value="@GetSetting("Interval.Details", "10")"
                                       min="5" max="300" placeholder="10">
                                <small class="text-muted">detik</small>
                            </div>
                            <small class="text-muted">Min: 5, Max: 300</small>
                        </div>
                        <div class="settings-field">
                            <label class="form-label">Anomaly Check</label>
                            <div class="input-group">
                                <input type="number" class="form-control" id="anomalyInterval"
                                       value="@GetSetting("Interval.Anomaly", "10")"
                                       min="5" max="300" placeholder="10">
                                <small class="text-muted">detik</small>
                            </div>
                            <small class="text-muted">Min: 5, Max: 300</small>
                        </div>
                        <div class="settings-field">
                            <label class="form-label">Chart Data Points</label>
                            <div class="input-group">
                                <input type="number" class="form-control" id="chartDataPoints"
                                       value="@GetSetting("Chart.DataPoints", "20")"
                                       min="10" max="100" placeholder="20">
                                <small class="text-muted">titik</small>
                            </div>
                            <small class="text-muted">Jumlah titik data pada grafik</small>
                        </div>
                        <div class="settings-field">
                            <label class="form-label">Auto-Scan</label>
                            <div class="input-group">
                                <input type="number" class="form-control" id="autoScanInterval"
                                       value="@GetSetting("Interval.AutoScan", "60")"
                                       min="30" max="600" placeholder="60">
                                <small class="text-muted">detik</small>
                            </div>
                            <small class="text-muted">Interval scan panel baru</small>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 3. LOAD GAUGE -->
            <div class="settings-section">
                <div class="settings-section-header">
                    <div class="settings-section-icon bg-warning-soft">
                        <i class="fas fa-tachometer-alt text-warning"></i>
                    </div>
                    <div class="settings-section-title">
                        <h5>Load Gauge Capacity & Threshold</h5>
                        <p>Konfigurasi kapasitas maksimal dan batas status beban</p>
                    </div>
                </div>
                <div class="settings-section-body">
                    <div class="settings-grid">
                        <div class="settings-field">
                            <label class="form-label">Maximal Capacity (Watt)</label>
                            <input type="number" class="form-control" id="maxCapacity"
                                   value="@GetSetting("Load.MaxCapacity", "30000")"
                                   min="1000" max="1000000" step="1000" placeholder="30000">
                            <small class="text-muted">Nilai 100% pada Load Gauge</small>
                        </div>
                        <div class="settings-field">
                            <label class="form-label">Normal Threshold (%)</label>
                            <input type="number" class="form-control" id="normalThreshold"
                                   value="@GetSetting("Load.NormalThreshold", "30")"
                                   min="10" max="50" placeholder="30">
                            <small class="text-muted">Batas atas Normal (default: 30%)</small>
                        </div>
                        <div class="settings-field">
                            <label class="form-label">Medium Threshold (%)</label>
                            <input type="number" class="form-control" id="mediumThreshold"
                                   value="@GetSetting("Load.MediumThreshold", "70")"
                                   min="50" max="90" placeholder="70">
                            <small class="text-muted">Batas atas Medium (default: 70%)</small>
                        </div>
                        <div class="settings-field">
                            <label class="form-label">High Threshold (%)</label>
                            <input type="text" class="form-control" id="highThreshold"
                                   value="> 70%" readonly>
                            <small class="text-muted">Otomatis > Medium Threshold</small>
                        </div>
                    </div>

                    @* <!-- Preview Load Gauge -->
                    <div class="settings-preview-box">
                        <div class="settings-preview-label"><i class="fas fa-eye"></i> Preview</div>
                        <div class="row g-3">
                            <div class="col-md-4">
                                <div class="settings-threshold-card settings-threshold-normal">
                                    <div class="settings-threshold-label">Normal</div>
                                    <div class="settings-threshold-value" id="previewNormal">9,000 W</div>
                                    <div class="progress" style="height: 8px;">
                                        <div class="progress-bar bg-success" style="width: 30%"></div>
                                    </div>
                                    <small>≤ 30%</small>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="settings-threshold-card settings-threshold-medium">
                                    <div class="settings-threshold-label">Medium</div>
                                    <div class="settings-threshold-value" id="previewMedium">21,000 W</div>
                                    <div class="progress" style="height: 8px;">
                                        <div class="progress-bar bg-warning" style="width: 70%"></div>
                                    </div>
                                    <small>31% - 70%</small>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="settings-threshold-card settings-threshold-high">
                                    <div class="settings-threshold-label">High</div>
                                    <div class="settings-threshold-value" id="previewHigh">30,000 W</div>
                                    <div class="progress" style="height: 8px;">
                                        <div class="progress-bar bg-danger" style="width: 100%"></div>
                                    </div>
                                    <small>> 70%</small>
                                </div>
                            </div>
                        </div>
                    </div> *@
                </div>
            </div>

            <!-- 4. TARIFF -->
            <div class="settings-section">
                <div class="settings-section-header">
                    <div class="settings-section-icon bg-success-soft">
                        <i class="fas fa-money-bill-wave text-success"></i>
                    </div>
                    <div class="settings-section-title">
                        <h5>Tarif Listrik per kWh</h5>
                        <p>Atur tarif listrik untuk menghitung estimasi biaya penggunaan energi</p>
                    </div>
                </div>
                <div class="settings-section-body">
                    <div class="settings-grid">
                        <div class="settings-field">
                            <label class="form-label">Tarif per kWh (Rp)</label>
                            <input type="number" class="form-control" id="tariffPerKWh" value="1500" min="0" step="50">
                            <small class="text-muted">/kWh — digunakan untuk estimasi biaya di Usage Statistics</small>
                        </div>
                    </div>
                </div>
            </div>

        </div>

        <!-- Sticky Save Bar -->
        <div class="settings-save-bar">
            <div class="settings-save-bar-inner">
                @* <div class="settings-save-bar-info">
                    <i class="fas fa-info-circle text-muted"></i>
                    <span>Perubahan System Settings akan tersimpan permanen di database</span>
                </div> *@
                <div class="settings-save-bar-actions">
                    <button type="button" class="btn btn-outline-secondary btn-sm" id="btnResetSystemSettings">
                        <i class="fas fa-undo"></i> Reset Default
                    </button>
                    @* <button type="button" class="btn btn-outline-info btn-sm" id="btnExportSettings">
                        <i class="fas fa-download"></i> Export
                    </button> *@
                    <button type="button" class="btn btn-primary btn-sm" id="btnSaveSystemSettings">
                        <i class="fas fa-save"></i> Save Settings
                    </button>
                </div>
            </div>
        </div>
        </form>
    </div>

    <!-- ==================== NOTIFICATION SETTINGS TAB ==================== -->
    <div class="tab-pane fade" id="notification" role="tabpanel" aria-labelledby="notification-tab">
        <form id="notificationSettingsForm">
        <div class="settings-section-list">

            <!-- Email Settings -->
            <div class="settings-section">
                <div class="settings-section-header">
                    <div class="settings-section-icon bg-primary-soft">
                        <i class="fas fa-envelope text-primary"></i>
                    </div>
                    <div class="settings-section-title">
                        <h5>Email Notification</h5>
                        <p>Konfigurasi SMTP untuk pengiriman email notifikasi</p>
                    </div>
                    <div class="settings-section-action">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="enableEmail">
                            <label class="form-check-label small">Enable</label>
                        </div>
                    </div>
                </div>
                <div class="settings-section-body">
                    <div class="settings-grid">
                        <div class="settings-field">
                            <label class="form-label">SMTP Server</label>
                            <input type="text" class="form-control" id="smtpServer" value="smtp.gmail.com" placeholder="smtp.gmail.com">
                            <small class="text-muted">Contoh: smtp.gmail.com, smtp.office365.com</small>
                        </div>
                        <div class="settings-field">
                            <label class="form-label">SMTP Port</label>
                            <input type="number" class="form-control" id="smtpPort" value="587" placeholder="587">
                            <small class="text-muted">587 (TLS) atau 465 (SSL)</small>
                        </div>
                        <div class="settings-field">
                            <label class="form-label">Sender Email</label>
                            <input type="email" class="form-control" id="senderEmail" placeholder="your.email@gmail.com">
                            <small class="text-muted">Email pengirim notifikasi</small>
                        </div>
                        <div class="settings-field">
                            <label class="form-label">App Password</label>
                            <input type="password" class="form-control" id="senderPassword" placeholder="App Password">
                            <small class="text-muted">Gunakan App Password jika pakai Gmail</small>
                        </div>
                        <div class="settings-field settings-field-full">
                            <label class="form-label">Recipient Email</label>
                            <input type="text" class="form-control" id="recipientEmail" placeholder="admin@pabrik.com, manager@pabrik.com">
                            <small class="text-muted">Pisahkan dengan tanda koma (,) untuk lebih dari 1 email</small>
                        </div>
                    </div>
                    <div class="settings-section-footer">
                        <button class="btn btn-outline-primary btn-sm" id="btnTestEmail">
                            <i class="fas fa-paper-plane"></i> Test Email
                        </button>
                    </div>
                </div>
            </div>

            <!-- WhatsApp Settings -->
            <div class="settings-section">
                <div class="settings-section-header">
                    <div class="settings-section-icon bg-success-soft">
                        <i class="fab fa-whatsapp text-success"></i>
                    </div>
                    <div class="settings-section-title">
                        <h5>WhatsApp Notification</h5>
                        <p>Konfigurasi Wablas API untuk pengiriman pesan WhatsApp</p>
                    </div>
                    <div class="settings-section-action">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="enableWhatsApp">
                            <label class="form-check-label small">Enable</label>
                        </div>
                    </div>
                </div>
                <div class="settings-section-body">
                    <div class="settings-info-banner settings-info-banner-info">
                        <i class="fas fa-info-circle"></i>
                        <div>
                            <strong>Wablas</strong> — WhatsApp Gateway API untuk Indonesia.
                            <a href="https://wablas.com" target="_blank">Daftar di wablas.com <i class="fas fa-external-link-alt"></i></a>
                        </div>
                    </div>
                    <div class="settings-grid">
                        <div class="settings-field">
                            <label class="form-label">Server URL</label>
                            <input type="text" class="form-control" id="wablasServerUrl"
                                   placeholder="https://pati.wablas.com">
                        </div>
                        <div class="settings-field">
                            <label class="form-label">API Token</label>
                            <input type="password" class="form-control" id="wablasToken" placeholder="Token dari dashboard Wablas">
                        </div>
                        <div class="settings-field">
                            <label class="form-label">Secret Key</label>
                            <input type="password" class="form-control" id="wablasSecretKey" placeholder="Secret key dari dashboard Wablas">
                        </div>
                        <div class="settings-field">
                            <label class="form-label">Nomor WhatsApp Penerima</label>
                            <input type="text" class="form-control" id="wablasPhoneNumbers"
                                   placeholder="081234567890, 082345678901">
                            <small class="text-muted">Pisahkan dengan koma (,) untuk beberapa nomor</small>
                        </div>
                    </div>
                    <div class="settings-section-footer">
                        <button class="btn btn-outline-success btn-sm" type="button" id="btnTestWablas">
                            <i class="fab fa-whatsapp"></i> Test Kirim
                        </button>
                        <button class="btn btn-outline-info btn-sm" type="button" id="btnCheckWablasDevice">
                            <i class="fas fa-mobile-alt"></i> Cek Device
                        </button>
                        <div id="wablasStatus" class="ms-2"></div>
                    </div>
                </div>
            </div>

            <!-- Notification Options -->
            <div class="settings-section">
                <div class="settings-section-header">
                    <div class="settings-section-icon bg-info-soft">
                        <i class="fas fa-sliders-h text-info"></i>
                    </div>
                    <div class="settings-section-title">
                        <h5>Jadwal Laporan</h5>
                        <p>Atur jenis dan jadwal pengiriman laporan notifikasi</p>
                    </div>
                </div>
                <div class="settings-section-body">
                    <!-- Report Toggles -->
                    <div class="settings-toggles-grid">
                        <label class="settings-toggle-card">
                            <input type="checkbox" id="sendInstantAlert" checked>
                            <div class="settings-toggle-card-inner">
                                <i class="fas fa-bell text-danger"></i>
                                <strong>Instant Alert</strong>
                                <small>Notifikasi saat anomali terdeteksi</small>
                            </div>
                        </label>
                        <label class="settings-toggle-card">
                            <input type="checkbox" id="sendHourlyReport" checked>
                            <div class="settings-toggle-card-inner">
                                <i class="fas fa-clock text-warning"></i>
                                <strong>Hourly Report</strong>
                                <small>Laporan setiap 1 jam</small>
                            </div>
                        </label>
                        <label class="settings-toggle-card">
                            <input type="checkbox" id="sendDailyReport">
                            <div class="settings-toggle-card-inner">
                                <i class="fas fa-calendar-alt text-success"></i>
                                <strong>Daily Report</strong>
                                <small>Laporan harian</small>
                            </div>
                        </label>
                        <label class="settings-toggle-card">
                            <input type="checkbox" id="sendMonthlyReport">
                            <div class="settings-toggle-card-inner">
                                <i class="fas fa-calendar-check text-primary"></i>
                                <strong>Monthly Report</strong>
                                <small>Laporan bulanan</small>
                            </div>
                        </label>
                    </div>

                    <hr class="settings-divider">

                    <!-- Schedule Settings -->
                    <div class="settings-grid">
                        <div class="settings-field">
                            <label class="form-label">Hourly Report Schedule</label>
                            <div class="form-control bg-light d-flex align-items-center" style="cursor: default;">
                                <i class="fas fa-clock text-warning me-2"></i> Setiap jam tepat (00:00, 01:00, 02:00, dst)
                            </div>
                            <small class="form-text text-muted">Laporan dikirim otomatis setiap jam pada menit ke-0</small>
                        </div>
                        <div class="settings-field">
                            <label class="form-label">Daily Report Time</label>
                            <input type="time" class="form-control" id="dailyReportTime" value="08:00">
                        </div>
                        <div class="settings-field">
                            <label class="form-label">Monthly Report Day & Time</label>
                            <div class="input-group">
                                <select class="form-select" id="monthlyReportDay">
                                    <option value="1">Tgl 1</option>
                                    <option value="2">Tgl 2</option>
                                    <option value="3">Tgl 3</option>
                                    <option value="4">Tgl 4</option>
                                    <option value="5">Tgl 5</option>
                                    <option value="6">Tgl 6</option>
                                    <option value="7">Tgl 7</option>
                                    <option value="8">Tgl 8</option>
                                    <option value="9">Tgl 9</option>
                                    <option value="10">Tgl 10</option>
                                    <option value="11">Tgl 11</option>
                                    <option value="12">Tgl 12</option>
                                    <option value="13">Tgl 13</option>
                                    <option value="14">Tgl 14</option>
                                    <option value="15">Tgl 15</option>
                                    <option value="16">Tgl 16</option>
                                    <option value="17">Tgl 17</option>
                                    <option value="18">Tgl 18</option>
                                    <option value="19">Tgl 19</option>
                                    <option value="20">Tgl 20</option>
                                    <option value="21">Tgl 21</option>
                                    <option value="22">Tgl 22</option>
                                    <option value="23">Tgl 23</option>
                                    <option value="24">Tgl 24</option>
                                    <option value="25">Tgl 25</option>
                                    <option value="26">Tgl 26</option>
                                    <option value="27">Tgl 27</option>
                                    <option value="28">Tgl 28</option>
                                </select>
                                <input type="time" class="form-control" id="monthlyReportTime" value="08:00">
                            </div>
                            <small class="text-muted">Hari ke-X setiap bulan & jam pengiriman</small>
                        </div>
                    </div>

                    <hr class="settings-divider">

                    <!-- Test Buttons -->
                    <div class="settings-test-grid">
                        <button type="button" class="btn btn-test-danger" id="btnTestInstantAlert">
                            <i class="fas fa-bell"></i> Test Instant
                        </button>
                        <button type="button" class="btn btn-test-warning" id="btnTestHourlyReport">
                            <i class="fas fa-clock"></i> Test Hourly
                        </button>
                        <button type="button" class="btn btn-test-success" id="btnTestDailyReport">
                            <i class="fas fa-calendar-alt"></i> Test Daily
                        </button>
                        <button type="button" class="btn btn-test-info" id="btnTestMonthlyReport">
                            <i class="fas fa-calendar-check"></i> Test Monthly
                        </button>
                    </div>
                </div>
            </div>

        </div>

        <!-- Sticky Save Bar -->
        <div class="settings-save-bar">
            <div class="settings-save-bar-inner">
                @* <div class="settings-save-bar-info">
                    <i class="fas fa-info-circle text-muted"></i>
                    <span>Pengaturan notifikasi akan tersimpan ke database</span>
                </div> *@
                <div class="settings-save-bar-actions">
                    <button type="button" class="btn btn-outline-secondary btn-sm" id="btnResetNotificationSettings">
                        <i class="fas fa-undo"></i> Reset Default
                    </button>
                    <button type="button" class="btn btn-primary btn-sm" id="btnSaveNotificationSettings">
                        <i class="fas fa-save"></i> Save Settings
