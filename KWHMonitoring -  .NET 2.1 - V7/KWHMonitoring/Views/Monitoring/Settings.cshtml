<!-- Settings Save Confirmation Modal -->
<div class="modal fade" id="settingsConfirmModal" tabindex="-1" role="dialog" aria-labelledby="settingsConfirmModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="settingsConfirmModalLabel"><i class="fas fa-exclamation-triangle text-warning"></i> Konfirmasi Perubahan</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <p id="settingsConfirmMessage">Apakah Anda yakin ingin menyimpan perubahan ini?</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Batal</button>
                <button type="button" class="btn btn-primary" id="settingsConfirmOk">Ya, Simpan</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Global settings confirmation modal helper
        var pendingSettingsAction = null;
        function showSettingsConfirm(title, message, callback) {
            var $modal = $('#settingsConfirmModal');
            $modal.find('.modal-title').html(title);
            $modal.find('#settingsConfirmMessage').text(message);
            pendingSettingsAction = callback;
            $modal.modal('show');
        }

        $(document).on('click', '#settingsConfirmOk', function() {
            if (typeof pendingSettingsAction === 'function') {
                pendingSettingsAction();
                pendingSettingsAction = null;
            }
            $('#settingsConfirmModal').modal('hide');
        });

        $(document).ready(function() {
            // Check if we should open a specific tab
            const urlParams = new URLSearchParams(window.location.search);
            if (urlParams.get('tab')) {
                const tabId = urlParams.get('tab') + '-tab';
                $('#' + tabId).tab('show');
            }

            // Load user management content when tab is shown
            function loadUserManagementTab() {
                var $container = $('#userManagementContainer');
                if ($container.length && $container.find('.um-action-form').length === 0) {
                    $container.html('<div class="text-center py-5"><i class="fas fa-spinner fa-spin fa-2x text-muted"></i><p class="text-muted mt-2">Memuat data user...</p></div>');
                    $.get('/UserManagement/Index', function(html) {
                        $container.html(html);
                    }).fail(function() {
                        $container.html('<div class="alert alert-danger">Gagal memuat data user.</div>');
                    });
                }
            }


            $('#users-tab').on('shown.bs.tab', function() {
                loadUserManagementTab();
            });

            // Load immediately if users tab is active on page load
            if ($('#users').hasClass('active')) {
                loadUserManagementTab();
            }

            // Sync all intervals
            $('#btnSyncIntervals').click(function() {
                var dashboardValue = $('#dashboardInterval').val();
                $('#chartsInterval').val(dashboardValue);
                $('#detailsInterval').val(dashboardValue);
                $('#anomalyInterval').val(dashboardValue);
                showNotification('All intervals synced to ' + dashboardValue + ' seconds', 'success');
            });

            // Test MQTT connection
            $('#btnTestConnection').click(function() {
                var btn = $(this);
                btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Testing...');
                $('#connectionStatus').html('').removeClass('text-success text-danger');

                var connectionData = {
                    broker: $('#mqttBroker').val(),
                    port: parseInt($('#mqttPort').val()) || 1883,
                    username: $('#mqttUsername').val(),
                    password: $('#mqttPassword').val(),
                    useTls: $('#mqttUseTls').val() === 'true',
                    clientId: $('#mqttClientId').val(),
                    clientCertPassword: $('#mqttClientCertPassword').val(),
                    skipCertValidation: $('#mqttSkipCertValidation').val() === 'true'
                };

                $.ajax({
                    url: '/api/Api/test-mqtt-connection',
                    method: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(connectionData),
                    success: function(response) {
                        $('#connectionStatus').html('<i class="fas fa-check-circle text-success"></i> Connection successful!').addClass('text-success');
                        btn.prop('disabled', false).html('<i class="fas fa-plug"></i> Test Connection');
                        showNotification('MQTT connection successful!', 'success');
                    },
                    error: function(xhr) {
                        var errorMsg = 'Connection failed';
                        try {
                            var response = JSON.parse(xhr.responseText);
                            errorMsg = response.error || errorMsg;
                        } catch(e) {}
                        $('#connectionStatus').html('<i class="fas fa-times-circle text-danger"></i> ' + errorMsg).addClass('text-danger');
                        btn.prop('disabled', false).html('<i class="fas fa-plug"></i> Test Connection');
                        showNotification('MQTT connection failed: ' + errorMsg, 'danger');
                    }
                });
            });

            // Save System Settings
            $('#btnSaveSystemSettings').click(function() {
                var btn = $(this);

                showSettingsConfirm(
                    'Simpan System Settings',
                    'Apakah Anda yakin ingin menyimpan perubahan System Settings?',
                    function() {
                        btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Saving...');

                        var settings = {
                            'MQTT.Broker': $('#mqttBroker').val(),
                            'MQTT.Port': $('#mqttPort').val(),
                            'MQTT.ClientId': $('#mqttClientId').val(),
                            'MQTT.UseTls': $('#mqttUseTls').val(),
                            'MQTT.Username': $('#mqttUsername').val(),
                            'MQTT.Password': $('#mqttPassword').val(),
                            'MQTT.TlsSkipCertValidation': $('#mqttSkipCertValidation').val(),
                            'MQTT.TlsClientCertPassword': $('#mqttClientCertPassword').val(),
                            'Interval.Dashboard': $('#dashboardInterval').val(),
                            'Interval.Charts': $('#chartsInterval').val(),
                            'Interval.Details': $('#detailsInterval').val(),
                            'Interval.Anomaly': $('#anomalyInterval').val(),
                            'Chart.DataPoints': $('#chartDataPoints').val(),
                            'Interval.AutoScan': $('#autoScanInterval').val()
                        };

                        $.ajax({
                            url: '/api/Api/save-system-settings',
                            method: 'POST',
                            contentType: 'application/json',
                            data: JSON.stringify(settings),
                            success: function(response) {
                                btn.prop('disabled', false).html('<i class="fas fa-save"></i> Save Settings');
                                showNotification('All settings saved successfully!', 'success');
                                setTimeout(function() { location.reload(); }, 1000);
                            },
                            error: function(xhr) {
                                btn.prop('disabled', false).html('<i class="fas fa-save"></i> Save Settings');
                                showNotification('Error saving settings', 'danger');
                            }
                        });
                    }
                );
            });

            // Reset System Settings
            $('#btnResetSystemSettings').click(function() {
                if (confirm('Reset semua settings ke default?')) {
                    $('#mqttBroker').val('localhost');
                    $('#mqttPort').val('1883');
                    $('#mqttClientId').val('KWHMonitoringWeb');
                    $('#mqttUseTls').val('false');
                    $('#mqttUsername').val('');
                    $('#mqttPassword').val('');
                    $('#mqttClientCertPassword').val('');
                    $('#mqttSkipCertValidation').val('false');
                    $('#mqttCaCertFile').val('');
                    $('#mqttClientCertFile').val('');
                    toggleTlsPanel();
                    $('#dashboardInterval').val('10');
                    $('#chartsInterval').val('10');
                    $('#detailsInterval').val('10');
                    $('#anomalyInterval').val('10');
                    $('#chartDataPoints').val('20');
                    $('#autoScanInterval').val('60');
                    showNotification('Settings reset to default. Click Save to apply.', 'info');
                }
            });

            // ============================================
            // MQTT TLS / SSL CERTIFICATES
            // ============================================
            function toggleTlsPanel() {
                if ($('#mqttUseTls').val() === 'true') {
                    $('#tlsOptionsPanel').show();
                } else {
                    $('#tlsOptionsPanel').hide();
                }
            }
            $('#mqttUseTls').on('change', toggleTlsPanel);
            toggleTlsPanel();

            function renderCertStatus($statusEl, fileName, type) {
                if (fileName && fileName.length > 0) {
                    $statusEl.html('<i class="fas fa-certificate text-success"></i> Tersimpan: <b>' + fileName + '</b> ' +
                        '<a href="javascript:void(0)" class="remove-mqtt-cert text-danger" data-type="' + type + '" style="margin-left:6px;">' +
                        '<i class="fas fa-trash-alt"></i> Hapus</a>');
                } else {
                    $statusEl.html('<i class="far fa-file text-muted"></i> Belum ada sertifikat');
                }
            }

            var caCertStatus = $('#mqttCaCertStatus');
            var clientCertStatus = $('#mqttClientCertStatus');
            renderCertStatus(caCertStatus, caCertStatus.data('stored') || '', 'ca');
            renderCertStatus(clientCertStatus, clientCertStatus.data('stored') || '', 'client');

            function uploadMqttCertificate($input, $statusEl, type) {
                if (!$input[0].files || $input[0].files.length === 0) {
                    return;
                }
                var fd = new FormData();
                fd.append('file', $input[0].files[0]);
                fd.append('certificateType', type);
                fd.append('certificatePassword', $('#mqttClientCertPassword').val() || '');

                $statusEl.html('<i class="fas fa-spinner fa-spin text-muted"></i> Mengunggah...');

                $.ajax({
                    url: '/api/Api/upload-mqtt-certificate?certificateType=' + encodeURIComponent(type),
                    method: 'POST',
                    data: fd,
                    processData: false,
                    contentType: false,
                    success: function(response) {
                        $statusEl.data('stored', response.fileName);
                        renderCertStatus($statusEl, response.fileName, type);
                        showNotification('Sertifikat ' + type.toUpperCase() + ' berhasil di-upload', 'success');
                    },
                    error: function(xhr) {
                        var errorMsg = 'Upload sertifikat gagal';
                        try {
                            var response = JSON.parse(xhr.responseText);
                            errorMsg = response.error || errorMsg;
                        } catch(e) {}
                        $statusEl.html('<i class="fas fa-times-circle text-danger"></i> ' + errorMsg);
                        showNotification('Upload sertifikat gagal: ' + errorMsg, 'danger');
                    },
                    complete: function() {
                        $input.val('');
                    }
                });
            }

            $('#mqttCaCertFile').on('change', function() {
                uploadMqttCertificate($(this), caCertStatus, 'ca');
            });

            $('#mqttClientCertFile').on('change', function() {
                uploadMqttCertificate($(this), clientCertStatus, 'client');
            });

            $(document).on('click', '.remove-mqtt-cert', function() {
                var type = $(this).data('type');
                var $statusEl = type === 'ca' ? caCertStatus : clientCertStatus;
                if (!confirm('Hapus sertifikat ini dari server?')) {
                    return;
                }
                $statusEl.html('<i class="fas fa-spinner fa-spin text-muted"></i> Menghapus...');
                $.ajax({
                    url: '/api/Api/remove-mqtt-certificate',
                    method: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({ certificateType: type }),
                    success: function() {
                        $statusEl.data('stored', '');
                        renderCertStatus($statusEl, '', type);
                        showNotification('Sertifikat berhasil dihapus', 'success');
                    },
                    error: function() {
                        renderCertStatus($statusEl, $statusEl.data('stored') || '', type);
                        showNotification('Gagal menghapus sertifikat', 'danger');
                    }
                });
            });

            // Export settings
            $('#btnExportSettings').click(function() {
                var settings = {
                    MQTT: {
                        Broker: $('#mqttBroker').val(),
                        Port: $('#mqttPort').val(),
                        ClientId: $('#mqttClientId').val(),
                        UseTls: $('#mqttUseTls').val(),
                        Username: $('#mqttUsername').val()
                    },
                    Intervals: {
                        Dashboard: $('#dashboardInterval').val(),
                        Charts: $('#chartsInterval').val(),
                        Details: $('#detailsInterval').val(),
                        Anomaly: $('#anomalyInterval').val(),
                        DataPoints: $('#chartDataPoints').val(),
                        AutoScan: $('#autoScanInterval').val()
                    },
                    LoadGauge: {
                        // Per-device: managed in Per-Device Settings tab
                    },
                    Tariff: {
                        // Per-device: managed in Per-Device Settings tab
                    }
                };

                var dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(settings, null, 2));
                var downloadAnchorNode = document.createElement('a');
                downloadAnchorNode.setAttribute("href", dataStr);
                downloadAnchorNode.setAttribute("download", "kwh_monitoring_settings_" + new Date().toISOString().slice(0,10) + ".json");
                document.body.appendChild(downloadAnchorNode);
                downloadAnchorNode.click();
                downloadAnchorNode.remove();
                showNotification('Settings exported successfully!', 'success');
            });

            // ============================================
            // NOTIFICATION SETTINGS
            // ============================================

            loadNotificationSettings();
            loadControlMode();

            $('#btnSaveNotificationSettings').click(function() {
                saveNotificationSettings();
            });

            $('#btnTestEmail').click(function() {
                testEmail();
            });

            $('#btnTestWablas').click(function () {
                testWablas();
            });

            $('#btnCheckWablasDevice').click(function () {
                checkWablasDevice();
            });

            $('#btnResetNotificationSettings').click(function() {
                if (confirm('Reset notification settings ke default?')) {
                    resetNotificationSettings();
                }
            });

            $('#btnTestInstantAlert').click(function() {
                var btn = $(this);
                btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Sending...');
                $.ajax({
                    url: '/api/Api/test-instant-alert',
                    method: 'POST',
                    success: function(response) {
                        showNotification(response.message || 'Test instant alert sent successfully!', 'success');
                    },
                    error: function(xhr, status, error) {
                        showNotification('Error: ' + (xhr.responseJSON?.error || error), 'danger');
                    },
                    complete: function() {
                        btn.prop('disabled', false).html('<i class="fas fa-bell"></i> Test Instant');
                    }
                });
            });

            $('#btnTestHourlyReport').click(function() {
                var btn = $(this);
                btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Sending...');
