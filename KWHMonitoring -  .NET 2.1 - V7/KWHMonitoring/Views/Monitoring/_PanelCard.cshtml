@model KWHMonitoring.Models.PanelViewModel

<div class="card shadow-sm h-100 border-0 panel-card-clickable"
     id="panelCard_@(Model.DeviceKey.Replace("-", "_"))"
     data-device-key="@Model.DeviceKey"
     data-details-url="@Url.Action("Details", "Monitoring", new { deviceKey = Model.DeviceKey })"
     data-is-three-phase="@Model.IsThreePhase.ToString().ToLower()"
     style="cursor: pointer; transition: all 0.2s ease; overflow: hidden;"
     onmouseenter="this.style.transform='translateY(-2px)'; this.style.boxShadow='0 4px 12px rgba(0,0,0,0.15)';"
     onmouseleave="this.style.transform='translateY(0)'; this.style.boxShadow='';">

    <!-- Header -->
    <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center py-2" id="panelHeader_@(Model.DeviceKey.Replace("-", "_"))" style="overflow: hidden;">
        <h6 class="mb-0 text-truncate" style="max-width: 45%; font-size: 0.9rem;">
            <i class="fas fa-plug"></i> @Model.GroupName
        </h6>
        <div class="d-flex gap-1 flex-shrink-0 align-items-center">
            <span class="category-icon cat-Billboard" id="categoryIcon_@(Model.DeviceKey.Replace("-", "_"))" data-device-key="@Model.DeviceKey" style="font-size: 1rem; cursor: default;">🔵</span>
            @if (Model.IsThreePhase)
            {
                <span class="badge" style="background-color: #6f42c1; font-size: 0.7rem;" data-phase-type="3-phase">3&#934;</span>
            }
            else
            {
                <span class="badge" style="background-color: #fd7e14; font-size: 0.7rem;" data-phase-type="1-phase">1&#934;</span>
            }
            <span class="badge bg-success" style="font-size: 0.7rem;" id="statusBadge_@(Model.DeviceKey.Replace("-", "_"))">@Model.Status</span>
            <button type="button" class="panel-collapse-toggle"
                    data-toggle="collapse"
                    data-target="#collapse_@(Model.DeviceKey.Replace("-", "_"))"
                    aria-expanded="false"
                    aria-controls="collapse_@(Model.DeviceKey.Replace("-", "_"))"
                    title="Expand/Collapse">
                <i class="fas fa-chevron-down collapse-icon"></i>
            </button>
        </div>
    </div>

    <div class="card-body p-2 p-md-3">

        <!-- ===== POWER & AKTIF - HIGHLIGHT (Always Visible) ===== -->
        <div class="d-flex gap-2 mb-3">
            <div class="flex-fill">
                <div class="power-highlight-card text-center p-2 p-md-3">
                    <div class="power-icon"><i class="fas fa-fire"></i> Power</div>
                    <div class="power-value text-truncate" data-value="power">@Model.Daya_Watt.ToString("N0")</div>
                    <div class="power-unit">Watt</div>
                </div>
            </div>
            <div class="flex-fill">
                <div class="aktif-highlight-card text-center p-2 p-md-3">
                    <div class="aktif-icon"><i class="fas fa-bolt"></i> Aktif</div>
                    <div class="aktif-value text-truncate" data-value="energi-aktif">@Model.Energi_Aktif_Wh.ToString("N0")</div>
                    <div class="aktif-unit">Wh</div>
                </div>
            </div>
        </div>

        <!-- ===== POWER FACTOR (Always Visible) ===== -->
        <div class="mb-3">
            <div class="d-flex justify-content-between align-items-baseline mb-1">
                <span class="panel-label"><i class="fas fa-percentage"></i> Power Factor</span>
                <span class="panel-value" data-label="pf-percent">@Model.Cos_Phi.ToString("N3")</span>
            </div>
            <div class="progress panel-progress">
                <div class="progress-bar bg-@Model.CosPhiColor" role="progressbar" style="width: @(Model.Cos_Phi * 100)%" data-gauge="power-factor">
                    @Model.Cos_Phi.ToString("P0")
                </div>
            </div>
        </div>

        <!-- ===== COLLAPSIBLE SECTIONS ===== -->
        <div class="collapse" id="collapse_@(Model.DeviceKey.Replace("-", "_"))">

            <!-- ===== LOAD BAR ===== -->
            <div class="mb-3">
                @{
                    var maxCapacity = 30000m;
                    var loadPercent = Math.Min((Model.Daya_Watt / maxCapacity) * 100, 100);
                    var loadColor = loadPercent > 70 ? "bg-danger" : loadPercent > 30 ? "bg-warning" : "bg-info";
                }
                <div class="d-flex justify-content-between align-items-baseline mb-1">
                    <span class="panel-label"><i class="fas fa-tachometer-alt"></i> Load</span>
                    <span class="panel-value" data-label="load-value">@Model.Daya_Watt.ToString("N0") W / @maxCapacity.ToString("N0") W</span>
                </div>
                <div class="progress panel-progress">
                    <div class="progress-bar @loadColor" role="progressbar" style="width: @loadPercent%" data-gauge="load">
                        @loadPercent.ToString("N0")%
                    </div>
                </div>
            </div>

            <!-- ===== VOLTAGE ===== -->
            <div class="mb-3">
                @if (Model.IsThreePhase)
                {
                    <div class="d-flex justify-content-between align-items-baseline mb-1">
                        <span class="panel-label"><i class="fas fa-bolt"></i> Voltage</span>
                        <span class="panel-value">Avg @Model.AvgVoltage.ToString("N1") V</span>
                    </div>
                    <div class="d-flex gap-1">
                        <div class="phase-badge flex-fill text-center bg-@Model.PhaseRColor" data-volt-badge data-phase="R">
                            <span class="phase-letter">R</span>
                            <span class="phase-val">@Model.Volt_R.ToString("N1")</span>
                        </div>
                        <div class="phase-badge flex-fill text-center bg-@Model.PhaseSColor" data-volt-badge data-phase="S">
                            <span class="phase-letter">S</span>
                            <span class="phase-val">@Model.Volt_S.Value.ToString("N1")</span>
                        </div>
                        <div class="phase-badge flex-fill text-center bg-@Model.PhaseTColor" data-volt-badge data-phase="T">
                            <span class="phase-letter">T</span>
                            <span class="phase-val">@Model.Volt_T.Value.ToString("N1")</span>
                        </div>
                    </div>
                }
                else
                {
                    <div class="d-flex justify-content-between align-items-baseline mb-1">
                        <span class="panel-label"><i class="fas fa-bolt"></i> Voltage</span>
                        <span class="panel-value">@Model.Volt_R.ToString("N1") V</span>
                    </div>
                    <div class="phase-badge text-center bg-@Model.PhaseRColor" data-volt-badge data-phase="R">
                        <span class="phase-letter">R</span>
                        <span class="phase-val">@Model.Volt_R.ToString("N1")</span>
                    </div>
                }
            </div>

            <!-- ===== CURRENT ===== -->
            <div class="mb-3">
                @if (Model.IsThreePhase)
                {
                    <div class="d-flex justify-content-between align-items-baseline mb-1">
                        <span class="panel-label"><i class="fas fa-wave-square"></i> Current</span>
                        <span class="panel-value">Avg @Model.AvgAmpere.ToString("N2") A</span>
                    </div>
                    <div class="d-flex gap-1">
                        <div class="phase-badge flex-fill text-center bg-secondary" data-amp-badge data-phase="R">
                            <span class="phase-letter">R</span>
                            <span class="phase-val">@Model.Amp_R.ToString("N2")</span>
                        </div>
                        <div class="phase-badge flex-fill text-center bg-secondary" data-amp-badge data-phase="S">
                            <span class="phase-letter">S</span>
                            <span class="phase-val">@Model.Amp_S.Value.ToString("N2")</span>
                        </div>
                        <div class="phase-badge flex-fill text-center bg-secondary" data-amp-badge data-phase="T">
                            <span class="phase-letter">T</span>
                            <span class="phase-val">@Model.Amp_T.Value.ToString("N2")</span>
                        </div>
                    </div>
                }
                else
                {
                    <div class="d-flex justify-content-between align-items-baseline mb-1">
                        <span class="panel-label"><i class="fas fa-wave-square"></i> Current</span>
                        <span class="panel-value">@Model.Amp_R.ToString("N2") A</span>
                    </div>
                    <div class="phase-badge text-center bg-secondary" data-amp-badge data-phase="R">
                        <span class="phase-letter">R</span>
                        <span class="phase-val">@Model.Amp_R.ToString("N2")</span>
                    </div>
                }
            </div>

            <!-- ===== COS PHI & FREQ ===== -->
            <div class="d-flex gap-2">
                <div class="flex-fill">
                    <div class="info-chip text-center">
                        <span class="info-chip-label">Cos &#934;</span>
                        <span class="info-chip-value" data-value="cosphi">@Model.Cos_Phi.ToString("N3")</span>
                    </div>
                </div>
                <div class="flex-fill">
                    <div class="info-chip text-center">
                        <span class="info-chip-label">Freq</span>
                        <span class="info-chip-value" data-value="freq">@Model.Frekuensi_Hz.ToString("N2") Hz</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card-footer bg-light py-2 text-center">
        <small class="text-muted" style="font-size: 0.75rem;">
            <i class="fas fa-mouse-pointer"></i> Klik untuk Details
        </small>
    </div>
</div>
