@model KWHMonitoring.Models.PanelViewModel

<div class="card shadow-sm h-100 border-0 panel-card-clickable"
     data-card-help=" "
     id="panelCard_@(Model.DeviceKey.Replace("-", "_"))"
     data-device-key="@Model.DeviceKey"
     data-details-url="@Url.Action("Details", "Monitoring", new { deviceKey = Model.DeviceKey })"
     data-is-three-phase="@Model.IsThreePhase.ToString().ToLower()"
     data-card-help-lokasi-kode="@Model.KodeLokasi"
     data-card-help-lokasi-alamat="@Model.Alamat"
     data-card-help-lokasi-kota="@Model.KotaProvinsi"
      data-card-help-lokasi-id-pelanggan="@Model.IDPelanggan"
      data-card-help-lokasi-daya-terpasang="@Model.InstalledCapacityVA VA"
     data-card-help-lokasi-catatan="@Model.Catatan"
     style="cursor: pointer; transition: all 0.2s ease; overflow: hidden;"
     onmouseenter="this.style.transform='translateY(-2px)'; this.style.boxShadow='0 4px 12px rgba(0,0,0,0.15)';"
     onmouseleave="this.style.transform='translateY(0)'; this.style.boxShadow='';">

    <!-- Header -->
    <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center py-2" id="panelHeader_@(Model.DeviceKey.Replace("-", "_"))" style="overflow: hidden;">
        <h6 class="mb-0 text-truncate" style="max-width: 100%; font-size: 0.9rem;">
            <i class="fas fa-plug"></i> @Model.GroupName
        </h6>
        <div class="d-flex gap-1 flex-shrink-0 align-items-center">
            <span class="category-icon cat-Billboard" id="categoryIcon_@(Model.DeviceKey.Replace("-", "_"))" data-device-key="@Model.DeviceKey" style="font-size: 1rem; cursor: default;"></span>
            @if (Model.IsThreePhase)
            {
                <span class="badge bg-info" style="font-size: 0.7rem;" data-phase-type="3-phase">3&#934;</span>
            }
            else
            {
                <span class="badge bg-warning" style="font-size: 0.7rem; color: #212529;" data-phase-type="1-phase">1&#934;</span>
            }
            @* <span class="badge bg-success" style="font-size: 0.7rem;" data-volt-header>@Model.Volt_R.ToString("N1")V</span> *@
            @* <span class="badge bg-success" style="font-size: 0.7rem;" id="statusBadge_@(Model.DeviceKey.Replace("-", "_"))">@Model.Status</span> *@
            <button type="button" class="panel-collapse-toggle"
                    data-toggle="collapse"
                    data-target="#collapse_@(Model.DeviceKey.Replace("-", "_"))"
                    aria-expanded="false"
                    aria-controls="collapse_@(Model.DeviceKey.Replace("-", "_"))"
                    title="Expand/Collapse">
                <i class="fas fa-chevron-down collapse-icon"></i>
            </button>
        </div>
    </div>

    <div class="card-body p-2 p-md-3">

        <!-- ===== PRIMARY REALTIME METRICS (Always Visible) ===== -->
        <div class="panel-primary-metrics">
            @{
                var loadPercent = Model.MaxCapacity > 0 ? Math.Min((Model.Daya_Watt / Model.MaxCapacity) * 100, 100) : 0m;
                var loadColor = Model.MaxCapacity <= 0 ? "bg-secondary" : loadPercent > Model.LoadMediumThreshold ? "bg-danger" : loadPercent > Model.LoadNormalThreshold ? "bg-warning" : "bg-info";
                var loadLabel = Model.MaxCapacity > 0 ? $"{Model.Daya_Watt:N0} W / {Model.MaxCapacity:N0} W" : $"{Model.Daya_Watt:N0} W";
            }

            <div class="panel-reference-topline">
                <div class="power-highlight-card text-center" data-card-help="Daya (Watt)|Daya aktif sesaat dari perangkat &mdash; konsumsi listrik pada saat ini.|Rumus 3 fasa: P = &#8730;3 &times; V &times; I &times; Cos Phi&#10;Beban (%) = Daya &divide; Kapasitas Maks &times; 100|Nilai ini yang menentukan kecepatan bertambahnya energi (Wh).">
                    <div class="power-icon"><i class="fas fa-fire"></i> Beban Daya</div>
                    <div class="power-value text-truncate" data-value="power">@Model.Daya_Watt.ToString("N0")</div>
                    <div class="power-unit">Watt</div>
                </div>

                <div class="phase-matrix @(Model.IsThreePhase ? "phase-matrix-3" : "phase-matrix-1")" aria-label="Voltage dan ampere per phase">
                    <div class="phase-matrix-cell bg-@Model.PhaseRColor" data-volt-badge data-phase="R">
                        <span class="phase-key">R</span>
                        <span class="phase-val">@Model.Volt_R.ToString("N1")</span>
                        <span class="phase-unit">V</span>
                    </div>
                    <div class="phase-matrix-cell bg-secondary" data-amp-badge data-phase="R">
                        <span class="phase-key">R</span>
                        <span class="phase-val">@Model.Amp_R.ToString("N2")</span>
                        <span class="phase-unit">A</span>
                    </div>
                    @if (Model.IsThreePhase)
                    {
                        <div class="phase-matrix-cell bg-@Model.PhaseSColor" data-volt-badge data-phase="S">
                            <span class="phase-key">S</span>
                            <span class="phase-val">@Model.Volt_S.Value.ToString("N1")</span>
                            <span class="phase-unit">V</span>
                        </div>
                        <div class="phase-matrix-cell bg-secondary" data-amp-badge data-phase="S">
                            <span class="phase-key">S</span>
                            <span class="phase-val">@Model.Amp_S.Value.ToString("N2")</span>
                            <span class="phase-unit">A</span>
                        </div>
                        <div class="phase-matrix-cell bg-@Model.PhaseTColor" data-volt-badge data-phase="T">
                            <span class="phase-key">T</span>
                            <span class="phase-val">@Model.Volt_T.Value.ToString("N1")</span>
                            <span class="phase-unit">V</span>
                        </div>
                        <div class="phase-matrix-cell bg-secondary" data-amp-badge data-phase="T">
                            <span class="phase-key">T</span>
                            <span class="phase-val">@Model.Amp_T.Value.ToString("N2")</span>
                            <span class="phase-unit">A</span>
                        </div>
                    }
                </div>
            </div>

                <div class="panel-gauge-group panel-reference-gauge">
                    <div class="d-flex justify-content-between align-items-baseline mb-1">
                        <span class="panel-label"><i class="fas fa-percentage"></i> Faktor Daya</span>
                        <span class="panel-value" data-label="pf-percent" data-value="cosphi">@Model.Cos_Phi.ToString("N3")</span>
                    </div>
                    <div class="progress panel-progress">
                        <div class="progress-bar bg-@Model.CosPhiColor" role="progressbar" style="width: @(Model.Cos_Phi * 100)%" data-gauge="power-factor">@Model.Cos_Phi.ToString("P0")</div>
                    </div>
                </div>
            <div class="panel-gauge-group panel-reference-gauge">
                <div class="d-flex justify-content-between align-items-baseline mb-1">
                    <span class="panel-label"><i class="fas fa-tachometer-alt"></i> Beban Daya</span>
                    <span class="panel-value" data-label="load-value">@loadLabel</span>
                </div>
                <div class="progress panel-progress">
                    @if (Model.MaxCapacity > 0)
                    {
                        <div class="progress-bar @loadColor" role="progressbar" style="width: @loadPercent%" data-gauge="load">@loadPercent.ToString("N0")%</div>
                    }
                    else
                    {
                        <div class="progress-bar @loadColor" role="progressbar" style="width: 100%" data-gauge="load">N/A</div>
                    }
                </div>
            </div>
        </div>

        <!-- ===== COLLAPSIBLE SECTIONS ===== -->
        <div class="collapse" id="collapse_@(Model.DeviceKey.Replace("-", "_"))">
            <div class="panel-secondary-metrics">

                <div class="panel-average-row">
                <span class="average-badge average-badge-active" data-label="voltage-avg">AVG V @Model.AvgVoltage.ToString("N1") V</span>
                <span class="average-badge average-badge-muted" data-label="current-avg">AVG A @Model.AvgAmpere.ToString("N2") A</span>
            </div>

                <div class="panel-energy-row">
                    <div class="aktif-highlight-card text-center" data-card-help="Energi Aktif (Wh)|Akumulasi energi aktif perangkat (kumulatif) &mdash; energi yang dihitung ke tagihan.|Rumus: kWh = Wh &divide; 1.000&#10;Biaya = kWh &times; Tarif (Rp/kWh)|Energi reaktif tidak dihitung dalam biaya listrik.">
                        <div class="aktif-icon"><i class="fas fa-bolt"></i> Energi Aktif</div>
                        <div class="aktif-value text-truncate" data-value="energi-aktif">@Model.Energi_Aktif_Wh.ToString("N0")</div>
                        <div class="aktif-unit">Wh</div>
                    </div>
                    <div class="monthly-energy-card text-center">
                        <div class="aktif-icon"><i class="fas fa-calendar-alt"></i> Energi 1 Bulan</div>
                        <div class="aktif-value text-truncate" data-value="energi-bulanan">@Model.TotalW1M_Wh.ToString("N0")</div>
                        <div class="aktif-unit">Wh</div>
                    </div>
                </div>

                <div class="frequency-highlight text-center">
                    <span class="info-chip-label">FREQ</span>
                    <span class="info-chip-value" data-value="freq">@Model.Frekuensi_Hz.ToString("N2") Hz</span>
                </div>
            </div>

            <!-- ===== DEVICE CONTROL ===== -->
            @{
                var controlMode = Model.ControlMode ?? "OnOff";
                var canControl = User.Identity.IsAuthenticated && (User.IsInRole("Operator") || User.IsInRole("Admin"));
            }
            @if (canControl)
            {
                @if (controlMode == "Toggle")
                {
                    <div class="device-control-wrapper unknown mt-3" data-device-key="@Model.DeviceKey" data-device-id="@Model.DeviceId" data-group-name="@Model.GroupName" data-control-mode="Toggle" data-relay-state="unknown">
                        <span class="relay-indicator" aria-hidden="true"></span>
                        <div class="d-flex gap-2 device-control-buttons">
                            <button type="button" class="btn btn-sm btn-success flex-fill btn-device-toggle"
                                    data-device-id="@Model.DeviceId" data-device-key="@Model.DeviceKey"
                                    data-relay="1" data-state="off" title="Toggle">
                                <i class="fas fa-power-off"></i> <span>POWER</span>
                            </button>
                        </div>
                    </div>
                }
                else if (controlMode == "Pulse")
                {
                    <div class="device-control-wrapper unknown mt-3" data-device-key="@Model.DeviceKey" data-device-id="@Model.DeviceId" data-group-name="@Model.GroupName" data-control-mode="Pulse" data-relay-state="unknown">
                        <span class="relay-indicator" aria-hidden="true"></span>
                        <div class="d-flex gap-2 device-control-buttons">
                            <button type="button" class="btn btn-sm btn-success flex-fill btn-device-pulse"
                                    data-device-id="@Model.DeviceId" data-device-key="@Model.DeviceKey"
                                    data-rc="1" title="Pulse ON">
                                <i class="fas fa-bolt"></i> ON
                            </button>
                            <button type="button" class="btn btn-sm btn-danger flex-fill btn-device-pulse"
                                    data-device-id="@Model.DeviceId" data-device-key="@Model.DeviceKey"
                                    data-rc="2" title="Pulse OFF">
                                <i class="fas fa-bolt"></i> OFF
                            </button>
                        </div>
                    </div>
                }
                else if (controlMode == "OnOff")
                {
                    <div class="device-control-wrapper unknown mt-3" data-device-key="@Model.DeviceKey" data-device-id="@Model.DeviceId" data-group-name="@Model.GroupName" data-control-mode="OnOff" data-relay-state="unknown">
                        <span class="relay-indicator" aria-hidden="true"></span>
                        <div class="d-flex gap-2 device-control-buttons">
                            <button type="button" class="btn btn-sm btn-success flex-fill btn-device-on"
                                    data-device-id="@Model.DeviceId" data-device-key="@Model.DeviceKey"
                                    title="Turn ON">
                                <i class="fas fa-power-off"></i> ON
                            </button>
                            <button type="button" class="btn btn-sm btn-danger flex-fill btn-device-off"
                                    data-device-id="@Model.DeviceId" data-device-key="@Model.DeviceKey"
                                    title="Turn OFF">
                                <i class="fas fa-power-off"></i> OFF
                            </button>
                        </div>
                    </div>
                }
                else if (controlMode == "Toggle2Relay")
                {
                    <div class="d-flex gap-2 mt-3">
                        <div class="device-control-wrapper unknown flex-fill" data-device-key="@Model.DeviceKey" data-device-id="@Model.DeviceId" data-group-name="@Model.GroupName" data-control-mode="Toggle2Relay" data-relay="1" data-relay-state="unknown">
                            <span class="relay-indicator" aria-hidden="true"></span>
                            <div class="device-control-buttons">
                                <button type="button" class="btn btn-sm btn-success w-100 btn-device-toggle"
                                        data-device-id="@Model.DeviceId" data-device-key="@Model.DeviceKey"
                                        data-relay="1" data-state="off" title="Relay 1">
                                    <i class="fas fa-power-off"></i> <span>R1</span>
                                </button>
                            </div>
                        </div>
                        <div class="device-control-wrapper unknown flex-fill" data-device-key="@Model.DeviceKey" data-device-id="@Model.DeviceId" data-group-name="@Model.GroupName" data-control-mode="Toggle2Relay" data-relay="2" data-relay-state="unknown">
                            <span class="relay-indicator" aria-hidden="true"></span>
                            <div class="device-control-buttons">
                                <button type="button" class="btn btn-sm btn-danger w-100 btn-device-toggle"
                                        data-device-id="@Model.DeviceId" data-device-key="@Model.DeviceKey"
                                        data-relay="2" data-state="off" title="Relay 2">
                                    <i class="fas fa-power-off"></i> <span>R2</span>
                                </button>
                            </div>
                        </div>
                    </div>
                }
                else if (controlMode == "ToggleAll")
                {
                    <div class="device-control-wrapper unknown mt-3" data-device-key="@Model.DeviceKey" data-device-id="@Model.DeviceId" data-group-name="@Model.GroupName" data-control-mode="ToggleAll" data-relay-state="unknown">
                        <span class="relay-indicator" aria-hidden="true"></span>
                        <div class="d-flex gap-2 device-control-buttons">
                            <button type="button" class="btn btn-sm btn-success flex-fill btn-device-toggle"
                                    data-device-id="@Model.DeviceId" data-device-key="@Model.DeviceKey"
                                    data-relay="all" data-state="off" title="Toggle All">
                                <i class="fas fa-power-off"></i> <span>ON ALL</span>
                            </button>
                        </div>
                    </div>
                }
            }
            else
            {
            }
        </div>
    </div>

    <div class="card-footer bg-light py-2 text-center">
        <small class="text-muted" style="font-size: 0.75rem;">
            <i class="fas fa-mouse-pointer"></i> Klik untuk melihat detail
        </small>
    </div>
</div>