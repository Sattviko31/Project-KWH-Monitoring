@model IEnumerable<KWHMonitoring.Models.AnomalyLog>
@{
    ViewData["Title"] = "Anomaly Logs";
}

<div class="container-fluid px-4">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h2><i class="fas fa-exclamation-triangle text-warning"></i> Anomaly Logs</h2>
                    <p class="text-muted mb-0">Log semua kejadian overload dan device drop dari semua panel</p>
                </div>
                <div>
                    <button class="btn btn-erp-action" id="btnRefresh">
                        <i class="fas fa-sync-alt"></i> Refresh
                    </button>
                    <a asp-action="Index" class="btn btn-erp-action">
                        <i class="fas fa-arrow-left"></i> Back to Dashboard
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Tabs -->
    <div class="erp-tabs">
        <a class="erp-tab" asp-controller="Monitoring" asp-action="Index">
            <i class="fas fa-th"></i> <span>Panel Monitoring</span>
        </a>
        <a class="erp-tab" asp-controller="Monitoring" asp-action="Charts">
            <i class="fas fa-chart-line"></i> <span>All Charts</span>
        </a>
        <a class="erp-tab" asp-controller="Monitoring" asp-action="UsageStatistics">
            <i class="fas fa-chart-bar"></i> <span>Usage Stats</span>
        </a>
        <a class="erp-tab active" asp-controller="Monitoring" asp-action="AnomalyLogs">
            <i class="fas fa-exclamation-triangle"></i> <span>Anomaly Logs</span>
        </a>
    </div>

    <!-- Summary Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card bg-danger text-white shadow-sm">
                <div class="card-body text-center">
                    <h6 class="text-uppercase small opacity-75">Total Overload</h6>
                    <h3 class="mb-0" id="totalOverload">0</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-warning text-dark shadow-sm">
                <div class="card-body text-center">
                    <h6 class="text-uppercase small opacity-75">Total Device Drop</h6>
                    <h3 class="mb-0" id="totalDrop">0</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-info text-white shadow-sm">
                <div class="card-body text-center">
                    <h6 class="text-uppercase small opacity-75">Total Logs</h6>
                    <h3 class="mb-0" id="totalLogs">0</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-success text-white shadow-sm">
                <div class="card-body text-center">
                    <h6 class="text-uppercase small opacity-75">Active Panels</h6>
                    <h3 class="mb-0" id="activePanels">0</h3>
                </div>
            </div>
        </div>
    </div>

    <!-- Anomaly Logs Table -->
    <div class="card shadow-sm">
        <div class="card-header bg-warning text-dark d-flex justify-content-between align-items-center py-3">
            <h5 class="mb-0"><i class="fas fa-list"></i> Anomaly Logs - All Panels</h5>
            <div>
                <select class="form-select form-select-sm d-inline-block w-auto" id="filterDevice">
                    <option value="">All Devices</option>
                </select>
                <button class="btn btn-sm btn-outline-dark ms-2" id="btnFilter">
                    <i class="fas fa-filter"></i> Filter
                </button>
            </div>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>#</th>
                            <th>Time</th>
                            <th>Device</th>
                            <th>Type</th>
                            <th>Power</th>
                            <th>Threshold</th>
                            <th>Deviation</th>
                            <th>Mode</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody id="anomalyLogsBody">
                        <tr>
                            <td colspan="9" class="text-center">
                                <div class="spinner-border text-primary" role="status">
                                    <span class="visually-hidden">Loading...</span>
                                </div>
                                <p class="mt-2 text-muted">Loading anomaly logs...</p>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            <nav aria-label="Anomaly logs pagination" class="mt-3">
                <ul class="pagination justify-content-center" id="anomalyPagination"></ul>
            </nav>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let currentPage = 1;
        const pageSize = 50;
        let deviceFilter = '';

        $(document).ready(function() {
            loadAnomalyLogs();
            loadDeviceList();

            $('#btnRefresh').click(function() {
                loadAnomalyLogs();
            });

            $('#btnFilter').click(function() {
                deviceFilter = $('#filterDevice').val();
                currentPage = 1;
                loadAnomalyLogs();
            });
        });

        function loadDeviceList() {
            $.ajax({
                url: '/api/Api/panels',
                method: 'GET',
                dataType: 'json',
                success: function(panels) {
                    const deviceKeys = [...new Set(panels.map(p => p.deviceKey))];
                    deviceKeys.forEach(key => {
                        $('#filterDevice').append(`<option value="${key}">${key}</option>`);
                    });
                }
            });
        }

        function loadAnomalyLogs(page = 1) {
            currentPage = page;
            let url = `/api/Api/anomaly-logs/ALL?page=${page}&pageSize=${pageSize}`;
            if (deviceFilter) {
                url = `/api/Api/anomaly-logs/${deviceFilter}?page=${page}&pageSize=${pageSize}`;
            }

            $.ajax({
                url: url,
                method: 'GET',
                dataType: 'json',
                success: function(response) {
                    if (response.success && response.logs.length > 0) {
                        let html = '';
                        let overloadCount = 0;
                        let dropCount = 0;

                        response.logs.forEach((log, index) => {
                            const typeClass = log.anomalyType === 'OVERLOAD' ? 'danger' : 'warning';
                            const typeIcon = log.anomalyType === 'OVERLOAD' ? 'fa-bolt' : 'fa-arrow-down';
                            const typeText = log.anomalyType === 'OVERLOAD' ? 'OVERLOAD' : 'DEVICE DROP';

                            if (log.anomalyType === 'OVERLOAD') overloadCount++;
                            else dropCount++;

                            html += `
                            <tr>
                                <td>${(currentPage - 1) * pageSize + index + 1}</td>
                                <td>${new Date(log.detectedTime).toLocaleString('id-ID')}</td>
                                <td><strong>${log.deviceKey}</strong></td>
                                <td><span class="badge bg-${typeClass}"><i class="fas ${typeIcon}"></i> ${typeText}</span></td>
                                <td><strong>${formatNumber(log.powerValue)} W</strong></td>
                                <td>${formatNumber(log.thresholdValue)} W</td>
                                <td>${log.deviation}%</td>
                                <td><span class="badge bg-info">${log.thresholdMode}</span></td>
                                <td>${log.acknowledged ? '<span class="badge bg-success">Acknowledged</span>' : '<span class="badge bg-secondary">New</span>'}</td>
                            </tr>
                            `;
                        });

                        $('#anomalyLogsBody').html(html);
                        $('#totalOverload').text(overloadCount);
                        $('#totalDrop').text(dropCount);
                        $('#totalLogs').text(response.totalCount);
                        $('#activePanels').text(new Set(response.logs.map(l => l.deviceKey)).size);

                        updatePagination(response.totalCount, response.totalPages, response.page);
                    } else {
                        $('#anomalyLogsBody').html('<tr><td colspan="9" class="text-center text-muted">No anomaly logs found</td></tr>');
                        $('#totalOverload').text(0);
                        $('#totalDrop').text(0);
                        $('#totalLogs').text(0);
                    }
                },
                error: function() {
                    $('#anomalyLogsBody').html('<tr><td colspan="9" class="text-center text-danger">Failed to load anomaly logs</td></tr>');
                }
            });
        }

        function updatePagination(totalCount, totalPages, currentPage) {
            let html = '';

            if (totalPages > 1) {
                if (currentPage > 1) {
                    html += `<li class="page-item"><a class="page-link" href="#" onclick="loadAnomalyLogs(${currentPage - 1}); return false;">Previous</a></li>`;
                }

                for (let i = 1; i <= totalPages; i++) {
                    if (i === 1 || i === totalPages || (i >= currentPage - 2 && i <= currentPage + 2)) {
                        html += `<li class="page-item ${i === currentPage ? 'active' : ''}"><a class="page-link" href="#" onclick="loadAnomalyLogs(${i}); return false;">${i}</a></li>`;
                    } else if (i === currentPage - 3 || i === currentPage + 3) {
                        html += '<li class="page-item disabled"><span class="page-link">...</span></li>';
                    }
                }

                if (currentPage < totalPages) {
                    html += `<li class="page-item"><a class="page-link" href="#" onclick="loadAnomalyLogs(${currentPage + 1}); return false;">Next</a></li>`;
                }
            }

            $('#anomalyPagination').html(html);
        }

        function formatNumber(num) {
            if (num === null || num === undefined || isNaN(num)) return '0';
            return Number(num).toLocaleString('id-ID', { maximumFractionDigits: 0 });
        }
    </script>
}