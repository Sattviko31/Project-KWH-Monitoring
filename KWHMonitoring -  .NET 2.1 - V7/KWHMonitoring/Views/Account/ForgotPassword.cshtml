@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Lupa Password";
    Layout = "_Layout";
    ViewData["AuthPage"] = true;
}

<div class="auth-page">
    <div class="auth-card">
        <div class="card-body text-center">
            <div class="auth-logo">
                <i class="fas fa-key"></i>
            </div>
            <h3 class="auth-title">Lupa Password?</h3>
            <p class="auth-subtitle">Masukkan email Anda, kami akan kirimkan link reset password.</p>

            <form asp-controller="Account" asp-action="ForgotPassword" method="post" novalidate>
                <div asp-validation-summary="All" class="auth-validation-summary text-start"></div>

                <div class="auth-input-group text-start">
                    <label asp-for="Email" class="auth-input-label">Email</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-envelope"></i></span>
                        <input asp-for="Email" class="form-control" placeholder="nama@email.com" autocomplete="email" />
                    </div>
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <button type="submit" class="auth-btn auth-btn-primary">
                    <i class="fas fa-paper-plane"></i> Kirim Link Reset
                </button>
            </form>

            <div class="auth-links">
                Ingat password? <a href="/Account/Login">Kembali ke Login</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
