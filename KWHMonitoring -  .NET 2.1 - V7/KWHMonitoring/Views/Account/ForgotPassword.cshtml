@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Lupa Password";
    Layout = "_Layout";
}

<div class="container-fluid vh-100 d-flex align-items-center justify-content-center" style="background: linear-gradient(135deg, #0d6efd 0%, #0a58ca 100%);">
    <div class="row justify-content-center w-100">
        <div class="col-md-5 col-lg-4">
            <div class="card shadow-lg border-0">
                <div class="card-body p-5">
                    <div class="text-center mb-4">
                        <i class="fas fa-key text-warning fa-3x mb-3"></i>
                        <h3 class="fw-bold text-primary">Lupa Password</h3>
                        <p class="text-muted">Masukkan email Anda untuk menerima link reset password.</p>
                    </div>

                    <form asp-controller="Account" asp-action="ForgotPassword" method="post">
                        <div asp-validation-summary="All" class="text-danger small mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label">Email</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-envelope"></i></span>
                                <input asp-for="Email" class="form-control" placeholder="nama@email.com" />
                            </div>
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 py-2 fw-bold">
                            <i class="fas fa-paper-plane me-2"></i> Kirim Link Reset
                        </button>
                    </form>

                    <div class="mt-4 text-center">
                        <p class="mb-0"><a href="/Account/Login" class="text-decoration-none">Kembali ke Login</a></p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
