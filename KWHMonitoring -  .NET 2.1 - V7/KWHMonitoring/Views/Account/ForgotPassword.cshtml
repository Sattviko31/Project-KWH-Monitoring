@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Lupa Kata Sandi";
    Layout = "_Layout";
    ViewData["AuthPage"] = true;
}

<div class="auth-page">
    <div class="auth-card" data-card-help="Lupa Kata Sandi|Kirim tautan untuk mengatur ulang kata sandi ke alamat email terdaftar.|Tautan bersifat rahasia, memiliki masa berlaku terbatas, dan hanya dapat digunakan satu kali.|Email pemberitahuan tidak akan dikirim jika alamat tersebut tidak terdaftar di sistem.">
        <div class="card-body text-center">
            <div class="auth-logo">
                <i class="fas fa-key"></i>
            </div>
            <h3 class="auth-title">Lupa Kata Sandi?</h3>
            <p class="auth-subtitle">Masukkan alamat email Anda. Kami akan mengirimkan tautan untuk mengatur ulang kata sandi.</p>

            <form asp-controller="Account" asp-action="ForgotPassword" method="post" novalidate>
                <div asp-validation-summary="All" class="auth-validation-summary text-start"></div>

                <div class="auth-input-group text-start">
                    <label asp-for="Email" class="auth-input-label">Email</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-envelope"></i></span>
                        <input asp-for="Email" class="form-control" placeholder="nama@email.com" autocomplete="email" />
                    </div>
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <button type="submit" class="auth-btn auth-btn-primary">
                    <i class="fas fa-paper-plane"></i> Kirim Tautan Pengaturan Ulang
                </button>
            </form>

            <div class="auth-links">
            Ingat kata sandi Anda? <a href="/Account/Login">Kembali ke halaman masuk</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
