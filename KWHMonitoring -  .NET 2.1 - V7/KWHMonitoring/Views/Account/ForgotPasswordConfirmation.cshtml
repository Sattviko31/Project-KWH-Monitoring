@{
    ViewData["Title"] = "Link Reset Dikirim";
    Layout = "_Layout";
}

<div class="container-fluid vh-100 d-flex align-items-center justify-content-center" style="background: linear-gradient(135deg, #0d6efd 0%, #0a58ca 100%);">
    <div class="row justify-content-center w-100">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-lg border-0">
                <div class="card-body p-5 text-center">
                    <i class="fas fa-envelope text-primary fa-4x mb-4"></i>
                    <h3 class="fw-bold text-primary">Link Reset Password Dikirim</h3>
                    <p class="text-muted mt-3">
                        Jika email Anda terdaftar, kami telah mengirimkan link reset password ke kotak masuk Anda.<br>
                        Link tersebut berlaku selama 1 jam.
                    </p>
                    <a href="/Account/Login" class="btn btn-primary mt-3">
                        <i class="fas fa-arrow-left me-2"></i> Ke Halaman Login
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
