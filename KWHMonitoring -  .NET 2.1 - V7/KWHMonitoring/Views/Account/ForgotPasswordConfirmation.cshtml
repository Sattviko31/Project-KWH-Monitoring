@{
    ViewData["Title"] = "Link Reset Dikirim";
    Layout = "_Layout";
    ViewData["AuthPage"] = true;
}

<div class="auth-page">
    <div class="auth-card auth-card-success">
        <div class="card-body text-center">
            <div class="auth-logo auth-logo-success">
                <i class="fas fa-envelope"></i>
            </div>
            <h3 class="auth-title">Periksa Email Anda</h3>
            <p class="auth-subtitle">Link reset password telah dikirim</p>

            <div class="auth-message">
                Jika email Anda terdaftar di sistem kami, kami telah mengirimkan link reset password ke kotak masuk Anda.<br>
                Link tersebut berlaku selama <strong>1 jam</strong>.
            </div>

            <a href="/Account/Login" class="auth-btn auth-btn-primary">
                <i class="fas fa-arrow-left"></i> Ke Halaman Login
            </a>

            <p class="auth-hint">
                <i class="fas fa-clock text-warning"></i>
                Tidak menerima email? Periksa folder Spam atau kirim ulang dalam beberapa menit.
            </p>
        </div>
    </div>
</div>
