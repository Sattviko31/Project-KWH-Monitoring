@{
    ViewData["Title"] = "Tautan Pengaturan Ulang Kata Sandi Telah Dikirim";
    Layout = "_Layout";
    ViewData["AuthPage"] = true;
}

<div class="auth-page">
    <div class="auth-card auth-card-success" data-card-help="Konfirmasi Terkirim|Petunjuk pengaturan ulang kata sandi telah dikirim ke alamat email Anda.|Buka tautan dalam email untuk membuat kata sandi baru.|Jika email tidak diterima, periksa folder spam atau ajukan permintaan kembali.">
        <div class="card-body text-center">
            <div class="auth-logo auth-logo-success">
                <i class="fas fa-envelope"></i>
            </div>
            <h3 class="auth-title">Periksa Email Anda</h3>
            <p class="auth-subtitle">Tautan pengaturan ulang kata sandi telah dikirim.</p>

            <div class="auth-message">
                Jika alamat email Anda terdaftar, petunjuk pengaturan ulang kata sandi telah kami kirim ke kotak masuk Anda.<br>
                Tautan tersebut berlaku selama <strong>1 jam</strong>.
            </div>

            <a href="/Account/Login" class="auth-btn auth-btn-primary">
                <i class="fas fa-arrow-left"></i> Ke Halaman Masuk
            </a>

            <p class="auth-hint">
                <i class="fas fa-clock text-warning"></i>
                Tidak menerima email? Periksa folder spam atau ajukan permintaan kembali dalam beberapa menit.
            </p>
        </div>
    </div>
</div>
