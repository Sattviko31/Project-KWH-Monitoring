@model RegisterViewModel
@{
    ViewData["Title"] = "Register";
    Layout = "_Layout";
    ViewData["AuthPage"] = true;
}

<div class="auth-page">
    <div class="auth-card" data-card-help="Pendaftaran Akun|Buat akun untuk mengakses sistem pemantauan.|Alur pendaftaran: isi data, verifikasi alamat email, lalu tunggu persetujuan administrator utama.|Kata sandi disimpan dalam bentuk hash (PBKDF2-HMACSHA256, 100.000 iterasi) dan tidak disimpan sebagai teks biasa.">
        <div class="card-body text-center">
            <div class="auth-logo">
                <i class="fas fa-user-plus"></i>
            </div>
            <h3 class="auth-title">Buat Akun</h3>
            <p class="auth-subtitle">Daftar gratis untuk mulai memantau konsumsi energi</p>

            <form asp-controller="Account" asp-action="Register" method="post" novalidate>
                <div asp-validation-summary="All" class="auth-validation-summary text-start"></div>

                <div class="auth-input-group text-start">
                    <label asp-for="DisplayName" class="auth-input-label">Nama Lengkap</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-user"></i></span>
                        <input asp-for="DisplayName" class="form-control" placeholder="Nama lengkap Anda" autocomplete="name" />
                    </div>
                    <span asp-validation-for="DisplayName" class="text-danger small"></span>
                </div>

                <div class="auth-input-group text-start">
                    <label asp-for="Email" class="auth-input-label">Email</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-envelope"></i></span>
                        <input asp-for="Email" class="form-control" placeholder="nama@email.com" autocomplete="email" />
                    </div>
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="auth-input-group text-start">
                    <label asp-for="Password" class="auth-input-label">Kata Sandi</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-lock"></i></span>
                        <input asp-for="Password" class="form-control" placeholder="Minimal 8 karakter" autocomplete="new-password" />
                        <span class="input-group-btn">
                            <button type="button" class="auth-password-toggle" data-toggle-password="#Password" aria-label="Tampilkan kata sandi">
                                <i class="fas fa-eye"></i>
                            </button>
                        </span>
                    </div>
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="auth-input-group text-start">
                    <label asp-for="ConfirmPassword" class="auth-input-label">Konfirmasi Kata Sandi</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-lock"></i></span>
                        <input asp-for="ConfirmPassword" class="form-control" placeholder="Ulangi kata sandi" autocomplete="new-password" />
                        <span class="input-group-btn">
                            <button type="button" class="auth-password-toggle" data-toggle-password="#ConfirmPassword" aria-label="Tampilkan kata sandi">
                                <i class="fas fa-eye"></i>
                            </button>
                        </span>
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>

                <button type="submit" class="auth-btn auth-btn-primary">
                    <i class="fas fa-user-plus"></i> Daftar Sekarang
                </button>
            </form>

            <div class="auth-links">
            Sudah memiliki akun? <a href="/Account/Login">Masuk ke akun Anda</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
