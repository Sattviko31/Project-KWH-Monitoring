@{
    ViewData["Title"] = "Akses Ditolak";
    Layout = "_Layout";
    ViewData["AuthPage"] = true;
}

<div class="auth-page auth-danger-bg">
    <div class="auth-card auth-card-danger">
        <div class="card-body text-center">
            <div class="auth-logo auth-logo-danger">
                <i class="fas fa-shield-alt"></i>
            </div>
            <h3 class="auth-title">Akses Ditolak</h3>
            <p class="auth-subtitle">Anda tidak memiliki izin untuk mengakses halaman ini</p>

            <div class="auth-message">
                Halaman yang Anda coba akses memerlukan hak akses khusus.<br>
                Silakan hubungi administrator jika Anda membutuhkan akses.
            </div>

            <a href="/" class="auth-btn auth-btn-danger">
                <i class="fas fa-arrow-left"></i> Ke Dashboard
            </a>
        </div>
    </div>
</div>
