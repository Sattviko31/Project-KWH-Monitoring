@model LoginViewModel
@{
    ViewData["Title"] = "Login";
    Layout = "_Layout";
    ViewData["AuthPage"] = true;
}

<div class="auth-page">
    <div class="auth-card">
        <div class="card-body text-center">
            <div class="auth-logo">
                <i class="fas fa-bolt"></i>
            </div>
            <h3 class="auth-title">Selamat Datang</h3>
            <p class="auth-subtitle">Masuk ke akun KWH Monitoring Anda</p>

            <form asp-controller="Account" asp-action="Login" method="post" asp-route-returnurl="@ViewData["ReturnUrl"]" novalidate>
                <div asp-validation-summary="All" class="auth-validation-summary text-start"></div>

                <div class="auth-input-group text-start">
                    <label asp-for="Email" class="auth-input-label">Email</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-envelope"></i></span>
                        <input asp-for="Email" class="form-control" placeholder="nama@email.com" autocomplete="email" />
                    </div>
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="auth-input-group text-start">
                    <label asp-for="Password" class="auth-input-label">Password</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-lock"></i></span>
                        <input asp-for="Password" class="form-control auth-password-input" placeholder="Masukkan password" autocomplete="current-password" />
                        <span class="input-group-btn">
                            <button type="button" class="auth-password-toggle" data-toggle-password="#Password" aria-label="Tampilkan password">
                                <i class="fas fa-eye"></i>
                            </button>
                        </span>
                    </div>
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="auth-remember">
                    <div class="form-check">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label">Ingat saya</label>
                    </div>
                    <a href="/Account/ForgotPassword" class="auth-forgot-link">Lupa password?</a>
                </div>

                <button type="submit" class="auth-btn auth-btn-primary">
                    <i class="fas fa-sign-in-alt"></i> Login
                </button>
            </form>

            <div class="auth-divider"><span>atau</span></div>

            <div class="auth-links">
                Belum punya akun? <a href="/Account/Register">Daftar sekarang</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
