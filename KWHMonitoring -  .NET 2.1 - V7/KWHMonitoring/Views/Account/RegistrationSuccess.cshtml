@{
    ViewData["Title"] = "Registrasi Berhasil";
    Layout = "_Layout";
    ViewData["AuthPage"] = true;
}

<div class="auth-page">
    <div class="auth-card auth-card-success">
        <div class="card-body text-center">
            <div class="auth-logo auth-logo-success">
                <i class="fas fa-envelope-open-text"></i>
            </div>
            <h3 class="auth-title">Registrasi Berhasil!</h3>
            <p class="auth-subtitle">Tinggal satu langkah lagi</p>

            <div class="auth-message">
                Kami telah mengirimkan email verifikasi ke <strong>@ViewBag.Email</strong>.<br>
                Silakan cek kotak masuk Anda dan klik link verifikasi untuk melanjutkan.
            </div>

            <a href="/Account/Login" class="auth-btn auth-btn-primary">
                <i class="fas fa-arrow-left"></i> Ke Halaman Login
            </a>

            <p class="auth-hint">
                <i class="fas fa-info-circle text-primary"></i>
                Setelah verifikasi, admin master akan menerima permintaan persetujuan akses Anda.
            </p>
        </div>
    </div>
</div>
