@{
    ViewData["Title"] = "Pendaftaran Berhasil";
    Layout = "_Layout";
    ViewData["AuthPage"] = true;
}

<div class="auth-page">
    <div class="auth-card auth-card-success" data-card-help="Pendaftaran Berhasil|Pendaftaran akun telah diterima oleh sistem.|Langkah berikutnya, periksa email untuk membuka tautan verifikasi yang berlaku selama 24 jam.|Setelah verifikasi, tunggu persetujuan administrator utama sebelum masuk.">
        <div class="card-body text-center">
            <div class="auth-logo auth-logo-success">
                <i class="fas fa-envelope-open-text"></i>
            </div>
            <h3 class="auth-title">Pendaftaran Berhasil!</h3>
            <p class="auth-subtitle">Satu langkah lagi untuk mengaktifkan akun Anda.</p>

            <div class="auth-message">
                Kami telah mengirimkan email verifikasi ke <strong>@ViewBag.Email</strong>.<br>
                Periksa kotak masuk Anda, lalu buka tautan verifikasi untuk melanjutkan.
            </div>

            <a href="/Account/Login" class="auth-btn auth-btn-primary">
                <i class="fas fa-arrow-left"></i> Ke Halaman Masuk
            </a>

            <p class="auth-hint">
                <i class="fas fa-info-circle text-primary"></i>
                Setelah verifikasi, administrator utama akan meninjau permintaan akses Anda.
            </p>
        </div>
    </div>
</div>
