@{
    ViewData["Title"] = "Registrasi Berhasil";
    Layout = "_Layout";
}

<div class="container-fluid vh-100 d-flex align-items-center justify-content-center" style="background: linear-gradient(135deg, #0d6efd 0%, #0a58ca 100%);">
    <div class="row justify-content-center w-100">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-lg border-0">
                <div class="card-body p-5 text-center">
                    <i class="fas fa-envelope-open-text text-success fa-4x mb-4"></i>
                    <h3 class="fw-bold text-primary">Registrasi Berhasil!</h3>
                    <p class="text-muted mt-3">
                        Kami telah mengirimkan email verifikasi ke <strong>@ViewBag.Email</strong>.<br>
                        Silakan cek kotak masuk Anda dan klik link verifikasi untuk melanjutkan.
                    </p>
                    <p class="text-muted small">
                        Setelah verifikasi, admin master akan menerima permintaan persetujuan akses Anda.
                    </p>
                    <a href="/Account/Login" class="btn btn-primary mt-3">
                        <i class="fas fa-arrow-left me-2"></i> Ke Halaman Login
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
