@{
    ViewData["Title"] = "Password Berhasil Direset";
    Layout = "_Layout";
}

<div class="container-fluid vh-100 d-flex align-items-center justify-content-center" style="background: linear-gradient(135deg, #198754 0%, #146c43 100%);">
    <div class="row justify-content-center w-100">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-lg border-0">
                <div class="card-body p-5 text-center">
                    <i class="fas fa-check-circle text-success fa-4x mb-4"></i>
                    <h3 class="fw-bold text-success">Password Berhasil Direset!</h3>
                    <p class="text-muted mt-3">
                        Password Anda telah berhasil diperbarui.<br>
                        Silakan login dengan password baru Anda.
                    </p>
                    <a href="/Account/Login" class="btn btn-success mt-3">
                        <i class="fas fa-arrow-left me-2"></i> Ke Halaman Login
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
