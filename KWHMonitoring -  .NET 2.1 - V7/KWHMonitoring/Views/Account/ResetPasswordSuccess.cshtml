@{
    ViewData["Title"] = "Password Berhasil Direset";
    Layout = "_Layout";
    ViewData["AuthPage"] = true;
}

<div class="auth-page auth-success-bg">
    <div class="auth-card auth-card-success">
        <div class="card-body text-center">
            <div class="auth-logo auth-logo-success">
                <i class="fas fa-check-circle"></i>
            </div>
            <h3 class="auth-title">Password Berhasil Direset!</h3>
            <p class="auth-subtitle">Akun Anda kini lebih aman</p>

            <div class="auth-message">
                Password Anda telah berhasil diperbarui.<br>
                Silakan login dengan password baru Anda.
            </div>

            <a href="/Account/Login" class="auth-btn auth-btn-success">
                <i class="fas fa-arrow-left"></i> Ke Halaman Login
            </a>
        </div>
    </div>
</div>
