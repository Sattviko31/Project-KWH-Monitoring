@{
    ViewData["Title"] = "Kata Sandi Berhasil Diatur Ulang";
    Layout = "_Layout";
    ViewData["AuthPage"] = true;
}

<div class="auth-page auth-success-bg">
    <div class="auth-card auth-card-success" data-card-help="Kata Sandi Berhasil Diatur Ulang|Kata sandi akun Anda telah diperbarui.|Gunakan kata sandi baru untuk masuk.|Tautan pengaturan ulang sebelumnya tidak dapat digunakan kembali.">
        <div class="card-body text-center">
            <div class="auth-logo auth-logo-success">
                <i class="fas fa-check-circle"></i>
            </div>
            <h3 class="auth-title">Kata Sandi Berhasil Diatur Ulang!</h3>
            <p class="auth-subtitle">Akun Anda kini lebih aman</p>

            <div class="auth-message">
                Kata sandi Anda telah berhasil diperbarui.<br>
                Silakan masuk menggunakan kata sandi baru Anda.
            </div>

            <a href="/Account/Login" class="auth-btn auth-btn-success">
                <i class="fas fa-arrow-left"></i> Ke Halaman Masuk
            </a>
        </div>
    </div>
</div>
