@{
    ViewData["Title"] = "Email Terverifikasi";
    Layout = "_Layout";
    ViewData["AuthPage"] = true;
}

<div class="auth-page auth-success-bg">
    <div class="auth-card auth-card-success" data-card-help="Verifikasi Berhasil|Alamat email telah dikonfirmasi dan permintaan akses dikirim kepada administrator utama.|Langkah berikutnya, tunggu persetujuan administrator yang akan disampaikan melalui email.|Setelah disetujui, masuk sesuai peran yang diberikan (Pengamat atau Operator).">
        <div class="card-body text-center">
            <div class="auth-logo auth-logo-success">
                <i class="fas fa-check-circle"></i>
            </div>
            <h3 class="auth-title">Email Berhasil Diverifikasi!</h3>
            <p class="auth-subtitle">Verifikasi email Anda telah selesai</p>

            <div class="auth-message">
                Terima kasih telah memverifikasi email Anda.<br>
                Permintaan akses Anda telah dikirim kepada administrator utama untuk diproses.
            </div>

            <a href="/Account/Login" class="auth-btn auth-btn-success">
                <i class="fas fa-arrow-left"></i> Ke Halaman Masuk
            </a>

            <p class="auth-hint">
                <i class="fas fa-envelope text-success"></i>
                Anda akan menerima email konfirmasi setelah administrator menyetujui akses Anda.
            </p>
        </div>
    </div>
</div>
