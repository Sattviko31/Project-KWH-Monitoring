@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Atur Ulang Kata Sandi";
    Layout = "_Layout";
    ViewData["AuthPage"] = true;
}

<div class="auth-page">
    <div class="auth-card" data-card-help="Atur Ulang Kata Sandi|Buat kata sandi baru menggunakan tautan verifikasi yang dikirim melalui email.|Keamanan: hash = PBKDF2-HMACSHA256 (salt acak 16 byte, 100.000 iterasi).|Tautan sebelumnya otomatis tidak berlaku setelah kata sandi baru disimpan.">
        <div class="card-body text-center">
            <div class="auth-logo">
                <i class="fas fa-lock"></i>
            </div>
            <h3 class="auth-title">Atur Ulang Kata Sandi</h3>
            <p class="auth-subtitle">Buat kata sandi baru yang kuat untuk melindungi akun Anda.</p>

            <form asp-controller="Account" asp-action="ResetPassword" method="post" novalidate>
                <div asp-validation-summary="All" class="auth-validation-summary text-start"></div>
                <input type="hidden" name="Email" value="@ViewBag.Email" />
                <input type="hidden" name="Token" value="@ViewBag.Token" />

                <div class="auth-input-group text-start">
                    <label asp-for="Password" class="auth-input-label">Kata Sandi Baru</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-lock"></i></span>
                        <input asp-for="Password" class="form-control" placeholder="Minimal 8 karakter" autocomplete="new-password" />
                        <span class="input-group-btn">
                            <button type="button" class="auth-password-toggle" data-toggle-password="#Password" aria-label="Tampilkan kata sandi">
                                <i class="fas fa-eye"></i>
                            </button>
                        </span>
                    </div>
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="auth-input-group text-start">
                    <label asp-for="ConfirmPassword" class="auth-input-label">Konfirmasi Kata Sandi Baru</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-lock"></i></span>
                        <input asp-for="ConfirmPassword" class="form-control" placeholder="Ulangi kata sandi baru" autocomplete="new-password" />
                        <span class="input-group-btn">
                            <button type="button" class="auth-password-toggle" data-toggle-password="#ConfirmPassword" aria-label="Tampilkan kata sandi">
                                <i class="fas fa-eye"></i>
                            </button>
                        </span>
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>

                <button type="submit" class="auth-btn auth-btn-primary">
                    <i class="fas fa-save"></i> Simpan Kata Sandi Baru
                </button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
